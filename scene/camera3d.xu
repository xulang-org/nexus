@"github.com/xulang-org/nexus/scene"

fm #"github.com/xulang-org/nexus/foundation/math"
camera_data #"github.com/xulang-org/nexus/resources/camera"
#errors

// Engine camera conventions stay separate from reusable vector/matrix algebra.
// Right-handed, +Y up, metres, camera forward -Z.
pub fn look_at_3d(eye fm.Vec3, target fm.Vec3, up fm.Vec3) fm.Mat4 {
    if !eye.is_finite() || !target.is_finite() || !up.is_finite() { >>> errors.new("nexus: invalid camera basis") }
    back := eye.sub(target).normalized() >>>
    right := up.cross(back).normalized() >>>
    vertical := back.cross(right)
    result := fm.Mat4{c0: fm.vec4(right.x, vertical.x, back.x, 0.0), c1: fm.vec4(right.y, vertical.y, back.y, 0.0),
        c2: fm.vec4(right.z, vertical.z, back.z, 0.0), c3: fm.vec4(-right.dot(eye), -vertical.dot(eye), -back.dot(eye), 1.0)}
    if !result.is_finite() { >>> errors.new("nexus: camera basis overflow") }
    << result
}
// Finite reverse-Z perspective: NDC depth near=1, far=0, clear=0, compare GREATER.
pub fn perspective_3d(vertical_fov f64, aspect f64, near f64, far f64) fm.Mat4 {
    << camera_data.projection(vertical_fov, aspect, near, far) >>>
}

pub struct Camera3D {
    pub position fm.Vec3
    pub target fm.Vec3
    pub up fm.Vec3
    pub vertical_fov f64
    pub near f64
    pub far f64
}
pub fn new_camera_3d() Camera3D {
    << Camera3D{position: fm.vec3(0.0, 0.0, 5.0), target: fm.vec3(0.0, 0.0, 0.0), up: fm.vec3(0.0, 1.0, 0.0),
        vertical_fov: 1.0471975511965976, near: 0.1, far: 1000.0}
}
pub fn (camera Camera3D) view_projection(aspect f64) fm.Mat4 {
    projection := perspective_3d(camera.vertical_fov, aspect, camera.near, camera.far) >>>
    view := look_at_3d(camera.position, camera.target, camera.up) >>>
    << projection.multiply(view)
}

// A camera attachment uses its Node3D's world pose, including parent transforms.
// GPU resources and scene transforms are not stored in this lens description.
pub struct CameraNode3D {
    pub node int
    pub vertical_fov f64
    pub near f64
    pub far f64
}
pub fn new_camera_node_3d(tree &SceneTree, node int) CameraNode3D {
    index := tree.editable(node) >>>
    component := tree.require_spatial(index, NODE_3D) >>>
    if tree.spatial_3d[component].orthographic.is_set() {
        >>> errors.new("nexus: orthographic camera requires camera_view_projection_3d")
    }
    lens := tree.spatial_3d[component].camera
    if lens.is_set() {
        << CameraNode3D{node: node, vertical_fov: lens.vertical_fov(), near: lens.near(), far: lens.far()}
    }
    << CameraNode3D{node: node, vertical_fov: 1.0471975511965976, near: 0.1, far: 1000.0}
}

pub fn (tree $&SceneTree) set_camera_3d(node int, lens camera_data.Perspective) int {
    index := tree.editable(node) >>>
    component := tree.require_spatial(index, NODE_3D) >>>
    tree.spatial_3d[component].camera = lens
    tree.spatial_3d[component].orthographic = camera_data.Orthographic{}
    << 0
}
pub fn (tree $&SceneTree) set_orthographic_camera_3d(node int, lens camera_data.Orthographic) int {
    index := tree.editable(node) >>>
    component := tree.require_spatial(index, NODE_3D) >>>
    tree.spatial_3d[component].orthographic = lens
    tree.spatial_3d[component].camera = camera_data.Perspective{}
    << 0
}
pub fn (tree &SceneTree) camera_projection_3d(node int, aspect f64) fm.Mat4 {
    index := tree.editable(node) >>>
    component := tree.require_spatial(index, NODE_3D) >>>
    ortho := tree.spatial_3d[component].orthographic
    if ortho.is_set() { << ortho.projection(aspect) >>> }
    camera := new_camera_node_3d(tree, node) >>>
    << perspective_3d(camera.vertical_fov, aspect, camera.near, camera.far) >>>
}
pub fn (tree &SceneTree) camera_view_projection_3d(node int, aspect f64) fm.Mat4 {
    projection := tree.camera_projection_3d(node, aspect) >>>
    view := (tree.global_transform_3d(node) >>>).affine_inverse() >>>
    result := projection.multiply(view)
    if !result.is_finite() { >>> errors.new("nexus: camera view-projection overflow") }
    << result
}
pub fn (camera CameraNode3D) view_projection(tree &SceneTree, aspect f64) fm.Mat4 {
    tree.editable(camera.node) >>>
    world := tree.global_transform_3d(camera.node) >>>
    view := world.affine_inverse() >>>
    projection := perspective_3d(camera.vertical_fov, aspect, camera.near, camera.far) >>>
    << projection.multiply(view)
}
