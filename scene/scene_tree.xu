@"github.com/xulang-org/nexus/scene"

fm #"github.com/xulang-org/nexus/foundation/math"
camera_data #"github.com/xulang-org/nexus/resources/camera"
#errors
#strings

pub const PROCESS_INHERIT = 0
pub const PROCESS_PAUSABLE = 1
pub const PROCESS_ALWAYS = 2
pub const PROCESS_WHEN_PAUSED = 3
pub const PROCESS_DISABLED = 4
pub const MAX_NODES = 65536
pub const NODE_GROUP = 0
pub const NODE_2D = 2
pub const NODE_3D = 3

struct NodeSlot {
    generation int
    alive bool
    pending_free bool
    ready bool
    parent int
    first_child int
    last_child int
    previous int
    next int
    free_next int
    name string
    kind int
    spatial int
    visible bool
    process_mode int
}
// IDs are scoped to a tree. Freed IDs cannot refer to a reused slot.
pub struct SceneTree {
    slots []NodeSlot
    free_head int
    capacity int
    spatial_2d []Spatial2D
    spatial_3d []Spatial3D
    world_2d []fm.Transform2D
    dirty_2d []bool
    world_3d []fm.Mat4
    dirty_3d []bool
    transforms_dirty bool
    free_2d int
    free_3d int
    pub paused bool
}
// Common identity and lifecycle data; transforms live in dimension-specific pools.
pub struct Node {
    pub id int
    pub parent int
    pub name string
    pub kind int
    pub visible bool
    pub process_mode int
    pub queued_free bool
}
pub struct Node2D {
    pub id int
    pub parent int
    pub name string
    pub transform fm.Transform2D
    pub camera camera_data.View2D
    pub visible bool
    pub process_mode int
}
fn new_slot(name string, parent int, generation int) NodeSlot {
    << NodeSlot{generation: generation, alive: true, pending_free: false, ready: false,
        parent: parent, first_child: -1, last_child: -1, previous: -1, next: -1, free_next: -1,
        name: name, kind: NODE_GROUP, spatial: -1, visible: true, process_mode: PROCESS_INHERIT}
}
fn valid_name(name &string) bool {
    if name.len == 0 || name.len > 255 || *name == "." || *name == ".." { << false }
    for i in 0:name.len {
        if name[i] < 32 || name[i] == 47 || name[i] == 127 { << false }
    }
    << true
}
pub fn new_scene_tree(name string, capacity int) SceneTree {
    << make_scene_tree(name, capacity, NODE_2D) >>>
}
pub fn new_scene_tree_3d(name string, capacity int) SceneTree {
    << make_scene_tree(name, capacity, NODE_3D) >>>
}
fn make_scene_tree(name string, capacity int, root_kind int) SceneTree {
    if capacity < 1 || capacity > MAX_NODES || !valid_name(&name) {
        >>> errors.new("nexus: invalid scene tree name or capacity")
    }
    $slots := []NodeSlot{}
    slots.push(new_slot(name, -1, 0))
    $tree := SceneTree{slots: slots, free_head: -1, capacity: capacity, paused: false,
        spatial_2d: []Spatial2D{}, spatial_3d: []Spatial3D{},
        world_2d: []fm.Transform2D{}, dirty_2d: []bool{},
        world_3d: []fm.Mat4{}, dirty_3d: []bool{},
        transforms_dirty: true, free_2d: -1, free_3d: -1}
    tree.allocate_spatial(0, root_kind)
    << tree
}
pub fn (tree &SceneTree) root() int { << 1 }
fn (tree &SceneTree) node_id(index int) int {
    if index < 0 { << 0 }
    << tree.slots[index].generation * MAX_NODES + index + 1
}
fn (tree &SceneTree) index(id int) int {
    if id <= 0 { >>> errors.new("nexus: invalid node ID") }
    index := (id - 1) % MAX_NODES
    if index >= tree.slots.len || !tree.slots[index].alive ||
        tree.slots[index].generation != (id - 1) / MAX_NODES {
        >>> errors.new("nexus: stale node ID")
    }
    << index
}
pub fn (tree &SceneTree) is_alive(id int) bool {
    if id <= 0 { << false }
    index := (id - 1) % MAX_NODES
    << index < tree.slots.len && tree.slots[index].alive &&
        tree.slots[index].generation == (id - 1) / MAX_NODES
}
fn (tree &SceneTree) editable(id int) int {
    index := tree.index(id) >>>
    if tree.slots[index].pending_free { >>> errors.new("nexus: node is queued for deletion") }
    << index
}
pub fn (tree &SceneTree) node(id int) Node2D {
    index := tree.index(id) >>>
    component := tree.require_spatial(index, NODE_2D) >>>
    << Node2D{id: id, parent: tree.node_id(tree.slots[index].parent), name: tree.slots[index].name + "",
        transform: tree.spatial_2d[component].local, camera: tree.spatial_2d[component].camera, visible: tree.slots[index].visible,
        process_mode: tree.slots[index].process_mode}
}
pub fn (tree &SceneTree) node_info(id int) Node {
    index := tree.index(id) >>>
    << Node{id: id, parent: tree.node_id(tree.slots[index].parent), name: tree.slots[index].name + "",
        kind: tree.slots[index].kind, visible: tree.slots[index].visible,
        process_mode: tree.slots[index].process_mode, queued_free: tree.slots[index].pending_free}
}
pub fn (tree &SceneTree) node_kind(id int) int {
    index := tree.index(id) >>>
    << tree.slots[index].kind
}
// Returns 0 when the immediate child is absent. Queued nodes remain until flush.
pub fn (tree &SceneTree) find_child(parent_id int, name string) int {
    parent := tree.index(parent_id) >>>
    $child := tree.slots[parent].first_child
    while child >= 0 {
        if tree.slots[child].name == name { << tree.node_id(child) }
        child = tree.slots[child].next
    }
    << 0
}
// Relative paths support . and ..; a leading / starts at this tree's root.
pub fn (tree &SceneTree) find_node(from int, path string) int {
    tree.index(from) >>>
    if path.len > 4096 { >>> errors.new("nexus: node path exceeds 4096 bytes") }
    $current := from
    if path.len > 0 && path[0] == 47 { current = tree.root() }
    parts := strings.split(&path, "/")
    for part in parts {
        if part.len == 0 || part == "." { -> }
        if part == ".." {
            index := tree.index(current) >>>
            if tree.slots[index].parent < 0 { >>> errors.new("nexus: node path escapes root") }
            current = tree.node_id(tree.slots[index].parent)
        } else {
            current = tree.find_child(current, part + "") >>>
            if current == 0 { >>> errors.new("nexus: node path not found: " + path) }
        }
    }
    << current
}
fn (tree &SceneTree) check_name(parent int, name &string, except int) int {
    if !valid_name(name) { >>> errors.new("nexus: invalid node name") }
    $child := tree.slots[parent].first_child
    while child >= 0 {
        if child != except && tree.slots[child].name == *name { >>> errors.new("nexus: duplicate sibling name") }
        child = tree.slots[child].next
    }
    << 0
}
fn (tree $&SceneTree) attach(index int, parent int) {
    last := tree.slots[parent].last_child
    tree.slots[index].parent = parent
    tree.slots[index].previous = last
    tree.slots[index].next = -1
    if last >= 0 { tree.slots[last].next = index } else { tree.slots[parent].first_child = index }
    tree.slots[parent].last_child = index
}
fn (tree $&SceneTree) detach(index int) {
    parent := tree.slots[index].parent
    previous := tree.slots[index].previous
    next := tree.slots[index].next
    if previous >= 0 { tree.slots[previous].next = next } else { tree.slots[parent].first_child = next }
    if next >= 0 { tree.slots[next].previous = previous } else { tree.slots[parent].last_child = previous }
}
pub fn (tree $&SceneTree) add_child(parent_id int, name string) int {
    << tree.add_typed_child(parent_id, name, NODE_2D) >>>
}
pub fn (tree $&SceneTree) add_child_3d(parent_id int, name string) int {
    << tree.add_typed_child(parent_id, name, NODE_3D) >>>
}
pub fn (tree $&SceneTree) add_group(parent_id int, name string) int {
    << tree.add_typed_child(parent_id, name, NODE_GROUP) >>>
}
fn (tree $&SceneTree) add_typed_child(parent_id int, name string, kind int) int {
    parent := tree.editable(parent_id) >>>
    tree.check_name(parent, &name, -1) >>>
    $index := tree.free_head
    if index >= 0 {
        generation := tree.slots[index].generation
        tree.free_head = tree.slots[index].free_next
        tree.slots[index] = new_slot(name, parent, generation)
    } else {
        if tree.slots.len >= tree.capacity { >>> errors.new("nexus: scene node capacity exceeded") }
        index = tree.slots.len
        tree.slots.push(new_slot(name, parent, 0))
    }
    tree.allocate_spatial(index, kind)
    tree.attach(index, parent)
    if kind == NODE_2D || kind == NODE_3D { tree.transforms_dirty = true }
    << tree.node_id(index)
}
// Iterative pre-order traversal, bounded by the configured node capacity.
pub fn (tree &SceneTree) subtree(id int) []int {
    root := tree.index(id) >>>
    $result := []int{}
    $index := root
    while true {
        result.push(tree.node_id(index))
        if tree.slots[index].first_child >= 0 {
            index = tree.slots[index].first_child
            ->
        }
        while index != root && tree.slots[index].next < 0 { index = tree.slots[index].parent }
        if index == root { <- }
        index = tree.slots[index].next
    }
    << result
}
fn (tree &SceneTree) postorder(id int) []int {
    root := tree.index(id) >>>
    $result := []int{}
    $index := root
    while tree.slots[index].first_child >= 0 { index = tree.slots[index].first_child }
    while true {
        result.push(tree.node_id(index))
        if index == root { <- }
        if tree.slots[index].next >= 0 {
            index = tree.slots[index].next
            while tree.slots[index].first_child >= 0 { index = tree.slots[index].first_child }
        } else { index = tree.slots[index].parent }
    }
    << result
}
pub fn (tree &SceneTree) global_transform(id int) fm.Transform2D {
    index := tree.index(id) >>>
    tree.require_spatial(index, NODE_2D) >>>
    << tree.inherited_2d(index) >>>
}
pub fn (tree $&SceneTree) set_transform(id int, value fm.Transform2D) int {
    index := tree.editable(id) >>>
    component := tree.require_spatial(index, NODE_2D) >>>
    if !value.is_finite() { >>> errors.new("nexus: node transform must be finite") }
    tree.spatial_2d[component].local = value
    tree.mark_dirty_subtree_2d(index)
    << 0
}
pub fn (tree $&SceneTree) set_position(id int, position fm.Vec2) int {
    index := tree.editable(id) >>>
    component := tree.require_spatial(index, NODE_2D) >>>
    if !fm.finite(position.x) || !fm.finite(position.y) { >>> errors.new("nexus: position must be finite") }
    tree.spatial_2d[component].local.tx = position.x
    tree.spatial_2d[component].local.ty = position.y
    tree.mark_dirty_subtree_2d(index)
    << 0
}
pub fn (tree $&SceneTree) set_visible(id int, visible bool) int {
    index := tree.editable(id) >>>
    tree.slots[index].visible = visible
    << 0
}
pub fn (tree &SceneTree) is_visible(id int) bool {
    $index := tree.index(id) >>>
    while index >= 0 {
        if !tree.slots[index].visible || tree.slots[index].pending_free { << false }
        index = tree.slots[index].parent
    }
    << true
}
pub fn (tree $&SceneTree) set_process_mode(id int, mode int) int {
    index := tree.editable(id) >>>
    if mode < PROCESS_INHERIT || mode > PROCESS_DISABLED { >>> errors.new("nexus: invalid process mode") }
    tree.slots[index].process_mode = mode
    << 0
}
pub fn (tree &SceneTree) can_process(id int) bool {
    $index := tree.index(id) >>>
    if tree.slots[index].pending_free { << false }
    $mode := PROCESS_PAUSABLE
    while index >= 0 {
        candidate := tree.slots[index].process_mode
        if candidate != PROCESS_INHERIT { mode = candidate
            <- }
        index = tree.slots[index].parent
    }
    << mode == PROCESS_ALWAYS || (mode == PROCESS_PAUSABLE && !tree.paused) ||
        (mode == PROCESS_WHEN_PAUSED && tree.paused)
}
pub fn (tree &SceneTree) process_order() []int {
    ids := tree.subtree(tree.root()) >>>
    $result := []int{}
    for id in ids { if tree.can_process(id) >>> { result.push(id) } }
    << result
}
// Post-order notifications, once per node. Caller dispatches its own Xu behavior.
pub fn (tree $&SceneTree) take_ready() []int {
    ids := tree.postorder(tree.root()) >>>
    $result := []int{}
    for id in ids {
        index := tree.index(id) >>>
        if !tree.slots[index].ready && !tree.slots[index].pending_free {
            tree.slots[index].ready = true
            result.push(id)
        }
    }
    << result
}
// Reject cycles and singular keep-global transforms before modifying either branch.
pub fn (tree $&SceneTree) reparent(id int, parent_id int, keep_global bool) int {
    index := tree.editable(id) >>>
    parent := tree.editable(parent_id) >>>
    if index == 0 { >>> errors.new("nexus: cannot reparent the root") }
    $ancestor := parent
    while ancestor >= 0 {
        if ancestor == index { >>> errors.new("nexus: reparent would create a cycle") }
        ancestor = tree.slots[ancestor].parent
    }
    tree.check_name(parent, &tree.slots[index].name, index) >>>
    kind := tree.slots[index].kind
    component := tree.slots[index].spatial
    $local_2d := fm.identity()
    $local_3d := fm.identity_3d()
    if keep_global && kind == NODE_GROUP { >>> errors.new("nexus: a group cannot preserve descendant world transforms on reparent") }
    if keep_global && kind == NODE_2D {
        global := tree.global_transform(id) >>>
        parent_global := tree.inherited_2d(parent) >>>
        inverse := parent_global.inverse() >>>
        local_2d = inverse.multiply(global)
        if !local_2d.is_finite() { >>> errors.new("nexus: reparent transform overflow") }
    }
    if keep_global && kind == NODE_3D {
        global := tree.global_transform_3d(id) >>>
        parent_global := tree.inherited_3d(parent) >>>
        inverse := parent_global.affine_inverse() >>>
        local_3d = inverse.multiply(global)
        if !local_3d.is_affine() { >>> errors.new("nexus: reparent transform overflow") }
    }
    tree.detach(index)
    tree.attach(index, parent)
    if keep_global && kind == NODE_2D { tree.spatial_2d[component].local = local_2d }
    if keep_global && kind == NODE_3D { tree.spatial_3d[component].local = local_3d }
    if kind == NODE_2D {
        tree.mark_dirty_subtree_2d(index)
    } else if kind == NODE_3D {
        tree.mark_dirty_subtree_3d(index)
    } else {
        tree.mark_dirty_subtree_2d(index)
        tree.mark_dirty_subtree_3d(index)
    }
    << 0
}
pub fn (tree $&SceneTree) queue_free(id int) int {
    if id == tree.root() { >>> errors.new("nexus: cannot free the tree root") }
    ids := tree.subtree(id) >>>
    for child_id in ids {
        index := tree.index(child_id) >>>
        tree.slots[index].pending_free = true
    }
    << 0
}
// Call at a frame boundary. Returned old IDs are EXIT notifications, children first.
pub fn (tree $&SceneTree) flush_free() []int {
    ids := tree.postorder(tree.root()) >>>
    $freed := []int{}
    for id in ids {
        index := tree.index(id) >>>
        if !tree.slots[index].pending_free { -> }
        tree.detach(index)
        tree.release_spatial(index)
        tree.slots[index].alive = false
        tree.slots[index].generation = tree.slots[index].generation + 1
        tree.slots[index].name = ""
        tree.slots[index].free_next = tree.free_head
        tree.free_head = index
        freed.push(id)
    }
    << freed
}
