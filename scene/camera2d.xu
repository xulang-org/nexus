@"github.com/xulang-org/nexus/scene"

fm #"github.com/xulang-org/nexus/foundation/math"
camera_data #"github.com/xulang-org/nexus/resources/camera"
#errors
#math

// The design size stays fixed as the output resizes. Position is the world
// point at the viewport center; +rotation rotates the camera clockwise.
pub struct Camera2D {
    design_size fm.Vec2
    pub position fm.Vec2
    pub rotation f64
    pub zoom f64
}
pub fn new_camera_2d(width f64, height f64) Camera2D {
    if !camera_data.valid_dimensions_2d(width, height) {
        >>> errors.new("nexus: camera design size must be in 1...16384")
    }
    << Camera2D{design_size: fm.vec2(width, height), position: fm.vec2(width * 0.5, height * 0.5),
        rotation: 0.0, zoom: 1.0}
}
// The world origin and X direction define the pose. Only lens zoom scales
// the viewport, even when the node inherits scale or shear.
pub fn new_camera_node_2d(tree &SceneTree, node int) Camera2D {
    index := tree.editable(node) >>>
    component := tree.require_spatial(index, NODE_2D) >>>
    lens := tree.spatial_2d[component].camera
    if !lens.is_set() { >>> errors.new("nexus: Node2D has no camera attachment") }
    world := tree.inherited_2d(index) >>>
    if world.a == 0.0 && world.b == 0.0 { >>> errors.new("nexus: 2D camera world X axis is degenerate") }
    camera := Camera2D{design_size: fm.vec2(lens.width(), lens.height()),
        position: fm.vec2(world.tx, world.ty), rotation: math.atan2(world.b, world.a), zoom: lens.zoom()}
    camera.validate(lens.width(), lens.height()) >>>
    << camera
}
pub fn (tree $&SceneTree) set_camera_2d(node int, lens camera_data.View2D) int {
    index := tree.editable(node) >>>
    component := tree.require_spatial(index, NODE_2D) >>>
    tree.spatial_2d[component].camera = lens
    << 0
}
fn (camera &Camera2D) validate(output_width f64, output_height f64) int {
    if !camera_data.valid_dimensions_2d(output_width, output_height) ||
        !camera_data.valid_dimensions_2d(camera.design_size.x, camera.design_size.y) ||
        !fm.finite(camera.position.x) || !fm.finite(camera.position.y) ||
        math.abs(camera.position.x) > 1000000000.0 || math.abs(camera.position.y) > 1000000000.0 ||
        !camera_data.valid_zoom_2d(camera.zoom) ||
        !fm.finite(camera.rotation) || math.abs(camera.rotation) > 1000000.0 {
        >>> errors.new("nexus: invalid camera, zoom or output size")
    }
    << 0
}
pub fn (camera &Camera2D) design_size() fm.Vec2 { << camera.design_size }
// Output coordinates use the same units as the renderer, normally pixels.
pub fn (camera &Camera2D) viewport(output_width f64, output_height f64) fm.Rect2 {
    camera.validate(output_width, output_height) >>>
    scale := math.min(output_width / camera.design_size.x, output_height / camera.design_size.y)
    width := camera.design_size.x * scale
    height := camera.design_size.y * scale
    << fm.rect2((output_width - width) * 0.5, (output_height - height) * 0.5, width, height)
}
pub fn (camera &Camera2D) view_transform(output_width f64, output_height f64) fm.Transform2D {
    view := camera.viewport(output_width, output_height) >>>
    scale := view.size.x / camera.design_size.x * camera.zoom
    center := view.position.add(view.size.scaled(0.5))
    basis := fm.transform_2d(center, -camera.rotation, fm.vec2(scale, scale))
    translation := fm.transform_2d(camera.position.scaled(-1.0), 0.0, fm.vec2(1.0, 1.0))
    << basis.multiply(translation)
}
pub fn (camera &Camera2D) world_to_screen(point fm.Vec2, output_width f64, output_height f64) fm.Vec2 {
    if !fm.finite(point.x) || !fm.finite(point.y) { >>> errors.new("nexus: non-finite camera point") }
    view := camera.view_transform(output_width, output_height) >>>
    mapped := view.point(point)
    if !fm.finite(mapped.x) || !fm.finite(mapped.y) { >>> errors.new("nexus: camera coordinate overflow") }
    << mapped
}
// Points in the letterbox bars still map to world coordinates; test viewport
// containment first when using this for picking. Rotation and zoom are inverted.
pub fn (camera &Camera2D) screen_to_world(point fm.Vec2, output_width f64, output_height f64) fm.Vec2 {
    if !fm.finite(point.x) || !fm.finite(point.y) { >>> errors.new("nexus: non-finite camera point") }
    view := camera.viewport(output_width, output_height) >>>
    scale := view.size.x / camera.design_size.x * camera.zoom
    center := view.position.add(view.size.scaled(0.5))
    inverse := fm.transform_2d(camera.position, camera.rotation, fm.vec2(1.0 / scale, 1.0 / scale))
    mapped := inverse.point(point.sub(center))
    if !fm.finite(mapped.x) || !fm.finite(mapped.y) { >>> errors.new("nexus: camera coordinate overflow") }
    << mapped
}
