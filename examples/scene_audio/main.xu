@main
worlds #"github.com/xulang-org/nexus/integration/scene_audio"
audio #"github.com/xulang-org/nexus/audio"
#os
#strconv
#errors

fn run() int {
    args := os.args()
    $path := "examples/scene_audio/assets/world.xuscene"
    $save := ""
    $seconds := 5
    $i := 1
    while i < args.len {
        if i + 1 >= args.len { >>> errors.new("missing option value") }
        next := i + 1
        if args[i] == "--scene" { path = args[next] + ""
        } else if args[i] == "--save" { save = args[next] + ""
        } else if args[i] == "--seconds" { seconds = strconv.atoi(&args[next]) >>>
            if seconds < 1 || seconds > 60 { >>> errors.new("invalid seconds") }
        } else { >>> errors.new("unknown option") }
        i = i + 2
    }
    $world := worlds.load(path, 48000) >>>
    $output := audio.open_output(world.sample_rate()) >>>
    println("Restored scene audio driver: " + (output.driver_name() >>>) + "; clips=" + str(world.clip_count()) + "; buses=" + str(world.bus_count()))
    world.pump(&output, 2048, 512) >>>
    output.pause(false) >>>
    start := now_ns()
    $blocks := 0
    while now_ns() - start < seconds * 1000000000 {
        report := world.pump(&output, 2048, 512) >>>
        blocks = blocks + report.blocks
        sleep_ns(5000000)
    }
    if save.len > 0 { world.save(save + "") >>>
        println("Saved authored audio references, buses and emitters") }
    output.pause(true) >>>
    output.clear() >>>
    output.close() >>>
    world.close() >>>
    println("Finished restored scene audio; refill blocks=" + str(blocks))
    << 0
}
fn main() int { << run() >>> (err) { eprintln(err.msg())
    << 1 } }
