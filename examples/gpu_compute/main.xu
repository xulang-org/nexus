@main

#gpu
#encoding/binary
#os
#errors

fn shader_bytes(path string) []u8 {
    $file := os.open(path) or >>
    $output := []u8{}
    while output.len <= 1048576 {
        chunk := file.read(65536) or >>
        if chunk.len == 0 { <- }
        if chunk.len > 1048576 - output.len { >> errors.new("shader exceeds example's 1 MiB budget") }
        for i in 0:chunk.len { output.push(u8(chunk[i])) }
    }
    file.close() or >>
    if output.len == 0 { >> errors.new("empty shader") }
    << output
}
fn parameters(multiplier int, bias int, count int) []u8 {
    $bytes := []u8{}
    for i in 0:16 { bytes.push(u8(0)) }
    order := binary.little_endian()
    order.put_u32_bytes($&bytes, 0, multiplier) or >>
    order.put_u32_bytes($&bytes, 4, bias) or >>
    order.put_u32_bytes($&bytes, 8, count) or >>
    << bytes
}
fn run() int {
    args := os.args()
    $backend := gpu.AUTO
    $directory := "build/gpu-compute-shaders"
    $i := 1
    while i < args.len {
        if i+1 >= args.len { >> errors.new("missing option value") }
        if args[i] == "--shaders" { directory = args[i+1] + ""
        } else if args[i] == "--backend" {
            if args[i+1] == "metal" { backend = gpu.METAL
            } else if args[i+1] == "vulkan" { backend = gpu.VULKAN
            } else if args[i+1] == "d3d12" { backend = gpu.D3D12
            } else if args[i+1] != "auto" { >> errors.new("unknown GPU backend") }
        } else { >> errors.new("unknown option: " + args[i]) }
        i += 2
    }
    $device := gpu.open(gpu.DeviceOptions{backend: backend, debug: true, shader_formats: 0}) or >>
    selected := device.backend() or >>
    $format := gpu.SHADER_MSL
    $entrypoint := "main0"
    $name := "Metal"
    if selected == gpu.VULKAN { format = gpu.SHADER_SPIRV
        entrypoint = "main"
        name = "Vulkan"
    } else if selected == gpu.D3D12 { format = gpu.SHADER_DXIL
        entrypoint = "main"
        name = "D3D12" }
    code := shader_bytes(directory + "/transform.comp.bin") or >>
    desc := gpu.ComputePipelineDesc{format: format, entrypoint: entrypoint, read_buffers: 1,
        write_buffers: 1, uniform_sizes: [16], threads_x: 64, threads_y: 1, threads_z: 1}
    $pipeline := device.compute_pipeline(&desc, &code) or >>
    count := 1027
    order := binary.little_endian()
    $bytes := []u8{}
    for n in 0:count*4 { bytes.push(u8(0)) }
    for n in 0:count { order.put_u32_bytes($&bytes, n*4, (n*1234567) & 4294967295) or >> }
    $input := device.buffer(count*4, gpu.BUFFER_COMPUTE_STORAGE_READ) or >>
    $middle := device.buffer(count*4, gpu.BUFFER_COMPUTE_STORAGE_READ | gpu.BUFFER_COMPUTE_STORAGE_WRITE) or >>
    $output := device.buffer(count*4, gpu.BUFFER_COMPUTE_STORAGE_WRITE) or >>
    $uploaded := device.upload(&input, 0, &bytes) or >>
    uploaded.close() or >>
    $encoder := device.command_encoder() or >>
    first_writes := [gpu.write_buffer(&middle, false)]
    $first := encoder.begin_compute(&first_writes) or >>
    first.pipeline(&pipeline) or >>
    first.read_buffer(0, &input) or >>
    u1 := parameters(3, 7, count) or >>
    first.uniform(0, &u1) or >>
    input.close() or >>
    first.dispatch((count+63)/64, 1, 1) or >>
    first.end() or >>
    // A separate pass supplies the dependency barrier before reading middle.
    second_writes := [gpu.write_buffer(&output, false)]
    $second := encoder.begin_compute(&second_writes) or >>
    second.pipeline(&pipeline) or >>
    second.read_buffer(0, &middle) or >>
    u2 := parameters(5, 11, count) or >>
    second.uniform(0, &u2) or >>
    middle.close() or >>
    pipeline.close() or >>
    second.dispatch((count+63)/64, 1, 1) or >>
    second.end() or >>
    $fence := encoder.submit() or >>
    $readback := device.download(&output, 0, count*4) or >>
    output.close() or >>
    readback.wait() or >>
    readback.read($&bytes) or >>
    for n in 0:count {
        actual := order.get_u32_bytes(&bytes, n*4) or >>
        assert(actual == ((n*1234567*15+46) & 4294967295))
    }
    fence.wait() or >>
    fence.close() or >>
    readback.close() or >>
    stats := device.stats() or >>
    assert(stats.buffer_count == 0 && stats.buffer_bytes == 0 && stats.submission_count == 0 && stats.staging_bytes == 0)
    assert(stats.compute_pipeline_count == 0 && stats.compute_pass_count == 0 && stats.encoder_count == 0)
    device.close() or >>
    println("Standard GPU compute backend: " + name)
    println("Verified 1027 exact GPU values through two dependent compute passes and zero live resources")
    << 0
}
fn main() int { << run() or (err) { eprintln(err.msg())
    << 1 } }
