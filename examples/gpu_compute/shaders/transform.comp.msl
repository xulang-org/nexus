#include <metal_stdlib>
using namespace metal;
struct Params { uint multiplier; uint bias; uint count; uint padding; };
kernel void main0(constant Params &p [[buffer(0)]], const device uint *source [[buffer(1)]],
                  device uint *output [[buffer(2)]], uint i [[thread_position_in_grid]]) {
    if (i < p.count) output[i] = source[i] * p.multiplier + p.bias;
}
