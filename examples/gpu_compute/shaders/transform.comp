#version 450
layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;
layout(set = 0, binding = 0, std430) readonly buffer Input { uint values[]; } source_data;
layout(set = 1, binding = 0, std430) buffer Output { uint values[]; } output_data;
layout(set = 2, binding = 0, std140) uniform Params { uvec4 values; } p;
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i < p.values.z) output_data.values[i] = source_data.values[i] * p.values.x + p.values.y;
}
