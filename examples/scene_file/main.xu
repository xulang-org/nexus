@main

light_data #"github.com/xulang-org/nexus/resources/lighting"
shadows #"github.com/xulang-org/nexus/resources/shadow"
light_bindings #"github.com/xulang-org/nexus/integration/lighting"
light_files #"github.com/xulang-org/nexus/integration/scene_lighting"

#gpu

gpu_info #"github.com/xulang-org/nexus/platform/gpu"

#window
window_events #window/events
mesh_shaders #"github.com/xulang-org/nexus/assets/shaders/three_d"

meshes #"github.com/xulang-org/nexus/resources/mesh"

files #"github.com/xulang-org/nexus/integration/scene"
nexus #"github.com/xulang-org/nexus/scene"
fm #"github.com/xulang-org/nexus/foundation/math"
colors #"github.com/xulang-org/nexus/foundation/color"
ren #"github.com/xulang-org/nexus/rendering/three_d"
scene_render #"github.com/xulang-org/nexus/integration/rendering/three_d"
#os
#strconv
#errors

struct Options { path string
    camera string
    save string
    capture string
    shaders string
    frames int
    cascades int
    backend int }
fn options() Options {
    args := os.args()
    $config := Options{path: "examples/scene_file/assets/world.xuscene", camera: "Camera",
        save: "", capture: "", shaders: "build/mesh-shaders", frames: 0, cascades: -1, backend: gpu.AUTO}
    $i := 1
    while i < args.len {
        if i + 1 >= args.len { >> errors.new("missing option value") }
        next := i + 1
        if args[i] == "--scene" { config.path = args[next] + ""
        } else if args[i] == "--camera" { config.camera = args[next] + ""
        } else if args[i] == "--save" { config.save = args[next] + ""
        } else if args[i] == "--shaders" { config.shaders = args[next] + ""
        } else if args[i] == "--capture" { config.capture = args[next] + ""
        } else if args[i] == "--cascades" {
            config.cascades = strconv.atoi(&args[next]) or >>
            if config.cascades != 0 && (config.cascades < 2 || config.cascades > 4) {
                >> errors.new("cascades requires 0, 2, 3 or 4")
            }
        } else if args[i] == "--frames" {
            config.frames = strconv.atoi(&args[next]) or >>
            if config.frames < 1 || config.frames > 1000000 { >> errors.new("invalid frames") }
        } else if args[i] == "--backend" {
            if args[next] == "metal" { config.backend = gpu.METAL
            } else if args[next] == "vulkan" { config.backend = gpu.VULKAN
            } else if args[next] == "d3d12" { config.backend = gpu.D3D12
            } else if args[next] != "auto" { >> errors.new("unknown backend") }
        } else { >> errors.new("unknown option: " + args[i]) }
        i = i + 2
    }
    if config.capture.len > 0 && config.frames == 0 { >> errors.new("capture requires --frames") }
    << config
}
fn shadow_wall() meshes.MeshData3D {
    $wall := meshes.new_mesh_data_3d()
    for position in [fm.vec3(-5.0,-3.3,-2.0), fm.vec3(5.0,-3.3,-2.0),
        fm.vec3(5.0,3.3,-2.0), fm.vec3(-5.0,3.3,-2.0)] {
        wall.vertex_lit(position, 4294967295, fm.vec3(0.0,0.0,1.0)) or >>
    }
    wall.triangle(0,1,2) or >>
    wall.triangle(0,2,3) or >>
    << wall
}
fn preview_shadow(selection light_bindings.ShadowSelection3D, sources &[]light_data.Light3D,
    override_count int) light_bindings.ShadowSelection3D {
    if override_count < 0 { << selection }
    if override_count == 0 { << light_bindings.no_shadow_selection() }
    $settings := shadows.default_cascades()
    settings.distance = 18.0
    settings.caster_padding = 4.0
    $source := selection.source
    if selection.cascades.enabled() {
        settings = selection.cascades.settings() or >>
    } else {
        source = -1
        for i in 0:sources.len {
            if sources[i].kind() == light_data.DIRECTIONAL {
                source = i
                <-
            }
        }
        if source < 0 { >> errors.new("scene preview: cascades require a visible directional light") }
    }
    settings.count = override_count
    profile := shadows.cascade_profile(settings) or >>
    << light_bindings.ShadowSelection3D{source: source, cascades: profile, punctual: shadows.PunctualProfile3D{}}
}
fn shadow_description(selection light_bindings.ShadowSelection3D, source light_data.Light3D,
    tree &nexus.SceneTree, camera_node int, aspect f64) shadows.ShadowDescription3D {
    if selection.cascades.enabled() {
        camera := scene_render.cascade_scene_camera(tree, camera_node, aspect) or >>
        settings := selection.cascades.settings() or >>
        << shadows.cascaded(source, camera, settings) or >>
    }
    << selection.punctual.description(source) or >>
}
fn run() int {
    config := options() or >>
    document := files.load(config.path + "") or >>
    $tree := nexus.new_scene_tree_3d("World", 128) or >>
    $light_world := light_bindings.new_scene_lights_3d()
    root := tree.root()
    instance := light_files.instantiate(&document, $&light_world, $&tree, root, "Loaded") or >>
    blue := tree.find_node(instance, "Objects/Blue") or >>
    gold := tree.find_node(instance, "Objects/Gold") or >>
    hidden := tree.find_node(instance, "Objects/Hidden") or >>
    camera_node := tree.find_node(instance, config.camera + "") or >>
    base := (tree.node_3d(blue) or >>).transform
    tree.camera_view_projection_3d(camera_node, 1.0) or >>

    $authored := light_bindings.no_shadow_selection()
    $sources := light_world.gather_with_shadows(&tree, $&authored) or >>
    if document.light_count() == 0 {
        sources = [light_data.directional(fm.vec3(0.4, 0.7, 1.0), fm.vec3(2.5, 2.5, 2.5)) or >>]
    }
    selection := preview_shadow(authored, &sources, config.cascades) or >>
    has_shadow := selection.source >= 0
    mesh_program_0 := mesh_shaders.load_mesh(config.shaders + "") or >>
    $device := ren.open_3d("Xu node scene file | Esc: exit", 960, 640, config.backend, &mesh_program_0) or >>
    println("Scene file GPU backend: " + gpu_info.backend_name(device.backend() or >>))
    source := meshes.sphere_mesh_3d(1.0, 48, 24, colors.rgba8(255, 255, 255, 255) or >>) or >>
    $mesh := device.upload(&source) or >>
    $scene := scene_render.new_scene_3d(&device) or >>
    blue_material := ren.material_3d(fm.vec3(0.05, 0.35, 0.7), 0.0, 0.3, fm.vec3(0.0, 0.0, 0.0)) or >>
    gold_material := ren.material_3d(fm.vec3(0.8, 0.4, 0.08), 0.8, 0.25, fm.vec3(0.0, 0.0, 0.0)) or >>
    // This example provides the procedural mesh and its materials at runtime.
    scene.attach_surface(&tree, blue, &mesh, blue_material) or >>
    scene.attach_surface(&tree, gold, &mesh, gold_material) or >>
    scene.attach_surface(&tree, hidden, &mesh, gold_material) or >>
    $backdrop := []ren.Mesh3D{}
    $shadow_maps := []ren.ShadowMap3D{}
    if has_shadow {
        // Preview geometry stays outside the loaded subtree and its save file.
        wall := shadow_wall() or >>
        uploaded := device.upload(&wall) or >>
        node := tree.add_child_3d(root, "ShadowWall") or >>
        material := ren.material_3d(fm.vec3(0.27,0.31,0.38), 0.0, 0.85, fm.vec3(0.0,0.0,0.0)) or >>
        scene.attach_surface(&tree, node, &uploaded, material) or >>
        backdrop.push(uploaded)
    }
    background := colors.rgba8(12, 20, 34, 255) or >>
    ready := tree.take_ready() or >>
    println("Loaded " + str(document.node_count()) + " nodes; ready=" + str(ready.len) + "; hidden node preserved")
    $frame := 0
    $quit := false
    while !quit && (config.frames == 0 || frame < config.frames) {
        window.pump() or >>
        for i in 0:256 {
            event := device.poll() or >>
            if event.kind == window_events.EVENT_NONE { <- }
            if event.kind == window_events.EVENT_CLOSE_REQUESTED || (event.kind == window_events.EVENT_KEY_DOWN && event.physical_key == window_events.KEY_ESCAPE) { quit = true }
        }
        if quit { <- }
        tree.set_transform_3d(blue, base.multiply(fm.rotation_y(f64(frame) / 60.0 * 0.3))) or >>
        width := device.width() or >>
        height := device.height() or >>
        if width < 1 || height < 1 { sleep_ns(10000000)
            -> }
        aspect := f64(width) / f64(height)
        view := tree.camera_view_projection_3d(camera_node, aspect) or >>
        if has_shadow {
            description := shadow_description(selection, sources[selection.source], &tree, camera_node, aspect) or >>
            if shadow_maps.len == 0 {
                shadow_program := mesh_shaders.load_shadow(config.shaders + "") or >>
                shadow_maps.push(device.shadow_map(description, &shadow_program) or >>)
            }
            casters := scene.shadow_casters(&tree) or >>
            shadow := $&shadow_maps[0]
            shadow.render(&device, &casters, description) or >>
        }
        eye := (tree.global_transform_3d(camera_node) or >>).c3.xyz()
        $candidates := []light_data.Light3D{}
        for source in sources { candidates.push(source) }
        lighting := light_data.environment(fm.vec3(0.15, 0.15, 0.15), eye, 1.0, candidates) or >>
        device.begin(background) or >>
        if has_shadow {
            draws := scene.draw_lit_shadowed($&device, &tree, view, &lighting, &shadow_maps[0], selection.source) or >>
            assert(draws.instances + draws.culled_instances == 3)
        } else {
            draws := scene.draw_lit($&device, &tree, view, lighting) or >>
            assert(draws.instances + draws.culled_instances == 2)
        }
        if config.capture.len > 0 && frame + 1 == config.frames { device.capture(config.capture + "") or >> }
        device.present() or >>
        frame = frame + 1
    }
    if config.save.len > 0 {
        captured := light_files.capture(&document, &light_world, &tree, instance) or >>
        files.save(config.save + "", &captured) or >>
        println("Saved " + str(captured.node_count()) + " nodes to " + config.save)
    }
    for i in 0:shadow_maps.len {
        shadow := $&shadow_maps[i]
        shadow.close() or >>
    }
    for i in 0:backdrop.len {
        wall := $&backdrop[i]
        wall.close() or >>
    }
    mesh.close() or >>
    device.close() or >>
    println("Finished " + str(frame) + " persisted-scene frames")
    << 0
}
fn main() int { << run() or (err) { eprintln(err.msg())
    << 1 } }
