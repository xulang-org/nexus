@main

game #"github.com/xulang-org/game"

fn run() int {
    $tree := game.new_scene_tree("World", 128) or >>
    player := tree.add_child(tree.root(), "Player") or >>
    tree.set_position(player, game.vec2(16.0, 20.0)) or >>
    $clock := game.new_clock(60, 8) or >>
    solids := [game.rect2(100.0, 0.0, 10.0, 200.0)]
    for frame in 0:120 {
        tick := clock.advance(1.0 / 60.0) or >>
        for step in 0:tick.steps {
            node := tree.node(player) or >>
            body := game.rect2(node.transform.tx, node.transform.ty, 16.0, 16.0)
            result := game.move_and_slide(body, game.vec2(120.0 * tick.fixed_delta, 0.0), &solids) or >>
            tree.set_position(player, result.position) or >>
        }
    }
    final := tree.global_transform(player) or >>
    assert(final.tx > 83.99 && final.tx <= 84.0)
    println("Headless: 120 fixed ticks, player stopped at the wall")
    << 0
}
fn main() int { << run() or (err) { eprintln(err.msg())
    << 1 } }
