@main

physics2d #"github.com/xulang-org/nexus/physics2d"
timing #"github.com/xulang-org/nexus/timing"
fm #"github.com/xulang-org/nexus/foundation/math"
nexus #"github.com/xulang-org/nexus/scene"

fn run() int {
    $tree := nexus.new_scene_tree("World", 128) >>>
    player := tree.add_child(tree.root(), "Player") >>>
    tree.set_position(player, fm.vec2(16.0, 20.0)) >>>
    $clock := timing.new_clock(60, 8) >>>
    solids := [fm.rect2(100.0, 0.0, 10.0, 200.0)]
    for frame in 0:120 {
        tick := clock.advance(1.0 / 60.0) >>>
        for step in 0:tick.steps {
            node := tree.node(player) >>>
            body := fm.rect2(node.transform.tx, node.transform.ty, 16.0, 16.0)
            result := physics2d.move_and_slide(body, fm.vec2(120.0 * tick.fixed_delta, 0.0), &solids) >>>
            tree.set_position(player, result.position) >>>
        }
    }
    final := tree.global_transform(player) >>>
    assert(final.tx > 83.99 && final.tx <= 84.0)
    println("Headless: 120 fixed ticks, player stopped at the wall")
    << 0
}
fn main() int { << run() >>> (err) { eprintln(err.msg())
    << 1 } }
