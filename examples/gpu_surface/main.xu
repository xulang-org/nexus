@main

#gpu
#window
#os
#errors
#strconv
#time

// A standalone standard-library consumer: no engine source or native bridge.
fn shader_bytes(path string) []u8 {
    $file := os.open(path) >>>
    $output := []u8{}
    while output.len <= 1048576 {
        chunk := file.read(65536) >>>
        if chunk.len == 0 { <- }
        if chunk.len > 1048576 - output.len { >>> errors.new("shader exceeds example's 1 MiB budget") }
        for i in 0:chunk.len { output.push(u8(chunk[i])) }
    }
    file.close() >>>
    if output.len == 0 { >>> errors.new("empty shader") }
    << output
}

fn run() int {
    args := os.args()
    $backend := gpu.AUTO
    $directory := "build/gpu-surface-shaders"
    $frames := 240
    $i := 1
    while i < args.len {
        if i + 1 >= args.len { >>> errors.new("missing option value") }
        if args[i] == "--shaders" { directory = args[i+1] + ""
        } else if args[i] == "--frames" {
            value := args[i+1]
            frames = strconv.atoi(&value) >>>
            if frames < 1 || frames > 1000000 { >>> errors.new("frames must be 1...1000000") }
        } else if args[i] == "--backend" {
            if args[i+1] == "metal" { backend = gpu.METAL
            } else if args[i+1] == "vulkan" { backend = gpu.VULKAN
            } else if args[i+1] == "d3d12" { backend = gpu.D3D12
            } else if args[i+1] != "auto" { >>> errors.new("unknown GPU backend") }
        } else { >>> errors.new("unknown option: " + args[i]) }
        i += 2
    }
    options := window.Options{title: "Xu Standard GPU Surface", width: 640, height: 360,
        resizable: true, high_pixel_density: true, hidden: false}
    $target := window.open(&options) >>>
    $device := gpu.open(gpu.DeviceOptions{backend: backend, debug: true, shader_formats: 0}) >>>
    $surface := device.surface(&target, gpu.SurfaceOptions{present_mode: gpu.PRESENT_VSYNC}) >>>
    selected := device.backend() >>>
    $shader_format := gpu.SHADER_MSL
    $entrypoint := "main0"
    $name := "Metal"
    if selected == gpu.VULKAN { shader_format = gpu.SHADER_SPIRV
        entrypoint = "main"
        name = "Vulkan"
    } else if selected == gpu.D3D12 { shader_format = gpu.SHADER_DXIL
        entrypoint = "main"
        name = "D3D12" }
    vertex_code := shader_bytes(directory + "/triangle.vert.bin") >>>
    fragment_code := shader_bytes(directory + "/triangle.frag.bin") >>>
    vd := gpu.ShaderDesc{stage: gpu.VERTEX, format: shader_format, entrypoint: entrypoint + "",
        samplers: 0, uniform_sizes: []int{}}
    fd := gpu.ShaderDesc{stage: gpu.FRAGMENT, format: shader_format, entrypoint: entrypoint,
        samplers: 0, uniform_sizes: []int{}}
    $vertex := device.shader(&vd, &vertex_code) >>>
    $fragment := device.shader(&fd, &fragment_code) >>>
    format := surface.format() >>>
    desc := gpu.pipeline_defaults(format)
    $pipeline := device.graphics_pipeline(&vertex, &fragment, &desc) >>>
    vertex.close() >>>
    fragment.close() >>>
    $presented := 0
    for attempt in 0:frames {
        window.pump() >>>
        state := target.state() >>>
        if state.close_requested { <- }
        $frame := surface.acquire() >>>
        if !frame.has_image() { time.sleep(16000000)
            -> }
        if frame.format() != format { >>> errors.new("surface format changed; pipeline must be rebuilt") }
        $pass := frame.begin_render(gpu.CLEAR, gpu.Color{r: 0.0, g: 0.0, b: 1.0, a: 1.0}, gpu.no_depth()) >>>
        pass.pipeline(&pipeline) >>>
        $left := frame.width()/2
        if left < 1 { left = 1 }
        pass.scissor(0, 0, left, frame.height()) >>>
        pass.draw(3, 0, 1, 0) >>>
        pass.end() >>>
        $fence := frame.present() >>>
        // Release the fence owner; presentation itself remains asynchronous.
        fence.close() >>>
        presented += 1
    }
    pipeline.close() >>>
    surface.close() >>>
    stats := device.stats() >>>
    if stats.surface_count != 0 || stats.frame_count != 0 || stats.encoder_count != 0 ||
        stats.pipeline_count != 0 || stats.shader_count != 0 || stats.submission_count != 0 {
        >>> errors.new("presentation left live GPU owners")
    }
    device.close() >>>
    target.close() >>>
    remaining := window.live_count() >>>
    if remaining != 0 { >>> errors.new("presentation left live window owners") }
    println("Presented standard GPU window with zero live window/surface/frame resources on " + name)
    println(presented)
    << 0
}

fn main() int {
    << run() >>> (err) { eprintln(err.msg())
        << 1 }
}
