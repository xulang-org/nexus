@main

light_data #"github.com/xulang-org/game/resources/lighting"
light_files #"github.com/xulang-org/game/integration/scene_lighting"
scene_lights #"github.com/xulang-org/game/integration/lighting"

#gpu

gpu_info #"github.com/xulang-org/game/platform/gpu"

#window
window_events #window/events
mesh_shaders #"github.com/xulang-org/game/assets/shaders/three_d"

timing #"github.com/xulang-org/game/timing"
loader #"github.com/xulang-org/game/integration/scene_render"
scripting #"github.com/xulang-org/game/integration/scene_script"
worlds #"github.com/xulang-org/game/integration/scene_audio"
audio #"github.com/xulang-org/game/audio"
game #"github.com/xulang-org/game/scene"
fm #"github.com/xulang-org/game/foundation/math"
colors #"github.com/xulang-org/game/foundation/color"
ren #"github.com/xulang-org/game/rendering/three_d"
scene_render #"github.com/xulang-org/game/integration/rendering/three_d"
#os
#strconv
#errors

struct Options { path string
    save string
    capture string
    shaders string
    frames int
    backend int
    reload_at int
    reload_from string }
fn options() Options {
    args := os.args()
    $config := Options{path: "build/scene-scripts/world.xuscene", save: "", capture: "", shaders: "build/mesh-shaders", frames: 0, backend: gpu.AUTO, reload_at: 0, reload_from: ""}
    $i := 1
    while i < args.len {
        if i + 1 >= args.len { >> errors.new("missing option value") }
        next := i + 1
        if args[i] == "--scene" { config.path = args[next] + ""
        } else if args[i] == "--save" { config.save = args[next] + ""
        } else if args[i] == "--shaders" { config.shaders = args[next] + ""
        } else if args[i] == "--capture" { config.capture = args[next] + ""
        } else if args[i] == "--reload-from" { config.reload_from = args[next] + ""
        } else if args[i] == "--reload-at" { config.reload_at = strconv.atoi(&args[next]) or >>
            if config.reload_at < 1 { >> errors.new("invalid reload frame") }
        } else if args[i] == "--frames" {
            config.frames = strconv.atoi(&args[next]) or >>
            if config.frames < 1 || config.frames > 1000000 { >> errors.new("invalid frames") }
        } else if args[i] == "--backend" {
            if args[next] == "metal" { config.backend = gpu.METAL
            } else if args[next] == "vulkan" { config.backend = gpu.VULKAN
            } else if args[next] == "d3d12" { config.backend = gpu.D3D12
            } else if args[next] != "auto" { >> errors.new("unknown backend") }
        } else { >> errors.new("unknown option: " + args[i]) }
        i = i + 2
    }
    if config.capture.len > 0 && config.frames == 0 { >> errors.new("capture requires --frames") }
    if config.reload_at > 0 && config.reload_from.len == 0 { >> errors.new("reload frame requires a prepared bytecode path") }
    << config
}
fn run() int {
    config := options() or >>
    mesh_program_0 := mesh_shaders.load_mesh(config.shaders + "") or >>
    $device := ren.open_3d("Xu restored node scripts, audio and surfaces | Esc: exit", 1200, 720, config.backend, &mesh_program_0) or >>
    println("Persisted surface GPU backend: " + gpu_info.backend_name(device.backend() or >>))
    $world := worlds.load_audio(config.path + "", 48000) or >>
    document := world.capture() or >>
    $models := loader.prepare_surfaces(&device, document, world.base_directory()) or >>
    instance := world.root()
    $scene := scene_render.new_scene_3d(&device) or >>
    models.bind($&scene, &world.tree, instance) or >>
    script_document := world.capture() or >>
    $scripts := scripting.prepare_scripts(script_document, world.base_directory()) or >>
    scripts.bind(&world.tree, instance) or >>
    light_document := world.capture() or >>
    $light_world := scene_lights.new_scene_lights_3d()
    light_files.bind(&light_document,$&light_world,&world.tree,instance) or >>
    normal_node := world.tree.find_child(instance, "Normal") or >>
    base_pose := (world.tree.node_3d(normal_node) or >>).transform
    camera_node := world.tree.find_child(instance, "Camera") or >>
    camera := game.new_camera_node_3d(&world.tree, camera_node) or >>
    tree := $&world.tree
    ready := tree.take_ready() or >>
    $output := audio.open_output(48000) or >>
    println("Restored AV audio driver: " + (output.driver_name() or >>))
    world.pump(&output, 2048, 512) or >>
    output.pause(false) or >>
    println("Restored " + str(ready.len) + " ready nodes, " + str(models.surface_count()) + " surfaces, " + str(models.model_count()) + " shared GLB model")
    background := colors.rgba8(12, 20, 34, 255) or >>
    $clock := timing.new_clock(60, 8) or >>
    $last := now_ns()
    $frame := 0
    $quit := false
    while !quit && (config.frames == 0 || frame < config.frames) {
        window.pump() or >>
        for i in 0:256 {
            event := device.poll() or >>
            if event.kind == window_events.EVENT_NONE { <- }
            if event.kind == window_events.EVENT_CLOSE_REQUESTED || (event.kind == window_events.EVENT_KEY_DOWN && event.physical_key == window_events.KEY_ESCAPE) { quit = true }
        }
        if quit { <- }
        if config.reload_at > 0 && frame == config.reload_at {
            changed := scripts.reload_from(&world.tree, "55005500550055005500550055005500", config.reload_from + "") or >>
            println("Reloaded scene script attachments=" + str(changed) + "; epoch=" + str(scripts.epoch(0) or >>) + "; preserved calls=" + str(scripts.calls(0) or >>))
        }
        now := now_ns()
        $delta := f64(now - last) / 1000000000.0
        last = now
        if config.frames > 0 { delta = 1.0 / 60.0 }
        ticks := clock.advance(delta) or >>
        for step in 0:ticks.steps {
            scripts.physics_process(&world.tree, 0, ticks.fixed_delta, 1.0) or >>
            report := scripts.dispatch(&world.tree, 64) or >>
            if report.rejected > 0 { >> errors.new(report.first_error + "") }
        }
        angle := (scripts.state(0, 2) or >>) * 0.2
        pose := base_pose.multiply(fm.rotation_y(angle))
        current_tree := $&world.tree
        current_tree.set_transform_3d(normal_node, pose) or >>
        width := device.width() or >>
        height := device.height() or >>
        if width < 1 || height < 1 { sleep_ns(10000000)
            -> }
        view := camera.view_projection(&world.tree, f64(width) / f64(height)) or >>
        eye := (world.tree.global_transform_3d(camera_node) or >>).c3.xyz()
        lighting := light_data.environment(fm.vec3(0.15, 0.15, 0.15), eye, 1.0, light_world.gather(&world.tree) or >>) or >>
        world.pump(&output, 2048, 512) or >>
        device.begin(background) or >>
        draws := scene.draw_lit($&device, &world.tree, view, &lighting) or >>
        assert((draws.instances+draws.culled_instances) == 8 && (draws.triangles+draws.culled_triangles) == 16)
        if config.capture.len > 0 && frame + 1 == config.frames { device.capture(config.capture + "") or >> }
        device.present() or >>
        frame = frame + 1
    }
    if config.save.len > 0 {
        scripts.save(config.save + "", &world.tree) or >>
        println("Saved resource IDs, source hashes and surface attachments to " + config.save)
    }
    output.pause(true) or >>
    output.clear() or >>
    output.close() or >>
    println("Script scene: calls=" + str(scripts.calls(0) or >>) + "; received=" + str(int(scripts.state(1, 1) or >>)) + "; epoch=" + str(scripts.epoch(0) or >>) + "; last=" + (strconv.format_float(scripts.state(1, 2) or >>, 103, -1) or >>))
    scripts.close() or >>
    world.close() or >>
    models.close() or >>
    device.close() or >>
    println("Finished " + str(frame) + " restored scripted AV frames")
    << 0
}
fn main() int { << run() or (err) { eprintln(err.msg())
    << 1 } }
