@main

light_data #"github.com/xulang-org/nexus/resources/lighting"
light_files #"github.com/xulang-org/nexus/integration/scene_lighting"
scene_lights #"github.com/xulang-org/nexus/integration/lighting"

#gpu

gpu_info #"github.com/xulang-org/nexus/platform/gpu"

#window
window_events #window/events
mesh_shaders #"github.com/xulang-org/nexus/assets/shaders/three_d"

timing #"github.com/xulang-org/nexus/timing"
loader #"github.com/xulang-org/nexus/integration/scene_render"
scripting #"github.com/xulang-org/nexus/integration/scene_script"
worlds #"github.com/xulang-org/nexus/integration/scene_audio"
audio #"github.com/xulang-org/nexus/audio"
fm #"github.com/xulang-org/nexus/foundation/math"
colors #"github.com/xulang-org/nexus/foundation/color"
ren #"github.com/xulang-org/nexus/rendering/three_d"
scene_render #"github.com/xulang-org/nexus/integration/rendering/three_d"
#os
#strconv
#errors

struct Options { path string
    save string
    capture string
    shaders string
    frames int
    backend int
    reload_at int
    reload_from string }
fn options() Options {
    args := os.args()
    $config := Options{path: "build/scene-scripts/world.xuscene", save: "", capture: "", shaders: "build/mesh-shaders", frames: 0, backend: gpu.AUTO, reload_at: 0, reload_from: ""}
    $i := 1
    while i < args.len {
        if i + 1 >= args.len { >> errors.new("missing option value") }
        next := i + 1
        if args[i] == "--scene" { config.path = args[next] + ""
        } else if args[i] == "--save" { config.save = args[next] + ""
        } else if args[i] == "--shaders" { config.shaders = args[next] + ""
        } else if args[i] == "--capture" { config.capture = args[next] + ""
        } else if args[i] == "--reload-from" { config.reload_from = args[next] + ""
        } else if args[i] == "--reload-at" { config.reload_at = strconv.atoi(&args[next]) >>>
            if config.reload_at < 1 { >> errors.new("invalid reload frame") }
        } else if args[i] == "--frames" {
            config.frames = strconv.atoi(&args[next]) >>>
            if config.frames < 1 || config.frames > 1000000 { >> errors.new("invalid frames") }
        } else if args[i] == "--backend" {
            if args[next] == "metal" { config.backend = gpu.METAL
            } else if args[next] == "vulkan" { config.backend = gpu.VULKAN
            } else if args[next] == "d3d12" { config.backend = gpu.D3D12
            } else if args[next] != "auto" { >> errors.new("unknown backend") }
        } else { >> errors.new("unknown option: " + args[i]) }
        i = i + 2
    }
    if config.capture.len > 0 && config.frames == 0 { >> errors.new("capture requires --frames") }
    if config.reload_at > 0 && config.reload_from.len == 0 { >> errors.new("reload frame requires a prepared bytecode path") }
    << config
}
fn run() int {
    config := options() >>>
    mesh_program_0 := mesh_shaders.load_mesh(config.shaders + "") >>>
    $device := ren.open_3d("Xu restored node scripts, audio and surfaces | Esc: exit", 1200, 720, config.backend, &mesh_program_0) >>>
    println("Persisted surface GPU backend: " + gpu_info.backend_name(device.backend() >>>))
    $world := worlds.load_audio(config.path + "", 48000) >>>
    document := world.capture() >>>
    $models := loader.prepare_surfaces(&device, document, world.base_directory()) >>>
    instance := world.root()
    $scene := scene_render.new_scene_3d(&device) >>>
    models.bind($&scene, &world.tree, instance) >>>
    script_document := world.capture() >>>
    $scripts := scripting.prepare_scripts(script_document, world.base_directory()) >>>
    scripts.bind(&world.tree, instance) >>>
    light_document := world.capture() >>>
    $light_world := scene_lights.new_scene_lights_3d()
    light_files.bind(&light_document,$&light_world,&world.tree,instance) >>>
    normal_node := world.tree.find_child(instance, "Normal") >>>
    base_pose := (world.tree.node_3d(normal_node) >>>).transform
    camera_node := world.tree.find_child(instance, "Camera") >>>
    world.tree.camera_view_projection_3d(camera_node, 1.0) >>>
    tree := $&world.tree
    ready := tree.take_ready() >>>
    $output := audio.open_output(48000) >>>
    println("Restored AV audio driver: " + (output.driver_name() >>>))
    world.pump(&output, 2048, 512) >>>
    output.pause(false) >>>
    println("Restored " + str(ready.len) + " ready nodes, " + str(models.surface_count()) + " surfaces, " + str(models.model_count()) + " shared GLB model")
    background := colors.rgba8(12, 20, 34, 255) >>>
    $clock := timing.new_clock(60, 8) >>>
    $last := now_ns()
    $frame := 0
    $quit := false
    while !quit && (config.frames == 0 || frame < config.frames) {
        window.pump() >>>
        for i in 0:256 {
            event := device.poll() >>>
            if event.kind == window_events.EVENT_NONE { <- }
            if event.kind == window_events.EVENT_CLOSE_REQUESTED || (event.kind == window_events.EVENT_KEY_DOWN && event.physical_key == window_events.KEY_ESCAPE) { quit = true }
        }
        if quit { <- }
        if config.reload_at > 0 && frame == config.reload_at {
            changed := scripts.reload_from(&world.tree, "55005500550055005500550055005500", config.reload_from + "") >>>
            println("Reloaded scene script attachments=" + str(changed) + "; epoch=" + str(scripts.epoch(0) >>>) + "; preserved calls=" + str(scripts.calls(0) >>>))
        }
        now := now_ns()
        $delta := f64(now - last) / 1000000000.0
        last = now
        if config.frames > 0 { delta = 1.0 / 60.0 }
        ticks := clock.advance(delta) >>>
        for step in 0:ticks.steps {
            scripts.physics_process(&world.tree, 0, ticks.fixed_delta, 1.0) >>>
            report := scripts.dispatch(&world.tree, 64) >>>
            if report.rejected > 0 { >> errors.new(report.first_error + "") }
        }
        angle := (scripts.state(0, 2) >>>) * 0.2
        pose := base_pose.multiply(fm.rotation_y(angle))
        current_tree := $&world.tree
        current_tree.set_transform_3d(normal_node, pose) >>>
        width := device.width() >>>
        height := device.height() >>>
        if width < 1 || height < 1 { sleep_ns(10000000)
            -> }
        view := world.tree.camera_view_projection_3d(camera_node, f64(width) / f64(height)) >>>
        eye := (world.tree.global_transform_3d(camera_node) >>>).c3.xyz()
        scene.select_lods(&world.tree, eye) >>>
        lighting := light_data.environment(fm.vec3(0.15, 0.15, 0.15), eye, 1.0, light_world.gather(&world.tree) >>>) >>>
        world.pump(&output, 2048, 512) >>>
        device.begin(background) >>>
        scene.draw_lit($&device, &world.tree, view, &lighting) >>>
        if config.capture.len > 0 && frame + 1 == config.frames { device.capture(config.capture + "") >>> }
        device.present() >>>
        frame = frame + 1
    }
    if config.save.len > 0 {
        scripts.save(config.save + "", &world.tree) >>>
        println("Saved resource IDs, source hashes and surface attachments to " + config.save)
    }
    output.pause(true) >>>
    output.clear() >>>
    output.close() >>>
    println("Script scene: calls=" + str(scripts.calls(0) >>>) + "; received=" + str(int(scripts.state(1, 1) >>>)) + "; epoch=" + str(scripts.epoch(0) >>>) + "; last=" + (strconv.format_float(scripts.state(1, 2) >>>, 103, -1) >>>))
    scripts.close() >>>
    world.close() >>>
    models.close() >>>
    device.close() >>>
    println("Finished " + str(frame) + " restored scripted AV frames")
    << 0
}
fn main() int { << run() >>> (err) { eprintln(err.msg())
    << 1 } }
