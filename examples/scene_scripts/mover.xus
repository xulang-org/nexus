@scripts/scene_mover

pub struct Mover {
    pub ticks f64
    pub distance f64
    pub speed f64
}
fn (self $&Mover) physics_process(delta f64, axis f64) f64 {
    self.ticks += 1.0
    movement := axis * self.speed * delta
    self.distance += movement
    emit_signal("moved", movement)
    << movement
}
