@main

audio #"github.com/xulang-org/game/audio"
mix #"github.com/xulang-org/game/audio/mixer"
assets #"github.com/xulang-org/game/assets/audio"
#os
#strconv
#errors

fn run() int {
    args := os.args()
    $seconds := 5
    $path := "examples/audio/assets/chime.wav"
    $i := 1
    while i < args.len {
        if i + 1 >= args.len { >> errors.new("missing audio demo option value") }
        next := i + 1
        if args[i] == "--seconds" { seconds = strconv.atoi(&args[next]) or >>
            if seconds < 1 || seconds > 60 { >> errors.new("seconds outside 1...60") }
        } else if args[i] == "--file" { path = args[next] + ""
        } else { >> errors.new("unknown audio demo option") }
        i = i + 2
    }
    clip := assets.load_wav(path) or >>
    $mixer := mix.new_mixer(48000, 32) or >>
    music := mixer.add_bus(0, "Music", 0.5) or >>
    clip_id := mixer.add_clip(clip) or >>
    voice := mixer.play(clip_id, music, 0.35, 0.0, true) or >>
    $output := audio.open_output(48000) or >>
    println("Audio driver: " + (output.driver_name() or >>))
    audio.pump(&output, $&mixer, 2048, 512) or >>
    output.pause(false) or >>
    start := now_ns()
    $blocks := 0
    $last_phase := -1
    while now_ns() - start < seconds * 1000000000 {
        elapsed := now_ns() - start
        phase := int(elapsed / 1000000000)
        if phase != last_phase {
            if phase % 4 == 1 { mixer.set_pan(voice, -0.8) or >>
            } else if phase % 4 == 2 { mixer.set_pan(voice, 0.8) or >>
            } else { mixer.set_pan(voice, 0.0) or >> }
            last_phase = phase
        }
        report := audio.pump(&output, $&mixer, 2048, 512) or >>
        blocks = blocks + report.blocks
        sleep_ns(5000000)
    }
    output.pause(true) or >>
    output.clear() or >>
    output.close() or >>
    println("Finished audio demo; submitted " + str(blocks) + " refill blocks")
    << 0
}
fn main() int { << run() or (err) { eprintln(err.msg())
    << 1 } }
