@main

audio #"github.com/xulang-org/nexus/audio"
mix #"github.com/xulang-org/nexus/audio/mixer"
assets #"github.com/xulang-org/nexus/assets/audio"
#os
#strconv
#errors

fn run() int {
    args := os.args()
    $seconds := 5
    $path := "examples/audio/assets/chime.wav"
    $i := 1
    while i < args.len {
        if i + 1 >= args.len { >>> errors.new("missing audio demo option value") }
        next := i + 1
        if args[i] == "--seconds" { seconds = strconv.atoi(&args[next]) >>>
            if seconds < 1 || seconds > 60 { >>> errors.new("seconds outside 1...60") }
        } else if args[i] == "--file" { path = args[next] + ""
        } else { >>> errors.new("unknown audio demo option") }
        i = i + 2
    }
    clip := assets.load_wav(path) >>>
    $mixer := mix.new_mixer(48000, 32) >>>
    music := mixer.add_bus(0, "Music", 0.5) >>>
    clip_id := mixer.add_clip(clip) >>>
    voice := mixer.play(clip_id, music, 0.35, 0.0, true) >>>
    $output := audio.open_output(48000) >>>
    println("Audio driver: " + (output.driver_name() >>>))
    audio.pump(&output, $&mixer, 2048, 512) >>>
    output.pause(false) >>>
    start := now_ns()
    $blocks := 0
    $last_phase := -1
    while now_ns() - start < seconds * 1000000000 {
        elapsed := now_ns() - start
        phase := int(elapsed / 1000000000)
        if phase != last_phase {
            if phase % 4 == 1 { mixer.set_pan(voice, -0.8) >>>
            } else if phase % 4 == 2 { mixer.set_pan(voice, 0.8) >>>
            } else { mixer.set_pan(voice, 0.0) >>> }
            last_phase = phase
        }
        report := audio.pump(&output, $&mixer, 2048, 512) >>>
        blocks = blocks + report.blocks
        sleep_ns(5000000)
    }
    output.pause(true) >>>
    output.clear() >>>
    output.close() >>>
    println("Finished audio demo; submitted " + str(blocks) + " refill blocks")
    << 0
}
fn main() int { << run() >>> (err) { eprintln(err.msg())
    << 1 } }
