@beacon_ctrl
struct BeaconCtrl {
    pulse f64
}
pub fn (self $&BeaconCtrl) physics_process(delta f64, axis f64) f64 {
    self.pulse = self.pulse + delta * (1.0 + axis * 0.25)
    << self.pulse
}
pub fn (self $&BeaconCtrl) beacon_pulse(rate f64) f64 {
    vfx_burst(0.0, 8.0)
    self.pulse = self.pulse + rate
    yield_frame()
    vfx_burst(0.0, 8.0)
    self.pulse = self.pulse + rate
    << self.pulse
}
