@main

fm #"github.com/xulang-org/nexus/foundation/math"
physics #"github.com/xulang-org/nexus/physics2d"
files #"github.com/xulang-org/nexus/internal/file_snapshot"
#encoding/json
#errors
#os
#strconv

struct IsometricCheckpoint {
    hero fm.Vec2
    camera fm.Vec2
    paused bool
}

fn position_field(data &json.Doc, index int) fm.Vec2 {
    if !data.is_list(index) || data.count(index) != 2 { >> errors.new("invalid checkpoint position") }
    x := data.as_f64(data.at(index, 0)) >>>
    y := data.as_f64(data.at(index, 1)) >>>
    if !fm.finite(x) || !fm.finite(y) { >> errors.new("invalid checkpoint coordinate") }
    << fm.vec2(x, y)
}

fn decode_isometric_checkpoint(raw &string, scene_key &string, level &string, initial IsometricCheckpoint) IsometricCheckpoint {
    data := json.parse_max(raw, 1024)
    root := data.root()
    if !data.ok() || !data.is_dict(root) { >> errors.new("invalid checkpoint object") }
    if level.len > 0 {
        map_id := data.get(root, "map")
        if data.count(root) != 6 || map_id < 0 || (data.as_string(map_id) >>>) != *level { << initial }
    } else if data.count(root) != 5 { >> errors.new("invalid checkpoint object") }
    version := data.get(root, "version")
    scene := data.get(root, "scene")
    hero := data.get(root, "hero")
    camera := data.get(root, "camera")
    pause := data.get(root, "paused")
    if version < 0 || scene < 0 || hero < 0 || camera < 0 || pause < 0 {
        >> errors.new("missing checkpoint field")
    }
    if (data.as_int(version) >>>) != 1 { >> errors.new("unsupported checkpoint version") }
    if (data.as_string(scene) >>>) != *scene_key { << initial }
    << IsometricCheckpoint{hero: position_field(&data, hero) >>>,
        camera: position_field(&data, camera) >>>, paused: data.as_bool(pause) >>>}
}

fn load_isometric_checkpoint(path string, scene_key &string, level &string, initial IsometricCheckpoint,
    hero_parent fm.Transform2D, colliders &[]physics.TileMapCollider2D, footprint fm.Vec2) IsometricCheckpoint {
    raw := files.read(path, 1024) >>> (err) {
        if !os.is_not_exist(err.msg()) { eprintln("Isometric checkpoint: " + err.msg()) }
        << initial
    }
    state := decode_isometric_checkpoint(&raw, scene_key, level, initial) >>> (err) {
        eprintln("Isometric checkpoint: " + err.msg())
        << initial
    }
    if colliders.len > 0 {
        // The same footprint used for movement must start clear of solids.
        colliders[0].move_and_slide(hero_parent.point(state.hero), fm.vec2(0.0, 0.0), footprint) >>> (err) {
            eprintln("Isometric checkpoint: " + err.msg())
            << initial
        }
    }
    << state
}

fn encode_position(position fm.Vec2) string {
    x := strconv.format_float(position.x, 103, -1) >>>
    y := strconv.format_float(position.y, 103, -1) >>>
    << "[" + x + "," + y + "]"
}

fn write_isometric_checkpoint(path string, scene_key &string, level &string, state IsometricCheckpoint) int {
    hero := encode_position(state.hero) >>>
    camera := encode_position(state.camera) >>>
    $header := "{\"version\":1"
    if level.len > 0 { header = header + ",\"map\":" + json.quote(level) }
    raw := header + ",\"scene\":\"" + *scene_key + "\",\"hero\":" + hero + ",\"camera\":" + camera +
        ",\"paused\":" + str(state.paused) + "}\n"
    << files.write_atomic(path, &raw) >>>
}

fn persist_isometric_checkpoint(path string, scene_key &string, level &string, state IsometricCheckpoint) {
    write_isometric_checkpoint(path, scene_key, level, state) >>> (err) {
        eprintln("Isometric checkpoint: " + err.msg())
        <<
    }
}
