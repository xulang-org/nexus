@main
#gpu
#window
window_events #window/events
#os
#strconv
#math
#errors
lod #"github.com/xulang-org/nexus/resources/lod"
meshes #"github.com/xulang-org/nexus/resources/mesh"
lights #"github.com/xulang-org/nexus/resources/lighting"
ren #"github.com/xulang-org/nexus/rendering/three_d"
scene_render #"github.com/xulang-org/nexus/integration/rendering/three_d"
shaders #"github.com/xulang-org/nexus/assets/shaders/three_d"
nexus #"github.com/xulang-org/nexus/scene"
fm #"github.com/xulang-org/nexus/foundation/math"
controls #"github.com/xulang-org/nexus/input"
input_bridge #"github.com/xulang-org/nexus/integration/input"
fn run() int {
    args := os.args()
    $frames := 0
    $distance := 18.0
    $capture := ""
    $mode := "lod"
    $shader_path := "build/mesh-shaders"
    $backend := gpu.AUTO
    $i := 1
    while i<args.len {
        if i+1>=args.len { >> errors.new("missing option value") }
        value := args[i+1]+""
        if args[i]=="--frames" { frames=strconv.atoi(&value) or >>
            if frames<1 || frames>1000000 { >> errors.new("invalid frame count") }
        } else if args[i]=="--distance" { distance=strconv.parse_float(&value) or >>
            if !fm.finite(distance) || distance<3.0 || distance>60.0 { >> errors.new("distance must be within 3...60") }
        } else if args[i]=="--mode" { mode=value
            if mode!="lod" && mode!="high" { >> errors.new("mode must be lod or high") }
        } else if args[i]=="--capture" { capture=value
        } else if args[i]=="--shaders" { shader_path=value
        } else if args[i]=="--backend" {
            if value=="metal" { backend=gpu.METAL
            } else if value=="vulkan" { backend=gpu.VULKAN
            } else if value=="d3d12" { backend=gpu.D3D12
            } else if value!="auto" { >> errors.new("unknown GPU backend") }
        } else { >> errors.new("unknown option") }
        i+=2
    }
    if capture.len>0 && frames==0 { >> errors.new("capture requires bounded frames") }
    program := shaders.load_mesh(shader_path) or >>
    $device := ren.open_3d("Xu distance LOD | Up/Down: near/far | Esc: exit",1100,720,backend,&program) or >>
    high_data := meshes.sphere_mesh_3d(0.65,48,24,4294967295) or >>
    medium_data := meshes.sphere_mesh_3d(0.65,16,8,4294967295) or >>
    low_data := meshes.sphere_mesh_3d(0.65,8,4,4294967295) or >>
    $high := device.upload(&high_data) or >>
    $medium := device.upload(&medium_data) or >>
    $low := device.upload(&low_data) or >>
    policy := lod.distance_lod([12.0,22.0],0.1) or >>
    $tree := nexus.new_scene_tree_3d("LOD",32) or >>
    $scene := scene_render.new_scene_3d(&device) or >>
    $nodes := []int{}
    for row in 0:3 {
        for column in 0:5 {
            node := tree.add_child_3d(tree.root(),"Sphere"+str(row*5+column)) or >>
            tree.set_position_3d(node,fm.vec3((f64(column)-2.0)*1.6,(1.0-f64(row))*1.65,0.0)) or >>
            if mode=="lod" { scene.attach_lods(&tree,node,[high.reference(),medium.reference(),low.reference()],&policy) or >>
            } else { scene.attach_mesh(&tree,node,&high) or >> }
            $base := fm.vec3(0.55,0.14,0.045)
            if row==1 { base=fm.vec3(0.045,0.35,0.5) }
            if row==2 { base=fm.vec3(0.6,0.45,0.12) }
            material := ren.material_3d(base,f64(row)/2.0,0.1+f64(column)*0.225,fm.vec3(0.0,0.0,0.0)) or >>
            scene.set_material(&tree,node,material) or >>
            nodes.push(node)
        }
    }
    $input := controls.new_input_map()
    input.bind("near",window_events.KEY_UP) or >>
    input.bind("far",window_events.KEY_DOWN) or >>
    input.bind("quit",window_events.KEY_ESCAPE) or >>
    $frame := 0
    $quit := false
    $last := now_ns()
    $counts := [0,0,0]
    $submitted := 0
    $culled := 0
    $triangles := 0
    $saved := 0
    $coarse := 0
    camera := nexus.new_camera_3d()
    while !quit && (frames==0 || frame<frames) {
        input.begin_frame()
        window.pump() or >>
        for poll in 0:256 {
            event := device.poll() or >>
            if event.kind==window_events.EVENT_NONE { <- }
            if event.kind==window_events.EVENT_CLOSE_REQUESTED { quit=true }
            input_bridge.apply_window_input($&input,&event) or >>
        }
        if input.just_pressed("quit") or >> { quit=true }
        if quit { <- }
        now := now_ns()
        $delta := math.min(0.1,f64(now-last)/1000000000.0)
        last=now
        if frames>0 { delta=1.0/60.0 }
        distance=math.max(3.0,math.min(60.0,distance+(input.axis("near","far") or >>)*delta*6.0))
        eye := fm.vec3(0.0,0.5,distance)
        for j in 0:nodes.len {
            $world := fm.rotation_y(f64(frame)*0.007)
            world.c3=fm.vec4((f64(j%5)-2.0)*1.6,(1.0-f64(j/5))*1.65,0.0,1.0)
            tree.set_transform_3d(nodes[j],world) or >>
        }
        selected := scene.select_lods(&tree,eye) or >>
        counts=[selected.levels[0],selected.levels[1],selected.levels[2]]
        width := device.width() or >>
        height := device.height() or >>
        if width<1 || height<1 { sleep_ns(10000000)
            -> }
        view := nexus.look_at_3d(eye,fm.vec3(0.0,0.0,0.0),fm.vec3(0.0,1.0,0.0)) or >>
        projection := nexus.perspective_3d(camera.vertical_fov,f64(width)/f64(height),camera.near,camera.far) or >>
        environment := lights.environment(fm.vec3(0.03,0.03,0.03),eye,1.0,
            [lights.directional(fm.vec3(0.4,0.7,1.0),fm.vec3(2.5,2.5,2.5)) or >>]) or >>
        device.begin(202515967) or >>
        report := scene.draw_lit($&device,&tree,projection.multiply(view),&environment) or >>
        assert(report.instances+report.culled_instances==15)
        submitted=report.instances
        culled=report.culled_instances
        triangles=report.triangles
        saved=report.lod_triangles_saved
        coarse=report.lod_instances
        if capture.len>0 && frame+1==frames { device.capture(capture+"") or >> }
        device.present() or >>
        frame+=1
    }
    println("LOD result: levels="+str(counts[0])+","+str(counts[1])+","+str(counts[2])+" submitted="+str(submitted)+" triangles="+str(triangles)+" saved="+str(saved)+" coarse="+str(coarse)+" culled="+str(culled)+" mode="+mode)
    high.close() or >>
    medium.close() or >>
    low.close() or >>
    device.close() or >>
    println("Finished "+str(frame)+" LOD frames")
    << 0
}
fn main() int { << run() or(err){ eprintln(err.msg())
    << 1 } }
