@main

#gpu

// Uses only the Xu GPU standard library: no nexus package, window, scene,
// shader tools or application-owned native archive.
fn run() int {
    $device := gpu.open(gpu.DeviceOptions{backend: gpu.AUTO, debug: false, shader_formats: 0}) or >>
    $source := device.buffer(4096, gpu.BUFFER_VERTEX) or >>
    $target := device.buffer(4096, gpu.BUFFER_COMPUTE_STORAGE_READ) or >>
    $bytes := []u8{}
    for i in 0:4096 { bytes.push(u8((i * 53 + 17) % 256)) }
    $upload := device.upload(&source, 0, &bytes) or >>
    bytes[0] = u8(255)
    $copied := device.copy(&source, 0, &target, 0, 4096) or >>
    $readback := device.download(&target, 0, 4096) or >>
    // Already-submitted work retains its resources in the driver.
    source.close() or >>
    target.close() or >>
    upload.close() or >>
    copied.close() or >>
    readback.wait() or >>
    $output := []u8{}
    for i in 0:4096 { output.push(u8(0)) }
    readback.read($&output) or >>
    for i in 0:4096 { assert(output[i] == u8((i * 53 + 17) % 256)) }
    readback.close() or >>
    stats := device.stats() or >>
    assert(stats.buffer_count == 0 && stats.submission_count == 0 && stats.staging_bytes == 0)
    backend := device.backend() or >>
    $name := "Metal"
    if backend == gpu.VULKAN { name = "Vulkan" }
    if backend == gpu.D3D12 { name = "D3D12" }
    println("Standard GPU backend: " + name)
    println("Verified 4096 bytes through GPU upload/copy/fence/readback without a window")
    device.close() or >>
    << 0
}
fn main() int { << run() or (err) { eprintln(err.msg())
    << 1 } }
