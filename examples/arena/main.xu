@main

#gpu

gpu_info #"github.com/xulang-org/game/platform/gpu"

#window
window_events #window/events

canvas_shaders #"github.com/xulang-org/game/assets/shaders/two_d"

ren_data #"github.com/xulang-org/game/resources/canvas"

image_render #"github.com/xulang-org/game/integration/image_render/two_d"
images #"github.com/xulang-org/game/assets/image"
colors #"github.com/xulang-org/game/foundation/color"
scene_render #"github.com/xulang-org/game/integration/rendering/two_d"
input_bridge #"github.com/xulang-org/game/integration/input"
ren #"github.com/xulang-org/game/rendering/two_d"
sprite_anim #"github.com/xulang-org/game/animation/sprite"
physics2d #"github.com/xulang-org/game/physics2d"
timing #"github.com/xulang-org/game/timing"
controls #"github.com/xulang-org/game/input"
fm #"github.com/xulang-org/game/foundation/math"
game #"github.com/xulang-org/game/scene"
xacp #"github.com/xulang-org/game/xacp"
#os
#strconv
#errors

struct Options {
    frames int
    backend int
    capture string
    shaders string
    autoplay bool
    width int
    height int
    texture string
    xacp_port int
}
fn options() Options {
    args := os.args()
    $out := Options{frames: 0, backend: gpu.AUTO, capture: "", shaders: "build/canvas-shaders", autoplay: false, width: 960, height: 640,
        texture: "examples/arena/assets/player.png", xacp_port: 0}
    $i := 1
    while i < args.len {
        if args[i] == "--autoplay" { out.autoplay = true
            i = i + 1
            -> }
        if args[i] == "--xacp-tcp" {
            out.xacp_port = 19876
            i = i + 1
            -> }
        if i + 1 >= args.len { >> errors.new("missing option value") }
        value_index := i + 1
        if args[i] == "--xacp-port" {
            out.xacp_port = strconv.atoi(&args[value_index]) or >>
        } else if args[i] == "--frames" {
            out.frames = strconv.atoi(&args[value_index]) or >>
            if out.frames < 1 || out.frames > 1000000 { >> errors.new("frames must be in 1...1000000") }
        } else if args[i] == "--shaders" { out.shaders = args[value_index] + ""
        } else if args[i] == "--capture" { out.capture = args[i + 1] + ""
        } else if args[i] == "--texture" { out.texture = args[i + 1] + ""
        } else if args[i] == "--width" {
            out.width = strconv.atoi(&args[value_index]) or >>
            if out.width < 160 || out.width > 4096 { >> errors.new("width must be in 160...4096") }
        } else if args[i] == "--height" {
            out.height = strconv.atoi(&args[value_index]) or >>
            if out.height < 160 || out.height > 4096 { >> errors.new("height must be in 160...4096") }
        } else if args[i] == "--backend" {
            name := args[i + 1]
            if name == "auto" { out.backend = gpu.AUTO
            } else if name == "metal" { out.backend = gpu.METAL
            } else if name == "vulkan" { out.backend = gpu.VULKAN
            } else if name == "d3d12" { out.backend = gpu.D3D12
            } else { >> errors.new("backend must be auto, metal, vulkan or d3d12") }
        } else { >> errors.new("unknown option: " + args[i]) }
        i = i + 2
    }
    if out.capture.len > 0 && out.frames == 0 { >> errors.new("--capture requires --frames") }
    << out
}
fn make_input() controls.InputMap {
    $input := controls.new_input_map()
    input.bind("left", window_events.KEY_A) or >>
    input.bind("left", window_events.KEY_LEFT) or >>
    input.bind("right", window_events.KEY_D) or >>
    input.bind("right", window_events.KEY_RIGHT) or >>
    input.bind("up", window_events.KEY_W) or >>
    input.bind("up", window_events.KEY_UP) or >>
    input.bind("down", window_events.KEY_S) or >>
    input.bind("down", window_events.KEY_DOWN) or >>
    input.bind("pause", window_events.KEY_SPACE) or >>
    input.bind("quit", window_events.KEY_ESCAPE) or >>
    << input
}
struct Gem {
    node int
    position fm.Vec2
    collected bool
}
fn run() int {
    config := options() or >>
    canvas_program_0 := canvas_shaders.load_canvas(config.shaders + "") or >>
    $renderer := ren.open_2d("Xu Game | WASD / Arrows: move | Space: pause | Esc: exit",
        config.width, config.height, config.backend, &canvas_program_0) or >>
    backend := renderer.backend() or >>
    println("Rendering on " + gpu_info.backend_name(backend))
    $tree := game.new_scene_tree("World", 128) or >>
    $canvas := scene_render.new_canvas_2d()
    level := tree.add_child(tree.root(), "Level") or >>
    player := tree.add_child(level, "Player") or >>
    $position := fm.vec2(110.0, 310.0)
    camera := game.new_camera_2d(960.0, 640.0) or >>
    tree.set_position(player, position) or >>
    solids := [fm.rect2(32.0, 112.0, 896.0, 16.0), fm.rect2(32.0, 576.0, 896.0, 16.0),
        fm.rect2(32.0, 128.0, 16.0, 448.0), fm.rect2(912.0, 128.0, 16.0, 448.0),
        fm.rect2(336.0, 192.0, 32.0, 288.0), fm.rect2(592.0, 256.0, 32.0, 256.0)]
    wall_color := colors.rgba8(58, 76, 104, 255) or >>
    for i in 0:solids.len {
        wall := tree.add_child(level, "Wall" + str(i)) or >>
        canvas.add_rect(wall, solids[i], wall_color) or >>
    }
    $template := game.new_scene_tree("Gem", 4) or >>
    template_root := template.root()
    packed := game.pack_scene(&template, template_root) or >>
    locations := [fm.vec2(160.0, 176.0), fm.vec2(816.0, 176.0), fm.vec2(160.0, 528.0),
        fm.vec2(816.0, 528.0), fm.vec2(480.0, 160.0), fm.vec2(720.0, 416.0)]
    $gems := []Gem{}
    gold := colors.rgba8(255, 202, 104, 255) or >>
    for i in 0:locations.len {
        node := packed.instantiate($&tree, level, "Gem" + str(i)) or >>
        tree.set_position(node, locations[i]) or >>
        canvas.add_rect(node, fm.rect2(-9.0, -9.0, 18.0, 18.0), gold) or >>
        gems.push(Gem{node: node, position: locations[i], collected: false})
    }
    ready := tree.take_ready() or >>
    println("Scene ready: " + str(ready.len) + " nodes")
    white := colors.rgba8(255, 255, 255, 255) or >>
    background := colors.rgba8(14, 20, 32, 255) or >>
    grid := colors.rgba8(25, 35, 52, 255) or >>
    accent := colors.rgba8(96, 230, 192, 255) or >>
    muted := colors.rgba8(42, 56, 78, 255) or >>
    letterbox := colors.rgba8(7, 10, 17, 255) or >>
    image_texture := images.load_png(config.texture + "") or >>
    $texture := image_render.upload_image_2d(&renderer, &image_texture, false) or >>
    clip := sprite_anim.new_atlas_animation(4, 1, 0, 4, 8.0, true) or >>
    $animator := sprite_anim.new_sprite_animator(clip) or >>
    $sprite := scene_render.Sprite2D{node: player, bounds: fm.rect2(0.0, 0.0, 28.0, 28.0),
        region: fm.rect2(0.0, 0.0, 1.0, 1.0), tint: white}
    $input := make_input() or >>
    $clock := timing.new_clock(60, 8) or >>
    $frame_number := 0
    $score := 0
    $animation_time := 0.0
    $quit := false
    $last_time := now_ns()
    $batch := ren_data.new_batch()
    $sprite_batch := ren_data.new_batch()

    $ctrl := xacp.GameControl{jobs: chan xacp.GameJob{cap: 1}, done: chan int{cap: 1}, active: false, paused: false, steps_remaining: 0, port: 0, has_screenshot_job: false, screenshot_job: xacp.GameJob{id: 0, op: "", body: "", permissions: 0, reply: chan xacp.GameReply{cap: 1}}}
    if config.xacp_port > 0 {
        ctrl = xacp.attach_tcp(config.xacp_port)
        println("XACP control listening on 127.0.0.1:" + str(config.xacp_port))
    }

    while !quit && (config.frames == 0 || frame_number < config.frames) {
        input.begin_frame()
        if ctrl.is_open() {
            ctrl.poll($&tree, $&input)
            if ctrl.screenshot_requested() {
                shot_path := "build/arena_xacp.png"
                renderer.capture(shot_path + "") or >>
                ctrl.fulfill_screenshot(renderer.width() or >>, renderer.height() or >>, shot_path)
            }
        }
        window.pump() or >>
        for event_index in 0:256 {
            event := renderer.poll() or >>
            if event.kind == window_events.EVENT_NONE { <- }
            if event.kind == window_events.EVENT_CLOSE_REQUESTED { quit = true }
            input_bridge.apply_window_input($&input, &event) or >>
        }
        if input.just_pressed("quit") or >> { quit = true }
        if quit { <- }
        if input.just_pressed("pause") or >> { tree.paused = !tree.paused }
        if config.autoplay {
            phase := (frame_number / 60) % 4
            input.feed_key(window_events.KEY_D, phase == 0) or >>
            input.feed_key(window_events.KEY_S, phase == 1) or >>
            input.feed_key(window_events.KEY_A, phase == 2) or >>
            input.feed_key(window_events.KEY_W, phase == 3) or >>
        }
        current_time := now_ns()
        $elapsed := f64(current_time - last_time) / 1000000000.0
        last_time = current_time
        if config.autoplay { elapsed = 1.0 / 60.0 }
        ticks := clock.advance(elapsed) or >>
        if tree.can_process(player) or >> {
            for step in 0:ticks.steps {
                animation_time = animation_time + ticks.fixed_delta
                animator.advance(ticks.fixed_delta) or >>
                direction := input.vector("left", "right", "up", "down") or >>
                movement := direction.scaled(240.0 * ticks.fixed_delta)
                result := physics2d.move_and_slide(fm.rect2(position.x, position.y, 28.0, 28.0), movement, &solids) or >>
                position = result.position
                tree.set_position(player, position) or >>
                for i in 0:gems.len {
                    if gems[i].collected { -> }
                    center := position.add(fm.vec2(14.0, 14.0))
                    if center.sub(gems[i].position).length() < 28.0 {
                        gems[i].collected = true
                        score = score + 1
                        tree.queue_free(gems[i].node) or >>
                        println("Collected " + str(score) + " / " + str(gems.len))
                    }
                }
            }
        }
        for gem in gems {
            if !gem.collected {
                transform := fm.transform_2d(gem.position, animation_time * 1.2, fm.vec2(1.0, 1.0))
                tree.set_transform(gem.node, transform) or >>
            }
        }
        tree.flush_free() or >>
        width := renderer.width() or >>
        height := renderer.height() or >>
        if width < 1 || height < 1 { sleep_ns(10000000)
            -> }
        view := camera.view_transform(f64(width), f64(height)) or >>
        viewport := camera.viewport(f64(width), f64(height)) or >>
        batch.clear()
        sprite_batch.clear()
        batch.quad(fm.rect2(0.0, 0.0, 960.0, 640.0), view, background) or >>
        for x in 0:29 { batch.quad(fm.rect2(48.0 + f64(x) * 30.0, 128.0, 1.0, 448.0), view, grid) or >> }
        for y in 0:15 { batch.quad(fm.rect2(48.0, 128.0 + f64(y) * 30.0, 864.0, 1.0), view, grid) or >> }
        // A compact progress display. Keyboard instructions remain in the title bar.
        batch.quad(fm.rect2(48.0, 44.0, 8.0, 36.0), view, accent) or >>
        for i in 0:gems.len {
            $color := muted
            if i < score { color = gold }
            batch.quad(fm.rect2(696.0 + f64(i) * 38.0, 48.0, 26.0, 26.0), view, color) or >>
        }
        if tree.paused {
            batch.quad(fm.rect2(80.0, 48.0, 8.0, 26.0), view, gold) or >>
            batch.quad(fm.rect2(96.0, 48.0, 8.0, 26.0), view, gold) or >>
        } else { batch.triangle(view.point(fm.vec2(80.0, 48.0)), view.point(fm.vec2(80.0, 74.0)),
            view.point(fm.vec2(100.0, 61.0)), accent) or >> }
        canvas.record(&tree, view, $&batch) or >>
        sprite.region = animator.region() or >>
        sprite.record(&tree, view, $&sprite_batch) or >>
        renderer.begin(letterbox) or >>
        renderer.clip_rect(viewport) or >>
        renderer.submit(&batch) or >>
        renderer.submit_texture(&sprite_batch, &texture) or >>
        if config.capture.len > 0 && frame_number + 1 == config.frames { renderer.capture(config.capture + "") or >> }
        renderer.present() or >>
        frame_number = frame_number + 1
    }
    texture.close() or >>
    renderer.close() or >>
    println("Finished " + str(frame_number) + " frames; score " + str(score))
    << 0
}
fn main() int { << run() or (err) { eprintln(err.msg())
    << 1 } }
