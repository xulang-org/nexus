@main

game #"github.com/xulang-org/game"
gpu #"github.com/xulang-org/game/gpu"
#os
#strconv
#errors

struct Options {
    frames int
    backend int
    capture string
    autoplay bool
}
fn options() Options {
    args := os.args()
    $out := Options{frames: 0, backend: gpu.AUTO, capture: "", autoplay: false}
    $i := 1
    while i < args.len {
        if args[i] == "--autoplay" { out.autoplay = true
            i = i + 1
            -> }
        if i + 1 >= args.len { >> errors.new("missing option value") }
        value_index := i + 1
        if args[i] == "--frames" {
            out.frames = strconv.atoi(&args[value_index]) or >>
            if out.frames < 1 || out.frames > 1000000 { >> errors.new("frames must be in 1...1000000") }
        } else if args[i] == "--capture" { out.capture = args[i + 1] + ""
        } else if args[i] == "--backend" {
            name := args[i + 1]
            if name == "auto" { out.backend = gpu.AUTO
            } else if name == "metal" { out.backend = gpu.METAL
            } else if name == "vulkan" { out.backend = gpu.VULKAN
            } else if name == "d3d12" { out.backend = gpu.D3D12
            } else { >> errors.new("backend must be auto, metal, vulkan or d3d12") }
        } else { >> errors.new("unknown option: " + args[i]) }
        i = i + 2
    }
    if out.capture.len > 0 && out.frames == 0 { >> errors.new("--capture requires --frames") }
    << out
}
fn make_input() game.InputMap {
    $input := game.new_input_map()
    input.bind("left", gpu.KEY_A) or >>
    input.bind("left", gpu.KEY_LEFT) or >>
    input.bind("right", gpu.KEY_D) or >>
    input.bind("right", gpu.KEY_RIGHT) or >>
    input.bind("up", gpu.KEY_W) or >>
    input.bind("up", gpu.KEY_UP) or >>
    input.bind("down", gpu.KEY_S) or >>
    input.bind("down", gpu.KEY_DOWN) or >>
    input.bind("pause", gpu.KEY_SPACE) or >>
    input.bind("quit", gpu.KEY_ESCAPE) or >>
    << input
}
fn player_pixels() []int {
    body_color := gpu.rgba(96, 230, 192, 255) or >>
    shadow_color := gpu.rgba(40, 150, 140, 255) or >>
    eye_color := gpu.rgba(14, 30, 40, 255) or >>
    $pixels := []int{}
    for y in 0:16 {
        for x in 0:16 {
            $color := 0
            if x >= 2 && x <= 13 && y >= 2 && y <= 13 {
                color = body_color
                if y >= 11 { color = shadow_color }
                if (x == 5 || x == 10) && (y == 6 || y == 7) { color = eye_color }
            }
            pixels.push(color)
        }
    }
    << pixels
}
struct Gem {
    node int
    position game.Vec2
    collected bool
}
fn run() int {
    config := options() or >>
    $renderer := gpu.open("Xu Game | WASD / Arrows: move | Space: pause | Esc: exit", 960, 640, config.backend) or >>
    backend := renderer.backend() or >>
    println("Rendering on " + gpu.backend_name(backend))
    $tree := game.new_scene_tree("World", 128) or >>
    $canvas := gpu.new_canvas()
    level := tree.add_child(tree.root(), "Level") or >>
    player := tree.add_child(level, "Player") or >>
    $position := game.vec2(110.0, 310.0)
    tree.set_position(player, position) or >>
    solids := [game.rect2(32.0, 112.0, 896.0, 16.0), game.rect2(32.0, 576.0, 896.0, 16.0),
        game.rect2(32.0, 128.0, 16.0, 448.0), game.rect2(912.0, 128.0, 16.0, 448.0),
        game.rect2(336.0, 192.0, 32.0, 288.0), game.rect2(592.0, 256.0, 32.0, 256.0)]
    wall_color := gpu.rgba(58, 76, 104, 255) or >>
    for i in 0:solids.len {
        wall := tree.add_child(level, "Wall" + str(i)) or >>
        canvas.add_rect(wall, solids[i], wall_color) or >>
    }
    $template := game.new_scene_tree("Gem", 4) or >>
    template_root := template.root()
    packed := game.pack_scene(&template, template_root) or >>
    locations := [game.vec2(160.0, 176.0), game.vec2(816.0, 176.0), game.vec2(160.0, 528.0),
        game.vec2(816.0, 528.0), game.vec2(480.0, 160.0), game.vec2(720.0, 416.0)]
    $gems := []Gem{}
    gold := gpu.rgba(255, 202, 104, 255) or >>
    for i in 0:locations.len {
        node := packed.instantiate($&tree, level, "Gem" + str(i)) or >>
        tree.set_position(node, locations[i]) or >>
        canvas.add_rect(node, game.rect2(-9.0, -9.0, 18.0, 18.0), gold) or >>
        gems.push(Gem{node: node, position: locations[i], collected: false})
    }
    ready := tree.take_ready() or >>
    println("Scene ready: " + str(ready.len) + " nodes")
    white := gpu.rgba(255, 255, 255, 255) or >>
    background := gpu.rgba(14, 20, 32, 255) or >>
    grid := gpu.rgba(25, 35, 52, 255) or >>
    accent := gpu.rgba(96, 230, 192, 255) or >>
    muted := gpu.rgba(42, 56, 78, 255) or >>
    pixels := player_pixels() or >>
    $texture := renderer.texture_rgba(16, 16, &pixels, false) or >>
    sprite := gpu.Sprite2D{node: player, bounds: game.rect2(0.0, 0.0, 28.0, 28.0),
        region: game.rect2(0.0, 0.0, 1.0, 1.0), tint: white}
    $input := make_input() or >>
    $clock := game.new_clock(60, 8) or >>
    $frame_number := 0
    $score := 0
    $quit := false
    $last_time := now_ns()
    $batch := gpu.new_batch()
    $sprite_batch := gpu.new_batch()
    while !quit && (config.frames == 0 || frame_number < config.frames) {
        input.begin_frame()
        for event_index in 0:256 {
            event := renderer.poll() or >>
            if event.kind == gpu.EVENT_NONE { <- }
            if event.kind == gpu.EVENT_QUIT { quit = true }
            gpu.apply_input($&input, &event) or >>
        }
        if input.just_pressed("quit") or >> { quit = true }
        if quit { <- }
        if input.just_pressed("pause") or >> { tree.paused = !tree.paused }
        if config.autoplay {
            phase := (frame_number / 60) % 4
            input.feed_key(gpu.KEY_D, phase == 0) or >>
            input.feed_key(gpu.KEY_S, phase == 1) or >>
            input.feed_key(gpu.KEY_A, phase == 2) or >>
            input.feed_key(gpu.KEY_W, phase == 3) or >>
        }
        current_time := now_ns()
        $elapsed := f64(current_time - last_time) / 1000000000.0
        last_time = current_time
        if config.autoplay { elapsed = 1.0 / 60.0 }
        ticks := clock.advance(elapsed) or >>
        if tree.can_process(player) or >> {
            for step in 0:ticks.steps {
                direction := input.vector("left", "right", "up", "down") or >>
                movement := direction.scaled(240.0 * ticks.fixed_delta)
                result := game.move_and_slide(game.rect2(position.x, position.y, 28.0, 28.0), movement, &solids) or >>
                position = result.position
                tree.set_position(player, position) or >>
                for i in 0:gems.len {
                    if gems[i].collected { -> }
                    center := position.add(game.vec2(14.0, 14.0))
                    if center.sub(gems[i].position).length() < 28.0 {
                        gems[i].collected = true
                        score = score + 1
                        tree.queue_free(gems[i].node) or >>
                        println("Collected " + str(score) + " / " + str(gems.len))
                    }
                }
            }
        }
        for gem in gems {
            if !gem.collected {
                transform := game.transform_2d(gem.position, f64(frame_number) * 0.02, game.vec2(1.0, 1.0))
                tree.set_transform(gem.node, transform) or >>
            }
        }
        tree.flush_free() or >>
        width := renderer.width() or >>
        height := renderer.height() or >>
        if width < 1 || height < 1 { sleep_ns(10000000)
            -> }
        camera := game.transform_2d(game.vec2(0.0, 0.0), 0.0, game.vec2(f64(width) / 960.0, f64(height) / 640.0))
        batch.clear()
        sprite_batch.clear()
        for x in 0:29 { batch.quad(game.rect2(48.0 + f64(x) * 30.0, 128.0, 1.0, 448.0), camera, grid) or >> }
        for y in 0:15 { batch.quad(game.rect2(48.0, 128.0 + f64(y) * 30.0, 864.0, 1.0), camera, grid) or >> }
        // A compact progress display. Keyboard instructions remain in the title bar.
        batch.quad(game.rect2(48.0, 44.0, 8.0, 36.0), camera, accent) or >>
        for i in 0:gems.len {
            $color := muted
            if i < score { color = gold }
            batch.quad(game.rect2(696.0 + f64(i) * 38.0, 48.0, 26.0, 26.0), camera, color) or >>
        }
        if tree.paused {
            batch.quad(game.rect2(80.0, 48.0, 8.0, 26.0), camera, gold) or >>
            batch.quad(game.rect2(96.0, 48.0, 8.0, 26.0), camera, gold) or >>
        } else { batch.triangle(camera.point(game.vec2(80.0, 48.0)), camera.point(game.vec2(80.0, 74.0)),
            camera.point(game.vec2(100.0, 61.0)), accent) or >> }
        canvas.record(&tree, camera, $&batch) or >>
        sprite.record(&tree, camera, $&sprite_batch) or >>
        renderer.begin(background) or >>
        renderer.submit(&batch) or >>
        renderer.submit_texture(&sprite_batch, &texture) or >>
        if config.capture.len > 0 && frame_number + 1 == config.frames { renderer.capture(config.capture + "") or >> }
        renderer.present() or >>
        frame_number = frame_number + 1
    }
    texture.close() or >>
    renderer.close() or >>
    println("Finished " + str(frame_number) + " frames; score " + str(score))
    << 0
}
fn main() int { << run() or (err) { eprintln(err.msg())
    << 1 } }
