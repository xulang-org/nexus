@main

#gpu

gpu_info #"github.com/xulang-org/nexus/platform/gpu"

#window
window_events #window/events
mesh_shaders #"github.com/xulang-org/nexus/assets/shaders/three_d"

meshes #"github.com/xulang-org/nexus/resources/mesh"

timing #"github.com/xulang-org/nexus/timing"
controls #"github.com/xulang-org/nexus/input"
ren #"github.com/xulang-org/nexus/rendering/three_d"
scene_render #"github.com/xulang-org/nexus/integration/rendering/three_d"
colors #"github.com/xulang-org/nexus/foundation/color"
input_bridge #"github.com/xulang-org/nexus/integration/input"
fm #"github.com/xulang-org/nexus/foundation/math"
nexus #"github.com/xulang-org/nexus/scene"
#os
#strconv
#errors

struct Options {
    frames int
    backend int
    capture string
    shaders string
}
fn options() Options {
    args := os.args()
    $config := Options{frames: 0, backend: gpu.AUTO, capture: "", shaders: "build/mesh-shaders"}
    $i := 1
    while i < args.len {
        if i + 1 >= args.len { >> errors.new("missing option value") }
        next := i + 1
        if args[i] == "--frames" {
            config.frames = strconv.atoi(&args[next]) or >>
            if config.frames < 1 || config.frames > 1000000 { >> errors.new("frames outside 1...1000000") }
        } else if args[i] == "--shaders" { config.shaders = args[next] + ""
        } else if args[i] == "--capture" { config.capture = args[next] + ""
        } else if args[i] == "--backend" {
            name := args[next]
            if name == "metal" { config.backend = gpu.METAL
            } else if name == "vulkan" { config.backend = gpu.VULKAN
            } else if name == "d3d12" { config.backend = gpu.D3D12
            } else if name != "auto" { >> errors.new("unknown GPU backend") }
        } else { >> errors.new("unknown option: " + args[i]) }
        i = i + 2
    }
    if config.capture.len > 0 && config.frames == 0 { >> errors.new("capture requires bounded --frames") }
    << config
}
// Face colors are authored vertex colors, not a lighting simulation.
fn cube_data() meshes.MeshData3D {
    points := [fm.vec3(-0.5, -0.5, -0.5), fm.vec3(0.5, -0.5, -0.5),
        fm.vec3(0.5, 0.5, -0.5), fm.vec3(-0.5, 0.5, -0.5),
        fm.vec3(-0.5, -0.5, 0.5), fm.vec3(0.5, -0.5, 0.5),
        fm.vec3(0.5, 0.5, 0.5), fm.vec3(-0.5, 0.5, 0.5)]
    corners := [4, 5, 6, 7, 1, 0, 3, 2, 0, 4, 7, 3, 5, 1, 2, 6, 3, 7, 6, 2, 0, 1, 5, 4]
    colors := [colors.rgba8(66, 210, 182, 255) or >>, colors.rgba8(28, 115, 134, 255) or >>,
        colors.rgba8(39, 145, 166, 255) or >>, colors.rgba8(238, 170, 72, 255) or >>,
        colors.rgba8(146, 244, 210, 255) or >>, colors.rgba8(25, 91, 111, 255) or >>]
    $mesh := meshes.new_mesh_data_3d()
    for face in 0:6 {
        base := mesh.vertex_count()
        for corner in 0:4 { mesh.vertex(points[corners[face * 4 + corner]], colors[face]) or >> }
        mesh.triangle(base, base + 1, base + 2) or >>
        mesh.triangle(base, base + 2, base + 3) or >>
    }
    << mesh
}
fn floor_data() meshes.MeshData3D {
    $mesh := meshes.new_mesh_data_3d()
    for row in 0:12 {
        for column in 0:12 {
            $color := colors.rgba8(29, 45, 65, 255) or >>
            if (row + column) % 2 == 0 { color = colors.rgba8(36, 56, 76, 255) or >> }
            x := f64(column) - 6.0
            z := f64(row) - 6.0
            base := mesh.vertex_count()
            mesh.vertex(fm.vec3(x, -1.0, z), color) or >>
            mesh.vertex(fm.vec3(x + 0.98, -1.0, z), color) or >>
            mesh.vertex(fm.vec3(x + 0.98, -1.0, z + 0.98), color) or >>
            mesh.vertex(fm.vec3(x, -1.0, z + 0.98), color) or >>
            mesh.triangle(base, base + 1, base + 2) or >>
            mesh.triangle(base, base + 2, base + 3) or >>
        }
    }
    << mesh
}
fn run() int {
    config := options() or >>
    mesh_program_0 := mesh_shaders.load_mesh(config.shaders + "") or >>
    $device := ren.open_3d("Nexus Engine 3D | arrows: orbit | Space: pause | Esc: exit", 960, 640, config.backend, &mesh_program_0) or >>
    backend := device.backend() or >>
    println("3D GPU backend: " + gpu_info.backend_name(backend))
    cube_source := cube_data() or >>
    floor_source := floor_data() or >>
    $cube := device.upload(&cube_source) or >>
    $floor := device.upload(&floor_source) or >>
    $tree := nexus.new_scene_tree_3d("World", 64) or >>
    root := tree.root()
    rotor := tree.add_child_3d(root, "Rotor") or >>
    geometry := tree.add_group(rotor, "Geometry") or >>
    hero := tree.add_child_3d(geometry, "Hero") or >>
    tree.set_transform_3d(hero, fm.scale_3d(fm.vec3(2.1, 2.1, 2.1))) or >>
    row := tree.add_child_3d(root, "Row") or >>
    tree.set_position_3d(row, fm.vec3(0.0, -0.5, -2.8)) or >>
    floor_node := tree.add_child_3d(root, "Floor") or >>
    rig := tree.add_child_3d(root, "CameraRig") or >>
    camera_node := tree.add_child_3d(rig, "Camera") or >>
    tree.set_process_mode(rig, nexus.PROCESS_ALWAYS) or >>
    view_pose := nexus.look_at_3d(fm.vec3(0.0, 4.5, 9.5), fm.vec3(0.0, 0.0, 0.0), fm.vec3(0.0, 1.0, 0.0)) or >>
    camera_pose := view_pose.affine_inverse() or >>
    tree.set_transform_3d(camera_node, camera_pose) or >>
    camera := nexus.new_camera_node_3d(&tree, camera_node) or >>
    $scene := scene_render.new_scene_3d(&device) or >>
    scene.attach_mesh(&tree, hero, &cube) or >>
    scene.attach_mesh(&tree, floor_node, &floor) or >>
    template := nexus.new_scene_tree_3d("Cube", 1) or >>
    packed_cube := nexus.pack_scene(&template, template.root()) or >>
    $small_nodes := []int{}
    for i in 0:5 {
        node := packed_cube.instantiate($&tree, row, "Cube" + str(i)) or >>
        small_nodes.push(node)
        scene.attach_mesh(&tree, node, &cube) or >>
    }
    ready := tree.take_ready() or >>
    println("Scene ready: " + str(ready.len) + " nodes, 7 mesh bindings")
    background := colors.rgba8(12, 20, 34, 255) or >>
    $input := controls.new_input_map()
    input.bind("left", window_events.KEY_LEFT) or >>
    input.bind("right", window_events.KEY_RIGHT) or >>
    input.bind("pause", window_events.KEY_SPACE) or >>
    $frame := 0
    $angle := 0.0
    $orbit := 0.55
    $quit := false
    $last := now_ns()
    $clock := timing.new_clock(60, 8) or >>
    while !quit && (config.frames == 0 || frame < config.frames) {
        input.begin_frame()
        window.pump() or >>
        for i in 0:256 {
            event := device.poll() or >>
            if event.kind == window_events.EVENT_NONE { <- }
            if event.kind == window_events.EVENT_CLOSE_REQUESTED || (event.kind == window_events.EVENT_KEY_DOWN && event.physical_key == window_events.KEY_ESCAPE) { quit = true }
            input_bridge.apply_window_input($&input, &event) or >>
        }
        if quit { <- }
        if input.just_pressed("pause") or >> { tree.paused = !tree.paused }
        now := now_ns()
        $delta := f64(now - last) / 1000000000.0
        last = now
        if config.frames > 0 { delta = 1.0 / 60.0 }
        ticks := clock.advance(delta) or >>
        for step in 0:ticks.steps {
            if tree.can_process(rotor) or >> { angle = angle + ticks.fixed_delta * 0.6 }
            if tree.can_process(rig) or >> { orbit = orbit + (input.axis("left", "right") or >>) * ticks.fixed_delta }
        }
        width := device.width() or >>
        height := device.height() or >>
        if width < 1 || height < 1 { sleep_ns(10000000)
            -> }
        tree.set_transform_3d(rig, fm.rotation_y(orbit)) or >>
        tree.set_transform_3d(rotor, fm.rotation_y(angle).multiply(fm.rotation_x(angle * 0.7))) or >>
        for i in 0:5 {
            offset := f64(i) * 1.5 - 3.0
            local := fm.translation_3d(fm.vec3(offset, 0.0, 0.0)).multiply(fm.rotation_y(-angle + f64(i) * 0.35))
            tree.set_transform_3d(small_nodes[i], local) or >>
        }
        view := camera.view_projection(&tree, f64(width) / f64(height)) or >>
        device.begin(background) or >>
        draws := scene.draw($&device, &tree, view) or >>
        assert((draws.instances+draws.culled_instances) == 7 && (draws.triangles+draws.culled_triangles) == 360)
        if config.capture.len > 0 && frame + 1 == config.frames { device.capture(config.capture + "") or >> }
        device.present() or >>
        frame = frame + 1
    }
    cube.close() or >>
    floor.close() or >>
    device.close() or >>
    println("Finished " + str(frame) + " 3D frames")
    << 0
}
fn main() int { << run() or (err) { eprintln(err.msg())
    << 1 } }
