@main

#app
#gpu
#window
events #window/events
#math
#os
#strconv
fm #"github.com/xulang-org/game/foundation/math"
controls #"github.com/xulang-org/game/input"
input_bridge #"github.com/xulang-org/game/integration/input"
frame_loop #"github.com/xulang-org/game/integration/frame"
physics #"github.com/xulang-org/game/physics2d"
scene #"github.com/xulang-org/game/scene"
canvas #"github.com/xulang-org/game/resources/canvas"
scene_render #"github.com/xulang-org/game/integration/rendering/two_d"
ren #"github.com/xulang-org/game/rendering/two_d"
shaders #"github.com/xulang-org/game/assets/shaders/two_d"
images #"github.com/xulang-org/game/assets/image"
image_render #"github.com/xulang-org/game/integration/image_render/two_d"
animation #"github.com/xulang-org/game/animation/sprite"
audio #"github.com/xulang-org/game/audio"
mix #"github.com/xulang-org/game/audio/mixer"
audio_assets #"github.com/xulang-org/game/assets/audio"

const BACKGROUND = 118100479
const PANEL = 236199167
const GRID = 422785279
const WALL = 978085119
const GOLD = 4291455231
const MINT = 1625735423
const MUTED = 708333311
const WHITE = 4294967295

fn new_input() controls.InputMap {
    $input := controls.new_input_map()
    names := ["left", "right", "up", "down", "boost", "pause"]
    keys := [events.KEY_A, events.KEY_D, events.KEY_W, events.KEY_S, events.KEY_LEFT_SHIFT, events.KEY_SPACE]
    for i in 0:names.len {
        input.bind_source(names[i] + "", i) or >>
        input.bind(names[i] + "", keys[i]) or >>
    }
    << input
}
fn touch_layout(width f64, height f64) input_bridge.TouchControls {
    $touch := input_bridge.new_touch_controls(fm.vec2(78.0, height - 84.0), 40.0, 0.08, 0) or >>
    touch.enable_floating(fm.rect2(0.0, height - 176.0, math.min(156.0, width / 2.0 - 30.0), 176.0)) or >>
    touch.add_button(fm.vec2(width - 74.0, height - 84.0), 48.0, 4, input_bridge.BUTTON_HOLD) or >>
    touch.add_button(pause_center(width, height), 23.0, 5, input_bridge.BUTTON_TAP) or >>
    << touch
}
// Input/layout units are logical points. Both axes are scaled independently to
// actual output pixels; world fitting never changes touch hit-test coordinates.
fn screen_transform(width f64, height f64, pixels_x int, pixels_y int) fm.Transform2D {
    << fm.transform_2d(fm.vec2(0.0, 0.0), 0.0, fm.vec2(f64(pixels_x) / width, f64(pixels_y) / height))
}
fn pause_center(width f64, height f64) fm.Vec2 {
    if width > height { << fm.vec2(width - 74.0, height - 180.0) }
    << fm.vec2(width / 2.0, height - 84.0)
}
fn world_transform(width f64, height f64) fm.Transform2D {
    $area := fm.rect2(16.0, 76.0, width - 32.0, height - 240.0)
    if width > height { area = fm.rect2(146.0, 20.0, width - 292.0, height - 40.0) }
    scale := math.min(area.size.x / 360.0, area.size.y / 420.0)
    origin := area.position.add(area.size.sub(fm.vec2(360.0, 420.0).scaled(scale)).scaled(0.5))
    << fm.transform_2d(origin, 0.0, fm.vec2(scale, scale))
}
fn circle(batch $&canvas.Batch2D, center fm.Vec2, radius f64, view fm.Transform2D, color int) int {
    for i in 0:32 {
        a := f64(i) * 6.283185307179586 / 32.0
        b := f64(i + 1) * 6.283185307179586 / 32.0
        batch.triangle(view.point(center), view.point(center.add(fm.vec2(math.cos(a), math.sin(a)).scaled(radius))),
            view.point(center.add(fm.vec2(math.cos(b), math.sin(b)).scaled(radius))), color) or >>
    }
    << 0
}
fn draw_controls(batch $&canvas.Batch2D, touch &input_bridge.TouchControls, width f64, height f64,
    view fm.Transform2D, paused bool, score int) int {
    batch.quad(fm.rect2(22.0, 25.0, 4.0, 24.0), view, MINT) or >>
    for i in 0:6 {
        $color := MUTED
        if i < score { color = GOLD }
        circle(batch, fm.vec2(45.0 + f64(i) * 23.0, 37.0), 6.0, view, color) or >>
    }
    circle(batch, touch.center, touch.radius + 3.0, view, MUTED) or >>
    circle(batch, touch.center, touch.radius, view, PANEL) or >>
    knob := touch.center.add(touch.offset.scaled(touch.radius * 0.65))
    circle(batch, knob, 19.0, view, MINT) or >>
    boost := fm.vec2(width - 74.0, height - 84.0)
    $boost_color := MUTED
    if touch.button_down(0) or >> { boost_color = GOLD }
    circle(batch, boost, 49.0, view, boost_color) or >>
    circle(batch, boost, 46.0, view, PANEL) or >>
    batch.triangle(view.point(boost.add(fm.vec2(4.0, -18.0))), view.point(boost.add(fm.vec2(-13.0, 3.0))),
        view.point(boost.add(fm.vec2(3.0, 3.0))), boost_color) or >>
    batch.triangle(view.point(boost.add(fm.vec2(-4.0, 18.0))), view.point(boost.add(fm.vec2(13.0, -3.0))),
        view.point(boost.add(fm.vec2(-3.0, -3.0))), boost_color) or >>
    pause := pause_center(width, height)
    circle(batch, pause, 23.0, view, MUTED) or >>
    if paused {
        batch.triangle(view.point(pause.add(fm.vec2(-5.0, -9.0))), view.point(pause.add(fm.vec2(-5.0, 9.0))),
            view.point(pause.add(fm.vec2(9.0, 0.0))), GOLD) or >>
    } else {
        batch.quad(fm.rect2(pause.x - 7.0, pause.y - 8.0, 4.0, 16.0), view, WHITE) or >>
        batch.quad(fm.rect2(pause.x + 3.0, pause.y - 8.0, 4.0, 16.0), view, WHITE) or >>
    }
    << 0
}
struct Gem { node int
    position fm.Vec2
    collected bool }
fn run() int {
    program := shaders.load_canvas(app.resource_path("canvas") or >>) or >>
    options := window.Options{title: "Xu Phone Arena", width: 375, height: 667,
        resizable: true, high_pixel_density: true, hidden: false}
    $renderer := ren.open_2d_window(options, gpu.AUTO, &program) or >>
    image := images.load_png(app.resource_path("player.png") or >>) or >>
    $texture := image_render.upload_image_2d(&renderer, &image, false) or >>
    clip := animation.new_atlas_animation(4, 1, 0, 4, 8.0, true) or >>
    $animator := animation.new_sprite_animator(clip) or >>
    $tree := scene.new_scene_tree("PhoneArena", 64) or >>
    root := tree.root()
    player := tree.add_child(root, "Player") or >>
    $position := fm.vec2(42.0, 180.0)
    tree.set_position(player, position) or >>
    solids := [fm.rect2(8.0, 8.0, 344.0, 8.0), fm.rect2(8.0, 404.0, 344.0, 8.0),
        fm.rect2(8.0, 16.0, 8.0, 388.0), fm.rect2(344.0, 16.0, 8.0, 388.0),
        fm.rect2(122.0, 75.0, 14.0, 225.0), fm.rect2(224.0, 140.0, 14.0, 214.0)]
    save_path := app.data_path("arena-v1.json") or >>
    $checkpoint := load_checkpoint(save_path + "", &solids) or >>
    position = checkpoint.position
    tree.set_position(player, position) or >>
    tree.paused = checkpoint.paused
    $mixer := mix.new_mixer(48000, 16) or >>
    sfx_bus := mixer.add_bus(0, "SFX", 0.9) or >>
    chime_clip := mixer.add_clip(audio_assets.load_wav(app.resource_path("chime.wav") or >>) or >>) or >>
    $output := audio.open_output(48000) or >>
    mixer.pause_bus(sfx_bus, tree.paused) or >>
    if !tree.paused {
        audio.pump(&output, $&mixer, 2048, 512) or >>
    }
    output.pause(tree.paused) or >>
    $score := 0
    $save_dirty := true
    $save_now := false
    $last_save := now_ns()
    $world_canvas := scene_render.new_canvas_2d()
    for i in 0:solids.len {
        node := tree.add_child(root, "Wall" + str(i)) or >>
        world_canvas.add_rect(node, solids[i], WALL) or >>
    }
    locations := [fm.vec2(65.0, 52.0), fm.vec2(294.0, 52.0), fm.vec2(65.0, 365.0),
        fm.vec2(294.0, 365.0), fm.vec2(177.0, 90.0), fm.vec2(287.0, 250.0)]
    $gems := []Gem{}
    for i in 0:locations.len {
        if (checkpoint.collected & (1 << i)) != 0 {
            gems.push(Gem{node: -1, position: locations[i], collected: true})
            score = score + 1
            ->
        }
        node := tree.add_child(root, "Gem" + str(i)) or >>
        tree.set_position(node, locations[i]) or >>
        world_canvas.add_rect(node, fm.rect2(-6.0, -6.0, 12.0, 12.0), GOLD) or >>
        gems.push(Gem{node: node, position: locations[i], collected: false})
    }
    $sprite := scene_render.Sprite2D{node: player, bounds: fm.rect2(0.0, 0.0, 22.0, 22.0),
        region: animator.region() or >>, tint: WHITE}
    initial_window := renderer.window() or >>
    initial := initial_window.state() or >>
    $logical_width := f64(initial.width)
    $logical_height := f64(initial.height)
    $touch := touch_layout(logical_width, logical_height) or >>
    $input := new_input() or >>
    $loop := frame_loop.new_frame_loop(60, 8) or >>
    $animation_time := 0.0
    $frames := 0
    $batch := canvas.new_batch()
    $sprite_batch := canvas.new_batch()
    $overlay := canvas.new_batch()
    println("Phone arena ready; backend=" + str(renderer.backend() or >>) + "; PNG=" + str(image.width) + "x" + str(image.height))
    println("Phone arena restored position=" + (strconv.format_float(position.x, 103, -1) or >>) + "," +
        (strconv.format_float(position.y, 103, -1) or >>) +
        "; collected=" + str(checkpoint.collected) + "; audio=" + output.driver_name() + "; pid=" + str(os.getpid()))
    while app.next_frame() or >> {
        if loop.begin_frame($&input, $&touch, now_ns(), app.resume_epoch()) or >> {
            save_now = true
            output.clear() or >>
            mixer.pause_bus(sfx_bus, tree.paused) or >>
            output.pause(tree.paused) or >>
            println("Phone arena resumed; input and clock reset; audio_paused=" + str(tree.paused) + "; pid=" + str(os.getpid()))
        }
        window.pump() or >>
        for i in 0:events.QUEUE_CAPACITY {
            event := renderer.poll() or >>
            if event.kind == events.EVENT_NONE { <- }
            loop.feed($&input, $&touch, &event) or >>
            if event.kind == events.EVENT_INPUT_RESET {
                println("Phone arena input reset; reason=" + str(event.reset_reason))
            }
            if event.kind == events.EVENT_TOUCH_UP || event.kind == events.EVENT_TOUCH_CANCEL { save_now = true }
            if event.kind == events.EVENT_TOUCH_DOWN || event.kind == events.EVENT_TOUCH_UP || event.kind == events.EVENT_TOUCH_CANCEL {
                println("touch=" + str(event.kind) + "; finger=" + str(event.touch_id))
            }
        }
        if !loop.running() {
            output.pause(true) or >>
            output.clear() or >>
            loop.finish_frame(tree.paused) or >>
            <- }
        target_window := renderer.window() or >>
        state := target_window.state() or >>
        if state.width < 320 || state.height < 260 || state.pixel_width < 1 || state.pixel_height < 1 {
            loop.finish_frame(true) or >>
            ->
        }
        if logical_width != f64(state.width) || logical_height != f64(state.height) {
            logical_width = f64(state.width)
            logical_height = f64(state.height)
            loop.reset_touches($&input, $&touch) or >>
            touch = touch_layout(logical_width, logical_height) or >>
        }
        if input.just_pressed("pause") or >> {
            tree.paused = !tree.paused
            checkpoint.paused = tree.paused
            save_dirty = true
            save_now = true
            mixer.pause_bus(sfx_bus, tree.paused) or >>
            if tree.paused {
                output.pause(true) or >>
                output.clear() or >>
            } else {
                mixer.play(chime_clip, sfx_bus, 0.25, 0.0, false) or >>
                audio.pump(&output, $&mixer, 2048, 512) or >>
                output.pause(false) or >>
            }
            println("Phone arena paused=" + str(tree.paused))
        }
        ticks := loop.finish_frame(tree.paused) or >>
        if !tree.paused {
            direction := input.vector("left", "right", "up", "down") or >>
            $speed := 110.0
            if input.pressed("boost") or >> { speed = 190.0 }
            for step in 0:ticks.steps {
                animation_time = animation_time + ticks.fixed_delta
                if direction.length() > 0.0 { animator.advance(ticks.fixed_delta) or >> }
                result := physics.move_and_slide(fm.rect2(position.x, position.y, 22.0, 22.0),
                    direction.scaled(speed * ticks.fixed_delta), &solids) or >>
                if result.position.x != position.x || result.position.y != position.y { save_dirty = true }
                position = result.position
                checkpoint.position = position
                tree.set_position(player, position) or >>
                for i in 0:gems.len {
                    if !gems[i].collected && position.add(fm.vec2(11.0, 11.0)).sub(gems[i].position).length() < 22.0 {
                        gems[i].collected = true
                        score = score + 1
                        checkpoint.collected = checkpoint.collected | (1 << i)
                        save_dirty = true
                        save_now = true
                        tree.queue_free(gems[i].node) or >>
                        pan := math.max(-0.75, math.min(0.75, (gems[i].position.x - 180.0) / 160.0))
                        mixer.play(chime_clip, sfx_bus, 0.65, pan, false) or >>
                        println("Phone arena collected=" + str(score) + "/6")
                    }
                }
            }
            audio.pump(&output, $&mixer, 2048, 512) or >>
        }
        for gem in gems {
            if !gem.collected { tree.set_transform(gem.node,
                fm.transform_2d(gem.position, animation_time, fm.vec2(1.0, 1.0))) or >> }
        }
        tree.flush_free() or >>
        pixels := screen_transform(logical_width, logical_height, state.pixel_width, state.pixel_height)
        view := pixels.multiply(world_transform(logical_width, logical_height))
        batch.clear()
        sprite_batch.clear()
        overlay.clear()
        batch.quad(fm.rect2(0.0, 0.0, 360.0, 420.0), view, PANEL) or >>
        for i in 0:11 { batch.quad(fm.rect2(16.0 + f64(i) * 30.0, 16.0, 1.0, 388.0), view, GRID) or >> }
        for i in 0:13 { batch.quad(fm.rect2(16.0, 16.0 + f64(i) * 30.0, 328.0, 1.0), view, GRID) or >> }
        world_canvas.record(&tree, view, $&batch) or >>
        sprite.region = animator.region() or >>
        sprite.record(&tree, view, $&sprite_batch) or >>
        draw_controls($&overlay, &touch, logical_width, logical_height, pixels, tree.paused, score) or >>
        renderer.begin(BACKGROUND) or >>
        renderer.submit(&batch) or >>
        renderer.submit_texture(&sprite_batch, &texture) or >>
        renderer.submit(&overlay) or >>
        renderer.present() or >>
        if save_dirty && (save_now || frames == 0 || now_ns() - last_save >= 1000000000) {
            save_checkpoint(save_path + "", &checkpoint, &solids) or >>
            save_dirty = false
            last_save = now_ns()
        }
        save_now = false
        frames = frames + 1
    }
    if save_dirty { save_checkpoint(save_path, &checkpoint, &solids) or >> }
    output.pause(true) or >>
    output.clear() or >>
    output.close() or >>
    texture.close() or >>
    renderer.close() or >>
    println("Phone arena finished; frames=" + str(frames) + "; score=" + str(score))
    << 0
}
fn main() int { << run() or (err) { eprintln(err.msg())
    << 1 } }
