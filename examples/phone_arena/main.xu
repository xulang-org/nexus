@main

#app
#gpu
#window
events #window/events
#math
#os
#strconv
#errors
fm #"github.com/xulang-org/nexus/foundation/math"
controls #"github.com/xulang-org/nexus/input"
input_bridge #"github.com/xulang-org/nexus/integration/input"
app_host #"github.com/xulang-org/nexus/integration/application"
vp #"github.com/xulang-org/nexus/integration/viewport"
physics #"github.com/xulang-org/nexus/physics2d"
scene #"github.com/xulang-org/nexus/scene"
canvas #"github.com/xulang-org/nexus/resources/canvas"
scene_render #"github.com/xulang-org/nexus/integration/rendering/two_d"
ren #"github.com/xulang-org/nexus/rendering/two_d"
shaders #"github.com/xulang-org/nexus/assets/shaders/two_d"
images #"github.com/xulang-org/nexus/assets/image"
image_render #"github.com/xulang-org/nexus/integration/image_render/two_d"
animation #"github.com/xulang-org/nexus/animation/sprite"
audio #"github.com/xulang-org/nexus/audio"
mix #"github.com/xulang-org/nexus/audio/mixer"
audio_assets #"github.com/xulang-org/nexus/assets/audio"

const BACKGROUND = 118100479
const PANEL = 236199167
const GRID = 422785279
const WALL = 978085119
const GOLD = 4291455231
const MINT = 1625735423
const MUTED = 708333311
const WHITE = 4294967295

fn parse_max_frames() int {
    args := os.args()
    $i := 1
    while i < args.len {
        if args[i] == "--frames" && i + 1 < args.len {
            next := i + 1
            n := strconv.atoi(&args[next]) >>>
            if n < 1 || n > 1000000 { >>> errors.new("arena: invalid --frames value") }
            << n
        }
        i += 1
    }
    << 0
}

fn canvas_shader_dir() string {
    if app.is_hosted() || os.getenv("XU_PHONE_RESOURCE_ROOT").len > 0 {
        << app_host.resolve_resource("canvas", "build") >>>
    }
    << "build/canvas-shaders"
}

fn new_input() controls.InputMap {
    $input := controls.new_input_map()
    names := ["left", "right", "up", "down", "boost", "pause"]
    keys := [events.KEY_A, events.KEY_D, events.KEY_W, events.KEY_S, events.KEY_LEFT_SHIFT, events.KEY_SPACE]
    for i in 0:names.len {
        input.bind_source(names[i] + "", i) >>>
        input.bind(names[i] + "", keys[i]) >>>
    }
    << input
}

fn ui_scale(view &vp.Viewport) f64 {
    sr := view.safe_rect
    << math.max(1.0, math.min(2.8, math.min(sr.size.x, sr.size.y) / 375.0))
}

fn boost_center(view &vp.Viewport) fm.Vec2 {
    sr := view.safe_rect
    s := ui_scale(view)
    << fm.vec2(sr.position.x + sr.size.x - 74.0 * s, sr.position.y + sr.size.y - 84.0 * s)
}

fn pause_center(view &vp.Viewport) fm.Vec2 {
    sr := view.safe_rect
    s := ui_scale(view)
    right := sr.position.x + sr.size.x
    bottom := sr.position.y + sr.size.y
    if view.is_landscape() { << fm.vec2(right - 74.0 * s, bottom - 180.0 * s) }
    << fm.vec2(sr.position.x + sr.size.x * 0.5, bottom - 84.0 * s)
}

fn touch_layout(view &vp.Viewport) input_bridge.TouchControls {
    sr := view.safe_rect
    s := ui_scale(view)
    sx := sr.position.x
    bottom := sr.position.y + sr.size.y
    $touch := input_bridge.new_touch_controls(fm.vec2(sx + 78.0 * s, bottom - 84.0 * s), 40.0 * s, 0.08, 0) >>>
    zone_w := math.max(96.0 * s, math.min(156.0 * s, sr.size.x * 0.5 - 30.0 * s))
    touch.enable_floating(fm.rect2(sx, bottom - 176.0 * s, zone_w, 176.0 * s)) >>>
    touch.add_button(boost_center(view), 48.0 * s, 4, input_bridge.BUTTON_HOLD) >>>
    touch.add_button(pause_center(view), 23.0 * s, 5, input_bridge.BUTTON_TAP) >>>
    << touch
}

fn world_fit(view &vp.Viewport) vp.Fit2D {
    s := ui_scale(view)
    $area := view.safe_inset_rect(16.0 * s, 64.0 * s, 16.0 * s, 164.0 * s) >>>
    if view.is_landscape() {
        area = view.safe_inset_rect(146.0 * s, 16.0 * s, 146.0 * s, 16.0 * s) >>>
    }
    if area.size.x < 60.0 || area.size.y < 60.0 {
        area = fm.rect2(16.0, 20.0, math.max(60.0, view.logical_width - 32.0), math.max(60.0, view.logical_height - 40.0))
    }
    << vp.fit_letterbox(area, 360.0, 420.0) >>>
}

fn circle(batch $&canvas.Batch2D, center fm.Vec2, radius f64, view fm.Transform2D, color int) int {
    for i in 0:32 {
        a := f64(i) * 6.283185307179586 / 32.0
        b := f64(i + 1) * 6.283185307179586 / 32.0
        batch.triangle(view.point(center), view.point(center.add(fm.vec2(math.cos(a), math.sin(a)).scaled(radius))),
            view.point(center.add(fm.vec2(math.cos(b), math.sin(b)).scaled(radius))), color) >>>
    }
    << 0
}

fn draw_controls(batch $&canvas.Batch2D, touch &input_bridge.TouchControls, view &vp.Viewport,
    screen fm.Transform2D, paused bool, score int) int {
    s := ui_scale(view)
    top_x := view.safe_rect.position.x
    top_y := view.safe_rect.position.y
    batch.quad(fm.rect2(top_x + 22.0 * s, top_y + 18.0 * s, 4.0 * s, 24.0 * s), screen, MINT) >>>
    for i in 0:6 {
        $color := MUTED
        if i < score { color = GOLD }
        circle(batch, fm.vec2(top_x + (45.0 + f64(i) * 23.0) * s, top_y + 30.0 * s), 6.0 * s, screen, color) >>>
    }
    circle(batch, touch.center, touch.radius + 3.0 * s, screen, MUTED) >>>
    circle(batch, touch.center, touch.radius, screen, PANEL) >>>
    knob := touch.center.add(touch.offset.scaled(touch.radius * 0.65))
    circle(batch, knob, 19.0 * s, screen, MINT) >>>
    boost := boost_center(view)
    $boost_color := MUTED
    if touch.button_down(0) >>> { boost_color = GOLD }
    circle(batch, boost, 49.0 * s, screen, boost_color) >>>
    circle(batch, boost, 46.0 * s, screen, PANEL) >>>
    batch.triangle(screen.point(boost.add(fm.vec2(4.0 * s, -18.0 * s))), screen.point(boost.add(fm.vec2(-13.0 * s, 3.0 * s))),
        screen.point(boost.add(fm.vec2(3.0 * s, 3.0 * s))), boost_color) >>>
    batch.triangle(screen.point(boost.add(fm.vec2(-4.0 * s, 18.0 * s))), screen.point(boost.add(fm.vec2(13.0 * s, -3.0 * s))),
        screen.point(boost.add(fm.vec2(-3.0 * s, -3.0 * s))), boost_color) >>>
    pause := pause_center(view)
    circle(batch, pause, 23.0 * s, screen, MUTED) >>>
    if paused {
        batch.triangle(screen.point(pause.add(fm.vec2(-5.0 * s, -9.0 * s))), screen.point(pause.add(fm.vec2(-5.0 * s, 9.0 * s))),
            screen.point(pause.add(fm.vec2(9.0 * s, 0.0))), GOLD) >>>
    } else {
        batch.quad(fm.rect2(pause.x - 7.0 * s, pause.y - 8.0 * s, 4.0 * s, 16.0 * s), screen, WHITE) >>>
        batch.quad(fm.rect2(pause.x + 3.0 * s, pause.y - 8.0 * s, 4.0 * s, 16.0 * s), screen, WHITE) >>>
    }
    << 0
}

struct Gem { node int
    position fm.Vec2
    collected bool }

fn run() int {
    max_frames := parse_max_frames() >>>
    program := shaders.load_canvas(canvas_shader_dir() >>>) >>>
    options := window.Options{title: "Xu Phone Arena", width: 375, height: 667,
        resizable: true, high_pixel_density: true, hidden: false}
    $renderer := ren.open_2d_window(options, gpu.AUTO, &program) >>>
    player_path := app_host.resolve_resource("player.png", "examples/arena/assets") >>>
    image := images.load_png(player_path) >>>
    $texture := image_render.upload_image_2d(&renderer, &image, false) >>>
    clip := animation.new_atlas_animation(4, 1, 0, 4, 8.0, true) >>>
    $animator := animation.new_sprite_animator(clip) >>>
    $tree := scene.new_scene_tree("PhoneArena", 64) >>>
    root := tree.root()
    player := tree.add_child(root, "Player") >>>
    $position := fm.vec2(42.0, 180.0)
    tree.set_position(player, position) >>>
    solids := [fm.rect2(8.0, 8.0, 344.0, 8.0), fm.rect2(8.0, 404.0, 344.0, 8.0),
        fm.rect2(8.0, 16.0, 8.0, 388.0), fm.rect2(344.0, 16.0, 8.0, 388.0),
        fm.rect2(122.0, 75.0, 14.0, 225.0), fm.rect2(224.0, 140.0, 14.0, 214.0)]
    save_path := app_host.resolve_data("arena-v1.json", "build") >>>
    $checkpoint := load_checkpoint(save_path + "", &solids) >>>
    position = checkpoint.position
    tree.set_position(player, position) >>>
    tree.paused = checkpoint.paused
    $mixer := mix.new_mixer(48000, 16) >>>
    sfx_bus := mixer.add_bus(0, "SFX", 0.9) >>>
    chime_path := app_host.resolve_resource("chime.wav", "examples/audio/assets") >>>
    chime_clip := mixer.add_clip(audio_assets.load_wav(chime_path) >>>) >>>
    $output := audio.open_output(48000) >>>
    mixer.pause_bus(sfx_bus, tree.paused) >>>
    if !tree.paused {
        audio.pump(&output, $&mixer, 2048, 512) >>>
    }
    output.pause(tree.paused) >>>
    $score := 0
    $save_dirty := true
    $save_now := false
    $last_save := now_ns()
    $world_canvas := scene_render.new_canvas_2d()
    for i in 0:solids.len {
        node := tree.add_child(root, "Wall" + str(i)) >>>
        world_canvas.add_rect(node, solids[i], WALL) >>>
    }
    locations := [fm.vec2(65.0, 52.0), fm.vec2(294.0, 52.0), fm.vec2(65.0, 365.0),
        fm.vec2(294.0, 365.0), fm.vec2(177.0, 90.0), fm.vec2(287.0, 250.0)]
    $gems := []Gem{}
    for i in 0:locations.len {
        if (checkpoint.collected & (1 << i)) != 0 {
            gems.push(Gem{node: -1, position: locations[i], collected: true})
            score = score + 1
            ->
        }
        node := tree.add_child(root, "Gem" + str(i)) >>>
        tree.set_position(node, locations[i]) >>>
        world_canvas.add_rect(node, fm.rect2(-6.0, -6.0, 12.0, 12.0), GOLD) >>>
        gems.push(Gem{node: node, position: locations[i], collected: false})
    }
    $sprite := scene_render.Sprite2D{node: player, bounds: fm.rect2(0.0, 0.0, 22.0, 22.0),
        region: animator.region() >>>, tint: WHITE}
    $view := vp.from_window(renderer.window() >>>) >>>
    $touch := touch_layout(&view) >>>
    $input := new_input() >>>
    $host := app_host.new_app_host(60, 8, 320, 260) >>>
    host.enable_back_handling() >>>
    $animation_time := 0.0
    $frames := 0
    $batch := canvas.new_batch()
    $sprite_batch := canvas.new_batch()
    $overlay := canvas.new_batch()
    println("Phone arena ready; backend=" + str(renderer.backend() >>>) + "; PNG=" + str(image.width) + "x" + str(image.height) +
        "; safe=" + str(int(view.safe_rect.position.x)) + "," + str(int(view.safe_rect.position.y)) + "," +
        str(int(view.safe_rect.size.x)) + "x" + str(int(view.safe_rect.size.y)))
    println("Phone arena restored position=" + (strconv.format_float(position.x, 103, -1) >>>) + "," +
        (strconv.format_float(position.y, 103, -1) >>>) +
        "; collected=" + str(checkpoint.collected) + "; audio=" + output.driver_name() + "; pid=" + str(os.getpid()))
    while (max_frames <= 0 || frames < max_frames) && (host.next_frame() >>>) {
        step := host.begin_step(renderer.window() >>>, $&input, $&touch, now_ns()) >>>
        if step.resumed {
            save_now = true
            output.clear() >>>
            mixer.pause_bus(sfx_bus, tree.paused) >>>
            output.pause(tree.paused) >>>
            println("Phone arena resumed; input and clock reset; audio_paused=" + str(tree.paused) + "; pid=" + str(os.getpid()))
        }
        if step.input_reset_reason != 0 {
            println("Phone arena input reset; reason=" + str(step.input_reset_reason))
        }
        if step.touch_ended { save_now = true }
        for ev in step.events {
            if ev.kind == events.EVENT_TOUCH_DOWN || ev.kind == events.EVENT_TOUCH_UP || ev.kind == events.EVENT_TOUCH_CANCEL {
                println("touch=" + str(ev.kind) + "; finger=" + str(ev.touch_id))
            }
        }
        if !step.running {
            output.pause(true) >>>
            output.clear() >>>
            host.finish_step(tree.paused) >>>
            <-
        }
        if !step.drawable {
            host.finish_step(true) >>>
            ->
        }
        if step.layout_changed || !view.same_geometry(&step.viewport) {
            view = step.viewport
            touch = touch_layout(&view) >>>
            println("Phone arena viewport=" + str(int(view.logical_width)) + "x" + str(int(view.logical_height)) +
                "; safe=" + str(int(view.safe_rect.position.x)) + "," + str(int(view.safe_rect.position.y)) + "," +
                str(int(view.safe_rect.size.x)) + "x" + str(int(view.safe_rect.size.y)))
        }
        if step.back_requested {
            if !tree.paused {
                tree.paused = true
                checkpoint.paused = true
                save_dirty = true
                save_now = true
                mixer.pause_bus(sfx_bus, true) >>>
                output.pause(true) >>>
                output.clear() >>>
                println("Phone arena back requested; paused=true")
            } else {
                if save_dirty {
                    save_checkpoint(save_path + "", &checkpoint, &solids) >>>
                    save_dirty = false
                }
                output.pause(true) >>>
                output.clear() >>>
                host.request_exit()
                host.finish_step(true) >>>
                println("Phone arena back requested while paused; exiting")
                <-
            }
        }
        if input.just_pressed("pause") >>> {
            tree.paused = !tree.paused
            checkpoint.paused = tree.paused
            save_dirty = true
            save_now = true
            mixer.pause_bus(sfx_bus, tree.paused) >>>
            if tree.paused {
                output.pause(true) >>>
                output.clear() >>>
            } else {
                mixer.play(chime_clip, sfx_bus, 0.25, 0.0, false) >>>
                audio.pump(&output, $&mixer, 2048, 512) >>>
                output.pause(false) >>>
            }
            println("Phone arena paused=" + str(tree.paused))
        }
        ticks := host.finish_step(tree.paused) >>>
        if !tree.paused {
            direction := input.vector("left", "right", "up", "down") >>>
            $speed := 110.0
            if input.pressed("boost") >>> { speed = 190.0 }
            for _step in 0:ticks.steps {
                animation_time = animation_time + ticks.fixed_delta
                if direction.length() > 0.0 { animator.advance(ticks.fixed_delta) >>> }
                result := physics.move_and_slide(fm.rect2(position.x, position.y, 22.0, 22.0),
                    direction.scaled(speed * ticks.fixed_delta), &solids) >>>
                if result.position.x != position.x || result.position.y != position.y { save_dirty = true }
                position = result.position
                checkpoint.position = position
                tree.set_position(player, position) >>>
                for i in 0:gems.len {
                    if !gems[i].collected && position.add(fm.vec2(11.0, 11.0)).sub(gems[i].position).length() < 22.0 {
                        gems[i].collected = true
                        score = score + 1
                        checkpoint.collected = checkpoint.collected | (1 << i)
                        save_dirty = true
                        save_now = true
                        tree.queue_free(gems[i].node) >>>
                        pan := math.max(-0.75, math.min(0.75, (gems[i].position.x - 180.0) / 160.0))
                        mixer.play(chime_clip, sfx_bus, 0.65, pan, false) >>>
                        println("Phone arena collected=" + str(score) + "/6")
                    }
                }
            }
            audio.pump(&output, $&mixer, 2048, 512) >>>
        }
        for gem in gems {
            if !gem.collected { tree.set_transform(gem.node,
                fm.transform_2d(gem.position, animation_time, fm.vec2(1.0, 1.0))) >>> }
        }
        tree.flush_free() >>>
        fit := world_fit(&view) >>>
        pixels := view.screen_transform()
        world_view := fit.world_to_pixels(&view)
        batch.clear()
        sprite_batch.clear()
        overlay.clear()
        batch.quad(fm.rect2(0.0, 0.0, 360.0, 420.0), world_view, PANEL) >>>
        for i in 0:11 { batch.quad(fm.rect2(16.0 + f64(i) * 30.0, 16.0, 1.0, 388.0), world_view, GRID) >>> }
        for i in 0:13 { batch.quad(fm.rect2(16.0, 16.0 + f64(i) * 30.0, 328.0, 1.0), world_view, GRID) >>> }
        world_canvas.record(&tree, world_view, $&batch) >>>
        sprite.region = animator.region() >>>
        sprite.record(&tree, world_view, $&sprite_batch) >>>
        draw_controls($&overlay, &touch, &view, pixels, tree.paused, score) >>>
        renderer.begin(BACKGROUND) >>>
        renderer.submit(&batch) >>>
        renderer.submit_texture(&sprite_batch, &texture) >>>
        renderer.submit(&overlay) >>>
        renderer.present() >>>
        if save_dirty && (save_now || frames == 0 || now_ns() - last_save >= 1000000000) {
            save_checkpoint(save_path + "", &checkpoint, &solids) >>>
            save_dirty = false
            last_save = now_ns()
        }
        save_now = false
        frames = frames + 1
    }
    if save_dirty { save_checkpoint(save_path, &checkpoint, &solids) >>> }
    output.pause(true) >>>
    output.clear() >>>
    output.close() >>>
    texture.close() >>>
    renderer.close() >>>
    println("Phone arena finished; frames=" + str(frames) + "; score=" + str(score))
    << 0
}
fn main() int { << run() >>> (err) { eprintln(err.msg())
    << 1 } }
