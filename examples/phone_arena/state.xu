@main

fm #"github.com/xulang-org/game/foundation/math"
files #"github.com/xulang-org/game/internal/file_snapshot"
#encoding/json
#os
#strconv
#errors

struct Checkpoint { position fm.Vec2
    collected int
    paused bool }
fn new_checkpoint() Checkpoint { << Checkpoint{position: fm.vec2(42.0, 180.0), collected: 0, paused: false} }
fn valid_checkpoint(state &Checkpoint, solids &[]fm.Rect2) bool {
    if !fm.finite(state.position.x) || !fm.finite(state.position.y) || state.position.x < 16.0 ||
        state.position.y < 16.0 || state.position.x > 322.0 || state.position.y > 382.0 ||
        state.collected < 0 || state.collected > 63 { << false }
    bounds := fm.rect2(state.position.x, state.position.y, 22.0, 22.0)
    for solid in solids { if bounds.overlaps(solid) { << false } }
    << true
}
fn decode_checkpoint(raw &string, solids &[]fm.Rect2) Checkpoint {
    document := json.parse_max(raw, 4096)
    root := document.root()
    if !document.ok() || !document.is_dict(root) || document.count(root) != 5 {
        >> errors.new("arena: invalid checkpoint object")
    }
    version := document.get(root, "version")
    x := document.get(root, "x")
    y := document.get(root, "y")
    mask := document.get(root, "collected")
    paused := document.get(root, "paused")
    if version < 0 || x < 0 || y < 0 || mask < 0 || paused < 0 {
        >> errors.new("arena: missing checkpoint fields")
    }
    if !document.is_number(version) || !document.is_number(x) || !document.is_number(y) ||
        !document.is_number(mask) || !document.is_bool(paused) {
        >> errors.new("arena: invalid checkpoint fields")
    }
    if document.as_int(version) or >> != 1 { >> errors.new("arena: unsupported checkpoint version") }
    state := Checkpoint{position: fm.vec2(document.as_f64(x) or >>, document.as_f64(y) or >>),
        collected: document.as_int(mask) or >>, paused: document.as_bool(paused) or >>}
    if !valid_checkpoint(&state, solids) { >> errors.new("arena: checkpoint outside playable world") }
    << state
}
fn encode_checkpoint(state &Checkpoint, solids &[]fm.Rect2) string {
    if !valid_checkpoint(state, solids) { >> errors.new("arena: cannot save invalid checkpoint") }
    << "{\"version\":1,\"x\":" + (strconv.format_float(state.position.x, 103, -1) or >>) +
        ",\"y\":" + (strconv.format_float(state.position.y, 103, -1) or >>) +
        ",\"collected\":" + str(state.collected) + ",\"paused\":" + str(state.paused) + "}\n"
}
fn load_checkpoint(path string, solids &[]fm.Rect2) Checkpoint {
    raw := files.read(path + "", 4096) or (err) {
        if os.is_not_exist(err.msg()) { << new_checkpoint() }
        >> err
    }
    << decode_checkpoint(&raw, solids) or (err) {
        rejected := path + ".rejected-" + str(now_ns())
        os.rename(path, rejected + "") or >>
        eprintln("arena: kept invalid checkpoint at " + rejected + "; " + err.msg())
        << new_checkpoint()
    }
}
fn save_checkpoint(path string, state &Checkpoint, solids &[]fm.Rect2) int {
    raw := encode_checkpoint(state, solids) or >>
    << files.write_atomic(path, &raw) or >>
}
