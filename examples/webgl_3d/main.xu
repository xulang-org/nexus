@main

fm #"github.com/xulang-org/nexus/foundation/math"
gltf #"github.com/xulang-org/nexus/formats/gltf"
meshes #"github.com/xulang-org/nexus/resources/mesh"
scene #"github.com/xulang-org/nexus/scene"
webgl #"github.com/xulang-org/nexus/integration/rendering/webgl"
#math
#image/png
#os
#errors

const WIDTH = 360
const HEIGHT = 240

fn quad(mesh $&meshes.MeshData3D, a fm.Vec3, b fm.Vec3, c fm.Vec3, d fm.Vec3, color int) int {
    base := mesh.vertex_count()
    for p in [a, b, c, d] { mesh.vertex(p, color) >>> }
    mesh.triangle(base, base + 1, base + 2) >>>
    mesh.triangle(base, base + 2, base + 3) >>>
    << 0
}

fn sphere(mesh $&meshes.MeshData3D, center fm.Vec3, radius f64, color int) int {
    shape := meshes.sphere_mesh_3d(radius, 16, 8, color) >>>
    base := mesh.vertex_count()
    light := fm.vec3(-0.5, 0.8, 0.3)
    for vertex in shape.vertices {
        shade := 0.4 + 0.6 * math.max(0.0, light.dot(vertex.normal))
        r := int(f64((color >> 24) & 255) * shade)
        g := int(f64((color >> 16) & 255) * shade)
        b := int(f64((color >> 8) & 255) * shade)
        mesh.vertex(center.add(vertex.position), (r << 24) | (g << 16) | (b << 8) | 255) >>>
    }
    for i in 0:shape.triangle_count() {
        mesh.triangle(base + shape.indices[i * 3], base + shape.indices[i * 3 + 1],
            base + shape.indices[i * 3 + 2]) >>>
    }
    << 0
}

fn floor(mesh $&meshes.MeshData3D) int {
    for row in 0:6 {
        z := f64(row - 3)
        for column in 0:6 {
            x := f64(column - 3)
            $color := 0x273c53ff
            if (row + column) % 2 == 0 { color = 0x354d65ff }
            quad(mesh, fm.vec3(x, 0.0, z), fm.vec3(x, 0.0, z + 1.0),
                fm.vec3(x + 1.0, 0.0, z + 1.0), fm.vec3(x + 1.0, 0.0, z), color) >>>
        }
    }
    << 0
}

pub fn nexus_reset() int { << 0 }

fn png_dimension(data &[]int, offset int) int {
    << (data[offset] << 24) | (data[offset + 1] << 16) | (data[offset + 2] << 8) | data[offset + 3]
}

fn write_packet(packet string) int {
    expected := packet.len
    if (os.fd_write(1, packet) >>>) != expected { >> errors.new("Nexus WebGL 3D: short packet write") }
    << 0
}

fn load_model(length int) int {
    if length < 1 || length > 524288 { >> errors.new("Nexus WebGL 3D: invalid GLB size") }
    raw := os.fd_read(0, length) >>>
    if raw.len != length { >> errors.new("Nexus WebGL 3D: short GLB read") }
    asset := gltf.decode_glb_geometry(&raw) >>>
    if asset.primitive_count() != 1 || asset.node_count() != 1 || asset.skin_count() != 0 ||
        !(asset.has_uvs(0) >>>) || !(asset.has_normals(0) >>>) {
        >> errors.new("Nexus WebGL 3D: expected one static textured primitive with UV and normals")
    }
    material := asset.material(asset.primitive_material(0) >>>) >>>
    texture := asset.texture(material.base_texture) >>>
    if (asset.image_mime(texture.image) >>>) != "image/png" {
        >> errors.new("Nexus WebGL 3D: expected an embedded PNG")
    }
    bytes := asset.image_bytes(texture.image) >>>
    if bytes.len < 33 || png_dimension(&bytes, 12) != 0x49484452 {
        >> errors.new("Nexus WebGL 3D: missing PNG header")
    }
    width := png_dimension(&bytes, 16)
    height := png_dimension(&bytes, 20)
    if width < 1 || width > 256 || height < 1 || height > 256 {
        >> errors.new("Nexus WebGL 3D: embedded texture exceeds 256 × 256")
    }
    $encoded := ""
    for value in bytes { encoded.push_byte(value) }
    decoded := png.decode(&encoded) >>>

    $model := meshes.new_mesh_data_3d()
    light := fm.vec3(0.45, 0.8, 0.35)
    count := asset.vertex_count(0) >>>
    for i in 0:count {
        normal := asset.normal(0, i) >>>
        shade := int(255.0 * (0.46 + 0.54 * math.max(0.0, light.dot(normal))))
        tint := (shade << 24) | (shade << 16) | (shade << 8) | 255
        model.vertex_uv(asset.position(0, i) >>>, tint, asset.uv(0, i) >>>) >>>
    }
    indices := asset.index_count(0) >>>
    for i in 0:indices / 3 {
        at := i * 3
        model.triangle(asset.index(0, at) >>>, asset.index(0, at + 1) >>>, asset.index(0, at + 2) >>>) >>>
    }
    $solid := meshes.new_mesh_data_3d()
    sphere($&solid, fm.vec3(0.74, 0.73, 1.34), 0.73, 0xffbd61ff) >>>
    sphere($&solid, fm.vec3(-1.5, 0.68, -0.8), 0.68, 0xa498ffff) >>>
    floor($&solid) >>>
    packet := webgl.encode_mesh_asset(&solid, &model, width, height, &decoded.pix) >>>
    << write_packet(packet) >>>
}

pub fn nexus_load_model(length int) int {
    << load_model(length) >>> (err) {
        eprintln(err.msg())
        << -1
    }
}

fn clamp_int(value int, lo int, hi int) int {
    if value < lo { << lo }
    if value > hi { << hi }
    << value
}

fn render(state int) int {
    yaw_idx := (state >> 3) & 255
    pitch_raw := (state >> 11) & 127
    $pitch_offset := pitch_raw
    if pitch_raw >= 64 { pitch_offset = pitch_raw - 128 }

    yaw := 0.58 + f64(yaw_idx) * (2.0 * math.pi() / 256.0)
    raw_pitch := 0.508 + f64(pitch_offset) * 0.03
    pitch := math.max(-1.45, math.min(1.45, raw_pitch))

    $camera := scene.new_camera_3d()
    camera.target = fm.vec3(0.0, 0.65, 0.0)
    orbit := fm.rotation_y(yaw).multiply(fm.rotation_x(-pitch))
    camera.position = camera.target.add(orbit.transform(fm.vec4(0.0, 0.0, 9.2, 1.0)).xyz())
    camera.vertical_fov = 0.87
    camera.far = 40.0
    view_projection := camera.view_projection(f64(WIDTH) / f64(HEIGHT)) >>>

    write_packet(webgl.encode_camera_frame(view_projection) >>>) >>>
    << state
}

pub fn nexus_frame(state int, x int, y int, delta_us int) int {
    // Bit 1 resets camera state; negative input falls back to initial state.
    $cur := state
    if cur < 0 || (cur & 2) != 0 { cur = 0 }

    was_dragging := (cur & 1) != 0
    $yaw_idx := (cur >> 3) & 255
    pitch_raw := (cur >> 11) & 127
    $pitch_offset := pitch_raw
    if pitch_raw >= 64 { pitch_offset = pitch_raw - 128 }

    $next := 0
    if x >= 0 && y >= 0 {
        cx := clamp_int(x, 0, WIDTH - 1)
        cy := clamp_int(y, 0, HEIGHT - 1)
        cur_x_enc := (cx / 3) + 1
        cur_y_enc := (cy / 4) + 1
        if was_dragging {
            prev_x_enc := (cur >> 18) & 127
            prev_y_enc := (cur >> 25) & 63
            if prev_x_enc > 0 && prev_y_enc > 0 {
                dx := cur_x_enc - prev_x_enc
                dy := cur_y_enc - prev_y_enc
                yaw_idx = (yaw_idx + dx) & 255
                pitch_offset = clamp_int(pitch_offset - dy, -64, 31)
            }
        }
        next = 1 | (yaw_idx << 3) | ((pitch_offset & 127) << 11) | (cur_x_enc << 18) | (cur_y_enc << 25)
    } else {
        $sub_yaw := 0
        $has_interacted := 0
        if was_dragging {
            has_interacted = 1
        } else {
            sub_yaw = (cur >> 18) & 127
            has_interacted = (cur >> 25) & 1
        }
        if has_interacted == 0 && delta_us > 0 {
            dt_us := clamp_int(delta_us, 0, 100000)
            total_sub := sub_yaw + (dt_us * 1043) / 1000000
            yaw_idx = (yaw_idx + (total_sub >> 7)) & 255
            sub_yaw = total_sub & 127
        }
        next = (yaw_idx << 3) | ((pitch_offset & 127) << 11) | (sub_yaw << 18) | (has_interacted << 25)
    }

    << render(next) >>> (err) {
        eprintln(err.msg())
        << -1
    }
}

fn main() int { << 0 }
