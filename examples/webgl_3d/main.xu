@main

fm #"github.com/xulang-org/nexus/foundation/math"
meshes #"github.com/xulang-org/nexus/resources/mesh"
scene #"github.com/xulang-org/nexus/scene"
webgl #"github.com/xulang-org/nexus/integration/rendering/webgl"
#math
#os
#errors

const WIDTH = 360
const HEIGHT = 240

fn quad(mesh $&meshes.MeshData3D, a fm.Vec3, b fm.Vec3, c fm.Vec3, d fm.Vec3, color int) int {
    base := mesh.vertex_count()
    for p in [a, b, c, d] { mesh.vertex(p, color) or >> }
    mesh.triangle(base, base + 1, base + 2) or >>
    mesh.triangle(base, base + 2, base + 3) or >>
    << 0
}

fn cube(mesh $&meshes.MeshData3D) int {
    a := fm.vec3(-1.1, 0.04, 0.95)
    b := fm.vec3(0.8, 0.04, 0.95)
    c := fm.vec3(0.8, 1.94, 0.95)
    d := fm.vec3(-1.1, 1.94, 0.95)
    back := fm.vec3(0.0, 0.0, -1.9)
    e := a.add(back)
    f := b.add(back)
    g := c.add(back)
    h := d.add(back)
    quad(mesh, a, b, c, d, 0x28bfb7ff) or >>
    quad(mesh, b, f, g, c, 0x2088a2ff) or >>
    quad(mesh, d, c, g, h, 0x7cf8d4ff) or >>
    quad(mesh, e, a, d, h, 0x247993ff) or >>
    quad(mesh, f, e, h, g, 0x249fafff) or >>
    quad(mesh, e, f, b, a, 0x195873ff) or >>
    << 0
}

fn sphere(mesh $&meshes.MeshData3D, center fm.Vec3, radius f64, color int) int {
    shape := meshes.sphere_mesh_3d(radius, 16, 8, color) or >>
    base := mesh.vertex_count()
    light := fm.vec3(-0.5, 0.8, 0.3)
    for vertex in shape.vertices {
        shade := 0.4 + 0.6 * math.max(0.0, light.dot(vertex.normal))
        r := int(f64((color >> 24) & 255) * shade)
        g := int(f64((color >> 16) & 255) * shade)
        b := int(f64((color >> 8) & 255) * shade)
        mesh.vertex(center.add(vertex.position), (r << 24) | (g << 16) | (b << 8) | 255) or >>
    }
    for i in 0:shape.triangle_count() {
        mesh.triangle(base + shape.indices[i * 3], base + shape.indices[i * 3 + 1],
            base + shape.indices[i * 3 + 2]) or >>
    }
    << 0
}

fn floor(mesh $&meshes.MeshData3D) int {
    for row in 0:6 {
        z := f64(row - 3)
        for column in 0:6 {
            x := f64(column - 3)
            $color := 0x273c53ff
            if (row + column) % 2 == 0 { color = 0x354d65ff }
            quad(mesh, fm.vec3(x, 0.0, z), fm.vec3(x, 0.0, z + 1.0),
                fm.vec3(x + 1.0, 0.0, z + 1.0), fm.vec3(x + 1.0, 0.0, z), color) or >>
        }
    }
    << 0
}

pub fn nexus_reset() int { << 180 | (120 << 9) }

fn render(state int) int {
    yaw := 0.58 + f64((state & 511) - 180) * 0.014
    pitch := 0.22 + f64(HEIGHT - (state >> 9)) * 0.0024
    $camera := scene.new_camera_3d()
    camera.target = fm.vec3(0.0, 0.65, 0.0)
    orbit := fm.rotation_y(yaw).multiply(fm.rotation_x(-pitch))
    camera.position = camera.target.add(orbit.transform(fm.vec4(0.0, 0.0, 9.2, 1.0)).xyz())
    camera.vertical_fov = 0.87
    camera.far = 40.0
    view_projection := camera.view_projection(f64(WIDTH) / f64(HEIGHT)) or >>

    $mesh := meshes.new_mesh_data_3d()
    sphere($&mesh, fm.vec3(0.74, 0.73, 1.34), 0.73, 0xffbd61ff) or >>
    cube($&mesh) or >>
    sphere($&mesh, fm.vec3(-1.5, 0.68, -0.8), 0.68, 0xa498ffff) or >>
    // Submit the ground last so visibility depends on depth rather than ordering.
    floor($&mesh) or >>
    packet := webgl.encode_mesh_frame(&mesh, view_projection) or >>
    expected := packet.len
    if (os.fd_write(1, packet) or >>) != expected {
        >> errors.new("Nexus WebGL 3D: short frame write")
    }
    << state
}

pub fn nexus_frame(state int, x int, y int, delta_us int) int {
    $next := state
    if x >= 0 && x < WIDTH && y >= 0 && y < HEIGHT { next = x | (y << 9) }
    << render(next) or (err) {
        eprintln(err.msg())
        << -1
    }
}

fn main() int { << 0 }
