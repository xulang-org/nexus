@main

// Lit 3D scene composited with an interactive #ui/widgets + XDF1 HUD across GPU,
// CPU software RGBA8, and headless fallbacks using nexus/integration/ui.

#errors
#gpu
#math
#os
#strconv
#time
#ui
#ui/draw
#ui/layout
phone #ui/phone
widgets #ui/widgets
#window
wev #window/events
fm #"github.com/xulang-org/nexus/foundation/math"
ui_bridge #"github.com/xulang-org/nexus/integration/ui"
scene_render #"github.com/xulang-org/nexus/integration/rendering/three_d"
lights #"github.com/xulang-org/nexus/resources/lighting"
meshes #"github.com/xulang-org/nexus/resources/mesh"
ren2 #"github.com/xulang-org/nexus/rendering/two_d"
ren3 #"github.com/xulang-org/nexus/rendering/three_d"
scene #"github.com/xulang-org/nexus/scene"
shaders2 #"github.com/xulang-org/nexus/assets/shaders/two_d"
shaders3 #"github.com/xulang-org/nexus/assets/shaders/three_d"

struct HudOptions {
    frames int
    hidden bool
    canvas_shaders string
    mesh_shaders string
    capture string
}

fn parse_options() HudOptions {
    args := os.args()
    $out := HudOptions{
        frames: 0,
        hidden: false,
        canvas_shaders: "build/canvas-shaders",
        mesh_shaders: "build/mesh-shaders",
        capture: ""
    }
    $i := 1
    while i < args.len {
        arg := args[i]
        if arg == "--hidden" {
            out.hidden = true
            i = i + 1
        } else if arg == "--frames" && i + 1 < args.len {
            next := i + 1
            out.frames = strconv.atoi(&args[next]) >>> (err) { << out }
            i = i + 2
        } else if arg == "--canvas-shaders" && i + 1 < args.len {
            out.canvas_shaders = args[i + 1] + ""
            i = i + 2
        } else if arg == "--mesh-shaders" && i + 1 < args.len {
            out.mesh_shaders = args[i + 1] + ""
            i = i + 2
        } else if arg == "--capture" && i + 1 < args.len {
            out.capture = args[i + 1] + ""
            i = i + 2
        } else {
            i = i + 1
        }
    }
    << out
}

fn build_widgets_xdf_card(vp &layout.Rect, id &ui.CanvasEvent, styles &widgets.Styles,
        phase f64, cmd &string, highlight bool) string {
    ctx := draw.default_context()
    $f := ctx.new_frame(4096)
    f.begin() >>>
    card := widgets.card(vp)
    title_s := "WIDGETS XDF1"
    $card_title := widgets.styled_label(&ctx, &title_s)
    card.paint_header_styled($&f, $&card_title, styles) >>>
    card_title.dispose()

    inner := card.content_bounds(styles)
    $chip := widgets.button(id, 41, &layout.Rect{x: inner.x, y: inner.y + 24.0, width: inner.width, height: 24.0})
    chip.set_selected(highlight)
    btn_txt := "CMD: " + cmd
    $chip_lbl := widgets.styled_label(&ctx, &btn_txt)
    chip.paint_styled($&f, $&chip_lbl, styles) >>>
    chip_lbl.dispose()

    prog := widgets.progress(&layout.Rect{x: inner.x, y: inner.y + 54.0, width: inner.width, height: 10.0}, phase)
    prog.paint_styled($&f, styles) >>>
    << f.export_xdf() >>>
}

fn build_phone_xdf_card(vp &layout.Rect, mode_name &string, pulses int, orbiting bool) string {
    ctx := draw.default_context()
    $c := phone.canvas(&ctx)
    th := phone.dark_theme()
    c.begin(&th) >>>
    c.card(layout.Rect{x: vp.x, y: vp.y, width: vp.width, height: vp.height}, &th) >>>
    $stat := "PAUSED"
    if orbiting { stat = "ACTIVE" }
    c.row(layout.Rect{x: vp.x + 8.0, y: vp.y + 6.0, width: vp.width - 16.0, height: 40.0},
        &th, "PHONE CANVAS", mode_name + " / " + stat, phone.ICON_ACTIVITY, false) >>>
    c.chip(layout.Rect{x: vp.x + 10.0, y: vp.y + 52.0, width: 92.0, height: 28.0},
        &th, "PULSES " + str(pulses), true, false) >>>
    c.button(layout.Rect{x: vp.x + 108.0, y: vp.y + 52.0, width: vp.width - 118.0, height: 30.0},
        &th, "XDF READY", true, false) >>>
    << c.export_xdf() >>>
}

fn run() int {
    opts := parse_options()
    canvas_prog := shaders2.load_canvas(opts.canvas_shaders + "") >>>
    sdf_prog := shaders2.load_ui_sdf(opts.canvas_shaders + "") >>>
    text_prog := shaders2.load_ui_text(opts.canvas_shaders + "") >>>
    mesh_prog := shaders3.load_mesh(opts.mesh_shaders + "") >>>

    w := 640
    h := 420
    wopts := window.Options{
        title: "Xu Engine UI HUD (3D + #ui/widgets + XDF1)",
        width: w,
        height: h,
        resizable: false,
        high_pixel_density: false,
        hidden: opts.hidden
    }
    $dev := ren3.open_3d_window_adaptive(wopts, gpu.AUTO, &mesh_prog) >>>
    $overlay := ren2.open_overlay(dev.present_session() >>>, &canvas_prog, &sdf_prog) >>>
    overlay.enable_text(dev.present_session() >>>, &text_prog) >>>

    $cube_mesh := dev.upload(&meshes.sphere_mesh_3d(1.15, 6, 4, 4294967295) >>>) >>>
    $orb_mesh := dev.upload(&meshes.sphere_mesh_3d(0.32, 24, 14, 4294967295) >>>) >>>
    $tree := scene.new_scene_tree_3d("HudScene", 16) >>>
    cube := tree.add_child_3d(tree.root(), "Core") >>>
    orb := tree.add_child_3d(tree.root(), "Satellite") >>>
    $sc := scene_render.new_scene_3d(&dev) >>>
    sc.attach_mesh(&tree, cube, &cube_mesh) >>>
    sc.attach_mesh(&tree, orb, &orb_mesh) >>>
    sc.set_material(&tree, cube, ren3.material_3d(fm.vec3(0.24, 0.56, 0.92), 0.25, 0.35, fm.vec3(0.0, 0.0, 0.0)) >>>) >>>
    sc.set_material(&tree, orb, ren3.material_3d(fm.vec3(0.95, 0.62, 0.24), 0.1, 0.45, fm.vec3(0.1, 0.04, 0.0)) >>>) >>>

    styles := widgets.dark_styles()
    $hud := ui_bridge.new_ui_frame(&styles) >>>
    $bridge := ui_bridge.default_input_bridge()
    $router := ui_bridge.new_hud_router()
    id := bridge.canvas_identity()
    viewport := layout.Rect{x: 0.0, y: 0.0, width: f64(w), height: f64(h)}
    safe := ui_bridge.safe_viewport(f64(w), f64(h), &layout.Insets{left: 12.0, top: 14.0, right: 12.0, bottom: 14.0})
    panel_rect := ui_bridge.anchor_rect(&safe, &layout.Size{width: 212.0, height: 344.0}, 0.0, 0.0, 0.0, 0.0)
    phone_vp := ui_bridge.anchor_rect(&safe, &layout.Size{width: 216.0, height: 94.0}, 1.0, 0.0, 0.0, 0.0)
    widgets_vp := ui_bridge.anchor_rect(&safe, &layout.Size{width: 216.0, height: 98.0}, 1.0, 1.0, 0.0, 0.0)

    hud_card := widgets.card(&panel_rect)
    mode_badge := widgets.badge(&layout.Rect{x: panel_rect.x + 12.0, y: panel_rect.y + 42.0, width: 188.0, height: 22.0})
    $btn_pulse := widgets.button(&id, 1, &layout.Rect{x: panel_rect.x + 12.0, y: panel_rect.y + 72.0, width: 188.0, height: 32.0})
    btn_pulse.set_focus(true)
    $sw_orbit := widgets.switch_control(&id, 2, &layout.Rect{x: panel_rect.x + 12.0, y: panel_rect.y + 112.0, width: 188.0, height: 28.0}, true)
    $cb_wire := widgets.checkbox(&id, 3, &layout.Rect{x: panel_rect.x + 12.0, y: panel_rect.y + 146.0, width: 188.0, height: 26.0}, false)
    $rd_day := widgets.radio(&id, 4, &layout.Rect{x: panel_rect.x + 12.0, y: panel_rect.y + 178.0, width: 90.0, height: 26.0}, 0, true)
    $rd_dusk := widgets.radio(&id, 5, &layout.Rect{x: panel_rect.x + 110.0, y: panel_rect.y + 178.0, width: 90.0, height: 26.0}, 1, false)
    $sl_speed := widgets.slider(&id, 6, &layout.Rect{x: panel_rect.x + 12.0, y: panel_rect.y + 210.0, width: 188.0, height: 26.0}, 0.2, 2.5, 1.1)
    $pr_cycle := widgets.progress(&layout.Rect{x: panel_rect.x + 12.0, y: panel_rect.y + 244.0, width: 188.0, height: 10.0}, 0.25)
    hud_div := widgets.divider(&layout.Rect{x: panel_rect.x + 12.0, y: panel_rect.y + 262.0, width: 188.0, height: 6.0}, widgets.AXIS_HORIZONTAL)
    $cmd_field := ui_bridge.new_text_field(30, &layout.Rect{x: panel_rect.x + 12.0, y: panel_rect.y + 276.0, width: 188.0, height: 34.0}, "orb-01", "command...") >>>
    $help_modal := widgets.modal(&id, 7, &layout.Rect{x: 180.0, y: 120.0, width: 280.0, height: 140.0}, &viewport)

    $sim_time := 0.0
    $yaw_offset := 0.0
    $pulses := 0
    $frame_idx := 0
    $running := true
    view := scene.look_at_3d(fm.vec3(0.0, 1.6, 4.6), fm.vec3(0.0, 0.0, 0.0), fm.vec3(0.0, 1.0, 0.0)) >>>
    proj := scene.perspective_3d(0.75, f64(w) / f64(h), 0.1, 100.0) >>>
    vp := proj.multiply(view)

    while running && (opts.frames <= 0 || frame_idx < opts.frames) {
        router.begin_frame()
        router.add_rect(&panel_rect) >>>
        router.add_rect(&phone_vp) >>>
        router.add_rect(&widgets_vp) >>>
        if help_modal.is_visible() {
            mb := help_modal.bounds()
            router.add_rect(&mb) >>>
        }
        router.set_modal(help_modal.blocks_input())
        router.set_text_focused(cmd_field.focused)

        for {
            ev := dev.poll()
            if ev.kind == wev.EVENT_NONE { <- }
            if ev.kind == wev.EVENT_CLOSE_REQUESTED {
                running = false
                <-
            }
            dec := router.route_event($&bridge, &ev)
            if dec.to_ui && ui_bridge.is_ui_input(&dec.ui_event) {
                ui_ev := dec.ui_event
                if help_modal.blocks_input() {
                    _ := help_modal.input(&ui_ev)
                } else {
                    _ := cmd_field.handle_input(&hud, &ui_ev, &dec.text)
                    router.set_text_focused(cmd_field.focused)
                    if btn_pulse.input(&ui_ev).kind == widgets.ACTION_ACTIVATE { pulses = pulses + 1 }
                    _ := sw_orbit.input(&ui_ev)
                    _ := cb_wire.input(&ui_ev)
                    if rd_day.input(&ui_ev).kind == widgets.ACTION_CHANGE {
                        rd_day.set_value(true)
                        rd_dusk.set_value(false)
                    }
                    if rd_dusk.input(&ui_ev).kind == widgets.ACTION_CHANGE {
                        rd_day.set_value(false)
                        rd_dusk.set_value(true)
                    }
                    _ := sl_speed.input(&ui_ev)
                }
            } else if dec.to_ui && dec.text.len > 0 {
                _ := cmd_field.handle_input(&hud, &dec.ui_event, &dec.text)
            }
            if dec.to_game {
                if ev.kind == wev.EVENT_KEY_DOWN && ev.physical_key == wev.KEY_H {
                    if help_modal.is_open() { help_modal.close(time.zero_instant(), true) >>> }
                    else { help_modal.open(time.zero_instant(), true, 1) >>> }
                } else if ev.kind == wev.EVENT_POINTER_MOVE && router.mouse_capture() == ui_bridge.ROUTE_GAME {
                    yaw_offset = yaw_offset + ev.dx * 0.012
                }
            }
        }
        if !running { <- }

        if sw_orbit.value() {
            sim_time = sim_time + 0.016 * sl_speed.value()
        }
        cycle := math.mod(sim_time * 0.25, 1.0)
        pr_cycle.set_value(cycle) >>>

        tree.set_transform_3d(cube, fm.rotation_y(sim_time * 0.9 + yaw_offset).multiply(fm.rotation_x(0.45))) >>>
        orb_pos := fm.vec3(math.cos(sim_time * 1.4 + yaw_offset) * 1.85, 0.35 * math.sin(sim_time * 2.2), math.sin(sim_time * 1.4 + yaw_offset) * 1.85)
        tree.set_transform_3d(orb, fm.translation_3d(orb_pos)) >>>

        $sky := 286931455
        if rd_dusk.value() { sky = 437397759 }
        sun := lights.directional(fm.vec3(0.6, 0.8, 0.4), fm.vec3(2.4, 2.25, 2.1)) >>>
        lighting := lights.environment(fm.vec3(0.14, 0.17, 0.24), fm.vec3(0.0, 1.6, 4.6), 1.0, [sun]) >>>

        hud.begin() >>>
        card_title := "ENGINE UI HUD"
        hud.card(&hud_card, &card_title) >>>
        mode_lbl := "MODE: " + dev.mode_name()
        hud.badge(&mode_badge, &mode_lbl) >>>
        btn_txt := "Pulse (" + str(pulses) + ")"
        hud.button(&btn_pulse, &btn_txt) >>>
        sw_txt := "Orbit Scene"
        hud.switch_control(&sw_orbit, &sw_txt) >>>
        cb_txt := "Show Highlight"
        hud.checkbox(&cb_wire, &cb_txt) >>>
        day_txt := "Day"
        hud.radio(&rd_day, &day_txt) >>>
        dusk_txt := "Dusk"
        hud.radio(&rd_dusk, &dusk_txt) >>>
        hud.slider(&sl_speed) >>>
        hud.progress(&pr_cycle) >>>
        hud.divider(&hud_div) >>>
        hud.text_field(&cmd_field) >>>

        mode_str := dev.mode_name()
        phone_blob := build_phone_xdf_card(&phone_vp, &mode_str, pulses, sw_orbit.value()) >>>
        hud.replay_xdf(&phone_blob, &phone_vp) >>>

        widgets_blob := build_widgets_xdf_card(&widgets_vp, &id, &styles, cycle, &cmd_field.text, cb_wire.value()) >>>
        hud.replay_xdf(&widgets_blob, &widgets_vp) >>>

        if help_modal.is_visible() {
            hud.modal_backdrop(&viewport, &help_modal) >>>
            mb := help_modal.bounds()
            modal_msg := "Press H to toggle modal"
            hud.draw_label(&mb, &modal_msg, draw.rgb(240, 244, 252), 14.0, 0.5, 0.5) >>>
        }

        dev.begin(sky) >>>
        sc.draw_lit($&dev, &tree, vp, &lighting) >>>
        overlay.clear() >>>
        hud.flush_overlay(dev.present_session() >>>, $&overlay) >>>

        if dev.is_gpu() {
            $pf := dev.begin_present_frame() >>>
            overlay.flush_gpu_frame(dev.gpu_device() >>>, $&pf, w, h, gpu.LOAD, 0) >>>
            dev.finish_present_frame($&pf) >>>
        } else {
            dev.software_prepare_present() >>>
            overlay.flush_software(dev.software_pixels_mut() >>>, w, h, false, 0) >>>
            if opts.capture.len > 0 && frame_idx == 0 {
                sess_cap := dev.present_session() >>>
                sess_cap.capture_software_png(opts.capture + "") >>>
            }
            dev.present_software_frame() >>>
        }
        frame_idx = frame_idx + 1
    }

    mode_label := dev.mode_name() >>>
    overlay.close() >>>
    cube_mesh.close() >>>
    orb_mesh.close() >>>
    dev.close() >>>
    println("UI HUD example complete: mode=" + mode_label + " frames=" + str(frame_idx))
    << 0
}

fn main() int {
    << run() >>> (err) {
        eprintln(err.msg())
        << 1
    }
}
