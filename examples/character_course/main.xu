@main

fm #"github.com/xulang-org/nexus/foundation/math"
physics #"github.com/xulang-org/nexus/physics3d"
meshes #"github.com/xulang-org/nexus/resources/mesh"
lighting_data #"github.com/xulang-org/nexus/resources/lighting"
scenes #"github.com/xulang-org/nexus/scene"
loaded #"github.com/xulang-org/nexus/integration/scene_render"
renderer #"github.com/xulang-org/nexus/integration/rendering/three_d"
ren #"github.com/xulang-org/nexus/rendering/three_d"
shaders #"github.com/xulang-org/nexus/assets/shaders/three_d"
gpu_info #"github.com/xulang-org/nexus/platform/gpu"
controls #"github.com/xulang-org/nexus/input"
bridge #"github.com/xulang-org/nexus/integration/input"
timing #"github.com/xulang-org/nexus/timing"
snapshot #"github.com/xulang-org/nexus/internal/file_snapshot"
events #window/events
#gpu
#window
#math
#os
#strconv
#strings
#errors

const POSE_IDLE = 0
const POSE_WALK = 1
const POSE_AIR = 2

struct Options {
    scene string
    frames int
    autoplay bool
    capture string
    trace string
}
fn options() Options {
    args := os.args()
    $config := Options{scene: "examples/character_course/assets/course.xuscene",
        frames: 0, autoplay: false, capture: "", trace: ""}
    $i := 1
    while i < args.len {
        if args[i] == "--autoplay" {
            config.autoplay = true
            i += 1
            ->
        }
        if i + 1 >= args.len { >> errors.new("missing option value") }
        value := args[i + 1] + ""
        if args[i] == "--scene" { config.scene = value }
        else if args[i] == "--capture" { config.capture = value }
        else if args[i] == "--trace" { config.trace = value }
        else if args[i] == "--frames" {
            config.frames = strconv.atoi(&value) >>>
            if config.frames < 1 || config.frames > 3600 { >> errors.new("invalid frame count") }
        } else { >> errors.new("unknown option: " + args[i]) }
        i += 2
    }
    if config.frames == 0 && (config.capture.len > 0 || config.trace.len > 0) {
        >> errors.new("capture and trace require --frames")
    }
    << config
}

fn solid_bounds(tree &scenes.SceneTree, id int) fm.Aabb3 {
    transform := tree.global_transform_3d(id) >>>
    if transform.c0.y != 0.0 || transform.c0.z != 0.0 || transform.c1.x != 0.0 ||
        transform.c1.z != 0.0 || transform.c2.x != 0.0 || transform.c2.y != 0.0 {
        >> errors.new("course collision boxes require axis-aligned transforms")
    }
    center := transform.c3.xyz()
    half := fm.vec3(math.abs(transform.c0.x), math.abs(transform.c1.y), math.abs(transform.c2.z)).scaled(0.5)
    << fm.aabb3(center.sub(half), center.add(half)) >>>
}
fn required_child(tree &scenes.SceneTree, root int, name string) int {
    node := tree.find_child(root, name + "") >>>
    if node == 0 { >> errors.new("course scene is missing " + name) }
    << node
}
fn static_world(tree &scenes.SceneTree, root int, goal int, ramp_root int) physics.CapsuleWorld3D {
    solid_root := required_child(tree, root, "Solids") >>>
    nodes := tree.subtree(solid_root) >>>
    $boxes := []physics.StaticBox3D{}
    for i in 1:nodes.len {
        box := solid_bounds(tree, nodes[i]) >>>
        boxes.push(physics.StaticBox3D{bounds: box, trigger: false, layer: 1})
    }
    finish := solid_bounds(tree, goal) >>>
    // Extend the sampled trigger above the finish pad for a descending jump.
    volume := fm.aabb3(finish.minimum, finish.maximum.add(fm.vec3(0.0, 0.8, 0.0))) >>>
    boxes.push(physics.StaticBox3D{bounds: volume, trigger: true, layer: 2})
    $ramps := []physics.StaticRamp3D{}
    if ramp_root != 0 {
        ramp_nodes := tree.subtree(ramp_root) >>>
        for i in 1:ramp_nodes.len {
            transform := tree.global_transform_3d(ramp_nodes[i]) >>>
            if transform.c1.y <= 0.0 || transform.c2.z <= 0.0 { >> errors.new("course ramps rise toward -Z and require positive Y/Z scale") }
            bounds := solid_bounds(tree, ramp_nodes[i]) >>>
            ramps.push(physics.StaticRamp3D{bounds: bounds, direction: physics.RAMP_NEGATIVE_Z, layer: 1})
        }
    }
    << physics.new_capsule_world(boxes, ramps) >>>
}

fn pose(tree $&scenes.SceneTree, pieces &[]int, center fm.Vec3, heading f64, phase f64, state int) int {
    $stride := 0.0
    $knee := 0.0
    if state == POSE_WALK { stride = math.sin(phase) * 0.14 }
    if state == POSE_AIR { stride = 0.11
        knee = 0.13 }
    root := fm.translation_3d(center).multiply(fm.rotation_y(heading))
    tree.set_transform_3d(pieces[0], root) >>>
    left := fm.translation_3d(fm.vec3(-0.13, -0.41 + knee, stride)).multiply(fm.scale_3d(fm.vec3(0.22, 0.33, 0.23)))
    right := fm.translation_3d(fm.vec3(0.13, -0.41 + knee, -stride)).multiply(fm.scale_3d(fm.vec3(0.22, 0.33, 0.23)))
    tree.set_transform_3d(pieces[1], left) >>>
    tree.set_transform_3d(pieces[2], right) >>>
    << 0
}

struct Sample {
    elapsed int
    simulation int
    encoding int
    present int
    draws int
    triangles int
    playing int
}
fn write_trace(path string, backend string, width int, height int, startup int, samples &[]Sample) int {
    $csv := strings.new_byte_builder(512)
    csv.write_str("backend,width,height,first_frame_ns,frame_ns,simulation_ns,encoding_ns,present_ns,draws,triangles,playing\n")
    prefix := backend + "," + str(width) + "," + str(height) + "," + str(startup) + ","
    for sample in samples {
        csv.write_str(prefix + str(sample.elapsed) + "," + str(sample.simulation) + "," + str(sample.encoding) +
            "," + str(sample.present) + "," + str(sample.draws) + "," + str(sample.triangles) +
            "," + str(sample.playing) + "\n")
    }
    data := csv.to_string()
    << snapshot.write_atomic(path, &data) >>>
}

fn run() int {
    origin := now_ns()
    config := options() >>>
    shader := shaders.load_mesh("build/mesh-shaders") >>>
    $device := ren.open_3d("Nexus course | Arrows: move | Space: jump | R: restart", 960, 540, gpu.AUTO, &shader) >>>
    backend := gpu_info.backend_name(device.backend() >>>)
    println("Course GPU backend: " + backend)
    $models := loaded.load(&device, config.scene + "") >>>
    $tree := scenes.new_scene_tree_3d("World", 4096) >>>
    root := tree.root()
    $view := renderer.new_scene_3d(&device) >>>
    entry := models.instantiate($&view, $&tree, root, "Course") >>>
    spawn := required_child(&tree, entry, "Spawn") >>>
    goal := required_child(&tree, entry, "Finish") >>>
    ramp_root := tree.find_child(entry, "Ramps") >>>
    world := static_world(&tree, entry, goal, ramp_root) >>>
    point := (tree.global_transform_3d(spawn) >>>).c3.xyz()
    start := physics.capsule_3d(point.add(fm.vec3(0.0, 0.6, 0.0)), 0.23, 0.37) >>>
    policy := physics.CapsuleController3D{solid_mask: 1, trigger_mask: 2, step_height: 0.36,
        ground_snap: 0.065, min_floor_y: 0.7071067811865476}

    ball := meshes.sphere_mesh_3d(0.5, 16, 10, 0xffba70ff) >>>
    $mesh := device.upload(&ball) >>>
    player := tree.add_child_3d(root, "Player") >>>
    torso := tree.add_child_3d(player, "Torso") >>>
    left := tree.add_child_3d(player, "Left leg") >>>
    right := tree.add_child_3d(player, "Right leg") >>>
    pieces := [player, left, right]
    tree.set_transform_3d(torso, fm.scale_3d(fm.vec3(0.44, 0.85, 0.39))) >>>
    for node in [torso, left, right] { view.attach_mesh(&tree, node, &mesh) >>> }

    $input := controls.new_input_map()
    input.bind("left", events.KEY_LEFT) >>>
    input.bind("right", events.KEY_RIGHT) >>>
    input.bind("forward", events.KEY_UP) >>>
    input.bind("back", events.KEY_DOWN) >>>
    input.bind("jump", events.KEY_SPACE) >>>
    input.bind("restart", events.KEY_R) >>>
    $clock := timing.new_clock(60, 8) >>>
    $last := now_ns()
    $frame := 0
    $first := 0
    $quit := false
    $body := start
    $vertical := 0.0
    $grounded := false
    $jump := false
    $cleared := false
    $steps := 0
    $slope_ticks := 0
    $jumps := 0
    $phase := 0.0
    $heading := 0.0
    $modes := 0
    $samples := []Sample{}
    $width := 0
    $height := 0
    while !quit && (config.frames == 0 || frame < config.frames) {
        begin := now_ns()
        input.begin_frame()
        window.pump() >>>
        for i in 0:256 {
            event := device.poll() >>>
            if event.kind == events.EVENT_NONE { <- }
            if event.kind == events.EVENT_CLOSE_REQUESTED ||
                (event.kind == events.EVENT_KEY_DOWN && event.physical_key == events.KEY_ESCAPE) { quit = true }
            bridge.apply_window_input($&input, &event) >>>
        }
        if quit { <- }
        if body.center.y - body.half_segment - body.radius < -3.0 || (input.just_pressed("restart") >>>) {
            body = start
            vertical = 0.0
            grounded = false
            jump = false
            cleared = false
            phase = 0.0
            heading = 0.0
            tree.set_visible(goal, true) >>>
        }
        if (input.just_pressed("jump") >>>) && grounded { jump = true }
        $direction := fm.vec3(input.axis("left", "right") >>>, 0.0, input.axis("forward", "back") >>>)
        if config.autoplay && frame >= 12 {
            direction = fm.vec3(0.0, 0.0, -1.0)
            if grounded && jumps == 0 && body.center.z + body.radius < -1.30 { jump = true }
        }
        if direction.length() > 1.0 { direction = direction.normalized() >>> }
        $delta := f64(begin - last) / 1000000000.0
        last = begin
        if config.frames > 0 { delta = 1.0 / 60.0 }
        ticks := clock.advance(delta) >>>
        for i in 0:ticks.steps {
            if cleared { <- }
            if jump && grounded {
                vertical = 5.0
                jumps += 1
            }
            jump = false
            vertical = math.max(-18.0, vertical - 11.0 * ticks.fixed_delta)
            motion := fm.vec3(direction.x * 3.5, vertical, direction.z * 3.5).scaled(ticks.fixed_delta)
            result := world.move_capsule(body, motion, policy) >>>
            body = result.body
            grounded = result.grounded
            if grounded || result.on_ceiling { vertical = 0.0 }
            if result.stepped { steps += 1 }
            if result.floor_ramp >= 0 && math.abs(result.floor_normal.z) > 0.08 &&
                result.travelled.y > 0.001 && result.travelled.z < -0.01 { slope_ticks += 1 }
            phase += result.travelled.x * 9.0 - result.travelled.z * 9.0
            if result.triggers.len > 0 && grounded {
                cleared = true
                tree.set_visible(goal, false) >>>
                println("Course complete. Press R to restart.")
            }
        }
        $state := POSE_IDLE
        if !grounded { state = POSE_AIR }
        else if !cleared && direction.length() > 0.0 { state = POSE_WALK }
        if direction.length() > 0.0 { heading = math.atan2(-direction.x, -direction.z) }
        modes = modes | (1 << state)
        center := body.center
        pose($&tree, &pieces, center, heading, phase, state) >>>
        simulated := now_ns()
        width = device.width() >>>
        height = device.height() >>>
        if width < 1 || height < 1 { sleep_ns(10000000)
            -> }
        $camera := scenes.new_camera_3d()
        camera.target = center.add(fm.vec3(0.0, 0.20, -1.15))
        camera.position = center.add(fm.vec3(3.20, 3.5, 5.10))
        projection := camera.view_projection(f64(width) / f64(height)) >>>
        light := lighting_data.directional(fm.vec3(-0.45, 0.9, 0.6), fm.vec3(2.1, 2.1, 2.1)) >>>
        environment := lighting_data.environment(fm.vec3(0.24, 0.24, 0.24), camera.position, 1.0, [light]) >>>
        view.select_lods(&tree, camera.position) >>>
        $background := 0x152133ff
        if cleared { background = 0x17362eff }
        device.begin(background) >>>
        draws := view.draw_lit($&device, &tree, projection, &environment) >>>
        encoded := now_ns()
        if config.capture.len > 0 && frame + 1 == config.frames { device.capture(config.capture + "") >>> }
        device.present() >>>
        ended := now_ns()
        if first == 0 { first = ended - origin }
        if config.trace.len > 0 {
            $playing := 1
            if cleared { playing = 0 }
            samples.push(Sample{elapsed: ended - begin, simulation: simulated - begin, encoding: encoded - simulated,
                present: ended - encoded, draws: draws.instances, triangles: draws.triangles, playing: playing})
        }
        frame += 1
    }
    if config.trace.len > 0 { write_trace(config.trace + "", backend + "", width, height, first, &samples) >>> }
    println("Course frames=" + str(frame) + ", steps=" + str(steps) + ", jumps=" + str(jumps) +
        ", pose_mask=" + str(modes) + ", slope_ticks=" + str(slope_ticks))
    if config.autoplay && config.frames >= 240 &&
        (!cleared || steps < 2 || jumps != 1 || modes != 7 || (ramp_root != 0 && slope_ticks < 8)) {
        >> errors.new("autoplay failed to finish the course with all required actions")
    }
    models.close() >>>
    mesh.close() >>>
    device.close() >>>
    << 0
}
fn main() int { << run() >>> (err) { eprintln(err.msg())
    << 1 } }
