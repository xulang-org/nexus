@main

light_data #"github.com/xulang-org/nexus/resources/lighting"
scene_lights #"github.com/xulang-org/nexus/integration/lighting"
light_files #"github.com/xulang-org/nexus/integration/scene_lighting"
scene_files #"github.com/xulang-org/nexus/integration/scene"

#gpu

gpu_info #"github.com/xulang-org/nexus/platform/gpu"

#window
window_events #window/events
mesh_shaders #"github.com/xulang-org/nexus/assets/shaders/three_d"

meshes #"github.com/xulang-org/nexus/resources/mesh"

timing #"github.com/xulang-org/nexus/timing"
controls #"github.com/xulang-org/nexus/input"
ren #"github.com/xulang-org/nexus/rendering/three_d"
scene_render #"github.com/xulang-org/nexus/integration/rendering/three_d"
colors #"github.com/xulang-org/nexus/foundation/color"
input_bridge #"github.com/xulang-org/nexus/integration/input"
fm #"github.com/xulang-org/nexus/foundation/math"
nexus #"github.com/xulang-org/nexus/scene"
#os
#strconv
#errors
#math

fn run() int {
    args := os.args()
    $frames := 0
    $capture := ""
    $shaders := "build/mesh-shaders"
    $mode := "all"
    $mode_selected := false
    $scene_path := "examples/lighting/assets/lights.xuscene"
    $save_scene := ""
    $animate := true
    $extra_lights := 0
    $distant_meshes := 0
    $i := 1
    while i < args.len {
        if i + 1 >= args.len { >>> errors.new("missing option value") }
        value := args[i + 1] + ""
        if args[i] == "--frames" { frames = strconv.atoi(&value) >>>
            if frames < 1 || frames > 1000000 { >>> errors.new("invalid frame count") }
        } else if args[i] == "--shaders" { shaders = value
        } else if args[i] == "--mode" { mode=value
            mode_selected=true
            if mode!="all" && mode!="directional" && mode!="point" && mode!="spot" && mode!="none" { >>> errors.new("mode must be all, directional, point, spot or none") }
        } else if args[i] == "--scene" { scene_path=value
            animate=false
        } else if args[i] == "--save-scene" { save_scene=value
        } else if args[i] == "--extra-lights" { extra_lights=strconv.atoi(&value) >>>
            if extra_lights<0 || extra_lights>light_data.MAX_SOURCES { >>> errors.new("invalid extra light count") }
        } else if args[i] == "--distant-meshes" { distant_meshes=strconv.atoi(&value) >>>
            if distant_meshes<0 || distant_meshes>4096 { >>> errors.new("invalid distant mesh count") }
        } else if args[i] == "--capture" { capture = value
        } else { >>> errors.new("unknown option") }
        i = i + 2
    }
    if capture.len > 0 && frames == 0 { >>> errors.new("capture requires bounded frames") }
    light_document := scene_files.load(scene_path) >>>
    if extra_lights>light_data.MAX_SOURCES-light_document.light_count() { >>> errors.new("extra lights exceed the 256-source scene budget") }
    mesh_program_0 := mesh_shaders.load_mesh(shaders + "") >>>
    $device := ren.open_3d("Xu lights | D/P/S: toggle source types | arrows: orbit | Space: pause | Esc: exit", 1100, 720, gpu.AUTO, &mesh_program_0) >>>
    println("Multi-light GPU backend: " + gpu_info.backend_name(device.backend() >>>))
    white := colors.rgba8(255, 255, 255, 255) >>>
    source := meshes.sphere_mesh_3d(0.65, 48, 24, white) >>>
    $sphere := device.upload(&source) >>>
    $tree := nexus.new_scene_tree_3d("Lights", 8192) >>>
    $scene := scene_render.new_scene_3d(&device) >>>
    zero := fm.vec3(0.0, 0.0, 0.0)
    for row in 0:3 {
        for column in 0:5 {
            node := tree.add_child_3d(tree.root(), "Sphere" + str(row * 5 + column)) >>>
            tree.set_position_3d(node, fm.vec3((f64(column) - 2.0) * 1.6, (1.0 - f64(row)) * 1.65, 0.0)) >>>
            scene.attach_mesh(&tree, node, &sphere) >>>
            $base := fm.vec3(0.55, 0.14, 0.045)
            if row == 1 { base = fm.vec3(0.045, 0.35, 0.5) }
            if row == 2 { base = fm.vec3(0.6, 0.45, 0.12) }
            material := ren.material_3d(base, f64(row) / 2.0, 0.1 + f64(column) * 0.225, zero) >>>
            scene.set_material(&tree, node, material) >>>
        }
    }
    $light_world := scene_lights.new_scene_lights_3d()
    parent := tree.root()
    light_root := light_files.instantiate(&light_document,$&light_world,$&tree,parent,"Sources") >>>
    directional_node := tree.find_node(light_root,"Directional") >>>
    points := tree.find_node(light_root,"Points") >>>
    red_node := tree.find_node(light_root,"Points/RedPoint") >>>
    blue_node := tree.find_node(light_root,"Points/BluePoint") >>>
    spot_node := tree.find_node(light_root,"Spot") >>>
    if extra_lights>0 {
        extras := tree.add_child_3d(light_root,"ExtraLights") >>>
        for j in 0:extra_lights {
            node := tree.add_child_3d(extras,"Light"+str(j)) >>>
            tree.set_position_3d(node,fm.vec3(100.0+f64(j)*2.0,0.0,2.0)) >>>
            light_world.attach(&tree,node,light_data.point(zero,fm.vec3(1.0,1.0,1.0),1.0) >>>) >>>
        }
    }
    for id in [red_node,blue_node,spot_node] { scene.attach_mesh(&tree,id,&sphere) >>> }
    scene.set_material(&tree,red_node,ren.material_3d(zero,0.0,1.0,fm.vec3(12.0,0.4,0.1)) >>>) >>>
    scene.set_material(&tree,blue_node,ren.material_3d(zero,0.0,1.0,fm.vec3(0.1,0.7,12.0)) >>>) >>>
    scene.set_material(&tree,spot_node,ren.material_3d(zero,0.0,1.0,fm.vec3(10.0,7.0,2.0)) >>>) >>>
    distant_material := ren.material_3d(fm.vec3(0.25,0.35,0.45),0.0,0.5,zero) >>>
    for j in 0:distant_meshes {
        node := tree.add_child_3d(tree.root(),"Distant"+str(j)) >>>
        tree.set_position_3d(node,fm.vec3(10000.0+f64(j)*5.0,0.0,0.0)) >>>
        scene.attach_mesh(&tree,node,&sphere) >>>
        scene.set_material(&tree,node,distant_material) >>>
    }
    $directional_on := tree.is_visible(directional_node) >>>
    $point_on := tree.is_visible(points) >>>
    $spot_on := tree.is_visible(spot_node) >>>
    if mode_selected {
        directional_on=mode=="all" || mode=="directional"
        point_on=mode=="all" || mode=="point"
        spot_on=mode=="all" || mode=="spot"
    }
    $input := controls.new_input_map()
    input.bind("left", window_events.KEY_LEFT) >>>
    input.bind("right", window_events.KEY_RIGHT) >>>
    input.bind("directional",window_events.KEY_D) >>>
    input.bind("points",window_events.KEY_P) >>>
    input.bind("spot",window_events.KEY_S) >>>
    input.bind("pause", window_events.KEY_SPACE) >>>
    input.bind("quit", window_events.KEY_ESCAPE) >>>
    $angle := 0.0
    $orbit := 0.0
    $paused := !animate
    $frame := 0
    $submitted := 0
    $culled := 0
    $quit := false
    $last := now_ns()
    $clock := timing.new_clock(60, 8) >>>
    projection := nexus.new_camera_3d()
    background := colors.rgba8(12, 18, 29, 255) >>>
    while !quit && (frames == 0 || frame < frames) {
        input.begin_frame()
        window.pump() >>>
        for poll in 0:256 { event := device.poll() >>>
            if event.kind == window_events.EVENT_NONE { <- }
            if event.kind == window_events.EVENT_CLOSE_REQUESTED { quit = true }
            input_bridge.apply_window_input($&input, &event) >>> }
        if input.just_pressed("quit") >>> { quit = true }
        if quit { <- }
        if input.just_pressed("pause") >>> { paused = !paused }
        if input.just_pressed("directional") >>> { directional_on=!directional_on }
        if input.just_pressed("points") >>> { point_on=!point_on }
        if input.just_pressed("spot") >>> { spot_on=!spot_on }
        now := now_ns()
        $delta := f64(now - last) / 1000000000.0
        last = now
        if frames > 0 { delta = 1.0 / 60.0 }
        ticks := clock.advance(delta) >>>
        for tick in 0:ticks.steps {
            if !paused { angle = angle + ticks.fixed_delta * 0.4 }
            orbit = orbit + (input.axis("left", "right") >>>) * ticks.fixed_delta * 0.4
        }
        eye := fm.vec3(math.sin(orbit) * 10.0, 0.6, math.cos(orbit) * 10.0)
        view := nexus.look_at_3d(eye, zero, fm.vec3(0.0, 1.0, 0.0)) >>>
        width := device.width() >>>
        height := device.height() >>>
        if width < 1 || height < 1 { sleep_ns(10000000)
            -> }
        vp := (nexus.perspective_3d(projection.vertical_fov, f64(width) / f64(height), projection.near, projection.far) >>>).multiply(view)
        tree.set_visible(directional_node,directional_on) >>>
        tree.set_visible(points,point_on) >>>
        tree.set_visible(spot_node,spot_on) >>>
        marker_scale := fm.scale_3d(fm.vec3(0.18,0.18,0.18))
        if !paused {
            tree.set_transform_3d(directional_node,fm.rotation_y(angle*0.3)) >>>
            tree.set_transform_3d(red_node,fm.translation_3d(fm.vec3(-2.2+math.sin(angle)*1.4,1.2,2.0)).multiply(marker_scale)) >>>
            tree.set_transform_3d(blue_node,fm.translation_3d(fm.vec3(2.2+math.cos(angle)*0.8,-0.9,2.0)).multiply(marker_scale)) >>>
            tree.set_transform_3d(spot_node,fm.translation_3d(fm.vec3(0.0,3.0,4.0)).multiply(fm.rotation_y(math.sin(angle)*0.35)).multiply(marker_scale)) >>>
        }
        sources := light_world.gather(&tree) >>>
        lighting := light_data.environment(fm.vec3(0.01,0.015,0.025),eye,1.0,sources) >>>
        device.begin(background) >>>
        draws := scene.draw_lit($&device, &tree, vp, &lighting) >>>
        submitted=draws.instances
        culled=draws.culled_instances
        assert(submitted+culled>=15+distant_meshes && draws.triangles+draws.culled_triangles==source.triangle_count()*(submitted+culled))
        if capture.len > 0 && frame + 1 == frames { device.capture(capture + "") >>> }
        device.present() >>>
        frame = frame + 1
    }
    if save_scene.len>0 {
        saved := light_files.capture_nodes(&light_world,&tree,light_root) >>>
        scene_files.save(save_scene,&saved) >>>
    }
    summary := device.lighting_stats() >>>
    println("Scene visibility: submitted="+str(submitted)+" culled="+str(culled))
    println("Lighting submissions: draws="+str(summary.draws)+" candidates="+str(summary.candidates)+" selected="+str(summary.selected)+" culled="+str(summary.culled))
    sphere.close() >>>
    device.close() >>>
    println("Finished " + str(frame) + " light frames; 15 material spheres with scene-bound directional/point/spot sources; mode="+mode)
    << 0
}
fn main() int { << run() >>> (err) { eprintln(err.msg())
    << 1 } }
