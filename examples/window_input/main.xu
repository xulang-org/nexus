@main

#window
#window/events
#gpu
#os
#strconv
#errors
#time
controls #"github.com/xulang-org/nexus/input"
input_bridge #"github.com/xulang-org/nexus/integration/input"

// The action map stays in nexus. Device/window/event mechanisms use the SDK;
// no engine renderer, scene, native archive or shader compiler is needed.
fn run() int {
    args := os.args()
    $frames := 600
    if args.len == 3 && args[1] == "--frames" {
        value := args[2]
        frames = strconv.atoi(&value) or >>
        if frames < 1 || frames > 1000000 { >> errors.new("frames must be 1...1000000") }
    } else if args.len != 1 { >> errors.new("usage: window-input [--frames count]") }
    options := window.Options{title: "Xu input: W/Space green, Escape closes; type text",width: 640,height: 360,
        resizable: true,high_pixel_density: true,hidden: false}
    $target := window.open(&options) or >>
    target.start_text_input() or >>
    target.text_input_area(20,20,600,40,4) or >>
    $device := gpu.open(gpu.DeviceOptions{backend: gpu.AUTO,debug: true,shader_formats: 0}) or >>
    $surface := device.surface(&target,gpu.SurfaceOptions{present_mode: gpu.PRESENT_VSYNC}) or >>
    $input := controls.new_input_map()
    input.bind("activate",events.KEY_W) or >>
    input.bind("activate",events.KEY_SPACE) or >>
    input.bind("quit",events.KEY_ESCAPE) or >>
    $presented := 0
    $received := 0
    for frame_index in 0:frames {
        input.begin_frame()
        window.pump() or >>
        for i in 0:events.QUEUE_CAPACITY {
            event := target.poll() or >>
            if event.kind == events.EVENT_NONE { <- }
            input_bridge.apply_window_input($&input,&event) or >>
            if event.kind == events.EVENT_TEXT_INPUT { println("Text: " + event.text) }
            if event.kind == events.EVENT_TEXT_EDITING { println("Composition: " + event.text) }
            if event.kind == events.EVENT_INPUT_RESET { println("Input history reset: " + str(event.reset_reason)) }
            received += 1
        }
        state := target.state() or >>
        quit := input.pressed("quit") or >>
        if state.close_requested || quit { <- }
        $frame := surface.acquire() or >>
        if !frame.has_image() { time.sleep(16000000)
            -> }
        active := input.pressed("activate") or >>
        $color := gpu.Color{r: 0.05,g: 0.12,b: 0.45,a: 1.0}
        if active { color = gpu.Color{r: 0.05,g: 0.7,b: 0.15,a: 1.0} }
        $pass := frame.begin_render(gpu.CLEAR,color,gpu.no_depth()) or >>
        pass.end() or >>
        $fence := frame.present() or >>
        fence.close() or >>
        presented += 1
    }
    surface.close() or >>
    stats := device.stats() or >>
    assert(stats.surface_count == 0 && stats.frame_count == 0 && stats.encoder_count == 0 && stats.submission_count == 0)
    device.close() or >>
    target.stop_text_input() or >>
    target.close() or >>
    assert((window.live_count() or >>) == 0)
    println("Finished standard window/input actions and GPU clear frames with zero live resources")
    println(presented)
    println(received)
    << 0
}
fn main() int {
    << run() or (err) { eprintln(err.msg())
        << 1 }
}
