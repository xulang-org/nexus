@main

#gpu

gpu_info #"github.com/xulang-org/game/platform/gpu"

#window
window_events #window/events

canvas_shaders #"github.com/xulang-org/game/assets/shaders/two_d"

ren_data #"github.com/xulang-org/game/resources/canvas"

colors #"github.com/xulang-org/game/foundation/color"
ren #"github.com/xulang-org/game/rendering/two_d"
input_bridge #"github.com/xulang-org/game/integration/input"
physics2d #"github.com/xulang-org/game/physics2d"
timing #"github.com/xulang-org/game/timing"
controls #"github.com/xulang-org/game/input"
fm #"github.com/xulang-org/game/foundation/math"
dev #"github.com/xulang-org/game/script/development"
game #"github.com/xulang-org/game/scene"
bc #"github.com/xulang-org/game/script/bytecode"
host #"github.com/xulang-org/game/script/host"
files #"github.com/xulang-org/game/internal/file_snapshot"
#os
#errors
#strconv
#math

struct Options {
    artifact string
    receiver_artifact string
    frames int
    capture string
    shaders string
    autoplay bool
    trace bool
}
fn options() Options {
    args := os.args()
    $config := Options{artifact: "build/player.xubc", receiver_artifact: "build/indicator.xubc", frames: 0, capture: "", shaders: "build/canvas-shaders", autoplay: false, trace: false}
    $i := 1
    while i < args.len {
        if args[i] == "--autoplay" { config.autoplay = true
            i = i + 1
            -> }
        if args[i] == "--trace" { config.trace = true
            i = i + 1
            -> }
        if i + 1 >= args.len { >> errors.new("missing option value") }
        next := i + 1
        if args[i] == "--artifact" { config.artifact = args[next] + ""
        } else if args[i] == "--receiver-artifact" { config.receiver_artifact = args[next] + ""
        } else if args[i] == "--frames" {
            config.frames = strconv.atoi(&args[next]) or >>
            if config.frames < 1 || config.frames > 1000000 { >> errors.new("invalid frame count") }
        } else if args[i] == "--shaders" { config.shaders = args[next] + ""
        } else if args[i] == "--capture" { config.capture = args[next] + ""
        } else { >> errors.new("unknown option: " + args[i]) }
        i = i + 2
    }
    if config.capture.len > 0 && config.frames == 0 { >> errors.new("capture requires bounded --frames") }
    << config
}
struct ScriptStatus { error string
    receiver_error string }
fn step(scripts $&host.SceneScripts, source int, status $&ScriptStatus, tree &game.SceneTree, delta f64, axis f64) f64 {
    result := scripts.physics_process(tree, source, delta, axis) or (err) {
        message := err.msg()
        if status.error != message { eprintln(message) }
        status.error = message
        << 0.0
    }
    status.error = ""
    << result
}
// The demonstration tolerates a user removing an observed HUD field on reload.
fn optional_state(scripts &host.SceneScripts, binding int, id int) f64 { << scripts.state(binding, id) or (err) { << 0.0 } }
fn run() int {
    config := options() or >>
    raw := files.read(config.artifact + "", bc.MAX_BYTES) or >>
    program := bc.decode(&raw) or >>
    receiver_raw := files.read(config.receiver_artifact + "", bc.MAX_BYTES) or >>
    receiver_program := bc.decode(&receiver_raw) or >>
    $tree := game.new_scene_tree("World", 16) or >>
    root := tree.root()
    actor := tree.add_child(root, "Actor") or >>
    indicator := tree.add_child(root, "MovementIndicator") or >>
    $scripts := host.new_scene_scripts(2) or >>
    source := scripts.attach(&tree, actor, program) or >>
    receiver := scripts.attach(&tree, indicator, receiver_program) or >>
    scripts.connect(&tree, source, "moved", receiver, "on_moved") or >>
    $watcher := dev.development_file(config.artifact + "", &raw)
    $receiver_watcher := dev.development_file(config.receiver_artifact + "", &receiver_raw)
    $status := ScriptStatus{error: "", receiver_error: ""}
    canvas_program_0 := canvas_shaders.load_canvas(config.shaders + "") or >>
    $renderer := ren.open_2d("XuScript live reload | edit player.xus | A/D: move | Space: pause | Esc: exit", 960, 540, gpu.AUTO, &canvas_program_0) or >>
    backend := renderer.backend() or >>
    println("Script GPU backend: " + gpu_info.backend_name(backend))
    $input := controls.new_input_map()
    input.bind("left", window_events.KEY_A) or >>
    input.bind("left", window_events.KEY_LEFT) or >>
    input.bind("right", window_events.KEY_D) or >>
    input.bind("right", window_events.KEY_RIGHT) or >>
    input.bind("pause", window_events.KEY_SPACE) or >>
    input.bind("quit", window_events.KEY_ESCAPE) or >>
    $position := fm.vec2(160.0, 280.0)
    tree.set_position(actor, position) or >>
    tree.set_position(indicator, fm.vec2(64.0, 452.0)) or >>
    $signal_count := 0
    solids := [fm.rect2(48.0, 160.0, 16.0, 240.0), fm.rect2(896.0, 160.0, 16.0, 240.0)]
    camera := game.new_camera_2d(960.0, 540.0) or >>
    background := colors.rgba8(12, 20, 34, 255) or >>
    grid := colors.rgba8(28, 43, 61, 255) or >>
    muted := colors.rgba8(55, 75, 100, 255) or >>
    green := colors.rgba8(80, 220, 170, 255) or >>
    gold := colors.rgba8(240, 173, 67, 255) or >>
    red := colors.rgba8(244, 91, 97, 255) or >>
    $batch := ren_data.new_batch()
    $clock := timing.new_clock(60, 8) or >>
    $last := now_ns()
    $frame := 0
    $quit := false
    println("Script ready: epoch=1 calls=0 x=160")
    println("Receiver ready: epoch=1 calls=0 events=0")
    while !quit && (config.frames == 0 || frame < config.frames) {
        input.begin_frame()
        window.pump() or >>
        for i in 0:256 {
            event := renderer.poll() or >>
            if event.kind == window_events.EVENT_NONE { <- }
            if event.kind == window_events.EVENT_CLOSE_REQUESTED { quit = true }
            input_bridge.apply_window_input($&input, &event) or >>
        }
        if input.just_pressed("quit") or >> { quit = true }
        if quit { <- }
        if input.just_pressed("pause") or >> { tree.paused = !tree.paused }
        if frame % 15 == 0 {
            before_calls := scripts.calls(source) or >>
            before_ticks := optional_state(&scripts, source, 1)
            notice := watcher.poll_scene(&tree, $&scripts, source)
            if notice.status == host.ACTIVATED {
                println("Script activated: epoch=" + str(scripts.epoch(source) or >>) + " calls=" + str(scripts.calls(source) or >>) +
                    " x=" + (strconv.format_float(position.x, 103, -1) or >>) +
                    " ticks_before=" + (strconv.format_float(before_ticks, 103, -1) or >>) +
                    " ticks_after=" + (strconv.format_float(optional_state(&scripts, source, 1), 103, -1) or >>))
                assert((scripts.calls(source) or >>) == before_calls)
            } else if notice.status == host.REJECTED { eprintln("Script candidate rejected: " + notice.message) }
            before_events := optional_state(&scripts, receiver, 1)
            receiver_notice := receiver_watcher.poll_scene(&tree, $&scripts, receiver)
            if receiver_notice.status == host.ACTIVATED {
                println("Receiver activated: epoch=" + str(scripts.epoch(receiver) or >>) + " calls=" + str(scripts.calls(receiver) or >>) +
                    " events_before=" + (strconv.format_float(before_events, 103, -1) or >>) +
                    " events_after=" + (strconv.format_float(optional_state(&scripts, receiver, 1), 103, -1) or >>))
            } else if receiver_notice.status == host.REJECTED { eprintln("Receiver candidate rejected: " + receiver_notice.message) }
        }
        now := now_ns()
        $delta := f64(now - last) / 1000000000.0
        last = now
        if config.autoplay { delta = 1.0 / 60.0 }
        ticks := clock.advance(delta) or >>
        $axis := input.axis("left", "right") or >>
        if config.autoplay { axis = 1.0
            if (frame / 120) % 2 == 1 { axis = -1.0 } }
        for i in 0:ticks.steps {
            movement := step($&scripts, source, $&status, &tree, ticks.fixed_delta, axis)
            motion := physics2d.move_and_slide(fm.rect2(position.x, position.y, 28.0, 40.0), fm.vec2(movement, 0.0), &solids) or >>
            position = motion.position
            tree.set_position(actor, position) or >>
            report := scripts.dispatch(&tree, host.DEFAULT_DISPATCH_LIMIT) or >>
            signal_count = signal_count + report.delivered
            if report.first_error.len > 0 && report.first_error != status.receiver_error { eprintln(report.first_error) }
            status.receiver_error = report.first_error + ""
            tree.set_position(indicator, fm.vec2(64.0 + math.abs(optional_state(&scripts, receiver, 3)), 452.0)) or >>
        }
        if config.trace && frame % 30 == 0 {
            println("Script step: frame=" + str(frame) + " epoch=" + str(scripts.epoch(source) or >>) + " calls=" + str(scripts.calls(source) or >>) +
                " x=" + (strconv.format_float(position.x, 103, -1) or >>) +
                " ticks=" + (strconv.format_float(optional_state(&scripts, source, 1), 103, -1) or >>))
            println("Script signals: frame=" + str(frame) + " delivered=" + str(signal_count) +
                " value=" + (strconv.format_float(optional_state(&scripts, receiver, 2), 103, -1) or >>) +
                " connections=" + str(scripts.connection_count()) + " receiver_epoch=" + str(scripts.epoch(receiver) or >>) +
                " offset=" + (strconv.format_float(optional_state(&scripts, receiver, 3), 103, -1) or >>))
        }
        width := renderer.width() or >>
        height := renderer.height() or >>
        if width < 1 || height < 1 { sleep_ns(10000000)
            -> }
        view := camera.view_transform(f64(width), f64(height)) or >>
        $accent := green
        if (scripts.epoch(source) or >>) % 2 == 0 { accent = gold }
        if watcher.has_error() || receiver_watcher.has_error() || status.error.len > 0 || status.receiver_error.len > 0 { accent = red }
        batch.clear()
        for i in 0:25 { batch.quad(fm.rect2(64.0 + f64(i) * 34.0, 180.0, 1.0, 200.0), view, grid) or >> }
        batch.quad(fm.rect2(64.0, 320.0, 832.0, 2.0), view, muted) or >>
        for solid in solids { batch.quad(solid, view, muted) or >> }
        batch.quad(fm.rect2(position.x, position.y, 28.0, 40.0), view, accent) or >>
        batch.quad(fm.rect2(64.0, 74.0, 8.0, 28.0), view, accent) or >>
        for i in 0:(scripts.epoch(source) or >>) % 25 { batch.quad(fm.rect2(88.0 + f64(i) * 20.0, 78.0, 12.0, 20.0), view, accent) or >> }
        batch.quad(fm.rect2(64.0, 416.0, f64((scripts.calls(source) or >>) % 180) * 4.0 + 1.0, 8.0), view, accent) or >>
        indicator_world := tree.global_transform(indicator) or >>
        batch.quad(fm.rect2(0.0, 0.0, 12.0, 12.0), view.multiply(indicator_world), accent) or >>
        if tree.paused { batch.quad(fm.rect2(864.0, 74.0, 8.0, 28.0), view, gold) or >>
            batch.quad(fm.rect2(880.0, 74.0, 8.0, 28.0), view, gold) or >> }
        renderer.begin(background) or >>
        renderer.submit(&batch) or >>
        if config.capture.len > 0 && frame + 1 == config.frames { renderer.capture(config.capture + "") or >> }
        renderer.present() or >>
        frame = frame + 1
    }
    renderer.close() or >>
    println("Finished " + str(frame) + " script frames; epoch=" + str(scripts.epoch(source) or >>) + " calls=" + str(scripts.calls(source) or >>))
    println("Signals delivered=" + str(signal_count) + " connections=" + str(scripts.connection_count()))
    println("Receiver epoch=" + str(scripts.epoch(receiver) or >>) + " calls=" + str(scripts.calls(receiver) or >>) +
        " events=" + (strconv.format_float(optional_state(&scripts, receiver, 1), 103, -1) or >>))
    << 0
}
fn main() int { << run() or (err) { eprintln(err.msg())
    << 1 } }
