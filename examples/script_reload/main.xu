@main

#gpu

gpu_info #"github.com/xulang-org/nexus/platform/gpu"

#window
window_events #window/events

canvas_shaders #"github.com/xulang-org/nexus/assets/shaders/two_d"

ren_data #"github.com/xulang-org/nexus/resources/canvas"

colors #"github.com/xulang-org/nexus/foundation/color"
ren #"github.com/xulang-org/nexus/rendering/two_d"
input_bridge #"github.com/xulang-org/nexus/integration/input"
physics2d #"github.com/xulang-org/nexus/physics2d"
timing #"github.com/xulang-org/nexus/timing"
controls #"github.com/xulang-org/nexus/input"
fm #"github.com/xulang-org/nexus/foundation/math"
dev #"github.com/xulang-org/nexus/script/development"
nexus #"github.com/xulang-org/nexus/scene"
bc #"github.com/xulang-org/nexus/script/bytecode"
host #"github.com/xulang-org/nexus/script/host"
files #"github.com/xulang-org/nexus/internal/file_snapshot"
#os
#errors
#strconv
#math

struct Options {
    artifact string
    receiver_artifact string
    frames int
    capture string
    shaders string
    autoplay bool
    trace bool
}
fn options() Options {
    args := os.args()
    $config := Options{artifact: "build/player.xubc", receiver_artifact: "build/indicator.xubc", frames: 0, capture: "", shaders: "build/canvas-shaders", autoplay: false, trace: false}
    $i := 1
    while i < args.len {
        if args[i] == "--autoplay" { config.autoplay = true
            i = i + 1
            -> }
        if args[i] == "--trace" { config.trace = true
            i = i + 1
            -> }
        if i + 1 >= args.len { >> errors.new("missing option value") }
        next := i + 1
        if args[i] == "--artifact" { config.artifact = args[next] + ""
        } else if args[i] == "--receiver-artifact" { config.receiver_artifact = args[next] + ""
        } else if args[i] == "--frames" {
            config.frames = strconv.atoi(&args[next]) >>>
            if config.frames < 1 || config.frames > 1000000 { >> errors.new("invalid frame count") }
        } else if args[i] == "--shaders" { config.shaders = args[next] + ""
        } else if args[i] == "--capture" { config.capture = args[next] + ""
        } else { >> errors.new("unknown option: " + args[i]) }
        i = i + 2
    }
    if config.capture.len > 0 && config.frames == 0 { >> errors.new("capture requires bounded --frames") }
    << config
}
struct ScriptStatus { error string
    receiver_error string }
fn step(scripts $&host.SceneScripts, source int, status $&ScriptStatus, tree &nexus.SceneTree, delta f64, axis f64) f64 {
    result := scripts.physics_process(tree, source, delta, axis) >>> (err) {
        message := err.msg()
        if status.error != message { eprintln(message) }
        status.error = message
        << 0.0
    }
    status.error = ""
    << result
}
// The demonstration tolerates a user removing an observed HUD field on reload.
fn optional_state(scripts &host.SceneScripts, binding int, id int) f64 { << scripts.state(binding, id) >>> (err) { << 0.0 } }
fn run() int {
    config := options() >>>
    raw := files.read(config.artifact + "", bc.MAX_BYTES) >>>
    program := bc.decode(&raw) >>>
    receiver_raw := files.read(config.receiver_artifact + "", bc.MAX_BYTES) >>>
    receiver_program := bc.decode(&receiver_raw) >>>
    $tree := nexus.new_scene_tree("World", 16) >>>
    root := tree.root()
    actor := tree.add_child(root, "Actor") >>>
    indicator := tree.add_child(root, "MovementIndicator") >>>
    $scripts := host.new_scene_scripts(2) >>>
    source := scripts.attach(&tree, actor, program) >>>
    receiver := scripts.attach(&tree, indicator, receiver_program) >>>
    scripts.connect(&tree, source, "moved", receiver, "on_moved") >>>
    $watcher := dev.development_file(config.artifact + "", &raw)
    $receiver_watcher := dev.development_file(config.receiver_artifact + "", &receiver_raw)
    $status := ScriptStatus{error: "", receiver_error: ""}
    canvas_program_0 := canvas_shaders.load_canvas(config.shaders + "") >>>
    $renderer := ren.open_2d("XuScript live reload | edit player.xus | A/D: move | Space: pause | Esc: exit", 960, 540, gpu.AUTO, &canvas_program_0) >>>
    backend := renderer.backend() >>>
    println("Script GPU backend: " + gpu_info.backend_name(backend))
    $input := controls.new_input_map()
    input.bind("left", window_events.KEY_A) >>>
    input.bind("left", window_events.KEY_LEFT) >>>
    input.bind("right", window_events.KEY_D) >>>
    input.bind("right", window_events.KEY_RIGHT) >>>
    input.bind("pause", window_events.KEY_SPACE) >>>
    input.bind("quit", window_events.KEY_ESCAPE) >>>
    $position := fm.vec2(160.0, 280.0)
    tree.set_position(actor, position) >>>
    tree.set_position(indicator, fm.vec2(64.0, 452.0)) >>>
    $signal_count := 0
    solids := [fm.rect2(48.0, 160.0, 16.0, 240.0), fm.rect2(896.0, 160.0, 16.0, 240.0)]
    camera := nexus.new_camera_2d(960.0, 540.0) >>>
    background := colors.rgba8(12, 20, 34, 255) >>>
    grid := colors.rgba8(28, 43, 61, 255) >>>
    muted := colors.rgba8(55, 75, 100, 255) >>>
    green := colors.rgba8(80, 220, 170, 255) >>>
    gold := colors.rgba8(240, 173, 67, 255) >>>
    red := colors.rgba8(244, 91, 97, 255) >>>
    $batch := ren_data.new_batch()
    $clock := timing.new_clock(60, 8) >>>
    $last := now_ns()
    $frame := 0
    $quit := false
    println("Script ready: epoch=1 calls=0 x=160")
    println("Receiver ready: epoch=1 calls=0 events=0")
    while !quit && (config.frames == 0 || frame < config.frames) {
        input.begin_frame()
        window.pump() >>>
        for i in 0:256 {
            event := renderer.poll() >>>
            if event.kind == window_events.EVENT_NONE { <- }
            if event.kind == window_events.EVENT_CLOSE_REQUESTED { quit = true }
            input_bridge.apply_window_input($&input, &event) >>>
        }
        if input.just_pressed("quit") >>> { quit = true }
        if quit { <- }
        if input.just_pressed("pause") >>> { tree.paused = !tree.paused }
        if frame % 15 == 0 {
            before_calls := scripts.calls(source) >>>
            before_ticks := optional_state(&scripts, source, 1)
            notice := watcher.poll_scene(&tree, $&scripts, source)
            if notice.status == host.ACTIVATED {
                println("Script activated: epoch=" + str(scripts.epoch(source) >>>) + " calls=" + str(scripts.calls(source) >>>) +
                    " x=" + (strconv.format_float(position.x, 103, -1) >>>) +
                    " ticks_before=" + (strconv.format_float(before_ticks, 103, -1) >>>) +
                    " ticks_after=" + (strconv.format_float(optional_state(&scripts, source, 1), 103, -1) >>>))
                assert((scripts.calls(source) >>>) == before_calls)
            } else if notice.status == host.REJECTED { eprintln("Script candidate rejected: " + notice.message) }
            before_events := optional_state(&scripts, receiver, 1)
            receiver_notice := receiver_watcher.poll_scene(&tree, $&scripts, receiver)
            if receiver_notice.status == host.ACTIVATED {
                println("Receiver activated: epoch=" + str(scripts.epoch(receiver) >>>) + " calls=" + str(scripts.calls(receiver) >>>) +
                    " events_before=" + (strconv.format_float(before_events, 103, -1) >>>) +
                    " events_after=" + (strconv.format_float(optional_state(&scripts, receiver, 1), 103, -1) >>>))
            } else if receiver_notice.status == host.REJECTED { eprintln("Receiver candidate rejected: " + receiver_notice.message) }
        }
        now := now_ns()
        $delta := f64(now - last) / 1000000000.0
        last = now
        if config.autoplay { delta = 1.0 / 60.0 }
        ticks := clock.advance(delta) >>>
        $axis := input.axis("left", "right") >>>
        if config.autoplay { axis = 1.0
            if (frame / 120) % 2 == 1 { axis = -1.0 } }
        for i in 0:ticks.steps {
            movement := step($&scripts, source, $&status, &tree, ticks.fixed_delta, axis)
            motion := physics2d.move_and_slide(fm.rect2(position.x, position.y, 28.0, 40.0), fm.vec2(movement, 0.0), &solids) >>>
            position = motion.position
            tree.set_position(actor, position) >>>
            report := scripts.dispatch(&tree, host.DEFAULT_DISPATCH_LIMIT) >>>
            signal_count = signal_count + report.delivered
            if report.first_error.len > 0 && report.first_error != status.receiver_error { eprintln(report.first_error) }
            status.receiver_error = report.first_error + ""
            tree.set_position(indicator, fm.vec2(64.0 + math.abs(optional_state(&scripts, receiver, 3)), 452.0)) >>>
        }
        if config.trace && frame % 30 == 0 {
            println("Script step: frame=" + str(frame) + " epoch=" + str(scripts.epoch(source) >>>) + " calls=" + str(scripts.calls(source) >>>) +
                " x=" + (strconv.format_float(position.x, 103, -1) >>>) +
                " ticks=" + (strconv.format_float(optional_state(&scripts, source, 1), 103, -1) >>>))
            println("Script signals: frame=" + str(frame) + " delivered=" + str(signal_count) +
                " value=" + (strconv.format_float(optional_state(&scripts, receiver, 2), 103, -1) >>>) +
                " connections=" + str(scripts.connection_count()) + " receiver_epoch=" + str(scripts.epoch(receiver) >>>) +
                " offset=" + (strconv.format_float(optional_state(&scripts, receiver, 3), 103, -1) >>>))
        }
        width := renderer.width() >>>
        height := renderer.height() >>>
        if width < 1 || height < 1 { sleep_ns(10000000)
            -> }
        view := camera.view_transform(f64(width), f64(height)) >>>
        $accent := green
        if (scripts.epoch(source) >>>) % 2 == 0 { accent = gold }
        if watcher.has_error() || receiver_watcher.has_error() || status.error.len > 0 || status.receiver_error.len > 0 { accent = red }
        batch.clear()
        for i in 0:25 { batch.quad(fm.rect2(64.0 + f64(i) * 34.0, 180.0, 1.0, 200.0), view, grid) >>> }
        batch.quad(fm.rect2(64.0, 320.0, 832.0, 2.0), view, muted) >>>
        for solid in solids { batch.quad(solid, view, muted) >>> }
        batch.quad(fm.rect2(position.x, position.y, 28.0, 40.0), view, accent) >>>
        batch.quad(fm.rect2(64.0, 74.0, 8.0, 28.0), view, accent) >>>
        for i in 0:(scripts.epoch(source) >>>) % 25 { batch.quad(fm.rect2(88.0 + f64(i) * 20.0, 78.0, 12.0, 20.0), view, accent) >>> }
        batch.quad(fm.rect2(64.0, 416.0, f64((scripts.calls(source) >>>) % 180) * 4.0 + 1.0, 8.0), view, accent) >>>
        indicator_world := tree.global_transform(indicator) >>>
        batch.quad(fm.rect2(0.0, 0.0, 12.0, 12.0), view.multiply(indicator_world), accent) >>>
        if tree.paused { batch.quad(fm.rect2(864.0, 74.0, 8.0, 28.0), view, gold) >>>
            batch.quad(fm.rect2(880.0, 74.0, 8.0, 28.0), view, gold) >>> }
        renderer.begin(background) >>>
        renderer.submit(&batch) >>>
        if config.capture.len > 0 && frame + 1 == config.frames { renderer.capture(config.capture + "") >>> }
        renderer.present() >>>
        frame = frame + 1
    }
    renderer.close() >>>
    println("Finished " + str(frame) + " script frames; epoch=" + str(scripts.epoch(source) >>>) + " calls=" + str(scripts.calls(source) >>>))
    println("Signals delivered=" + str(signal_count) + " connections=" + str(scripts.connection_count()))
    println("Receiver epoch=" + str(scripts.epoch(receiver) >>>) + " calls=" + str(scripts.calls(receiver) >>>) +
        " events=" + (strconv.format_float(optional_state(&scripts, receiver, 1), 103, -1) >>>))
    << 0
}
fn main() int { << run() >>> (err) { eprintln(err.msg())
    << 1 } }
