@scripts/player

pub struct Player {
    pub ticks f64
    pub distance f64
}

fn (self $&Player) physics_process(delta f64, axis f64) f64 {
    self.ticks = self.ticks + 1.0
    speed := 180.0
    movement := axis * speed * delta
    self.distance = self.distance + movement
    emit_signal("moved", movement)
    << movement
}
