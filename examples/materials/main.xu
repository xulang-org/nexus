@main

light_data #"github.com/xulang-org/game/resources/lighting"

#gpu

gpu_info #"github.com/xulang-org/game/platform/gpu"

#window
window_events #window/events
mesh_shaders #"github.com/xulang-org/game/assets/shaders/three_d"

meshes #"github.com/xulang-org/game/resources/mesh"

timing #"github.com/xulang-org/game/timing"
controls #"github.com/xulang-org/game/input"
ren #"github.com/xulang-org/game/rendering/three_d"
scene_render #"github.com/xulang-org/game/integration/rendering/three_d"
colors #"github.com/xulang-org/game/foundation/color"
input_bridge #"github.com/xulang-org/game/integration/input"
fm #"github.com/xulang-org/game/foundation/math"
game #"github.com/xulang-org/game/scene"
#os
#strconv
#errors
#math

fn run() int {
    args := os.args()
    $frames := 0
    $capture := ""
    $shaders := "build/mesh-shaders"
    $i := 1
    while i < args.len {
        if i + 1 >= args.len { >> errors.new("missing option value") }
        value := args[i + 1] + ""
        if args[i] == "--frames" { frames = strconv.atoi(&value) or >>
            if frames < 1 || frames > 1000000 { >> errors.new("invalid frame count") }
        } else if args[i] == "--shaders" { shaders = value
        } else if args[i] == "--capture" { capture = value
        } else { >> errors.new("unknown option") }
        i = i + 2
    }
    if capture.len > 0 && frames == 0 { >> errors.new("capture requires bounded frames") }
    mesh_program_0 := mesh_shaders.load_mesh(shaders + "") or >>
    $device := ren.open_3d("Xu materials | arrows: orbit | Space: pause light | Esc: exit", 1100, 720, gpu.AUTO, &mesh_program_0) or >>
    println("Material GPU backend: " + gpu_info.backend_name(device.backend() or >>))
    white := colors.rgba8(255, 255, 255, 255) or >>
    source := meshes.sphere_mesh_3d(0.65, 48, 24, white) or >>
    $sphere := device.upload(&source) or >>
    $tree := game.new_scene_tree_3d("Materials", 32) or >>
    $scene := scene_render.new_scene_3d(&device) or >>
    zero := fm.vec3(0.0, 0.0, 0.0)
    for row in 0:3 {
        for column in 0:5 {
            node := tree.add_child_3d(tree.root(), "Sphere" + str(row * 5 + column)) or >>
            tree.set_position_3d(node, fm.vec3((f64(column) - 2.0) * 1.6, (1.0 - f64(row)) * 1.65, 0.0)) or >>
            scene.attach_mesh(&tree, node, &sphere) or >>
            $base := fm.vec3(0.55, 0.14, 0.045)
            if row == 1 { base = fm.vec3(0.045, 0.35, 0.5) }
            if row == 2 { base = fm.vec3(0.6, 0.45, 0.12) }
            material := ren.material_3d(base, f64(row) / 2.0, 0.1 + f64(column) * 0.225, zero) or >>
            scene.set_material(&tree, node, material) or >>
        }
    }
    $input := controls.new_input_map()
    input.bind("left", window_events.KEY_LEFT) or >>
    input.bind("right", window_events.KEY_RIGHT) or >>
    input.bind("pause", window_events.KEY_SPACE) or >>
    input.bind("quit", window_events.KEY_ESCAPE) or >>
    $angle := 0.0
    $orbit := 0.0
    $paused := false
    $frame := 0
    $quit := false
    $last := now_ns()
    $clock := timing.new_clock(60, 8) or >>
    projection := game.new_camera_3d()
    background := colors.rgba8(12, 18, 29, 255) or >>
    while !quit && (frames == 0 || frame < frames) {
        input.begin_frame()
        window.pump() or >>
        for poll in 0:256 { event := device.poll() or >>
            if event.kind == window_events.EVENT_NONE { <- }
            if event.kind == window_events.EVENT_CLOSE_REQUESTED { quit = true }
            input_bridge.apply_window_input($&input, &event) or >> }
        if input.just_pressed("quit") or >> { quit = true }
        if quit { <- }
        if input.just_pressed("pause") or >> { paused = !paused }
        now := now_ns()
        $delta := f64(now - last) / 1000000000.0
        last = now
        if frames > 0 { delta = 1.0 / 60.0 }
        ticks := clock.advance(delta) or >>
        for tick in 0:ticks.steps {
            if !paused { angle = angle + ticks.fixed_delta * 0.4 }
            orbit = orbit + (input.axis("left", "right") or >>) * ticks.fixed_delta * 0.4
        }
        eye := fm.vec3(math.sin(orbit) * 10.0, 0.6, math.cos(orbit) * 10.0)
        view := game.look_at_3d(eye, zero, fm.vec3(0.0, 1.0, 0.0)) or >>
        width := device.width() or >>
        height := device.height() or >>
        if width < 1 || height < 1 { sleep_ns(10000000)
            -> }
        vp := (game.perspective_3d(projection.vertical_fov, f64(width) / f64(height), projection.near, projection.far) or >>).multiply(view)
        lighting := light_data.environment(fm.vec3(0.025, 0.03, 0.04), eye, 1.0, [light_data.directional(fm.vec3(math.sin(angle) * 0.8, 0.6, 1.0), fm.vec3(4.0, 3.8, 3.5)) or >>]) or >>
        device.begin(background) or >>
        draws := scene.draw_lit($&device, &tree, vp, &lighting) or >>
        assert((draws.instances+draws.culled_instances) == 15 && (draws.triangles+draws.culled_triangles) == source.triangle_count() * 15)
        if capture.len > 0 && frame + 1 == frames { device.capture(capture + "") or >> }
        device.present() or >>
        frame = frame + 1
    }
    sphere.close() or >>
    device.close() or >>
    println("Finished " + str(frame) + " material frames; 15 shared sphere instances")
    << 0
}
fn main() int { << run() or (err) { eprintln(err.msg())
    << 1 } }
