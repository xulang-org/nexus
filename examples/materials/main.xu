@main

light_data #"github.com/xulang-org/nexus/resources/lighting"

#gpu

gpu_info #"github.com/xulang-org/nexus/platform/gpu"

#window
window_events #window/events
mesh_shaders #"github.com/xulang-org/nexus/assets/shaders/three_d"

meshes #"github.com/xulang-org/nexus/resources/mesh"

timing #"github.com/xulang-org/nexus/timing"
controls #"github.com/xulang-org/nexus/input"
ren #"github.com/xulang-org/nexus/rendering/three_d"
scene_render #"github.com/xulang-org/nexus/integration/rendering/three_d"
colors #"github.com/xulang-org/nexus/foundation/color"
input_bridge #"github.com/xulang-org/nexus/integration/input"
fm #"github.com/xulang-org/nexus/foundation/math"
nexus #"github.com/xulang-org/nexus/scene"
#os
#strconv
#errors
#math

fn run() int {
    args := os.args()
    $frames := 0
    $capture := ""
    $shaders := "build/mesh-shaders"
    $i := 1
    while i < args.len {
        if i + 1 >= args.len { >> errors.new("missing option value") }
        value := args[i + 1] + ""
        if args[i] == "--frames" { frames = strconv.atoi(&value) >>>
            if frames < 1 || frames > 1000000 { >> errors.new("invalid frame count") }
        } else if args[i] == "--shaders" { shaders = value
        } else if args[i] == "--capture" { capture = value
        } else { >> errors.new("unknown option") }
        i = i + 2
    }
    if capture.len > 0 && frames == 0 { >> errors.new("capture requires bounded frames") }
    mesh_program_0 := mesh_shaders.load_mesh(shaders + "") >>>
    $device := ren.open_3d("Xu materials | arrows: orbit | Space: pause light | Esc: exit", 1100, 720, gpu.AUTO, &mesh_program_0) >>>
    println("Material GPU backend: " + gpu_info.backend_name(device.backend() >>>))
    white := colors.rgba8(255, 255, 255, 255) >>>
    source := meshes.sphere_mesh_3d(0.65, 48, 24, white) >>>
    $sphere := device.upload(&source) >>>
    $tree := nexus.new_scene_tree_3d("Materials", 32) >>>
    $scene := scene_render.new_scene_3d(&device) >>>
    zero := fm.vec3(0.0, 0.0, 0.0)
    for row in 0:3 {
        for column in 0:5 {
            node := tree.add_child_3d(tree.root(), "Sphere" + str(row * 5 + column)) >>>
            tree.set_position_3d(node, fm.vec3((f64(column) - 2.0) * 1.6, (1.0 - f64(row)) * 1.65, 0.0)) >>>
            scene.attach_mesh(&tree, node, &sphere) >>>
            $base := fm.vec3(0.55, 0.14, 0.045)
            if row == 1 { base = fm.vec3(0.045, 0.35, 0.5) }
            if row == 2 { base = fm.vec3(0.6, 0.45, 0.12) }
            material := ren.material_3d(base, f64(row) / 2.0, 0.1 + f64(column) * 0.225, zero) >>>
            scene.set_material(&tree, node, material) >>>
        }
    }
    $input := controls.new_input_map()
    input.bind("left", window_events.KEY_LEFT) >>>
    input.bind("right", window_events.KEY_RIGHT) >>>
    input.bind("pause", window_events.KEY_SPACE) >>>
    input.bind("quit", window_events.KEY_ESCAPE) >>>
    $angle := 0.0
    $orbit := 0.0
    $paused := false
    $frame := 0
    $quit := false
    $last := now_ns()
    $clock := timing.new_clock(60, 8) >>>
    projection := nexus.new_camera_3d()
    background := colors.rgba8(12, 18, 29, 255) >>>
    while !quit && (frames == 0 || frame < frames) {
        input.begin_frame()
        window.pump() >>>
        for poll in 0:256 { event := device.poll() >>>
            if event.kind == window_events.EVENT_NONE { <- }
            if event.kind == window_events.EVENT_CLOSE_REQUESTED { quit = true }
            input_bridge.apply_window_input($&input, &event) >>> }
        if input.just_pressed("quit") >>> { quit = true }
        if quit { <- }
        if input.just_pressed("pause") >>> { paused = !paused }
        now := now_ns()
        $delta := f64(now - last) / 1000000000.0
        last = now
        if frames > 0 { delta = 1.0 / 60.0 }
        ticks := clock.advance(delta) >>>
        for tick in 0:ticks.steps {
            if !paused { angle = angle + ticks.fixed_delta * 0.4 }
            orbit = orbit + (input.axis("left", "right") >>>) * ticks.fixed_delta * 0.4
        }
        eye := fm.vec3(math.sin(orbit) * 10.0, 0.6, math.cos(orbit) * 10.0)
        view := nexus.look_at_3d(eye, zero, fm.vec3(0.0, 1.0, 0.0)) >>>
        width := device.width() >>>
        height := device.height() >>>
        if width < 1 || height < 1 { sleep_ns(10000000)
            -> }
        vp := (nexus.perspective_3d(projection.vertical_fov, f64(width) / f64(height), projection.near, projection.far) >>>).multiply(view)
        lighting := light_data.environment(fm.vec3(0.025, 0.03, 0.04), eye, 1.0, [light_data.directional(fm.vec3(math.sin(angle) * 0.8, 0.6, 1.0), fm.vec3(4.0, 3.8, 3.5)) >>>]) >>>
        device.begin(background) >>>
        draws := scene.draw_lit($&device, &tree, vp, &lighting) >>>
        assert((draws.instances+draws.culled_instances) == 15 && (draws.triangles+draws.culled_triangles) == source.triangle_count() * 15)
        if capture.len > 0 && frame + 1 == frames { device.capture(capture + "") >>> }
        device.present() >>>
        frame = frame + 1
    }
    sphere.close() >>>
    device.close() >>>
    println("Finished " + str(frame) + " material frames; 15 shared sphere instances")
    << 0
}
fn main() int { << run() >>> (err) { eprintln(err.msg())
    << 1 } }
