@main

#app
#gpu
#window
window_events #window/events

gpu_info #"github.com/xulang-org/nexus/platform/gpu"
mesh_shaders #"github.com/xulang-org/nexus/assets/shaders/three_d"
canvas_shaders #"github.com/xulang-org/nexus/assets/shaders/two_d"
sprite_anim #"github.com/xulang-org/nexus/animation/sprite"
colors #"github.com/xulang-org/nexus/foundation/color"
fm #"github.com/xulang-org/nexus/foundation/math"
controls #"github.com/xulang-org/nexus/input"
app_host #"github.com/xulang-org/nexus/integration/application"
phone_controls #"github.com/xulang-org/nexus/integration/phone_controls"
viewport #"github.com/xulang-org/nexus/integration/viewport"
light_bindings #"github.com/xulang-org/nexus/integration/lighting"
scene_render #"github.com/xulang-org/nexus/integration/rendering/three_d"
files #"github.com/xulang-org/nexus/integration/scene"
light_files #"github.com/xulang-org/nexus/integration/scene_lighting"
sprite_files #"github.com/xulang-org/nexus/integration/scene_sprites3d"
ren #"github.com/xulang-org/nexus/rendering/three_d"
ren2 #"github.com/xulang-org/nexus/rendering/two_d"
canvas #"github.com/xulang-org/nexus/resources/canvas"
light_data #"github.com/xulang-org/nexus/resources/lighting"
meshes #"github.com/xulang-org/nexus/resources/mesh"
shadows #"github.com/xulang-org/nexus/resources/shadow"
nexus #"github.com/xulang-org/nexus/scene"
#errors
#math
#os
#strconv

const HERO_X_LIMIT = 4
const HERO_Z_LIMIT = 3

struct Options {
    path string
    camera string
    save string
    capture string
    shaders string
    frames int
    backend int
    flip_hero bool
    touch bool
    autoplay bool
}

fn options() Options {
    args := os.args()
    $config := Options{
        path: "examples/hd2d_scene/assets/world.xuscene",
        camera: "CameraOrtho",
        save: "",
        capture: "",
        shaders: "build/mesh-shaders",
        frames: 0,
        backend: gpu.AUTO,
        flip_hero: false,
        touch: app.is_hosted() || os.getenv("XU_PHONE_RESOURCE_ROOT").len > 0,
        autoplay: false
    }
    if config.touch {
        config.path = app_host.resolve_resource("map/world.xuscene", "build") >>>
        config.shaders = app_host.resolve_resource("mesh", "build") >>>
    }
    $i := 1
    while i < args.len {
        if args[i] == "--flip-hero" {
            config.flip_hero = true
            i = i + 1
            ->
        }
        if args[i] == "--touch" || args[i] == "--autoplay" {
            config.touch = true
            if args[i] == "--autoplay" { config.autoplay = true }
            i = i + 1
            ->
        }
        if i + 1 >= args.len { >> errors.new("missing option value") }
        next := i + 1
        if args[i] == "--scene" { config.path = args[next] + ""
        } else if args[i] == "--camera" { config.camera = args[next] + ""
        } else if args[i] == "--save" { config.save = args[next] + ""
        } else if args[i] == "--shaders" { config.shaders = args[next] + ""
        } else if args[i] == "--capture" { config.capture = args[next] + ""
        } else if args[i] == "--frames" {
            config.frames = strconv.atoi(&args[next]) >>>
            if config.frames < 1 || config.frames > 1000000 { >> errors.new("invalid frames") }
        } else if args[i] == "--backend" {
            if args[next] == "metal" { config.backend = gpu.METAL
            } else if args[next] == "vulkan" { config.backend = gpu.VULKAN
            } else if args[next] == "d3d12" { config.backend = gpu.D3D12
            } else if args[next] != "auto" { >> errors.new("unknown backend") }
        } else { >> errors.new("unknown option: " + args[i]) }
        i = i + 2
    }
    if config.capture.len > 0 && config.frames == 0 { >> errors.new("capture requires --frames") }
    if config.autoplay && config.frames == 0 { >> errors.new("autoplay requires --frames") }
    if config.camera != "CameraOrtho" && config.camera != "CameraPersp" { >> errors.new("unknown camera: " + config.camera) }
    << config
}

fn box_mesh(sx f64, sy f64, sz f64, color int) meshes.MeshData3D {
    hx := sx * 0.5
    hy := sy * 0.5
    hz := sz * 0.5
    $mesh := meshes.new_mesh_data_3d()
    // Top (+Y)
    t0 := mesh.vertex_lit(fm.vec3(-hx, hy, hz), color, fm.vec3(0.0, 1.0, 0.0)) >>>
    t1 := mesh.vertex_lit(fm.vec3(hx, hy, hz), color, fm.vec3(0.0, 1.0, 0.0)) >>>
    t2 := mesh.vertex_lit(fm.vec3(hx, hy, -hz), color, fm.vec3(0.0, 1.0, 0.0)) >>>
    t3 := mesh.vertex_lit(fm.vec3(-hx, hy, -hz), color, fm.vec3(0.0, 1.0, 0.0)) >>>
    mesh.triangle(t0, t1, t2) >>>
    mesh.triangle(t0, t2, t3) >>>
    // Front (+Z)
    f0 := mesh.vertex_lit(fm.vec3(-hx, -hy, hz), color, fm.vec3(0.0, 0.0, 1.0)) >>>
    f1 := mesh.vertex_lit(fm.vec3(hx, -hy, hz), color, fm.vec3(0.0, 0.0, 1.0)) >>>
    f2 := mesh.vertex_lit(fm.vec3(hx, hy, hz), color, fm.vec3(0.0, 0.0, 1.0)) >>>
    f3 := mesh.vertex_lit(fm.vec3(-hx, hy, hz), color, fm.vec3(0.0, 0.0, 1.0)) >>>
    mesh.triangle(f0, f1, f2) >>>
    mesh.triangle(f0, f2, f3) >>>
    // Right (+X)
    r0 := mesh.vertex_lit(fm.vec3(hx, -hy, hz), color, fm.vec3(1.0, 0.0, 0.0)) >>>
    r1 := mesh.vertex_lit(fm.vec3(hx, -hy, -hz), color, fm.vec3(1.0, 0.0, 0.0)) >>>
    r2 := mesh.vertex_lit(fm.vec3(hx, hy, -hz), color, fm.vec3(1.0, 0.0, 0.0)) >>>
    r3 := mesh.vertex_lit(fm.vec3(hx, hy, hz), color, fm.vec3(1.0, 0.0, 0.0)) >>>
    mesh.triangle(r0, r1, r2) >>>
    mesh.triangle(r0, r2, r3) >>>
    // Left (-X)
    l0 := mesh.vertex_lit(fm.vec3(-hx, -hy, -hz), color, fm.vec3(-1.0, 0.0, 0.0)) >>>
    l1 := mesh.vertex_lit(fm.vec3(-hx, -hy, hz), color, fm.vec3(-1.0, 0.0, 0.0)) >>>
    l2 := mesh.vertex_lit(fm.vec3(-hx, hy, hz), color, fm.vec3(-1.0, 0.0, 0.0)) >>>
    l3 := mesh.vertex_lit(fm.vec3(-hx, hy, -hz), color, fm.vec3(-1.0, 0.0, 0.0)) >>>
    mesh.triangle(l0, l1, l2) >>>
    mesh.triangle(l0, l2, l3) >>>
    << mesh
}

fn shadow_description(selection light_bindings.ShadowSelection3D, source light_data.Light3D,
    view fm.Mat4, projection fm.Mat4, mobile bool) shadows.ShadowDescription3D {
    if selection.cascades.enabled() {
        camera := shadows.cascade_camera(view, projection) >>>
        $settings := selection.cascades.settings() >>>
        if mobile && settings.resolution > PHONE_SHADOW_RESOLUTION { settings.resolution = PHONE_SHADOW_RESOLUTION }
        << shadows.cascaded(source, camera, settings) >>>
    }
    if mobile {
        $settings := selection.punctual.settings() >>>
        if settings.resolution > PHONE_SHADOW_RESOLUTION { settings.resolution = PHONE_SHADOW_RESOLUTION }
        profile := shadows.punctual_profile(source, settings) >>>
        << profile.description(source) >>>
    }
    << selection.punctual.description(source) >>>
}

fn run() int {
    config := options() >>>
    mesh_program := mesh_shaders.load_mesh(config.shaders + "") >>>
    shadow_program := mesh_shaders.load_shadow(config.shaders + "") >>>
    $window_options := window.Options{title: "Nexus Engine HD-2D 2.5D", width: 960, height: 640,
        resizable: true, high_pixel_density: false, hidden: false}
    if config.touch {
        // The desktop touch preview is large enough to exercise the same pixel cap.
        window_options.width = 768
        window_options.height = 1360
        window_options.high_pixel_density = true
    }
    $device := ren.open_3d_window(window_options, config.backend, &mesh_program) >>>
    $overlays := []ren2.Overlay2D{}
    if config.touch {
        device.set_max_render_pixels(PHONE_RENDER_PIXELS) >>>
        canvas_program := canvas_shaders.load_canvas(config.shaders + "") >>>
        sdf_program := canvas_shaders.load_ui_sdf(config.shaders + "") >>>
        overlays.push(ren2.open_overlay(device.present_session() >>>, &canvas_program, &sdf_program) >>>)
    }
    println("HD-2D GPU backend: " + gpu_info.backend_name(device.backend() >>>))

    $sprite_set := sprite_files.load_sprites(&device, config.path + "") >>>
    packed := files.to_packed_nodes(sprite_set.document()) >>>
    $tree := nexus.new_scene_tree_3d("Root", 128) >>>
    root := tree.root()
    instance := packed.instantiate($&tree, root, "HD2D") >>>

    $light_world := light_bindings.new_scene_lights_3d()
    light_files.bind(sprite_set.document(), $&light_world, &tree, instance) >>>

    $sprites := scene_render.new_scene_sprites_3d(&device) >>>
    sprite_set.bind($&sprites, &tree, instance) >>>

    // Procedural 3D PBR courtyard floor and raised stone step outside the saved subtree.
    $scene := scene_render.new_scene_3d(&device) >>>
    white := colors.rgba8(255, 255, 255, 255) >>>
    floor_data := box_mesh(11.0, 0.4, 9.0, white) >>>
    dais_data := box_mesh(3.2, 0.3, 2.0, white) >>>
    $floor_mesh := device.upload(&floor_data) >>>
    $dais_mesh := device.upload(&dais_data) >>>
    floor_node := tree.add_child_3d(root, "CourtyardFloor") >>>
    tree.set_position_3d(floor_node, fm.vec3(0.0, -0.2, 0.0)) >>>
    dais_node := tree.add_child_3d(root, "StoneDais") >>>
    tree.set_position_3d(dais_node, fm.vec3(0.0, -0.15, -1.6)) >>>
    floor_mat := ren.material_3d(fm.vec3(0.28, 0.36, 0.25), 0.0, 0.88, fm.vec3(0.0, 0.0, 0.0)) >>>
    dais_mat := ren.material_3d(fm.vec3(0.45, 0.43, 0.4), 0.0, 0.82, fm.vec3(0.0, 0.0, 0.0)) >>>
    scene.attach_surface(&tree, floor_node, &floor_mesh, floor_mat) >>>
    scene.attach_surface(&tree, dais_node, &dais_mesh, dais_mat) >>>

    hero := tree.find_node(instance, "Hero") >>>
    ortho_cam := tree.find_node(instance, "CameraOrtho") >>>
    persp_cam := tree.find_node(instance, "CameraPersp") >>>
    $active_cam := ortho_cam
    if config.camera == "CameraPersp" { active_cam = persp_cam }
    hero_spec := sprites.spec(hero) >>>
    $hero_flip_x := hero_spec.flip_x
    $checkpoint_path := ""
    if config.touch && (app.is_hosted() || os.getenv("XU_PHONE_DATA_ROOT").len > 0) {
        checkpoint_path = app_host.resolve_data("hd2d-v1.json", "build") >>>
        authored := (tree.node_3d(hero) >>>).transform.c3.xyz()
        checkpoint := load_phone_checkpoint(checkpoint_path + "", PhoneCheckpoint{x: authored.x, z: authored.z,
            perspective: active_cam == persp_cam, flip_x: hero_flip_x, paused: tree.paused}) >>>
        tree.set_position_3d(hero, fm.vec3(checkpoint.x, authored.y, checkpoint.z)) >>>
        if checkpoint.perspective { active_cam = persp_cam } else { active_cam = ortho_cam }
        hero_flip_x = checkpoint.flip_x
        tree.paused = checkpoint.paused
    }
    if config.flip_hero {
        hero_flip_x = !hero_flip_x
    }
    if hero_flip_x != hero_spec.flip_x {
        sprites.set_region(hero, hero_spec.region, hero_flip_x, hero_spec.flip_y) >>>
    }

    clip := sprite_anim.new_atlas_animation(4, 1, 0, 4, 6.0, true) >>>
    $animator := sprite_anim.new_sprite_animator(clip) >>>
    for frame in 0:4 {
        region := clip.region(frame) >>>
        if region.position.x == hero_spec.region.position.x && region.position.y == hero_spec.region.position.y &&
            region.size.x == hero_spec.region.size.x && region.size.y == hero_spec.region.size.y {
            animator.seek_frame(frame) >>>
            <-
        }
    }
    $input := controls.new_input_map()
    actions := ["left", "right", "up", "down", "pause", "toggle_cam"]
    keys := [window_events.KEY_A, window_events.KEY_D, window_events.KEY_W, window_events.KEY_S,
        window_events.KEY_SPACE, window_events.KEY_C]
    for i in 0:actions.len {
        input.bind(actions[i] + "", keys[i]) >>>
        input.bind_source(actions[i] + "", i) >>>
    }
    input.bind("quit", window_events.KEY_ESCAPE) >>>
    $host := app_host.new_app_host(60, 8, 1, 1) >>>
    host.enable_back_handling() >>>
    initial := viewport.from_window(device.window() >>>) >>>
    $layout := phone_controls.layout(&initial, config.touch)
    $touch := layout.controls() >>>
    $hud := canvas.new_batch()
    $shadow_maps := []ren.ShadowMap3D{}
    background := colors.rgba8(18, 26, 42, 255) >>>
    $frame := 0
    while (config.frames == 0 || frame < config.frames) && (host.next_frame() >>>) {
        step := host.begin_step(device.window() >>>, $&input, $&touch, now_ns()) >>>
        if !step.running || (input.just_pressed("quit") >>>) || (step.back_requested && tree.paused) {
            host.finish_step(true) >>>
            <-
        }
        if !step.drawable {
            host.finish_step(true) >>>
            if !host.is_hosted() { sleep_ns(10000000) }
            ->
        }
        view := &step.viewport
        if step.layout_changed {
            touch.cancel($&input) >>>
            layout = phone_controls.layout(view, config.touch)
            touch = layout.controls() >>>
        }
        if config.autoplay { autoplay_input($&input, $&touch, &layout, frame) >>> }
        if step.resumed && config.touch { println("HD-2D resumed") }
        if step.back_requested || (input.just_pressed("pause") >>>) {
            tree.paused = !tree.paused
            println("HD-2D paused=" + str(tree.paused))
        }
        if input.just_pressed("toggle_cam") >>> {
            if active_cam == ortho_cam { active_cam = persp_cam } else { active_cam = ortho_cam }
            println("HD-2D perspective=" + str(active_cam == persp_cam))
        }
        $ticks := host.finish_step(tree.paused) >>>
        if config.frames > 0 && !tree.paused { ticks.steps = 1 }
        for tick in 0:ticks.steps {
            move := input.vector("left", "right", "up", "down") >>>
            if move.x != 0.0 || move.y != 0.0 {
                if move.x < -0.01 { hero_flip_x = true }
                if move.x > 0.01 { hero_flip_x = false }
                cur := (tree.node_3d(hero) >>>).transform.c3.xyz()
                nx := math.max(-f64(HERO_X_LIMIT), math.min(f64(HERO_X_LIMIT), cur.x + move.x * 2.8 * ticks.fixed_delta))
                nz := math.max(-f64(HERO_Z_LIMIT), math.min(f64(HERO_Z_LIMIT), cur.z + move.y * 2.8 * ticks.fixed_delta))
                tree.set_position_3d(hero, fm.vec3(nx, cur.y, nz)) >>>
            }
            if config.frames == 0 || frame > 0 {
                animator.advance(ticks.fixed_delta) >>>
                sprites.set_region(hero, animator.region() >>>, hero_flip_x, hero_spec.flip_y) >>>
            }
        }
        if config.touch && step.touch_ended {
            pose := (tree.node_3d(hero) >>>).transform.c3.xyz()
            x := strconv.format_float(pose.x, 102, 3) >>>
            z := strconv.format_float(pose.z, 102, 3) >>>
            println("HD-2D hero: " + x + "," + z)
        }
        aspect := view.aspect_ratio()
        camera_world := tree.global_transform_3d(active_cam) >>>
        camera_view := camera_world.affine_inverse() >>>
        $projection := tree.camera_projection_3d(active_cam, aspect) >>>
        if config.touch { projection = phone_projection(projection, aspect) }
        vp := projection.multiply(camera_view)
        eye := camera_world.c3.xyz()
        $selection := light_bindings.no_shadow_selection()
        sources := light_world.gather_with_shadows(&tree, $&selection) >>>
        lighting := light_data.environment(fm.vec3(0.24, 0.27, 0.34), eye, 1.0, sources) >>>

        $shadow_pixels := 0
        if selection.source >= 0 {
            shadow_source := lighting.source(selection.source) >>>
            desc := shadow_description(selection, shadow_source, camera_view, projection, config.touch) >>>
            shadow_pixels = desc.resolution()
            if shadow_maps.len == 0 {
                shadow_maps.push(device.shadow_map(desc, &shadow_program) >>>)
            }
            $casters := scene.shadow_casters(&tree) >>>
            sprite_casters := sprites.shadow_casters(&tree, camera_world) >>>
            for c in sprite_casters { casters.push(c) }
            shadow := $&shadow_maps[0]
            shadow.render(&device, &casters, desc) >>>
        }

        device.begin(background) >>>
        if selection.source >= 0 {
            scene.draw_lit_shadowed($&device, &tree, vp, &lighting, &shadow_maps[0], selection.source) >>>
            sprites.draw_lit_shadowed($&device, &tree, camera_world, vp, &lighting, &shadow_maps[0], selection.source) >>>
        } else {
            scene.draw_lit($&device, &tree, vp, &lighting) >>>
            sprites.draw_lit($&device, &tree, camera_world, vp, &lighting) >>>
        }
        if config.capture.len > 0 && frame + 1 == config.frames {
            device.capture(config.capture + "") >>>
        }
        if config.touch {
            phone_controls.record($&hud, &touch, &layout, view, tree.paused, active_cam == persp_cam) >>>
            present_phone($&device, $&overlays[0], &hud) >>>
            if frame == 0 {
                println("HD-2D Phone frame: render=" + str(device.render_width() >>>) + "x" + str(device.render_height() >>>) +
                    "; present=" + str(view.pixel_width) + "x" + str(view.pixel_height) + "; shadow=" + str(shadow_pixels))
            }
        } else { device.present() >>> }
        frame += 1
    }
    if checkpoint_path.len > 0 {
        pose := (tree.node_3d(hero) >>>).transform.c3.xyz()
        checkpoint := PhoneCheckpoint{x: pose.x, z: pose.z, perspective: active_cam == persp_cam,
            flip_x: hero_flip_x, paused: tree.paused}
        persist_phone_checkpoint(checkpoint_path + "", checkpoint)
    }
    if config.save.len > 0 {
        sprite_set.save(config.save + "", &sprites, &tree, instance) >>>
    }
    if overlays.len > 0 {
        overlay := $&overlays[0]
        overlay.close() >>>
    }
    for i in 0:shadow_maps.len {
        s := $&shadow_maps[i]
        s.close() >>>
    }
    sprites.close() >>>
    sprite_set.close() >>>
    floor_mesh.close() >>>
    dais_mesh.close() >>>
    device.close() >>>
    << 0
}

fn main() int {
    << run() >>> (err) {
        eprintln(err.msg())
        << 1
    }
}
