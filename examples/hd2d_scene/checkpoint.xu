@main

fm #"github.com/xulang-org/nexus/foundation/math"
files #"github.com/xulang-org/nexus/internal/file_snapshot"
#encoding/json
#errors
#os
#strconv

struct PhoneCheckpoint {
    x f64
    z f64
    perspective bool
    flip_x bool
    paused bool
}

fn decode_phone_checkpoint(raw &string, initial PhoneCheckpoint) PhoneCheckpoint {
    data := json.parse_max(raw, 1024)
    root := data.root()
    if !data.ok() || !data.is_dict(root) || data.count(root) != 6 {
        >> errors.new("HD-2D: invalid checkpoint object")
    }
    version := data.get(root, "version")
    x := data.get(root, "x")
    z := data.get(root, "z")
    perspective := data.get(root, "perspective")
    flip := data.get(root, "flip_x")
    paused := data.get(root, "paused")
    if version < 0 || x < 0 || z < 0 || perspective < 0 || flip < 0 || paused < 0 {
        >> errors.new("HD-2D: missing checkpoint field")
    }
    if !data.is_number(version) || !data.is_number(x) || !data.is_number(z) ||
        !data.is_bool(perspective) || !data.is_bool(flip) || !data.is_bool(paused) ||
        (data.as_int(version) or >>) != 1 {
        >> errors.new("HD-2D: invalid checkpoint field")
    }
    state := PhoneCheckpoint{x: data.as_f64(x) or >>, z: data.as_f64(z) or >>,
        perspective: data.as_bool(perspective) or >>, flip_x: data.as_bool(flip) or >>,
        paused: data.as_bool(paused) or >>}
    if !fm.finite(state.x) || !fm.finite(state.z) ||
        ((state.x < -f64(HERO_X_LIMIT) || state.x > f64(HERO_X_LIMIT)) && state.x != initial.x) ||
        ((state.z < -f64(HERO_Z_LIMIT) || state.z > f64(HERO_Z_LIMIT)) && state.z != initial.z) {
        >> errors.new("HD-2D: invalid checkpoint position")
    }
    << state
}

fn load_phone_checkpoint(path string, initial PhoneCheckpoint) PhoneCheckpoint {
    raw := files.read(path + "", 1024) or (err) {
        if !os.is_not_exist(err.msg()) { eprintln("HD-2D checkpoint: " + err.msg()) }
        << initial
    }
    state := decode_phone_checkpoint(&raw, initial) or (err) {
        eprintln("HD-2D checkpoint: " + err.msg())
        << initial
    }
    x := strconv.format_float(state.x, 102, 3) or >>
    z := strconv.format_float(state.z, 102, 3) or >>
    println("HD-2D restored: hero=" + x + "," + z + "; perspective=" + str(state.perspective) +
        "; flip_x=" + str(state.flip_x) + "; paused=" + str(state.paused))
    << state
}

fn save_phone_checkpoint(path string, state PhoneCheckpoint) int {
    x := strconv.format_float(state.x, 103, -1) or >>
    z := strconv.format_float(state.z, 103, -1) or >>
    raw := "{\"version\":1,\"x\":" + x + ",\"z\":" + z + ",\"perspective\":" + str(state.perspective) +
        ",\"flip_x\":" + str(state.flip_x) + ",\"paused\":" + str(state.paused) + "}\n"
    << files.write_atomic(path, &raw) or >>
}

fn persist_phone_checkpoint(path string, state PhoneCheckpoint) {
    save_phone_checkpoint(path, state) or (err) {
        eprintln("HD-2D checkpoint: " + err.msg())
        <<
    }
}
