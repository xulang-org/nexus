<view class="page">
  <view class="toolbar">
    <text wx:if="{{mesh}}">3D WebGL</text>
    <text wx:else>宝石 {{collected}} / 3</text>
    <button size="mini" bindtap="resetGame" disabled="{{!ready}}">{{mesh ? '复位' : '重开'}}</button>
  </view>
  <canvas type="webgl" id="arena" class="arena" disable-scroll
    catchtouchstart="touchStart" catchtouchmove="touchMove"
    catchtouchend="touchEnd" catchtouchcancel="touchCancel" />
  <text class="status">{{status}}</text>
</view>
