page {
  background: #0a111c;
  color: #e8edf8;
}

.page {
  box-sizing: border-box;
  padding: 24rpx;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.toolbar button {
  margin: 0;
  background: #23364a;
  color: #e8edf8;
}

.arena {
  width: 100%;
  height: 66vw;
  background: #0a111c;
}

.status {
  margin-top: 20rpx;
  min-height: 36rpx;
  font-size: 26rpx;
  color: #a8b9d1;
}
