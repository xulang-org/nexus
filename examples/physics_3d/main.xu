@main

fm #"github.com/xulang-org/nexus/foundation/math"
physics #"github.com/xulang-org/nexus/physics3d"
meshes #"github.com/xulang-org/nexus/resources/mesh"
nexus #"github.com/xulang-org/nexus/scene"
renderer #"github.com/xulang-org/nexus/integration/rendering/three_d"
ren #"github.com/xulang-org/nexus/rendering/three_d"
mesh_shaders #"github.com/xulang-org/nexus/assets/shaders/three_d"
gpu_info #"github.com/xulang-org/nexus/platform/gpu"
controls #"github.com/xulang-org/nexus/input"
bridge #"github.com/xulang-org/nexus/integration/input"
timing #"github.com/xulang-org/nexus/timing"
events #window/events
#gpu
#window
#math
#os
#strconv
#errors

struct Options { frames int
    capture string
    autoplay bool }

fn options() Options {
    args := os.args()
    $result := Options{frames: 0, capture: "", autoplay: false}
    $i := 1
    while i < args.len {
        if args[i] == "--autoplay" { result.autoplay = true
            i += 1
            -> }
        if i + 1 >= args.len { >> errors.new("missing option value") }
        next := i + 1
        if args[i] == "--frames" {
            result.frames = strconv.atoi(&args[next]) or >>
            if result.frames < 1 || result.frames > 1000000 { >> errors.new("invalid frame count") }
        } else if args[i] == "--capture" { result.capture = args[next] + "" }
        else { >> errors.new("unknown option: " + args[i]) }
        i += 2
    }
    if result.capture.len > 0 && result.frames == 0 { >> errors.new("capture requires --frames") }
    << result
}

fn box_mesh(tones &[]int) meshes.MeshData3D {
    points := [fm.vec3(-0.5,-0.5,-0.5), fm.vec3(0.5,-0.5,-0.5), fm.vec3(0.5,0.5,-0.5), fm.vec3(-0.5,0.5,-0.5),
        fm.vec3(-0.5,-0.5,0.5), fm.vec3(0.5,-0.5,0.5), fm.vec3(0.5,0.5,0.5), fm.vec3(-0.5,0.5,0.5)]
    corners := [4,5,6,7, 1,0,3,2, 0,4,7,3, 5,1,2,6, 3,7,6,2, 0,1,5,4]
    $mesh := meshes.new_mesh_data_3d()
    for face in 0:6 {
        base := face * 4
        for i in 0:4 { mesh.vertex(points[corners[base + i]], tones[face]) or >> }
        mesh.triangle(base, base + 1, base + 2) or >>
        mesh.triangle(base, base + 2, base + 3) or >>
    }
    << mesh
}

fn triangle_ramp_mesh(triangles &[]physics.StaticTriangle3D, top_color int, bottom_color int) meshes.MeshData3D {
    $mesh := meshes.new_mesh_data_3d()
    for i in 0:triangles.len {
        tri := triangles[i]
        base := i * 6
        mesh.vertex(tri.a, top_color) or >>
        mesh.vertex(tri.b, top_color) or >>
        mesh.vertex(tri.c, top_color) or >>
        mesh.triangle(base, base + 1, base + 2) or >>
        mesh.vertex(tri.a, bottom_color) or >>
        mesh.vertex(tri.c, bottom_color) or >>
        mesh.vertex(tri.b, bottom_color) or >>
        mesh.triangle(base + 3, base + 4, base + 5) or >>
    }
    << mesh
}

fn put_box(tree $&nexus.SceneTree, node int, box fm.Aabb3) int {
    center := box.center() or >>
    size := box.maximum.sub(box.minimum)
    << tree.set_transform_3d(node, fm.translation_3d(center).multiply(fm.scale_3d(size))) or >>
}

fn put_rigid(tree $&nexus.SceneTree, node int, body physics.RigidBody3D) int {
    if body.kind == physics.SHAPE_SPHERE {
        s := fm.vec3(body.radius, body.radius, body.radius)
        << tree.set_transform_3d(node, fm.translation_3d(body.position).multiply(fm.scale_3d(s))) or >>
    }
    size := body.half_extents.scaled(2.0)
    << tree.set_transform_3d(node, fm.translation_3d(body.position).multiply(fm.scale_3d(size))) or >>
}

fn run() int {
    config := options() or >>
    floor := fm.aabb3(fm.vec3(-5.0,-0.35,-5.0), fm.vec3(5.0,0.0,5.0)) or >>
    wall := fm.aabb3(fm.vec3(0.6,0.0,-3.5), fm.vec3(0.75,1.75,2.8)) or >>
    post := fm.aabb3(fm.vec3(-2.8,0.0,-2.45), fm.vec3(-1.8,1.1,-1.45)) or >>
    solids := [floor, wall, post]
    spawn := fm.aabb3(fm.vec3(-2.3,1.8,1.65), fm.vec3(-1.75,3.0,2.2)) or >>
    $body := spawn
    $falling := 0.0

    // Arbitrary diagonally rotated 3D triangle ramp on the +X side for dynamic rigid bodies.
    slope_xf := fm.translation_3d(fm.vec3(2.9, 0.0, -1.6)).multiply(fm.rotation_y(0.35))
    sa := fm.vec3(-1.0, 1.4, -1.3)
    sb := fm.vec3(1.0, 1.4, -1.3)
    sc := fm.vec3(1.0, 0.0, 1.3)
    sd := fm.vec3(-1.0, 0.0, 1.3)
    tri0 := physics.transform_triangle_3d(sa, sc, sb, slope_xf, 1) or >>
    tri1 := physics.transform_triangle_3d(sa, sd, sc, slope_xf, 1) or >>
    ramp_tris := [tri0, tri1]
    static_boxes := [physics.StaticBox3D{bounds: floor, layer: 1, trigger: false},
        physics.StaticBox3D{bounds: wall, layer: 1, trigger: false},
        physics.StaticBox3D{bounds: post, layer: 1, trigger: false}]
    $rigid_world := physics.new_rigid_world(fm.vec3(0.0, -9.8, 0.0), static_boxes,
        []physics.StaticRamp3D{}, [tri0, tri1]) or >>
    ball_spawn := fm.vec3(2.55, 2.2, -2.55)
    crate0_spawn := fm.vec3(3.15, 0.35, 0.95)
    crate1_spawn := fm.vec3(3.15, 1.06, 0.95)
    ball_id := rigid_world.add_body(physics.dynamic_sphere_3d(ball_spawn, 0.34, 1.5, 0.35, 0.06) or >>) or >>
    crate0_id := rigid_world.add_body(physics.dynamic_box_3d(crate0_spawn, fm.vec3(0.35, 0.35, 0.35), 2.0, 0.1, 0.55) or >>) or >>
    crate1_id := rigid_world.add_body(physics.dynamic_box_3d(crate1_spawn, fm.vec3(0.35, 0.35, 0.35), 2.0, 0.1, 0.55) or >>) or >>

    program := mesh_shaders.load_mesh("build/mesh-shaders") or >>
    $device := ren.open_3d("Nexus 3D Physics | arrows: move | Space: respawn | Esc: exit", 900, 600, gpu.AUTO, &program) or >>
    println("Physics 3D GPU backend: " + gpu_info.backend_name(device.backend() or >>))
    object := box_mesh(&[0x496274ff,0x415064ff,0x334956ff,0x3b5260ff,0x627e8eff,0x344454ff]) or >>
    character := box_mesh(&[0xffad5aff,0xd4793fff,0xb8522dff,0xd57538ff,0xffda8aff,0xc36536ff]) or >>
    crate_data := box_mesh(&[0x5cc48aff,0x3b9967ff,0x2e7d53ff,0x46ab74ff,0x8ae0b0ff,0x33865aff]) or >>
    sphere_data := meshes.sphere_mesh_3d(1.0, 18, 12, 0x52c7f2ff) or >>
    ramp_data := triangle_ramp_mesh(&ramp_tris, 0x7a9bb5ff, 0x3b5260ff) or >>
    $solid_mesh := device.upload(&object) or >>
    $player_mesh := device.upload(&character) or >>
    $crate_mesh := device.upload(&crate_data) or >>
    $sphere_mesh := device.upload(&sphere_data) or >>
    $ramp_mesh := device.upload(&ramp_data) or >>
    $tree := nexus.new_scene_tree_3d("Physics", 32) or >>
    root := tree.root()
    $world := renderer.new_scene_3d(&device) or >>
    for i in 0:solids.len {
        node := tree.add_child_3d(root, "Static " + str(i)) or >>
        put_box($&tree, node, solids[i]) or >>
        world.attach_mesh(&tree, node, &solid_mesh) or >>
    }
    ramp_node := tree.add_child_3d(root, "Triangle ramp") or >>
    world.attach_mesh(&tree, ramp_node, &ramp_mesh) or >>
    player := tree.add_child_3d(root, "Player") or >>
    marker := tree.add_child_3d(root, "Ray hit") or >>
    world.attach_mesh(&tree, player, &player_mesh) or >>
    world.attach_mesh(&tree, marker, &player_mesh) or >>
    ball_node := tree.add_child_3d(root, "Dynamic sphere") or >>
    crate0_node := tree.add_child_3d(root, "Dynamic crate 0") or >>
    crate1_node := tree.add_child_3d(root, "Dynamic crate 1") or >>
    world.attach_mesh(&tree, ball_node, &sphere_mesh) or >>
    world.attach_mesh(&tree, crate0_node, &crate_mesh) or >>
    world.attach_mesh(&tree, crate1_node, &crate_mesh) or >>
    $camera := nexus.new_camera_3d()
    camera.position = fm.vec3(-7.6, 8.7, 10.2)
    camera.target = fm.vec3(0.0, 0.0, 0.0)

    $input := controls.new_input_map()
    input.bind("left", events.KEY_LEFT) or >>
    input.bind("right", events.KEY_RIGHT) or >>
    input.bind("forward", events.KEY_UP) or >>
    input.bind("back", events.KEY_DOWN) or >>
    input.bind("respawn", events.KEY_SPACE) or >>
    $clock := timing.new_clock(60, 8) or >>
    $last := now_ns()
    $frame := 0
    $floor_contacts := 0
    $wall_slides := 0
    $rigid_contacts := 0
    $ray_collider := -1
    $quit := false
    while !quit && (config.frames == 0 || frame < config.frames) {
        input.begin_frame()
        window.pump() or >>
        for i in 0:256 {
            event := device.poll() or >>
            if event.kind == events.EVENT_NONE { <- }
            if event.kind == events.EVENT_CLOSE_REQUESTED || (event.kind == events.EVENT_KEY_DOWN && event.physical_key == events.KEY_ESCAPE) { quit = true }
            bridge.apply_window_input($&input, &event) or >>
        }
        if quit { <- }
        if body.minimum.y < -5.0 || (input.just_pressed("respawn") or >>) {
            body = spawn
            falling = 0.0
            rigid_world.set_position(ball_id, ball_spawn) or >>
            rigid_world.set_velocity(ball_id, fm.vec3(0.0, 0.0, 0.0)) or >>
            rigid_world.set_position(crate0_id, crate0_spawn) or >>
            rigid_world.set_velocity(crate0_id, fm.vec3(0.0, 0.0, 0.0)) or >>
            rigid_world.set_position(crate1_id, crate1_spawn) or >>
            rigid_world.set_velocity(crate1_id, fm.vec3(0.0, 0.0, 0.0)) or >>
        }
        now := now_ns()
        $delta := f64(now - last) / 1000000000.0
        last = now
        if config.frames > 0 { delta = 1.0 / 60.0 }
        ticks := clock.advance(delta) or >>
        $direction := fm.vec3(input.axis("left", "right") or >>, 0.0, input.axis("forward", "back") or >>)
        if config.autoplay { direction = fm.vec3(1.0, 0.0, -1.0) }
        if direction.length() > 1.0 { direction = direction.normalized() or >> }
        for tick in 0:ticks.steps {
            falling = math.max(-20.0, falling - 9.8 * ticks.fixed_delta)
            motion := fm.vec3(direction.x * 3.0, falling, direction.z * 3.0).scaled(ticks.fixed_delta)
            result := physics.move_and_slide(body, motion, &solids) or >>
            body = result.bounds
            if result.on_floor { falling = 0.0
                floor_contacts += 1 }
            if result.on_wall && math.abs(result.travelled.z) > 0.0 { wall_slides += 1 }
            rigid_step := rigid_world.step(ticks.fixed_delta, 4, 10) or >>
            rigid_contacts += rigid_step.contacts
        }
        put_box($&tree, player, body) or >>
        put_rigid($&tree, ball_node, rigid_world.body(ball_id) or >>) or >>
        put_rigid($&tree, crate0_node, rigid_world.body(crate0_id) or >>) or >>
        put_rigid($&tree, crate1_node, rigid_world.body(crate1_id) or >>) or >>
        origin := body.center() or >>
        hit := physics.raycast(origin, fm.vec3(1.0,0.0,0.0), 6.0, &solids) or >>
        ray_collider = hit.collider
        tree.set_visible(marker, ray_collider >= 0) or >>
        if ray_collider >= 0 {
            pose := fm.translation_3d(hit.point).multiply(fm.scale_3d(fm.vec3(0.16,0.16,0.16)))
            tree.set_transform_3d(marker, pose) or >>
        }
        width := device.width() or >>
        height := device.height() or >>
        if width < 1 || height < 1 { sleep_ns(10000000)
            -> }
        view := camera.view_projection(f64(width) / f64(height)) or >>
        device.begin(0x111928ff) or >>
        world.draw($&device, &tree, view) or >>
        if config.capture.len > 0 && frame + 1 == config.frames { device.capture(config.capture + "") or >> }
        device.present() or >>
        frame += 1
    }
    ball_final := rigid_world.body(ball_id) or >>
    crate0_final := rigid_world.body(crate0_id) or >>
    crate1_final := rigid_world.body(crate1_id) or >>
    if config.autoplay && config.frames == 120 {
        assert(floor_contacts > 50 && wall_slides > 30 && ray_collider == 1)
        assert(body.maximum.x == wall.minimum.x && body.minimum.y == floor.maximum.y && body.minimum.z < -2.0)
        assert(rigid_contacts > 100 && ball_final.position.z > 0.0 && ball_final.position.y >= 0.32)
        assert(crate0_final.position.y >= 0.33 && crate0_final.position.z > crate0_spawn.z + 0.1)
        assert(crate1_final.position.y >= 0.33)
    }
    println("Finished " + str(frame) + " physics frames, floor contacts=" + str(floor_contacts) +
        ", wall slide steps=" + str(wall_slides) + ", rigid contacts=" + str(rigid_contacts) +
        ", ray collider=" + str(ray_collider))
    ramp_mesh.close() or >>
    sphere_mesh.close() or >>
    crate_mesh.close() or >>
    player_mesh.close() or >>
    solid_mesh.close() or >>
    device.close() or >>
    << 0
}

fn main() int { << run() or (err) { eprintln(err.msg())
    << 1 } }
