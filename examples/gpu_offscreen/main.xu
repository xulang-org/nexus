@main

#gpu
#gpu/layout
#encoding/binary
#os
#errors

// This example is an independent standard-library consumer. Shader binaries
// are prepared offline; no nexus package or native archive is linked.
fn shader_bytes(path string) []u8 {
    $file := os.open(path) or >>
    $output := []u8{}
    while output.len <= 1048576 {
        chunk := file.read(65536) or >>
        if chunk.len == 0 { <- }
        if chunk.len > 1048576 - output.len { >> errors.new("shader exceeds example's 1 MiB budget") }
        for i in 0:chunk.len { output.push(u8(chunk[i])) }
    }
    file.close() or >>
    if output.len == 0 { >> errors.new("empty shader") }
    << output
}
// Layouts in this example use IEEE binary32 little-endian words.
fn float_bytes(values &[]f64) []u8 {
    $output := []u8{}
    for i in 0:values.len*4 { output.push(u8(0)) }
    order := binary.little_endian()
    for i in 0:values.len { order.put_f32($&output, i*4, values[i]) or >> }
    << output
}
fn transform_bytes(offset_x f64) []u8 {
    $values := []f64{}
    for column in 0:4 { for row in 0:4 {
        $value := 0.0
        if row == column { value = 1.0 }
        values.push(value)
    } }
    values[12] = offset_x
    << float_bytes(&values) or >>
}
fn run() int {
    args := os.args()
    $backend := gpu.AUTO
    $directory := "build/gpu-offscreen-shaders"
    $i := 1
    while i < args.len {
        if i + 1 >= args.len { >> errors.new("missing option value") }
        if args[i] == "--shaders" { directory = args[i+1] + ""
        } else if args[i] == "--backend" {
            if args[i+1] == "metal" { backend = gpu.METAL
            } else if args[i+1] == "vulkan" { backend = gpu.VULKAN
            } else if args[i+1] == "d3d12" { backend = gpu.D3D12
            } else if args[i+1] != "auto" { >> errors.new("unknown GPU backend") }
        } else { >> errors.new("unknown option: " + args[i]) }
        i += 2
    }
    $device := gpu.open(gpu.DeviceOptions{backend: backend, debug: true, shader_formats: 0}) or >>
    selected := device.backend() or >>
    $format := gpu.SHADER_MSL
    $entrypoint := "main0"
    $name := "Metal"
    if selected == gpu.VULKAN { format = gpu.SHADER_SPIRV
        entrypoint = "main"
        name = "Vulkan"
    } else if selected == gpu.D3D12 { format = gpu.SHADER_DXIL
        entrypoint = "main"
        name = "D3D12" }
    vertex_code := shader_bytes(directory + "/triangle.vert.bin") or >>
    fragment_code := shader_bytes(directory + "/triangle.frag.bin") or >>
    vertex_desc := gpu.ShaderDesc{stage: gpu.VERTEX, format: format, entrypoint: entrypoint + "", samplers: 0, uniform_sizes: [64]}
    fragment_desc := gpu.ShaderDesc{stage: gpu.FRAGMENT, format: format, entrypoint: entrypoint, samplers: 1, uniform_sizes: [16]}
    $vertex := device.shader(&vertex_desc, &vertex_code) or >>
    $fragment := device.shader(&fragment_desc, &fragment_code) or >>
    $pipeline_desc := gpu.pipeline_defaults(layout.RGBA8_UNORM)
    pipeline_desc.vertex_buffers = [gpu.VertexBufferLayout{slot: 0, stride: 12, rate: gpu.PER_VERTEX}]
    pipeline_desc.attributes = [gpu.VertexAttribute{location: 0, slot: 0, format: gpu.FLOAT3, offset: 0}]
    $pipeline := device.graphics_pipeline(&vertex, &fragment, &pipeline_desc) or >>
    vertex.close() or >>
    fragment.close() or >>
    $source := device.texture_2d(gpu.Texture2DDesc{format: layout.RGBA8_UNORM, width: 1, height: 1, levels: 1, usage: gpu.TEXTURE_SAMPLED}) or >>
    $target := device.texture_2d(gpu.Texture2DDesc{format: layout.RGBA8_UNORM, width: 7, height: 5, levels: 1, usage: gpu.TEXTURE_COLOR_TARGET}) or >>
    $sampler := device.sampler(gpu.sampler_defaults()) or >>
    pixel := [u8(23), u8(181), u8(67), u8(255)]
    $uploaded := device.upload_texture(&source, 0, &pixel) or >>
    uploaded.close() or >>
    coordinates := [-1.0,-1.0,0.5, 3.0,-1.0,0.5, -1.0,3.0,0.5]
    vertices := float_bytes(&coordinates) or >>
    $vertex_buffer := device.buffer(vertices.len, gpu.BUFFER_VERTEX) or >>
    $vertex_upload := device.upload(&vertex_buffer, 0, &vertices) or >>
    vertex_upload.close() or >>
    for frame in 0:4 {
        $offset := 0.0
        if frame == 1 { offset = f64(frame) * 2.0 }
        matrix := transform_bytes(offset) or >>
        $tint := [0.0,0.0,0.0,1.0]
        $channel := 0
        if frame == 2 { channel = 1 }
        if frame == 3 { channel = 2 }
        tint[channel] = 1.0
        color := float_bytes(&tint) or >>
        $encoder := device.command_encoder() or >>
        $pass := encoder.begin_render(gpu.ColorAttachment{view: target.view(0) or >>, load: gpu.CLEAR, store: gpu.STORE,
            clear: gpu.Color{r: 0.0, g: 0.0, b: 0.0, a: 1.0}}, gpu.no_depth()) or >>
        pass.pipeline(&pipeline) or >>
        pass.vertex_buffer(0, &vertex_buffer, 0) or >>
        pass.sampler(gpu.FRAGMENT, 0, &source, &sampler) or >>
        pass.uniform(gpu.VERTEX, 0, &matrix) or >>
        pass.uniform(gpu.FRAGMENT, 0, &color) or >>
        if frame == 3 {
            // Recording retains resources even after their CPU owners close.
            pipeline.close() or >>
            vertex_buffer.close() or >>
            source.close() or >>
            sampler.close() or >>
        }
        pass.draw(3, 0, 1, 0) or >>
        pass.end() or >>
        $submitted := encoder.submit() or >>
        submitted.close() or >>
        $result := device.download_texture(&target, 0) or >>
        result.wait() or >>
        $output := []u8{}
        for i in 0:140 { output.push(u8(0)) }
        result.read($&output) or >>
        // Matrix translation clips the entire triangle in frame 1. The
        // remaining frames independently exercise each color uniform channel.
        for i in 0:35 { for component in 0:4 {
            $expected := u8(0)
            if component == 3 { expected = u8(255)
            } else if frame != 1 && component == channel { expected = pixel[component] }
            assert(output[i*4+component] == expected)
        } }
        result.close() or >>
    }
    target.close() or >>
    stats := device.stats() or >>
    assert(stats.buffer_count == 0 && stats.buffer_bytes == 0 && stats.texture_count == 0 && stats.shader_count == 0 && stats.pipeline_count == 0 &&
        stats.sampler_count == 0 && stats.encoder_count == 0 && stats.render_pass_count == 0 && stats.submission_count == 0 && stats.staging_bytes == 0)
    device.close() or >>
    println("Standard GPU offscreen backend: " + name)
    println("Verified four dynamic vertex/matrix/tint GPU frames, exact 7x5 pixels and zero live resources")
    << 0
}
fn main() int { << run() or (err) { eprintln(err.msg())
    << 1 } }
