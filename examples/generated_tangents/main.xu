@main

light_data #"github.com/xulang-org/nexus/resources/lighting"

#gpu

gpu_info #"github.com/xulang-org/nexus/platform/gpu"

#window
window_events #window/events
mesh_shaders #"github.com/xulang-org/nexus/assets/shaders/three_d"

meshes #"github.com/xulang-org/nexus/resources/mesh"
ren #"github.com/xulang-org/nexus/rendering/three_d"
fm #"github.com/xulang-org/nexus/foundation/math"
camera #"github.com/xulang-org/nexus/scene"
colors #"github.com/xulang-org/nexus/foundation/color"
#os
#math
#strconv
#errors

// A curved grid has authored analytic normals and UVs, with no tangents.
fn curved_grid() meshes.MeshData3D {
    $mesh := meshes.new_mesh_data_3d()
    for row in 0:49 {
        y := f64(row) / 24.0 - 1.0
        for column in 0:49 {
            x := f64(column) / 24.0 - 1.0
            z := 0.12 * math.cos(x * 4.0) * math.cos(y * 4.0)
            dx := -0.48 * math.sin(x * 4.0) * math.cos(y * 4.0)
            dy := -0.48 * math.cos(x * 4.0) * math.sin(y * 4.0)
            mesh.vertex_lit_uv(fm.vec3(x, y, z), 4294967295, fm.vec3(-dx, -dy, 1.0),
                fm.vec2((x + 1.0) * 2.0, (y + 1.0) * 2.0)) >>>
        }
    }
    for row in 0:48 {
        for column in 0:48 {
            a := row * 49 + column
            mesh.triangle(a, a + 1, a + 50) >>>
            mesh.triangle(a, a + 50, a + 49) >>>
        }
    }
    assert((mesh.generate_tangents() >>>) == 0)
    << mesh
}
fn run() int {
    args := os.args()
    $frames := 0
    $capture := ""
    $shaders := "build/mesh-shaders"
    $i := 1
    while i < args.len {
        if i + 1 >= args.len { >>> errors.new("missing option value") }
        value := args[i + 1] + ""
        if args[i] == "--frames" {
            frames = strconv.atoi(&value) >>>
            if frames < 1 || frames > 1000000 { >>> errors.new("invalid frame count") }
        } else if args[i] == "--shaders" { shaders = value
        } else if args[i] == "--capture" { capture = value
        } else { >>> errors.new("unknown option") }
        i += 2
    }
    if capture.len > 0 && frames == 0 { >>> errors.new("capture requires bounded frames") }
    source := curved_grid() >>>
    mesh_program_0 := mesh_shaders.load_mesh(shaders + "") >>>
    $device := ren.open_3d("Xu generated tangents | left: geometric normal | right: normal map", 1000, 600, gpu.AUTO, &mesh_program_0) >>>
    println("Generated tangents GPU backend: " + gpu_info.backend_name(device.backend() >>>))
    $mesh := device.upload(&source) >>>
    $pixels := []int{}
    for y in 0:64 {
        for x in 0:64 {
            normal := fm.vec3(0.7 * math.sin(f64(x) / 64.0 * 2.0 * math.pi()),
                0.7 * math.sin(f64(y) / 64.0 * 2.0 * math.pi()), 1.0).normalized() >>>
            pixels.push(colors.rgba8(int((normal.x * 0.5 + 0.5) * 255.0),
                int((normal.y * 0.5 + 0.5) * 255.0), int((normal.z * 0.5 + 0.5) * 255.0), 255) >>>)
        }
    }
    $texture := device.texture_rgba(64, 64, &pixels, false, true, true) >>>
    zero := fm.vec3(0.0, 0.0, 0.0)
    base := ren.material_3d(fm.vec3(0.08, 0.42, 0.65), 0.25, 0.5, zero) >>>
    mapped := base.with_normal_texture(&texture, 1.5) >>>
    eye := fm.vec3(0.0, 0.0, 5.5)
    view := camera.look_at_3d(eye, zero, fm.vec3(0.0, 1.0, 0.0)) >>>
    light := light_data.environment(fm.vec3(0.08, 0.08, 0.08), eye, 1.0, [light_data.directional(fm.vec3(-0.4, 0.6, 1.0), fm.vec3(4.0, 4.0, 4.0)) >>>]) >>>
    $frame := 0
    $quit := false
    while !quit && (frames == 0 || frame < frames) {
        window.pump() >>>
        for poll in 0:256 {
            event := device.poll() >>>
            if event.kind == window_events.EVENT_NONE { <- }
            if event.kind == window_events.EVENT_CLOSE_REQUESTED || (event.kind == window_events.EVENT_KEY_DOWN && event.physical_key == window_events.KEY_ESCAPE) { quit = true }
        }
        if quit { <- }
        width := device.width() >>>
        height := device.height() >>>
        if width < 1 || height < 1 { sleep_ns(10000000)
            -> }
        vp := (camera.perspective_3d(0.8, f64(width) / f64(height), 0.1, 100.0) >>>).multiply(view)
        rotation := fm.rotation_y(0.2 * math.sin(f64(frame) * 0.01))
        device.begin(colors.rgba8(12, 18, 29, 255) >>>) >>>
        device.draw_material(&mesh, fm.translation_3d(fm.vec3(-1.2, 0.0, 0.0)).multiply(rotation), vp, &base, &light) >>>
        device.draw_material(&mesh, fm.translation_3d(fm.vec3(1.2, 0.0, 0.0)).multiply(rotation), vp, &mapped, &light) >>>
        if capture.len > 0 && frame == frames - 1 { device.capture(capture + "") >>> }
        device.present() >>>
        frame += 1
    }
    println("Finished " + str(frame) + " generated-tangent frames; CPU vertices=" + str(source.vertex_count()))
    << 0
}
fn main() int { << run() >>> (err) { eprintln(err.msg())
    << 1 } }
