@main

#gpu

gpu_info #"github.com/xulang-org/nexus/platform/gpu"

#window
window_events #window/events

canvas_shaders #"github.com/xulang-org/nexus/assets/shaders/two_d"

ren_data #"github.com/xulang-org/nexus/resources/canvas"

sprite_anim #"github.com/xulang-org/nexus/animation/sprite"
timing #"github.com/xulang-org/nexus/timing"
controls #"github.com/xulang-org/nexus/input"
ren #"github.com/xulang-org/nexus/rendering/two_d"
scene_render #"github.com/xulang-org/nexus/integration/rendering/two_d"
image_render #"github.com/xulang-org/nexus/integration/image_render/two_d"
images #"github.com/xulang-org/nexus/assets/image"
input_bridge #"github.com/xulang-org/nexus/integration/input"
colors #"github.com/xulang-org/nexus/foundation/color"
fm #"github.com/xulang-org/nexus/foundation/math"
nexus #"github.com/xulang-org/nexus/scene"
#os
#strconv
#errors
#math

struct Options {
    frames int
    backend int
    capture string
    shaders string
}
fn options() Options {
    args := os.args()
    $config := Options{frames: 0, backend: gpu.AUTO, capture: "", shaders: "build/canvas-shaders"}
    $i := 1
    while i < args.len {
        if i + 1 >= args.len { >> errors.new("missing option value") }
        next := i + 1
        if args[i] == "--frames" {
            config.frames = strconv.atoi(&args[next]) or >>
            if config.frames < 1 || config.frames > 1000000 { >> errors.new("frames outside 1...1000000") }
        } else if args[i] == "--shaders" { config.shaders = args[next] + ""
        } else if args[i] == "--capture" { config.capture = args[next] + ""
        } else if args[i] == "--backend" {
            name := args[next]
            if name == "metal" { config.backend = gpu.METAL
            } else if name == "vulkan" { config.backend = gpu.VULKAN
            } else if name == "d3d12" { config.backend = gpu.D3D12
            } else if name != "auto" { >> errors.new("unknown GPU backend") }
        } else { >> errors.new("unknown option: " + args[i]) }
        i = i + 2
    }
    if config.capture.len > 0 && config.frames == 0 { >> errors.new("capture requires bounded --frames") }
    << config
}
fn run() int {
    config := options() or >>
    // CPU image loading is independent of the window and GPU allocation.
    image := images.load_png("examples/arena/assets/player.png") or >>
    canvas_program_0 := canvas_shaders.load_canvas(config.shaders + "") or >>
    $renderer := ren.open_2d("Nexus Engine 2D | arrows: move | Space: pause | Esc: exit", 960, 640, config.backend, &canvas_program_0) or >>
    println("Layered 2D GPU backend: " + gpu_info.backend_name(renderer.backend() or >>))
    $atlas := image_render.upload_image_2d(&renderer, &image, false) or >>
    $tree := nexus.new_scene_tree("World", 64) or >>
    root := tree.root()
    $canvas := scene_render.new_canvas_2d()
    for row in 0:5 {
        for column in 0:9 {
            node := tree.add_child(root, "Tile_" + str(row * 9 + column)) or >>
            tree.set_position(node, fm.vec2(88.0 + f64(column) * 98.0, 110.0 + f64(row) * 98.0)) or >>
            $color := colors.rgba8(27, 49, 68, 255) or >>
            if (row + column) % 2 == 0 { color = colors.rgba8(35, 65, 82, 255) or >> }
            canvas.add_rect(node, fm.rect2(-43.0, -43.0, 86.0, 86.0), color) or >>
        }
    }
    actor := tree.add_child(root, "Player") or >>
    tree.set_position(actor, fm.vec2(480.0, 306.0)) or >>
    white := colors.rgba8(255, 255, 255, 255) or >>
    $sprite := scene_render.Sprite2D{node: actor, bounds: fm.rect2(-32.0, -32.0, 64.0, 64.0),
        region: fm.rect2(0.0, 0.0, 0.25, 1.0), tint: white}
    clip := sprite_anim.new_atlas_animation(4, 1, 0, 4, 8.0, true) or >>
    $animator := sprite_anim.new_sprite_animator(clip) or >>
    camera := nexus.new_camera_2d(960.0, 640.0) or >>
    $input := controls.new_input_map()
    input.bind("left", window_events.KEY_LEFT) or >>
    input.bind("right", window_events.KEY_RIGHT) or >>
    input.bind("up", window_events.KEY_UP) or >>
    input.bind("down", window_events.KEY_DOWN) or >>
    input.bind("pause", window_events.KEY_SPACE) or >>
    $clock := timing.new_clock(60, 8) or >>
    $last := now_ns()
    $frame := 0
    $quit := false
    $batch := ren_data.new_batch()
    $sprites := ren_data.new_batch()
    background := colors.rgba8(12, 20, 34, 255) or >>
    while !quit && (config.frames == 0 || frame < config.frames) {
        input.begin_frame()
        window.pump() or >>
        for i in 0:256 {
            event := renderer.poll() or >>
            if event.kind == window_events.EVENT_NONE { <- }
            if event.kind == window_events.EVENT_CLOSE_REQUESTED || (event.kind == window_events.EVENT_KEY_DOWN && event.physical_key == window_events.KEY_ESCAPE) { quit = true }
            input_bridge.apply_window_input($&input, &event) or >>
        }
        if quit { <- }
        if input.just_pressed("pause") or >> { tree.paused = !tree.paused }
        now := now_ns()
        $delta := f64(now - last) / 1000000000.0
        last = now
        if config.frames > 0 { delta = 1.0 / 60.0 }
        ticks := clock.advance(delta) or >>
        for step in 0:ticks.steps {
            if tree.can_process(actor) or >> {
                direction := input.vector("left", "right", "up", "down") or >>
                current := tree.node(actor) or >>
                moved := fm.vec2(current.transform.tx, current.transform.ty).add(direction.scaled(220.0 * ticks.fixed_delta))
                next := fm.vec2(math.max(40.0, math.min(920.0, moved.x)), math.max(40.0, math.min(600.0, moved.y)))
                tree.set_position(actor, next) or >>
                animator.advance(ticks.fixed_delta) or >>
            }
        }
        width := renderer.width() or >>
        height := renderer.height() or >>
        if width < 1 || height < 1 { sleep_ns(10000000)
            -> }
        view := camera.view_transform(f64(width), f64(height)) or >>
        viewport := camera.viewport(f64(width), f64(height)) or >>
        sprite.region = animator.region() or >>
        batch.clear()
        sprites.clear()
        canvas.record(&tree, view, $&batch) or >>
        sprite.record(&tree, view, $&sprites) or >>
        renderer.begin(background) or >>
        renderer.clip_rect(viewport) or >>
        renderer.submit(&batch) or >>
        renderer.submit_texture(&sprites, &atlas) or >>
        if config.capture.len > 0 && frame + 1 == config.frames { renderer.capture(config.capture + "") or >> }
        renderer.present() or >>
        frame = frame + 1
    }
    atlas.close() or >>
    renderer.close() or >>
    println("Finished " + str(frame) + " layered 2D frames")
    << 0
}
fn main() int { << run() or (err) { eprintln(err.msg())
    << 1 } }
