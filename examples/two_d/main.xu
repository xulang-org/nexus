@main

#gpu

gpu_info #"github.com/xulang-org/nexus/platform/gpu"

#window
window_events #window/events

canvas_shaders #"github.com/xulang-org/nexus/assets/shaders/two_d"

ren_data #"github.com/xulang-org/nexus/resources/canvas"

sprite_anim #"github.com/xulang-org/nexus/animation/sprite"
timing #"github.com/xulang-org/nexus/timing"
controls #"github.com/xulang-org/nexus/input"
ren #"github.com/xulang-org/nexus/rendering/two_d"
scene_render #"github.com/xulang-org/nexus/integration/rendering/two_d"
files #"github.com/xulang-org/nexus/integration/scene"
image_render #"github.com/xulang-org/nexus/integration/image_render/two_d"
images #"github.com/xulang-org/nexus/assets/image"
input_bridge #"github.com/xulang-org/nexus/integration/input"
colors #"github.com/xulang-org/nexus/foundation/color"
fm #"github.com/xulang-org/nexus/foundation/math"
nexus #"github.com/xulang-org/nexus/scene"
#os
#strconv
#errors
#math

struct Options {
    frames int
    backend int
    capture string
    shaders string
    camera_scene string
}
fn options() Options {
    args := os.args()
    $config := Options{frames: 0, backend: gpu.AUTO, capture: "", shaders: "build/canvas-shaders", camera_scene: ""}
    $i := 1
    while i < args.len {
        if i + 1 >= args.len { >>> errors.new("missing option value") }
        next := i + 1
        if args[i] == "--frames" {
            config.frames = strconv.atoi(&args[next]) >>>
            if config.frames < 1 || config.frames > 1000000 { >>> errors.new("frames outside 1...1000000") }
        } else if args[i] == "--shaders" { config.shaders = args[next] + ""
        } else if args[i] == "--capture" { config.capture = args[next] + ""
        } else if args[i] == "--camera-scene" { config.camera_scene = args[next] + ""
        } else if args[i] == "--backend" {
            name := args[next]
            if name == "metal" { config.backend = gpu.METAL
            } else if name == "vulkan" { config.backend = gpu.VULKAN
            } else if name == "d3d12" { config.backend = gpu.D3D12
            } else if name != "auto" { >>> errors.new("unknown GPU backend") }
        } else { >>> errors.new("unknown option: " + args[i]) }
        i = i + 2
    }
    if config.capture.len > 0 && config.frames == 0 { >>> errors.new("capture requires bounded --frames") }
    << config
}
fn camera_from_scene(path string) nexus.Camera2D {
    if path.len == 0 { << nexus.new_camera_2d(960.0, 640.0) >>> }
    document := files.load(path) >>>
    $rig := nexus.new_scene_tree("CameraWorld", document.node_count() + 1) >>>
    root := rig.root()
    packed := files.to_packed_nodes(&document) >>>
    instance := packed.instantiate($&rig, root, "CameraRig") >>>
    node := rig.find_node(instance, "Camera2D") >>>
    << nexus.new_camera_node_2d(&rig, node) >>>
}
fn run() int {
    config := options() >>>
    camera := camera_from_scene(config.camera_scene + "") >>>
    // CPU image loading is independent of the window and GPU allocation.
    image := images.load_png("examples/arena/assets/player.png") >>>
    canvas_program_0 := canvas_shaders.load_canvas(config.shaders + "") >>>
    $renderer := ren.open_2d("Nexus Engine 2D | arrows: move | Space: pause | Esc: exit", 960, 640, config.backend, &canvas_program_0) >>>
    println("Layered 2D GPU backend: " + gpu_info.backend_name(renderer.backend() >>>))
    $atlas := image_render.upload_image_2d(&renderer, &image, false) >>>
    $tree := nexus.new_scene_tree("World", 64) >>>
    root := tree.root()
    $canvas := scene_render.new_canvas_2d()
    for row in 0:5 {
        for column in 0:9 {
            node := tree.add_child(root, "Tile_" + str(row * 9 + column)) >>>
            tree.set_position(node, fm.vec2(88.0 + f64(column) * 98.0, 110.0 + f64(row) * 98.0)) >>>
            $color := colors.rgba8(27, 49, 68, 255) >>>
            if (row + column) % 2 == 0 { color = colors.rgba8(35, 65, 82, 255) >>> }
            canvas.add_rect(node, fm.rect2(-43.0, -43.0, 86.0, 86.0), color) >>>
        }
    }
    actor := tree.add_child(root, "Player") >>>
    tree.set_position(actor, fm.vec2(480.0, 306.0)) >>>
    white := colors.rgba8(255, 255, 255, 255) >>>
    $sprite := scene_render.Sprite2D{node: actor, bounds: fm.rect2(-32.0, -32.0, 64.0, 64.0),
        region: fm.rect2(0.0, 0.0, 0.25, 1.0), tint: white}
    clip := sprite_anim.new_atlas_animation(4, 1, 0, 4, 8.0, true) >>>
    $animator := sprite_anim.new_sprite_animator(clip) >>>
    $input := controls.new_input_map()
    input.bind("left", window_events.KEY_LEFT) >>>
    input.bind("right", window_events.KEY_RIGHT) >>>
    input.bind("up", window_events.KEY_UP) >>>
    input.bind("down", window_events.KEY_DOWN) >>>
    input.bind("pause", window_events.KEY_SPACE) >>>
    $clock := timing.new_clock(60, 8) >>>
    $last := now_ns()
    $frame := 0
    $quit := false
    $batch := ren_data.new_batch()
    $sprites := ren_data.new_batch()
    background := colors.rgba8(12, 20, 34, 255) >>>
    while !quit && (config.frames == 0 || frame < config.frames) {
        input.begin_frame()
        window.pump() >>>
        for i in 0:256 {
            event := renderer.poll() >>>
            if event.kind == window_events.EVENT_NONE { <- }
            if event.kind == window_events.EVENT_CLOSE_REQUESTED || (event.kind == window_events.EVENT_KEY_DOWN && event.physical_key == window_events.KEY_ESCAPE) { quit = true }
            input_bridge.apply_window_input($&input, &event) >>>
        }
        if quit { <- }
        if input.just_pressed("pause") >>> { tree.paused = !tree.paused }
        now := now_ns()
        $delta := f64(now - last) / 1000000000.0
        last = now
        if config.frames > 0 { delta = 1.0 / 60.0 }
        ticks := clock.advance(delta) >>>
        for step in 0:ticks.steps {
            if tree.can_process(actor) >>> {
                direction := input.vector("left", "right", "up", "down") >>>
                current := tree.node(actor) >>>
                moved := fm.vec2(current.transform.tx, current.transform.ty).add(direction.scaled(220.0 * ticks.fixed_delta))
                next := fm.vec2(math.max(40.0, math.min(920.0, moved.x)), math.max(40.0, math.min(600.0, moved.y)))
                tree.set_position(actor, next) >>>
                animator.advance(ticks.fixed_delta) >>>
            }
        }
        width := renderer.width() >>>
        height := renderer.height() >>>
        if width < 1 || height < 1 { sleep_ns(10000000)
            -> }
        view := camera.view_transform(f64(width), f64(height)) >>>
        viewport := camera.viewport(f64(width), f64(height)) >>>
        sprite.region = animator.region() >>>
        batch.clear()
        sprites.clear()
        canvas.record(&tree, view, $&batch) >>>
        sprite.record(&tree, view, $&sprites) >>>
        renderer.begin(background) >>>
        renderer.clip_rect(viewport) >>>
        renderer.submit(&batch) >>>
        renderer.submit_texture(&sprites, &atlas) >>>
        if config.capture.len > 0 && frame + 1 == config.frames { renderer.capture(config.capture + "") >>> }
        renderer.present() >>>
        frame = frame + 1
    }
    atlas.close() >>>
    renderer.close() >>>
    println("Finished " + str(frame) + " layered 2D frames")
    << 0
}
fn main() int { << run() >>> (err) { eprintln(err.msg())
    << 1 } }
