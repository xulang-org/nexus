@main

light_data #"github.com/xulang-org/game/resources/lighting"

#gpu

gpu_info #"github.com/xulang-org/game/platform/gpu"

#window
window_events #window/events
mesh_shaders #"github.com/xulang-org/game/assets/shaders/three_d"

meshes #"github.com/xulang-org/game/resources/mesh"

timing #"github.com/xulang-org/game/timing"
controls #"github.com/xulang-org/game/input"
ren #"github.com/xulang-org/game/rendering/three_d"
fm #"github.com/xulang-org/game/foundation/math"
scene_render #"github.com/xulang-org/game/integration/rendering/three_d"
input_bridge #"github.com/xulang-org/game/integration/input"
images #"github.com/xulang-org/game/resources/image"
image_render #"github.com/xulang-org/game/integration/image_render/three_d"
game #"github.com/xulang-org/game/scene"
#os
#strconv
#errors
#math

fn checker_image() images.ImageRGBA8 {
    $pixels := []int{}
    for y in 0:128 {
        for x in 0:128 {
            $color := 4294967295
            if (x / 8 + y / 8) % 2 == 0 { color = 255 }
            pixels.push(color)
        }
    }
    << images.ImageRGBA8{width: 128, height: 128, pixels: pixels}
}
fn ground_mesh() meshes.MeshData3D {
    $mesh := meshes.new_mesh_data_3d()
    positions := [fm.vec3(-1.0, 0.0, 3.0), fm.vec3(1.0, 0.0, 3.0), fm.vec3(1.0, 0.0, -60.0), fm.vec3(-1.0, 0.0, -60.0)]
    uvs := [fm.vec2(0.0, 0.0), fm.vec2(2.0, 0.0), fm.vec2(2.0, 64.0), fm.vec2(0.0, 64.0)]
    for i in 0:4 { mesh.vertex_lit_uv(positions[i], 4294967295, fm.vec3(0.0, 1.0, 0.0), uvs[i]) or >> }
    mesh.triangle(0, 1, 2) or >>
    mesh.triangle(0, 2, 3) or >>
    << mesh
}
fn run() int {
    args := os.args()
    $frames := 0
    $capture := ""
    $shaders := "build/mesh-shaders"
    $i := 1
    while i < args.len {
        if i + 1 >= args.len { >> errors.new("missing option value") }
        value := args[i + 1] + ""
        if args[i] == "--frames" { frames = strconv.atoi(&value) or >>
            if frames < 1 || frames > 1000000 { >> errors.new("invalid frame count") }
        } else if args[i] == "--shaders" { shaders = value
        } else if args[i] == "--capture" { capture = value
        } else { >> errors.new("unknown option") }
        i = i + 2
    }
    if capture.len > 0 && frames == 0 { >> errors.new("capture requires bounded frames") }
    mesh_program_0 := mesh_shaders.load_mesh(shaders + "") or >>
    $device := ren.open_3d("Xu mipmaps | left: no mip | middle: nearest mip | right: trilinear | Up/Down: distance | Space: pause | Esc: quit", 1200, 720, gpu.AUTO, &mesh_program_0) or >>
    println("Mipmap GPU backend: " + gpu_info.backend_name(device.backend() or >>))
    image := checker_image()
    source := ground_mesh() or >>
    $mesh := device.upload(&source) or >>
    $textures := []ren.Texture3D{}
    $materials := []ren.Material3D{}
    zero := fm.vec3(0.0, 0.0, 0.0)
    white := fm.vec3(1.0, 1.0, 1.0)
    base := ren.material_3d(white, 0.0, 1.0, zero) or >>
    for mip in [ren.MIP_NONE, ren.MIP_NEAREST, ren.MIP_LINEAR] {
        sampling := ren.TextureSampling3D{min_linear: true, mag_linear: true, repeat_u: true, repeat_v: true, mip_filter: mip}
        $texture := image_render.upload_image_3d_sampled(&device, &image, true, sampling) or >>
        println("Mip mode=" + str(mip) + " levels=" + str(texture.mip_levels() or >>) + " texel bytes=" + str(texture.storage_bytes() or >>))
        materials.push(base.with_base_texture(&texture) or >>)
        textures.push(texture)
    }
    $tree := game.new_scene_tree_3d("Mipmap comparison", 16) or >>
    $scene := scene_render.new_scene_3d(&device) or >>
    for column in 0:3 {
        node := tree.add_child_3d(tree.root(), "Lane" + str(column)) or >>
        tree.set_position_3d(node, fm.vec3((f64(column) - 1.0) * 2.4, 0.0, 0.0)) or >>
        scene.attach_mesh(&tree, node, &mesh) or >>
        scene.set_material(&tree, node, materials[column]) or >>
    }
    $input := controls.new_input_map()
    input.bind("closer", window_events.KEY_UP) or >>
    input.bind("farther", window_events.KEY_DOWN) or >>
    input.bind("pause", window_events.KEY_SPACE) or >>
    input.bind("quit", window_events.KEY_ESCAPE) or >>
    $phase := 0.0
    $distance := 8.0
    $paused := false
    $quit := false
    $frame := 0
    $last := now_ns()
    $clock := timing.new_clock(60, 8) or >>
    camera := game.new_camera_3d()
    while !quit && (frames == 0 || frame < frames) {
        input.begin_frame()
        window.pump() or >>
        for poll in 0:256 {
            event := device.poll() or >>
            if event.kind == window_events.EVENT_NONE { <- }
            if event.kind == window_events.EVENT_CLOSE_REQUESTED { quit = true }
            input_bridge.apply_window_input($&input, &event) or >>
        }
        if input.just_pressed("quit") or >> { quit = true }
        if quit { <- }
        if input.just_pressed("pause") or >> { paused = !paused }
        now := now_ns()
        $delta := f64(now - last) / 1000000000.0
        last = now
        if frames > 0 { delta = 1.0 / 60.0 }
        ticks := clock.advance(delta) or >>
        for tick in 0:ticks.steps {
            if !paused { phase = phase + ticks.fixed_delta * 0.8 }
            distance = distance + (input.axis("closer", "farther") or >>) * ticks.fixed_delta * 3.0
            if distance < 5.0 { distance = 5.0 }
            if distance > 18.0 { distance = 18.0 }
        }
        eye := fm.vec3(math.sin(phase) * 0.15, 3.2, distance + math.sin(phase * 0.7) * 0.7)
        view := game.look_at_3d(eye, fm.vec3(0.0, 0.0, -14.0), fm.vec3(0.0, 1.0, 0.0)) or >>
        width := device.width() or >>
        height := device.height() or >>
        if width < 1 || height < 1 { sleep_ns(10000000)
            -> }
        vp := (game.perspective_3d(camera.vertical_fov, f64(width) / f64(height), camera.near, camera.far) or >>).multiply(view)
        lighting := light_data.environment(white, eye, 1.0, [light_data.directional(fm.vec3(0.0, 1.0, 0.0), zero) or >>]) or >>
        device.begin(202513919) or >>
        draws := scene.draw_lit($&device, &tree, vp, &lighting) or >>
        assert((draws.instances+draws.culled_instances) == 3 && (draws.triangles+draws.culled_triangles) == 6)
        if capture.len > 0 && frame + 1 == frames { device.capture(capture + "") or >> }
        device.present() or >>
        frame = frame + 1
    }
    device.close() or >>
    println("Finished " + str(frame) + " mipmap frames; 3 perspective lanes share one mesh and source image")
    << 0
}
fn main() int { << run() or (err) { eprintln(err.msg())
    << 1 } }
