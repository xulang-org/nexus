@"github.com/xulang-org/nexus/physics3d"

fm #"github.com/xulang-org/nexus/foundation/math"
#errors

pub struct StaticBox3D {
    pub bounds fm.Aabb3
    pub layer int
    pub trigger bool
}
pub struct StaticWorld3D {
    boxes []StaticBox3D
}
pub struct CharacterMotion3D {
    pub motion MotionResult3D
    pub grounded bool
    pub stepped bool
    pub triggers []int
}

fn check_static_boxes(boxes &[]StaticBox3D) int {
    if boxes.len > MAX_COLLIDERS { >>> errors.new("nexus physics3d: static world budget exceeded") }
    for box in boxes {
        check_box(box.bounds) >>>
        if box.layer <= 0 || box.layer > 0x7fffffff { >>> errors.new("nexus physics3d: invalid collision layer") }
    }
    << 0
}
pub fn new_static_world(boxes []StaticBox3D) StaticWorld3D {
    check_static_boxes(&boxes) >>>
    << StaticWorld3D{boxes: boxes}
}
fn check_mask(mask int) int {
    if mask < 0 || mask > 0x7fffffff { >>> errors.new("nexus physics3d: invalid collision mask") }
    << 0
}
pub fn (world &StaticWorld3D) overlap_triggers(body fm.Aabb3, mask int) []int {
    check_box(body) >>>
    check_mask(mask) >>>
    $overlaps := []int{}
    for i in 0:world.boxes.len {
        box := world.boxes[i]
        if box.trigger && (box.layer & mask) != 0 && intersects_open(body, box.bounds) { overlaps.push(i) }
    }
    << overlaps
}
fn supported(body fm.Aabb3, probe f64, solids &[]fm.Aabb3) bool {
    contact := nearest_contact(body, fm.vec3(0.0, -probe, 0.0), solids)
    << contact.normals.y > 0.0
}
fn horizontal_progress(body fm.Aabb3, origin fm.Aabb3, direction fm.Vec3) f64 {
    delta := body.minimum.sub(origin.minimum)
    << delta.x * direction.x + delta.z * direction.z
}
fn try_step(body fm.Aabb3, motion fm.Vec3, height f64, probe f64, solids &[]fm.Aabb3,
    direct MotionResult3D) MotionResult3D {
    raised := move_and_slide(body, fm.vec3(0.0, height, 0.0), solids) >>>
    if raised.on_ceiling { << direct }
    planar := fm.vec3(motion.x, 0.0, motion.z)
    across := move_and_slide(raised.bounds, planar, solids) >>>
    landing := move_and_slide(across.bounds, fm.vec3(0.0, -height - probe, 0.0), solids) >>>
    elevation := landing.bounds.minimum.y - body.minimum.y
    if !landing.on_floor || elevation <= 0.0 || elevation > height ||
        horizontal_progress(landing.bounds, body, planar) <= horizontal_progress(direct.bounds, body, planar) {
        << direct
    }
    << MotionResult3D{bounds: landing.bounds, travelled: landing.bounds.minimum.sub(body.minimum),
        collisions: across.collisions + landing.collisions, on_floor: true, on_wall: across.on_wall, on_ceiling: false}
}

// Query one character against masked static geometry. Trigger IDs are stable
// indexes in this world. Trigger overlaps sample the final bounds of this step.
pub fn (world &StaticWorld3D) move_character(body fm.Aabb3, motion fm.Vec3, solid_mask int,
    trigger_mask int, step_height f64, ground_probe f64) CharacterMotion3D {
    check_mask(solid_mask) >>>
    check_mask(trigger_mask) >>>
    if !fm.finite(step_height) || step_height < 0.0 || step_height >= body.maximum.y - body.minimum.y ||
        !fm.finite(ground_probe) || ground_probe <= 0.0 || ground_probe > 0.25 {
        >>> errors.new("nexus physics3d: invalid step height or floor probe")
    }
    $solids := []fm.Aabb3{}
    for box in world.boxes {
        if !box.trigger && (box.layer & solid_mask) != 0 { solids.push(box.bounds) }
    }
    $moved := move_and_slide(body, motion, &solids) >>>
    $stepped := false
    if moved.on_wall && motion.y <= 0.0 && step_height > 0.0 && supported(body, ground_probe, &solids) {
        candidate := try_step(body, motion, step_height, ground_probe, &solids, moved) >>>
        stepped = candidate.bounds.minimum.y > moved.bounds.minimum.y
        moved = candidate
    }
    grounded := motion.y <= 0.0 && (moved.on_floor || supported(moved.bounds, ground_probe, &solids))
    triggers := world.overlap_triggers(moved.bounds, trigger_mask) >>>
    << CharacterMotion3D{motion: moved, grounded: grounded, stepped: stepped, triggers: triggers}
}
