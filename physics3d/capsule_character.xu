@"github.com/xulang-org/nexus/physics3d"

fm #"github.com/xulang-org/nexus/foundation/math"
#errors
#math

pub struct CapsuleWorld3D {
    boxes []StaticBox3D
    ramps []StaticRamp3D
    triangles []StaticTriangle3D
}

pub struct CapsuleController3D {
    pub solid_mask int
    pub trigger_mask int
    pub step_height f64
    pub ground_snap f64
    pub min_floor_y f64
}

pub struct CapsuleMotion3D {
    pub body Capsule3D
    pub travelled fm.Vec3
    pub collisions int
    pub grounded bool
    pub floor_normal fm.Vec3
    pub floor_ramp int
    pub floor_triangle int
    pub on_wall bool
    pub on_ceiling bool
    pub stepped bool
    pub triggers []int
}

pub fn new_capsule_mesh_world(boxes []StaticBox3D, ramps []StaticRamp3D, triangles []StaticTriangle3D) CapsuleWorld3D {
    if boxes.len + ramps.len + triangles.len > MAX_COLLIDERS { >> errors.new("nexus physics3d: static capsule world budget exceeded") }
    check_static_boxes(&boxes) or >>
    for ramp in ramps {
        check_ramp(ramp) or >>
        if ramp.layer <= 0 || ramp.layer > 0x7fffffff { >> errors.new("nexus physics3d: invalid ramp collision layer") }
    }
    for tri in triangles { check_triangle(tri) or >> }
    << CapsuleWorld3D{boxes: boxes, ramps: ramps, triangles: triangles}
}

pub fn new_capsule_world(boxes []StaticBox3D, ramps []StaticRamp3D) CapsuleWorld3D {
    << new_capsule_mesh_world(boxes, ramps, []StaticTriangle3D{}) or >>
}

struct CapsuleContact {
    sweep SweepHit3D
    ramp int
    triangle int
}

fn no_capsule_contact() CapsuleContact { << CapsuleContact{sweep: capsule_miss(), ramp: -1, triangle: -1} }

fn nearest_capsule(world &CapsuleWorld3D, body Capsule3D, motion fm.Vec3, solid_mask int) CapsuleContact {
    $nearest := no_capsule_contact()
    for box in world.boxes {
        if box.trigger || (box.layer & solid_mask) == 0 { -> }
        hit := sweep_hull(body, motion, capsule_hull(box.bounds, 0, body.half_segment)) or >>
        if hit.started_overlapping { >> errors.new("nexus physics3d: capsule overlaps a static box") }
        if hit.hit && (!nearest.sweep.hit || hit.time < nearest.sweep.time) {
            nearest = CapsuleContact{sweep: hit, ramp: -1, triangle: -1}
        }
    }
    for i in 0:world.ramps.len {
        ramp := world.ramps[i]
        if (ramp.layer & solid_mask) == 0 { -> }
        hit := sweep_hull(body, motion, capsule_hull(ramp.bounds, ramp.direction, body.half_segment)) or >>
        if hit.started_overlapping { >> errors.new("nexus physics3d: capsule overlaps a static ramp") }
        if hit.hit && (!nearest.sweep.hit || hit.time < nearest.sweep.time) {
            nearest = CapsuleContact{sweep: hit, ramp: i, triangle: -1}
        }
    }
    for i in 0:world.triangles.len {
        tri := world.triangles[i]
        if (tri.layer & solid_mask) == 0 { -> }
        hit := sweep_capsule_triangle_unchecked(body, motion, tri) or >>
        if hit.started_overlapping { >> errors.new("nexus physics3d: capsule overlaps a static triangle") }
        if hit.hit && (!nearest.sweep.hit || hit.time < nearest.sweep.time) {
            nearest = CapsuleContact{sweep: hit, ramp: -1, triangle: i}
        }
    }
    << nearest
}

pub fn (world &CapsuleWorld3D) overlap_capsule_triggers(body Capsule3D, mask int) []int {
    body.bounds() or >>
    check_mask(mask) or >>
    $overlaps := []int{}
    for i in 0:world.boxes.len {
        box := world.boxes[i]
        if !box.trigger || (box.layer & mask) == 0 { -> }
        delta := hull_delta(body.center, capsule_hull(box.bounds, 0, body.half_segment))
        radius := body.radius - contact_epsilon()
        if delta.dot(delta) < radius * radius { overlaps.push(i) }
    }
    << overlaps
}

struct CapsuleSlide {
    body Capsule3D
    collisions int
    wall bool
    ceiling bool
    step_wall bool
}

fn plane_slide(motion fm.Vec3, normal fm.Vec3, floor_y f64) fm.Vec3 {
    into := motion.dot(normal)
    if into >= 0.0 { << motion }
    if normal.y >= floor_y {
        // Preserve the commanded horizontal motion on a walkable floor.
        // Adjust only Y so gravity alone never drifts down a walkable slope.
        << fm.vec3(motion.x, motion.y - into / normal.y, motion.z)
    }
    $next := motion
    if normal.y > 0.0 {
        // Remove uphill input on a steep slope, then allow a falling
        // capsule to slide downhill under its vertical motion.
        side := fm.vec3(normal.x, 0.0, normal.z).normalized() or >>
        uphill := next.dot(side)
        if uphill < 0.0 { next = next.sub(side.scaled(uphill)) }
    }
    rest := next.dot(normal)
    if rest < 0.0 { next = next.sub(normal.scaled(rest)) }
    << next
}

fn slide_capsule(world &CapsuleWorld3D, body Capsule3D, motion fm.Vec3, policy CapsuleController3D) CapsuleSlide {
    body.bounds() or >>
    advance_capsule(body, motion).bounds() or >>
    $current := body
    $remaining := motion
    $wall := false
    $ceiling := false
    $step_wall := false
    $collisions := 0
    for pass in 0:8 {
        contact := nearest_capsule(world, current, remaining, policy.solid_mask) or >>
        hit := contact.sweep
        if !hit.hit {
            current = advance_capsule(current, remaining)
            <-
        }
        current = advance_capsule(current, remaining.scaled(hit.time))
        leftover := remaining.scaled(1.0 - hit.time)
        remaining = plane_slide(leftover, hit.normal, policy.min_floor_y) or >>
        ceiling = ceiling || hit.normal.y <= -policy.min_floor_y
        wall_contact := hit.normal.y < policy.min_floor_y && hit.normal.y > -policy.min_floor_y
        wall = wall || wall_contact
        step_wall = step_wall || (wall_contact && contact.ramp < 0 && contact.triangle < 0)
        collisions += 1
        if remaining.dot(remaining) <= 0.0000000000000001 { <- }
        advance_capsule(current, remaining).bounds() or >>
    }
    current.bounds() or >>
    nearest_capsule(world, current, zero(), policy.solid_mask) or >>
    << CapsuleSlide{body: current, collisions: collisions, wall: wall, ceiling: ceiling, step_wall: step_wall}
}

fn floor_cast(world &CapsuleWorld3D, body Capsule3D, distance f64, policy CapsuleController3D) CapsuleContact {
    down := fm.vec3(0.0, -distance, 0.0)
    if !valid_point(capsule_aabb(body).minimum.add(down)) { << no_capsule_contact() }
    contact := nearest_capsule(world, body, down, policy.solid_mask) or >>
    if !contact.sweep.hit || contact.sweep.normal.y < policy.min_floor_y { << no_capsule_contact() }
    << contact
}

fn step_landing(world &CapsuleWorld3D, body Capsule3D, raised Capsule3D, flat fm.Vec3, policy CapsuleController3D,
    direct CapsuleSlide) CapsuleSlide {
    endpoint := capsule_aabb(advance_capsule(raised, flat))
    if !valid_point(endpoint.minimum) || !valid_point(endpoint.maximum) { << direct }
    across := slide_capsule(world, raised, flat, policy) or >>
    distance := policy.step_height + policy.ground_snap
    floor := floor_cast(world, across.body, distance, policy) or >>
    if !floor.sweep.hit { << direct }
    landed := advance_capsule(across.body, fm.vec3(0.0, -distance * floor.sweep.time, 0.0))
    elevation := landed.center.y - body.center.y
    if elevation <= contact_epsilon() || elevation > policy.step_height + contact_epsilon() ||
        landed.center.y <= direct.body.center.y + contact_epsilon() ||
        landed.center.sub(direct.body.center).dot(flat) <= contact_epsilon() * flat.length() {
        << direct
    }
    << CapsuleSlide{body: landed, collisions: across.collisions + 1, wall: across.wall, ceiling: false, step_wall: false}
}

fn capsule_step(world &CapsuleWorld3D, body Capsule3D, motion fm.Vec3, policy CapsuleController3D,
    direct CapsuleSlide) CapsuleSlide {
    up := fm.vec3(0.0, policy.step_height, 0.0)
    flat := fm.vec3(motion.x, 0.0, motion.z)
    if flat.length() <= contact_epsilon() { << direct }
    raised := advance_capsule(body, up)
    if !valid_point(capsule_aabb(raised).maximum) { << direct }
    blocker := nearest_capsule(world, body, up, policy.solid_mask) or >>
    if blocker.sweep.hit { << direct }
    attempt := step_landing(world, body, raised, flat, policy, direct) or >>
    if attempt.body.center.y > direct.body.center.y { << attempt }

    // A short frame can stop over the rounded lip before the cap reaches a
    // walkable landing. Allow a bounded forward assist along the same input.
    // The full assisted path and its vertical landing are still swept.
    extra := math.min(body.radius * 0.5, policy.step_height)
    direction := flat.normalized() or >>
    << step_landing(world, body, raised, flat.add(direction.scaled(extra)), policy, direct) or >>
}

pub fn (world &CapsuleWorld3D) move_capsule(body Capsule3D, motion fm.Vec3, policy CapsuleController3D) CapsuleMotion3D {
    check_mask(policy.solid_mask) or >>
    check_mask(policy.trigger_mask) or >>
    body.bounds() or >>
    if !fm.finite(policy.step_height) || policy.step_height < 0.0 || policy.step_height >= (body.radius + body.half_segment) * 2.0 ||
        !fm.finite(policy.ground_snap) || policy.ground_snap < contact_epsilon() * 4.0 || policy.ground_snap > 0.25 ||
        !fm.finite(policy.min_floor_y) || policy.min_floor_y < 0.1 || policy.min_floor_y > 1.0 {
        >> errors.new("nexus physics3d: invalid capsule step, floor snap or slope limit")
    }
    $moved := slide_capsule(world, body, motion, policy) or >>
    $stepped := false
    $grounded := false
    $floor_normal := zero()
    $floor_ramp := -1
    $floor_triangle := -1
    if motion.y <= 0.0 {
        before := floor_cast(world, body, policy.ground_snap, policy) or >>
        if before.sweep.hit && moved.step_wall && policy.step_height > 0.0 {
            candidate := capsule_step(world, body, motion, policy, moved) or >>
            stepped = candidate.body.center.y > moved.body.center.y
            moved = candidate
        }
        $probe := contact_epsilon() * 4.0
        if before.sweep.hit { probe = policy.ground_snap }
        floor := floor_cast(world, moved.body, probe, policy) or >>
        if floor.sweep.hit {
            moved.body = advance_capsule(moved.body, fm.vec3(0.0, -probe * floor.sweep.time, 0.0))
            grounded = true
            floor_normal = floor.sweep.normal
            floor_ramp = floor.ramp
            floor_triangle = floor.triangle
        }
    }
    moved.body.bounds() or >>
    nearest_capsule(world, moved.body, zero(), policy.solid_mask) or >>
    triggers := world.overlap_capsule_triggers(moved.body, policy.trigger_mask) or >>
    << CapsuleMotion3D{body: moved.body, travelled: moved.body.center.sub(body.center), collisions: moved.collisions,
        grounded: grounded, floor_normal: floor_normal, floor_ramp: floor_ramp, floor_triangle: floor_triangle,
        on_wall: moved.wall, on_ceiling: moved.ceiling, stepped: stepped, triggers: triggers}
}
