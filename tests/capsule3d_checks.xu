@main

fm #"github.com/xulang-org/nexus/foundation/math"
p #"github.com/xulang-org/nexus/physics3d"
#math

fn box(x f64, y f64, z f64, xx f64, yy f64, zz f64) fm.Aabb3 {
    << fm.Aabb3{minimum: fm.vec3(x, y, z), maximum: fm.vec3(xx, yy, zz)}
}
fn solid(bounds fm.Aabb3) p.StaticBox3D {
    << p.StaticBox3D{bounds: bounds, layer: 1, trigger: false}
}
fn near(a f64, b f64) bool { << math.abs(a - b) < 0.000002 }

fn sweeps() int {
    capsule := p.capsule_3d(fm.vec3(0.0, 0.6, 0.0), 0.5, 0.1) >>>
    thin := box(2.25, -1.0, -1.0, 2.25001, 3.0, 1.0)
    fast := p.sweep_capsule_box(capsule, fm.vec3(100.0, 0.0, 0.0), thin) >>>
    assert(fast.hit && !fast.started_overlapping && near(fast.time, 0.0175) && near(fast.normal.x, -1.0))
    endpoint := p.sweep_capsule_box(capsule, fm.vec3(1.75, 0.0, 0.0), thin) >>>
    assert(endpoint.hit && near(endpoint.time, 1.0))
    block := box(0.0, -1.0, 0.0, 1.0, 2.0, 1.0)
    diagonal := p.capsule_3d(fm.vec3(-2.0, 0.6, -2.0), 0.5, 0.1) >>>
    corner := p.sweep_capsule_box(diagonal, fm.vec3(3.0, 0.0, 3.0), block) >>>
    assert(corner.hit && near(corner.time, (2.0 - 0.5 / math.sqrt(2.0)) / 3.0))
    assert(near(corner.normal.x, -math.sqrt(0.5)) && near(corner.normal.z, -math.sqrt(0.5)))
    tangent := p.capsule_3d(fm.vec3(-1.0, 0.6, -0.5), 0.5, 0.1) >>>
    assert(!(p.sweep_capsule_box(tangent, fm.vec3(3.0, 0.0, 0.0), block) >>>).hit)
    overlap := p.sweep_capsule_box(capsule, fm.vec3(-1.0, 0.0, -1.0), block) >>>
    assert(overlap.hit && overlap.started_overlapping && overlap.time == 0.0)
    // A slow vertical component must still hit during a long horizontal cast.
    above := p.capsule_3d(fm.vec3(0.0, 0.6005, 0.0), 0.5, 0.1) >>>
    vast := box(-1.0, -1.0, -1.0, 400000000.0, 0.0, 1.0)
    shallow := p.sweep_capsule_box(above, fm.vec3(200000000.0, -0.01, 0.0), vast) >>>
    assert(shallow.hit && near(shallow.time, 0.05) && near(shallow.normal.y, 1.0))
    << 0
}

fn ramp_sweeps() int {
    body := p.capsule_3d(fm.vec3(0.0, 3.0, 0.0), 0.5, 0.35) >>>
    bounds := box(-2.0, 0.0, -2.0, 2.0, 1.0, 2.0)
    normalization := math.sqrt(1.0 + 0.25 * 0.25)
    wanted_height := 0.5 + 0.35 + 0.5 * normalization
    wanted_time := (3.0 - wanted_height) / 3.0
    for direction in [p.RAMP_POSITIVE_X, p.RAMP_NEGATIVE_X, p.RAMP_POSITIVE_Z, p.RAMP_NEGATIVE_Z] {
        ramp := p.StaticRamp3D{bounds: bounds, direction: direction, layer: 1}
        hit := p.sweep_capsule_ramp(body, fm.vec3(0.0, -3.0, 0.0), ramp) >>>
        assert(hit.hit && near(hit.time, wanted_time) && near(hit.normal.y, 1.0 / normalization))
        if direction == p.RAMP_POSITIVE_X { assert(near(hit.normal.x, -0.25 / normalization)) }
        if direction == p.RAMP_NEGATIVE_X { assert(near(hit.normal.x, 0.25 / normalization)) }
        if direction == p.RAMP_POSITIVE_Z { assert(near(hit.normal.z, -0.25 / normalization)) }
        if direction == p.RAMP_NEGATIVE_Z { assert(near(hit.normal.z, 0.25 / normalization)) }
    }
    ramp := p.StaticRamp3D{bounds: bounds, direction: p.RAMP_NEGATIVE_Z, layer: 1}
    outside := p.capsule_3d(fm.vec3(2.51, 3.0, 0.0), 0.5, 0.35) >>>
    assert(!(p.sweep_capsule_ramp(outside, fm.vec3(0.0, -3.0, 0.0), ramp) >>>).hit)
    << 0
}

fn walking() int {
    ramp := p.StaticRamp3D{bounds: box(-2.0, 0.0, -2.0, 2.0, 1.0, 2.0), direction: p.RAMP_NEGATIVE_Z, layer: 1}
    world := p.new_capsule_world([]p.StaticBox3D{}, [ramp]) >>>
    policy := p.CapsuleController3D{solid_mask: 1, trigger_mask: 0, step_height: 0.0, ground_snap: 0.08, min_floor_y: 0.7}
    spawn := p.capsule_3d(fm.vec3(0.0, 2.0, 1.5), 0.23, 0.37) >>>
    landed := world.move_capsule(spawn, fm.vec3(0.0, -2.0, 0.0), policy) >>>
    assert(landed.grounded && landed.floor_ramp == 0 && landed.floor_normal.z > 0.2)
    $body := landed.body
    for i in 0:18 {
        up := world.move_capsule(body, fm.vec3(0.0, -0.002, -0.09), policy) >>>
        assert(up.grounded && !up.on_wall && !up.stepped)
        assert(near(up.travelled.y, 0.0225) && near(up.travelled.z, -0.09))
        body = up.body
    }
    stopped := world.move_capsule(body, fm.vec3(0.0, -0.01, 0.0), policy) >>>
    assert(stopped.grounded && near(stopped.travelled.z, 0.0) && near(stopped.travelled.y, 0.0))
    for i in 0:18 {
        down := world.move_capsule(body, fm.vec3(0.0, -0.002, 0.09), policy) >>>
        assert(down.grounded && near(down.travelled.y, -0.0225) && near(down.travelled.z, 0.09))
        body = down.body
    }
    assert(near(body.center.y, landed.body.center.y))
    jump := world.move_capsule(body, fm.vec3(0.0, 0.09, -0.03), policy) >>>
    assert(!jump.grounded && near(jump.travelled.y, 0.09))

    steep := p.StaticRamp3D{bounds: box(-2.0, 0.0, 0.0, 2.0, 2.0, 1.0), direction: p.RAMP_NEGATIVE_Z, layer: 1}
    deck := solid(box(-3.0, -0.5, -3.0, 3.0, 0.0, 4.0))
    steep_world := p.new_capsule_world([deck], [steep]) >>>
    start := p.capsule_3d(fm.vec3(0.0, 0.6, 1.5), 0.23, 0.37) >>>
    blocked := steep_world.move_capsule(start, fm.vec3(0.0, -0.02, -0.9), policy) >>>
    assert(blocked.on_wall && near(blocked.travelled.y, 0.0) && blocked.travelled.z > -0.5)
    // A ramp that fits beneath the step height still obeys the slope limit.
    lip := p.StaticRamp3D{bounds: box(-2.0, 0.0, 0.0, 2.0, 0.20, 0.10), direction: p.RAMP_NEGATIVE_Z, layer: 1}
    lip_world := p.new_capsule_world([deck], [lip]) >>>
    $step_policy := policy
    step_policy.step_height = 0.36
    approaching := p.capsule_3d(fm.vec3(0.0, 0.6, 0.5), 0.23, 0.37) >>>
    refused := lip_world.move_capsule(approaching, fm.vec3(0.0, -0.02, -0.47), step_policy) >>>
    assert(refused.on_wall && !refused.stepped && near(refused.travelled.y, 0.0))
    << 0
}

fn stair_and_trigger() int {
    body := p.capsule_3d(fm.vec3(0.0, 0.6, 0.0), 0.23, 0.37) >>>
    floor := solid(box(-4.0, -1.0, -4.0, 4.0, 0.0, 4.0))
    step := solid(box(0.75, 0.0, -1.0, 2.0, 0.25, 1.0))
    goal := p.StaticBox3D{bounds: box(0.8, 0.25, -0.5, 2.0, 2.0, 0.5), layer: 2, trigger: true}
    $policy := p.CapsuleController3D{solid_mask: 1, trigger_mask: 2, step_height: 0.36, ground_snap: 0.04, min_floor_y: 0.7}
    world := p.new_capsule_world([floor, step, goal], []p.StaticRamp3D{}) >>>
    move := fm.vec3(1.0, -0.02, 0.0)
    done := world.move_capsule(body, move, policy) >>>
    assert(done.stepped && done.grounded && done.floor_ramp == -1 &&
        near(done.travelled.y, 0.25) && near(done.travelled.x, 1.0))
    assert(done.triggers.len == 1 && done.triggers[0] == 2)
    lip := p.capsule_3d(fm.vec3(0.52, 0.6, 0.0), 0.23, 0.37) >>>
    short_step := world.move_capsule(lip, fm.vec3(0.058, -0.003, 0.0), policy) >>>
    assert(short_step.stepped && short_step.grounded && short_step.travelled.x <= 0.174)
    assert((world.overlap_capsule_triggers(done.body, 1) >>>).len == 0)
    corner := p.capsule_3d(fm.vec3(0.59, 0.85, 0.71), 0.23, 0.37) >>>
    assert((world.overlap_capsule_triggers(corner, 2) >>>).len == 0)
    low_ceiling := solid(box(-1.0, 1.35, -1.0, 2.0, 2.0, 1.0))
    constrained := p.new_capsule_world([floor, step, low_ceiling], []p.StaticRamp3D{}) >>>
    blocked := constrained.move_capsule(body, move, policy) >>>
    assert(!blocked.stepped && blocked.on_wall && near(blocked.travelled.x, 0.52))
    policy.solid_mask = 0
    clear := constrained.move_capsule(body, move, policy) >>>
    assert(!clear.grounded && clear.collisions == 0 && near(clear.travelled.x, 1.0))
    << 0
}

fn rejects_radius() bool {
    p.capsule_3d(fm.vec3(0.0, 0.0, 0.0), 0.0, 0.35) >>> (err) { << true }
    << false
}
fn rejects_ramp(bounds fm.Aabb3) bool {
    invalid := p.StaticRamp3D{bounds: bounds, direction: 9, layer: 1}
    p.new_capsule_world([]p.StaticBox3D{}, [invalid]) >>> (err) { << true }
    << false
}
fn rejects_motion(world &p.CapsuleWorld3D, body p.Capsule3D, motion fm.Vec3, policy p.CapsuleController3D) bool {
    world.move_capsule(body, motion, policy) >>> (err) { << true }
    << false
}

fn corners_and_rejections() int {
    // Simultaneous contacts with two walls and the floor leave no inward motion.
    floor := solid(box(-4.0, -1.0, -4.0, 4.0, 0.0, 4.0))
    wall_x := solid(box(1.0, 0.0, -4.0, 1.1, 2.0, 4.0))
    wall_z := solid(box(-4.0, 0.0, 1.0, 4.0, 2.0, 1.1))
    world := p.new_capsule_world([floor, wall_x, wall_z], []p.StaticRamp3D{}) >>>
    reversed := p.new_capsule_world([wall_z, wall_x, floor], []p.StaticRamp3D{}) >>>
    policy := p.CapsuleController3D{solid_mask: 1, trigger_mask: 0, step_height: 0.0, ground_snap: 0.04, min_floor_y: 0.7}
    body := p.capsule_3d(fm.vec3(0.0, 0.6, 0.0), 0.25, 0.35) >>>
    motion := fm.vec3(5.0, -2.0, 5.0)
    corners := world.move_capsule(body, motion, policy) >>>
    again := reversed.move_capsule(body, motion, policy) >>>
    assert(corners.on_wall && corners.grounded && near(corners.travelled.x, 0.75) && near(corners.travelled.z, 0.75))
    assert(near(again.travelled.x, corners.travelled.x) && near(again.travelled.y, corners.travelled.y) &&
        near(again.travelled.z, corners.travelled.z))

    open := p.new_capsule_world([floor], []p.StaticRamp3D{}) >>>
    edge := p.capsule_3d(fm.vec3(3.9, 0.6, 0.0), 0.25, 0.35) >>>
    leave := open.move_capsule(edge, fm.vec3(1.0, -0.01, 0.0), policy) >>>
    assert(!leave.grounded && near(leave.travelled.x, 1.0))
    sphere := p.capsule_3d(fm.vec3(0.0, 1.0, 0.0), 0.25, 0.0) >>>
    fall := world.move_capsule(sphere, fm.vec3(0.0, -2.0, 0.0), policy) >>>
    assert(fall.grounded && near(fall.body.center.y, 0.25))

    inside := p.capsule_3d(fm.vec3(0.0, 0.55, 0.0), 0.25, 0.35) >>>
    assert(rejects_radius() && rejects_ramp(floor.bounds))
    assert(rejects_motion(&world, body, fm.vec3(1000000001.0, 0.0, 0.0), policy))
    assert(rejects_motion(&world, inside, fm.vec3(0.0, 0.0, 0.0), policy))
    << 0
}

fn run() int {
    sweeps() >>>
    ramp_sweeps() >>>
    walking() >>>
    stair_and_trigger() >>>
    corners_and_rejections() >>>
    println("PASS: capsule continuous thin-wall and rounded-corner sweeps, four ramps, uphill/downhill, slope limit, stairs and triggers")
    << 0
}
fn main() int { << run() >>> (err) { eprintln(err.msg())
    << 1 } }
