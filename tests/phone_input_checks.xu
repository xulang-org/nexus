@main
controls #"github.com/xulang-org/nexus/input"
bridge #"github.com/xulang-org/nexus/integration/input"
fm #"github.com/xulang-org/nexus/foundation/math"
events #window/events
#math
fn event(kind int, finger int, x f64, y f64) events.Event {
    $out := events.empty()
    out.kind = kind
    out.device_id = -1
    out.touch_id = finger
    out.x = x
    out.y = y
    << out
}
fn rejects_source_overflow() bool {
    bridge.new_touch_controls(fm.vec2(0.0, 0.0), 40.0, 0.1, 9223372036854775807) or (err) { << true }
    << false
}
fn run() int {
    assert(rejects_source_overflow())
    $input := controls.new_input_map()
    input.bind("right", events.KEY_D) or >>
    input.bind_source("left", 0) or >>
    input.bind_source("right", 1) or >>
    input.bind_source("up", 2) or >>
    input.bind_source("down", 3) or >>
    input.bind_source("boost", 4) or >>
    input.bind_source("pause", 5) or >>
    input.bind_source("right", 6) or >>
    $touch := bridge.new_touch_controls(fm.vec2(50.0, 50.0), 40.0, 0.2, 0) or >>
    touch.add_button(fm.vec2(150.0, 50.0), 30.0, 4, bridge.BUTTON_HOLD) or >>
    touch.add_button(fm.vec2(150.0, 150.0), 30.0, 5, bridge.BUTTON_TAP) or >>
    input.begin_frame()
    down := event(events.EVENT_TOUCH_DOWN, -2, 70.0, 50.0)
    touch.apply($&input, &down) or >>
    assert(math.abs((input.value("right") or >>) - 0.375) < 0.000000001)
    boost := event(events.EVENT_TOUCH_DOWN, 0, 150.0, 50.0)
    touch.apply($&input, &boost) or >>
    assert(input.pressed("boost") or >>)
    release := event(events.EVENT_TOUCH_UP, 0, 300.0, 50.0)
    touch.apply($&input, &release) or >>
    assert(!(input.pressed("boost") or >>))
    assert(math.abs((input.value("right") or >>) - 0.375) < 0.000000001)
    input.feed_key(events.KEY_D, true) or >>
    input.feed_source(6, 0.75) or >>
    cancel := event(events.EVENT_TOUCH_CANCEL, -2, 70.0, 50.0)
    touch.apply($&input, &cancel) or >>
    assert(input.value("right") or >> == 1.0)
    input.feed_key(events.KEY_D, false) or >>
    assert(input.value("right") or >> == 0.75)
    input.feed_source(6, 0.0) or >>
    tap_down := event(events.EVENT_TOUCH_DOWN, 7, 150.0, 150.0)
    tap_up := event(events.EVENT_TOUCH_UP, 7, 150.0, 150.0)
    touch.apply($&input, &tap_down) or >>
    assert(!(input.just_pressed("pause") or >>))
    touch.apply($&input, &tap_up) or >>
    assert(input.just_pressed("pause") or >>)
    assert(!(input.pressed("pause") or >>))
    input.begin_frame()
    touch.apply($&input, &tap_down) or >>
    tap_cancel := event(events.EVENT_TOUCH_CANCEL, 7, 150.0, 150.0)
    touch.apply($&input, &tap_cancel) or >>
    assert(!(input.just_pressed("pause") or >>))
    touch.apply($&input, &down) or >>
    reset := event(events.EVENT_INPUT_RESET, 0, 0.0, 0.0)
    touch.apply($&input, &reset) or >>
    assert(!(input.pressed("right") or >>))
    stale := event(events.EVENT_TOUCH_MOVE, -2, 90.0, 50.0)
    touch.apply($&input, &stale) or >>
    assert(!(input.pressed("right") or >>))
    // Floating activation isn't restricted to the visible idle ring. The same
    // finger retains full control outside both the ring and activation area.
    $floating := bridge.new_touch_controls(fm.vec2(50.0, 50.0), 40.0, 0.08, 0) or >>
    floating.enable_floating(fm.rect2(0.0, 0.0, 120.0, 160.0)) or >>
    floating.add_button(fm.vec2(180.0, 130.0), 40.0, 4, bridge.BUTTON_HOLD) or >>
    start := event(events.EVENT_TOUCH_DOWN, 99, 10.0, 140.0)
    floating.apply($&input, &start) or >>
    assert(floating.center.x == 10.0 && floating.center.y == 140.0)
    assert(!(input.pressed("right") or >>))
    outside := event(events.EVENT_TOUCH_MOVE, 99, 250.0, 140.0)
    floating.apply($&input, &outside) or >>
    assert(math.abs((input.value("right") or >>) - 1.0) < 0.000000001)
    assert(math.abs(floating.center.x - 210.0) < 0.000000001 && math.abs(floating.offset.x - 1.0) < 0.000000001)
    second_finger := event(events.EVENT_TOUCH_DOWN, 100, 180.0, 130.0)
    floating.apply($&input, &second_finger) or >>
    assert((input.pressed("boost") or >>) && (input.pressed("right") or >>))
    stranger := event(events.EVENT_TOUCH_UP, 101, 250.0, 140.0)
    floating.apply($&input, &stranger) or >>
    assert(input.pressed("right") or >>)
    button_release := event(events.EVENT_TOUCH_UP, 100, 300.0, 140.0)
    floating.apply($&input, &button_release) or >>
    assert(!(input.pressed("boost") or >>) && (input.pressed("right") or >>))
    end := event(events.EVENT_TOUCH_UP, 99, 250.0, 140.0)
    floating.apply($&input, &end) or >>
    assert(!(input.pressed("right") or >>))
    assert(floating.center.x == 50.0 && floating.center.y == 50.0 && floating.offset.x == 0.0)
    println("phone input: independent fingers/sources, analog strength, cancellation and tap edges PASS")
    << 0
}
fn main() int { << run() or (err) { eprintln(err.msg())
    << 1 } }
