@main
controls #"github.com/xulang-org/nexus/input"
bridge #"github.com/xulang-org/nexus/integration/input"
fm #"github.com/xulang-org/nexus/foundation/math"
events #window/events
#math
fn event(kind int, finger int, x f64, y f64) events.Event {
    $out := events.empty()
    out.kind = kind
    out.device_id = -1
    out.touch_id = finger
    out.x = x
    out.y = y
    << out
}
fn rejects_source_overflow() bool {
    bridge.new_touch_controls(fm.vec2(0.0, 0.0), 40.0, 0.1, 9223372036854775807) >>> (err) { << true }
    << false
}
fn run() int {
    assert(rejects_source_overflow())
    $input := controls.new_input_map()
    input.bind("right", events.KEY_D) >>>
    input.bind_source("left", 0) >>>
    input.bind_source("right", 1) >>>
    input.bind_source("up", 2) >>>
    input.bind_source("down", 3) >>>
    input.bind_source("boost", 4) >>>
    input.bind_source("pause", 5) >>>
    input.bind_source("right", 6) >>>
    $touch := bridge.new_touch_controls(fm.vec2(50.0, 50.0), 40.0, 0.2, 0) >>>
    touch.add_button(fm.vec2(150.0, 50.0), 30.0, 4, bridge.BUTTON_HOLD) >>>
    touch.add_button(fm.vec2(150.0, 150.0), 30.0, 5, bridge.BUTTON_TAP) >>>
    input.begin_frame()
    down := event(events.EVENT_TOUCH_DOWN, -2, 70.0, 50.0)
    touch.apply($&input, &down) >>>
    assert(math.abs((input.value("right") >>>) - 0.375) < 0.000000001)
    boost := event(events.EVENT_TOUCH_DOWN, 0, 150.0, 50.0)
    touch.apply($&input, &boost) >>>
    assert(input.pressed("boost") >>>)
    release := event(events.EVENT_TOUCH_UP, 0, 300.0, 50.0)
    touch.apply($&input, &release) >>>
    assert(!(input.pressed("boost") >>>))
    assert(math.abs((input.value("right") >>>) - 0.375) < 0.000000001)
    input.feed_key(events.KEY_D, true) >>>
    input.feed_source(6, 0.75) >>>
    cancel := event(events.EVENT_TOUCH_CANCEL, -2, 70.0, 50.0)
    touch.apply($&input, &cancel) >>>
    assert(input.value("right") >>> == 1.0)
    input.feed_key(events.KEY_D, false) >>>
    assert(input.value("right") >>> == 0.75)
    input.feed_source(6, 0.0) >>>
    tap_down := event(events.EVENT_TOUCH_DOWN, 7, 150.0, 150.0)
    tap_up := event(events.EVENT_TOUCH_UP, 7, 150.0, 150.0)
    touch.apply($&input, &tap_down) >>>
    assert(!(input.just_pressed("pause") >>>))
    touch.apply($&input, &tap_up) >>>
    assert(input.just_pressed("pause") >>>)
    assert(!(input.pressed("pause") >>>))
    input.begin_frame()
    touch.apply($&input, &tap_down) >>>
    tap_cancel := event(events.EVENT_TOUCH_CANCEL, 7, 150.0, 150.0)
    touch.apply($&input, &tap_cancel) >>>
    assert(!(input.just_pressed("pause") >>>))
    touch.apply($&input, &down) >>>
    reset := event(events.EVENT_INPUT_RESET, 0, 0.0, 0.0)
    touch.apply($&input, &reset) >>>
    assert(!(input.pressed("right") >>>))
    stale := event(events.EVENT_TOUCH_MOVE, -2, 90.0, 50.0)
    touch.apply($&input, &stale) >>>
    assert(!(input.pressed("right") >>>))
    // Floating activation isn't restricted to the visible idle ring. The same
    // finger retains full control outside both the ring and activation area.
    $floating := bridge.new_touch_controls(fm.vec2(50.0, 50.0), 40.0, 0.08, 0) >>>
    floating.enable_floating(fm.rect2(0.0, 0.0, 120.0, 160.0)) >>>
    floating.add_button(fm.vec2(180.0, 130.0), 40.0, 4, bridge.BUTTON_HOLD) >>>
    start := event(events.EVENT_TOUCH_DOWN, 99, 10.0, 140.0)
    floating.apply($&input, &start) >>>
    assert(floating.center.x == 10.0 && floating.center.y == 140.0)
    assert(!(input.pressed("right") >>>))
    outside := event(events.EVENT_TOUCH_MOVE, 99, 250.0, 140.0)
    floating.apply($&input, &outside) >>>
    assert(math.abs((input.value("right") >>>) - 1.0) < 0.000000001)
    assert(math.abs(floating.center.x - 210.0) < 0.000000001 && math.abs(floating.offset.x - 1.0) < 0.000000001)
    second_finger := event(events.EVENT_TOUCH_DOWN, 100, 180.0, 130.0)
    floating.apply($&input, &second_finger) >>>
    assert((input.pressed("boost") >>>) && (input.pressed("right") >>>))
    stranger := event(events.EVENT_TOUCH_UP, 101, 250.0, 140.0)
    floating.apply($&input, &stranger) >>>
    assert(input.pressed("right") >>>)
    button_release := event(events.EVENT_TOUCH_UP, 100, 300.0, 140.0)
    floating.apply($&input, &button_release) >>>
    assert(!(input.pressed("boost") >>>) && (input.pressed("right") >>>))
    end := event(events.EVENT_TOUCH_UP, 99, 250.0, 140.0)
    floating.apply($&input, &end) >>>
    assert(!(input.pressed("right") >>>))
    assert(floating.center.x == 50.0 && floating.center.y == 50.0 && floating.offset.x == 0.0)
    println("phone input: independent fingers/sources, analog strength, cancellation and tap edges PASS")
    << 0
}
fn main() int { << run() >>> (err) { eprintln(err.msg())
    << 1 } }
