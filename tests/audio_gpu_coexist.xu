@main

#gpu

canvas_shaders #"github.com/xulang-org/nexus/assets/shaders/two_d"

audio #"github.com/xulang-org/nexus/audio"
ren #"github.com/xulang-org/nexus/rendering/two_d"
colors #"github.com/xulang-org/nexus/foundation/color"

fn run() int {
    $samples := []int{}
    for i in 0:1024 { samples.push(0) }
    $output := audio.open_output(48000) or >>
    assert((output.driver_name() or >>) == "dummy")
    output.submit(&samples) or >>
    output.pause(false) or >>
    canvas_program_0 := canvas_shaders.load_canvas("build/canvas-shaders") or >>
    $renderer := ren.open_2d("Audio/GPU subsystem coexistence", 64, 64, gpu.AUTO, &canvas_program_0) or >>
    color := colors.rgba8(40, 180, 120, 255) or >>
    renderer.begin(color) or >>
    assert((renderer.read_pixel(1, 1) or >>) == color)
    renderer.present() or >>
    renderer.close() or >>
    output.pause(true) or >>
    output.clear() or >>
    assert((output.submit(&samples) or >>) == 512 && (output.queued_frames() or >>) == 512)
    canvas_program_1 := canvas_shaders.load_canvas("build/canvas-shaders") or >>
    $next_renderer := ren.open_2d("Audio close preserves GPU", 64, 64, gpu.AUTO, &canvas_program_1) or >>
    output.close() or >>
    next_renderer.begin(color) or >>
    assert((next_renderer.read_pixel(1, 1) or >>) == color)
    next_renderer.present() or >>
    $again := audio.open_output(48000) or >>
    assert((again.driver_name() or >>) == "dummy" && (again.submit(&samples) or >>) == 512)
    again.close() or >>
    next_renderer.close() or >>
    println("PASS: simultaneous audio/GPU modules; closing either SDL subsystem preserves the other")
    << 0
}
fn main() int { << run() or (err) { eprintln(err.msg())
    << 1 } }
