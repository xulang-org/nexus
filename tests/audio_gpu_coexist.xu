@main

#gpu

canvas_shaders #"github.com/xulang-org/nexus/assets/shaders/two_d"

audio #"github.com/xulang-org/nexus/audio"
ren #"github.com/xulang-org/nexus/rendering/two_d"
colors #"github.com/xulang-org/nexus/foundation/color"

fn run() int {
    $samples := []int{}
    for i in 0:1024 { samples.push(0) }
    $output := audio.open_output(48000) >>>
    assert((output.driver_name() >>>) == "dummy")
    output.submit(&samples) >>>
    output.pause(false) >>>
    canvas_program_0 := canvas_shaders.load_canvas("build/canvas-shaders") >>>
    $renderer := ren.open_2d("Audio/GPU subsystem coexistence", 64, 64, gpu.AUTO, &canvas_program_0) >>>
    color := colors.rgba8(40, 180, 120, 255) >>>
    renderer.begin(color) >>>
    assert((renderer.read_pixel(1, 1) >>>) == color)
    renderer.present() >>>
    renderer.close() >>>
    output.pause(true) >>>
    output.clear() >>>
    assert((output.submit(&samples) >>>) == 512 && (output.queued_frames() >>>) == 512)
    canvas_program_1 := canvas_shaders.load_canvas("build/canvas-shaders") >>>
    $next_renderer := ren.open_2d("Audio close preserves GPU", 64, 64, gpu.AUTO, &canvas_program_1) >>>
    output.close() >>>
    next_renderer.begin(color) >>>
    assert((next_renderer.read_pixel(1, 1) >>>) == color)
    next_renderer.present() >>>
    $again := audio.open_output(48000) >>>
    assert((again.driver_name() >>>) == "dummy" && (again.submit(&samples) >>>) == 512)
    again.close() >>>
    next_renderer.close() >>>
    println("PASS: simultaneous audio/GPU modules; closing either SDL subsystem preserves the other")
    << 0
}
fn main() int { << run() >>> (err) { eprintln(err.msg())
    << 1 } }
