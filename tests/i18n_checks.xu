@main

ri #"github.com/xulang-org/nexus/resources/i18n"
li #"github.com/xulang-org/nexus/i18n"
snapshot #"github.com/xulang-org/nexus/internal/file_snapshot"
#os
#path/filepath
#strings

fn fmt_fails(tmpl string, params &map[string]string) bool {
    _ := ri.format_template(&tmpl, params) or (err) {
        _ := err.msg()
        << true
    }
    << false
}

fn run() int {
    // 1. BCP-47 normalization, fallback chains, RTL & plurals
    assert(ri.normalize_locale(&"zh_hans_cn") or >> == "zh-Hans-CN")
    assert(ri.normalize_locale(&"EN_us") or >> == "en-US")
    chain := ri.locale_fallback_chain(&"zh-Hans-CN", &"en-US")
    assert(chain.len == 5 && chain[0] == "zh-Hans-CN" && chain[1] == "zh-Hans" && chain[2] == "zh" && chain[3] == "en-US" && chain[4] == "en")

    assert(ri.is_rtl_locale(&"ar-SA") && ri.is_rtl_locale(&"he") && !ri.is_rtl_locale(&"zh-CN"))
    assert(ri.plural_category(&"en-US", 0) == "zero")
    assert(ri.plural_category(&"en-US", 1) == "one")
    assert(ri.plural_category(&"en-US", 5) == "other")
    assert(ri.plural_category(&"zh-CN", 1) == "other")

    // 2. Template formatting & errors
    $pm := map[string]string{}
    pm["player"] = "Aria"
    pm["gold"] = "250"
    formatted := ri.format_template(&"Hello {player}, {{{gold}}}G", &pm) or >>
    assert(formatted == "Hello Aria, {250}G")
    assert(fmt_fails("Bad {unclosed", &pm) && fmt_fails("Missing {foo}", &pm) && fmt_fails("Empty {}", &pm))

    // 3. Catalog JSON + CSV roundtrips
    $cat := ri.new_catalog("en-US") or >>
    cat.set_entry("en", "menu.play", "Play Game") or >>
    cat.set_entry("zh", "menu.play", "开始游戏") or >>
    cat.set_entry("zh-Hans-CN", "hud.greet", "你好, {player}!") or >>
    cat.set_plural("en", "inv.arrows", "zero", "No arrows") or >>
    cat.set_plural("en", "inv.arrows", "one", "1 arrow") or >>
    cat.set_plural("en", "inv.arrows", "other", "{count} arrows") or >>
    cat.set_plural("zh", "inv.arrows", "other", "{count} 支箭") or >>

    enc := ri.encode_catalog_json(&cat)
    dec := ri.decode_catalog_json(&enc) or >>
    assert(dec.resolve("zh-Hans-CN", "menu.play") == "开始游戏")
    assert(dec.resolve("en-GB", "menu.play") == "Play Game")

    csv_raw := "key,en,zh-Hans,fr\n\"ui,ok\",\"Yes, \"\"OK\"\"\",确定,Oui\nquit,Quit,,Quitter\n"
    csv_cat := ri.decode_catalog_csv(&csv_raw, "en") or >>
    assert(csv_cat.resolve("en", "ui,ok") == "Yes, \"OK\"")
    assert(csv_cat.resolve("zh-Hans-CN", "ui,ok") == "确定")
    assert(csv_cat.resolve("zh-CN", "quit") == "Quit")

    // 4. Localizer file load, hot locale switch, plurals & missing keys
    tmp := filepath.join(["build", "i18n-tmp"])
    os.mkdir_all(tmp + "") or >>
    cpath := filepath.join([tmp + "", "strings.json"])
    snapshot.write_atomic(cpath + "", &enc) or >>

    $loc := li.load_json_file(cpath + "", "zh-Hans-CN") or >>
    assert(loc.locale() == "zh-Hans-CN" && !loc.is_rtl() && loc.revision() == 1)
    assert(loc.tr("menu.play") == "开始游戏")
    assert(loc.tr_fmt("hud.greet", &pm) == "你好, Aria!")
    assert(loc.tr_plural("inv.arrows", 3, &pm) == "3 支箭")

    loc.set_locale("ar-SA") or >>
    assert(loc.is_rtl() && loc.revision() == 2)
    loc.set_locale("en-US") or >>
    assert(loc.tr_plural("inv.arrows", 0, &pm) == "No arrows")
    assert(loc.tr_plural("inv.arrows", 1, &pm) == "1 arrow")
    assert(loc.tr_plural("inv.arrows", 4, &pm) == "4 arrows")

    assert(loc.tr("missing.key") == "missing.key")
    assert(loc.missing_key_count() == 1)

    os.remove_all(tmp + "") or (err) {
        _ := err.msg()
        << 0
    }
    println("PASS: i18n_checks")
    << 0
}

fn main() int {
    run() or (err) {
        println("FAIL: " + err.msg())
        << 1
    }
    << 0
}
