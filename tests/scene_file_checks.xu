@main

scene #"github.com/xulang-org/nexus/integration/scene"
resource #"github.com/xulang-org/nexus/resources/scene"
codec #"github.com/xulang-org/nexus/formats/scene"
fm #"github.com/xulang-org/nexus/foundation/math"
nexus #"github.com/xulang-org/nexus/scene"
#os
#strings
#math

fn rejected(raw &string) bool { codec.decode(raw) or (err) { << true }
    << false }
fn bad_document(nodes []resource.NodeData) bool { resource.make_document(nodes) or (err) { << true }
    << false }
fn bad_mount(document &resource.Document, tree $&nexus.SceneTree, parent int, name string) bool {
    scene.instantiate(document, tree, parent, name) or (err) { << true }
    << false
}
fn bad_capture(tree &nexus.SceneTree, root int) bool { scene.capture_nodes(tree, root) or (err) { << true }
    << false }
fn bad_save(path string, document &resource.Document) bool { scene.save(path, document) or (err) { << true }
    << false }
fn bad_load(path string) bool { scene.load(path) or (err) { << true }
    << false }
fn invalid_document() resource.Document { $document := resource.Document{}
    << document }
fn bad_empty_encode() bool { document := invalid_document()
    codec.encode(&document) or (err) { << true }
    << false }
fn snapshot(tree &nexus.SceneTree) string {
    document := scene.capture_nodes(tree, tree.root()) or >>
    << codec.encode(&document) or >>
}
fn roundtrip() int {
    $source := nexus.new_scene_tree_3d("世界\"\\", 32) or >>
    root := source.root()
    source.set_transform_3d(root, fm.translation_3d(fm.vec3(5.0, -2.0, 1.0))) or >>
    group := source.add_group(root, "Group") or >>
    object := source.add_child_3d(group, "Object") or >>
    transform := fm.translation_3d(fm.vec3(1.125, 2.0, -3.0)).multiply(fm.rotation_y(0.12345678901234567))
    source.set_transform_3d(object, transform) or >>
    source.set_visible(group, false) or >>
    source.set_process_mode(object, nexus.PROCESS_ALWAYS) or >>
    hud := source.add_child(root, "HUD") or >>
    panel := source.add_child(hud, "Panel") or >>
    source.set_transform(hud, fm.Transform2D{a: -2.0, b: 0.25, c: 0.5, d: 3.0, tx: 12.75, ty: -20.5}) or >>
    source.set_position(panel, fm.vec2(2.0, 4.0)) or >>
    source.set_process_mode(hud, nexus.PROCESS_WHEN_PAUSED) or >>
    source.set_process_mode(panel, nexus.PROCESS_DISABLED) or >>
    document := scene.capture_nodes(&source, root) or >>
    raw := codec.encode(&document) or >>
    restored := codec.decode(&raw) or >>
    assert(raw == (codec.encode(&restored) or >>))
    $target := nexus.new_scene_tree_3d("Target", 32) or >>
    target.paused = true
    target_root := target.root()
    target.set_position_3d(target_root, fm.vec3(20.0, 0.0, 0.0)) or >>
    instance := scene.instantiate(&restored, $&target, target_root, "Loaded") or >>
    node := target.find_node(instance, "Group/Object") or >>
    matrix := (target.node_3d(node) or >>).transform
    assert(matrix.c0.x == transform.c0.x && matrix.c0.z == transform.c0.z && matrix.c3.x == 1.125)
    world := target.global_transform_3d(node) or >>
    assert(world.c3.x == 26.125 && world.c3.y == 0.0 && world.c3.z == -2.0)
    assert(!(target.is_visible(node) or >>) && (target.can_process(node) or >>))
    loaded_panel := target.find_node(instance, "HUD/Panel") or >>
    t := target.global_transform(loaded_panel) or >>
    assert(t.tx == 10.75 && t.ty == -8.0 && t.a == -2.0)
    assert(!(target.can_process(loaded_panel) or >>) && target.paused)
    assert((target.take_ready() or >>).len == 6)
    // A second instance has independent storage, process state and lifecycle.
    packed := scene.to_packed(&restored) or >>
    assert(packed.node_count() == restored.node_count())
    second := packed.instantiate($&target, target_root, "Second") or >>
    second_object := target.find_node(second, "Group/Object") or >>
    target.set_position_3d(node, fm.vec3(99.0, 0.0, 0.0)) or >>
    assert((target.node_3d(second_object) or >>).transform.c3.x == 1.125)
    target.queue_free(instance) or >>
    target.flush_free() or >>
    third := scene.instantiate(&restored, $&target, target_root, "Third") or >>
    assert(!target.is_alive(instance) && !target.is_alive(node) && target.is_alive(third))
    // Capture a subtree resets only its external parent; its local pose remains.
    subtree := scene.capture_nodes(&source, group) or >>
    assert(subtree.node_count() == 2 && (subtree.describe_node(0) or >>).parent == -1)
    for kind in ["Node", "Node2D", "Node3D"] {
        d := scene.load("build/scene-fixtures/" + kind + ".xuscene") or >>
        $tree := nexus.new_scene_tree("Root", 2) or >>
        p := tree.root()
        n := scene.instantiate(&d, $&tree, p, "Imported") or >>
        assert((tree.node_kind(n) or >>) == (d.describe_node(0) or >>).kind)
    }
    << 0
}
fn precision() int {
    // These values lose information through str(f64), including subnormals.
    values := [0.12345678901234567, 1.0000000000000002, -0.0, 1e-300, -1e300,
        4.9406564584124654e-324, 2.2250738585072014e-308, 1.7976931348623157e308]
    for value in values {
        $n := resource.node(-1, "Precision", resource.NODE_2D)
        n.local.tx = value
        original := resource.make_document([n]) or >>
        raw := codec.encode(&original) or >>
        loaded := codec.decode(&raw) or >>
        got := (loaded.describe_node(0) or >>).local.tx
        assert(got == value)
        if value == 0.0 { assert((1.0 / got) == (1.0 / value)) }
        assert(raw == (codec.encode(&loaded) or >>))
    }
    << 0
}
fn failure_atomicity() int {
    document := scene.load("build/scene-fixtures/valid.xuscene") or >>
    $tree := nexus.new_scene_tree("Target", 4) or >>
    root := tree.root()
    keeper := tree.add_child(root, "Keeper") or >>
    tree.take_ready() or >>
    before := snapshot(&tree) or >>
    assert(bad_mount(&document, $&tree, root, "TooLarge"))
    assert(before == (snapshot(&tree) or >>) && (tree.take_ready() or >>).len == 0)
    single := scene.load("build/scene-fixtures/Node.xuscene") or >>
    assert(bad_mount(&single, $&tree, root, "Keeper"))
    assert(bad_mount(&single, $&tree, root, "a/b"))
    assert(bad_mount(&single, $&tree, 0, "Invalid"))
    assert(before == (snapshot(&tree) or >>) && (tree.take_ready() or >>).len == 0)
    tree.queue_free(keeper) or >>
    assert(bad_mount(&single, $&tree, keeper, "Queued"))
    assert(bad_capture(&tree, root))
    tree.flush_free() or >>
    assert(bad_capture(&tree, keeper))
    assert(bad_mount(&single, $&tree, keeper, "Stale"))
    // A valid candidate can reuse capacity freed by a prior subtree.
    instance := scene.instantiate(&single, $&tree, root, "Okay") or >>
    assert(tree.is_alive(instance) && !tree.is_alive(keeper))
    empty := invalid_document()
    assert(bad_mount(&empty, $&tree, root, "Empty") && bad_empty_encode())
    << 0
}
fn limits() int {
    $nodes := []resource.NodeData{}
    for i in 0:resource.MAX_NODES {
        $parent := 0
        if i == 0 { parent = -1 }
        nodes.push(resource.node(parent, "n" + str(i), resource.NODE_GROUP))
    }
    largest := resource.make_document(nodes) or >>
    raw := codec.encode(&largest) or >>
    decoded := codec.decode(&raw) or >>
    assert(decoded.node_count() == 4096)
    $tree := nexus.new_scene_tree("Target", 4097) or >>
    root := tree.root()
    instance := scene.instantiate(&decoded, $&tree, root, "Largest") or >>
    assert((tree.subtree(instance) or >>).len == 4096)
    $deep := []resource.NodeData{}
    for i in 0:resource.MAX_DEPTH { deep.push(resource.node(i - 1, "n" + str(i), resource.NODE_GROUP)) }
    deepest := resource.make_document(deep) or >>
    assert(deepest.node_count() == 256)
    assert(bad_document([]resource.NodeData{}))
    $bad := resource.node(-1, "Inactive", resource.NODE_GROUP)
    bad.local.tx = 1.0
    assert(bad_document([bad]))
    $bad3d := resource.node(-1, "Inactive", resource.NODE_2D)
    bad3d.local_3d.c3.x = 1.0
    assert(bad_document([bad3d]))
    $nan := resource.node(-1, "Nonfinite", resource.NODE_2D)
    nan.local.tx = math.sqrt(-1.0)
    assert(bad_document([nan]))
    $invalid := resource.node(-1, "Invalid", resource.NODE_GROUP)
    invalid.kind = 1
    assert(bad_document([invalid]))
    $mode := resource.node(-1, "Invalid", resource.NODE_GROUP)
    mode.process_mode = 5
    assert(bad_document([mode]))
    $unusual := resource.node(-1, "Huge", resource.NODE_3D)
    unusual.local_3d.c0.w = 1.0
    assert(bad_document([unusual]))
    << 0
}
fn files() int {
    $identities := map[string]bool{}
    for i in 0:100 {
        uid := scene.new_resource_id() or >>
        assert(resource.valid_resource_id(&uid) && !identities.has(uid + ""))
        identities[uid] = true
    }
    document := scene.load("build/scene-fixtures/valid.xuscene") or >>
    expected := codec.encode(&document) or >>
    scene.save("build/scene-fixtures/saved.xuscene", &document) or >>
    assert(expected == (os.read("build/scene-fixtures/saved.xuscene") or >>))
    for i in 0:10 {
        value := scene.load("build/scene-fixtures/saved.xuscene") or >>
        scene.save("build/scene-fixtures/saved.xuscene", &value) or >>
    }
    empty := invalid_document()
    assert(bad_save("build/scene-fixtures/saved.xuscene", &empty))
    assert(expected == (os.read("build/scene-fixtures/saved.xuscene") or >>))
    assert(bad_save("build/scene-fixtures/destination-dir", &document))
    assert(bad_save("build/scene-fixtures/missing/destination.xuscene", &document))
    assert(bad_load("build/scene-fixtures/does-not-exist.xuscene"))
    assert(bad_load("build/scene-fixtures/oversized.xuscene"))
    // Independently authored JSON is accepted; malformed inputs are rejected.
    failures := os.read("build/scene-fixtures/reject-list.txt") or >>
    rows := strings.split(&failures, "\n")
    $checked := 0
    for row in rows {
        if row.len == 0 { -> }
        raw := os.read("build/scene-fixtures/" + row) or >>
        if !rejected(&raw) { println("Incorrectly accepted scene: " + row)
            assert(false) }
        checked = checked + 1
    }
    println("PASS: scene format rejected " + str(checked) + " malformed/version/topology/transform/budget inputs")
    << 0
}
fn run() int {
    roundtrip() or >>
    precision() or >>
    failure_atomicity() or >>
    limits() or >>
    files() or >>
    println("PASS: node scene mixed dimensions/flags/preorder/UTF-8/decimal precision, independent instances, lifecycle, capacity/queued/stale/name failure atomicity, 4096 nodes/256 depth and atomic file replacement")
    << 0
}
fn main() int { << run() or (err) { eprintln(err.msg())
    << 1 } }
