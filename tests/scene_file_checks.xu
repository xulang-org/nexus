@main

scene #"github.com/xulang-org/nexus/integration/scene"
resource #"github.com/xulang-org/nexus/resources/scene"
codec #"github.com/xulang-org/nexus/formats/scene"
fm #"github.com/xulang-org/nexus/foundation/math"
camera_data #"github.com/xulang-org/nexus/resources/camera"
nexus #"github.com/xulang-org/nexus/scene"
#os
#strings
#math

fn rejected(raw &string) bool { codec.decode(raw) >>> (err) { << true }
    << false }
fn bad_document(nodes []resource.NodeData) bool { resource.make_document(nodes) >>> (err) { << true }
    << false }
fn bad_mount(document &resource.Document, tree $&nexus.SceneTree, parent int, name string) bool {
    scene.instantiate(document, tree, parent, name) >>> (err) { << true }
    << false
}
fn bad_capture(tree &nexus.SceneTree, root int) bool { scene.capture_nodes(tree, root) >>> (err) { << true }
    << false }
fn bad_save(path string, document &resource.Document) bool { scene.save(path, document) >>> (err) { << true }
    << false }
fn bad_load(path string) bool { scene.load(path) >>> (err) { << true }
    << false }
fn invalid_document() resource.Document { $document := resource.Document{}
    << document }
fn bad_empty_encode() bool { document := invalid_document()
    codec.encode(&document) >>> (err) { << true }
    << false }
fn snapshot(tree &nexus.SceneTree) string {
    document := scene.capture_nodes(tree, tree.root()) >>>
    << codec.encode(&document) >>>
}
fn roundtrip() int {
    $source := nexus.new_scene_tree_3d("世界\"\\", 32) >>>
    root := source.root()
    source.set_transform_3d(root, fm.translation_3d(fm.vec3(5.0, -2.0, 1.0))) >>>
    group := source.add_group(root, "Group") >>>
    object := source.add_child_3d(group, "Object") >>>
    transform := fm.translation_3d(fm.vec3(1.125, 2.0, -3.0)).multiply(fm.rotation_y(0.12345678901234567))
    source.set_transform_3d(object, transform) >>>
    source.set_visible(group, false) >>>
    source.set_process_mode(object, nexus.PROCESS_ALWAYS) >>>
    hud := source.add_child(root, "HUD") >>>
    panel := source.add_child(hud, "Panel") >>>
    source.set_transform(hud, fm.Transform2D{a: -2.0, b: 0.25, c: 0.5, d: 3.0, tx: 12.75, ty: -20.5}) >>>
    source.set_position(panel, fm.vec2(2.0, 4.0)) >>>
    source.set_process_mode(hud, nexus.PROCESS_WHEN_PAUSED) >>>
    source.set_process_mode(panel, nexus.PROCESS_DISABLED) >>>
    document := scene.capture_nodes(&source, root) >>>
    raw := codec.encode(&document) >>>
    restored := codec.decode(&raw) >>>
    assert(raw == (codec.encode(&restored) >>>))
    $target := nexus.new_scene_tree_3d("Target", 32) >>>
    target.paused = true
    target_root := target.root()
    target.set_position_3d(target_root, fm.vec3(20.0, 0.0, 0.0)) >>>
    instance := scene.instantiate(&restored, $&target, target_root, "Loaded") >>>
    node := target.find_node(instance, "Group/Object") >>>
    matrix := (target.node_3d(node) >>>).transform
    assert(matrix.c0.x == transform.c0.x && matrix.c0.z == transform.c0.z && matrix.c3.x == 1.125)
    world := target.global_transform_3d(node) >>>
    assert(world.c3.x == 26.125 && world.c3.y == 0.0 && world.c3.z == -2.0)
    assert(!(target.is_visible(node) >>>) && (target.can_process(node) >>>))
    loaded_panel := target.find_node(instance, "HUD/Panel") >>>
    t := target.global_transform(loaded_panel) >>>
    assert(t.tx == 10.75 && t.ty == -8.0 && t.a == -2.0)
    assert(!(target.can_process(loaded_panel) >>>) && target.paused)
    assert((target.take_ready() >>>).len == 6)
    // A second instance has independent storage, process state and lifecycle.
    packed := scene.to_packed(&restored) >>>
    assert(packed.node_count() == restored.node_count())
    second := packed.instantiate($&target, target_root, "Second") >>>
    second_object := target.find_node(second, "Group/Object") >>>
    target.set_position_3d(node, fm.vec3(99.0, 0.0, 0.0)) >>>
    assert((target.node_3d(second_object) >>>).transform.c3.x == 1.125)
    target.queue_free(instance) >>>
    target.flush_free() >>>
    third := scene.instantiate(&restored, $&target, target_root, "Third") >>>
    assert(!target.is_alive(instance) && !target.is_alive(node) && target.is_alive(third))
    // Capture a subtree resets only its external parent; its local pose remains.
    subtree := scene.capture_nodes(&source, group) >>>
    assert(subtree.node_count() == 2 && (subtree.describe_node(0) >>>).parent == -1)
    for kind in ["Node", "Node2D", "Node3D"] {
        d := scene.load("build/scene-fixtures/" + kind + ".xuscene") >>>
        $tree := nexus.new_scene_tree("Root", 2) >>>
        p := tree.root()
        n := scene.instantiate(&d, $&tree, p, "Imported") >>>
        assert((tree.node_kind(n) >>>) == (d.describe_node(0) >>>).kind)
    }
    << 0
}
fn precision() int {
    // These values lose information through str(f64), including subnormals.
    values := [0.12345678901234567, 1.0000000000000002, -0.0, 1e-300, -1e300,
        4.9406564584124654e-324, 2.2250738585072014e-308, 1.7976931348623157e308]
    for value in values {
        $n := resource.node(-1, "Precision", resource.NODE_2D)
        n.local.tx = value
        original := resource.make_document([n]) >>>
        raw := codec.encode(&original) >>>
        loaded := codec.decode(&raw) >>>
        got := (loaded.describe_node(0) >>>).local.tx
        assert(got == value)
        if value == 0.0 { assert((1.0 / got) == (1.0 / value)) }
        assert(raw == (codec.encode(&loaded) >>>))
    }
    << 0
}
fn bad_camera(tree $&nexus.SceneTree, node int, lens camera_data.Perspective) bool {
    tree.set_camera_3d(node, lens) >>> (err) { << true }
    << false
}
fn camera_roundtrip() int {
    legacy := scene.load("build/scene-fixtures/valid.xuscene") >>>
    assert(!(legacy.describe_node(2) >>>).camera.is_set())
    document := scene.load("build/scene-fixtures/camera.xuscene") >>>
    lens := (document.describe_node(2) >>>).camera
    assert(lens.is_set() && lens.vertical_fov() == 0.8765432101234567 && lens.near() == 0.25 && lens.far() == 50.0)
    packed := scene.to_packed(&document) >>>
    $tree := nexus.new_scene_tree_3d("CameraWorld", 16) >>>
    root := tree.root()
    tree.set_position_3d(root, fm.vec3(3.0, -2.0, 1.0)) >>>
    left := packed.instantiate($&tree, root, "Left") >>>
    right := packed.instantiate($&tree, root, "Right") >>>
    camera := tree.find_node(left, "Group/Cube") >>>
    other := tree.find_node(right, "Group/Cube") >>>
    group := tree.find_node(left, "Group") >>>
    hud := tree.find_node(left, "HUD") >>>
    assert(bad_camera($&tree, group, lens) && bad_camera($&tree, hud, lens))
    bound := nexus.new_camera_node_3d(&tree, camera) >>>
    assert(bound.node == camera && bound.vertical_fov == lens.vertical_fov() && bound.near == lens.near() && bound.far == lens.far())
    eye := (tree.global_transform_3d(camera) >>>).c3.xyz()
    view := bound.view_projection(&tree, 1.5) >>>
    at_near := view.transform(fm.vec4(eye.x, eye.y, eye.z - bound.near, 1.0))
    at_far := view.transform(fm.vec4(eye.x, eye.y, eye.z - bound.far, 1.0))
    assert(math.abs(at_near.z / at_near.w - 1.0) < 1e-12 && math.abs(at_far.z / at_far.w) < 1e-12)

    captured := scene.capture_nodes(&tree, left) >>>
    scene.save("build/scene-fixtures/saved-camera.xuscene", &captured) >>>
    loaded := scene.load("build/scene-fixtures/saved-camera.xuscene") >>>
    assert((loaded.describe_node(2) >>>).camera.vertical_fov() == lens.vertical_fov())
    assert((codec.encode(&loaded) >>>) == (codec.encode(&captured) >>>))
    // Editing one instance does not alter the saved lens or another instance.
    tree.set_camera_3d(camera, camera_data.Perspective{}) >>>
    assert(!(tree.node_3d(camera) >>>).camera.is_set())
    assert((nexus.new_camera_node_3d(&tree, camera) >>>).near == 0.1)
    assert((nexus.new_camera_node_3d(&tree, other) >>>).near == 0.25)
    tree.queue_free(right) >>>
    assert(bad_camera($&tree, other, lens))
    tree.flush_free() >>>
    assert(bad_camera($&tree, other, lens))
    recycled := tree.add_child_3d(root, "Recycled") >>>
    assert(!(tree.node_3d(recycled) >>>).camera.is_set())
    println("PASS: version 1 legacy lens defaults, version 2 lens save/load, inherited pose, reverse-Z, independent PackedScene instances and slot reuse")
    << 0
}
fn rejects_perspective_binding(tree &nexus.SceneTree, node int) bool {
    nexus.new_camera_node_3d(tree, node) >>> (err) { << true }
    << false
}
fn rejects_camera_2d(tree &nexus.SceneTree, node int) bool {
    nexus.new_camera_node_2d(tree, node) >>> (err) { << true }
    << false
}
fn rejects_camera_projection(tree &nexus.SceneTree, node int, aspect f64) bool {
    tree.camera_view_projection_3d(node, aspect) >>> (err) { << true }
    << false
}
fn mixed_cameras_roundtrip() int {
    document := scene.load("build/scene-fixtures/multi-camera.xuscene") >>>
    packed := scene.to_packed(&document) >>>
    $tree := nexus.new_scene_tree_3d("World", 24) >>>
    root := tree.root()
    tree.set_position_3d(root, fm.vec3(2.0, 3.0, 7.0)) >>>
    first := packed.instantiate($&tree, root, "First") >>>
    second := packed.instantiate($&tree, root, "Second") >>>
    ortho_node := tree.find_node(first, "Group/Cube") >>>
    view_node := tree.find_node(first, "HUD/View") >>>
    assert(rejects_perspective_binding(&tree, ortho_node))
    assert(!(tree.node_3d(ortho_node) >>>).camera.is_set())
    assert((nexus.new_camera_node_3d(&tree, first) >>>).vertical_fov == 0.8765432101234567)
    eye := (tree.global_transform_3d(ortho_node) >>>).c3.xyz()
    projection := tree.camera_view_projection_3d(ortho_node, 2.0) >>>
    near := projection.transform(fm.vec4(eye.x + 6.0, eye.y + 3.0, eye.z - 0.25, 1.0))
    far := projection.transform(fm.vec4(eye.x + 6.0, eye.y + 3.0, eye.z - 50.0, 1.0))
    assert(math.abs(near.x - 1.0) < 1e-12 && near.y == 1.0 && near.w == 1.0 && far.w == 1.0)
    assert(near.x == far.x && near.y == far.y && math.abs(near.z - 1.0) < 1e-12 && math.abs(far.z) < 1e-12)
    square := tree.camera_view_projection_3d(ortho_node, 1.0) >>>
    assert(square.c0.x == 2.0 * projection.c0.x && square.c1.y == projection.c1.y)
    assert(rejects_camera_projection(&tree, ortho_node, 0.0))

    hud := tree.find_node(first, "HUD") >>>
    tree.set_transform(hud, fm.Transform2D{a: 0.0, b: 2.0, c: -3.0, d: 0.0, tx: 30.0, ty: 40.0}) >>>
    camera := nexus.new_camera_node_2d(&tree, view_node) >>>
    assert(camera.position.x == 21.0 && camera.position.y == 44.0 && camera.zoom == 2.0)
    viewport := camera.viewport(640.0, 480.0) >>>
    assert(viewport.size.x == 640.0 && viewport.size.y == 360.0 && viewport.position.y == 60.0)
    point := camera.world_to_screen(fm.vec2(21.0, 54.0), 640.0, 480.0) >>>
    assert(math.abs(point.x - 360.0) < 1e-8 && math.abs(point.y - 240.0) < 1e-8)
    pick := camera.screen_to_world(point, 640.0, 480.0) >>>
    assert(math.abs(pick.x - 21.0) < 1e-8 && math.abs(pick.y - 54.0) < 1e-8)

    captured := scene.capture_nodes(&tree, first) >>>
    scene.save("build/scene-fixtures/saved-multi-camera.xuscene", &captured) >>>
    loaded := scene.load("build/scene-fixtures/saved-multi-camera.xuscene") >>>
    assert((codec.encode(&loaded) >>>) == (codec.encode(&captured) >>>))
    copy := scene.instantiate(&loaded, $&tree, root, "Reloaded") >>>
    restored_view := tree.find_node(copy, "HUD/View") >>>
    assert((nexus.new_camera_node_2d(&tree, restored_view) >>>).position.x == 21.0)
    restored_ortho := tree.find_node(copy, "Group/Cube") >>>
    assert((tree.node_3d(restored_ortho) >>>).orthographic.vertical_size() == 6.0)

    tree.set_camera_3d(ortho_node, camera_data.perspective(0.9, 0.2, 100.0) >>>) >>>
    assert(!(tree.node_3d(ortho_node) >>>).orthographic.is_set())
    other_ortho := tree.find_node(second, "Group/Cube") >>>
    assert((tree.node_3d(other_ortho) >>>).orthographic.is_set())
    tree.set_transform(hud, fm.Transform2D{a: 0.0, b: 0.0, c: -3.0, d: 0.0, tx: 30.0, ty: 40.0}) >>>
    assert(rejects_camera_2d(&tree, view_node))
    tree.set_camera_2d(view_node, camera_data.View2D{}) >>>
    assert(!(tree.node(view_node) >>>).camera.is_set())
    other_view := tree.find_node(second, "HUD/View") >>>
    assert((nexus.new_camera_node_2d(&tree, other_view) >>>).zoom == 2.0)
    tree.queue_free(second) >>>
    assert(rejects_camera_2d(&tree, other_view))
    assert(rejects_camera_projection(&tree, other_ortho, 1.0))
    tree.flush_free() >>>
    assert(rejects_camera_2d(&tree, other_view))
    assert(rejects_camera_projection(&tree, other_ortho, 1.0))
    recycled := tree.add_child(root, "Recycled2D") >>>
    assert(!(tree.node(recycled) >>>).camera.is_set())
    println("PASS: mixed version 3 orthographic, perspective and Node2D cameras, projection depth, viewport and picking, independent instances and invalid poses")
    << 0
}
fn failure_atomicity() int {
    document := scene.load("build/scene-fixtures/valid.xuscene") >>>
    $tree := nexus.new_scene_tree("Target", 4) >>>
    root := tree.root()
    keeper := tree.add_child(root, "Keeper") >>>
    tree.take_ready() >>>
    before := snapshot(&tree) >>>
    assert(bad_mount(&document, $&tree, root, "TooLarge"))
    assert(before == (snapshot(&tree) >>>) && (tree.take_ready() >>>).len == 0)
    single := scene.load("build/scene-fixtures/Node.xuscene") >>>
    assert(bad_mount(&single, $&tree, root, "Keeper"))
    assert(bad_mount(&single, $&tree, root, "a/b"))
    assert(bad_mount(&single, $&tree, 0, "Invalid"))
    assert(before == (snapshot(&tree) >>>) && (tree.take_ready() >>>).len == 0)
    tree.queue_free(keeper) >>>
    assert(bad_mount(&single, $&tree, keeper, "Queued"))
    assert(bad_capture(&tree, root))
    tree.flush_free() >>>
    assert(bad_capture(&tree, keeper))
    assert(bad_mount(&single, $&tree, keeper, "Stale"))
    // A valid candidate can reuse capacity freed by a prior subtree.
    instance := scene.instantiate(&single, $&tree, root, "Okay") >>>
    assert(tree.is_alive(instance) && !tree.is_alive(keeper))
    empty := invalid_document()
    assert(bad_mount(&empty, $&tree, root, "Empty") && bad_empty_encode())
    << 0
}
fn limits() int {
    $nodes := []resource.NodeData{}
    for i in 0:resource.MAX_NODES {
        $parent := 0
        if i == 0 { parent = -1 }
        nodes.push(resource.node(parent, "n" + str(i), resource.NODE_GROUP))
    }
    largest := resource.make_document(nodes) >>>
    raw := codec.encode(&largest) >>>
    decoded := codec.decode(&raw) >>>
    assert(decoded.node_count() == 4096)
    $tree := nexus.new_scene_tree("Target", 4097) >>>
    root := tree.root()
    instance := scene.instantiate(&decoded, $&tree, root, "Largest") >>>
    assert((tree.subtree(instance) >>>).len == 4096)
    $deep := []resource.NodeData{}
    for i in 0:resource.MAX_DEPTH { deep.push(resource.node(i - 1, "n" + str(i), resource.NODE_GROUP)) }
    deepest := resource.make_document(deep) >>>
    assert(deepest.node_count() == 256)
    assert(bad_document([]resource.NodeData{}))
    $bad := resource.node(-1, "Inactive", resource.NODE_GROUP)
    bad.local.tx = 1.0
    assert(bad_document([bad]))
    $bad3d := resource.node(-1, "Inactive", resource.NODE_2D)
    bad3d.local_3d.c3.x = 1.0
    assert(bad_document([bad3d]))
    $nan := resource.node(-1, "Nonfinite", resource.NODE_2D)
    nan.local.tx = math.sqrt(-1.0)
    assert(bad_document([nan]))
    $invalid := resource.node(-1, "Invalid", resource.NODE_GROUP)
    invalid.kind = 1
    assert(bad_document([invalid]))
    $mode := resource.node(-1, "Invalid", resource.NODE_GROUP)
    mode.process_mode = 5
    assert(bad_document([mode]))
    $unusual := resource.node(-1, "Huge", resource.NODE_3D)
    unusual.local_3d.c0.w = 1.0
    assert(bad_document([unusual]))
    << 0
}
fn files() int {
    $identities := map[string]bool{}
    for i in 0:100 {
        uid := scene.new_resource_id() >>>
        assert(resource.valid_resource_id(&uid) && !identities.has(uid + ""))
        identities[uid] = true
    }
    document := scene.load("build/scene-fixtures/valid.xuscene") >>>
    expected := codec.encode(&document) >>>
    scene.save("build/scene-fixtures/saved.xuscene", &document) >>>
    assert(expected == (os.read("build/scene-fixtures/saved.xuscene") >>>))
    for i in 0:10 {
        value := scene.load("build/scene-fixtures/saved.xuscene") >>>
        scene.save("build/scene-fixtures/saved.xuscene", &value) >>>
    }
    empty := invalid_document()
    assert(bad_save("build/scene-fixtures/saved.xuscene", &empty))
    assert(expected == (os.read("build/scene-fixtures/saved.xuscene") >>>))
    assert(bad_save("build/scene-fixtures/destination-dir", &document))
    assert(bad_save("build/scene-fixtures/missing/destination.xuscene", &document))
    assert(bad_load("build/scene-fixtures/does-not-exist.xuscene"))
    assert(bad_load("build/scene-fixtures/oversized.xuscene"))
    // Independently authored JSON is accepted; malformed inputs are rejected.
    failures := os.read("build/scene-fixtures/reject-list.txt") >>>
    rows := strings.split(&failures, "\n")
    $checked := 0
    for row in rows {
        if row.len == 0 { -> }
        raw := os.read("build/scene-fixtures/" + row) >>>
        if !rejected(&raw) { println("Incorrectly accepted scene: " + row)
            assert(false) }
        checked = checked + 1
    }
    println("PASS: scene format rejected " + str(checked) + " malformed/version/topology/transform/budget inputs")
    << 0
}
fn run() int {
    roundtrip() >>>
    precision() >>>
    camera_roundtrip() >>>
    mixed_cameras_roundtrip() >>>
    failure_atomicity() >>>
    limits() >>>
    files() >>>
    println("PASS: node scene mixed dimensions/flags/preorder/UTF-8/decimal precision, independent instances, lifecycle, capacity/queued/stale/name failure atomicity, 4096 nodes/256 depth and atomic file replacement")
    << 0
}
fn main() int { << run() >>> (err) { eprintln(err.msg())
    << 1 } }
