@main

#gpu
#math
#os
#time
assets #"github.com/xulang-org/nexus/assets/gltf"
fm #"github.com/xulang-org/nexus/foundation/math"
mesh #"github.com/xulang-org/nexus/resources/mesh"
lights #"github.com/xulang-org/nexus/resources/lighting"
nexus #"github.com/xulang-org/nexus/scene"
ren #"github.com/xulang-org/nexus/rendering/three_d"
gltf_ren #"github.com/xulang-org/nexus/integration/gltf_render"
bridge #"github.com/xulang-org/nexus/integration/rendering/three_d"
shaders #"github.com/xulang-org/nexus/assets/shaders/three_d"

fn max_f64(a f64, b f64) f64 {
    if a > b { << a }
    << b
}

fn min_f64(a f64, b f64) f64 {
    if a < b { << a }
    << b
}

fn rgba_close(a int, b int, tol int) bool {
    r0 := (a >> 24) & 255
    g0 := (a >> 16) & 255
    b0 := (a >> 8) & 255
    a0 := a & 255
    r1 := (b >> 24) & 255
    g1 := (b >> 16) & 255
    b1 := (b >> 8) & 255
    a1 := b & 255
    << math.abs(f64(r0 - r1)) <= f64(tol) &&
        math.abs(f64(g0 - g1)) <= f64(tol) &&
        math.abs(f64(b0 - b1)) <= f64(tol) &&
        math.abs(f64(a0 - a1)) <= f64(tol)
}

fn capture_pixels(device $&ren.Device3D, scene &bridge.Scene3D, tree &nexus.SceneTree, vp fm.Mat4, env &lights.Environment3D, name string) []int {
    device.begin(255) or >>
    scene.draw_lit(device, tree, vp, env) or >>
    $pixels := []int{}
    for y in 0:16 {
        for x in 0:16 {
            pixels.push(device.read_pixel(x * 4 + 2, y * 4 + 2) or >>)
        }
    }
    device.capture("build/" + name + ".png") or >>
    device.present() or >>
    << pixels
}

fn cpu_blend_mat(palette &[]fm.Mat4, j0 int, j1 int, j2 int, j3 int, w0 f64, w1 f64, w2 f64, w3 f64) fm.Mat4 {
    $c0 := fm.vec4(0.0, 0.0, 0.0, 0.0)
    $c1 := fm.vec4(0.0, 0.0, 0.0, 0.0)
    $c2 := fm.vec4(0.0, 0.0, 0.0, 0.0)
    $c3 := fm.vec4(0.0, 0.0, 0.0, 0.0)
    js := [j0, j1, j2, j3]
    ws := [w0, w1, w2, w3]
    for k in 0:4 {
        w := ws[k]
        if w > 0.0 {
            m := palette[js[k]]
            c0 = fm.vec4(c0.x + m.c0.x * w, c0.y + m.c0.y * w, c0.z + m.c0.z * w, 0.0)
            c1 = fm.vec4(c1.x + m.c1.x * w, c1.y + m.c1.y * w, c1.z + m.c1.z * w, 0.0)
            c2 = fm.vec4(c2.x + m.c2.x * w, c2.y + m.c2.y * w, c2.z + m.c2.z * w, 0.0)
            c3 = fm.vec4(c3.x + m.c3.x * w, c3.y + m.c3.y * w, c3.z + m.c3.z * w, c3.w + m.c3.w * w)
        }
    }
    << fm.Mat4{c0: c0, c1: c1, c2: c2, c3: c3}
}

fn cpu_skin_mesh(
    rest &mesh.MeshData3D,
    joint_indices &[]int,
    joint_weights &[]f64,
    palette &[]fm.Mat4
) mesh.MeshData3D {
    $out := mesh.new_mesh_data_3d()
    for i in 0:rest.vertices.len {
        v := &rest.vertices[i]
        base := i * 4
        blend := cpu_blend_mat(
            palette,
            joint_indices[base], joint_indices[base + 1], joint_indices[base + 2], joint_indices[base + 3],
            joint_weights[base], joint_weights[base + 1], joint_weights[base + 2], joint_weights[base + 3]
        )
        pos := blend.transform(fm.vec4(v.position.x, v.position.y, v.position.z, 1.0)).xyz()
        inv_t := (blend.affine_inverse() or >>).transposed()
        nrm := inv_t.transform(fm.vec4(v.normal.x, v.normal.y, v.normal.z, 0.0)).xyz().normalized() or >>
        tw := blend.transform(fm.vec4(v.tangent.x, v.tangent.y, v.tangent.z, 0.0)).xyz()
        ortho := tw.sub(nrm.scaled(tw.dot(nrm))).normalized() or >>
        ds := blend.determinant_sign() or >>
        out.vertex_tangent(pos, v.color, nrm, v.uv, fm.vec4(ortho.x, ortho.y, ortho.z, v.tangent.w * f64(ds))) or >>
    }
    for i in 0:(rest.indices.len / 3) {
        out.triangle(rest.indices[i * 3], rest.indices[i * 3 + 1], rest.indices[i * 3 + 2]) or >>
    }
    out.validate() or >>
    << out
}

fn run() int {
    program := shaders.load_mesh("build/mesh-shaders") or >>
    skin_prog := shaders.load_skin_program("build/mesh-shaders") or >>
    $device := ren.open_3d("GPU skinning checks", 64, 64, gpu.METAL, &program) or >>
    eye := fm.vec3(0.0, 0.0, 3.6)
    view := nexus.look_at_3d(eye, fm.vec3(0.8, 0.0, 0.0), fm.vec3(0.0, 1.0, 0.0)) or >>
    vp := (nexus.perspective_3d(0.9, 1.0, 0.1, 50.0) or >>).multiply(view)
    sun := lights.directional(fm.vec3(0.3, 0.4, 1.0).normalized() or >>, fm.vec3(3.0, 3.0, 3.0)) or >>
    pt := lights.point(fm.vec3(1.5, 1.0, 2.0), fm.vec3(4.0, 2.5, 2.0), 10.0) or >>
    env := lights.environment(fm.vec3(0.08, 0.08, 0.10), eye, 1.0, [sun, pt]) or >>

    // Part 1: GLB CPU upload_animated vs GPU upload_animated_gpu across clips/times.
    asset := assets.load_glb_geometry("build/gltf-animation-fixtures/analytic.glb") or >>
    $tree_cpu := nexus.new_scene_tree_3d("CPU", 64) or >>
    $tree_gpu := nexus.new_scene_tree_3d("GPU", 64) or >>
    root_cpu := tree_cpu.add_child_3d(tree_cpu.root(), "Scale") or >>
    root_gpu := tree_gpu.add_child_3d(tree_gpu.root(), "Scale") or >>
    nonunif := fm.Mat4{
        c0: fm.vec4(1.4, 0.0, 0.0, 0.0),
        c1: fm.vec4(0.0, 0.8, 0.0, 0.0),
        c2: fm.vec4(0.0, 0.0, 1.0, 0.0),
        c3: fm.vec4(0.0, 0.0, 0.0, 1.0)
    }
    tree_cpu.set_transform_3d(root_cpu, nonunif) or >>
    tree_gpu.set_transform_3d(root_gpu, nonunif) or >>
    inst_cpu := assets.instantiate(&asset, $&tree_cpu, root_cpu, "CpuInst") or >>
    inst_gpu := assets.instantiate(&asset, $&tree_gpu, root_gpu, "GpuInst") or >>
    $scene_cpu := bridge.new_scene_3d(&device) or >>
    $scene_gpu := bridge.new_scene_3d(&device) or >>
    $anim_cpu := gltf_ren.upload_animated(&device, &asset) or >>
    $anim_gpu := gltf_ren.upload_animated_gpu(&device, &asset, &skin_prog) or >>
    clips := [0, 0, 0, 3]
    times := [0.0, 0.5, 1.0, 0.5]
    $nonbg_total := 0
    for k in 0:clips.len {
        anim_cpu.sample(&device, $&scene_cpu, $&tree_cpu, &asset, &inst_cpu, clips[k], times[k]) or >>
        anim_gpu.sample(&device, $&scene_gpu, $&tree_gpu, &asset, &inst_gpu, clips[k], times[k]) or >>
        px_c := capture_pixels($&device, &scene_cpu, &tree_cpu, vp, &env, "skin-cpu-" + str(k)) or >>
        px_g := capture_pixels($&device, &scene_gpu, &tree_gpu, vp, &env, "skin-gpu-" + str(k)) or >>
        for p in 0:px_c.len {
            assert(rgba_close(px_c[p], px_g[p], 2))
            if px_c[p] != 255 { nonbg_total += 1 }
        }
    }
    assert(nonbg_total > 10)
    anim_cpu.close() or >>
    anim_gpu.close() or >>

    // Part 2: Non-uniform scale + negative determinant (reflection) inside bone palette!
    // Verify SkinnedMesh3D.pose conservative bone-box bounds and pixel equivalence vs CPU.
    cols := 32
    rows := 64
    $grid := mesh.new_mesh_data_3d()
    $j_idx := []int{}
    $j_wgt := []f64{}
    $bone_used := []bool{}
    $bone_mins := []fm.Vec3{}
    $bone_maxs := []fm.Vec3{}
    for b in 0:16 {
        bone_used.push(false)
        bone_mins.push(fm.vec3(0.0, 0.0, 0.0))
        bone_maxs.push(fm.vec3(0.0, 0.0, 0.0))
    }
    for r in 0:rows {
        for c in 0:cols {
            fx := f64(c) / f64(cols - 1) * 2.0 - 1.0
            fy := f64(r) / f64(rows - 1) * 2.0 - 1.0
            fz := 0.12 * math.sin(fx * 2.0) * math.cos(fy * 2.0)
            p := fm.vec3(fx, fy, fz)
            n := fm.vec3(0.15 * fx, 0.1 * fy, 1.0).normalized() or >>
            t := fm.vec3(1.0, 0.0, 0.0)
            ortho := t.sub(n.scaled(t.dot(n))).normalized() or >>
            grid.vertex_tangent(p, 4294967295, n, fm.vec2(f64(c) / f64(cols - 1), f64(r) / f64(rows - 1)),
                fm.vec4(ortho.x, ortho.y, ortho.z, 1.0)) or >>
            b0 := (c * 15) / (cols - 1)
            $b1 := b0 + 1
            if b1 > 15 { b1 = 15 }
            j_idx.push(b0)
            j_idx.push(b1)
            j_idx.push(0)
            j_idx.push(0)
            j_wgt.push(0.65)
            j_wgt.push(0.35)
            j_wgt.push(0.0)
            j_wgt.push(0.0)
            for ji in [b0, b1] {
                if !bone_used[ji] {
                    bone_used[ji] = true
                    bone_mins[ji] = p
                    bone_maxs[ji] = p
                } else {
                    bone_mins[ji] = fm.vec3(min_f64(bone_mins[ji].x, p.x), min_f64(bone_mins[ji].y, p.y), min_f64(bone_mins[ji].z, p.z))
                    bone_maxs[ji] = fm.vec3(max_f64(bone_maxs[ji].x, p.x), max_f64(bone_maxs[ji].y, p.y), max_f64(bone_maxs[ji].z, p.z))
                }
            }
        }
    }
    for r in 0:(rows - 1) {
        for c in 0:(cols - 1) {
            i0 := r * cols + c
            i1 := i0 + 1
            i2 := (r + 1) * cols + c + 1
            i3 := (r + 1) * cols + c
            grid.triangle(i0, i1, i2) or >>
            grid.triangle(i0, i2, i3) or >>
        }
    }
    grid.validate() or >>
    $bone_boxes := []fm.Aabb3{}
    for b in 0:16 {
        if bone_used[b] {
            bone_boxes.push(fm.aabb3(bone_mins[b], bone_maxs[b]) or >>)
        } else {
            bone_boxes.push(fm.aabb3(fm.vec3(0.0, 0.0, 0.0), fm.vec3(0.0, 0.0, 0.0)) or >>)
        }
    }
    $skin_pipe := device.skin_pipeline(&skin_prog) or >>
    $sk := device.upload_skinned_mesh(&grid, &j_idx, &j_wgt, 16, &bone_boxes, &bone_used) or >>
    rest_bounds := sk.current_bounds()

    // Reflected / non-uniform bone palette tests:
    // Case A: positive det non-uniform scale (sx=1.3, sy=0.7) facing +Z camera.
    $palette_pos := []fm.Mat4{}
    $palette_neg := []fm.Mat4{}
    for b in 0:16 {
        ang := 0.25 + f64(b) * 0.04
        ca := math.cos(ang)
        sa := math.sin(ang)
        m_pos := fm.Mat4{
            c0: fm.vec4(ca * 1.3, 0.0, -sa * 1.3, 0.0),
            c1: fm.vec4(0.0, 0.7, 0.0, 0.0),
            c2: fm.vec4(sa, 0.0, ca, 0.0),
            c3: fm.vec4(0.25, -0.1, 0.0, 1.0)
        }
        m_neg := fm.Mat4{
            c0: fm.vec4(-ca * 1.3, 0.0, sa * 1.3, 0.0),
            c1: fm.vec4(0.0, 0.7, 0.0, 0.0),
            c2: fm.vec4(sa, 0.0, ca, 0.0),
            c3: fm.vec4(-0.25, -0.1, 0.0, 1.0)
        }
        palette_pos.push(m_pos)
        palette_neg.push(m_neg)
    }

    posed_pos := sk.pose(&device, &skin_pipe, &palette_pos) or >>
    posed_bounds := sk.current_bounds()
    assert(posed_bounds.maximum.x > rest_bounds.maximum.x)

    cpu_data := cpu_skin_mesh(&grid, &j_idx, &j_wgt, &palette_pos) or >>
    cpu_b := cpu_data.bounds() or >>
    assert(posed_bounds.minimum.x <= cpu_b.minimum.x + 1e-4 && posed_bounds.maximum.x >= cpu_b.maximum.x - 1e-4)
    assert(posed_bounds.minimum.y <= cpu_b.minimum.y + 1e-4 && posed_bounds.maximum.y >= cpu_b.maximum.y - 1e-4)
    assert(posed_bounds.minimum.z <= cpu_b.minimum.z + 1e-4 && posed_bounds.maximum.z >= cpu_b.maximum.z - 1e-4)
    $cpu_mesh := device.upload(&cpu_data) or >>

    $t_grid_c := nexus.new_scene_tree_3d("GC", 16) or >>
    $t_grid_g := nexus.new_scene_tree_3d("GG", 16) or >>
    nc := t_grid_c.add_child_3d(t_grid_c.root(), "M") or >>
    ng := t_grid_g.add_child_3d(t_grid_g.root(), "M") or >>
    $sc_c := bridge.new_scene_3d(&device) or >>
    $sc_g := bridge.new_scene_3d(&device) or >>
    mat := ren.material_3d(fm.vec3(0.75, 0.65, 0.55), 0.15, 0.45, fm.vec3(0.0, 0.0, 0.0)) or >>
    sc_c.attach_surface(&t_grid_c, nc, &cpu_mesh, mat) or >>
    sc_g.attach_surface_ref(&t_grid_g, ng, posed_pos, mat) or >>
    view2 := nexus.look_at_3d(fm.vec3(0.0, 0.0, 3.2), fm.vec3(0.2, -0.1, 0.0), fm.vec3(0.0, 1.0, 0.0)) or >>
    vp2 := (nexus.perspective_3d(0.9, 1.0, 0.1, 50.0) or >>).multiply(view2)
    grid_c_px := capture_pixels($&device, &sc_c, &t_grid_c, vp2, &env, "skin-grid-pos-cpu") or >>
    grid_g_px := capture_pixels($&device, &sc_g, &t_grid_g, vp2, &env, "skin-grid-pos-gpu") or >>
    $grid_lit := 0
    for i in 0:grid_c_px.len {
        assert(rgba_close(grid_c_px[i], grid_g_px[i], 2))
        if grid_c_px[i] != 255 { grid_lit += 1 }
    }
    assert(grid_lit > 20)

    // Case B: reflected bone palette (det < 0, winding flipped) viewed & lit from -Z.
    posed_neg := sk.pose(&device, &skin_pipe, &palette_neg) or >>
    cpu_neg_data := cpu_skin_mesh(&grid, &j_idx, &j_wgt, &palette_neg) or >>
    $cpu_neg_mesh := device.upload(&cpu_neg_data) or >>
    sc_c.attach_surface(&t_grid_c, nc, &cpu_neg_mesh, mat) or >>
    sc_g.attach_surface_ref(&t_grid_g, ng, posed_neg, mat) or >>
    eye_neg := fm.vec3(0.0, 0.0, -3.2)
    view_neg := nexus.look_at_3d(eye_neg, fm.vec3(-0.2, -0.1, 0.0), fm.vec3(0.0, 1.0, 0.0)) or >>
    vp_neg := (nexus.perspective_3d(0.9, 1.0, 0.1, 50.0) or >>).multiply(view_neg)
    sun_neg := lights.directional(fm.vec3(-0.2, 0.3, -1.0).normalized() or >>, fm.vec3(3.0, 3.0, 3.0)) or >>
    env_neg := lights.environment(fm.vec3(0.08, 0.08, 0.10), eye_neg, 1.0, [sun_neg]) or >>
    neg_c_px := capture_pixels($&device, &sc_c, &t_grid_c, vp_neg, &env_neg, "skin-grid-neg-cpu") or >>
    neg_g_px := capture_pixels($&device, &sc_g, &t_grid_g, vp_neg, &env_neg, "skin-grid-neg-gpu") or >>
    $neg_lit := 0
    for i in 0:neg_c_px.len {
        assert(rgba_close(neg_c_px[i], neg_g_px[i], 2))
        if neg_c_px[i] != 255 { neg_lit += 1 }
    }
    assert(neg_lit > 20)

    // Part 3: 30-frame 2048-vertex x 16-bone benchmark (GPU Compute pose vs CPU LBS + upload).
    t_gpu0 := time.now()
    for f in 0:30 {
        _ := sk.pose(&device, &skin_pipe, &palette_pos) or >>
    }
    gpu_us := (time.now() - t_gpu0) / 1000

    t_cpu0 := time.now()
    for f in 0:30 {
        d := cpu_skin_mesh(&grid, &j_idx, &j_wgt, &palette_pos) or >>
        $m := device.upload(&d) or >>
        m.close() or >>
    }
    cpu_us := (time.now() - t_cpu0) / 1000

    cpu_neg_mesh.close() or >>
    cpu_mesh.close() or >>
    sk.close() or >>
    skin_pipe.close() or >>
    device.close() or >>
    println("PASS: GPU Compute LBS pixel-equivalent to CPU (non-uniform/reflected bone palette, " +
        str(grid_lit) + " shaded cells, bounds verified; 30x2048v bench: gpu=" + str(gpu_us) + "us vs cpu=" + str(cpu_us) + "us)")
    << 0
}

fn main() int {
    << run() or (err) {
        eprintln(err.msg())
        << 1
    }
}
