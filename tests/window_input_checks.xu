@main
#window/events
#errors
controls #"github.com/xulang-org/nexus/input"
bridge #"github.com/xulang-org/nexus/integration/input"
fn feed(input $&controls.InputMap, kind int, key int, repeated bool) int {
    $event := events.empty()
    event.kind=kind
    event.physical_key=key
    event.logical_key=events.KEY_SPECIAL_BASE+events.KEY_F12
    event.repeated=repeated
    << bridge.apply_window_input(input,&event) or >>
}
fn invalid(input $&controls.InputMap) int {
    feed(input,events.EVENT_KEY_DOWN,events.KEY_COUNT,false) or (err) { << 0 }
    >> errors.new("invalid portable key accepted")
}
fn run() int {
    $input := controls.new_input_map()
    input.bind("move",events.KEY_A) or >>
    input.bind("move",events.KEY_LEFT) or >>
    input.begin_frame()
    feed($&input,events.EVENT_KEY_DOWN,events.KEY_A,true) or >>
    assert(!(input.pressed("move") or >>))
    feed($&input,events.EVENT_KEY_DOWN,events.KEY_A,false) or >>
    assert((input.pressed("move") or >>) && (input.just_pressed("move") or >>))
    input.begin_frame()
    feed($&input,events.EVENT_KEY_DOWN,events.KEY_LEFT,false) or >>
    feed($&input,events.EVENT_KEY_UP,events.KEY_A,false) or >>
    assert((input.pressed("move") or >>) && !(input.just_released("move") or >>))
    feed($&input,events.EVENT_TEXT_INPUT,events.KEY_LEFT,false) or >>
    feed($&input,events.EVENT_POINTER_UP,events.KEY_LEFT,false) or >>
    assert(input.pressed("move") or >>)
    // Even a malformed repeat flag on key-up must release a held action.
    feed($&input,events.EVENT_KEY_UP,events.KEY_LEFT,true) or >>
    assert(!(input.pressed("move") or >>) && (input.just_released("move") or >>))
    for kind in [events.EVENT_INPUT_RESET,events.EVENT_FOCUS_LOST,events.EVENT_CLOSE_REQUESTED] {
        input.begin_frame()
        feed($&input,events.EVENT_KEY_DOWN,events.KEY_A,false) or >>
        feed($&input,kind,events.KEY_UNKNOWN,false) or >>
        assert(!(input.pressed("move") or >>) && (input.just_released("move") or >>))
        input.begin_frame()
        feed($&input,events.EVENT_KEY_DOWN,events.KEY_A,true) or >>
        assert(!(input.pressed("move") or >>) && !(input.just_pressed("move") or >>))
    }
    feed($&input,events.EVENT_KEY_DOWN,events.KEY_UNKNOWN,false) or >>
    invalid($&input) or >>
    assert(!(input.pressed("move") or >>))
    println("PASS: portable physical-key actions, multiple bindings, frame edges, repeat/unknown filtering, ignored text/pointer data, reset/focus/close release and invalid-key rejection")
    << 0
}
fn main() int { << run() or (err) { eprintln(err.msg())
    << 1 } }
