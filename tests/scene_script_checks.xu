@main
loader #"github.com/xulang-org/nexus/integration/scene_script"
files #"github.com/xulang-org/nexus/integration/scene"
codec #"github.com/xulang-org/nexus/formats/scene"
nexus #"github.com/xulang-org/nexus/scene"
#os
#math

fn load(name string) loader.ScriptScene { << loader.load("build/scene-script-fixtures/" + name + ".xuscene") >>> }
fn bad_load(name string) bool { load(name) >>> (err) { << true }
    << false }
fn bad_mount(set $&loader.ScriptScene, tree $&nexus.SceneTree, root int, name string) bool {
    set.instantiate(tree, root, name) >>> (err) { << true }
    << false
}
fn bad_reload(set $&loader.ScriptScene, tree &nexus.SceneTree, path string) bool {
    set.reload_from(tree, "55005500550055005500550055005500", path) >>> (err) { << true }
    << false
}
fn bad_save(set &loader.ScriptScene, tree &nexus.SceneTree, path string) bool {
    set.save(path, tree) >>> (err) { << true }
    << false
}
fn failed_callback(set $&loader.ScriptScene, tree &nexus.SceneTree) bool {
    set.physics_process(tree, 0, 0.0, 1.0) >>> (err) { << true }
    << false
}
fn snapshot(tree &nexus.SceneTree) string {
    document := files.capture_nodes(tree, tree.root()) >>>
    << codec.encode(&document) >>>
}
fn run() int {
    $set := load("base") >>>
    $tree := nexus.new_scene_tree("World", 32) >>>
    parent := tree.root()
    root := set.instantiate($&tree, parent, "Loaded") >>>
    assert((tree.take_ready() >>>).len == 4 && set.script_count() == 2 && set.bytecode_count() == 2)
    assert((set.state(0, 3) >>>) == 0.9 && (set.state(1, 3) >>>) == 5.0)
    set.physics_process(&tree, 0, 0.1, 1.0) >>>
    // A pending signal is retained across a stable-ID rename/reload.
    assert((set.reload_from(&tree, "55005500550055005500550055005500", "next.xubc") >>>) == 1)
    assert((set.epoch(0) >>>) == 2 && (set.calls(0) >>>) == 1 && (set.state(0, 1) >>>) == 1.0)
    assert((set.dispatch(&tree, 64) >>>).delivered == 1 && (set.state(1, 1) >>>) == 1.0)
    delta := set.physics_process(&tree, 0, 0.1, 1.0) >>>
    assert(math.abs(delta - 0.18) < 0.000001 && (set.state(0, 1) >>>) == 2.0)
    assert((set.reload_from(&tree, "66006600660066006600660066006600", "indicator-next.xubc") >>>) == 1)
    assert((set.dispatch(&tree, 64) >>>).delivered == 1 && (set.state(1, 1) >>>) == 2.0)
    assert((set.reload_from(&tree, "55005500550055005500550055005500", "next.xubc") >>>) == 0)
    set.save("build/scene-script-fixtures/saved.xuscene", &tree) >>>
    saved := files.load("build/scene-script-fixtures/saved.xuscene") >>>
    assert((saved.resource(0) >>>).path == "next.xubc" && (saved.script(0) >>>).initial[0].value == 0.9)
    $fresh := load("saved") >>>
    $fresh_tree := nexus.new_scene_tree("Fresh", 8) >>>
    fresh_parent := fresh_tree.root()
    fresh.instantiate($&fresh_tree, fresh_parent, "Fresh") >>>
    assert((fresh.calls(0) >>>) == 0 && (fresh.state(0, 1) >>>) == 0.0 && (fresh.state(0, 3) >>>) == 0.9)
    assert(math.abs((fresh.physics_process(&fresh_tree, 0, 0.1, 1.0) >>>) - 0.18) < 0.000001)
    for path in ["drop-field.xubc", "drop-signal.xubc", "wrong-class.xubc", "broken.xubc", "oversized.xubc", "absent.xubc", "../next.xubc"] {
        assert(bad_reload($&set, &tree, path))
        assert((set.epoch(0) >>>) == 2 && (set.calls(0) >>>) == 2 && set.connection_count() == 1)
    }
    assert((set.reload_from(&tree, "55005500550055005500550055005500", "runtime-fail.xubc") >>>) == 1)
    assert(failed_callback($&set, &tree) && (set.calls(0) >>>) == 2 && (set.state(0, 1) >>>) == 2.0)
    assert((set.dispatch(&tree, 64) >>>).delivered == 0)
    // The same compiled source has independent per-node state, switched together.
    $batch := load("batch") >>>
    $batch_tree := nexus.new_scene_tree("Batch", 16) >>>
    bp := batch_tree.root()
    batch_root := batch.instantiate($&batch_tree, bp, "Batch") >>>
    batch.physics_process(&batch_tree, 0, 0.1, 1.0) >>>
    batch.physics_process(&batch_tree, 1, 0.1, 1.0) >>>
    assert((batch.reload_from(&batch_tree, "55005500550055005500550055005500", "next.xubc") >>>) == 2)
    assert((batch.epoch(0) >>>) == 2 && (batch.epoch(1) >>>) == 2 && (batch.state(0, 3) >>>) == 1.0 && (batch.state(1, 3) >>>) == 2.0)
    assert((batch.dispatch(&batch_tree, 64) >>>).delivered == 2 && (batch.state(2, 1) >>>) == 2.0)
    last := batch_tree.find_child(batch_root, "B") >>>
    batch_tree.queue_free(last) >>>
    assert(bad_reload($&batch, &batch_tree, "mover.xubc") && (batch.epoch(0) >>>) == 2)
    $aliases := load("aliases") >>>
    $alias_tree := nexus.new_scene_tree("Alias", 16) >>>
    ap := alias_tree.root()
    aliases.instantiate($&alias_tree, ap, "Alias") >>>
    assert(aliases.bytecode_count() == 2)
    aliases.reload_from(&alias_tree, "55005500550055005500550055005500", "next.xubc") >>>
    assert(aliases.bytecode_count() == 3 && (aliases.epoch(0) >>>) == 2 && (aliases.epoch(1) >>>) == 1)
    $full := load("full") >>>
    $full_tree := nexus.new_scene_tree("Full", 64) >>>
    fp := full_tree.root()
    full.instantiate($&full_tree, fp, "Full") >>>
    assert(full.script_count() == 32 && full.connection_count() == 32)
    full.physics_process(&full_tree, 0, 0.1, 1.0) >>>
    assert((full.dispatch(&full_tree, 64) >>>).delivered == 30)
    // Bad actual field/route IDs are rejected before any target nodes/ready.
    for name in ["bad-field", "bad-signal", "bad-handler"] {
        $bad := load(name) >>>
        $target := nexus.new_scene_tree("Target", 8) >>>
        tp := target.root()
        target.take_ready() >>>
        before := snapshot(&target) >>>
        assert(bad_mount($&bad, $&target, tp, "Bad"))
        assert(before == (snapshot(&target) >>>) && (target.take_ready() >>>).len == 0)
    }
    for name in ["missing", "hash", "broken", "oversized"] { assert(bad_load(name)) }
    $small_set := load("base") >>>
    $small := nexus.new_scene_tree("Small", 3) >>>
    sp := small.root()
    assert(bad_mount($&small_set, $&small, sp, "TooLarge"))
    assert((small.subtree(sp) >>>).len == 1)
    assert(bad_mount($&set, $&tree, parent, "AlreadyBound"))
    // Saving refuses a lost accepted disk revision and leaves the old file intact.
    old_saved := os.read("build/scene-script-fixtures/saved.xuscene") >>>
    accepted := os.read("build/scene-script-fixtures/runtime-fail.xubc") >>>
    os.write("build/scene-script-fixtures/runtime-fail.xubc", "broken") >>>
    assert(bad_save(&set, &tree, "build/scene-script-fixtures/saved.xuscene"))
    assert((os.read("build/scene-script-fixtures/saved.xuscene") >>>) == old_saved)
    os.write("build/scene-script-fixtures/runtime-fail.xubc", accepted) >>>
    set.close() >>>
    set.close() >>>
    assert(bad_reload($&set, &tree, "next.xubc"))
    println("PASS: script scene startup overrides/routes, pending signals, stable renames, atomic shared-source reload, independent aliases, runtime rollback, 32 scripts/routes, target preflight and accepted-revision save/reopen")
    << 0
}
fn main() int { << run() >>> (err) { eprintln(err.msg())
    << 1 } }
