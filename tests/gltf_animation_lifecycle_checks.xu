@main
assets #"github.com/xulang-org/nexus/assets/gltf"
nexus #"github.com/xulang-org/nexus/scene"
fm #"github.com/xulang-org/nexus/foundation/math"
#math
fn bad_apply(instance &assets.GlbInstance,tree $&nexus.SceneTree,asset_path string) bool {
    asset := assets.load_glb_geometry(asset_path) >>>
    locals := asset.sample_pose(0,0.5) >>>
    instance.apply_pose(tree,&asset,&locals) >>> (err){ << true }
    << false
}
fn run() int {
    path := "build/gltf-animation-fixtures/analytic.glb"
    asset := assets.load_glb_geometry(path+"") >>>
    $tree := nexus.new_scene_tree_3d("World",64) >>>
    root := tree.root()
    a := assets.instantiate(&asset,$&tree,root,"A") >>>
    b := assets.instantiate(&asset,$&tree,root,"B") >>>
    pose := asset.sample_pose(0,0.5) >>>
    a.apply_pose($&tree,&asset,&pose) >>>
    assert((tree.node_3d(a.source_node(1) >>>) >>>).transform.c3.x==1.0)
    assert((tree.node_3d(b.source_node(1) >>>) >>>).transform.c3.x==0.0)
    doomed := a.source_node(2) >>>
    tree.queue_free(doomed) >>>
    assert(bad_apply(&a,$&tree,path+"") >>>)
    assert((tree.node_3d(a.source_node(1) >>>) >>>).transform.c3.x==1.0)
    println("PASS: independent animation instances and pending-deletion pose preflight preserve earlier node transforms")
    << 0
}
fn main() int { << run() >>> (err){ eprintln(err.msg())
    << 1 } }
