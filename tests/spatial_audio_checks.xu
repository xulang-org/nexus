@main

mix #"github.com/xulang-org/nexus/audio/mixer"
pcm #"github.com/xulang-org/nexus/resources/audio"
fm #"github.com/xulang-org/nexus/foundation/math"
#math

fn make_sine_clip(rate int, frames int, freq_hz f64, amp f64) pcm.Clip {
    $samples := []int{}
    for i in 0:frames {
        t := f64(i) / f64(rate)
        v := int(math.round_to_even(math.sin(6.283185307179586 * freq_hz * t) * amp))
        samples.push(v)
    }
    << pcm.pcm16(rate, 1, samples) >>>
}

fn make_square_high_freq_clip(rate int, frames int, freq_hz f64, amp int) pcm.Clip {
    $samples := []int{}
    half_period := f64(rate) / (2.0 * freq_hz)
    for i in 0:frames {
        idx := int(f64(i) / half_period)
        if idx % 2 == 0 { samples.push(amp) }
        else { samples.push(-amp) }
    }
    << pcm.pcm16(rate, 1, samples) >>>
}

fn run() int {
    rate := 48000

    // 1. Distance attenuation models & Doppler pitch shift
    $p_close := mix.default_spatial_3d_params(fm.vec3(2.0, 0.0, 0.0), fm.vec3(0.0, 0.0, 0.0), fm.vec3(1.0, 0.0, 0.0), fm.vec3(0.0, 0.0, -1.0))
    p_close.atten_model = mix.ATTEN_INVERSE
    p_close.source_velocity = fm.vec3(-40.0, 0.0, 0.0) // Approaching listener
    r_app := mix.spatial_3d_advanced(&p_close)
    assert(r_app.pitch > 1.1 && r_app.itd_frames > 0 && r_app.right_gain > r_app.left_gain)

    $p_rec := mix.default_spatial_3d_params(fm.vec3(10.0, 0.0, 0.0), fm.vec3(0.0, 0.0, 0.0), fm.vec3(1.0, 0.0, 0.0), fm.vec3(0.0, 0.0, -1.0))
    p_rec.atten_model = mix.ATTEN_EXPONENTIAL
    p_rec.rolloff = 1.5
    p_rec.source_velocity = fm.vec3(40.0, 0.0, 0.0) // Receding from listener
    r_rec := mix.spatial_3d_advanced(&p_rec)
    assert(r_rec.pitch < 0.95 && r_rec.volume < r_app.volume)

    // 2. Box occlusion (single & double walls)
    boxes := [
        mix.AcousticBox{min: fm.vec3(3.0, -2.0, -2.0), max: fm.vec3(4.0, 2.0, 2.0), absorption: 0.5},
        mix.AcousticBox{min: fm.vec3(6.0, -2.0, -2.0), max: fm.vec3(7.0, 2.0, 2.0), absorption: 0.6}
    ]
    occ1 := mix.compute_box_occlusion(fm.vec3(5.0, 0.0, 0.0), fm.vec3(0.0, 0.0, 0.0), &boxes) >>>
    assert(math.abs(occ1 - 0.5) < 1e-6)
    occ2 := mix.compute_box_occlusion(fm.vec3(9.0, 0.0, 0.0), fm.vec3(0.0, 0.0, 0.0), &boxes) >>>
    // 1 - (1 - 0.5)*(1 - 0.6) = 0.8
    assert(math.abs(occ2 - 0.8) < 1e-6)
    occ0 := mix.compute_box_occlusion(fm.vec3(0.0, 5.0, 0.0), fm.vec3(0.0, 0.0, 0.0), &boxes) >>>
    assert(occ0 == 0.0)

    // 3. Binaural ITD arrival-time check in rendered PCM: sound on +X (right) arrives in right ear before left ear
    $imp_samples := []int{}
    for i in 0:256 {
        if i == 0 { imp_samples.push(20000) }
        else { imp_samples.push(0) }
    }
    imp_clip := pcm.pcm16(rate, 1, imp_samples) >>>
    $m1 := mix.new_mixer(rate, 8) >>>
    c_imp := m1.add_clip(imp_clip) >>>
    v_imp := m1.play(c_imp, 0, 1.0, 0.0, false) >>>
    $pr := mix.default_spatial_3d_params(fm.vec3(5.0, 0.0, 0.0), fm.vec3(0.0, 0.0, 0.0), fm.vec3(1.0, 0.0, 0.0), fm.vec3(0.0, 0.0, -1.0))
    res_r := mix.spatial_3d_advanced(&pr)
    assert(res_r.itd_frames > 15)
    m1.apply_spatial_3d(v_imp, &res_r) >>>

    pcm_itd := m1.render(128) >>>
    $first_l := -1
    $first_r := -1
    for i in 0:128 {
        if first_l < 0 && math.abs(f64(pcm_itd[i * 2])) > 100.0 { first_l = i }
        if first_r < 0 && math.abs(f64(pcm_itd[i * 2 + 1])) > 100.0 { first_r = i }
    }
    assert(first_r == 0 && first_l == res_r.itd_frames)

    // 4. Doppler pitch-shifted waveform has more zero crossings on approach
    sine_a := make_sine_clip(rate, 4096, 440.0, 10000.0)
    $m2 := mix.new_mixer(rate, 8) >>>
    cs := m2.add_clip(sine_a) >>>
    va := m2.play(cs, 0, 1.0, 0.0, true) >>>
    m2.set_pitch(va, 1.5) >>>
    out_fast := m2.render(1024) >>>
    sine_b := make_sine_clip(rate, 4096, 440.0, 10000.0)
    $m3 := mix.new_mixer(rate, 8) >>>
    cs3 := m3.add_clip(sine_b) >>>
    vb := m3.play(cs3, 0, 1.0, 0.0, true) >>>
    out_norm := m3.render(1024) >>>
    $zc_fast := 0
    $zc_norm := 0
    for i in 1:1024 {
        if out_fast[(i - 1) * 2] <= 0 && out_fast[i * 2] > 0 { zc_fast += 1 }
        if out_norm[(i - 1) * 2] <= 0 && out_norm[i * 2] > 0 { zc_norm += 1 }
    }
    assert(zc_fast > zc_norm)

    // 5. Occlusion low-pass & head shadow attenuate high-frequency content
    hf_a := make_square_high_freq_clip(rate, 4096, 8000.0, 12000)
    $m4 := mix.new_mixer(rate, 8) >>>
    ch4 := m4.add_clip(hf_a) >>>
    v4 := m4.play(ch4, 0, 1.0, 0.0, true) >>>
    unocc := m4.render(512) >>>
    hf_b := make_square_high_freq_clip(rate, 4096, 8000.0, 12000)
    $m5 := mix.new_mixer(rate, 8) >>>
    ch5 := m5.add_clip(hf_b) >>>
    v5 := m5.play(ch5, 0, 1.0, 0.0, true) >>>
    m5.set_voice_lowpass(v5, 500.0, 500.0) >>>
    occ_blk := m5.prepare(512) >>>
    m5.commit(&occ_blk) >>>
    $e_un := 0.0
    $e_oc := 0.0
    for i in 0:512 {
        e_un += math.abs(f64(unocc[i * 2]))
        e_oc += math.abs(f64(occ_blk.samples[i * 2]))
    }
    assert(e_oc < e_un * 0.25 && m4.is_playing(v4))

    println("PASS: spatial_audio_checks")
    << 0
}

fn main() int {
    run() >>> (err) {
        println("FAIL: " + err.msg())
        << 1
    }
    << 0
}
