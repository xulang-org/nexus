@main

#gpu

gpu_info #"github.com/xulang-org/nexus/platform/gpu"

mesh_shaders #"github.com/xulang-org/nexus/assets/shaders/three_d"

meshes #"github.com/xulang-org/nexus/resources/mesh"

ren #"github.com/xulang-org/nexus/rendering/three_d"
scene_render #"github.com/xulang-org/nexus/integration/rendering/three_d"
colors #"github.com/xulang-org/nexus/foundation/color"
fm #"github.com/xulang-org/nexus/foundation/math"
nexus #"github.com/xulang-org/nexus/scene"
#math

fn triangle(color int) meshes.MeshData3D {
    $mesh := meshes.new_mesh_data_3d()
    mesh.vertex(fm.vec3(-1.0, -1.0, 0.0), color) >>>
    mesh.vertex(fm.vec3(1.0, -1.0, 0.0), color) >>>
    mesh.vertex(fm.vec3(0.0, 1.0, 0.0), color) >>>
    mesh.triangle(0, 1, 2) >>>
    << mesh
}
fn attach_rejected(scene $&scene_render.Scene3D, tree &nexus.SceneTree, node int, mesh &ren.Mesh3D) bool {
    scene.attach_mesh(tree, node, mesh) >>> (err) { << true }
    << false
}
fn draw_rejected(scene &scene_render.Scene3D, device $&ren.Device3D, tree &nexus.SceneTree, view fm.Mat4) bool {
    scene.draw(device, tree, view) >>> (err) { << true }
    << false
}
fn run() int {
    mesh_program_0 := mesh_shaders.load_mesh("build/mesh-shaders") >>>
    $device := ren.open_3d("Xu 3D scene validation", 256, 256, gpu.AUTO, &mesh_program_0) >>>
    backend := device.backend() >>>
    println("Scene GPU backend: " + gpu_info.backend_name(backend))
    red := colors.rgba8(255, 0, 0, 255) >>>
    blue := colors.rgba8(0, 0, 255, 255) >>>
    background := colors.rgba8(16, 24, 32, 255) >>>
    red_source := triangle(red) >>>
    blue_source := triangle(blue) >>>
    $red_mesh := device.upload(&red_source) >>>
    $blue_mesh := device.upload(&blue_source) >>>
    $tree := nexus.new_scene_tree_3d("World", 16) >>>
    root := tree.root()
    parent := tree.add_child_3d(root, "Parent") >>>
    tree.set_position_3d(parent, fm.vec3(0.0, 0.0, -2.0)) >>>
    group := tree.add_group(parent, "Group") >>>
    near_node := tree.add_child_3d(group, "Near") >>>
    far_node := tree.add_child_3d(root, "Far") >>>
    tree.set_transform_3d(far_node, fm.translation_3d(fm.vec3(0.0, 0.0, -4.0)).multiply(fm.scale_3d(fm.vec3(2.0, 2.0, 2.0)))) >>>
    rig := tree.add_child_3d(root, "CameraRig") >>>
    camera_node := tree.add_child_3d(rig, "Camera") >>>
    $camera := nexus.new_camera_node_3d(&tree, camera_node) >>>
    camera.vertical_fov = math.pi() / 2.0
    view := camera.view_projection(&tree, 1.0) >>>
    $scene := scene_render.new_scene_3d(&device) >>>
    scene.attach_mesh(&tree, near_node, &red_mesh) >>>
    scene.attach_mesh(&tree, far_node, &blue_mesh) >>>
    scene.attach_mesh(&tree, near_node, &red_mesh) >>>
    assert(scene.binding_count() == 2)
    assert(attach_rejected($&scene, &tree, group, &red_mesh))
    device.begin(background) >>>
    counts := scene.draw($&device, &tree, view) >>>
    assert(counts.instances == 2 && counts.triangles == 2)
    assert((device.read_pixel(128, 128) >>>) == red)
    device.present() >>>
    tree.set_visible(parent, false) >>>
    device.begin(background) >>>
    hidden := scene.draw($&device, &tree, view) >>>
    assert(hidden.instances == 1 && (device.read_pixel(128, 128) >>>) == blue)
    device.present() >>>
    tree.set_visible(parent, true) >>>
    assert(scene.detach_mesh(far_node) >>> == 1)
    assert(scene.detach_mesh(far_node) >>> == 0)
    tree.set_position_3d(parent, fm.vec3(1.4, 0.0, -2.0)) >>>
    device.begin(background) >>>
    moved := scene.draw($&device, &tree, view) >>>
    assert(moved.instances == 1 && (device.read_pixel(128, 128) >>>) == background)
    assert((device.read_pixel(217, 150) >>>) == red)
    device.present() >>>
    tree.set_position_3d(rig, fm.vec3(1.4, 0.0, 0.0)) >>>
    follow_view := camera.view_projection(&tree, 1.0) >>>
    tree.paused = true
    assert(!(tree.can_process(near_node) >>>))
    device.begin(background) >>>
    scene.draw($&device, &tree, follow_view) >>>
    assert((device.read_pixel(128, 128) >>>) == red)
    device.capture("build/gpu3d-scene-camera.png") >>>
    device.present() >>>
    tree.queue_free(parent) >>>
    assert(attach_rejected($&scene, &tree, near_node, &red_mesh))
    device.begin(background) >>>
    queued := scene.draw($&device, &tree, follow_view) >>>
    assert(queued.instances == 0 && (device.read_pixel(128, 128) >>>) == background)
    device.present() >>>
    freed := tree.flush_free() >>>
    assert(freed.len == 3 && freed[0] == near_node)
    replacement_parent := tree.add_child_3d(root, "ReplacementParent") >>>
    replacement_group := tree.add_group(replacement_parent, "Group") >>>
    replacement := tree.add_child_3d(replacement_group, "Near") >>>
    tree.set_position_3d(replacement, fm.vec3(1.4, 0.0, -2.0)) >>>
    assert(replacement != near_node)
    device.begin(background) >>>
    reused := scene.draw($&device, &tree, follow_view) >>>
    assert(reused.instances == 0 && (device.read_pixel(128, 128) >>>) == background)
    device.present() >>>
    assert((scene.prune(&tree) >>>) == 1 && scene.binding_count() == 0)
    scene.attach_mesh(&tree, replacement, &red_mesh) >>>
    red_mesh.close() >>>
    $fresh_mesh := device.upload(&blue_source) >>>
    device.begin(background) >>>
    assert(draw_rejected(&scene, $&device, &tree, follow_view))
    device.present() >>>
    assert(attach_rejected($&scene, &tree, replacement, &red_mesh))
    scene.attach_mesh(&tree, replacement, &fresh_mesh) >>>
    device.begin(background) >>>
    scene.draw($&device, &tree, follow_view) >>>
    assert((device.read_pixel(128, 128) >>>) == blue)
    device.present() >>>
    // Another live GPU device cannot consume this scene or its resources.
    mesh_program_1 := mesh_shaders.load_mesh("build/mesh-shaders") >>>
    $other := ren.open_3d("Foreign device validation", 128, 128, gpu.AUTO, &mesh_program_1) >>>
    $foreign_mesh := other.upload(&blue_source) >>>
    assert(attach_rejected($&scene, &tree, replacement, &foreign_mesh))
    assert(draw_rejected(&scene, $&other, &tree, follow_view))
    foreign_mesh.close() >>>
    other.close() >>>
    scene.detach_mesh(replacement) >>>
    // Detach never closes the owning GPU resource.
    device.begin(background) >>>
    device.draw(&fresh_mesh, view.multiply(fm.translation_3d(fm.vec3(0.0, 0.0, -2.0)))) >>>
    assert((device.read_pixel(128, 128) >>>) == blue)
    device.present() >>>
    fresh_mesh.close() >>>
    blue_mesh.close() >>>
    device.close() >>>
    println("PASS: scene GPU hierarchy, visibility, camera rig, pause rendering, deletion, node/mesh generation reuse, pruning, detach ownership, foreign devices")
    << 0
}
fn main() int { << run() >>> (err) { eprintln(err.msg())
    << 1 } }
