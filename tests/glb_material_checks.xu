@main

gltf #"github.com/xulang-org/nexus/formats/gltf"
assets #"github.com/xulang-org/nexus/assets/gltf"
#os
#strings
#math

fn rejected(raw &string, needle &string) bool {
    gltf.decode_glb_geometry(raw) or (err) {
        message := err.msg()
        if !strings.contains(&message, *needle) { println("Wrong material error: " + message + " expected " + *needle)
            << false }
        << true
    }
    << false
}
fn run() int {
    source := assets.load_glb_geometry("build/glb-material-fixtures/all.glb") or >>
    assert(source.material_count() == 1 && source.texture_count() == 5 && source.image_count() == 5)
    assert((source.primitive_material(0) or >>) == 0)
    material := source.material(0) or >>
    assert(material.base.x == 1.0 && material.alpha == 1.0 && material.metallic == 0.0 && material.roughness == 1.0)
    assert(material.base_texture == 0 && material.metallic_roughness_texture == 1 && material.occlusion_texture == 2 && material.normal_texture == 3 && material.emission_texture == 4)
    assert(material.normal_scale == 1.0 && material.occlusion_strength == 1.0 && material.emission.x == 0.25 && !material.double_sided)
    sampler := source.texture_sampler(0) or >>
    assert(sampler.min_filter == 9728 && sampler.mag_filter == 9728 && sampler.wrap_u == 33071 && sampler.wrap_v == 33071)
    raw_png := source.image_bytes(0) or >>
    assert(raw_png.len > 33 && raw_png[0] == 137 && raw_png[1] == 80)
    default_asset := assets.load_glb_geometry("build/glb-material-fixtures/default.glb") or >>
    assert(default_asset.material_count() == 0 && (default_asset.primitive_material(0) or >>) == -1)
    empty := assets.load_glb_geometry("build/glb-material-fixtures/empty-pbr.glb") or >>
    defaults := empty.material(0) or >>
    assert(defaults.base.x == 1.0 && defaults.metallic == 1.0 && defaults.roughness == 1.0 && defaults.emission.x == 0.0 && !defaults.double_sided)
    panel := assets.load_glb_geometry("examples/glb_materials/assets/panels.glb") or >>
    assert(panel.material_count() == 8 && panel.primitive_count() == 8 && panel.image_count() == 5)
    default_sampling := panel.texture_sampler(0) or >>
    assert(default_sampling.min_filter == 9987 && default_sampling.mag_filter == 9729 && default_sampling.wrap_u == 10497 && default_sampling.wrap_v == 10497)
    failures := os.read("build/glb-material-fixtures/reject-list.txt") or >>
    rows := strings.split(&failures, "\n")
    $checked := 0
    for row in rows {
        if row.len == 0 { -> }
        pieces := strings.split(&row, "|")
        raw := os.read("build/glb-material-fixtures/" + pieces[0]) or >>
        if !rejected(&raw, &pieces[1]) { println("Material case failed: " + pieces[0])
            assert(false) }
        checked = checked + 1
    }
    println("PASS: pure GLB material/image/sampler descriptors, defaults, source assignment and " + str(checked) + " strict profile rejection cases")
    << 0
}
fn main() int { << run() or (err) { eprintln(err.msg())
    << 1 } }
