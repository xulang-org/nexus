@main
gltf #"github.com/xulang-org/nexus/formats/gltf"
fm #"github.com/xulang-org/nexus/foundation/math"
#os
#math
#strings
fn rejected(raw &string) bool { gltf.decode_glb_geometry(raw) >>> (err){ << true }
    << false }
fn bad_sample(asset &gltf.GlbGeometry,index int,time f64) bool { asset.sample_pose(index,time) >>> (err){ << true }
    << false }
fn close(a f64,b f64) bool { << math.abs(a-b)<0.000001 }
fn run() int {
    root := "build/gltf-animation-fixtures/"
    raw := os.read(root+"analytic.glb") >>>
    asset := gltf.decode_glb_geometry(&raw) >>>
    assert(asset.animation_count()==5 && asset.skin_count()==1)
    for clip in 0:3 {
        for time in [-1.0,0.0,0.25,0.5,1.0,2.0] {
            locals := asset.sample_pose(clip,time) >>>
            worlds := asset.world_pose(&locals) >>>
            palette := asset.skin_palette(2,&worlds) >>>
            skin := asset.skin_matrix(0,0,&palette) >>>
            $t := math.max(0.0,math.min(time,1.0))
            if clip==1 { if time<1.0 { t=0.0 } else { t=1.0 } }
            if clip==2 { t=3.0*t*t-2.0*t*t*t }
            assert(close(skin.c3.x,2.0*t) && skin.c3.y==0.0)
        }
    }
    r := asset.sample_pose(3,0.5) >>>
    p := r[1].transform(fm.vec4(1.0,0.0,0.0,1.0))
    assert(close(p.x,0.0) && close(p.y,1.0))
    shortest := asset.sample_pose(4,0.5) >>>
    assert(close(shortest[1].c0.x,1.0) && close(shortest[1].c1.y,1.0))
    rest := asset.sample_pose(-1,100.0) >>>
    assert(rest[1].c3.x==0.0)
    assert(bad_sample(&asset,-2,0.0) && bad_sample(&asset,5,0.0) && bad_sample(&asset,0,math.float64_from_bits(9221120237041090560)))
    list := os.read(root+"reject-list.txt") >>>
    $count := 0
    for name in strings.split(&list,"\n") { if name.len==0 { -> }
        bytes := os.read(root+name) >>>
        assert(rejected(&bytes))
        count+=1 }
    unresolved := os.read(root+"external.glb") >>>
    $decoded := gltf.decode_glb_geometry(&unresolved) >>>
    before := decoded.content_hash()
    png := os.read(root+"Textures/map.png") >>>
    decoded.resolve_image(0,&png) >>>
    assert((decoded.image_bytes(0) >>>).len>8 && before!=decoded.content_hash())
    println("PASS: analytic LINEAR/STEP/cubic, shortest-arc rotations, clamped/rest/invalid samples, skin palette and external-image fingerprint; "+str(count)+" malformed animation/skin/URI inputs")
    << 0
}
fn main() int { << run() >>> (err){ eprintln(err.msg())
    << 1 } }
