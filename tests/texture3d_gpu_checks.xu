@main

light_data #"github.com/xulang-org/nexus/resources/lighting"

#gpu

gpu_info #"github.com/xulang-org/nexus/platform/gpu"

mesh_shaders #"github.com/xulang-org/nexus/assets/shaders/three_d"

meshes #"github.com/xulang-org/nexus/resources/mesh"

ren #"github.com/xulang-org/nexus/rendering/three_d"
fm #"github.com/xulang-org/nexus/foundation/math"
scene_render #"github.com/xulang-org/nexus/integration/rendering/three_d"
nexus #"github.com/xulang-org/nexus/scene"
assets #"github.com/xulang-org/nexus/assets/gltf"
glb #"github.com/xulang-org/nexus/integration/gltf_render"
#math

fn quad(uv fm.Vec2, varying bool, flags int, color int) meshes.MeshData3D {
    $data := meshes.new_mesh_data_3d()
    positions := [fm.vec3(-1.0, 1.0, 0.5), fm.vec3(1.0, 1.0, 0.5), fm.vec3(1.0, -1.0, 0.5), fm.vec3(-1.0, -1.0, 0.5)]
    coordinates := [fm.vec2(0.0, 0.0), fm.vec2(1.0, 0.0), fm.vec2(1.0, 1.0), fm.vec2(0.0, 1.0)]
    for i in 0:4 {
        $point := uv
        if varying { point = coordinates[i] }
        if flags == 3 { data.vertex_lit_uv(positions[i], color, fm.vec3(0.0, 0.0, 1.0), point) >>>
        } else if flags == 2 { data.vertex_uv(positions[i], color, point) >>>
        } else if flags == 1 || (flags == 4 && i == 3) { data.vertex_lit(positions[i], color, fm.vec3(0.0, 0.0, 1.0)) >>>
        } else if flags == 4 { data.vertex_lit_uv(positions[i], color, fm.vec3(0.0, 0.0, 1.0), point) >>>
        } else { data.vertex(positions[i], color) >>> }
    }
    data.triangle(0, 2, 1) >>>
    data.triangle(0, 3, 2) >>>
    << data
}
fn channel(pixel int, index int) int {
    if index == 0 { << pixel / 16777216 % 256 }
    if index == 1 { << pixel / 65536 % 256 }
    << pixel / 256 % 256
}
fn check(pixel int, red int, green int, blue int) {
    expected := [red, green, blue]
    for i in 0:3 { assert(math.abs(f64(channel(pixel, i) - expected[i])) <= 2.0) }
    assert(pixel % 256 == 255)
}
fn sample(device $&ren.Device3D, mesh &ren.Mesh3D, material &ren.Material3D, light &light_data.Environment3D) int {
    device.begin(255) >>>
    device.draw_material(mesh, fm.identity_3d(), fm.identity_3d(), material, light) >>>
    pixel := device.read_pixel(32, 32) >>>
    device.present() >>>
    << pixel
}
fn rejected(device $&ren.Device3D, mesh &ren.Mesh3D, material &ren.Material3D, light &light_data.Environment3D) bool {
    device.draw_material(mesh, fm.identity_3d(), fm.identity_3d(), material, light) >>> (err) { << true }
    << false
}
fn bad_upload(device &ren.Device3D, width int, height int, pixels &[]int) bool {
    device.texture_rgba(width, height, pixels, true, false, false) >>> (err) { << true }
    << false
}
fn bad_set(scene $&scene_render.Scene3D, tree &nexus.SceneTree, node int, material ren.Material3D) bool {
    scene.set_material(tree, node, material) >>> (err) { << true }
    << false
}
fn bad_replace(scene $&scene_render.Scene3D, tree &nexus.SceneTree, node int, mesh &ren.Mesh3D) bool {
    scene.attach_mesh(tree, node, mesh) >>> (err) { << true }
    << false
}
fn bad_uv(data $&meshes.MeshData3D) bool {
    data.vertex_lit_uv(fm.vec3(0.0, 0.0, 0.0), 4294967295, fm.vec3(0.0, 0.0, 1.0), fm.vec2(1000001.0, 0.0)) >>> (err) { << true }
    << false
}
fn stale_bind(material &ren.Material3D, texture &ren.Texture3D) bool {
    material.with_base_texture(texture) >>> (err) { << true }
    << false
}
fn texture_budget() int {
    mesh_program_0 := mesh_shaders.load_mesh("build/mesh-shaders") >>>
    $device := ren.open_3d("Texture budget checks", 32, 32, gpu.AUTO, &mesh_program_0) >>>
    $pixels := []int{}
    for i in 0:4194304 { pixels.push(4294967295) }
    $textures := []ren.Texture3D{}
    for i in 0:4 { textures.push(device.texture_rgba(2048, 2048, &pixels, true, false, false) >>>) }
    single := [4294967295]
    assert(bad_upload(&device, 1, 1, &single))
    first := $&textures[0]
    first.close() >>>
    $after := device.texture_rgba(1, 1, &single, true, false, false) >>>
    device.close() >>>
    after.close() >>>
    << 0
}
fn texture_capacity() int {
    mesh_program_1 := mesh_shaders.load_mesh("build/mesh-shaders") >>>
    $device := ren.open_3d("Texture capacity checks", 32, 32, gpu.AUTO, &mesh_program_1) >>>
    pixels := [4294967295]
    $textures := []ren.Texture3D{}
    for i in 0:512 { textures.push(device.texture_rgba(1, 1, &pixels, true, false, false) >>>) }
    assert(bad_upload(&device, 1, 1, &pixels))
    first := $&textures[0]
    first.close() >>>
    $after := device.texture_rgba(1, 1, &pixels, true, false, false) >>>
    device.close() >>>
    after.close() >>>
    << 0
}
fn run() int {
    mesh_program_2 := mesh_shaders.load_mesh("build/mesh-shaders") >>>
    $device := ren.open_3d("Xu base texture GPU checks", 64, 64, gpu.AUTO, &mesh_program_2) >>>
    println("Texture GPU checks backend: " + gpu_info.backend_name(device.backend() >>>))
    zero := fm.vec3(0.0, 0.0, 0.0)
    white := fm.vec3(1.0, 1.0, 1.0)
    material := ren.material_3d(white, 0.0, 1.0, zero) >>>
    light := light_data.environment(white, fm.vec3(0.0, 0.0, 2.0), 1.0, [light_data.directional(fm.vec3(0.0, 0.0, 1.0), zero) >>>]) >>>
    $source := quad(fm.vec2(0.5, 0.5), true, 3, 4294967295) >>>
    before := source.vertex_count()
    assert(bad_uv($&source) && source.vertex_count() == before)
    $mesh := device.upload(&source) >>>
    $pixels := [2155905279]
    $srgb := device.texture_rgba(1, 1, &pixels, true, false, false) >>>
    $linear := device.texture_rgba(1, 1, &pixels, false, false, false) >>>
    srgb_material := material.with_base_texture(&srgb) >>>
    linear_material := material.with_base_texture(&linear) >>>
    // Independent reference: sRGB(128/255) decodes to 0.21586, then
    // Reinhard + sRGB output yields 117. Linear 128/255 yields 156.
    check(sample($&device, &mesh, &srgb_material, &light) >>>, 117, 117, 117)
    check(sample($&device, &mesh, &linear_material, &light) >>>, 156, 156, 156)
    pixels[0] = 4294967295
    check(sample($&device, &mesh, &srgb_material, &light) >>>, 117, 117, 117)
    $quadrants := [4278190335, 16711935, 65535, 4294967295]
    $corners := device.texture_rgba(2, 2, &quadrants, true, false, false) >>>
    corner_material := material.with_base_texture(&corners) >>>
    device.begin(255) >>>
    device.draw_material(&mesh, fm.identity_3d(), fm.identity_3d(), &corner_material, &light) >>>
    check(device.read_pixel(16, 16) >>>, 188, 0, 0)
    check(device.read_pixel(48, 16) >>>, 0, 188, 0)
    check(device.read_pixel(16, 48) >>>, 0, 0, 188)
    check(device.read_pixel(48, 48) >>>, 188, 188, 188)
    device.present() >>>
    $bw := [255, 4294967295]
    $filtered := device.texture_rgba(2, 1, &bw, true, true, false) >>>
    filtered_material := material.with_base_texture(&filtered) >>>
    middle_source := quad(fm.vec2(0.5, 0.5), false, 3, 4294967295) >>>
    $middle := device.upload(&middle_source) >>>
    // Black/white sRGB texels must be filtered AFTER decoding, yielding
    // linear 0.5 -> 156. Filtering encoded bytes first would yield 117.
    check(sample($&device, &middle, &filtered_material, &light) >>>, 156, 156, 156)
    $rg := [4278190335, 16711935]
    $clamped := device.texture_rgba(2, 1, &rg, true, false, false) >>>
    $repeated := device.texture_rgba(2, 1, &rg, true, false, true) >>>
    clamp_material := material.with_base_texture(&clamped) >>>
    repeat_material := material.with_base_texture(&repeated) >>>
    for u in [1.25, -0.75] {
        outside_source := quad(fm.vec2(u, 0.5), false, 3, 4294967295) >>>
        $outside := device.upload(&outside_source) >>>
        check(sample($&device, &outside, &repeat_material, &light) >>>, 188, 0, 0)
        if u > 0.0 { check(sample($&device, &outside, &clamp_material, &light) >>>, 0, 188, 0)
        } else { check(sample($&device, &outside, &clamp_material, &light) >>>, 188, 0, 0) }
    }
    // Both sampler axes, alpha ignored by the opaque pipeline.
    $alpha_pixels := [4278190080, 65535]
    $vertical := device.texture_rgba(1, 2, &alpha_pixels, true, false, true) >>>
    vertical_material := material.with_base_texture(&vertical) >>>
    v_source := quad(fm.vec2(0.5, 1.25), false, 3, 4294967295) >>>
    $v_mesh := device.upload(&v_source) >>>
    check(sample($&device, &v_mesh, &vertical_material, &light) >>>, 188, 0, 0)
    // Switch textured -> plain material -> old vertex colors in one frame.
    device.begin(255) >>>
    device.draw_material(&mesh, fm.translation_3d(fm.vec3(0.0, 0.0, -0.2)), fm.identity_3d(), &corner_material, &light) >>>
    device.draw_material(&mesh, fm.identity_3d(), fm.identity_3d(), &material, &light) >>>
    check(device.read_pixel(32, 32) >>>, 188, 188, 188)
    device.present() >>>
    device.begin(255) >>>
    device.draw_material(&mesh, fm.identity_3d(), fm.identity_3d(), &corner_material, &light) >>>
    device.draw(&mesh, fm.translation_3d(fm.vec3(0.0, 0.0, 0.2))) >>>
    check(device.read_pixel(32, 32) >>>, 255, 255, 255)
    device.present() >>>
    $tree := nexus.new_scene_tree_3d("Textures", 16) >>>
    node := tree.add_child_3d(tree.root(), "Quad") >>>
    $scene := scene_render.new_scene_3d(&device) >>>
    scene.attach_mesh(&tree, node, &mesh) >>>
    scene.set_material(&tree, node, corner_material) >>>
    for flags in [0, 1, 2, 4] {
        bad_source := quad(fm.vec2(0.0, 0.0), false, flags, 4294967295) >>>
        $bad_mesh := device.upload(&bad_source) >>>
        assert(bad_replace($&scene, &tree, node, &bad_mesh))
        other_node := tree.add_child_3d(tree.root(), "Missing attributes" + str(flags)) >>>
        scene.attach_mesh(&tree, other_node, &bad_mesh) >>>
        assert(bad_set($&scene, &tree, other_node, corner_material))
        scene.detach_mesh(other_node) >>>
        device.begin(255) >>>
        assert(rejected($&device, &bad_mesh, &corner_material, &light))
        draws := scene.draw_lit($&device, &tree, fm.identity_3d(), &light) >>>
        assert(draws.instances == 1)
        check(device.read_pixel(16, 16) >>>, 188, 0, 0)
        device.present() >>>
    }
    mesh_program_3 := mesh_shaders.load_mesh("build/mesh-shaders") >>>
    $other := ren.open_3d("Foreign texture owner", 64, 64, gpu.AUTO, &mesh_program_3) >>>
    $foreign := other.texture_rgba(1, 1, &pixels, true, false, false) >>>
    foreign_material := material.with_base_texture(&foreign) >>>
    assert(bad_set($&scene, &tree, node, foreign_material))
    device.begin(255) >>>
    assert(rejected($&device, &mesh, &foreign_material, &light))
    assert(bad_upload(&device, 1, 1, &pixels))
    device.present() >>>
    assert(bad_upload(&device, 0, 1, &pixels) && bad_upload(&device, 4097, 1, &pixels) && bad_upload(&device, 2, 2, &pixels))
    bad_pixels := [-1]
    assert(bad_upload(&device, 1, 1, &bad_pixels))
    bad_pixels2 := [4294967296]
    assert(bad_upload(&device, 1, 1, &bad_pixels2))
    srgb.close() >>>
    srgb.close() >>>
    $reused := device.texture_rgba(1, 1, &pixels, true, false, false) >>>
    assert(stale_bind(&material, &srgb))
    assert(bad_set($&scene, &tree, node, srgb_material))
    device.begin(255) >>>
    assert(rejected($&device, &mesh, &srgb_material, &light))
    device.present() >>>
    // Imported geometry must retain UV values, not just a presence flag.
    asset := assets.load_glb_geometry("build/glb-fixtures/triangle.glb") >>>
    $imported := glb.upload_primitive(&device, &asset, 0) >>>
    $fade_pixels := [255, 4294967295]
    $fade_texture := device.texture_rgba(2, 1, &fade_pixels, true, true, false) >>>
    fade_material := material.with_base_texture(&fade_texture) >>>
    projection := nexus.perspective_3d(math.pi() / 2.0, 1.0, 0.1, 100.0) >>>
    device.begin(255) >>>
    device.draw_material(&imported, fm.translation_3d(fm.vec3(0.0, 0.0, -2.0)), projection, &fade_material, &light) >>>
    check(device.read_pixel(32, 32) >>>, 159, 0, 0)
    device.present() >>>
    // Odd row widths and three distinct image rows expose upload pitch bugs.
    $odd_pixels := []int{}
    for color in [4278190335, 16711935, 65535] {
        for column in 0:7 { odd_pixels.push(color) }
    }
    $odd := device.texture_rgba(7, 3, &odd_pixels, true, false, false) >>>
    odd_material := material.with_base_texture(&odd) >>>
    for row in 0:3 {
        odd_source := quad(fm.vec2(0.5, (f64(row) + 0.5) / 3.0), false, 3, 4294967295) >>>
        $odd_mesh := device.upload(&odd_source) >>>
        pixel := sample($&device, &odd_mesh, &odd_material, &light) >>>
        if row == 0 { check(pixel, 188, 0, 0) }
        if row == 1 { check(pixel, 0, 188, 0) }
        if row == 2 { check(pixel, 0, 0, 188) }
    }
    assert(!material.has_base_texture() && corner_material.has_base_texture() && !corner_material.without_base_texture().has_base_texture())
    // Releasing device first invalidates children safely even after slot reuse.
    other.close() >>>
    mesh_program_4 := mesh_shaders.load_mesh("build/mesh-shaders") >>>
    $replacement := ren.open_3d("Reused device slot", 64, 64, gpu.AUTO, &mesh_program_4) >>>
    foreign.close() >>>
    replacement.close() >>>
    device.close() >>>
    corners.close() >>>
    reused.close() >>>
    texture_budget() >>>
    texture_capacity() >>>
    println("PASS: 64 MiB budget/512-texture capacity recovery, odd row pitch, sRGB/linear sampling, decode-before-filter, UV orientation/repeat/clamp, opaque alpha, state switching, GLB UV upload, scene preflight, stale/foreign resources and lifetime/bounds")
    << 0
}
fn main() int { << run() >>> (err) { eprintln(err.msg())
    << 1 } }
