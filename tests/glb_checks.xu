@main

gltf #"github.com/xulang-org/nexus/formats/gltf"
fm #"github.com/xulang-org/nexus/foundation/math"
assets #"github.com/xulang-org/nexus/assets/gltf"
nexus #"github.com/xulang-org/nexus/scene"
#os
#strings
#math

fn near(a f64, b f64) bool { << math.abs(a - b) < 0.00001 }
fn rejected(raw &string, needle &string) bool {
    gltf.decode_glb_geometry(raw) >>> (err) {
        message := err.msg()
        if !strings.contains(&message, *needle) { eprintln("Wrong error: " + message + " expected " + *needle)
            << false }
        << true
    }
    << false
}
fn instance_rejected(asset &gltf.GlbGeometry, tree $&nexus.SceneTree, name string) bool {
    root := tree.root()
    assets.instantiate(asset, tree, root, name) >>> (err) { << true }
    << false
}
fn bad_quaternion() bool { fm.quaternion(0.0, 0.0, 0.0, 0.0).rotation_matrix() >>> (err) { << true }
    << false }
fn missing_normal(asset &gltf.GlbGeometry) bool { asset.normal(0, 0) >>> (err) { << true }
    << false }
fn run() int {
    assert(math.float32_from_bits(1065353216) == 1.0)
    assert(math.float32_from_bits(3212836864) == -1.0)
    smallest := math.float32_from_bits(1)
    assert(smallest == math.ldexp(1.0, -149))
    largest := math.float32_from_bits(2139095039)
    assert(largest == math.ldexp(2.0 - 1.0 / 8388608.0, 127))
    q := fm.quaternion(0.0, 0.0, math.sqrt(0.5), math.sqrt(0.5)).rotation_matrix() >>>
    rotated := q.transform(fm.vec4(1.0, 0.0, 0.0, 1.0))
    assert(near(rotated.x, 0.0) && near(rotated.y, 1.0) && bad_quaternion())
    asset := assets.load_glb_geometry("build/glb-fixtures/triangle.glb") >>>
    expected_hash := os.read("build/glb-fixtures/triangle.sha256") >>>
    assert(asset.content_hash() == expected_hash)
    assert(asset.mesh_count() == 1 && asset.primitive_count() == 1 && asset.node_count() == 3)
    assert((asset.vertex_count(0) >>>) == 3 && (asset.index_count(0) >>>) == 3)
    position := asset.position(0, 2) >>>
    normal := asset.normal(0, 2) >>>
    uv := asset.uv(0, 2) >>>
    assert(position.x == 0.0 && position.y == 1.0 && normal.z == 1.0 && uv.x == 0.5 && uv.y == 1.0)
    assert((asset.color(0, 0) >>>) == 4278190335 && (asset.index(0, 2) >>>) == 2)
    assert(!(asset.has_tangents(0) >>>))
    for name in ["tangents", "tangents-mirrored", "tangents-exporter-basis"] {
        tangent_asset := assets.load_glb_geometry("build/glb-fixtures/" + name + ".glb") >>>
        assert(tangent_asset.has_tangents(0) >>>)
        tangent := tangent_asset.tangent(0, 2) >>>
        assert(tangent.x == 1.0 && tangent.y == 0.0 && tangent.z == 0.0)
        if name != "tangents-mirrored" { assert(tangent.w == 1.0)
        } else { assert(tangent.w == -1.0) }
    }
    $tree := nexus.new_scene_tree_3d("World", 100) >>>
    root := tree.root()
    a := assets.instantiate(&asset, $&tree, root, "A") >>>
    b := assets.instantiate(&asset, $&tree, root, "B") >>>
    assert(a.primitive_count() == 1 && (a.source_node(2) >>>) == 0)
    source_name := asset.node_name(0) >>>
    assert(source_name == "Root/name")
    a_node := a.source_node(1) >>>
    b_node := b.source_node(1) >>>
    a_primitive := a.primitive_node(0) >>>
    world := tree.global_transform_3d(a_primitive) >>>
    assert(world.c3.z == -2.0)
    tree.set_position_3d(a_node, fm.vec3(3.0, 4.0, 5.0)) >>>
    unchanged := tree.global_transform_3d(b_node) >>>
    assert(unchanged.c3.x == 0.0 && unchanged.c3.z == -2.0)
    before := tree.subtree(root) >>>
    assert(instance_rejected(&asset, $&tree, "A"))
    after := tree.subtree(root) >>>
    assert(before.len == after.len)
    $small := nexus.new_scene_tree_3d("Small", 2) >>>
    assert(instance_rejected(&asset, $&small, "NoRoom"))
    small_nodes := small.subtree(small.root()) >>>
    assert(small_nodes.len == 1)
    for name in ["index-5121", "index-5123", "index-5125", "nonindexed", "rgb", "color16", "colorfloat", "uv16", "uv8", "unknown-chunk", "default-scene", "matrix", "depth64", "extras-metadata"] {
        variant := assets.load_glb_geometry("build/glb-fixtures/" + name + ".glb") >>>
        assert((variant.vertex_count(0) >>>) == 3 && (variant.index(0, 2) >>>) == 2)
        $expected := 4278190335
        if name == "color16" || name == "colorfloat" { expected = 2164211967 }
        assert((variant.color(0, 0) >>>) == expected)
    }
    uv16 := assets.load_glb_geometry("build/glb-fixtures/uv16.glb") >>>
    uv8 := assets.load_glb_geometry("build/glb-fixtures/uv8.glb") >>>
    point16 := uv16.uv(0, 1) >>>
    point8 := uv8.uv(0, 1) >>>
    assert(math.abs(point16.x - 32768.0 / 65535.0) < 0.0000000001 && point16.y == 1.0)
    assert(math.abs(point8.x - 128.0 / 255.0) < 0.0000000001 && point8.y == 1.0)
    matrix_asset := assets.load_glb_geometry("build/glb-fixtures/matrix.glb") >>>
    matrix := matrix_asset.node_transform(1) >>>
    assert(matrix.c0.x == 2.0 && matrix.c1.y == 3.0 && matrix.c2.z == -4.0 && matrix.c3.x == 1.0 && matrix.c3.z == -2.0)
    deepest := assets.load_glb_geometry("build/glb-fixtures/depth64.glb") >>>
    $deep_tree := nexus.new_scene_tree_3d("Deep", 128) >>>
    deep_root := deep_tree.root()
    deep_instance := assets.instantiate(&deepest, $&deep_tree, deep_root, "Model") >>>
    assert(deep_instance.primitive_count() == 1 && (deep_instance.source_node(64) >>>) > 0)
    no_attributes := assets.load_glb_geometry("build/glb-fixtures/positions-only.glb") >>>
    assert(!(no_attributes.has_normals(0) >>>) && !(no_attributes.has_uvs(0) >>>))
    assert((no_attributes.color(0, 0) >>>) == 4294967295 && missing_normal(&no_attributes))
    trs := assets.load_glb_geometry("build/glb-fixtures/trs.glb") >>>
    $trs_tree := nexus.new_scene_tree_3d("TRS", 16) >>>
    trs_root := trs_tree.root()
    trs_instance := assets.instantiate(&trs, $&trs_tree, trs_root, "Model") >>>
    trs_node := trs_instance.source_node(1) >>>
    trs_world := trs_tree.global_transform_3d(trs_node) >>>
    point := trs_world.transform(fm.vec4(1.0, 0.0, 0.0, 1.0))
    assert(near(point.x, 2.0) && near(point.y, 6.0) && near(point.z, 2.0))
    scene_one := assets.load_glb_geometry("build/glb-fixtures/scene-one.glb") >>>
    $one_tree := nexus.new_scene_tree_3d("One", 16) >>>
    one_root := one_tree.root()
    selected := assets.instantiate(&scene_one, $&one_tree, one_root, "Selected") >>>
    assert((selected.source_node(0) >>>) == 0 && (selected.source_node(2) >>>) > 0)
    tower := assets.load_glb_geometry("examples/glb_preview/assets/tower.glb") >>>
    assert(tower.mesh_count() == 2 && tower.primitive_count() == 3 && tower.node_count() == 8)
    $tower_tree := nexus.new_scene_tree_3d("Tower", 100) >>>
    tower_root := tower_tree.root()
    tower_instance := assets.instantiate(&tower, $&tower_tree, tower_root, "Model") >>>
    assert(tower_instance.primitive_count() == 11 && (tower_instance.source_node(7) >>>) == 0)
    failures := os.read("build/glb-fixtures/reject-list.txt") >>>
    rows := strings.split(&failures, "\n")
    $checked := 0
    for row in rows {
        if row.len == 0 { -> }
        pieces := strings.split(&row, "|")
        raw := os.read("build/glb-fixtures/" + pieces[0]) >>>
        if !rejected(&raw, &pieces[1]) { eprintln("Case failed: " + pieces[0])
            assert(false) }
        checked = checked + 1
    }
    println("PASS: GLB container/accessors, 3 index widths, colors/UV encodings, normal/UV preservation, matrix/TRS, scene selection, independent instances, atomic failure; rejected " + str(checked) + " malformed/unsupported assets")
    << 0
}
fn main() int { << run() >>> (err) { eprintln(err.msg())
    << 1 } }
