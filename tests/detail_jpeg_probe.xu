@main
#os
images #"github.com/xulang-org/nexus/assets/image"
fn run() int {
    args := os.args()
    raw := os.read(args[1]+"") >>>
    image := images.decode_jpeg(&raw,4194304) >>>
    println("JPEG "+str(image.width)+"x"+str(image.height)+" pixels="+str(image.pixels.len))
    << 0
}
fn main() int { << run() >>> (err){ eprintln(err.msg())
    << 1 } }
