@main
worlds #"github.com/xulang-org/nexus/integration/scene_audio"
#os

fn run() int {
    args := os.args()
    assert(args.len == 4)
    if args[1] == "write" {
        $world := worlds.load(args[2] + "", 8000) >>>
        samples := world.render(2) >>>
        assert(samples[0] == 250 && samples[2] == -250 && (world.position_frames(0) >>>) == 2.0)
        world.save(args[3] + "") >>>
        println("saved")
    } else {
        $world := worlds.load(args[3] + "", 8000) >>>
        assert(world.clip_count() == 1 && world.bus_count() == 2 && (world.position_frames(0) >>>) == 0.0)
        assert((world.render(1) >>>)[0] == 250)
        println("loaded")
    }
    << 0
}
fn main() int { << run() >>> (err) { eprintln(err.msg())
    << 1 } }
