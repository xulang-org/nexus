@main

codec #"github.com/xulang-org/nexus/formats/scene"
resource #"github.com/xulang-org/nexus/resources/scene"
#os
#strings

fn rejected(raw &string) bool { codec.decode(raw) >>> (err) { << true }
    << false }
fn exceeds_json_budget(document &resource.Document) bool {
    codec.encode(document) >>> (err) {
        message := err.msg()
        << strings.contains(&message, "JSON node budget")
    }
    << false
}
fn run() int {
    raw := os.read("build/scene-asset-fixtures/base.xuscene") >>>
    document := codec.decode(&raw) >>>
    assert(document.node_count() == 2 && document.resource_count() == 1 && document.surface_count() == 1)
    reference := document.resource(0) >>>
    assert(reference.uid == "11001100110011001100110011001100" && reference.path == "base.glb" && reference.kind == "glb_model")
    surface := document.surface(0) >>>
    assert(surface.node == 1 && surface.primitive == 0 && surface.resource_uid == reference.uid)
    canonical := codec.encode(&document) >>>
    restored := codec.decode(&canonical) >>>
    assert(canonical == (codec.encode(&restored) >>>))
    original := os.read("examples/scene_assets/assets/world.xuscene") >>>
    gallery := codec.decode(&original) >>>
    assert(gallery.node_count() == 10 && gallery.surface_count() == 8 && gallery.resource_count() == 1)
    lod_raw := os.read("build/scene-asset-fixtures/lod-authored.xuscene") >>>
    lod_document := codec.decode(&lod_raw) >>>
    assert(lod_document.surface_count() == 1 && lod_document.resource_count() == 2)
    $lod_surface := lod_document.surface(0) >>>
    assert(lod_surface.levels.len == 1 && lod_surface.levels[0].resource_uid == (lod_document.resource(1) >>>).uid)
    policy := lod_surface.distance_policy() >>>
    assert((policy.threshold(0) >>>) == 2.123456789012345 && policy.hysteresis() == 0.125)
    edited := $&lod_surface.levels[0]
    edited.distance = 3.0
    assert((lod_document.surface(0) >>>).levels[0].distance == 2.123456789012345)
    lod_canonical := codec.encode(&lod_document) >>>
    assert(strings.contains(&lod_canonical, "\"version\":6"))
    lod_restored := codec.decode(&lod_canonical) >>>
    assert(lod_canonical == (codec.encode(&lod_restored) >>>))
    // A maximum-size document shares one source model across all surface nodes.
    $nodes := []resource.NodeData{}
    $surfaces := []resource.Surface{}
    for i in 0:4096 {
        $parent := 0
        if i == 0 { parent = -1 }
        nodes.push(resource.node(parent, "n" + str(i), resource.NODE_3D))
        surfaces.push(resource.surface(i, reference.uid + "", 0))
    }
    plain := resource.make_document(nodes) >>>
    largest := resource.with_attachments(&plain, [reference], surfaces, []resource.AudioBus{}, []resource.AudioEmitter{}, []resource.ScriptAttachment{}, []resource.ScriptConnection{}, []resource.LightAttachment{}) >>>
    largest_raw := codec.encode(&largest) >>>
    largest_loaded := codec.decode(&largest_raw) >>>
    assert(largest_loaded.surface_count() == 4096 && largest_loaded.node_count() == 4096)
    dense_reference := largest_loaded.resource(0) >>>
    $dense_lods := []resource.Surface{}
    for i in 0:plain.node_count() {
        uid := dense_reference.uid + ""
        $surface := resource.surface(i, uid + "", 0)
        surface.levels.push(resource.SurfaceLevel{distance: 2.0, resource_uid: uid, primitive: 0})
        dense_lods.push(surface)
    }
    dense := resource.with_attachments(&plain, [dense_reference], dense_lods, []resource.AudioBus{}, []resource.AudioEmitter{},
        []resource.ScriptAttachment{}, []resource.ScriptConnection{}, []resource.LightAttachment{}) >>>
    assert(exceeds_json_budget(&dense))
    failures := os.read("build/scene-asset-fixtures/reject-list.txt") >>>
    rows := strings.split(&failures, "\n")
    $count := 0
    for row in rows {
        if row.len == 0 { -> }
        bad := os.read("build/scene-asset-fixtures/" + row) >>>
        if !rejected(&bad) { println("Accepted invalid resource scene: " + row)
            assert(false) }
        count = count + 1
    }
    println("PASS: pinned resource/surface and LOD descriptors, canonical roundtrip, original PBR gallery, 4096 shared surfaces and " + str(count) + " strict rejection cases")
    << 0
}
fn main() int { << run() >>> (err) { eprintln(err.msg())
    << 1 } }
