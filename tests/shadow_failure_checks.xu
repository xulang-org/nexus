@main
#gpu
#os
fm #"github.com/xulang-org/nexus/foundation/math"
policy #"github.com/xulang-org/nexus/resources/shadow"
mesh #"github.com/xulang-org/nexus/resources/mesh"
lights #"github.com/xulang-org/nexus/resources/lighting"
ren #"github.com/xulang-org/nexus/rendering/three_d"
shaders #"github.com/xulang-org/nexus/assets/shaders/three_d"
fn failed_render(shadow $&ren.ShadowMap3D,device &ren.Device3D,casters &[]ren.ShadowCaster3D,description policy.ShadowDescription3D) bool {
    shadow.render(device,casters,description) >>>(err){ assert(err.msg()=="gpu: injected consumed submit failure")
        << true }
    << false
}
fn failed_create(device &ren.Device3D,description policy.ShadowDescription3D,program &ren.ShadowProgram3D) bool {
    device.shadow_map(description,program) >>>(err){ assert(err.msg()=="gpu: injected depth allocation failure")
        << true }
    << false
}
fn frame(device $&ren.Device3D,receiver &ren.Mesh3D,shadow &ren.ShadowMap3D,env &lights.Environment3D,vp fm.Mat4) string {
    binding := shadow.binding(env,0) >>>
    material := ren.material_3d(fm.vec3(0.6,0.6,0.6),0.0,0.8,fm.vec3(0.0,0.0,0.0)) >>>
    device.begin(255) >>>
    device.draw_material_shadowed_reference(receiver.reference(),fm.identity_3d(),vp,&material,env,&binding) >>>
    device.capture("build/shadow-fault.png") >>>
    device.present() >>>
    << os.read("build/shadow-fault.png") >>>
}
fn run() int {
    args := os.args()
    program := shaders.load_mesh("build/mesh-shaders") >>>
    shadow_program := shaders.load_shadow("build/mesh-shaders") >>>
    $device := ren.open_3d("Shadow failure recovery",64,64,gpu.METAL,&program) >>>
    $data := mesh.new_mesh_data_3d()
    for p in [fm.vec3(-0.6,-0.6,0.5),fm.vec3(0.6,-0.6,0.5),fm.vec3(0.6,0.6,0.5),fm.vec3(-0.6,0.6,0.5)] { data.vertex_lit(p,4294967295,fm.vec3(0.0,0.0,1.0)) >>> }
    data.triangle(0,1,2) >>>
    data.triangle(0,2,3) >>>
    $receiver := device.upload(&data) >>>
    sources := [lights.directional(fm.vec3(0.0,0.0,1.0),fm.vec3(3.0,3.0,3.0)) >>>,
        lights.spot(fm.vec3(0.0,0.0,4.0),fm.vec3(0.0,0.0,-1.0),fm.vec3(48.0,48.0,48.0),8.0,0.35,0.6) >>>,
        lights.point(fm.vec3(0.0,0.0,4.0),fm.vec3(48.0,48.0,48.0),8.0) >>>,
        lights.directional(fm.vec3(0.0,0.0,1.0),fm.vec3(3.0,3.0,3.0)) >>>]
    for i in 0:sources.len {
        source := sources[i]
        $vp := fm.identity_3d()
        $description := policy.directional(fm.vec3(0.0,0.0,0.0),fm.vec3(0.0,0.0,1.0),2.0,6.0,128) >>>
        if source.kind()==lights.SPOT { description=policy.spot(source,0.1,128) >>> }
        if source.kind()==lights.POINT { description=policy.point(source,0.1,128) >>> }
        if i==3 {
            projection := fm.Mat4{c0: fm.vec4(1.0,0.0,0.0,0.0),c1: fm.vec4(0.0,1.0,0.0,0.0),c2: fm.vec4(0.0,0.0,0.1/7.9,-1.0),c3: fm.vec4(0.0,0.0,0.8/7.9,0.0)}
            view := fm.translation_3d(fm.vec3(0.0,0.0,-4.0))
            vp=projection.multiply(view)
            camera := policy.cascade_camera(view,projection) >>>
            $settings := policy.default_cascades()
            settings.resolution=128
            settings.distance=8.0
            settings.caster_padding=3.0
            description=policy.cascaded(source,camera,settings) >>>
        }
        $shadow := device.shadow_map(description,&shadow_program) >>>
        env := lights.environment(fm.vec3(0.08,0.08,0.08),fm.vec3(0.0,0.0,4.0),1.0,[source]) >>>
        initial := [ren.shadow_caster(receiver.reference(), fm.translation_3d(fm.vec3(0.0,0.0,1.0)))]
        moved := [ren.shadow_caster(receiver.reference(), fm.translation_3d(fm.vec3(1.5,0.0,1.0)))]
        shadow.render(&device,&initial,description) >>>
        baseline := frame($&device,&receiver,&shadow,&env,vp) >>>
        write_file(args[1]+"","submit") >>>
        assert(failed_render($&shadow,&device,&moved,description))
        after := frame($&device,&receiver,&shadow,&env,vp) >>>
        assert(after==baseline)
        write_file(args[2]+"","depth") >>>
        assert(failed_create(&device,description,&shadow_program))
        after_allocation := frame($&device,&receiver,&shadow,&env,vp) >>>
        assert(after_allocation==baseline)
        $recovered := device.shadow_map(description,&shadow_program) >>>
        recovered.close() >>>
        shadow.render(&device,&moved,description) >>>
        next := frame($&device,&receiver,&shadow,&env,vp) >>>
        assert(next!=baseline)
        shadow.close() >>>
    }
    receiver.close() >>>
    device.close() >>>
    println("PASS: directional/spot/point/cascaded injected shadow submit/depth-allocation failures retain previous map PNG and recover next map render")
    << 0
}
fn main() int { << run() >>>(err){ eprintln(err.msg())
    << 1 } }
