@main
#gpu
#os
assets #"github.com/xulang-org/nexus/assets/gltf"
gltf #"github.com/xulang-org/nexus/formats/gltf"
glb #"github.com/xulang-org/nexus/integration/gltf_render"
nexus #"github.com/xulang-org/nexus/scene"
fm #"github.com/xulang-org/nexus/foundation/math"
light #"github.com/xulang-org/nexus/resources/lighting"
ren #"github.com/xulang-org/nexus/rendering/three_d"
bridge #"github.com/xulang-org/nexus/integration/rendering/three_d"
shaders #"github.com/xulang-org/nexus/assets/shaders/three_d"
fn capture(device $&ren.Device3D,scene &bridge.Scene3D,tree &nexus.SceneTree,path string) string {
    view := nexus.look_at_3d(fm.vec3(0.0,0.0,4.0),fm.vec3(0.0,0.0,0.0),fm.vec3(0.0,1.0,0.0)) >>>
    projection := nexus.perspective_3d(1.0471975511965976,4.0/3.0,0.1,100.0) >>>
    source := light.directional(fm.vec3(0.0,0.0,1.0),fm.vec3(4.0,4.0,4.0)) >>>
    env := light.environment(fm.vec3(0.2,0.2,0.2),fm.vec3(0.0,0.0,4.0),1.0,[source]) >>>
    device.begin(202515967) >>>
    report := scene.draw_lit(device,tree,projection.multiply(view),&env) >>>
    assert(report.instances==2 && report.triangles==2)
    device.capture(path+"") >>>
    device.present() >>>
    << os.read(path) >>>
}
fn fails(player $&glb.GlbAnimated3D,device &ren.Device3D,scene $&bridge.Scene3D,tree $&nexus.SceneTree,
    asset &gltf.GlbGeometry,instance &assets.GlbInstance,clip int,time f64) bool {
    player.sample(device,scene,tree,asset,instance,clip,time) >>>(err){ << true }
    << false
}
fn run() int {
    asset := assets.load_glb_geometry("build/gltf-animation-fixtures/analytic.glb") >>>
    program := shaders.load_mesh("build/mesh-shaders") >>>
    $device := ren.open_3d("Animation isolation",256,192,gpu.AUTO,&program) >>>
    $foreign := ren.open_3d("Foreign device",64,64,gpu.AUTO,&program) >>>
    $tree := nexus.new_scene_tree_3d("World",64) >>>
    root := tree.root()
    a := assets.instantiate(&asset,$&tree,root,"A") >>>
    b := assets.instantiate(&asset,$&tree,root,"B") >>>
    tree.set_transform_3d(a.root,fm.translation_3d(fm.vec3(-0.8,0.0,0.0))) >>>
    tree.set_transform_3d(b.root,fm.translation_3d(fm.vec3(0.5,0.0,0.0))) >>>
    $scene := bridge.new_scene_3d(&device) >>>
    $first := glb.upload_animated(&device,&asset) >>>
    $second := glb.upload_animated(&device,&asset) >>>
    first.sample(&device,$&scene,$&tree,&asset,&a,0,0.0) >>>
    second.sample(&device,$&scene,$&tree,&asset,&b,0,0.25) >>>
    baseline := capture($&device,&scene,&tree,"build/animation-baseline.png") >>>
    assert(fails($&first,&device,$&scene,$&tree,&asset,&a,100,0.0) >>>)
    assert(fails($&first,&foreign,$&scene,$&tree,&asset,&a,0,0.5) >>>)
    after := capture($&device,&scene,&tree,"build/animation-after-failures.png") >>>
    assert(after==baseline)
    first.sample(&device,$&scene,$&tree,&asset,&a,0,0.25) >>>
    changed := capture($&device,&scene,&tree,"build/animation-changed.png") >>>
    assert(changed!=baseline)
    assert((tree.node_3d(b.source_node(1) >>>) >>>).transform.c3.x==0.5)
    tree.queue_free(a.source_node(1) >>>) >>>
    assert(fails($&first,&device,$&scene,$&tree,&asset,&a,0,0.75) >>>)
    unchanged := capture($&device,&scene,&tree,"build/animation-pending-node.png") >>>
    assert(unchanged==changed)
    first.close() >>>
    second.close() >>>
    foreign.close() >>>
    device.close() >>>
    println("PASS: real GPU independent skinned instances, visible posed vertices, invalid clip/foreign device/pending-node rejection preserve accepted pixels and bindings")
    << 0
}
fn main() int { << run() >>>(err){ eprintln(err.msg())
    << 1 } }
