@main
#gpu
#os
assets #"github.com/xulang-org/nexus/assets/gltf"
gltf #"github.com/xulang-org/nexus/formats/gltf"
glb #"github.com/xulang-org/nexus/integration/gltf_render"
nexus #"github.com/xulang-org/nexus/scene"
fm #"github.com/xulang-org/nexus/foundation/math"
light #"github.com/xulang-org/nexus/resources/lighting"
ren #"github.com/xulang-org/nexus/rendering/three_d"
bridge #"github.com/xulang-org/nexus/integration/rendering/three_d"
shaders #"github.com/xulang-org/nexus/assets/shaders/three_d"
fn capture(device $&ren.Device3D,scene &bridge.Scene3D,tree &nexus.SceneTree,path string) string {
    view := nexus.look_at_3d(fm.vec3(0.0,0.0,4.0),fm.vec3(0.0,0.0,0.0),fm.vec3(0.0,1.0,0.0)) or >>
    projection := nexus.perspective_3d(1.0471975511965976,4.0/3.0,0.1,100.0) or >>
    source := light.directional(fm.vec3(0.0,0.0,1.0),fm.vec3(4.0,4.0,4.0)) or >>
    env := light.environment(fm.vec3(0.2,0.2,0.2),fm.vec3(0.0,0.0,4.0),1.0,[source]) or >>
    device.begin(202515967) or >>
    report := scene.draw_lit(device,tree,projection.multiply(view),&env) or >>
    assert(report.instances==2 && report.triangles==2)
    device.capture(path+"") or >>
    device.present() or >>
    << os.read(path) or >>
}
fn fails(player $&glb.GlbAnimated3D,device &ren.Device3D,scene $&bridge.Scene3D,tree $&nexus.SceneTree,
    asset &gltf.GlbGeometry,instance &assets.GlbInstance,clip int,time f64) bool {
    player.sample(device,scene,tree,asset,instance,clip,time) or(err){ << true }
    << false
}
fn run() int {
    asset := assets.load_glb_geometry("build/gltf-animation-fixtures/analytic.glb") or >>
    program := shaders.load_mesh("build/mesh-shaders") or >>
    $device := ren.open_3d("Animation isolation",256,192,gpu.AUTO,&program) or >>
    $foreign := ren.open_3d("Foreign device",64,64,gpu.AUTO,&program) or >>
    $tree := nexus.new_scene_tree_3d("World",64) or >>
    root := tree.root()
    a := assets.instantiate(&asset,$&tree,root,"A") or >>
    b := assets.instantiate(&asset,$&tree,root,"B") or >>
    tree.set_transform_3d(a.root,fm.translation_3d(fm.vec3(-0.8,0.0,0.0))) or >>
    tree.set_transform_3d(b.root,fm.translation_3d(fm.vec3(0.5,0.0,0.0))) or >>
    $scene := bridge.new_scene_3d(&device) or >>
    $first := glb.upload_animated(&device,&asset) or >>
    $second := glb.upload_animated(&device,&asset) or >>
    first.sample(&device,$&scene,$&tree,&asset,&a,0,0.0) or >>
    second.sample(&device,$&scene,$&tree,&asset,&b,0,0.25) or >>
    baseline := capture($&device,&scene,&tree,"build/animation-baseline.png") or >>
    assert(fails($&first,&device,$&scene,$&tree,&asset,&a,100,0.0) or >>)
    assert(fails($&first,&foreign,$&scene,$&tree,&asset,&a,0,0.5) or >>)
    after := capture($&device,&scene,&tree,"build/animation-after-failures.png") or >>
    assert(after==baseline)
    first.sample(&device,$&scene,$&tree,&asset,&a,0,0.25) or >>
    changed := capture($&device,&scene,&tree,"build/animation-changed.png") or >>
    assert(changed!=baseline)
    assert((tree.node_3d(b.source_node(1) or >>) or >>).transform.c3.x==0.5)
    tree.queue_free(a.source_node(1) or >>) or >>
    assert(fails($&first,&device,$&scene,$&tree,&asset,&a,0,0.75) or >>)
    unchanged := capture($&device,&scene,&tree,"build/animation-pending-node.png") or >>
    assert(unchanged==changed)
    first.close() or >>
    second.close() or >>
    foreign.close() or >>
    device.close() or >>
    println("PASS: real GPU independent skinned instances, visible posed vertices, invalid clip/foreign device/pending-node rejection preserve accepted pixels and bindings")
    << 0
}
fn main() int { << run() or(err){ eprintln(err.msg())
    << 1 } }
