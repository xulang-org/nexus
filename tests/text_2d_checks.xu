@main
#os
#gpu
#window
#errors
#math
font #ui/font
fm #"github.com/xulang-org/nexus/foundation/math"
present #"github.com/xulang-org/nexus/platform/present"
canvas #"github.com/xulang-org/nexus/resources/canvas"
texts #"github.com/xulang-org/nexus/resources/text"
meshes #"github.com/xulang-org/nexus/resources/mesh"
lights #"github.com/xulang-org/nexus/resources/lighting"
nexus #"github.com/xulang-org/nexus/scene"
shaders2 #"github.com/xulang-org/nexus/assets/shaders/two_d"
shaders3 #"github.com/xulang-org/nexus/assets/shaders/three_d"
ren2 #"github.com/xulang-org/nexus/rendering/two_d"
ren3 #"github.com/xulang-org/nexus/rendering/three_d"
bridge3 #"github.com/xulang-org/nexus/integration/rendering/three_d"

const PX_BLACK = 255
const PX_WHITE = 4294967295
const PX_RED = 4278190335
const PX_YELLOW = 4294902015
const PX_NAVY = 270020863
const PX_PANEL = 539971839
const PX_BANNER = 270018780

fn px_r(c int) int { << (c >> 24) & 255 }
fn px_g(c int) int { << (c >> 16) & 255 }
fn px_b(c int) int { << (c >> 8) & 255 }
fn px_a(c int) int { << c & 255 }

fn mode_tag(mode_id int) string {
    if mode_id == present.MODE_GPU { << "gpu" }
    if mode_id == present.MODE_SOFTWARE { << "software" }
    << "headless"
}

fn rejects_submit_text(r $&ren2.Renderer2D, batch &canvas.Batch2D, mask &ren2.MaskTexture2D) bool {
    r.submit_text(batch, mask) >>> (err) { << true }
    << false
}

fn rejects_sync_mask(mask $&ren2.MaskTexture2D, r &ren2.Renderer2D, w int, h int, bytes &[]u8, rev int) bool {
    mask.sync_r8(r, w, h, bytes, rev) >>> (err) { << true }
    << false
}

fn rejects_invalid_utf8(stack &font.FontStack) bool {
    opts := font.default_options(16.0)
    txt := string_from_bytes([255, 254])
    font.layout_text(stack, &txt, &opts) >>> (err) { << true }
    << false
}

fn rejects_bad_color(layout &font.TextLayout, stack &font.FontStack, atlas $&font.GlyphAtlas) bool {
    $b := canvas.new_batch()
    texts.append_layout_quads($&b, layout, stack, atlas, fm.vec2(0.0, 0.0), fm.identity(), -1) >>> (err) { << true }
    << false
}

fn rejects_nan_origin(layout &font.TextLayout, stack &font.FontStack, atlas $&font.GlyphAtlas) bool {
    $b := canvas.new_batch()
    nan := 0.0 / 0.0
    texts.append_layout_quads($&b, layout, stack, atlas, fm.vec2(nan, 0.0), fm.identity(), PX_WHITE) >>> (err) { << true }
    << false
}

fn count_bright_pixels(r $&ren2.Renderer2D, x0 int, y0 int, w int, h int, min_luma int) int {
    $hits := 0
    for py in y0:(y0 + h) {
        for px in x0:(x0 + w) {
            c := r.read_pixel(px, py) >>>
            luma := (px_r(c) + px_g(c) + px_b(c)) / 3
            if luma >= min_luma { hits += 1 }
        }
    }
    << hits
}

fn count_exact_pixels(r $&ren2.Renderer2D, x0 int, y0 int, w int, h int, expected int) int {
    $hits := 0
    for py in y0:(y0 + h) {
        for px in x0:(x0 + w) {
            c := r.read_pixel(px, py) >>>
            if c == expected { hits += 1 }
        }
    }
    << hits
}

fn count_soft_bright(sess &present.Session, x0 int, y0 int, w int, h int, min_luma int) int {
    $hits := 0
    for py in y0:(y0 + h) {
        for px in x0:(x0 + w) {
            c := sess.read_software_pixel(px, py) >>>
            luma := (px_r(c) + px_g(c) + px_b(c)) / 3
            if luma >= min_luma { hits += 1 }
        }
    }
    << hits
}

fn check_resources_text_unit() int {
    $stack := font.new_font_stack()
    stack.ensure_builtin_fallback(1)
    assert(stack.resolve(65).glyph_id >= 0)

    $small_atlas := font.new_glyph_atlas(64, 64, 256, 256) >>>
    $empty_batch := canvas.new_batch()
    spaces := "   "
    opts := font.default_options(20.0)
    sp_layout := font.layout_text(&stack, &spaces, &opts) >>>
    emitted_sp := texts.append_layout_quads($&empty_batch, &sp_layout, &stack, $&small_atlas,
        fm.vec2(0.0, 0.0), fm.identity(), PX_WHITE) >>>
    assert(emitted_sp == 0)
    assert(empty_batch.vertex_count() == 0)
    assert(rejects_invalid_utf8(&stack))
    assert(rejects_bad_color(&sp_layout, &stack, $&small_atlas))
    assert(rejects_nan_origin(&sp_layout, &stack, $&small_atlas))

    // Trigger atlas growth mid-layout and confirm every quad UV matches post-grow atlas entries
    $grow_atlas := font.new_glyph_atlas(64, 64, 512, 512) >>>
    long_str := "0123456789ABCDEFGH"
    $grow_batch := canvas.new_batch()
    grow_layout := texts.draw_string_quads($&grow_batch, &long_str, &stack, $&grow_atlas,
        fm.vec2(4.0, 4.0), 28.0, PX_WHITE) >>>
    assert(grow_atlas.width > 64 || grow_atlas.height > 64)
    assert(grow_batch.vertex_count() == grow_layout.glyph_count() * 6)
    for gi in 0:grow_layout.glyph_count() {
        g := grow_layout.glyph_at(gi)
        rg := font.ResolvedGlyph{face_index: g.face_index, font_id: g.font_id, glyph_id: g.glyph_id}
        entry := grow_atlas.get_or_rasterize(&stack, rg, grow_layout.size) >>>
        v0 := grow_batch.vertex_at(gi * 6) >>>
        assert(math.abs(v0.uv.x - entry.u0) < 1.0e-9)
        assert(math.abs(v0.uv.y - entry.v0) < 1.0e-9)
    }
    << 0
}

fn check_2d_text(expect int, canvas_prog &ren2.ShaderProgram2D,
    sdf_prog &ren2.SdfProgram2D, text_prog &ren2.TextProgram2D, font_path &string) int {
    wopts := window.Options{title: "Text 2D " + mode_tag(expect), width: 192, height: 160,
        resizable: false, high_pixel_density: false, hidden: true}
    $r := ren2.open_2d_window_adaptive(wopts, gpu.AUTO, canvas_prog) >>>
    assert((r.backend_mode() >>>) == expect)
    r.enable_sdf(sdf_prog) >>>
    r.enable_text(text_prog) >>>

    $stack := font.new_font_stack()
    stack.ensure_builtin_fallback(1)
    $atlas := font.new_glyph_atlas(64, 64, 512, 512) >>>

    // Frame 1: SDF panel + builtin text + clipped yellow text line.
    $b_title := canvas.new_batch()
    title_str := "OX 12"
    texts.draw_string_quads($&b_title, &title_str, &stack, $&atlas,
        fm.vec2(16.0, 18.0), 24.0, PX_WHITE) >>>
    $b_clip := canvas.new_batch()
    clip_str := "HELLO"
    texts.draw_string_quads($&b_clip, &clip_str, &stack, $&atlas,
        fm.vec2(16.0, 82.0), 28.0, PX_YELLOW) >>>

    $mask := r.mask_texture_r8(atlas.width, atlas.height, true, &atlas.pixels, atlas.revision) >>>
    assert(mask.width_px() == 64 && mask.height_px() == 64)

    r.begin(PX_NAVY) >>>
    $sdf := canvas.new_sdf_batch()
    sdf.rounded_rect(fm.rect2(8.0, 8.0, 176.0, 56.0), 6.0, PX_PANEL, 0.0, 0) >>>
    r.submit_sdf(&sdf) >>>
    r.submit_text(&b_title, &mask) >>>
    r.clip_rect(fm.rect2(16.0, 80.0, 42.0, 42.0)) >>>
    r.submit_text(&b_clip, &mask) >>>
    r.reset_clip() >>>

    title_hits := count_bright_pixels($&r, 14, 16, 120, 36, 160) >>>
    assert(title_hits >= 50)
    above_clear := count_exact_pixels($&r, 16, 9, 140, 4, PX_PANEL) >>>
    assert(above_clear == 140 * 4)
    clip_in := count_bright_pixels($&r, 16, 80, 40, 36, 150) >>>
    assert(clip_in >= 25)
    clip_out_clear := count_exact_pixels($&r, 70, 80, 100, 36, PX_NAVY) >>>
    assert(clip_out_clear == 100 * 36)

    builtin_png := "build/text-2d-builtin-" + mode_tag(expect) + ".png"
    r.capture(builtin_png + "") >>>
    r.present() >>>

    // Frame 2: Grow the same atlas and verify MaskTexture2D.sync_r8 re-uploads and renders crisp ink.
    $b_grow := canvas.new_batch()
    grow_str1 := "ABCDEFGHIJKL"
    grow_str2 := "MNOPQRSTUVWXYZ!"
    texts.draw_string_quads($&b_grow, &grow_str1, &stack, $&atlas,
        fm.vec2(8.0, 14.0), 22.0, PX_WHITE) >>>
    texts.draw_string_quads($&b_grow, &grow_str2, &stack, $&atlas,
        fm.vec2(8.0, 48.0), 20.0, PX_YELLOW) >>>
    // Regenerate line 1 quads after line 2 potentially grew atlas so UVs match grown atlas dimensions!
    b_grow.clear()
    texts.draw_string_quads($&b_grow, &grow_str1, &stack, $&atlas,
        fm.vec2(8.0, 14.0), 22.0, PX_WHITE) >>>
    texts.draw_string_quads($&b_grow, &grow_str2, &stack, $&atlas,
        fm.vec2(8.0, 48.0), 20.0, PX_YELLOW) >>>

    assert(atlas.width > 64 || atlas.height > 64)
    mask.sync_r8(&r, atlas.width, atlas.height, &atlas.pixels, atlas.revision) >>>
    assert(mask.width_px() == atlas.width && mask.height_px() == atlas.height)
    assert(mask.current_revision() == atlas.revision)

    r.begin(PX_NAVY) >>>
    r.submit_text(&b_grow, &mask) >>>
    grown_hits1 := count_bright_pixels($&r, 8, 12, 176, 32, 160) >>>
    grown_hits2 := count_bright_pixels($&r, 8, 46, 176, 32, 150) >>>
    assert(grown_hits1 >= 60 && grown_hits2 >= 60)
    grown_png := "build/text-2d-grown-" + mode_tag(expect) + ".png"
    r.capture(grown_png + "") >>>
    r.present() >>>

    // Frame 3 (optional system TTF): Arial.ttf wrapped center-aligned block.
    if font_path.len > 0 {
        raw := os.read(font_path + "") >>>
        $ttf_bytes := []u8{}
        for i in 0:raw.len { ttf_bytes.push(u8(raw[i] & 255)) }
        face := font.parse_ttf(&ttf_bytes, 0, 2) >>>
        $ttf_stack := font.new_font_stack()
        ttf_stack.add_face(face)
        ttf_stack.ensure_builtin_fallback(99)
        $ttf_atlas := font.default_glyph_atlas() >>>
        $b_ttf := canvas.new_batch()
        msg1 := "XuUI 2D"
        texts.draw_string_quads($&b_ttf, &msg1, &ttf_stack, $&ttf_atlas,
            fm.vec2(12.0, 14.0), 26.0, PX_WHITE) >>>
        msg2 := "GPU + CPU\nFallback"
        texts.draw_wrapped_quads($&b_ttf, &msg2, &ttf_stack, $&ttf_atlas,
            fm.vec2(12.0, 58.0), 18.0, 168.0, font.TEXT_CENTER, PX_YELLOW) >>>
        $ttf_mask := r.mask_texture_r8(ttf_atlas.width, ttf_atlas.height, true, &ttf_atlas.pixels, ttf_atlas.revision) >>>
        r.begin(PX_NAVY) >>>
        r.submit_text(&b_ttf, &ttf_mask) >>>
        ttf_hits := count_bright_pixels($&r, 12, 12, 168, 120, 160) >>>
        assert(ttf_hits >= 100)
        arial_png := "build/text-2d-arial-" + mode_tag(expect) + ".png"
        r.capture(arial_png + "") >>>
        r.present() >>>
        ttf_mask.close() >>>
    }

    // Closed MaskTexture2D rejection.
    mask.close() >>>
    r.begin(PX_NAVY) >>>
    assert(rejects_submit_text($&r, &b_title, &mask))
    assert(rejects_sync_mask($&mask, &r, atlas.width, atlas.height, &atlas.pixels, atlas.revision + 1))
    r.present() >>>
    r.close() >>>
    << 0
}

fn check_overlay_3d_text(expect int, mesh_prog &ren3.ShaderProgram3D,
    canvas_prog &ren2.ShaderProgram2D, sdf_prog &ren2.SdfProgram2D, text_prog &ren2.TextProgram2D) int {
    wopts := window.Options{title: "Overlay Text 3D " + mode_tag(expect), width: 160, height: 120,
        resizable: false, high_pixel_density: false, hidden: true}
    $d := ren3.open_3d_window_adaptive(wopts, gpu.AUTO, mesh_prog) >>>
    assert((d.backend_mode() >>>) == expect)

    $quad := meshes.new_mesh_data_3d()
    n := fm.vec3(0.0, 0.0, 1.0)
    quad.vertex_lit_uv(fm.vec3(-2.0, -2.0, 0.0), PX_WHITE, n, fm.vec2(0.0, 0.0)) >>>
    quad.vertex_lit_uv(fm.vec3(2.0, -2.0, 0.0), PX_WHITE, n, fm.vec2(1.0, 0.0)) >>>
    quad.vertex_lit_uv(fm.vec3(2.0, 2.0, 0.0), PX_WHITE, n, fm.vec2(1.0, 1.0)) >>>
    quad.vertex_lit_uv(fm.vec3(-2.0, 2.0, 0.0), PX_WHITE, n, fm.vec2(0.0, 1.0)) >>>
    quad.triangle(0, 1, 2) >>>
    quad.triangle(0, 2, 3) >>>
    $mesh := d.upload(&quad) >>>
    mat_red := ren3.material_3d(fm.vec3(1.0, 0.0, 0.0), 0.0, 0.8, fm.vec3(0.0, 0.0, 0.0)) >>>
    env := lights.environment(fm.vec3(1.0, 1.0, 1.0), fm.vec3(0.0, 0.0, 4.0), 1.0, []lights.Light3D{}) >>>
    view := nexus.look_at_3d(fm.vec3(0.0, 0.0, 4.0), fm.vec3(0.0, 0.0, 0.0), fm.vec3(0.0, 1.0, 0.0)) >>>
    vp := (nexus.perspective_3d(0.8, 160.0 / 120.0, 0.1, 100.0) >>>).multiply(view)

    $tree := nexus.new_scene_tree_3d("World", 8) >>>
    node := tree.add_child_3d(tree.root(), "Back") >>>
    $scene := bridge3.new_scene_3d(&d) >>>
    scene.attach_mesh(&tree, node, &mesh) >>>
    scene.set_material(&tree, node, mat_red) >>>

    psess := d.present_session() >>>
    $overlay := ren2.open_overlay(psess, canvas_prog, sdf_prog) >>>
    overlay.enable_text(psess, text_prog) >>>

    $stack := font.new_font_stack()
    stack.ensure_builtin_fallback(1)
    $atlas := font.default_glyph_atlas() >>>
    $hud_text := canvas.new_batch()
    hud_msg := "HUD 99"
    texts.draw_string_quads($&hud_text, &hud_msg, &stack, $&atlas,
        fm.vec2(14.0, 14.0), 20.0, PX_WHITE) >>>
    overlay.sync_text_mask(psess, atlas.width, atlas.height, true, &atlas.pixels, atlas.revision) >>>
    $ext_mask := ren2.mask_texture_r8_session(psess, atlas.width, atlas.height, true, &atlas.pixels, atlas.revision) >>>

    $hud_sdf := canvas.new_sdf_batch()
    hud_sdf.rounded_rect(fm.rect2(8.0, 8.0, 144.0, 34.0), 6.0, PX_BANNER, 0.0, 0) >>>
    $hud_badge := canvas.new_batch()
    hud_badge.quad(fm.rect2(12.0, 88.0, 20.0, 20.0), fm.identity(), PX_YELLOW) >>>

    // Pass 1: internal overlay.sync_text_mask
    d.begin(PX_BLACK) >>>
    scene.draw_lit($&d, &tree, vp, &env) >>>
    overlay.clear() >>>
    overlay.submit_sdf(&hud_sdf) >>>
    overlay.submit_text(&hud_text) >>>
    overlay.submit(&hud_badge) >>>

    if d.is_gpu() {
        $frame := d.begin_present_frame() >>>
        overlay.flush_gpu_frame(d.gpu_device() >>>, $&frame, 160, 120, gpu.LOAD, 0) >>>
        d.finish_present_frame($&frame) >>>
    } else {
        d.software_prepare_present() >>>
        overlay.flush_software(d.software_pixels_mut() >>>, 160, 120, false, 0) >>>
        sess := d.present_session() >>>
        bg3d := sess.read_software_pixel(100, 80) >>>
        assert(px_r(bg3d) >= 180 && px_g(bg3d) == 0 && px_b(bg3d) == 0)
        badge := sess.read_software_pixel(20, 96) >>>
        assert(badge == PX_YELLOW)
        hud_hits := count_soft_bright(sess, 12, 12, 130, 28, 170) >>>
        assert(hud_hits >= 40)
        sess.capture_software_png("build/overlay-3d-text-" + mode_tag(expect) + ".png") >>>
        d.present_software_frame() >>>
    }

    // Pass 2: external MaskTexture2D via flush_gpu_frame_with_mask / flush_software_with_mask
    d.begin(PX_BLACK) >>>
    scene.draw_lit($&d, &tree, vp, &env) >>>
    overlay.clear() >>>
    overlay.submit_sdf(&hud_sdf) >>>
    overlay.clip_rect(fm.rect2(12.0, 8.0, 56.0, 34.0)) >>>
    overlay.submit_text(&hud_text) >>>
    overlay.reset_clip() >>>

    if d.is_gpu() {
        $frame2 := d.begin_present_frame() >>>
        overlay.flush_gpu_frame_with_mask(d.gpu_device() >>>, $&frame2, 160, 120, gpu.LOAD, 0, &ext_mask) >>>
        d.finish_present_frame($&frame2) >>>
    } else {
        d.software_prepare_present() >>>
        overlay.flush_software_with_mask(d.software_pixels_mut() >>>, 160, 120, false, 0, &ext_mask) >>>
        sess := d.present_session() >>>
        clip_in := count_soft_bright(sess, 12, 12, 52, 28, 170) >>>
        clip_out := count_soft_bright(sess, 80, 12, 60, 28, 170) >>>
        assert(clip_in >= 15 && clip_out == 0)
        d.present_software_frame() >>>
    }

    ext_mask.close() >>>
    overlay.close() >>>
    mesh.close() >>>
    d.close() >>>

    // Explicit open_overlay_software standalone RGBA buffer test
    if expect != present.MODE_GPU {
        $sw_ov := ren2.open_overlay_software()
        $buf := []u8{}
        total := 128 * 64 * 4
        for i in 0:total {
            buf.push(u8(0))
        }
        $sw_mask := ren2.mask_texture_r8_software(atlas.width, atlas.height, true, &atlas.pixels, atlas.revision) >>>
        sw_ov.submit_sdf(&hud_sdf) >>>
        sw_ov.submit_text(&hud_text) >>>
        sw_ov.flush_software_with_mask($&buf, 128, 64, true, PX_NAVY, &sw_mask) >>>
        $white_cnt := 0
        for py in 12:38 {
            for px in 12:120 {
                off := (py * 128 + px) * 4
                if int(buf[off]) > 170 && int(buf[off + 1]) > 170 && int(buf[off + 2]) > 170 {
                    white_cnt += 1
                }
            }
        }
        assert(white_cnt >= 35)
        sw_mask.close() >>>
        sw_ov.close() >>>
    }
    << 0
}

fn run() int {
    args := os.args()
    $mode_arg := "gpu"
    if args.len > 1 { mode_arg = args[1] + "" }
    $font_path := ""
    if args.len > 2 { font_path = args[2] + "" }

    $mode_id := present.MODE_GPU
    if mode_arg == "gpu" {
        mode_id = present.MODE_GPU
    } else if mode_arg == "software" {
        mode_id = present.MODE_SOFTWARE
    } else if mode_arg == "headless" {
        mode_id = present.MODE_HEADLESS
    } else {
        >> errors.new("text_2d_checks: expected gpu, software, or headless")
    }

    check_resources_text_unit() >>>
    canvas_prog := shaders2.load_canvas("build/canvas-shaders") >>>
    sdf_prog := shaders2.load_ui_sdf("build/canvas-shaders") >>>
    text_prog := shaders2.load_ui_text("build/canvas-shaders") >>>
    mesh_prog := shaders3.load_mesh("build/mesh-shaders") >>>

    check_2d_text(mode_id, &canvas_prog, &sdf_prog, &text_prog, &font_path) >>>
    check_overlay_3d_text(mode_id, &mesh_prog, &canvas_prog, &sdf_prog, &text_prog) >>>
    println("PASS: 2D text mask pipeline & 3D+SDF+Text overlay verified in " + mode_arg + " mode")
    << 0
}

fn main() int {
    << run() >>> (err) {
        eprintln(err.msg())
        << 1
    }
}
