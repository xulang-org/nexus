@main

fm #"github.com/xulang-org/nexus/foundation/math"
tl #"github.com/xulang-org/nexus/animation/timeline"
#errors
#math

fn assert(ok bool, msg string) int {
    if !ok { >> errors.new("animation_timeline_checks: " + msg) }
    << 0
}

fn run() int {
    $clip := tl.new_clip("door_open", 2.0) >>>
    _ := clip.add_scalar_track("Door", "step_mode", tl.INTERP_STEP, [
        tl.ScalarKey{time: 0.0, value: 1.0, in_tangent: 0.0, out_tangent: 0.0},
        tl.ScalarKey{time: 1.0, value: 5.0, in_tangent: 0.0, out_tangent: 0.0}
    ]) >>>
    _ := clip.add_scalar_track("Door", "linear_val", tl.INTERP_LINEAR, [
        tl.ScalarKey{time: 0.0, value: 0.0, in_tangent: 0.0, out_tangent: 0.0},
        tl.ScalarKey{time: 2.0, value: 10.0, in_tangent: 0.0, out_tangent: 0.0}
    ]) >>>
    // Hermite from 0 -> 0 with positive out_tangent at t=0 and negative in_tangent at t=1 raises arch midpoint above 0.
    _ := clip.add_scalar_track("Door", "hermite_arch", tl.INTERP_CUBIC_HERMITE, [
        tl.ScalarKey{time: 0.0, value: 0.0, in_tangent: 0.0, out_tangent: 4.0},
        tl.ScalarKey{time: 1.0, value: 0.0, in_tangent: -4.0, out_tangent: 0.0}
    ]) >>>
    _ := clip.add_vec3_track("Door", "position", tl.INTERP_LINEAR, [
        tl.Vec3Key{time: 0.0, value: fm.vec3(0.0, 0.0, 0.0)},
        tl.Vec3Key{time: 2.0, value: fm.vec3(4.0, 2.0, -6.0)}
    ]) >>>
    _ := clip.add_color_track("Lamp", "color", [
        tl.ColorKey{time: 0.0, rgba: (0 << 24) | (100 << 16) | (200 << 8) | 255},
        tl.ColorKey{time: 2.0, rgba: (200 << 24) | (100 << 16) | (0 << 8) | 255}
    ]) >>>
    _ := clip.add_event(0.5, "unlock", 1.0) >>>
    _ := clip.add_event(1.5, "open_done", 2.0) >>>

    // Midpoint evaluation at t=0.5 (step=1, linear=2.5, hermite(u=0.5)=0.25*4*(0.5^2? wait dt=1, h10=0.125, h11=-0.125 -> 1.0!)).
    s_half := clip.evaluate(0.5)
    assert(math.abs(s_half.scalar_values[0] - 1.0) < 1e-9, "step keeps first key before 1.0") >>>
    assert(math.abs(s_half.scalar_values[1] - 2.5) < 1e-9, "linear at 0.5") >>>
    assert(math.abs(s_half.scalar_values[2] - 1.0) < 1e-6, "cubic hermite arch at 0.5 == 1.0") >>>

    // Color & Vec3 midpoint at t=1.0.
    s_mid := clip.evaluate(1.0)
    assert(math.abs(s_mid.vec3_values[0].x - 2.0) < 1e-9 && math.abs(s_mid.vec3_values[0].z - (-3.0)) < 1e-9, "vec3 midpoint") >>>
    mid_r := (s_mid.color_values[0] >> 24) & 255
    mid_b := (s_mid.color_values[0] >> 8) & 255
    assert(mid_r == 100 && mid_b == 100, "rgba8 channel lerp midpoint") >>>

    // Looping player crossing events cleanly across boundaries without double-firing.
    $player := tl.new_player(true)
    a1 := player.advance(&clip, 0.6) >>>
    assert(a1.fired_events.len == 1 && a1.fired_events[0].name == "unlock", "fired unlock at 0.5") >>>

    player.pause()
    a_paused := player.advance(&clip, 1.0) >>>
    assert(a_paused.fired_events.len == 0 && math.abs(player.time - 0.6) < 1e-9, "pause holds time") >>>

    player.play()
    // Advance from 0.6 by 2.0 -> crosses open_done (1.5), wraps 2.0 -> 0.6 and crosses unlock (0.5)!
    a_wrap := player.advance(&clip, 2.0) >>>
    assert(a_wrap.fired_events.len == 2, "wraparound fired both open_done and unlock") >>>
    assert(a_wrap.fired_events[0].name == "open_done" && a_wrap.fired_events[1].name == "unlock", "wrap event order") >>>

    println("PASS: animation_timeline_checks")
    << 0
}

fn main() int {
    run() >>> (err) {
        println("FAIL: " + err.msg())
        << 1
    }
    << 0
}
