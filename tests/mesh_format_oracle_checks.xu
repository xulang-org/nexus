@main
gltf #"github.com/xulang-org/nexus/formats/gltf"
files #"github.com/xulang-org/nexus/assets/mesh"
#os
#math
fn run() int {
    args := os.args()
    root := args[1]+""
    raw := os.read(root+"/icosphere.glb") >>>
    reference := gltf.decode_glb_geometry(&raw) >>>
    assert(reference.primitive_count()==1 && (reference.index_count(0) >>>)==960)
    for suffix in [".obj",".ascii.stl",".binary.stl"] {
        loaded := files.load(root+"/icosphere"+suffix) >>>
        assert(loaded.triangle_count()==320)
        for i in 0:loaded.indices.len {
            want := reference.position(0,reference.index(0,i) >>>) >>>
            got := loaded.vertices[loaded.indices[i]].position
            assert(got.x==want.x && got.y==want.y && got.z==want.z)
            normal := loaded.vertices[loaded.indices[i]].normal
            assert(math.abs(normal.dot(normal)-1.0)<0.000001)
        }
    }
    println("PASS: independently exported 320-triangle icosphere agrees in GLB/OBJ/ASCII STL/binary STL")
    << 0
}
fn main() int { << run() >>>(err){ eprintln(err.msg())
    << 1 } }
