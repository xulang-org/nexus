@main
#gpu
fm #"github.com/xulang-org/nexus/foundation/math"
policy #"github.com/xulang-org/nexus/resources/shadow"
mesh #"github.com/xulang-org/nexus/resources/mesh"
light #"github.com/xulang-org/nexus/resources/lighting"
nexus #"github.com/xulang-org/nexus/scene"
ren #"github.com/xulang-org/nexus/rendering/three_d"
bridge #"github.com/xulang-org/nexus/integration/rendering/three_d"
shaders #"github.com/xulang-org/nexus/assets/shaders/three_d"
fn run() int {
    program := shaders.load_mesh("build/mesh-shaders") or >>
    shadow_program := shaders.load_shadow("build/mesh-shaders") or >>
    $device := ren.open_3d("Shadow",800,600,gpu.METAL,&program) or >>
    device.set_render_scale(2) or >>
    direction := fm.vec3(-0.5,1.0,0.8)
    description := policy.directional(fm.vec3(0.0,0.0,0.0),direction,3.5,12.0,1024) or >>
    $shadow := device.shadow_map(description,&shadow_program) or >>
    $plane := mesh.new_mesh_data_3d()
    for p in [fm.vec3(-3.0,-0.9,-3.0),fm.vec3(-3.0,-0.9,3.0),fm.vec3(3.0,-0.9,3.0),fm.vec3(3.0,-0.9,-3.0)] { plane.vertex_lit(p,4294967295,fm.vec3(0.0,1.0,0.0)) or >> }
    plane.triangle(0,1,2) or >>
    plane.triangle(0,2,3) or >>
    sphere := mesh.sphere_mesh_3d(0.8,64,32,4294967295) or >>
    $floor := device.upload(&plane) or >>
    $ball := device.upload(&sphere) or >>
    $tree := nexus.new_scene_tree_3d("World",16) or >>
    root := tree.root()
    ground := tree.add_child_3d(root,"Ground") or >>
    object := tree.add_child_3d(root,"Sphere") or >>
    $scene := bridge.new_scene_3d(&device) or >>
    scene.attach_mesh(&tree,ground,&floor) or >>
    scene.attach_mesh(&tree,object,&ball) or >>
    scene.set_material(&tree,ground,ren.material_3d(fm.vec3(0.55,0.58,0.65),0.0,0.8,fm.vec3(0.0,0.0,0.0)) or >>) or >>
    scene.set_material(&tree,object,ren.material_3d(fm.vec3(0.6,0.15,0.05),0.0,0.3,fm.vec3(0.0,0.0,0.0)) or >>) or >>
    casters := scene.shadow_casters(&tree) or >>
    println("Shadow triangles="+str(shadow.render(&device,&casters,description) or >>))
    eye := fm.vec3(3.8,2.6,5.0)
    view := nexus.look_at_3d(eye,fm.vec3(0.0,-0.2,0.0),fm.vec3(0.0,1.0,0.0)) or >>
    projection := nexus.perspective_3d(0.8,4.0/3.0,0.1,100.0) or >>
    env := light.environment(fm.vec3(0.08,0.08,0.08),eye,1.0,[light.directional(direction,fm.vec3(3.0,3.0,3.0)) or >>]) or >>
    device.begin(202515967) or >>
    scene.draw_lit_shadowed($&device,&tree,projection.multiply(view),&env,&shadow,0) or >>
    device.capture("build/shadow-probe.png") or >>
    device.present() or >>
    shadow.close() or >>
    floor.close() or >>
    ball.close() or >>
    device.close() or >>
    << 0
}
fn main() int { << run() or(err){ eprintln(err.msg())
    << 1 } }
