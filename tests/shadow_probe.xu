@main
#gpu
fm #"github.com/xulang-org/nexus/foundation/math"
policy #"github.com/xulang-org/nexus/resources/shadow"
mesh #"github.com/xulang-org/nexus/resources/mesh"
light #"github.com/xulang-org/nexus/resources/lighting"
nexus #"github.com/xulang-org/nexus/scene"
ren #"github.com/xulang-org/nexus/rendering/three_d"
bridge #"github.com/xulang-org/nexus/integration/rendering/three_d"
shaders #"github.com/xulang-org/nexus/assets/shaders/three_d"
fn run() int {
    program := shaders.load_mesh("build/mesh-shaders") >>>
    shadow_program := shaders.load_shadow("build/mesh-shaders") >>>
    $device := ren.open_3d("Shadow",800,600,gpu.METAL,&program) >>>
    device.set_render_scale(2) >>>
    direction := fm.vec3(-0.5,1.0,0.8)
    description := policy.directional(fm.vec3(0.0,0.0,0.0),direction,3.5,12.0,1024) >>>
    $shadow := device.shadow_map(description,&shadow_program) >>>
    $plane := mesh.new_mesh_data_3d()
    for p in [fm.vec3(-3.0,-0.9,-3.0),fm.vec3(-3.0,-0.9,3.0),fm.vec3(3.0,-0.9,3.0),fm.vec3(3.0,-0.9,-3.0)] { plane.vertex_lit(p,4294967295,fm.vec3(0.0,1.0,0.0)) >>> }
    plane.triangle(0,1,2) >>>
    plane.triangle(0,2,3) >>>
    sphere := mesh.sphere_mesh_3d(0.8,64,32,4294967295) >>>
    $floor := device.upload(&plane) >>>
    $ball := device.upload(&sphere) >>>
    $tree := nexus.new_scene_tree_3d("World",16) >>>
    root := tree.root()
    ground := tree.add_child_3d(root,"Ground") >>>
    object := tree.add_child_3d(root,"Sphere") >>>
    $scene := bridge.new_scene_3d(&device) >>>
    scene.attach_mesh(&tree,ground,&floor) >>>
    scene.attach_mesh(&tree,object,&ball) >>>
    scene.set_material(&tree,ground,ren.material_3d(fm.vec3(0.55,0.58,0.65),0.0,0.8,fm.vec3(0.0,0.0,0.0)) >>>) >>>
    scene.set_material(&tree,object,ren.material_3d(fm.vec3(0.6,0.15,0.05),0.0,0.3,fm.vec3(0.0,0.0,0.0)) >>>) >>>
    casters := scene.shadow_casters(&tree) >>>
    println("Shadow triangles="+str(shadow.render(&device,&casters,description) >>>))
    eye := fm.vec3(3.8,2.6,5.0)
    view := nexus.look_at_3d(eye,fm.vec3(0.0,-0.2,0.0),fm.vec3(0.0,1.0,0.0)) >>>
    projection := nexus.perspective_3d(0.8,4.0/3.0,0.1,100.0) >>>
    env := light.environment(fm.vec3(0.08,0.08,0.08),eye,1.0,[light.directional(direction,fm.vec3(3.0,3.0,3.0)) >>>]) >>>
    device.begin(202515967) >>>
    scene.draw_lit_shadowed($&device,&tree,projection.multiply(view),&env,&shadow,0) >>>
    device.capture("build/shadow-probe.png") >>>
    device.present() >>>
    shadow.close() >>>
    floor.close() >>>
    ball.close() >>>
    device.close() >>>
    << 0
}
fn main() int { << run() >>>(err){ eprintln(err.msg())
    << 1 } }
