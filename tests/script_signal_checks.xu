@main

nexus #"github.com/xulang-org/nexus/scene"
bc #"github.com/xulang-org/nexus/script/bytecode"
vm #"github.com/xulang-org/nexus/script/vm"
host #"github.com/xulang-org/nexus/script/host"
files #"github.com/xulang-org/nexus/internal/file_snapshot"
#math
#strings

fn load(name string) bc.Module {
    raw := files.read("build/script-fixtures/" + name + ".xubc", bc.MAX_BYTES) >>>
    << bc.decode(&raw) >>>
}
fn near(a f64, b f64) bool { << math.abs(a - b) < 0.000001 }
fn execution_rejected(machine $&vm.Instance, expected string) bool {
    machine.execute(0.1, 1.0, 4096, 1024.0) >>> (err) {
        message := err.msg()
        << strings.contains(&message, expected)
    }
    << false
}
fn reload_rejected(machine $&vm.Instance) bool {
    candidate := load("signal-basic") >>>
    machine.reload(candidate) >>> (err) {
        message := err.msg()
        << strings.contains(&message, "retired signal ID")
    }
    << false
}
fn connection_rejected(script $&host.NodeScript, tree &nexus.SceneTree, name string, target int, handler string) bool {
    script.connect(tree, name, target, handler) >>> (err) { << true }
    << false
}
fn old_format_rejected() bool {
    first := old_format_file_rejected("invalid-old-format") >>>
    second := old_format_file_rejected("invalid-format-two") >>>
    third := old_format_file_rejected("invalid-format-three") >>>
    << first && second && third
}
fn old_format_file_rejected(name string) bool {
    raw := files.read("build/script-fixtures/" + name + ".xubc", bc.MAX_BYTES) >>>
    bc.decode(&raw) >>> (err) {
        message := err.msg()
        << strings.contains(&message, "magic")
    }
    << false
}
fn zero_host_rejected() bool {
    tree := nexus.new_scene_tree("Zero", 2) >>>
    $script := host.NodeScript{}
    script.collect_signals(&tree) >>> (err) { << true }
    << false
}
fn vm_checks() int {
    assert(old_format_rejected() && zero_host_rejected())
    program := load("signal-basic") >>>
    raw := program.encode() >>>
    decoded := bc.decode(&raw) >>>
    assert(decoded.fingerprint() == program.fingerprint() && decoded.signal_count() == 2)
    assert((decoded.signal_id("moved") >>>) == 11 && decoded.signal_index(12) == 1)
    $machine := vm.instantiate(decoded) >>>
    machine.execute(0.1, 1.0, 4096, 1024.0) >>>
    assert(machine.pending_signals() == 2 && machine.calls() == 1)
    first := machine.drain_signals() >>>
    assert(first.len == 2 && first[0].id == 11 && near(first[0].value, 18.0))
    assert(first[1].id == 12 && near(first[1].value, 1.0) && first[1].epoch == 1 && first[1].call == 1)
    assert((machine.drain_signals() >>>).len == 0)
    machine.execute(0.1, -1.0, 4096, 1024.0) >>>
    machine.reload(load("signal-rename") >>>) >>>
    assert(machine.has_signal(11) && machine.pending_signals() == 2 && near(machine.state(1) >>>, 2.0))
    machine.execute(0.1, 1.0, 4096, 1024.0) >>>
    mixed := machine.drain_signals() >>>
    assert(mixed.len == 3 && mixed[0].id == 11 && mixed[0].epoch == 1 && mixed[0].call == 2)
    assert(mixed[2].id == 11 && near(mixed[2].value, 36.0) && mixed[2].epoch == 2 && mixed[2].call == 3)
    machine.reload(load("signal-delete") >>>) >>>
    assert(!machine.has_signal(11) && machine.has_signal(12))
    assert((reload_rejected($&machine) >>>) && machine.epoch() == 3 && near(machine.state(1) >>>, 3.0))
    names := ["signal-fail", "signal-return-fail", "signal-limit", "signal-budget", "signal-uninitialized"]
    messages := ["division by zero", "host bound", "outbox limit", "budget exhausted", "uninitialized register"]
    for i in 0:names.len {
        $case := vm.instantiate(load("signal-basic") >>>) >>>
        case.execute(0.1, 1.0, 4096, 1024.0) >>>
        case.reload(load(names[i] + "") >>>) >>>
        assert(execution_rejected($&case, messages[i] + ""))
        assert(case.pending_signals() == 2 && case.calls() == 1 && near(case.state(1) >>>, 1.0))
        retained := case.drain_signals() >>>
        assert(retained.len == 2 && retained[0].epoch == 1 && near(retained[0].value, 18.0))
    }
    $batch := vm.instantiate(load("signal-batch") >>>) >>>
    for i in 0:4 { batch.execute(0.1, 1.0, 4096, 1024.0) >>> }
    assert(batch.pending_signals() == 128 && execution_rejected($&batch, "outbox limit"))
    assert(batch.calls() == 4 && near(batch.state(1) >>>, 4.0))
    all := batch.drain_signals() >>>
    for i in 0:all.len { assert(all[i].call == i / 32 + 1 && near(all[i].value, f64(i % 32))) }
    batch.execute(0.1, 1.0, 4096, 1024.0) >>>
    assert(batch.calls() == 5 && batch.pending_signals() == 32)
    << 0
}
fn host_checks() int {
    $tree := nexus.new_scene_tree("Signals", 16) >>>
    root := tree.root()
    source := tree.add_child(root, "Source") >>>
    target_a := tree.add_child(root, "A") >>>
    target_b := tree.add_child_3d(root, "B") >>>
    $script := host.attach(&tree, source, load("signal-basic") >>>) >>>
    a := script.connect(&tree, "moved", target_a, "on_moved") >>>
    b := script.connect(&tree, "moved", target_b, "on_moved") >>>
    halted := script.connect(&tree, "halted", target_a, "on_halted") >>>
    assert(a != b && b != halted && script.connection_count() == 3)
    assert((script.connect(&tree, "moved", target_a, "on_moved") >>>) == a)
    assert(connection_rejected($&script, &tree, "unknown", target_a, "on_moved"))
    assert(connection_rejected($&script, &tree, "moved", target_a, "bad-name"))
    script.physics_process(&tree, 0.1, 1.0) >>>
    tree.paused = true
    assert((script.physics_process(&tree, 0.1, 1.0) >>>) == 0.0 && script.calls() == 1)
    first := script.collect_signals(&tree) >>>
    assert(first.len == 3 && first[0].connection == a && first[1].connection == b && first[2].connection == halted)
    assert(first[0].source == source && first[0].target == target_a && first[0].signal == 11 && near(first[0].value, 18.0))
    assert(first[0].is_live(&tree) && first[0].handler == "on_moved")
    assert((script.collect_signals(&tree) >>>).len == 0 && script.pending_signals() == 0)
    tree.paused = false
    assert(script.disconnect(a) == 1 && script.disconnect(a) == 0)
    next_a := script.connect(&tree, "moved", target_a, "on_moved") >>>
    assert(next_a > halted)
    // Existing events and connections survive a same-ID rename/reorder.
    script.physics_process(&tree, 0.1, 1.0) >>>
    script.reload(&tree, load("signal-rename") >>>) >>>
    before := script.collect_signals(&tree) >>>
    assert(before.len == 3 && before[0].epoch == 1 && before[0].call == 2)
    assert((script.connect(&tree, "motion", target_a, "on_moved") >>>) == next_a)
    script.physics_process(&tree, 0.1, 1.0) >>>
    after := script.collect_signals(&tree) >>>
    assert(after.len == 2 && after[0].connection == b && after[1].connection == next_a && after[0].epoch == 2)
    assert(near(after[0].value, 36.0) && near(script.state(1) >>>, 3.0))
    script.physics_process(&tree, 0.1, 1.0) >>>
    script.reload(&tree, load("signal-delete") >>>) >>>
    assert(script.connection_count() == 1 && script.prune_connections(&tree) == 0)
    assert((script.collect_signals(&tree) >>>).len == 0)
    script.physics_process(&tree, 0.1, 1.0) >>>
    remaining := script.collect_signals(&tree) >>>
    assert(remaining.len == 1 && remaining[0].connection == halted)
    // Generation IDs prevent a deferred event from reaching a reused slot.
    tree.queue_free(target_a) >>>
    assert(!remaining[0].is_live(&tree))
    assert(connection_rejected($&script, &tree, "halted", target_a, "on_halted"))
    script.physics_process(&tree, 0.1, 1.0) >>>
    assert((script.collect_signals(&tree) >>>).len == 0 && script.connection_count() == 0)
    tree.flush_free() >>>
    replacement := tree.add_child(root, "Replacement") >>>
    assert(replacement != target_a && !remaining[0].is_live(&tree))
    script.connect(&tree, "halted", replacement, "on_halted") >>>
    script.physics_process(&tree, 0.1, 1.0) >>>
    tree.queue_free(source) >>>
    assert((script.collect_signals(&tree) >>>).len == 0 && script.connection_count() == 0 && script.pending_signals() == 0)
    << 0
}
fn capacity_checks() int {
    $tree := nexus.new_scene_tree("Capacity", 4) >>>
    source := tree.add_child(tree.root(), "Source") >>>
    target := tree.add_child(tree.root(), "Target") >>>
    $script := host.attach(&tree, source, load("signal-batch") >>>) >>>
    for i in 0:host.MAX_CONNECTIONS { script.connect(&tree, "moved", target, "handler_" + str(i)) >>> }
    assert(connection_rejected($&script, &tree, "moved", target, "extra"))
    for i in 0:4 { script.physics_process(&tree, 0.1, 1.0) >>> }
    deliveries := script.collect_signals(&tree) >>>
    assert(deliveries.len == 4096 && script.pending_signals() == 0)
    for i in 0:deliveries.len {
        assert(deliveries[i].connection == i % 32 + 1 && deliveries[i].call == i / 1024 + 1)
        assert(near(deliveries[i].value, f64((i / 32) % 32)))
    }
    << 0
}
fn collection_snapshot_checks() int {
    $tree := nexus.new_scene_tree("Snapshots", 4) >>>
    source := tree.add_child(tree.root(), "Source") >>>
    target := tree.add_child(tree.root(), "Target") >>>
    $script := host.attach(&tree, source, load("signal-basic") >>>) >>>
    // Connections are resolved when collecting, not when the VM emits.
    script.physics_process(&tree, 0.1, 1.0) >>>
    connection := script.connect(&tree, "moved", target, "handler") >>>
    snapshot := script.collect_signals(&tree) >>>
    assert(snapshot.len == 1 && snapshot[0].call == 1)
    assert(script.disconnect(connection) == 1 && snapshot[0].is_live(&tree))
    script.physics_process(&tree, 0.1, 1.0) >>>
    next := script.connect(&tree, "moved", target, "handler") >>>
    assert(next > connection && script.disconnect(next) == 1)
    assert((script.collect_signals(&tree) >>>).len == 0)
    script.physics_process(&tree, 0.1, 1.0) >>>
    script.connect(&tree, "moved", target, "handler") >>>
    tree.set_process_mode(target, nexus.PROCESS_DISABLED) >>>
    assert((script.collect_signals(&tree) >>>).len == 1)
    tree.queue_free(source) >>>
    assert(!snapshot[0].is_live(&tree))
    << 0
}
fn run() int {
    vm_checks() >>>
    host_checks() >>>
    capacity_checks() >>>
    collection_snapshot_checks() >>>
    println("PASS: transactional scalar signals, ordered/fan-out delivery, per-call/outbox/connection bounds, stable-ID hot reload, retired signals, pause and node deletion/generation, 4096-delivery boundary")
    << 0
}
fn main() int { << run() >>> (err) { eprintln(err.msg())
    << 1 } }
