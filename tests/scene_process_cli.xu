@main

scene #"github.com/xulang-org/nexus/integration/scene"
codec #"github.com/xulang-org/nexus/formats/scene"
nexus #"github.com/xulang-org/nexus/scene"
fm #"github.com/xulang-org/nexus/foundation/math"
camera_data #"github.com/xulang-org/nexus/resources/camera"
#os

fn run() int {
    args := os.args()
    assert(args.len == 3)
    if args[1] == "write" {
        $tree := nexus.new_scene_tree_3d("Persistent", 8) >>>
        root := tree.root()
        group := tree.add_group(root, "Group") >>>
        object := tree.add_child_3d(group, "Object") >>>
        tree.set_transform_3d(object, fm.translation_3d(fm.vec3(0.12345678901234567, 2.0, -3.0))) >>>
        tree.set_camera_3d(object, camera_data.perspective(0.8765432101234567, 0.25, 50.0) >>>) >>>
        ui := tree.add_child(root, "用户界面") >>>
        tree.set_visible(ui, false) >>>
        tree.set_process_mode(ui, nexus.PROCESS_ALWAYS) >>>
        document := scene.capture_nodes(&tree, root) >>>
        scene.save(args[2] + "", &document) >>>
        println("saved")
        << 0
    }
    assert(args[1] == "read")
    document := scene.load(args[2] + "") >>>
    assert(document.node_count() == 4)
    $tree := nexus.new_scene_tree("FreshProcess", 8) >>>
    root := tree.root()
    instance := scene.instantiate(&document, $&tree, root, "Loaded") >>>
    object := tree.find_node(instance, "Group/Object") >>>
    assert((tree.global_transform_3d(object) >>>).c3.x == 0.12345678901234567)
    lens := nexus.new_camera_node_3d(&tree, object) >>>
    assert(lens.vertical_fov == 0.8765432101234567 && lens.near == 0.25 && lens.far == 50.0)
    ui := tree.find_child(instance, "用户界面") >>>
    assert(!(tree.is_visible(ui) >>>) && (tree.node_info(ui) >>>).process_mode == nexus.PROCESS_ALWAYS)
    assert((tree.take_ready() >>>).len == 5)
    raw := codec.encode(&document) >>>
    assert(raw == (os.read(args[2] + "") >>>))
    println("loaded")
    << 0
}
fn main() int { << run() >>> (err) { eprintln(err.msg())
    << 1 } }
