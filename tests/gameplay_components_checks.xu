@main

// Pure CPU deterministic tests covering all nexus/gameplay component systems:
// StatSheet + StatusManager, Health + Damage Pipeline + Hitbox/Hurtbox + AbilitySet,
// ItemRegistry + Inventory + EquipmentLoadout + Pity LootTable,
// QuestJournal + DialogueGraph, CameraShake + FollowCamera2D + OrbitCamera3D,
// WaveDirector + GameplayFsm + InteractableRegistry.

#errors
#math
fm #"github.com/xulang-org/nexus/foundation/math"
gp #"github.com/xulang-org/nexus/gameplay"

fn check(cond bool, msg string) int {
    if !cond { >> errors.new("gameplay check failed: " + msg) }
    << 0
}

fn near(a f64, b f64, eps f64) bool {
    << math.abs(a - b) <= eps
}

fn define_stat_fails(s $&gp.StatSheet, name string, base f64, mn f64, mx f64) bool {
    _ := s.define(name, base, mn, mx) or (err) {
        _ := err.msg()
        << true
    }
    << false
}

fn equip_fails(eq $&gp.EquipmentLoadout, inv $&gp.Inventory, reg &gp.ItemRegistry, stats $&gp.StatSheet, item_id string) bool {
    _ := eq.equip_from_inventory(inv, reg, stats, item_id, gp.EQUIP_NONE) or (err) {
        _ := err.msg()
        << true
    }
    << false
}

fn test_stats_and_statuses() int {
    $s := gp.new_stat_sheet()
    s.define("attack", 100.0, 0.0, 500.0) or >>
    s.define("defense", 100.0, 0.0, 500.0) or >>
    s.define("move_speed", 10.0, 1.0, 30.0) or >>
    check(define_stat_fails($&s, "", 1.0, 0.0, 2.0), "empty stat name must reject") or >>
    check(define_stat_fails($&s, "bad", 1.0, 10.0, 5.0), "min > max stat must reject") or >>

    // (100 + 20) * (1 + 0.5) * 1.2 = 216
    s.add_modifier(gp.StatModifier{id: "m1", source: "sword", stat: "attack", op: gp.MOD_FLAT, value: 20.0, priority: 0}) or >>
    s.add_modifier(gp.StatModifier{id: "m2", source: "aura", stat: "attack", op: gp.MOD_PERCENT_ADD, value: 0.50, priority: 0}) or >>
    s.add_modifier(gp.StatModifier{id: "m3", source: "rage", stat: "attack", op: gp.MOD_PERCENT_MULT, value: 1.20, priority: 0}) or >>
    check(near(s.get("attack") or >>, 216.0, 1e-6), "Flat -> PctAdd -> PctMult stacking mismatch") or >>

    // Override priority check + source removal
    s.add_modifier(gp.StatModifier{id: "ov1", source: "cursed", stat: "attack", op: gp.MOD_OVERRIDE, value: 50.0, priority: 5}) or >>
    s.add_modifier(gp.StatModifier{id: "ov2", source: "bless", stat: "attack", op: gp.MOD_OVERRIDE, value: 333.0, priority: 10}) or >>
    check(near(s.get("attack") or >>, 333.0, 1e-6), "higher-priority MOD_OVERRIDE must win") or >>
    _ := s.remove_by_source("cursed")
    _ := s.remove_by_source("bless")
    check(near(s.get("attack") or >>, 216.0, 1e-6), "removing override restores computed attack") or >>

    // Stats JSON roundtrip
    s_json := gp.encode_stats_json(&s)
    s_dec := gp.decode_stats_json(&s_json) or >>
    check(near(s_dec.get("attack") or >>, 216.0, 1e-6), "stats JSON roundtrip parity failed") or >>

    // StatusManager: STACK_INTENSITY (3 stacks), STACK_DURATION, STACK_INDEPENDENT, multi-tick DoT & dispel
    $sm := gp.new_status_manager()
    fury := gp.StatusSpec{
        id: "fury",
        category: gp.STATUS_CAT_BUFF,
        stack_policy: gp.STACK_INTENSITY,
        max_stacks: 3,
        duration: 2.0,
        max_duration: 2.0,
        tick_interval: 0.0,
        tick_damage: 0.0,
        tick_heal: 0.0,
        damage_element: gp.DMG_PHYSICAL,
        tags: []string{},
        modifiers: [gp.StatModifier{id: "f_atk", source: "", stat: "attack", op: gp.MOD_FLAT, value: 10.0, priority: 0}]
    }
    _ := sm.apply(&fury, $&s) or >>
    _ := sm.apply(&fury, $&s) or >>
    _ := sm.apply(&fury, $&s) or >>
    _ := sm.apply(&fury, $&s) or >>
    check(sm.stack_count("fury") == 3, "STACK_INTENSITY should cap at max_stacks=3") or >>
    // (100 + 20 + 30) * 1.5 * 1.2 = 270
    check(near(s.get("attack") or >>, 270.0, 1e-6), "3-stack flat modifier scaling mismatch") or >>

    // Poison independent stacks + DoT multi-tick catchup (dt = 1.1s, interval = 0.5s => 2 ticks per instance!)
    poison := gp.StatusSpec{
        id: "poison",
        category: gp.STATUS_CAT_DEBUFF,
        stack_policy: gp.STACK_INDEPENDENT,
        max_stacks: 5,
        duration: 1.5,
        max_duration: 1.5,
        tick_interval: 0.5,
        tick_damage: 7.0,
        tick_heal: 0.0,
        damage_element: gp.DMG_POISON,
        tags: [gp.TAG_SILENCED],
        modifiers: []gp.StatModifier{}
    }
    _ := sm.apply(&poison, $&s) or >>
    _ := sm.apply(&poison, $&s) or >>
    check(sm.stack_count("poison") == 2 && sm.has_tag(gp.TAG_SILENCED), "STACK_INDEPENDENT should allow 2 active instances + silence tag") or >>

    ticks := sm.step(1.1, $&s) or >>
    $dot_sum := 0.0
    for ti in 0:ticks.len {
        if ticks[ti].effect_id == "poison" { dot_sum += ticks[ti].damage }
    }
    // 2 instances x 2 ticks x 7.0 damage = 28.0
    check(near(dot_sum, 28.0, 1e-6), "DoT catch-up tick sum mismatch") or >>

    // Dispel 1 debuff instance -> 1 remains; expiry on next 1.0s cleans up fury & remaining poison!
    disp := sm.dispel_category(gp.STATUS_CAT_DEBUFF, 1, $&s)
    check(disp == 1 && sm.stack_count("poison") == 1, "dispel_category count=1 should remove 1 poison instance") or >>

    _ := sm.step(1.0, $&s) or >>
    check(!sm.has_effect("fury") && !sm.has_effect("poison") && !sm.has_tag(gp.TAG_SILENCED), "all statuses should expire cleanly after 2.1s") or >>
    check(near(s.get("attack") or >>, 216.0, 1e-6), "expired fury status must clean its attack modifiers from StatSheet") or >>
    << 0
}

fn test_combat_and_abilities() int {
    $rng := gp.new_rng(777)
    $st := gp.new_stat_sheet()
    st.define("defense", 100.0, 0.0, 1000.0) or >> // 100/(100+100) = 0.5x physical mitigation
    st.define("fire_res", 0.50, -1.0, 0.90) or >>

    $sm := gp.new_status_manager()
    $hp := gp.new_health(200.0, 50.0, 30.0) or >>
    hp.configure_regen(0.20, 2.0, 10.0, 1.0, 15.0) or >>

    // 1. Friendly fire rejected
    $ff := gp.default_damage_spec(1, gp.TEAM_ENEMY, 40.0)
    ff.attack_id = 10
    r_ff := gp.apply_damage($&hp, gp.TEAM_ENEMY, &st, &sm, &ff, $&rng) or >>
    check(!r_ff.applied && r_ff.blocked_reason == "friendly_fire", "same-team attack without friendly_fire must block") or >>

    // 2. Physical hit: raw=120 -> 60 mitigated -> 50 shield absorbed, 10 HP damage, 35 poise >= 30 => staggered!
    $hit1 := gp.default_damage_spec(2, gp.TEAM_PLAYER, 120.0)
    hit1.attack_id = 11
    hit1.poise_damage = 35.0
    r1 := gp.apply_damage($&hp, gp.TEAM_ENEMY, &st, &sm, &hit1, $&rng) or >>
    check(r1.applied && near(r1.shield_absorbed, 50.0, 1e-6) && near(r1.hp_damage, 10.0, 1e-6) && r1.staggered,
        "physical + shield + stagger resolution mismatch") or >>
    check(near(hp.hp, 190.0, 1e-6) && near(hp.shield, 0.0, 1e-6), "HP/shield post-hit mismatch") or >>

    // 3. Duplicate attack_id blocked even after invuln clears!
    hp.step(0.25)
    r_dup := gp.apply_damage($&hp, gp.TEAM_ENEMY, &st, &sm, &hit1, $&rng) or >>
    check(!r_dup.applied && r_dup.blocked_reason == "duplicate_hit", "same attack_id must not hit target twice") or >>

    // 4. Invulnerability frame window check
    $hit2 := gp.default_damage_spec(2, gp.TEAM_PLAYER, 40.0)
    hit2.attack_id = 12
    r2 := gp.apply_damage($&hp, gp.TEAM_ENEMY, &st, &sm, &hit2, $&rng) or >>
    check(r2.applied && hp.invuln_remaining > 0.1, "hit2 should arm invuln frames") or >>
    $hit3 := gp.default_damage_spec(2, gp.TEAM_PLAYER, 40.0)
    hit3.attack_id = 13
    r_inv := gp.apply_damage($&hp, gp.TEAM_ENEMY, &st, &sm, &hit3, $&rng) or >>
    check(!r_inv.applied && r_inv.blocked_reason == "invulnerable", "follow-up inside i-frame window must block") or >>

    // Wait out regen delay -> shield and poise regenerate!
    hp.step(2.5)
    check(hp.shield > 4.0 && near(hp.poise, 30.0, 1e-6), "shield/poise delayed regen should restore points") or >>

    // 5. True damage bypasses defense/shield & Hitbox/Hurtbox weakpoint 2.0x overlap
    $tr := gp.default_damage_spec(2, gp.TEAM_PLAYER, 50.0)
    tr.attack_id = 14
    tr.element = gp.DMG_TRUE
    tr.hit_multiplier = 2.0
    hp_before := hp.hp
    r_tr := gp.apply_damage($&hp, gp.TEAM_ENEMY, &st, &sm, &tr, $&rng) or >>
    check(r_tr.applied && near(r_tr.hp_damage, 100.0, 1e-6) && near(hp_before - hp.hp, 100.0, 1e-6),
        "DMG_TRUE + 2x multiplier should bypass shield & defense") or >>

    hbs := [gp.Hitbox3D{id: 1, owner_id: 1, team: gp.TEAM_PLAYER, attack_id: 99, center: fm.vec3(1.0, 0.0, 0.0), radius: 1.2, active: true, spec: tr}]
    hurts := [
        gp.Hurtbox3D{id: 2, owner_id: 2, team: gp.TEAM_ENEMY, center: fm.vec3(1.8, 0.0, 0.0), radius: 0.5, damage_multiplier: 2.0, active: true, tag: "head"},
        gp.Hurtbox3D{id: 3, owner_id: 3, team: gp.TEAM_ENEMY, center: fm.vec3(9.0, 0.0, 0.0), radius: 0.5, damage_multiplier: 1.0, active: true, tag: "far"}
    ]
    ovs := gp.resolve_combat_overlaps_3d(&hbs, &hurts)
    check(ovs.len == 1 && ovs[0].target_id == 2 && near(ovs[0].multiplier, 2.0, 1e-6), "hitbox overlap should hit head hurtbox only") or >>

    // 6. AbilitySet: multi-charge, GCD, silence, combo chain, sequential recharge
    $ab := gp.new_ability_set()
    ab.register(gp.AbilityDef{id: "slash", cooldown: 2.0, max_charges: 2, cost: 10.0, cast_time: 0.0, gcd: 0.3, combo_steps: 3, combo_window: 1.0}) or >>
    ab.register(gp.AbilityDef{id: "fireball", cooldown: 3.0, max_charges: 1, cost: 30.0, cast_time: 0.4, gcd: 0.3, combo_steps: 1, combo_window: 0.0}) or >>

    c1 := ab.try_cast("slash", 50.0, false)
    check(c1.started && c1.combo_step == 1 && ab.charges("slash") == 1, "combo step 1 cast failed") or >>
    c_gcd := ab.try_cast("fireball", 50.0, false)
    check(!c_gcd.started && c_gcd.reason == "gcd", "cast inside GCD must reject") or >>
    ab.step(0.35)
    c2 := ab.try_cast("slash", 50.0, false)
    check(c2.started && c2.combo_step == 2 && ab.charges("slash") == 0, "combo step 2 inside combo_window failed") or >>
    c_cd := ab.try_cast("slash", 50.0, false)
    // gcd active for 0.3s; step past gcd and check cooldown block
    _ := c_cd
    ab.step(0.35)
    c_cd2 := ab.try_cast("slash", 50.0, false)
    check(!c_cd2.started && c_cd2.reason == "cooldown", "0 charges should block with cooldown") or >>
    c_sil := ab.try_cast("fireball", 50.0, true)
    check(!c_sil.started && c_sil.reason == "silenced", "silenced actor must not cast") or >>
    c_low := ab.try_cast("fireball", 10.0, false)
    check(!c_low.started && c_low.reason == "resource", "low resource must reject cast") or >>

    // Step 4.0s -> both slash charges restored + combo window expired!
    ab.step(4.0)
    check(ab.charges("slash") == 2, "both slash charges must recharge sequentially") or >>
    c_reset := ab.try_cast("slash", 50.0, false)
    check(c_reset.started && c_reset.combo_step == 1, "expired combo window must reset combo_step back to 1") or >>
    << 0
}

fn test_inventory_equipment_and_pity_loot() int {
    $reg := gp.new_item_registry()
    reg.register(gp.ItemDef{
        id: "potion", name_key: "item.potion", category: gp.ITEM_CONSUMABLE, rarity: gp.RARITY_COMMON,
        max_stack: 5, weight: 0.5, equip_slot: gp.EQUIP_NONE, modifiers: []gp.StatModifier{}
    }) or >>
    reg.register(gp.ItemDef{
        id: "iron_sword", name_key: "item.iron_sword", category: gp.ITEM_WEAPON, rarity: gp.RARITY_UNCOMMON,
        max_stack: 1, weight: 4.0, equip_slot: gp.EQUIP_MAIN_HAND,
        modifiers: [gp.StatModifier{id: "atk", source: "", stat: "attack", op: gp.MOD_FLAT, value: 15.0, priority: 0}]
    }) or >>
    reg.register(gp.ItemDef{
        id: "flame_sword", name_key: "item.flame_sword", category: gp.RARITY_LEGENDARY, rarity: gp.RARITY_LEGENDARY,
        max_stack: 1, weight: 4.5, equip_slot: gp.EQUIP_MAIN_HAND,
        modifiers: [gp.StatModifier{id: "atk", source: "", stat: "attack", op: gp.MOD_FLAT, value: 45.0, priority: 0}]
    }) or >>

    $inv := gp.new_inventory(4, 15.0) or >>
    ov1 := inv.add_item(&reg, "potion", 7) or >> // uses 2 slots (5 + 2), weight=3.5
    check(ov1 == 0 && inv.count_of("potion") == 7, "potion stacking across 2 slots failed") or >>
    ov_heavy := inv.add_item(&reg, "iron_sword", 3) or >> // remaining weight=11.5 -> fits 2 swords (8.0kg), 1 overflows!
    check(ov_heavy == 1 && inv.count_of("iron_sword") == 2, "weight cap overflow check failed") or >>
    check(inv.count_of("potion") == 7, "count_of unchanged after sword overflow") or >>

    // Consume 2 potions to free space, equip flame_sword after adding, swap iron <-> flame, unequip & sort + JSON
    _ := inv.remove_item("iron_sword", 1) or >>
    _ := inv.add_item(&reg, "flame_sword", 1) or >>
    inv.sort_by_rarity(&reg)
    check(inv.slots[0].item_id == "flame_sword", "sort_by_rarity should put legendary flame_sword in slot 0") or >>

    $stats := gp.new_stat_sheet()
    stats.define("attack", 10.0, 0.0, 999.0) or >>
    $eq := gp.new_equipment_loadout()
    prev0 := eq.equip_from_inventory($&inv, &reg, $&stats, "iron_sword", gp.EQUIP_NONE) or >>
    check(prev0 == "" && near(stats.get("attack") or >>, 25.0, 1e-6), "equipping iron_sword must yield attack 25") or >>
    prev1 := eq.equip_from_inventory($&inv, &reg, $&stats, "flame_sword", gp.EQUIP_NONE) or >>
    check(prev1 == "iron_sword" && near(stats.get("attack") or >>, 55.0, 1e-6) && inv.has_item("iron_sword", 1),
        "swapping to flame_sword must return iron_sword and update attack to 55") or >>
    check(equip_fails($&eq, $&inv, &reg, $&stats, "potion"), "equipping non-equippable potion must fail") or >>
    _ := eq.unequip_to_inventory($&inv, &reg, $&stats, gp.EQUIP_MAIN_HAND) or >>
    check(near(stats.get("attack") or >>, 10.0, 1e-6) && inv.has_item("flame_sword", 1), "unequip must restore base attack") or >>

    inv_json := gp.encode_inventory_json(&inv)
    inv_dec := gp.decode_inventory_json(&inv_json) or >>
    check(inv_dec.count_of("flame_sword") == 1 && inv_dec.count_of("potion") == 7, "inventory JSON roundtrip mismatch") or >>

    // LootTable pity threshold: rare entry weight tiny (1e-6), common huge (1000.0) -> pity_threshold=4 guarantees rare within 4 rolls!
    $lt := gp.new_loot_table("boss_chest", 1, 4) or >>
    lt.add_entry(gp.LootEntry{item_id: "potion", min_count: 1, max_count: 2, weight: 10000.0, guaranteed: false, is_rare_pity: false}) or >>
    lt.add_entry(gp.LootEntry{item_id: "flame_sword", min_count: 1, max_count: 1, weight: 0.0001, guaranteed: false, is_rare_pity: true}) or >>
    $rng := gp.new_rng(12345)
    $rare_hits := 0
    for _ in 0:4 {
        drops := lt.roll($&rng)
        for di in 0:drops.len {
            if drops[di].item_id == "flame_sword" { rare_hits += 1 }
        }
    }
    check(rare_hits >= 1 && lt.misses_since_rare == 0, "pity_threshold=4 must guarantee rare drop by roll 4") or >>
    << 0
}

fn test_quests_dialogue_camera_and_world() int {
    // 1. QuestJournal prereq chain & JSON roundtrip + DialogueGraph conditional choices
    $q := gp.new_quest_journal()
    q1 := gp.QuestDef{
        id: "q_goblin", title_key: "quest.goblin", prereq_ids: []string{},
        objectives: [gp.QuestObjective{id: "k1", desc_key: "obj.k1", kind: gp.OBJ_KILL, target_id: "goblin", required: 2, current: 0, optional: false}],
        reward: gp.QuestReward{xp: 100, gold: 50, items: [gp.ItemStack{item_id: "potion", count: 2}]}
    }
    q2 := gp.QuestDef{
        id: "q_boss", title_key: "quest.boss", prereq_ids: ["q_goblin"],
        objectives: [gp.QuestObjective{id: "k2", desc_key: "obj.k2", kind: gp.OBJ_KILL, target_id: "orc_chief", required: 1, current: 0, optional: false}],
        reward: gp.QuestReward{xp: 500, gold: 200, items: []gp.ItemStack{}}
    }
    q.register(&q1) or >>
    q.register(&q2) or >>
    check(q.state_of("q_goblin") == gp.QUEST_AVAILABLE && q.state_of("q_boss") == gp.QUEST_LOCKED,
        "prereq quest must start LOCKED") or >>
    q.accept("q_goblin") or >>
    ready1 := q.notify_event(gp.OBJ_KILL, "goblin", 1)
    check(ready1.len == 0 && q.objective_progress("q_goblin", "k1") == 1, "1/2 kill should stay active") or >>
    ready2 := q.notify_event(gp.OBJ_KILL, "goblin", 5)
    check(ready2.len == 1 && ready2[0] == "q_goblin" && q.state_of("q_goblin") == gp.QUEST_READY,
        "clamped 2/2 kill should mark quest READY") or >>
    rew := q.complete("q_goblin") or >>
    check(rew.gold == 50 && q.state_of("q_boss") == gp.QUEST_AVAILABLE, "completing q1 must unlock q2") or >>

    qj := gp.encode_journal_json(&q)
    q_dec := gp.decode_journal_json(&qj, &[q1, q2]) or >>
    check(q_dec.state_of("q_goblin") == gp.QUEST_COMPLETED && q_dec.state_of("q_boss") == gp.QUEST_AVAILABLE,
        "journal JSON roundtrip mismatch") or >>

    $dg := gp.new_dialogue_graph("elder") or >>
    dg.add_node(gp.DialogueNode{
        id: "root", speaker_key: "npc.elder", text_key: "dlg.hi",
        on_enter: []gp.DialogueEffect{},
        choices: [
            gp.DialogueChoice{text_key: "c.normal", next_node: "", condition: gp.cond_none(), effects: [gp.DialogueEffect{kind: gp.DEFF_SET_FLAG, key: "met", amount: 1}]},
            gp.DialogueChoice{text_key: "c.high_charisma", next_node: "secret", condition: gp.DialogueCondition{kind: gp.DCOND_STAT_GE, key: "charisma", threshold: 10.0, int_val: 0}, effects: []gp.DialogueEffect{}}
        ]
    }) or >>
    dg.add_node(gp.DialogueNode{
        id: "secret", speaker_key: "npc.elder", text_key: "dlg.secret",
        on_enter: [gp.DialogueEffect{kind: gp.DEFF_ADD_GOLD, key: "gold", amount: 100}],
        choices: []gp.DialogueChoice{}
    }) or >>
    $st_d := gp.new_stat_sheet()
    st_d.define("charisma", 5.0, 0.0, 20.0) or >>
    inv_d := gp.new_inventory(2, 0.0) or >>
    flags_d := []string{}
    av_low := dg.available_choices("root", &flags_d, &st_d, &inv_d, &q) or >>
    check(av_low.len == 1 && av_low[0] == 0, "low charisma hides gated dialogue option") or >>
    st_d.set_base("charisma", 12.0) or >>
    av_hi := dg.available_choices("root", &flags_d, &st_d, &inv_d, &q) or >>
    check(av_hi.len == 2, "high charisma unlocks choice 1") or >>
    tr := dg.select_choice("root", 1, &flags_d, &st_d, &inv_d, &q) or >>
    check(tr.next_node == "secret" && tr.effects.len == 1 && tr.effects[0].kind == gp.DEFF_ADD_GOLD, "on_enter dialogue effect missing") or >>

    // 2. CameraShake + FollowCamera2D + OrbitCamera3D SpringArm Occlusion
    $fc := gp.new_follow_camera_2d(fm.vec2(100.0, 100.0), fm.vec2(20.0, 20.0), 0.1, 10.0) or >>
    fc.set_bounds(fm.rect2(0.0, 0.0, 400.0, 300.0), fm.vec2(160.0, 120.0)) or >>
    f0 := fc.step(fm.vec2(110.0, 110.0), fm.vec2(0.0, 0.0), 0.016)
    check(near(f0.position.x, 100.0, 1e-4) && near(f0.position.y, 100.0, 1e-4), "target inside 2D deadzone must keep camera steady") or >>
    $f_edge := f0
    for _ in 0:30 {
        f_edge = fc.step(fm.vec2(395.0, 295.0), fm.vec2(0.0, 0.0), 0.05)
    }
    // Max focus X = 400 - 80 = 320, max focus Y = 300 - 60 = 240
    check(f_edge.position.x <= 320.01 && f_edge.position.y <= 240.01, "FollowCamera2D bounds clamp exceeded") or >>

    $oc := gp.new_orbit_camera_3d(6.0, fm.vec3(0.0, 1.5, 0.0)) or >>
    wall := [fm.aabb3(fm.vec3(-4.0, -1.0, 2.5), fm.vec3(4.0, 4.0, 3.5)) or >>]
    empty_b := []fm.Aabb3{}
    p_clear := oc.step(fm.vec3(0.0, 0.0, 0.0), &empty_b, 0.016)
    check(!p_clear.occluded && near(p_clear.arm_distance, 6.0, 1e-4), "unobstructed OrbitCamera3D must keep target distance") or >>
    $p_occ := p_clear
    for _ in 0:15 {
        p_occ = oc.step(fm.vec3(0.0, 0.0, 0.0), &wall, 0.033)
    }
    check(p_occ.occluded && p_occ.arm_distance < 2.6, "wall behind anchor must pull OrbitCamera3D spring arm inward") or >>
    oc.add_trauma(0.9)
    p_shaken := oc.step(fm.vec3(0.0, 0.0, 0.0), &empty_b, 0.016)
    check(p_shaken.eye.sub(fm.vec3(p_clear.eye.x, p_clear.eye.y, p_shaken.eye.z)).length() > 0.001 || oc.shake_trauma() > 0.7,
        "camera trauma should stay active right after impulse") or >>

    // 3. WaveDirector + GameplayFsm + InteractableRegistry
    $wd := gp.new_wave_director(2) or >>
    wd.add_wave(gp.WaveDef{name: "w1", start_delay: 0.5, max_concurrent: 2, rules: [gp.WaveSpawnRule{enemy_type: "slime", count: 3, interval: 0.2, boss: false}]}) or >>
    wd.start() or >>
    check(wd.step(0.25).len == 0, "start_delay should defer initial wave spawns") or >>
    s_w1 := wd.step(0.30)
    // Concurrent cap=2 limits immediate multi-tick spawns!
    check(s_w1.len >= 1 && s_w1.len <= 2 && wd.alive_count() <= 2, "WaveDirector concurrent cap violated") or >>
    while wd.alive_count() < 2 {
        _ := wd.step(0.25)
    }
    check(wd.step(0.5).len == 0, "at max_concurrent=2 WaveDirector must wait for kills") or >>
    wd.notify_enemy_killed()
    s_next := wd.step(0.25)
    check(s_next.len == 1, "killing 1 enemy unlocks 3rd slime spawn") or >>
    wd.notify_enemy_killed()
    wd.notify_enemy_killed()
    _ := wd.step(0.05)
    check(wd.is_cleared() && wd.total_killed() == 3, "WaveDirector should clear after all 3 slimes killed") or >>

    $fsm := gp.new_gameplay_fsm("idle") or >>
    fsm.register_state("attack", 0.25) or >>
    fsm.allow_transition("idle", "attack") or >>
    fsm.allow_transition("attack", "idle") or >>
    check(!fsm.try_transition("jump"), "edge allowlist from idle must block jump") or >>
    check(fsm.try_transition("attack"), "allowed idle -> attack failed") or >>
    fsm.step(0.10)
    check(!fsm.try_transition("idle"), "min_duration lockout must keep attack state active") or >>
    fsm.step(0.20)
    check(fsm.try_transition("idle") && fsm.previous() == "attack" && fsm.history_count() == 2,
        "completed min_duration should permit attack -> idle") or >>

    $ireg := gp.new_interactable_registry()
    ireg.register(gp.Interactable{id: "lever", prompt_key: "p.lever", position: fm.vec3(0.0, 0.0, 2.0), radius: 3.0, hold_duration: 0.4, cooldown: 1.0, priority: 1, one_shot: true, enabled: true}) or >>
    sel_back := ireg.step(fm.vec3(0.0, 0.0, 0.0), fm.vec3(0.0, 0.0, -1.0), 0.5, false, 0.016)
    check(!sel_back.found, "facing away from interactable must fail facing dot filter") or >>
    sel_h1 := ireg.step(fm.vec3(0.0, 0.0, 0.0), fm.vec3(0.0, 0.0, 1.0), 0.5, true, 0.20)
    check(sel_h1.found && near(sel_h1.hold_progress, 0.5, 1e-4) && !sel_h1.triggered, "half hold progress mismatch") or >>
    sel_h2 := ireg.step(fm.vec3(0.0, 0.0, 0.0), fm.vec3(0.0, 0.0, 1.0), 0.5, true, 0.25)
    check(sel_h2.triggered, "completed hold_duration must trigger") or >>
    sel_after := ireg.step(fm.vec3(0.0, 0.0, 0.0), fm.vec3(0.0, 0.0, 1.0), 0.5, true, 0.016)
    check(!sel_after.found, "one_shot interactable should disable itself after trigger") or >>
    << 0
}

fn main() int {
    test_stats_and_statuses() or (err) {
        println("FAIL: " + err.msg())
        << 1
    }
    test_combat_and_abilities() or (err) {
        println("FAIL: " + err.msg())
        << 1
    }
    test_inventory_equipment_and_pity_loot() or (err) {
        println("FAIL: " + err.msg())
        << 1
    }
    test_quests_dialogue_camera_and_world() or (err) {
        println("FAIL: " + err.msg())
        << 1
    }
    println("PASS: gameplay_components_checks")
    << 0
}
