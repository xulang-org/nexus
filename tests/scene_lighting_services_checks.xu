@main
resource #"github.com/xulang-org/nexus/resources/scene"
files #"github.com/xulang-org/nexus/integration/scene"
light_files #"github.com/xulang-org/nexus/integration/scene_lighting"
lights #"github.com/xulang-org/nexus/resources/lighting"
bindings #"github.com/xulang-org/nexus/integration/lighting"
models #"github.com/xulang-org/nexus/integration/scene_render"
scripting #"github.com/xulang-org/nexus/integration/scene_script"
worlds #"github.com/xulang-org/nexus/integration/scene_audio"
render_scene #"github.com/xulang-org/nexus/integration/rendering/three_d"
shaders #"github.com/xulang-org/nexus/assets/shaders/three_d"
ren #"github.com/xulang-org/nexus/rendering/three_d"
fm #"github.com/xulang-org/nexus/foundation/math"
nexus #"github.com/xulang-org/nexus/scene"
#gpu
fn bad_models(device &ren.Device3D, path string) bool { models.load(device,path) or(err){ << true }
    << false }
fn bad_audio(path string) bool { worlds.load(path,48000) or(err){ << true }
    << false }
fn bad_scripts(path string) bool { scripting.load(path) or(err){ << true }
    << false }
fn run() int {
    original := files.load("build/scene-scripts/world.xuscene") or >>
    source := lights.point(fm.vec3(0.0,0.0,3.0),fm.vec3(6.0,4.0,2.0),20.0) or >>
    declared := resource.with_lights(&original,[resource.LightAttachment{node: 0,source: source}]) or >>
    path := "build/scene-scripts/with-lights.xuscene"
    files.save(path+"",&declared) or >>
    program := shaders.load_mesh("build/mesh-shaders") or >>
    $device := ren.open_3d("Composed light scene",64,64,gpu.AUTO,&program) or >>
    assert(bad_models(&device,path+"") && bad_audio(path+"") && bad_scripts(path+""))
    // Explicit partial loaders restore every service into the same node tree.
    $audio := worlds.load_audio(path+"",48000) or >>
    root := audio.root()
    model_document := audio.capture() or >>
    assert(model_document.light_count()==1)
    $mesh_set := models.prepare_surfaces(&device,model_document,audio.base_directory()) or >>
    $scene := render_scene.new_scene_3d(&device) or >>
    mesh_set.bind($&scene,&audio.tree,root) or >>
    script_document := audio.capture() or >>
    $scripts := scripting.prepare_scripts(script_document,audio.base_directory()) or >>
    scripts.bind(&audio.tree,root) or >>
    light_document := audio.capture() or >>
    $world := bindings.new_scene_lights_3d()
    assert((light_files.bind(&light_document,$&world,&audio.tree,root) or >>)==1)
    assert((world.gather(&audio.tree) or >>).len==1)
    scripts.physics_process(&audio.tree,0,1.0/60.0,1.0) or >>
    assert((scripts.dispatch(&audio.tree,64) or >>).delivered==1)
    assert((audio.render(128) or >>).len==256)
    camera_node := audio.tree.find_child(root,"Camera") or >>
    camera := nexus.new_camera_node_3d(&audio.tree,camera_node) or >>
    view := camera.view_projection(&audio.tree,1.0) or >>
    eye := (audio.tree.global_transform_3d(camera_node) or >>).c3.xyz()
    environment := lights.environment(fm.vec3(0.15,0.15,0.15),eye,1.0,world.gather(&audio.tree) or >>) or >>
    device.begin(255) or >>
    assert((scene.draw_lit($&device,&audio.tree,view,&environment) or >>).instances==8)
    device.read_pixel(32,32) or >>
    device.present() or >>
    // A light edit and an accepted script revision share the final scene save.
    replacement := lights.spot(fm.vec3(0.0,0.0,4.0),fm.vec3(0.0,0.0,-1.0),fm.vec3(2.0,3.0,4.0),16.0,0.2,0.7) or >>
    world.attach(&audio.tree,root,replacement) or >>
    scripts.reload_from(&audio.tree,"55005500550055005500550055005500","next.xubc") or >>
    accepted := scripts.capture(&audio.tree) or >>
    assert(accepted.light_count()==1)
    current := light_files.capture(&accepted,&world,&audio.tree,root) or >>
    files.save_rebased("build/scene-scripts/with-lights-saved.xuscene",&current,audio.base_directory()) or >>
    saved := files.load("build/scene-scripts/with-lights-saved.xuscene") or >>
    assert(saved.light_count()==1 && (saved.light(0) or >>).source.kind()==lights.SPOT && (saved.light(0) or >>).source.radius()==16.0)
    assert(saved.script_count()==2 && saved.script_connection_count()==1 && saved.audio_count()==1 && saved.surface_count()==8)
    assert(saved.resource_count()==4)
    $revision_found := false
    for i in 0:saved.resource_count() {
        reference := saved.resource(i) or >>
        if reference.uid=="55005500550055005500550055005500" { revision_found=reference.path=="next.xubc" }
    }
    assert(revision_found)
    assert((mesh_set.capture(&audio.tree,root) or >>).light_count()==1)
    scripts.close() or >>
    audio.close() or >>
    mesh_set.close() or >>
    device.close() or >>
    println("PASS: full loaders reject unhandled light/service attachments; explicit Metal/PCM/script/light composition renders, dispatches, and saves light edits plus accepted script revision without losing other metadata")
    << 0
}
fn main() int { << run() or(err){ eprintln(err.msg())
    << 1 } }
