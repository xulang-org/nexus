@main
worlds #"github.com/xulang-org/nexus/integration/scene_audio"
files #"github.com/xulang-org/nexus/integration/scene"
fm #"github.com/xulang-org/nexus/foundation/math"
nexus #"github.com/xulang-org/nexus/scene"
#os
#strings

fn bad_load(name string) bool {
    worlds.load("build/scene-audio-fixtures/" + name + ".xuscene", 8000) or (err) {
        message := err.msg()
        if name == "bank-budget" { assert(strings.contains(&message, "PCM bank capacity")) }
        if name == "source-budget" { assert(strings.contains(&message, "snapshot exceeds byte limit")) }
        << true }
    << false
}
fn bad_sync(world $&worlds.AudioScene) bool { world.sync() or (err) { << true }
    << false }
fn bad_render(world $&worlds.AudioScene) bool { world.render(1) or (err) { << true }
    << false }
fn bad_capture(world &worlds.AudioScene) bool { world.capture() or (err) { << true }
    << false }
fn bad_nodes(path string) bool {
    document := files.load(path) or >>
    files.to_packed(&document) or (err) { << true }
    << false
}
fn run() int {
    $world := worlds.load("build/scene-audio-fixtures/base.xuscene", 8000) or >>
    assert(world.clip_count() == 1 && world.bus_count() == 2 && (world.is_playing(0) or >>))
    samples := world.render(5) or >>
    assert(samples[0] == 250 && samples[2] == -250 && samples[4] == 500 && samples[6] == -500 && samples[8] == 250)
    assert((world.position_frames(0) or >>) == 1.0)
    voice := world.play(0) or >>
    assert((world.position_frames(0) or >>) == 0.0)
    world.render(1) or >>
    assert((world.play(0) or >>) == voice)
    world.tree.paused = true
    silence := world.render(2) or >>
    assert(silence[0] == 0 && (world.position_frames(0) or >>) == 0.0)
    source := world.node(1) or >>
    tree := $&world.tree
    tree.set_process_mode(source, nexus.PROCESS_ALWAYS) or >>
    resumed := world.render(1) or >>
    assert(resumed[0] == 250)
    before := world.capture() or >>
    assert((before.audio_emitter(0) or >>).autoplay && (before.audio_bus(1) or >>).volume == 0.5)
    world.save("build/scene-audio-fixtures/saved.xuscene") or >>
    $restored := worlds.load("build/scene-audio-fixtures/saved.xuscene", 8000) or >>
    assert((restored.position_frames(0) or >>) == 0.0 && (restored.render(1) or >>)[0] == 250)
    world.stop(0) or >>
    assert(!(world.is_playing(0) or >>))
    world.play(0) or >>
    world.close() or >>
    world.close() or >>
    assert(bad_render($&world))
    $sharing := worlds.load("build/scene-audio-fixtures/sharing.xuscene", 8000) or >>
    assert(sharing.clip_count() == 1 && !(sharing.is_playing(1) or >>))
    sharing.play(1) or >>
    assert((sharing.render(1) or >>)[0] == 500)
    $muted := worlds.load("build/scene-audio-fixtures/muted.xuscene", 8000) or >>
    assert((muted.render(1) or >>)[0] == 0 && (muted.position_frames(0) or >>) == 1.0)
    $paused := worlds.load("build/scene-audio-fixtures/bus-paused.xuscene", 8000) or >>
    assert((paused.render(1) or >>)[0] == 0 && (paused.position_frames(0) or >>) == 0.0)
    muted.mute_bus(1, false) or >>
    assert((muted.render(1) or >>)[0] == -250)
    paused.pause_bus(1, false) or >>
    paused.set_bus_volume(1, 1.0) or >>
    assert((paused.render(1) or >>)[0] == 500)
    assert((paused.capture() or >>).audio_bus_count() == 2)
    $once := worlds.load("build/scene-audio-fixtures/once.xuscene", 8000) or >>
    once.render(4) or >>
    assert(!(once.is_playing(0) or >>))
    once.play(0) or >>
    assert((once.render(1) or >>)[0] == 250)
    $full := worlds.load("build/scene-audio-fixtures/full.xuscene", 8000) or >>
    assert(full.clip_count() == 1 && full.bus_count() == 16)
    for i in 0:32 { assert(full.is_playing(i) or >>) }
    full.play(0) or >>
    assert((full.render(1) or >>)[0] == 0)
    $spatial := worlds.load("build/scene-audio-fixtures/3d.xuscene", 8000) or >>
    first := spatial.render(1) or >>
    assert(first[0] == 0 && first[1] == 250)
    listener := spatial.node(2) or >>
    spatial_tree := $&spatial.tree
    spatial_tree.set_transform_3d(listener, fm.scale_3d(fm.vec3(-1.0, 1.0, 1.0))) or >>
    second := spatial.render(1) or >>
    assert(second[0] == -250 && second[1] == 0)
    listener_tree := $&spatial.tree
    listener_tree.queue_free(listener) or >>
    assert((spatial.sync() or >>) == 1 && !(spatial.is_playing(0) or >>))
    assert(bad_capture(&spatial))
    $flat := worlds.load("build/scene-audio-fixtures/2d.xuscene", 8000) or >>
    flat_pcm := flat.render(1) or >>
    assert(flat_pcm[0] == 0 && flat_pcm[1] == 250)
    $pair := worlds.load("build/scene-audio-fixtures/spatial-pair.xuscene", 8000) or >>
    dead := pair.node(1) or >>
    pair_listener := pair.node(3) or >>
    pair_tree := $&pair.tree
    pair_tree.queue_free(dead) or >>
    pair_tree.set_transform_3d(pair_listener, fm.scale_3d(fm.vec3(0.0, 1.0, 1.0))) or >>
    assert(bad_sync($&pair))
    assert((pair.is_playing(0) or >>) && (pair.position_frames(0) or >>) == 0.0)
    fixed := $&pair.tree
    fixed.set_transform_3d(pair_listener, fm.identity_3d()) or >>
    assert((pair.sync() or >>) == 1 && !(pair.is_playing(0) or >>))
    // Failed candidates never mutate an already running world's PCM position.
    for name in ["missing", "hash", "late-bad", "bank-budget", "source-budget"] { assert(bad_load(name)) }
    assert((restored.position_frames(0) or >>) == 1.0 && (restored.render(1) or >>)[0] == -250)
    assert(bad_nodes("build/scene-audio-fixtures/base.xuscene") or >>)
    println("PASS: restored PCM/buses/mute/pause/autoplay/loop/restart, clip sharing, 32 voices, 2D/3D listener transforms/deletion, two-phase sync, metadata save/fresh start and isolated failed WAV/source/PCM-budget candidates")
    << 0
}
fn main() int { << run() or (err) { eprintln(err.msg())
    << 1 } }
