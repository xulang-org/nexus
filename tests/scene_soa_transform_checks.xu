@main

fm #"github.com/xulang-org/nexus/foundation/math"
scene #"github.com/xulang-org/nexus/scene"
#math
#time

fn mat_close(a fm.Mat4, b fm.Mat4) bool {
    cols_a := [a.c0, a.c1, a.c2, a.c3]
    cols_b := [b.c0, b.c1, b.c2, b.c3]
    for i in 0:4 {
        if math.abs(cols_a[i].x - cols_b[i].x) > 1e-9 { << false }
        if math.abs(cols_a[i].y - cols_b[i].y) > 1e-9 { << false }
        if math.abs(cols_a[i].z - cols_b[i].z) > 1e-9 { << false }
        if math.abs(cols_a[i].w - cols_b[i].w) > 1e-9 { << false }
    }
    << true
}

fn run() int {
    // 1. Mixed 3D/Group/2D reparent + partial dirty subtree verification.
    $tree := scene.new_scene_tree_3d("Root", 4096) >>>
    g := tree.add_group(tree.root(), "Grp") >>>
    a := tree.add_child_3d(g, "A") >>>
    b := tree.add_child_3d(a, "B") >>>
    g2 := tree.add_group(b, "G2") >>>
    c := tree.add_child_3d(g2, "C") >>>
    sub2d := tree.add_child(b, "Hud") >>>
    nested3d := tree.add_child_3d(sub2d, "Nested3D") >>>

    tree.set_transform_3d(a, fm.translation_3d(fm.vec3(1.0, 2.0, 3.0))) >>>
    tree.set_transform_3d(b, fm.rotation_y(0.5)) >>>
    tree.set_transform_3d(c, fm.translation_3d(fm.vec3(0.0, 0.0, 4.0))) >>>
    tree.set_transform_3d(nested3d, fm.translation_3d(fm.vec3(7.0, 0.0, 0.0))) >>>

    assert(tree.is_transform_dirty_3d(c))
    flushed := tree.flush_transforms() >>>
    assert(flushed >= 5)
    assert(!tree.is_transform_dirty_3d(a) && !tree.is_transform_dirty_3d(b) && !tree.is_transform_dirty_3d(c) && !tree.is_transform_dirty_3d(nested3d))

    // Compare cached O(1) vs analytic reference.
    expected_c := fm.translation_3d(fm.vec3(1.0, 2.0, 3.0)).multiply(fm.rotation_y(0.5)).multiply(fm.translation_3d(fm.vec3(0.0, 0.0, 4.0)))
    got_c := tree.global_transform_3d(c) >>>
    assert(mat_close(got_c, expected_c))
    // Nested 3D across a 2D boundary starts a fresh 3D root.
    got_nested := tree.global_transform_3d(nested3d) >>>
    assert(mat_close(got_nested, fm.translation_3d(fm.vec3(7.0, 0.0, 0.0))))

    // Mutating A dirties A, B, C, but NOT nested3d across the 2D boundary!
    tree.set_position_3d(a, fm.vec3(5.0, 2.0, 3.0)) >>>
    assert(tree.is_transform_dirty_3d(a) && tree.is_transform_dirty_3d(b) && tree.is_transform_dirty_3d(c))
    assert(!tree.is_transform_dirty_3d(nested3d))

    // Reparent C keeping global transform under root.
    tree.reparent(c, tree.root(), true) >>>
    after_reparent := tree.global_transform_3d(c) >>>
    expected_c2 := fm.translation_3d(fm.vec3(5.0, 2.0, 3.0)).multiply(fm.rotation_y(0.5)).multiply(fm.translation_3d(fm.vec3(0.0, 0.0, 4.0)))
    assert(mat_close(after_reparent, expected_c2))
    updated := tree.flush_transforms() >>>
    assert(updated == 3)
    assert((tree.flush_transforms() >>>) == 0)

    // 2. Benchmark: 64 chains x 32 depth = 2048 3D nodes, 20 rounds of all-node global transform reads.
    $bench := scene.new_scene_tree_3d("Bench", 4096) >>>
    $nodes := []int{}
    for chain in 0:64 {
        $parent := bench.root()
        for d in 0:32 {
            nid := bench.add_child_3d(parent, "N_" + str(chain) + "_" + str(d)) >>>
            bench.set_position_3d(nid, fm.vec3(1.0, 0.0, 0.0)) >>>
            nodes.push(nid)
            parent = nid
        }
    }
    t0 := time.now()
    $acc_cold := 0.0
    for round in 0:4 {
        for nid in nodes {
            m := bench.global_transform_3d(nid) >>>
            acc_cold += m.c3.x
        }
    }
    cold_us := (time.now() - t0) / 1000

    bench.flush_transforms() >>>
    t1 := time.now()
    $acc_cached := 0.0
    for round in 0:4 {
        for nid in nodes {
            m := bench.global_transform_3d(nid) >>>
            acc_cached += m.c3.x
        }
    }
    cached_us := (time.now() - t1) / 1000
    assert(math.abs(acc_cold - acc_cached) < 1e-6)
    println("PASS: SceneTree SoA dirty-tracked transform cache (2048 nodes x4 reads: uncached=" + str(cold_us) + "us vs cached=" + str(cached_us) + "us)")
    << 0
}

fn main() int {
    << run() >>> (err) {
        eprintln(err.msg())
        << 1
    }
}
