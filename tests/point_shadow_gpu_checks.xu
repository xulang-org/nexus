@main
#gpu
#os
fm #"github.com/xulang-org/nexus/foundation/math"
policy #"github.com/xulang-org/nexus/resources/shadow"
mesh #"github.com/xulang-org/nexus/resources/mesh"
lights #"github.com/xulang-org/nexus/resources/lighting"
nexus #"github.com/xulang-org/nexus/scene"
ren #"github.com/xulang-org/nexus/rendering/three_d"
bridge #"github.com/xulang-org/nexus/integration/rendering/three_d"
shaders #"github.com/xulang-org/nexus/assets/shaders/three_d"

fn basis_right(face int) fm.Vec3 {
    forward := policy.point_face_direction(face) >>>
    $up := fm.vec3(0.0,1.0,0.0)
    if face==2 || face==3 { up=fm.vec3(0.0,0.0,1.0) }
    << up.cross(forward.scaled(-1.0))
}
fn cube(size f64) mesh.MeshData3D {
    $data := mesh.new_mesh_data_3d()
    for face in 0:6 {
        forward := policy.point_face_direction(face) >>>
        right := basis_right(face) >>>
        up := forward.scaled(-1.0).cross(right)
        center := forward.scaled(size)
        for xy in [fm.vec2(-size,-size),fm.vec2(size,-size),fm.vec2(size,size),fm.vec2(-size,size)] {
            data.vertex_lit(center.add(right.scaled(xy.x)).add(up.scaled(xy.y)),4294967295,forward.scaled(-1.0)) >>>
        }
        data.triangle(face*4,face*4+1,face*4+2) >>>
        data.triangle(face*4,face*4+2,face*4+3) >>>
    }
    << data
}
fn world(center fm.Vec3,half f64) fm.Mat4 {
    << fm.translation_3d(center).multiply(fm.scale_3d(fm.vec3(half,half,half)))
}
fn camera(face int,offset f64) fm.Mat4 {
    forward := policy.point_face_direction(face) >>>
    right := basis_right(face) >>>
    up := forward.scaled(-1.0).cross(right)
    // Offset the view axis to exercise face selection inside the output image.
    target := forward.add(right.scaled(0.03+offset)).add(up.scaled(0.017))
    view := nexus.look_at_3d(fm.vec3(0.0,0.0,0.0),target,up) >>>
    << (nexus.perspective_3d(1.62,1.0,0.1,100.0) >>>).multiply(view)
}
fn capture(device $&ren.Device3D,scene &bridge.Scene3D,tree &nexus.SceneTree,vp fm.Mat4,env &lights.Environment3D,
    shadow &ren.ShadowMap3D,enabled bool,name string,values $&[]int) string {
    device.begin(255) >>>
    if enabled { scene.draw_lit_shadowed(device,tree,vp,env,shadow,1) >>>
    } else { scene.draw_lit(device,tree,vp,env) >>> }
    values.push(device.read_pixel(32,32) >>>)
    path := "build/point-shadow-"+name+".png"
    device.capture(path+"") >>>
    device.present() >>>
    << os.read(path) >>>
}
fn failed_binding(shadow &ren.ShadowMap3D,env &lights.Environment3D) bool {
    shadow.binding(env,1) >>>(err){ << true }
    << false
}
fn failed_render(shadow $&ren.ShadowMap3D,device &ren.Device3D,description policy.ShadowDescription3D) bool {
    empty := []ren.ShadowCaster3D{}
    shadow.render(device,&empty,description) >>>(err){ << true }
    << false
}
fn failed_create(device &ren.Device3D,description policy.ShadowDescription3D,program &ren.ShadowProgram3D) bool {
    device.shadow_map(description,program) >>>(err){ << true }
    << false
}
fn run() int {
    program := shaders.load_mesh("build/mesh-shaders") >>>
    shadow_program := shaders.load_shadow("build/mesh-shaders") >>>
    $device := ren.open_3d("Point atlas shadow checks",64,64,gpu.METAL,&program) >>>
    origin := fm.vec3(0.0,0.0,0.0)
    white := fm.vec3(48.0,48.0,48.0)
    point := lights.point(origin,white,10.0) >>>
    description := policy.point(point,0.1,128) >>>
    $shadow := device.shadow_map(description,&shadow_program) >>>
    distant := lights.point(fm.vec3(100.0,100.0,100.0),white,1.0) >>>
    env := lights.environment(fm.vec3(0.08,0.08,0.08),origin,1.0,[distant,point]) >>>
    room_data := cube(3.0) >>>
    box_data := cube(1.0) >>>
    $room := device.upload(&room_data) >>>
    $box := device.upload(&box_data) >>>
    $casters := []ren.ShadowCaster3D{}
    for center in [fm.vec3(1.5,0.12,-0.07),fm.vec3(-1.4,-0.15,0.08),fm.vec3(0.06,1.6,-0.09),
        fm.vec3(-0.12,-1.45,0.16),fm.vec3(0.1,-0.08,1.3),fm.vec3(-0.14,0.09,-1.55)] {
        casters.push(ren.shadow_caster(box.reference(), world(center,0.25)))
    }
    // All twelve cube edges and eight corners have real occluders.
    for pair in 0:3 { for a in [-1.0,1.0] { for b in [-1.0,1.0] {
        $center := fm.vec3(a*1.1,b*1.1,0.15)
        if pair==1 { center=fm.vec3(a*1.1,0.15,b*1.1) }
        if pair==2 { center=fm.vec3(0.15,a*1.1,b*1.1) }
        casters.push(ren.shadow_caster(box.reference(), world(center,0.12)))
    } } }
    for x in [-1.0,1.0] { for y in [-1.0,1.0] { for z in [-1.0,1.0] {
        casters.push(ren.shadow_caster(box.reference(), world(fm.vec3(x,y,z),0.1)))
    } } }
    assert(casters.len==26 && (shadow.render(&device,&casters,description) >>>)==1872)
    $tree := nexus.new_scene_tree_3d("World",16) >>>
    node := tree.add_child_3d(tree.root(),"Room") >>>
    $scene := bridge.new_scene_3d(&device) >>>
    scene.attach_mesh(&tree,node,&room) >>>
    material := ren.material_3d(fm.vec3(0.6,0.6,0.6),0.0,0.8,fm.vec3(0.0,0.0,0.0)) >>>
    scene.set_material(&tree,node,material) >>>
    $values := []int{}
    $lit := []string{}
    $dark := []string{}
    for face in 0:6 {
        vp := camera(face,0.0) >>>
        lit.push(capture($&device,&scene,&tree,vp,&env,&shadow,false,str(face)+"-lit",$&values) >>>)
        dark.push(capture($&device,&scene,&tree,vp,&env,&shadow,true,str(face)+"-occluded",$&values) >>>)
        assert(values[face*2+1]<values[face*2] && lit[face]!=dark[face])
    }
    duplicate := lights.environment(fm.vec3(0.08,0.08,0.08),origin,1.0,[distant,point,point]) >>>
    capture($&device,&scene,&tree,camera(0,0.0) >>>,&duplicate,&shadow,true,"duplicate",$&values) >>>
    assert(values[12]==values[0])
    for changed in [lights.point(fm.vec3(0.1,0.0,0.0),white,10.0) >>>,lights.point(origin,white,9.0) >>>,
        lights.directional(fm.vec3(0.0,0.0,1.0),white) >>>] {
        changed_env := lights.environment(fm.vec3(0.08,0.08,0.08),origin,1.0,[distant,changed]) >>>
        assert(failed_binding(&shadow,&changed_env))
    }
    assert(failed_render($&shadow,&device,policy.default_directional()))
    after := capture($&device,&scene,&tree,camera(0,0.0) >>>,&env,&shadow,true,"after-invalid",$&values) >>>
    assert(after==dark[0])
    capture($&device,&scene,&tree,camera(0,-0.00001) >>>,&env,&shadow,true,"jitter-left",$&values) >>>
    capture($&device,&scene,&tree,camera(0,0.00001) >>>,&env,&shadow,true,"jitter-right",$&values) >>>
    moved_point := lights.point(fm.vec3(0.25,0.1,-0.2),white,10.0) >>>
    moved_description := policy.point(moved_point,0.1,128) >>>
    moved_env := lights.environment(fm.vec3(0.08,0.08,0.08),origin,1.0,[distant,moved_point]) >>>
    shadow.render(&device,&casters,moved_description) >>>
    moved_lit := capture($&device,&scene,&tree,camera(0,0.0) >>>,&moved_env,&shadow,false,"moved-lit",$&values) >>>
    moved_dark := capture($&device,&scene,&tree,camera(0,0.0) >>>,&moved_env,&shadow,true,"moved-occluded",$&values) >>>
    assert(moved_lit!=moved_dark && moved_dark!=dark[0])
    moved_empty := []ren.ShadowCaster3D{}
    shadow.render(&device,&moved_empty,moved_description) >>>
    moved_clear := capture($&device,&scene,&tree,camera(0,0.0) >>>,&moved_env,&shadow,true,"moved-empty",$&values) >>>
    assert(moved_clear==moved_lit)
    // A sloped receiving plane crosses point-face seams; normals are smoothed.
    $plane := mesh.new_mesh_data_3d()
    for xy in [fm.vec2(-5.0,-5.0),fm.vec2(-5.0,5.0),fm.vec2(5.0,5.0),fm.vec2(5.0,-5.0)] {
        plane.vertex_lit(fm.vec3(xy.x,xy.y,3.0+0.2*xy.x+0.1*xy.y),4294967295,fm.vec3(0.0,0.0,-1.0)) >>>
    }
    plane.triangle(0,1,2) >>>
    plane.triangle(0,2,3) >>>
    $sloped := device.upload(&plane) >>>
    scene.attach_mesh(&tree,node,&sloped) >>>
    self_casters := scene.shadow_casters(&tree) >>>
    shadow.render(&device,&self_casters,description) >>>
    control := capture($&device,&scene,&tree,camera(4,0.0) >>>,&env,&shadow,false,"plane-control",$&values) >>>
    self := capture($&device,&scene,&tree,camera(4,0.0) >>>,&env,&shadow,true,"plane-self",$&values) >>>
    assert(control==self)
    scene.attach_mesh(&tree,node,&room) >>>
    empty := []ren.ShadowCaster3D{}
    for i in 0:30 { shadow.render(&device,&empty,description) >>> }
    for face in 0:6 {
        cleared := capture($&device,&scene,&tree,camera(face,0.0) >>>,&env,&shadow,true,str(face)+"-empty",$&values) >>>
        assert(cleared==lit[face])
    }
    large := policy.point(point,0.1,512) >>>
    $extra := []ren.ShadowMap3D{}
    for i in 0:2 { item := device.shadow_map(large,&shadow_program) >>>
        extra.push(item) }
    assert(failed_create(&device,large,&shadow_program))
    for i in 0:extra.len { item := $&extra[i]
        item.close() >>> }
    $recovered := device.shadow_map(large,&shadow_program) >>>
    recovered.close() >>>
    shadow.close() >>>
    assert(failed_binding(&shadow,&env))
    room.close() >>>
    box.close() >>>
    sloped.close() >>>
    device.close() >>>
    println("PASS: point shadow atlas six faces/12 edges/8 corners, stable duplicate-light identity, stale source/layout rejection, cross-face sloped-plane self shadow, six-face clear/30 refreshes, 24 MiB map budget/lifetime recovery")
    << 0
}
fn main() int { << run() >>>(err){ eprintln(err.msg())
    << 1 } }
