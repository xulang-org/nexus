@main

fm #"github.com/xulang-org/nexus/foundation/math"
vp #"github.com/xulang-org/nexus/integration/viewport"
#math

fn close(a f64, b f64) bool {
    << math.abs(a - b) < 0.000001
}

fn rejects_metrics(lw int, lh int, pw int, ph int) bool {
    vp.from_metrics(lw, lh, pw, ph, 0, 0, lw, lh) or (err) { << true }
    << false
}

fn rejects_letterbox(area fm.Rect2, ww f64, wh f64) bool {
    vp.fit_letterbox(area, ww, wh) or (err) { << true }
    << false
}

fn rejects_padding(v &vp.Viewport, left f64) bool {
    v.safe_inset_rect(left, 0.0, 0.0, 0.0) or (err) { << true }
    << false
}

fn run() int {
    assert(rejects_metrics(0, 100, 100, 100))
    assert(rejects_metrics(100, 100, 0, 100))
    // Clamp safe area inside logical bounds and deduct once.
    notched := vp.from_metrics(390, 844, 1170, 2532, -10, 47, 410, 763) or >>
    assert(close(notched.safe_rect.position.x, 0.0))
    assert(close(notched.safe_rect.position.y, 47.0))
    assert(close(notched.safe_rect.size.x, 390.0))
    assert(close(notched.safe_rect.size.y, 763.0))
    assert(close(notched.density_x(), 3.0) && close(notched.density_y(), 3.0))
    assert(!notched.is_landscape())

    inner := notched.safe_inset_rect(12.0, 56.0, 12.0, 152.0) or >>
    assert(close(inner.position.x, 12.0) && close(inner.position.y, 103.0))
    assert(close(inner.size.x, 366.0) && close(inner.size.y, 555.0))
    assert(rejects_padding(&notched, -1.0))

    fit := vp.fit_letterbox(inner, 360.0, 420.0) or >>
    assert(close(fit.scale, 366.0 / 360.0))
    world_pt := fm.vec2(180.0, 210.0)
    logical_pt := fit.world_to_logical_point(world_pt) or >>
    assert(fit.contains_logical(logical_pt))
    roundtrip := fit.logical_to_world(logical_pt) or >>
    assert(close(roundtrip.x, world_pt.x) && close(roundtrip.y, world_pt.y))

    px := fit.world_to_pixels(&notched).point(world_pt)
    assert(close(px.x, logical_pt.x * 3.0) && close(px.y, logical_pt.y * 3.0))

    // Degenerate or inverted safe area falls back cleanly to full logical bounds.
    fallback := vp.from_metrics(844, 390, 2532, 1170, 0, 0, 0, 0) or >>
    assert(fallback.is_landscape())
    assert(close(fallback.safe_rect.size.x, 844.0) && close(fallback.safe_rect.size.y, 390.0))
    assert(!notched.same_geometry(&fallback))
    assert(notched.same_geometry(&notched))
    assert(rejects_letterbox(fm.rect2(0.0, 0.0, 0.0, 10.0), 360.0, 420.0))
    assert(rejects_letterbox(fm.rect2(0.0, 0.0, 100.0, 100.0), 0.0, 420.0))

    println("phone viewport: safe-area clamping, single inset deduction and letterbox inverse PASS")
    << 0
}

fn main() int {
    << run() or (err) {
        eprintln(err.msg())
        << 1
    }
}
