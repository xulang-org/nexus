@main

inp #"github.com/xulang-org/nexus/input"
timing #"github.com/xulang-org/nexus/timing"
#errors
#math

fn assert(ok bool, msg string) int {
    if !ok { >> errors.new("input_replay_timing_checks: " + msg) }
    << 0
}

fn run() int {
    // 1. Input rebinding + JSON roundtrip + gamepad deadzone shaping.
    $src_map := inp.new_input_map()
    src_map.bind("jump", 32) >>>
    src_map.bind("fire", 70) >>>
    src_map.bind_source("move_left", 1) >>>
    src_map.bind_source("move_right", 2) >>>
    src_map.rebind_key("jump", 32, 87) >>>

    keys := src_map.action_keys("jump") >>>
    assert(keys.len == 1 && keys[0] == 87, "rebind_key moved jump from 32 to 87") >>>

    exported := src_map.export_bindings_json()
    $live := inp.new_input_map()
    live.import_bindings_json(&exported) >>>
    live_keys := live.action_keys("jump") >>>
    assert(live_keys.len == 1 && live_keys[0] == 87, "JSON bindings imported") >>>

    assert(math.abs(inp.apply_deadzone(0.10, 0.15) >>>) < 1e-9, "deadzone zeros inner stick") >>>
    dz_edge := inp.apply_deadzone(1.0, 0.2) >>>
    assert(math.abs(dz_edge - 1.0) < 1e-9, "deadzone scales full deflection to 1.0") >>>
    live.feed_axis_pair(1, 2, 0.6, 0.2) >>>
    assert(math.abs((live.axis("move_left", "move_right") >>>) - 0.5) < 1e-6, "axis pair deadzone 0.5") >>>

    // 2. Deterministic InputRecorder -> JSON -> InputReplayer replay.
    $rec := inp.new_recorder()
    rec.record_key(0, 87, true) >>>
    rec.record_source(1, 2, 0.75) >>>
    rec.record_key(2, 87, false) >>>
    tape_json := rec.encode_json() >>>

    $replayer := inp.decode_tape_json(&tape_json) >>>
    $play_map := inp.new_input_map()
    play_map.import_bindings_json(&exported) >>>

    play_map.begin_frame()
    assert((replayer.apply_frame(0, $&play_map) >>>) == 1, "frame 0 applies 1 event") >>>
    assert((play_map.just_pressed("jump") >>>) && (play_map.pressed("jump") >>>), "frame 0 jump just_pressed") >>>

    play_map.begin_frame()
    assert((replayer.apply_frame(1, $&play_map) >>>) == 1, "frame 1 applies source event") >>>
    assert(!(play_map.just_pressed("jump") >>>) && math.abs((play_map.value("move_right") >>>) - 0.75) < 1e-6, "frame 1 move_right=0.75") >>>

    play_map.begin_frame()
    _ := replayer.apply_frame(2, $&play_map) >>>
    assert((play_map.just_released("jump") >>>) && replayer.is_finished(), "frame 2 jump released and tape finished") >>>

    // 3. ScaledClock: slow-mo, fast-forward, pause, hitstop.
    $clk := timing.new_scaled_clock(60, 8) >>>
    clk.set_time_scale(0.5) >>>
    st1 := clk.advance(1.0 / 30.0) >>> // 0.5 * 1/30 = 1/60 -> exactly 1 step!
    assert(st1.steps == 1 && math.abs(clk.unscaled_elapsed() - (1.0 / 30.0)) < 1e-6, "0.5x slow-mo produces 1 fixed step from 1/30s") >>>

    clk.set_time_scale(2.0) >>>
    st2 := clk.advance(1.0 / 60.0) >>> // 2.0 * 1/60 = 1/30 -> 2 steps!
    assert(st2.steps == 2, "2.0x scale produces 2 fixed steps per 60Hz frame") >>>

    clk.trigger_hitstop(0.05) >>>
    st_hit := clk.advance(0.03) >>>
    assert(st_hit.steps == 0 && st_hit.in_hitstop && clk.in_hitstop(), "hitstop freezes scaled steps") >>>
    _ := clk.advance(0.03) >>> // drains remaining 0.02s hitstop
    assert(!clk.in_hitstop(), "hitstop expired after unscaled time elapsed") >>>

    clk.set_paused(true)
    st_pause := clk.advance(0.05) >>>
    assert(st_pause.steps == 0 && st_pause.paused, "pause freezes scaled steps") >>>

    println("PASS: input_replay_timing_checks")
    << 0
}

fn main() int {
    run() >>> (err) {
        println("FAIL: " + err.msg())
        << 1
    }
    << 0
}
