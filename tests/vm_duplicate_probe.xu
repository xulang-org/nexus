@main
vm #"github.com/xulang-org/nexus/script/vm"
bc #"github.com/xulang-org/nexus/script/bytecode"
#os

fn run() int {
    raw := os.read("build/scene-script-fixtures/mover.xubc") >>>
    original := vm.instantiate(bc.decode(&raw) >>>) >>>
    println(original.epoch())
    duplicate := original.duplicate() >>>
    println(duplicate.epoch())
    << 0
}
fn main() int { << run() >>> (e) { println(e.msg())
    << 1 } }
