@main

codec #"github.com/xulang-org/nexus/formats/scene"
fm #"github.com/xulang-org/nexus/foundation/math"
physics #"github.com/xulang-org/nexus/physics2d"
scene2d #"github.com/xulang-org/nexus/integration/rendering/two_d"
tiles #"github.com/xulang-org/nexus/resources/tilemap"
nexus #"github.com/xulang-org/nexus/scene"
#math
#os
#strings

fn check_tile_layouts() int {
    $tree := nexus.new_scene_tree("Root", 8) or >>
    root := tree.root()
    parent := tree.add_child(root, "Parent") or >>
    node := tree.add_child(parent, "TileMap") or >>
    tree.set_transform(parent, fm.transform_2d(fm.vec2(120.0, 50.0), 0.2, fm.vec2(1.5, 0.8))) or >>
    tree.set_position(node, fm.vec2(25.0, -10.0)) or >>
    world := tree.global_transform(node) or >>

    $camera := nexus.new_camera_2d(320.0, 240.0) or >>
    camera.position = fm.vec2(160.0, 90.0)
    camera.rotation = -0.4
    camera.zoom = 1.3
    for layout in [tiles.LAYOUT_ORTHOGONAL, tiles.LAYOUT_ISOMETRIC, tiles.LAYOUT_STAGGERED] {
        atlas := tiles.tileset_2d(2, 2, 64.0, 80.0, fm.vec2(0.5, 0.75)) or >>
        $grid := tiles.new_tilemap_2d(layout, 4, 4, 64.0, 32.0, 12.0, atlas) or >>
        grid.set_cell(2, 1, 3) or >>
        grid.set_elevation(2, 1, 2.0) or >>
        layer := scene2d.new_tilemap_layer_2d(node, grid, 0, true, 0.0) or >>
        for row in 0:4 {
            for col in 0:4 {
                ground := world.point(layer.grid.cell_center(col, row))
                pixel := camera.world_to_screen(ground, 1200.0, 720.0) or >>
                picked := layer.pick_cell(&tree, &camera, pixel, 1200.0, 720.0) or >>
                assert(picked.col == col && picked.row == row)
            }
        }
        cell := layer.grid.cell_center(2, 1)
        raised := layer.grid.cell_visual_center(2, 1) or >>
        assert(raised.x == cell.x && raised.y == cell.y - 24.0)

        // Queue a marker just behind the ground anchor. Elevation moves the
        // drawn quad above it without moving the tile ahead of it in draw order.
        $queue := scene2d.new_ysort_queue_2d()
        assert((layer.enqueue(&tree, $&queue, 3) or >>) == 1)
        mark := world.point(cell)
        queue.push_quad(fm.rect2(0.0, 0.0, 1.0, 1.0), fm.rect2(0.0, 0.0, 1.0, 1.0),
            world, 4294967295, 8, 0, mark.y - 1.0) or >>
        runs := queue.record_runs(fm.transform_2d(fm.vec2(0.0, 0.0), 0.0, fm.vec2(1.0, 1.0))) or >>
        assert(runs.len == 2 && runs[0].texture_id == 8 && runs[1].texture_id == 3)
    }
    layer := scene2d.new_parallax_layer_2d(0.5, 0.25, 0.0, 0.0) or >>
    first := layer.view_transform(&camera, 1200.0, 720.0) or >>
    full_first := camera.view_transform(1200.0, 720.0) or >>
    camera.position.x += 20.0
    second := layer.view_transform(&camera, 1200.0, 720.0) or >>
    full_second := camera.view_transform(1200.0, 720.0) or >>
    assert(math.abs((second.tx - first.tx) - (full_second.tx - full_first.tx) * 0.5) < 0.0000001)
    << 0
}

fn rejects_overlap(collider &physics.TileMapCollider2D, center fm.Vec2, half_size fm.Vec2) bool {
    collider.move_and_slide(center, fm.vec2(0.0, 0.0), half_size) or (err) { << true }
    << false
}

fn check_tile_collision() int {
    atlas := tiles.tileset_2d(2, 1, 64.0, 128.0, fm.vec2(0.5, 0.75)) or >>
    world := fm.transform_2d(fm.vec2(120.0, 50.0), 0.2, fm.vec2(1.5, 0.8))
    half_size := fm.vec2(0.1, 0.1)
    for layout in [tiles.LAYOUT_ORTHOGONAL, tiles.LAYOUT_ISOMETRIC, tiles.LAYOUT_STAGGERED] {
        $grid := tiles.new_tilemap_2d(layout, 4, 4, 64.0, 32.0, 12.0, atlas) or >>
        grid.set_tile_solid(1, true) or >>
        grid.set_cell(2, 1, 1) or >>
        grid.set_cell(3, 1, 0) or >>
        grid.set_elevation(2, 1, 3.0) or >>
        snapshot := grid.clone() or >>
        grid.set_tile_solid(1, false) or >>
        assert((snapshot.cell_is_solid(2, 1) or >>) && !(grid.cell_is_solid(2, 1) or >>))
        assert(!(snapshot.cell_is_solid(3, 1) or >>) && !(snapshot.cell_is_solid(0, 0) or >>))
        collider := physics.new_tilemap_collider_2d(&snapshot, world) or >>
        local := snapshot.cell_center(2, 1)
        center := world.point(local)
        $u := fm.vec2(64.0, 0.0)
        $v := fm.vec2(0.0, 32.0)
        if layout != tiles.LAYOUT_ORTHOGONAL {
            u = fm.vec2(32.0, 16.0)
            v = fm.vec2(-32.0, 16.0)
        }
        du := world.point(local.add(u)).sub(center)
        dv := world.point(local.add(v)).sub(center)

        // A large step hits the ground footprint, then slides along the free axis.
        start := center.sub(du.scaled(3.0)).add(dv.scaled(0.1))
        motion := du.scaled(4.0).add(dv.scaled(0.25))
        blocked := collider.move_and_slide(start, motion, half_size) or >>
        expected := center.sub(du.scaled(0.6)).add(dv.scaled(0.35))
        assert(blocked.collisions == 1 && blocked.position.sub(expected).length() < 0.001)
        assert(rejects_overlap(&collider, center, half_size))
        resumed := collider.move_and_slide(blocked.position, dv.scaled(0.4), half_size) or >>
        assert(resumed.collisions == 0 && resumed.position.sub(blocked.position.add(dv.scaled(0.4))).length() < 0.001)

        passable := start.add(dv)
        open := collider.move_and_slide(passable, motion, half_size) or >>
        assert(open.collisions == 0 && open.position.sub(passable.add(motion)).length() < 0.001)
    }
    << 0
}

fn rejects_scene(raw &string) bool {
    codec.decode(raw) or (err) { << true }
    << false
}

fn check_collision_format() int {
    raw := os.read("examples/isometric_2d/assets/world.xuscene") or >>
    document := codec.decode(&raw) or >>
    assert(document.has_solid_tiles_2d() && document.tilemap_2d_count() == 2)
    layer := document.tilemap_2d(1) or >>
    assert((layer.grid.cell_is_solid(2, 2) or >>) && !(layer.grid.cell_is_solid(3, 3) or >>))
    canonical := codec.encode(&document) or >>
    restored := codec.decode(&canonical) or >>
    assert(canonical == (codec.encode(&restored) or >>))
    assert(strings.contains(&canonical, "\"version\":8"))
    for bad in ["[2,2]", "[4]", "[-1]", "[true]", "{}"] {
        invalid := strings.replace_all(&canonical, "\"solid_tiles\":[2]", "\"solid_tiles\":" + bad)
        assert(rejects_scene(&invalid))
    }
    missing := strings.replace_all(&canonical, ",\"solid_tiles\":[2]", "")
    assert(rejects_scene(&missing))
    no_solids := strings.replace_all(&missing, ",\"solid_tiles\":[]", "")
    legacy_raw := strings.replace_all(&no_solids, "\"version\":8", "\"version\":7")
    legacy := codec.decode(&legacy_raw) or >>
    assert(!legacy.has_solid_tiles_2d())
    encoded_legacy := codec.encode(&legacy) or >>
    assert(encoded_legacy == legacy_raw)
    << 0
}

fn run() int {
    check_tile_layouts() or >>
    check_tile_collision() or >>
    check_collision_format() or >>
    println("PASS: tile layouts, picking, depth, parallax, transformed swept collision / sliding, strict v8 and legacy v7 scenes")
    << 0
}

fn main() int {
    << run() or (err) {
        eprintln(err.msg())
        << 1
    }
}
