@main
#os
#gpu
#window
#errors
#strings
fm #"github.com/xulang-org/nexus/foundation/math"
present #"github.com/xulang-org/nexus/platform/present"
canvas #"github.com/xulang-org/nexus/resources/canvas"
meshes #"github.com/xulang-org/nexus/resources/mesh"
lights #"github.com/xulang-org/nexus/resources/lighting"
nexus #"github.com/xulang-org/nexus/scene"
shaders2 #"github.com/xulang-org/nexus/assets/shaders/two_d"
shaders3 #"github.com/xulang-org/nexus/assets/shaders/three_d"
ren2 #"github.com/xulang-org/nexus/rendering/two_d"
ren3 #"github.com/xulang-org/nexus/rendering/three_d"
bridge3 #"github.com/xulang-org/nexus/integration/rendering/three_d"

const PX_BLACK = 255
const PX_RED = 4278190335
const PX_GREEN = 16711935
const PX_BLUE = 65535
const PX_WHITE = 4294967295
const PX_HALF_RED = 4278190208

fn px_r(c int) int { << (c >> 24) & 255 }
fn px_g(c int) int { << (c >> 16) & 255 }
fn px_b(c int) int { << (c >> 8) & 255 }
fn px_a(c int) int { << c & 255 }

fn quad_data_3d(half f64, z f64, color int) meshes.MeshData3D {
    $data := meshes.new_mesh_data_3d()
    n := fm.vec3(0.0, 0.0, 1.0)
    data.vertex_lit_uv(fm.vec3(-half, -half, z), color, n, fm.vec2(0.0, 0.0)) >>>
    data.vertex_lit_uv(fm.vec3(half, -half, z), color, n, fm.vec2(1.0, 0.0)) >>>
    data.vertex_lit_uv(fm.vec3(half, half, z), color, n, fm.vec2(1.0, 1.0)) >>>
    data.vertex_lit_uv(fm.vec3(-half, half, z), color, n, fm.vec2(0.0, 1.0)) >>>
    data.triangle(0, 1, 2) >>>
    data.triangle(0, 2, 3) >>>
    << data
}

fn tri_data_3d(a fm.Vec3, b fm.Vec3, c fm.Vec3, color int) meshes.MeshData3D {
    $data := meshes.new_mesh_data_3d()
    n := fm.vec3(0.0, 0.0, 1.0)
    data.vertex_lit_uv(a, color, n, fm.vec2(0.0, 0.0)) >>>
    data.vertex_lit_uv(b, color, n, fm.vec2(1.0, 0.0)) >>>
    data.vertex_lit_uv(c, color, n, fm.vec2(0.5, 1.0)) >>>
    data.triangle(0, 1, 2) >>>
    << data
}

fn mode_tag(mode_id int) string {
    if mode_id == present.MODE_GPU { << "gpu" }
    if mode_id == present.MODE_SOFTWARE { << "software" }
    << "headless"
}

fn expect_mode(actual_mode int, actual_name string, is_gpu bool, is_sw bool, has_win bool, expect int) {
    assert(actual_mode == expect)
    assert(actual_name == mode_tag(expect))
    if expect == present.MODE_GPU {
        assert(is_gpu && !is_sw && has_win)
    } else if expect == present.MODE_SOFTWARE {
        assert(!is_gpu && is_sw && has_win)
    } else {
        assert(!is_gpu && is_sw && !has_win)
    }
}

fn rejects_submit_texture(r $&ren2.Renderer2D, batch &canvas.Batch2D, tex &ren2.Texture2D) bool {
    r.submit_texture(batch, tex) >>> (err) { << true }
    << false
}

fn rejects_set_material(scene $&bridge3.Scene3D, tree &nexus.SceneTree, node int, mat ren3.Material3D) bool {
    scene.set_material(tree, node, mat) >>> (err) { << true }
    << false
}

fn rejects_draw_ref(d $&ren3.Device3D, mesh ren3.MeshRef3D, vp fm.Mat4) bool {
    d.draw_reference(mesh, vp) >>> (err) { << true }
    << false
}

fn check_2d(expect int, canvas_prog &ren2.ShaderProgram2D, sdf_prog &ren2.SdfProgram2D) int {
    wopts := window.Options{title: "Adaptive 2D " + mode_tag(expect), width: 128, height: 128,
        resizable: false, high_pixel_density: false, hidden: true}
    $r := ren2.open_2d_window_adaptive(wopts, gpu.AUTO, canvas_prog) >>>
    expect_mode(r.backend_mode() >>>, r.mode_name() >>>, r.is_gpu(), r.is_software(), r.has_display_window(), expect)
    r.enable_sdf(sdf_prog) >>>

    // Frame 1: SDF rounded_rect (with border) + circle + Batch2D quad.
    r.begin(PX_BLACK) >>>
    $sdf := canvas.new_sdf_batch()
    sdf.rounded_rect(fm.rect2(16.0, 16.0, 64.0, 48.0), 12.0, PX_RED, 4.0, PX_GREEN) >>>
    sdf.circle(fm.vec2(96.0, 96.0), 16.0, PX_BLUE, 0.0, 0) >>>
    r.submit_sdf(&sdf) >>>

    $batch := canvas.new_batch()
    batch.quad(fm.rect2(4.0, 80.0, 24.0, 24.0), fm.identity(), PX_WHITE) >>>
    r.submit(&batch) >>>

    center_px := r.read_pixel(48, 40) >>>
    assert(px_r(center_px) >= 250 && px_g(center_px) <= 5 && px_b(center_px) <= 5 && px_a(center_px) == 255)
    border_px := r.read_pixel(18, 40) >>>
    assert(px_g(border_px) >= 200 && px_r(border_px) <= 60 && px_b(border_px) <= 60 && px_a(border_px) == 255)
    corner_out := r.read_pixel(17, 17) >>>
    assert(px_r(corner_out) <= 5 && px_g(corner_out) <= 5 && px_b(corner_out) <= 5)
    circ_in := r.read_pixel(96, 96) >>>
    assert(px_b(circ_in) >= 250 && px_r(circ_in) <= 5 && px_g(circ_in) <= 5)
    circ_out := r.read_pixel(82, 82) >>>
    assert(px_b(circ_out) <= 5 && px_r(circ_out) <= 5 && px_g(circ_out) <= 5)
    quad_px := r.read_pixel(16, 92) >>>
    assert(quad_px == PX_WHITE)

    png_path := "build/present-2d-" + mode_tag(expect) + ".png"
    r.capture(png_path + "") >>>
    png_bytes := os.read(png_path + "") >>>
    assert(png_bytes.len > 64)
    r.present() >>>

    // Frame 2: shared-diagonal semitransparent quad (no double blending) + Texture2D sampling.
    tex_px := [PX_RED, PX_GREEN, PX_BLUE, PX_WHITE]
    $tex := r.texture_rgba(2, 2, &tex_px, false) >>>
    r.begin(PX_BLUE) >>>
    $alpha := canvas.new_batch()
    alpha.quad(fm.rect2(0.0, 0.0, 64.0, 64.0), fm.identity(), PX_HALF_RED) >>>
    r.submit(&alpha) >>>
    diag_px := r.read_pixel(20, 20) >>>
    above_px := r.read_pixel(10, 30) >>>
    below_px := r.read_pixel(30, 10) >>>
    assert(px_r(diag_px) >= 126 && px_r(diag_px) <= 130 && px_g(diag_px) == 0 && px_b(diag_px) >= 126 && px_b(diag_px) <= 130 && px_a(diag_px) == 255)
    assert(diag_px == above_px && diag_px == below_px)

    $tex_batch := canvas.new_batch()
    tex_batch.quad(fm.rect2(64.0, 0.0, 64.0, 64.0), fm.identity(), PX_WHITE) >>>
    r.submit_texture(&tex_batch, &tex) >>>
    assert((r.read_pixel(80, 16) >>>) == PX_RED)
    assert((r.read_pixel(112, 16) >>>) == PX_GREEN)
    assert((r.read_pixel(80, 48) >>>) == PX_BLUE)
    assert((r.read_pixel(112, 48) >>>) == PX_WHITE)
    tex.close() >>>
    assert(rejects_submit_texture($&r, &tex_batch, &tex))
    r.present() >>>
    r.close() >>>

    if expect == present.MODE_SOFTWARE {
        sw_opts := window.Options{title: "Software 2D", width: 128, height: 128,
            resizable: false, high_pixel_density: false, hidden: true}
        $sw := ren2.open_2d_software(sw_opts) >>>
        expect_mode(sw.backend_mode() >>>, sw.mode_name() >>>, sw.is_gpu(), sw.is_software(), sw.has_display_window(), present.MODE_SOFTWARE)
        sw.begin(PX_GREEN) >>>
        assert((sw.read_pixel(10, 10) >>>) == PX_GREEN)
        sw.present() >>>
        sw.close() >>>
    }
    $hd := ren2.open_2d_headless(32, 32) >>>
    expect_mode(hd.backend_mode() >>>, hd.mode_name() >>>, hd.is_gpu(), hd.is_software(), hd.has_display_window(), present.MODE_HEADLESS)
    hd.enable_sdf(sdf_prog) >>>
    hd.begin(PX_BLACK) >>>
    $hsdf := canvas.new_sdf_batch()
    hsdf.fill_rect(fm.rect2(4.0, 4.0, 24.0, 24.0), 4.0, PX_RED) >>>
    hd.submit_sdf(&hsdf) >>>
    assert((hd.read_pixel(16, 16) >>>) == PX_RED)
    hd.present() >>>
    hd.close() >>>
    << 0
}

fn check_3d(expect int, prog3 &ren3.ShaderProgram3D, canvas_prog &ren2.ShaderProgram2D, sdf_prog &ren2.SdfProgram2D) int {
    wopts := window.Options{title: "Adaptive 3D " + mode_tag(expect), width: 128, height: 128,
        resizable: false, high_pixel_density: false, hidden: true}
    $d := ren3.open_3d_window_adaptive(wopts, gpu.AUTO, prog3) >>>
    expect_mode(d.backend_mode() >>>, d.mode_name() >>>, d.is_gpu(), d.is_software(), d.has_display_window(), expect)

    back_data := quad_data_3d(1.5, 0.0, PX_WHITE) >>>
    front_data := quad_data_3d(0.4, 1.0, PX_WHITE) >>>
    behind_data := tri_data_3d(fm.vec3(-1.0, -1.0, 5.0), fm.vec3(1.0, -1.0, 5.0), fm.vec3(0.0, 1.0, 5.0), PX_WHITE) >>>
    near_data := tri_data_3d(fm.vec3(-1.5, -1.5, 0.0), fm.vec3(1.5, -1.5, 0.0), fm.vec3(0.0, 2.5, 4.5), PX_WHITE) >>>

    $back_mesh := d.upload(&back_data) >>>
    $front_mesh := d.upload(&front_data) >>>
    $behind_mesh := d.upload(&behind_data) >>>
    $near_mesh := d.upload(&near_data) >>>

    red_px := [PX_RED]
    $red_tex := d.texture_rgba(1, 1, &red_px, true, false, false) >>>
    mat_red := (ren3.material_3d(fm.vec3(1.0, 1.0, 1.0), 0.0, 0.8, fm.vec3(0.0, 0.0, 0.0)) >>>).with_base_texture(&red_tex)
    mat_green := ren3.material_3d(fm.vec3(0.0, 1.0, 0.0), 0.0, 0.8, fm.vec3(0.0, 0.0, 0.0)) >>>
    env := lights.environment(fm.vec3(1.0, 1.0, 1.0), fm.vec3(0.0, 0.0, 4.0), 1.0, []lights.Light3D{}) >>>
    view := nexus.look_at_3d(fm.vec3(0.0, 0.0, 4.0), fm.vec3(0.0, 0.0, 0.0), fm.vec3(0.0, 1.0, 0.0)) >>>
    vp := (nexus.perspective_3d(0.8, 1.0, 0.1, 100.0) >>>).multiply(view)

    // 1. Reverse-Z occlusion (closer drawn first) + PBR sRGB byte parity (185..190).
    d.begin(PX_BLACK) >>>
    d.draw_material(&front_mesh, fm.identity_3d(), vp, &mat_green, &env) >>>
    d.draw_material(&back_mesh, fm.identity_3d(), vp, &mat_red, &env) >>>
    occluded := d.read_pixel(64, 64) >>>
    assert(px_g(occluded) >= 180 && px_r(occluded) == 0 && px_b(occluded) == 0)
    lit_red := d.read_pixel(24, 64) >>>
    assert(px_r(lit_red) >= 185 && px_r(lit_red) <= 190 && px_g(lit_red) == 0 && px_b(lit_red) == 0 && px_a(lit_red) == 255)
    d.present() >>>

    // 2. Behind-camera cull + near-plane homogeneous clipping (separate frames because read_pixel seals GPU pass).
    d.begin(PX_BLACK) >>>
    d.draw_material(&behind_mesh, fm.identity_3d(), vp, &mat_green, &env) >>>
    assert((d.read_pixel(64, 64) >>>) == PX_BLACK)
    d.present() >>>

    d.begin(PX_BLACK) >>>
    d.draw_material(&near_mesh, fm.identity_3d(), vp, &mat_red, &env) >>>
    clipped_hit := d.read_pixel(64, 64) >>>
    assert(px_r(clipped_hit) >= 180 && px_g(clipped_hit) == 0)
    d.present() >>>

    // 3. 2x supersampling + PNG readback.
    d.set_render_scale(2) >>>
    assert((d.width() >>>) == 128 && (d.height() >>>) == 128)
    d.begin(PX_BLACK) >>>
    d.draw_material(&back_mesh, fm.identity_3d(), vp, &mat_red, &env) >>>
    ss_red := d.read_pixel(64, 64) >>>
    assert(px_r(ss_red) >= 185 && px_r(ss_red) <= 190 && px_g(ss_red) == 0 && px_b(ss_red) == 0)
    png3_path := "build/present-3d-" + mode_tag(expect) + ".png"
    d.capture(png3_path + "") >>>
    png3_bytes := os.read(png3_path + "") >>>
    assert(png3_bytes.len > 64)
    d.present() >>>
    d.set_render_scale(1) >>>

    // 4. Scene3D draw_lit + Overlay2D multi-pass UI composition.
    $tree := nexus.new_scene_tree_3d("World", 16) >>>
    node := tree.add_child_3d(tree.root(), "RedQuad") >>>
    $scene := bridge3.new_scene_3d(&d) >>>
    scene.attach_mesh(&tree, node, &back_mesh) >>>
    scene.set_material(&tree, node, mat_red) >>>

    psess := d.present_session() >>>
    $overlay := ren2.open_overlay(psess, canvas_prog, sdf_prog) >>>
    assert(overlay.is_gpu() == d.is_gpu())

    d.begin(PX_BLACK) >>>
    report := scene.draw_lit($&d, &tree, vp, &env) >>>
    assert(report.instances == 1)
    s_red := d.read_pixel(48, 48) >>>
    assert(px_r(s_red) >= 185 && px_r(s_red) <= 190)

    $ui_sdf := canvas.new_sdf_batch()
    ui_sdf.circle(fm.vec2(96.0, 96.0), 16.0, PX_BLUE, 0.0, 0) >>>
    $ui_batch := canvas.new_batch()
    ui_batch.quad(fm.rect2(8.0, 8.0, 24.0, 24.0), fm.identity(), PX_WHITE) >>>
    overlay.clear() >>>
    overlay.submit_sdf(&ui_sdf) >>>
    overlay.submit(&ui_batch) >>>

    if d.is_gpu() {
        $frame := d.begin_present_frame() >>>
        overlay.flush_gpu_frame(d.gpu_device() >>>, $&frame, 128, 128, gpu.LOAD, 0) >>>
        d.finish_present_frame($&frame) >>>
    } else {
        d.software_prepare_present() >>>
        overlay.flush_software(d.software_pixels_mut() >>>, 128, 128, false, 0) >>>
        sess := d.present_session() >>>
        bg_comp := sess.read_software_pixel(48, 48) >>>
        assert(px_r(bg_comp) >= 185 && px_r(bg_comp) <= 190 && px_g(bg_comp) == 0)
        ui_circ := sess.read_software_pixel(96, 96) >>>
        assert(px_b(ui_circ) >= 250 && px_r(ui_circ) <= 5)
        ui_quad := sess.read_software_pixel(16, 16) >>>
        assert(ui_quad == PX_WHITE)
        comp_path := "build/present-composite-" + mode_tag(expect) + ".png"
        sess.capture_software_png(comp_path + "") >>>
        comp_bytes := os.read(comp_path + "") >>>
        assert(comp_bytes.len > 64)
        d.present_software_frame() >>>
    }

    // 5. Closed SoftBlob / Mesh3D / Texture3D handle rejection.
    $dead_tex := d.texture_rgba(1, 1, &red_px, false, false, false) >>>
    dead_mat := (ren3.material_3d(fm.vec3(1.0, 1.0, 1.0), 0.0, 0.8, fm.vec3(0.0, 0.0, 0.0)) >>>).with_base_texture(&dead_tex)
    dead_tex.close() >>>
    assert(rejects_set_material($&scene, &tree, node, dead_mat))

    $dead_mesh := d.upload(&front_data) >>>
    dead_ref := dead_mesh.reference()
    dead_mesh.close() >>>
    d.begin(PX_BLACK) >>>
    assert(rejects_draw_ref($&d, dead_ref, vp))
    d.present() >>>

    overlay.close() >>>
    near_mesh.close() >>>
    behind_mesh.close() >>>
    front_mesh.close() >>>
    back_mesh.close() >>>
    red_tex.close() >>>
    d.close() >>>

    if expect == present.MODE_SOFTWARE {
        sw_opts := window.Options{title: "Software 3D", width: 128, height: 128,
            resizable: false, high_pixel_density: false, hidden: true}
        $sw3 := ren3.open_3d_software(sw_opts) >>>
        expect_mode(sw3.backend_mode() >>>, sw3.mode_name() >>>, sw3.is_gpu(), sw3.is_software(), sw3.has_display_window(), present.MODE_SOFTWARE)
        sw3.close() >>>
    }
    $hd3 := ren3.open_3d_headless(32, 32) >>>
    expect_mode(hd3.backend_mode() >>>, hd3.mode_name() >>>, hd3.is_gpu(), hd3.is_software(), hd3.has_display_window(), present.MODE_HEADLESS)
    $hm := hd3.upload(&front_data) >>>
    hd3.begin(PX_BLACK) >>>
    hd3.draw(&hm, vp) >>>
    assert((hd3.read_pixel(16, 16) >>>) == PX_WHITE)
    hd3.present() >>>
    hm.close() >>>
    hd3.close() >>>
    << 0
}

fn run() int {
    args := os.args()
    $mode_arg := "gpu"
    if args.len > 1 { mode_arg = args[1] + "" }
    $mode_id := present.MODE_GPU
    if mode_arg == "gpu" {
        mode_id = present.MODE_GPU
    } else if mode_arg == "software" {
        mode_id = present.MODE_SOFTWARE
    } else if mode_arg == "headless" {
        mode_id = present.MODE_HEADLESS
    } else {
        >> errors.new("present fallback check: expected gpu, software, or headless mode")
    }
    canvas_prog := shaders2.load_canvas("build/canvas-shaders") >>>
    sdf_prog := shaders2.load_ui_sdf("build/canvas-shaders") >>>
    mesh_prog := shaders3.load_mesh("build/mesh-shaders") >>>
    check_2d(mode_id, &canvas_prog, &sdf_prog) >>>
    check_3d(mode_id, &mesh_prog, &canvas_prog, &sdf_prog) >>>
    println("PASS: present fallback & overlay compositor verified in " + mode_arg + " mode")
    << 0
}

fn main() int {
    << run() >>> (err) {
        eprintln(err.msg())
        << 1
    }
}
