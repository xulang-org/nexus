@main
codec #"github.com/xulang-org/nexus/formats/scene"
#os
#strings

fn rejected(raw &string) bool { codec.decode(raw) >>> (err) { << true }
    << false }
fn run() int {
    for path in ["build/scene-audio-fixtures/base.xuscene", "build/scene-audio-fixtures/full.xuscene", "examples/scene_av/assets/world.xuscene"] {
        raw := os.read(path) >>>
        document := codec.decode(&raw) >>>
        assert(document.audio_count() > 0 && document.audio_bus_count() > 0)
        encoded := codec.encode(&document) >>>
        restored := codec.decode(&encoded) >>>
        assert(encoded == (codec.encode(&restored) >>>))
        assert(restored.audio_count() == document.audio_count() && restored.surface_count() == document.surface_count())
    }
    failures := os.read("build/scene-audio-fixtures/reject-list.txt") >>>
    rows := strings.split(&failures, "\n")
    $count := 0
    for row in rows {
        if row.len == 0 { -> }
        raw := os.read("build/scene-audio-fixtures/" + row) >>>
        if !rejected(&raw) { println("Accepted invalid audio scene " + row)
            assert(false) }
        count = count + 1
    }
    println("PASS: WAV/bus/emitter/spatial descriptors, canonical audio/AV roundtrip, 32 emitters/16 buses and " + str(count) + " strict rejects")
    << 0
}
fn main() int { << run() >>> (err) { eprintln(err.msg())
    << 1 } }
