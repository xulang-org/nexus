@main

diag #"github.com/xulang-org/nexus/foundation/diagnostics"
fm #"github.com/xulang-org/nexus/foundation/math"
scene #"github.com/xulang-org/nexus/scene"
controls #"github.com/xulang-org/nexus/input"
timing #"github.com/xulang-org/nexus/timing"
xacp #"github.com/xulang-org/nexus/xacp"
#encoding/xun
#os
#strings
#strconv
#time
#errors

fn send_request(fd int, body &string) int {
    frame := "XACP/1\n" + str(body.len) + "\n" + *body
    $offset := 0
    while offset < frame.len {
        $end := offset + 512
        if end > frame.len { end = frame.len }
        n := os.socket_write(fd, frame[offset:end]) >>>
        if n <= 0 { >> errors.new("send_request: socket write error") }
        offset += n
    }
    << 0
}

struct TestReader {
    fd int
    remainder string
}

fn (r $&TestReader) wait_readable() int {
    for _ in 0:2000 {
        ready := os.socket_poll(r.fd, 1) >>>
        if ready != 0 { << 0 }
        time.sleep(1000000)
    }
    >> errors.new("xacp test: timed out waiting for socket response")
}

fn (r $&TestReader) read_line() string {
    while true {
        idx := strings.index_byte(&r.remainder, 10)
        if idx >= 0 {
            line := r.remainder[0:idx]
            r.remainder = r.remainder[idx + 1:r.remainder.len]
            if line.len > 0 && line[line.len - 1] == 13 {
                << line[0:line.len - 1]
            }
            << line
        }
        r.wait_readable() >>>
        chunk := os.socket_read(r.fd, 4096) >>>
        if chunk.len == 0 { >> errors.new("EOF") }
        r.remainder = r.remainder + chunk
    }
}

fn (r $&TestReader) read_bytes(count int) string {
    while r.remainder.len < count {
        r.wait_readable() >>>
        chunk := os.socket_read(r.fd, 4096) >>>
        if chunk.len == 0 { >> errors.new("EOF") }
        r.remainder = r.remainder + chunk
    }
    body := r.remainder[0:count]
    r.remainder = r.remainder[count:r.remainder.len]
    << body
}

fn (r $&TestReader) read_frame() string {
    magic := r.read_line() >>>
    if magic != "XACP/1" { >> errors.new("bad magic: " + magic) }
    len_line := r.read_line() >>>
    length := strconv.atoi(&len_line) >>>
    body := r.read_bytes(length) >>>
    << body
}

fn wait_poll(ctrl $&xacp.GameControl, tree $&scene.SceneTree, input $&controls.InputMap) int {
    for _ in 0:200 {
        if ctrl.poll(tree, input) {
            << 0
        }
        time.sleep(1000000)
    }
    >> errors.new("xacp test: timed out waiting for ctrl.poll")
}

fn wait_poll_full(ctrl $&xacp.GameControl, tree $&scene.SceneTree, input $&controls.InputMap,
                  logger $&diag.Logger, cvars $&diag.CVarRegistry, profiler $&timing.FrameProfiler) int {
    for _ in 0:200 {
        if ctrl.poll_full(tree, input, logger, cvars, profiler) {
            << 0
        }
        time.sleep(1000000)
    }
    >> errors.new("xacp test: timed out waiting for ctrl.poll_full")
}

fn run_tests() int {
    println("=== Nexus Engine XACP Integration Test Suite ===")

    $tree := scene.new_scene_tree("World", 128) >>>
    level := tree.add_child(tree.root(), "Level") >>>
    player := tree.add_child(level, "Player") >>>
    tree.set_position(player, fm.vec2(100.0, 200.0)) >>>
    gem := tree.add_child(level, "Gem0") >>>
    tree.set_position(gem, fm.vec2(300.0, 400.0)) >>>

    $input := controls.new_input_map()
    input.bind("up", xacp.KEY_W) >>>
    input.bind("left", xacp.KEY_A) >>>
    input.bind_mouse("fire", controls.MOUSE_BUTTON_LEFT) >>>

    port := 19876
    $ctrl := xacp.attach_tcp(port)
    assert(ctrl.is_open())
    ctrl.set_canvas_size(1280, 720)
    ctrl.set_frame(42)

    client := os.socket(2, 1, 0) >>>
    os.connect4(client, 127, 0, 0, 1, port) >>>
    $reader := TestReader{fd: client, remainder: ""}

    // Test 1: xacp.hello
    hello_req := "id: !i 1\nop: xacp.hello\nargs:\n  ver: !ver 1.0.0\n  nonce: \"test-nexus-nonce\"\n"
    send_request(client, &hello_req) >>>
    hello_res := reader.read_frame() >>>
    assert(strings.contains(&hello_res, "ok: !b true"))
    assert(strings.contains(&hello_res, "test-nexus-nonce"))
    assert(strings.contains(&hello_res, "target: \"nexus\""))
    println("  [OK] xacp.hello capability handshake and target negotiation")

    // Test 2: proc.status
    status_req := "id: !i 2\nop: proc.status\nargs: {}\n"
    send_request(client, &status_req) >>>
    status_res := reader.read_frame() >>>
    assert(strings.contains(&status_res, "ok: !b true"))
    assert(strings.contains(&status_res, "state: \"OPEN\""))
    println("  [OK] proc.status process status query")

    // Test 3: ui.tree
    tree_req := "id: !i 3\nop: ui.tree\nargs:\n  win: !i 1\n"
    send_request(client, &tree_req) >>>
    wait_poll($&ctrl, $&tree, $&input) >>>
    tree_res := reader.read_frame() >>>
    assert(strings.contains(&tree_res, "ok: !b true"))
    assert(strings.contains(&tree_res, "revision: !i "))
    assert(strings.contains(&tree_res, "World"))
    assert(strings.contains(&tree_res, "Player"))
    assert(strings.contains(&tree_res, "Gem0"))
    assert(strings.contains(&tree_res, "total: !i 4"))
    println("  [OK] ui.tree scene hierarchy inspection and serialization")

    // Test 4: ui.input (keyboard)
    is_up := input.pressed("up") >>>
    assert(!is_up)
    input_req := "id: !i 4\nop: ui.input\nargs:\n  win: !i 1\n  steps: [{ev: key_down, key: !i 119}]\n"
    send_request(client, &input_req) >>>
    wait_poll($&ctrl, $&tree, $&input) >>>
    input_res := reader.read_frame() >>>
    assert(strings.contains(&input_res, "ok: !b true"))
    assert(strings.contains(&input_res, "applied: !i 1"))
    is_up_now := input.pressed("up") >>>
    assert(is_up_now)
    println("  [OK] ui.input virtual keyboard injection into nexus input map")

    // Test 5: ui.act (pause & unpause with structured action feedback)
    assert(!tree.paused)
    act_req := "id: !i 5\nop: ui.act\nargs:\n  win: !i 1\n  node: !i 1\n  act: pause\n"
    send_request(client, &act_req) >>>
    wait_poll($&ctrl, $&tree, $&input) >>>
    act_res := reader.read_frame() >>>
    assert(strings.contains(&act_res, "ok: !b true"))
    assert(strings.contains(&act_res, "paused: !b true"))
    assert(tree.paused)

    unpause_req := "id: !i 6\nop: ui.act\nargs:\n  win: !i 1\n  node: !i 1\n  act: unpause\n"
    send_request(client, &unpause_req) >>>
    wait_poll($&ctrl, $&tree, $&input) >>>
    unpause_res := reader.read_frame() >>>
    assert(strings.contains(&unpause_res, "ok: !b true"))
    assert(strings.contains(&unpause_res, "paused: !b false"))
    assert(!tree.paused)

    re_pause_req := "id: !i 7\nop: ui.act\nargs:\n  win: !i 1\n  node: !i 1\n  act: pause\n"
    send_request(client, &re_pause_req) >>>
    wait_poll($&ctrl, $&tree, $&input) >>>
    _ := reader.read_frame() >>>
    assert(tree.paused)
    println("  [OK] ui.act pause and unpause control actions")

    // Test 6: nexus.step
    step_req := "id: !i 8\nop: nexus.step\nargs:\n  frames: !i 5\n"
    send_request(client, &step_req) >>>
    wait_poll($&ctrl, $&tree, $&input) >>>
    step_res := reader.read_frame() >>>
    assert(strings.contains(&step_res, "ok: !b true"))
    assert(strings.contains(&step_res, "frame_number: !i 42"))
    assert(ctrl.steps_remaining == 5)
    assert(ctrl.consume_step())
    assert(ctrl.steps_remaining == 4)
    println("  [OK] nexus.step frame-by-frame advance control")

    // Test 7: nexus.state (reflects configured canvas dimensions and frame)
    state_req := "id: !i 9\nop: nexus.state\nargs: {}\n"
    send_request(client, &state_req) >>>
    wait_poll($&ctrl, $&tree, $&input) >>>
    state_res := reader.read_frame() >>>
    assert(strings.contains(&state_res, "node_count: !i 4"))
    assert(strings.contains(&state_res, "paused: !b true"))
    assert(strings.contains(&state_res, "frame_number: !i 42"))
    assert(strings.contains(&state_res, "canvas_width: !i 1280"))
    assert(strings.contains(&state_res, "canvas_height: !i 720"))
    println("  [OK] nexus.state internal metrics query")

    // Test 8: ui.screenshot
    shot_req := "id: !i 10\nop: ui.screenshot\nargs:\n  win: !i 1\n  mode: file\n"
    send_request(client, &shot_req) >>>
    wait_poll($&ctrl, $&tree, $&input) >>>
    assert(ctrl.screenshot_requested())
    ctrl.fulfill_screenshot(1280, 720, "tests/xu.xun")
    shot_res := reader.read_frame() >>>
    assert(xun.parse(&shot_res).ok())
    assert(strings.contains(&shot_res, "ok: !b true"))
    assert(strings.contains(&shot_res, "pixel_width: !i 1280"))
    println("  [OK] ui.screenshot rendering lifecycle synchronization")

    // Test 9: invalid_request_id recovery (0, -1, duplicate, skipped)
    bad_zero := "id: !i 0\nop: proc.status\nargs: {}\n"
    send_request(client, &bad_zero) >>>
    assert(strings.contains(&reader.read_frame() >>>, "code: invalid_request_id"))
    bad_dup := "id: !i 10\nop: proc.status\nargs: {}\n"
    send_request(client, &bad_dup) >>>
    assert(strings.contains(&reader.read_frame() >>>, "code: invalid_request_id"))
    bad_skip := "id: !i 12\nop: proc.status\nargs: {}\n"
    send_request(client, &bad_skip) >>>
    assert(strings.contains(&reader.read_frame() >>>, "code: invalid_request_id"))
    ok_next := "id: !i 11\nop: proc.status\nargs: {}\n"
    send_request(client, &ok_next) >>>
    assert(strings.contains(&reader.read_frame() >>>, "id: !i 11\nok: !b true"))
    println("  [OK] strict monotonic request_id enforcement and recovery")

    os.socket_close(client) >>>

    // Test 10: Cross-connection nonce replay rejection on same listener
    c_replay := os.socket(2, 1, 0) >>>
    os.connect4(c_replay, 127, 0, 0, 1, port) >>>
    $r_replay := TestReader{fd: c_replay, remainder: ""}
    send_request(c_replay, &hello_req) >>>
    replay_res := r_replay.read_frame() >>>
    assert(strings.contains(&replay_res, "code: nonce_replay"))
    os.socket_close(c_replay) >>>
    ctrl.close()
    println("  [OK] cross-connection nonce replay rejection")

    // Test 11: close() unbinds listener & mixed 3D/Group nodes + XUN escaping
    $tree3d := scene.new_scene_tree_3d("Stage3D", 64) >>>
    grp := tree3d.add_group(tree3d.root(), "Entities") >>>
    hero3d := tree3d.add_child_3d(grp, "Hero \"Alpha\" \\v1") >>>
    tree3d.set_position_3d(hero3d, fm.vec3(1.5, 2.5, 3.5)) >>>
    sub2d := tree3d.add_child(grp, "HudItem") >>>
    tree3d.set_position(sub2d, fm.vec2(42.0, 84.0)) >>>

    $ctrl2 := xacp.attach_tcp(port)
    assert(ctrl2.is_open())
    c2 := os.socket(2, 1, 0) >>>
    os.connect4(c2, 127, 0, 0, 1, port) >>>
    $r2 := TestReader{fd: c2, remainder: ""}
    hello_req2 := "id: !i 1\nop: xacp.hello\nargs:\n  ver: !ver 1.0.0\n  nonce: \"test-3d-nonce\"\n"
    send_request(c2, &hello_req2) >>>
    _ := r2.read_frame() >>>
    tree_req2 := "id: !i 2\nop: ui.tree\nargs:\n  win: !i 1\n"
    send_request(c2, &tree_req2) >>>
    wait_poll($&ctrl2, $&tree3d, $&input) >>>
    tree3d_res := r2.read_frame() >>>
    assert(strings.contains(&tree3d_res, "ok: !b true"))
    assert(strings.contains(&tree3d_res, "node_kind: \"Group\""))
    assert(strings.contains(&tree3d_res, "node_kind: \"Node3D\""))
    assert(strings.contains(&tree3d_res, "dim: !i 3"))
    assert(strings.contains(&tree3d_res, "z: !f 3.5"))
    assert(strings.contains(&tree3d_res, "node_kind: \"Node2D\""))
    assert(strings.contains(&tree3d_res, "Hero \\\"Alpha\\\" \\\\v1"))
    os.socket_close(c2) >>>
    ctrl2.close()
    println("  [OK] close() port reuse, 3D/Group scene tree and XUN string escaping")

    // Test 12: Token auth enforcement before handshake and bad token rejection
    $ctrl_auth := xacp.attach_tcp_with_token(0, "nexus-secret-token")
    assert(ctrl_auth.is_open())
    assert(ctrl_auth.port > 0)
    c_bad := os.socket(2, 1, 0) >>>
    os.connect4(c_bad, 127, 0, 0, 1, ctrl_auth.port) >>>
    $r_bad := TestReader{fd: c_bad, remainder: ""}

    unauth_s_req := "id: !i 1\nop: proc.status\nargs: {}\n"
    send_request(c_bad, &unauth_s_req) >>>
    unauth_status := r_bad.read_frame() >>>
    assert(strings.contains(&unauth_status, "code: auth_required"))

    bad_hello := "id: !i 1\nop: xacp.hello\nargs:\n  ver: !ver 1.0.0\n  nonce: \"n1\"\n  token: \"wrong\"\n"
    send_request(c_bad, &bad_hello) >>>
    bad_hello_res := r_bad.read_frame() >>>
    assert(strings.contains(&bad_hello_res, "code: auth_failed"))
    os.socket_close(c_bad) >>>

    c_ok := os.socket(2, 1, 0) >>>
    os.connect4(c_ok, 127, 0, 0, 1, ctrl_auth.port) >>>
    $r_ok := TestReader{fd: c_ok, remainder: ""}
    good_hello := "id: !i 1\nop: xacp.hello\nargs:\n  ver: !ver 1.0.0\n  nonce: \"n2\"\n  token: \"nexus-secret-token\"\n"
    send_request(c_ok, &good_hello) >>>
    good_hello_res := r_ok.read_frame() >>>
    assert(strings.contains(&good_hello_res, "ok: !b true"))

    send_request(c_ok, &tree_req2) >>>
    wait_poll($&ctrl_auth, $&tree3d, $&input) >>>
    auth_tree_res := r_ok.read_frame() >>>
    assert(strings.contains(&auth_tree_res, "ok: !b true"))
    assert(strings.contains(&auth_tree_res, "Stage3D"))
    os.socket_close(c_ok) >>>
    ctrl_auth.close()
    println("  [OK] token authentication enforcement and rejection before handshake")

    // Test 13: request_timeout when poll() is not called, then recovery
    short_limits := xacp.ServerLimits{
        request_timeout_ms: 150,
        write_timeout_ms: 2000,
        hello_timeout_ms: 2000,
        idle_timeout_ms: 5000,
        nonce_cache: 128,
        nonce_replay: true
    }
    $ctrl_to := xacp.attach_tcp_with_limits(0, "", short_limits)
    assert(ctrl_to.is_open())
    c_to := os.socket(2, 1, 0) >>>
    os.connect4(c_to, 127, 0, 0, 1, ctrl_to.port) >>>
    $r_to := TestReader{fd: c_to, remainder: ""}
    send_request(c_to, &hello_req) >>>
    assert(strings.contains(&r_to.read_frame() >>>, "ok: !b true"))
    to_tree_req := "id: !i 2\nop: ui.tree\nargs: {}\n"
    send_request(c_to, &to_tree_req) >>>
    to_res := r_to.read_frame() >>>
    assert(strings.contains(&to_res, "code: request_timeout"))
    // Session remains open and next id works when polled
    to_state_req := "id: !i 3\nop: nexus.state\nargs: {}\n"
    send_request(c_to, &to_state_req) >>>
    wait_poll($&ctrl_to, $&tree, $&input) >>>
    assert(strings.contains(&r_to.read_frame() >>>, "ok: !b true"))
    os.socket_close(c_to) >>>
    ctrl_to.close()
    println("  [OK] request_timeout delivery and post-timeout session recovery")

    // Test 14: Pointer/scroll/modifiers ui.input + UI node mirror + ui.tree filters + ui.act
    $ctrl_ui := xacp.attach_tcp(0)
    assert(ctrl_ui.is_open())
    ctrl_ui.register_ui_node(xacp.UiNodeSnapshot{
        id: 100, parent: -1, kind: "UiPanel", label: "HUD",
        x: 0.0, y: 0.0, width: 400.0, height: 300.0,
        visible: true, enabled: true, focusable: false, focused: false, checked: false, value: 0.0
    })
    ctrl_ui.register_ui_node(xacp.UiNodeSnapshot{
        id: 101, parent: 100, kind: "UiButton", label: "Play",
        x: 20.0, y: 20.0, width: 120.0, height: 40.0,
        visible: true, enabled: true, focusable: true, focused: false, checked: false, value: 0.0
    })
    ctrl_ui.register_ui_node(xacp.UiNodeSnapshot{
        id: 102, parent: 100, kind: "UiToggle", label: "Audio",
        x: 20.0, y: 80.0, width: 120.0, height: 32.0,
        visible: true, enabled: true, focusable: true, focused: false, checked: false, value: 0.0
    })

    c_ui := os.socket(2, 1, 0) >>>
    os.connect4(c_ui, 127, 0, 0, 1, ctrl_ui.port) >>>
    $r_ui := TestReader{fd: c_ui, remainder: ""}
    send_request(c_ui, &hello_req) >>>
    _ := r_ui.read_frame() >>>

    ptr_req := "id: !i 2\nop: ui.input\nargs:\n  win: !i 1\n  steps: [{ev: pointer_move, x: !f 150.0, y: !f 220.0, dx: !f 5.0, dy: !f -3.0}, {ev: pointer_down, button: !i 1, x: !f 150.0, y: !f 220.0, modifiers: !i 3}, {ev: scroll, dx: !f 0.0, dy: !f 1.5}]\n"
    send_request(c_ui, &ptr_req) >>>
    wait_poll($&ctrl_ui, $&tree, $&input) >>>
    ptr_res := r_ui.read_frame() >>>
    assert(strings.contains(&ptr_res, "applied: !i 3"))
    assert(strings.contains(&ptr_res, "mouse_x: !f 150"))
    assert(input.pressed("fire") >>>)
    assert(input.has_modifier(controls.MOD_SHIFT))

    act_focus := "id: !i 3\nop: ui.act\nargs:\n  win: !i 1\n  node: !i 101\n  act: focus\n"
    send_request(c_ui, &act_focus) >>>
    wait_poll($&ctrl_ui, $&tree, $&input) >>>
    assert(strings.contains(&r_ui.read_frame() >>>, "consumed: !b true"))

    act_toggle := "id: !i 4\nop: ui.act\nargs:\n  win: !i 1\n  node: !i 102\n  act: click\n"
    send_request(c_ui, &act_toggle) >>>
    wait_poll($&ctrl_ui, $&tree, $&input) >>>
    toggle_res := r_ui.read_frame() >>>
    assert(strings.contains(&toggle_res, "checked: !b true"))

    act_text := "id: !i 5\nop: ui.act\nargs:\n  win: !i 1\n  node: !i 101\n  act: set_text\n  text: \"Resume\"\n"
    send_request(c_ui, &act_text) >>>
    wait_poll($&ctrl_ui, $&tree, $&input) >>>
    _ := r_ui.read_frame() >>>

    ui_tree_req := "id: !i 6\nop: ui.tree\nargs:\n  scope: \"ui\"\n  focused_only: !b true\n"
    send_request(c_ui, &ui_tree_req) >>>
    wait_poll($&ctrl_ui, $&tree, $&input) >>>
    ui_tree_res := r_ui.read_frame() >>>
    assert(strings.contains(&ui_tree_res, "total: !i 1"))
    assert(strings.contains(&ui_tree_res, "id: !i 102"))

    all_tree_req := "id: !i 7\nop: ui.tree\nargs:\n  scope: \"all\"\n"
    send_request(c_ui, &all_tree_req) >>>
    wait_poll($&ctrl_ui, $&tree, $&input) >>>
    all_tree_res := r_ui.read_frame() >>>
    assert(strings.contains(&all_tree_res, "total: !i 7"))
    assert(strings.contains(&all_tree_res, "text: \"Resume\""))

    drained := ctrl_ui.drain_ui_actions()
    assert(drained.len == 3)
    assert(drained[0].act == "focus" && drained[1].act == "click" && drained[2].text == "Resume")
    os.socket_close(c_ui) >>>
    ctrl_ui.close()
    println("  [OK] pointer/scroll ui.input, UI mirror ui.tree, and widget ui.act feedback")

    // Test 15: poll_full (Logger -> proc.output, CVarRegistry -> nexus.cvar, FrameProfiler -> nexus.state, deferred step)
    $logger := diag.new_logger(64) >>>
    _ := logger.info("boot", "nexus xacp ready", 10) >>>
    _ := logger.warn("render", "frame spike", 20) >>>
    $cvars := diag.new_cvar_registry()
    _ := cvars.register_int("r.fov", 75, diag.CVAR_NONE, "camera fov") >>>
    $profiler := timing.new_frame_profiler()
    profiler.record_frame_ms(16.0)
    profiler.record_frame_ms(16.0)

    $ctrl_full := xacp.attach_tcp(0)
    assert(ctrl_full.is_open())
    ctrl_full.set_frame(100)
    c_full := os.socket(2, 1, 0) >>>
    os.connect4(c_full, 127, 0, 0, 1, ctrl_full.port) >>>
    $r_full := TestReader{fd: c_full, remainder: ""}
    send_request(c_full, &hello_req) >>>
    _ := r_full.read_frame() >>>

    out_req := "id: !i 2\nop: proc.output\nargs:\n  stream: \"log\"\n  since: !i 0\n  max_bytes: !i 4096\n"
    send_request(c_full, &out_req) >>>
    wait_poll_full($&ctrl_full, $&tree, $&input, $&logger, $&cvars, $&profiler) >>>
    out_res := r_full.read_frame() >>>
    assert(strings.contains(&out_res, "nexus xacp ready"))
    assert(strings.contains(&out_res, "frame spike"))

    cvar_req := "id: !i 3\nop: nexus.cvar\nargs:\n  cmd: \"r.fov 90\"\n"
    send_request(c_full, &cvar_req) >>>
    wait_poll_full($&ctrl_full, $&tree, $&input, $&logger, $&cvars, $&profiler) >>>
    cvar_res := r_full.read_frame() >>>
    assert(strings.contains(&cvar_res, "exec_ok: !b true"))
    assert(strings.contains(&cvar_res, "r.fov = 90"))

    full_state_req := "id: !i 4\nop: nexus.state\nargs: {}\n"
    send_request(c_full, &full_state_req) >>>
    wait_poll_full($&ctrl_full, $&tree, $&input, $&logger, $&cvars, $&profiler) >>>
    full_state_res := r_full.read_frame() >>>
    assert(strings.contains(&full_state_res, "profiler_frames: !i 2"))
    assert(strings.contains(&full_state_res, "log_count: !i 2"))

    wait_step_req := "id: !i 5\nop: nexus.step\nargs:\n  frames: !i 2\n  wait: !b true\n"
    send_request(c_full, &wait_step_req) >>>
    wait_poll_full($&ctrl_full, $&tree, $&input, $&logger, $&cvars, $&profiler) >>>
    assert(ctrl_full.consume_step())
    assert(!ctrl_full.complete_step_if_done(tree.paused))
    assert(ctrl_full.consume_step())
    ctrl_full.set_frame(102)
    assert(ctrl_full.complete_step_if_done(tree.paused))
    wait_step_res := r_full.read_frame() >>>
    assert(strings.contains(&wait_step_res, "completed: !b true"))
    assert(strings.contains(&wait_step_res, "frame_number: !i 102"))

    // Test 16: reject_screenshot path redaction
    shot_fail_req := "id: !i 6\nop: ui.screenshot\nargs:\n  win: !i 1\n"
    send_request(c_full, &shot_fail_req) >>>
    wait_poll_full($&ctrl_full, $&tree, $&input, $&logger, $&cvars, $&profiler) >>>
    assert(ctrl_full.screenshot_requested())
    ctrl_full.reject_screenshot("failed writing /Users/secret/dump.png")
    shot_fail_res := r_full.read_frame() >>>
    assert(strings.contains(&shot_fail_res, "code: adapter_error"))
    assert(!strings.contains(&shot_fail_res, "/Users/secret"))
    assert(strings.contains(&shot_fail_res, "<path>"))

    os.socket_close(c_full) >>>
    ctrl_full.close()
    println("  [OK] poll_full (proc.output, nexus.cvar, profiler, deferred nexus.step, error redaction)")

    println("=== ALL XACP NEXUS TESTS PASSED! ===")
    << 0
}

fn main() int {
    << run_tests() >>> (err) {
        eprintln("test failed: " + err.msg())
        << 1
    }
}
