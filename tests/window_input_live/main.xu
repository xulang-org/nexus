@main

#window
#window/events
#gpu
#os
#strconv
#errors
#time
controls #"github.com/xulang-org/nexus/input"
input_bridge #"github.com/xulang-org/nexus/integration/input"

// The action map stays in nexus. Device/window/event mechanisms use the SDK;
// no engine renderer, scene, native archive or shader compiler is needed.
fn old_log() string {
    << read_file("build/os-input-gpu.log") >>> (err) { << "" }
}
fn run() int {
    $input_log := old_log()
    input_log.push_str("OPEN\n")
    write_file("build/os-input-gpu.log",input_log) >>>
    $previous_active := false

    args := os.args()
    $frames := 7200
    if args.len == 3 && args[1] == "--frames" {
        value := args[2]
        frames = strconv.atoi(&value) >>>
        if frames < 1 || frames > 1000000 { >>> errors.new("frames must be 1...1000000") }
    } else if args.len != 1 { >>> errors.new("usage: window-input [--frames count]") }
    options := window.Options{title: "Xu input: W/Space green, Escape closes; type text",width: 640,height: 360,
        resizable: true,high_pixel_density: true,hidden: false}
    $target := window.open(&options) >>>
    target.start_text_input() >>>
    target.text_input_area(20,20,600,40,4) >>>
    $device := gpu.open(gpu.DeviceOptions{backend: gpu.AUTO,debug: true,shader_formats: 0}) >>>
    $surface := device.surface(&target,gpu.SurfaceOptions{present_mode: gpu.PRESENT_VSYNC}) >>>
    $input := controls.new_input_map()
    input.bind("activate",events.KEY_W) >>>
    input.bind("activate",events.KEY_SPACE) >>>
    input.bind("quit",events.KEY_ESCAPE) >>>
    $presented := 0
    $received := 0
    for frame_index in 0:frames {
        input.begin_frame()
        window.pump() >>>
        for i in 0:events.QUEUE_CAPACITY {
            event := target.poll() >>>
            if event.kind == events.EVENT_NONE { <- }
            input_bridge.apply_window_input($&input,&event) >>>
            if event.kind == events.EVENT_TEXT_INPUT { println("Text: " + event.text) }
            if event.kind == events.EVENT_TEXT_EDITING { println("Composition: " + event.text) }
            if event.kind == events.EVENT_INPUT_RESET { println("Input history reset: " + str(event.reset_reason)) }
            received += 1
        }
        state := target.state() >>>
        quit := input.pressed("quit") >>>
        if state.close_requested || quit { <- }
        $frame := surface.acquire() >>>
        if !frame.has_image() { time.sleep(16000000)
            -> }
        active := input.pressed("activate") >>>
        $color := gpu.Color{r: 0.05,g: 0.12,b: 0.45,a: 1.0}
        if active { color = gpu.Color{r: 0.05,g: 0.7,b: 0.15,a: 1.0} }
        $pass := frame.begin_render(gpu.CLEAR,color,gpu.no_depth()) >>>
        pass.end() >>>
        $fence := frame.present() >>>
        fence.close() >>>
        if active != previous_active {
            if active { input_log.push_str("PRESENTED_GREEN\n")
            } else { input_log.push_str("PRESENTED_BLUE\n") }
            write_file("build/os-input-gpu.log",input_log) >>>
            previous_active = active
        }
        presented += 1
    }
    surface.close() >>>
    stats := device.stats() >>>
    assert(stats.surface_count == 0 && stats.frame_count == 0 && stats.encoder_count == 0 && stats.submission_count == 0)
    device.close() >>>
    target.stop_text_input() >>>
    target.close() >>>
    assert((window.live_count() >>>) == 0)
    input_log.push_str("CLOSED_ZERO_RESOURCES\n")
    write_file("build/os-input-gpu.log",input_log) >>>
    println("Finished standard window/input actions and GPU clear frames with zero live resources")
    println(presented)
    println(received)
    << 0
}
fn main() int {
    << run() >>> (err) { eprintln(err.msg())
        << 1 }
}
