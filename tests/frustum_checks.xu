@main
fm #"github.com/xulang-org/nexus/foundation/math"
#math
#os
#encoding/binary
fn box(x f64,y f64,z f64) fm.Aabb3 { p := fm.vec3(x,y,z)
    << fm.aabb3(p,p) or >> }
fn bad(bounds fm.Aabb3,matrix fm.Mat4,relative f64,absolute f64) bool {
    bounds.intersects_clip(matrix,relative,absolute) or(err){ << true }
    << false
}
fn run() int {
    identity := fm.identity_3d()
    inside := fm.aabb3(fm.vec3(-0.5,-0.5,0.1),fm.vec3(0.5,0.5,0.9)) or >>
    assert(inside.intersects_clip(identity,1e-12,1e-300) or >>)
    for p in [fm.vec3(-2.0,0.0,0.5),fm.vec3(2.0,0.0,0.5),fm.vec3(0.0,-2.0,0.5),
              fm.vec3(0.0,2.0,0.5),fm.vec3(0.0,0.0,-0.1),fm.vec3(0.0,0.0,1.1)] {
        outside := fm.aabb3(p,p) or >>
        assert(!(outside.intersects_clip(identity,1e-12,1e-300) or >>))
    }
    for p in [fm.vec3(-1.0,0.0,0.5),fm.vec3(1.0,0.0,0.5),fm.vec3(0.0,-1.0,0.5),
              fm.vec3(0.0,1.0,0.5),fm.vec3(0.0,0.0,0.0),fm.vec3(0.0,0.0,1.0)] {
        touching := fm.aabb3(p,p) or >>
        assert(touching.intersects_clip(identity,1e-12,1e-300) or >>)
    }
    tangent := box(1.000001,0.0,0.5) or >>
    assert(tangent.intersects_clip(identity,0.00001,1e-36) or >>)
    projection := fm.Mat4{c0: fm.vec4(1.0,0.0,0.0,0.0),c1: fm.vec4(0.0,1.0,0.0,0.0),
        c2: fm.vec4(0.0,0.0,1.0/9.0,-1.0),c3: fm.vec4(0.0,0.0,10.0/9.0,0.0)}
    for z in [-1.0,-2.0,-10.0] { assert((box(0.0,0.0,z) or >>).intersects_clip(projection,1e-12,1e-300) or >>) }
    for z in [-0.5,-11.0,2.0] { assert(!((box(0.0,0.0,z) or >>).intersects_clip(projection,1e-12,1e-300) or >>)) }
    crossing := fm.aabb3(fm.vec3(-1.0,-1.0,-2.0),fm.vec3(1.0,1.0,2.0)) or >>
    assert(crossing.intersects_clip(projection,1e-12,1e-300) or >>)
    surrounding := fm.aabb3(fm.vec3(-100.0,-100.0,-100.0),fm.vec3(100.0,100.0,100.0)) or >>
    assert(surrounding.intersects_clip(projection,1e-12,1e-300) or >>)
    $huge := identity
    huge.c0.x=1e300
    assert((box(1e300,0.0,0.0) or >>).intersects_clip(huge,0.00001,1e-36) or >>)
    $invalid := identity
    invalid.c0.x=math.float64_from_bits(9221120237041090560)
    assert(bad(inside,invalid,0.0,0.0) && bad(inside,identity,-1.0,0.0) && bad(inside,identity,0.0,-1.0))
    assert(bad(fm.Aabb3{minimum: fm.vec3(1.0,1.0,1.0),maximum: fm.vec3(0.0,0.0,0.0)},identity,0.0,0.0))
    args := os.args()
    raw := os.read(args[1]+"") or >>
    $bytes := []u8{}
    for i in 0:raw.len { bytes.push(u8(raw[i])) }
    assert(bytes.len==512*22*8)
    for i in 0:512 {
        $v := []f64{}
        for j in 0:22 { v.push(binary.little_endian().get_f64(&bytes,(i*22+j)*8) or >>) }
        bounds := fm.aabb3(fm.vec3(v[0],v[1],v[2]),fm.vec3(v[3],v[4],v[5])) or >>
        matrix := fm.Mat4{c0: fm.vec4(v[6],v[7],v[8],v[9]),c1: fm.vec4(v[10],v[11],v[12],v[13]),
            c2: fm.vec4(v[14],v[15],v[16],v[17]),c3: fm.vec4(v[18],v[19],v[20],v[21])}
        assert(bounds.intersects_clip(matrix,1e-12,1e-300) or >>)
    }
    println("PASS: six closed clip planes, reverse-Z near/far/behind-camera, w=0 crossings, enclosing boxes, uncertainty retention, invalid inputs and 512 independent visible-point witnesses")
    << 0
}
fn main() int { << run() or(err){ eprintln(err.msg())
    << 1 } }
