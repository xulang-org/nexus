@main
obj #"github.com/xulang-org/nexus/formats/obj"
stl #"github.com/xulang-org/nexus/formats/stl"
gltf #"github.com/xulang-org/nexus/formats/gltf"
files #"github.com/xulang-org/nexus/assets/mesh"
fm #"github.com/xulang-org/nexus/foundation/math"
#os
#strings
#math
fn bad_obj(raw &string) bool { obj.decode(raw) or(err){ << true }
    << false }
fn bad_stl(raw &string) bool { stl.decode(raw) or(err){ << true }
    << false }
fn bad_load(path string) bool { files.load(path) or(err){ << true }
    << false }
fn run() int {
    args := os.args()
    root := args[1]+""
    for name in ["triangle","cube","tetrahedron"] {
        raw := os.read(root+"/"+name+".glb") or >>
        reference := gltf.decode_glb_geometry(&raw) or >>
        for suffix in [".obj",".ascii.stl",".binary.stl",".solid-header.stl"] {
            loaded := files.load(root+"/"+name+suffix) or >>
            assert(loaded.triangle_count()*3==(reference.index_count(0) or >>))
            for i in 0:loaded.indices.len {
                expected := reference.position(0,reference.index(0,i) or >>) or >>
                got := loaded.vertices[loaded.indices[i]].position
                assert(got.x==expected.x && got.y==expected.y && got.z==expected.z)
                normal := loaded.vertices[loaded.indices[i]].normal
                assert(math.abs(normal.dot(normal)-1.0)<0.000001)
            }
            loaded.bounds() or >>
        }
    }
    negative := files.load(root+"/negative.obj") or >>
    assert(negative.vertex_count()==3 && negative.vertices[2].has_uv && negative.vertices[2].uv.y==1.0 && negative.vertices[0].normal.z==1.0)
    normals := files.load(root+"/normal-only.obj") or >>
    assert(normals.vertices[0].normal.z==1.0 && !normals.vertices[0].has_uv)
    uvs := files.load(root+"/uv-only.obj") or >>
    assert(uvs.vertices[0].normal.z==1.0 && uvs.vertices[2].uv.x==0.5)
    seam := files.load(root+"/seam.obj") or >>
    assert(seam.vertex_count()==6 && seam.vertices[0].uv.x==0.0 && seam.vertices[3].uv.x==0.5)
    assert((files.load(root+"/uppercase.OBJ") or >>).triangle_count()==1)
    list := os.read(root+"/reject-list.txt") or >>
    $count := 0
    for name in strings.split(&list,"\n") {
        if name.len==0 { -> }
        raw := os.read(root+"/"+name) or >>
        $rejected := false
        if strings.has_suffix(&name,".obj") { rejected=bad_obj(&raw)
        } else { rejected=bad_stl(&raw) }
        if !rejected { println("Accepted malformed model: "+name)
            assert(false) }
        assert(bad_load(root+"/"+name))
        count+=1
    }
    for ext in ["fbx","ply","dae","blend","gltf"] { assert(bad_load(root+"/unsupported."+ext)) }
    assert(bad_load(root+"/missing.obj"))
    // Size is checked before text splitting, binary conversion or mesh output.
    $oversized := strings.new_byte_builder(16777217)
    for i in 0:16777217 { oversized.write_byte(32) }
    too_large := oversized.to_string()
    assert(bad_obj(&too_large) && bad_stl(&too_large))
    println("PASS: original triangle/cube/tetrahedron geometry agrees across GLB/OBJ/ASCII+binary STL; independent/negative indices, UV seams, normals, binary solid header, "+str(count)+" malformed inputs, size bounds and explicit unsupported-format dispatch")
    << 0
}
fn main() int { << run() or(err){ eprintln(err.msg())
    << 1 } }
