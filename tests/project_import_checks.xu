@main

proj #"github.com/xulang-org/nexus/integration/project"
codec #"github.com/xulang-org/nexus/formats/scene"
resource #"github.com/xulang-org/nexus/resources/scene"
snapshot #"github.com/xulang-org/nexus/internal/file_snapshot"
#encoding/json
#errors
#os
#os/exec
#path/filepath
#strings

struct Config {
    validator string
    project_cli string
    preview string
}

struct CmdResult {
    ok bool
    output string
}

fn check(cond bool, msg string) int {
    if !cond {
        >> errors.new("project_import_checks: " + msg)
    }
    << 0
}

fn copy_file(src string, dst string) int {
    dir := filepath.dir(&dst)
    if dir.len > 0 && dir != "." {
        os.mkdir_all(dir + "") >>>
    }
    raw := snapshot.read(src + "", snapshot.MAX_BYTES) >>>
    snapshot.write_atomic(dst + "", &raw) >>>
    << 0
}

fn is_valid_png(raw &string) bool {
    if raw.len < 24 { << false }
    << (raw[0] & 255) == 137 &&
        (raw[1] & 255) == 80 &&
        (raw[2] & 255) == 78 &&
        (raw[3] & 255) == 71 &&
        (raw[4] & 255) == 13 &&
        (raw[5] & 255) == 10 &&
        (raw[6] & 255) == 26 &&
        (raw[7] & 255) == 10
}

fn run_cmd(bin &string, args &[]string) CmdResult {
    $cmd := exec.command(*bin + "")
    for i in 0:args.len {
        cmd.args.push(args[i] + "")
    }
    out := cmd.combined_output() >>> (err) {
        << CmdResult{ok: false, output: err.msg()}
    }
    << CmdResult{ok: true, output: out}
}

fn must_cmd(bin &string, args &[]string, label string) string {
    res := run_cmd(bin, args)
    if !res.ok {
        >> errors.new("project_import_checks: " + label + " failed: " + res.output)
    }
    << res.output
}

fn replace_surfaces(base &resource.Document, refs []resource.ResourceReference, surfaces []resource.Surface) resource.Document {
    << resource.with_attachments(
        base,
        refs,
        surfaces,
        []resource.AudioBus{},
        []resource.AudioEmitter{},
        []resource.ScriptAttachment{},
        []resource.ScriptConnection{},
        []resource.LightAttachment{}
    ) >>>
}

fn parse_args(argv []string) Config {
    $cfg := Config{
        validator: "build/nexus-project-validate",
        project_cli: "build/nexus-project",
        preview: ""
    }
    $i := 1
    while i < argv.len {
        arg := argv[i] + ""
        if arg == "--validator" {
            i = i + 1
            if i >= argv.len { >> errors.new("missing value for --validator") }
            cfg.validator = argv[i] + ""
        } else if arg == "--project-cli" {
            i = i + 1
            if i >= argv.len { >> errors.new("missing value for --project-cli") }
            cfg.project_cli = argv[i] + ""
        } else if arg == "--preview" {
            i = i + 1
            if i >= argv.len { >> errors.new("missing value for --preview") }
            cfg.preview = argv[i] + ""
        } else {
            >> errors.new("unknown argument: " + arg)
        }
        i = i + 1
    }
    << cfg
}

fn has_staging_dirs(gens_dir string) bool {
    items := os.entries(gens_dir + "") >>> (err) {
        _ := err
        << false
    }
    for e in items {
        if strings.has_prefix(&e.name, ".staging-") {
            << true
        }
    }
    << false
}

fn png_crc32(data &string) int {
    $crc := 0xFFFFFFFF
    for i in 0:data.len {
        crc = crc ^ (data[i] & 255)
        for _ in 0:8 {
            if (crc & 1) != 0 {
                crc = ((crc >> 1) & 0x7FFFFFFF) ^ 0xEDB88320
            } else {
                crc = (crc >> 1) & 0x7FFFFFFF
            }
        }
    }
    << crc ^ 0xFFFFFFFF
}

fn write_u32_be(sb $&strings.ByteBuilder, v int) {
    sb.write_byte((v >> 24) & 255)
    sb.write_byte((v >> 16) & 255)
    sb.write_byte((v >> 8) & 255)
    sb.write_byte(v & 255)
}

fn append_png_text_chunk(raw &string) string {
    $chunk_body := strings.new_byte_builder(32)
    chunk_body.write_str("tEXtTest")
    chunk_body.write_byte(0)
    chunk_body.write_str("Changed atlas")
    chunk := chunk_body.to_string()
    data_len := chunk.len - 4
    crc := png_crc32(&chunk)
    head := raw[0 : raw.len - 12]
    tail := raw[raw.len - 12 : raw.len]
    $out := strings.new_byte_builder(raw.len + chunk.len + 8)
    out.write_str(head)
    write_u32_be($&out, data_len)
    out.write_str(chunk)
    write_u32_be($&out, crc)
    out.write_str(tail)
    << out.to_string()
}

fn run_png_checks_in_dir(val_bin &string, cli_bin &string, root string) int {
    iso_dir := filepath.join([root + "", "iso_project"])
    iso_assets := filepath.join([iso_dir + "", "assets"])
    iso_out := filepath.join([root + "", "iso_out"])
    os.mkdir_all(iso_assets + "") >>>

    copy_file("examples/isometric_2d/project.json", filepath.join([iso_dir + "", "project.json"])) >>>
    iso_entries := os.entries("examples/isometric_2d/assets") >>>
    for e in iso_entries {
        if !e.is_dir {
            copy_file(filepath.join(["examples/isometric_2d/assets", e.name + ""]), filepath.join([iso_assets + "", e.name + ""])) >>>
        }
    }

    iso_proj := filepath.join([iso_dir + "", "project.json"])
    loaded := proj.load_project(iso_proj + "") >>>
    check(loaded.assets.len == 1, "isometric project has 1 PNG asset") >>>
    uid := loaded.assets[0].key + ""
    rel := loaded.assets[0].path + ""
    orig_path := filepath.join([iso_dir + "", rel])
    png_bytes := snapshot.read(orig_path + "", snapshot.MAX_BYTES) >>>

    build1 := must_cmd(cli_bin, &["build", iso_proj + "", "--output", iso_out + "", "--validator", *val_bin + ""], "isometric PNG build")
    check(strings.contains(&build1, "rebuilt=1 reused=0"), "isometric PNG initial build imports 1 asset: " + build1) >>>
    pub_world := strings.trim_space(&must_cmd(cli_bin, &["scene", "world.xuscene", "--output", iso_out + ""], "resolve isometric world"))
    pub_world_raw := snapshot.read(pub_world + "", codec.MAX_BYTES) >>>
    pub_world_doc := codec.decode(&pub_world_raw) >>>
    check(pub_world_doc.resource_count() == 1, "isometric world has 1 resource") >>>
    ref := pub_world_doc.resource(0) >>>
    check(ref.kind == "image_rgba" && ref.path == "assets/" + uid + ".png", "published PNG uses uid.png image_rgba") >>>
    pub_gen_dir := filepath.dir(&pub_world)
    pub_png_path := filepath.join([pub_gen_dir + "", ref.path + ""])
    check((snapshot.read(pub_png_path + "", snapshot.MAX_BYTES) >>>) == png_bytes, "published PNG matches source bytes") >>>

    moved := filepath.join([iso_dir + "", "renamed.PNG"])
    os.rename(orig_path + "", moved + "") >>>
    _ := must_cmd(cli_bin, &["relocate", iso_proj + "", uid + "", "renamed.PNG"], "relocate PNG asset")
    build2 := must_cmd(cli_bin, &["build", iso_proj + "", "--output", iso_out + "", "--validator", *val_bin + ""], "relocated PNG rebuild")
    check(strings.contains(&build2, "rebuilt=0 reused=1"), "relocated PNG reuses receipt: " + build2) >>>
    pub_world2 := strings.trim_space(&must_cmd(cli_bin, &["scene", "world.xuscene", "--output", iso_out + ""], "resolve relocated world"))
    check(pub_world2 == pub_world, "relocated PNG preserves generation") >>>

    updated := append_png_text_chunk(&png_bytes)
    snapshot.write_atomic(moved + "", &updated) >>>
    build3 := must_cmd(cli_bin, &["build", iso_proj + "", "--output", iso_out + "", "--validator", *val_bin + ""], "modified PNG rebuild")
    check(strings.contains(&build3, "rebuilt=1 reused=0"), "modified PNG rebuilds asset: " + build3) >>>
    pub_world3 := strings.trim_space(&must_cmd(cli_bin, &["scene", "world.xuscene", "--output", iso_out + ""], "resolve modified world"))
    check(pub_world3 != pub_world, "modified PNG produces new generation") >>>

    iso_ptr := filepath.join([iso_out + "", "current.json"])
    saved_ptr := snapshot.read(iso_ptr + "", snapshot.MAX_BYTES) >>>
    broken := "broken png"
    snapshot.write_atomic(moved + "", &broken) >>>
    bad := run_cmd(cli_bin, &["build", iso_proj + "", "--output", iso_out + "", "--validator", *val_bin + ""])
    check(!bad.ok && strings.contains(&bad.output, "PNG"), "broken PNG fails validation: " + bad.output) >>>
    check((snapshot.read(iso_ptr + "", snapshot.MAX_BYTES) >>>) == saved_ptr, "broken PNG preserves current.json") >>>
    check((snapshot.read(pub_png_path + "", snapshot.MAX_BYTES) >>>) == png_bytes, "broken PNG preserves published PNG") >>>
    << 0
}

fn try_register_escape(project_path string, escape_path string) bool {
    _ := proj.register_asset(project_path + "", escape_path + "") >>> (err) {
        _ := err
        << false
    }
    << true
}

fn run_checks(cfg &Config) int {
    val_bin := filepath.abs(&cfg.validator) >>>
    cli_bin := filepath.abs(&cfg.project_cli) >>>
    root := os.mkdir_temp("", "nexus-project-import-") >>>
    _ := run_checks_in_dir(cfg, val_bin, cli_bin, root + "") >>> (err) {
        _ := os.remove_all(root + "")
        >> err
    }
    os.remove_all(root + "") >>>
    << 0
}

fn run_checks_in_dir(cfg &Config, val_bin string, cli_bin string, root string) int {
    work := filepath.join([root + "", "project"])
    out_dir := filepath.join([root + "", "published"])
    outside_glb := filepath.join([root + "", "outside.glb"])
    os.mkdir_all(filepath.join([work + "", "assets"])) >>>

    copy_file("examples/scene_assets/project.json", filepath.join([work + "", "project.json"])) >>>
    copy_file("examples/scene_assets/assets/panels.glb", filepath.join([work + "", "assets", "panels.glb"])) >>>
    copy_file("examples/scene_assets/assets/world.xuscene", filepath.join([work + "", "assets", "world.xuscene"])) >>>
    copy_file("examples/character_course/assets/course.glb", filepath.join([work + "", "assets", "alt.glb"])) >>>
    copy_file("examples/character_course/assets/course.glb", outside_glb) >>>

    proj_json := filepath.join([work + "", "project.json"])
    world_scene := filepath.join([work + "", "assets", "world.xuscene"])

    // Add a second scene sharing panels.glb UID and a third standalone scene without GLB surfaces.
    world_raw := snapshot.read(world_scene + "", codec.MAX_BYTES) >>>
    world_doc := codec.decode(&world_raw) >>>
    mirror_scene := filepath.join([work + "", "assets", "mirror.xuscene"])
    mirror_raw := codec.encode(&world_doc) >>>
    snapshot.write_atomic(mirror_scene + "", &mirror_raw) >>>

    loaded0 := proj.load_project(proj_json + "") >>>
    panels_uid := loaded0.assets[0].key + ""
    $scenes0 := []proj.Entry{}
    for i in 0:loaded0.scenes.len {
        s := &loaded0.scenes[i]
        scenes0.push(proj.Entry{key: s.key + "", path: s.path + "", resolved: s.resolved + ""})
    }
    $assets0 := []proj.Entry{}
    for i in 0:loaded0.assets.len {
        a := &loaded0.assets[i]
        assets0.push(proj.Entry{key: a.key + "", path: a.path + "", resolved: a.resolved + ""})
    }
    $updated0 := proj.make_project(
        loaded0.path + "",
        loaded0.directory + "",
        scenes0,
        assets0
    )
    updated0.scenes.push(proj.Entry{
        key: "mirror.xuscene",
        path: "assets/mirror.xuscene",
        resolved: mirror_scene + ""
    })
    proj.save_project_manifest(&updated0) >>>

    empty_key := proj.create_scene(proj_json + "", "empty", "EmptyRoot") >>>
    check(empty_key == "empty.xuscene", "create_scene appends .xuscene") >>>

    // Register a duplicate UID pointing to the same panels.glb bytes via CLI to test shared cache reuse.
    uid2 := strings.trim_space(&must_cmd(&cli_bin, &["register", proj_json + "", "assets/panels.glb"], "register duplicate glb"))
    check(resource.valid_resource_id(&uid2), "registered UID is valid hex32") >>>

    // First build: 1st UID builds receipt, 2nd UID pointing to identical GLB bytes reuses it in-session.
    build1 := must_cmd(&cli_bin, &["build", proj_json + "", "--output", out_dir + "", "--validator", val_bin + ""], "initial build")
    check(strings.contains(&build1, "rebuilt=1 reused=1"), "initial build reused shared GLB cache: " + build1) >>>

    gens_dir := filepath.join([out_dir + "", "generations"])
    check(!has_staging_dirs(gens_dir), "no staging directories left after publish") >>>

    pub_gallery := strings.trim_space(&must_cmd(&cli_bin, &["scene", "gallery.xuscene", "--output", out_dir + ""], "resolve gallery.xuscene"))
    pub_mirror := strings.trim_space(&must_cmd(&cli_bin, &["scene", "mirror.xuscene", "--output", out_dir + ""], "resolve mirror.xuscene"))
    pub_empty := strings.trim_space(&must_cmd(&cli_bin, &["scene", "empty.xuscene", "--output", out_dir + ""], "resolve empty.xuscene"))

    _ := must_cmd(&val_bin, &["scene", pub_gallery + ""], "validate published gallery")
    _ := must_cmd(&val_bin, &["scene", pub_mirror + ""], "validate published mirror")
    _ := must_cmd(&val_bin, &["scene", pub_empty + ""], "validate published empty")

    // Verify published gallery scene JSON hashes its GLB reference and reuses content-addressed file.
    pub_gallery_raw := snapshot.read(pub_gallery + "", codec.MAX_BYTES) >>>
    pub_gallery_doc := codec.decode(&pub_gallery_raw) >>>
    check(pub_gallery_doc.resource_count() == 1, "gallery keeps single glb resource") >>>
    pub_ref := pub_gallery_doc.resource(0) >>>
    check(strings.has_prefix(&pub_ref.path, "assets/") && strings.ends_with(&pub_ref.path, ".glb"), "content-addressed asset ref") >>>
    check(pub_ref.content_hash.len == 64, "content hash is sha256") >>>

    // Immediate rebuild with no edits reuses both assets and preserves exact generation path.
    build2 := must_cmd(&cli_bin, &["build", proj_json + "", "--output", out_dir + "", "--validator", val_bin + ""], "no-op rebuild")
    check(strings.contains(&build2, "rebuilt=0 reused=2"), "second build reuses both cached assets: " + build2) >>>
    pub_gallery2 := strings.trim_space(&must_cmd(&cli_bin, &["scene", "gallery.xuscene", "--output", out_dir + ""], "resolve gallery after no-op"))
    check(pub_gallery2 == pub_gallery, "no-op rebuild keeps identical generation") >>>

    // Selective rebuild & UID relocation: relocate uid2 to alt.glb and bind mirror.xuscene to uid2.
    _ := must_cmd(&cli_bin, &["relocate", proj_json + "", uid2 + "", "assets/alt.glb"], "relocate uid2")
    dummy_hash := strings.repeat(&"0", 64)
    mirror_with_alt := replace_surfaces(
        &world_doc,
        [resource.ResourceReference{uid: uid2 + "", kind: "glb_model", path: "assets/alt.glb", content_hash: dummy_hash + ""}],
        [resource.surface(1, uid2 + "", 0)]
    ) >>>
    mirror_alt_raw := codec.encode(&mirror_with_alt) >>>
    snapshot.write_atomic(mirror_scene + "", &mirror_alt_raw) >>>

    build3 := must_cmd(&cli_bin, &["build", proj_json + "", "--output", out_dir + "", "--validator", val_bin + ""], "selective rebuild")
    check(strings.contains(&build3, "rebuilt=1 reused=1"), "selective rebuild reuses panels and rebuilds alt: " + build3) >>>
    pub_gallery3 := strings.trim_space(&must_cmd(&cli_bin, &["scene", "gallery.xuscene", "--output", out_dir + ""], "resolve gallery after relocate"))
    check(pub_gallery3 != pub_gallery, "relocated build produces new generation") >>>
    _ := must_cmd(&val_bin, &["scene", pub_gallery + ""], "previous generation stays valid")
    _ := must_cmd(&val_bin, &["scene", pub_gallery3 + ""], "new generation validates")

    current_ptr := filepath.join([out_dir + "", "current.json"])
    saved_current := snapshot.read(current_ptr + "", snapshot.MAX_BYTES) >>>
    alt_path := filepath.join([work + "", "assets", "alt.glb"])
    alt_backup := snapshot.read(alt_path + "", snapshot.MAX_BYTES) >>>

    // Rollback 1: corrupt GLB bytes must fail build and keep current.json intact.
    bad_glb := "not-a-valid-glb"
    snapshot.write_atomic(alt_path + "", &bad_glb) >>>
    bad_build1 := run_cmd(&cli_bin, &["build", proj_json + "", "--output", out_dir + "", "--validator", val_bin + ""])
    check(!bad_build1.ok, "corrupt GLB rejected") >>>
    check((snapshot.read(current_ptr + "", snapshot.MAX_BYTES) >>>) == saved_current, "corrupt GLB keeps current.json") >>>
    snapshot.write_atomic(alt_path + "", &alt_backup) >>>

    // Rollback 2: out-of-range primitive index must fail build and preserve current.json.
    bad_prim_doc := replace_surfaces(
        &world_doc,
        [resource.ResourceReference{uid: uid2 + "", kind: "glb_model", path: "assets/alt.glb", content_hash: dummy_hash + ""}],
        [resource.surface(1, uid2 + "", 99)]
    ) >>>
    bad_prim_raw := codec.encode(&bad_prim_doc) >>>
    snapshot.write_atomic(mirror_scene + "", &bad_prim_raw) >>>
    bad_build2 := run_cmd(&cli_bin, &["build", proj_json + "", "--output", out_dir + "", "--validator", val_bin + ""])
    check(!bad_build2.ok, "out-of-range primitive rejected") >>>
    check((snapshot.read(current_ptr + "", snapshot.MAX_BYTES) >>>) == saved_current, "bad primitive keeps current.json") >>>

    // Rollback 3: incompatible LOD (denser triangle count or bad LOD primitive) rejected while preserving current.json.
    prims_alt := proj.validate_glb_primitives(val_bin + "", alt_path + "") >>>
    prims_pan := proj.validate_glb_primitives(val_bin + "", filepath.join([work + "", "assets", "panels.glb"])) >>>
    $base_uid := uid2 + ""
    $base_prim := 0
    $lod_uid := panels_uid + ""
    $lod_prim := 99
    if prims_alt.len > 0 && prims_pan.len > 0 {
        if prims_pan[0].triangles > prims_alt[0].triangles {
            lod_prim = 0
        } else if prims_alt[0].triangles > prims_pan[0].triangles {
            base_uid = panels_uid + ""
            lod_uid = uid2 + ""
            lod_prim = 0
        }
    }
    bad_lod_surf := resource.Surface{
        node: 1,
        resource_uid: base_uid + "",
        primitive: base_prim,
        levels: [resource.SurfaceLevel{distance: 10.0, resource_uid: lod_uid + "", primitive: lod_prim}],
        hysteresis: 0.0
    }
    ref_alt := resource.ResourceReference{uid: uid2 + "", kind: "glb_model", path: "assets/alt.glb", content_hash: dummy_hash + ""}
    ref_pan := resource.ResourceReference{uid: panels_uid + "", kind: "glb_model", path: "assets/panels.glb", content_hash: dummy_hash + ""}
    lod_refs := [ref_alt, ref_pan]
    bad_lod_doc := replace_surfaces(&world_doc, lod_refs, [bad_lod_surf]) >>>
    bad_lod_raw := codec.encode(&bad_lod_doc) >>>
    snapshot.write_atomic(mirror_scene + "", &bad_lod_raw) >>>
    bad_build3 := run_cmd(&cli_bin, &["build", proj_json + "", "--output", out_dir + "", "--validator", val_bin + ""])
    check(!bad_build3.ok, "incompatible/denser LOD rejected") >>>
    check((snapshot.read(current_ptr + "", snapshot.MAX_BYTES) >>>) == saved_current, "bad LOD keeps current.json") >>>

    // Restore valid mirror.xuscene.
    snapshot.write_atomic(mirror_scene + "", &mirror_alt_raw) >>>

    // Reject path escaping outside project root and unknown scene keys.
    check(!try_register_escape(proj_json + "", "../outside.glb"), "escape path rejected") >>>
    missing_scene := run_cmd(&cli_bin, &["scene", "does-not-exist.xuscene", "--output", out_dir + ""])
    check(!missing_scene.ok, "missing published scene rejected") >>>

    // Shared PNG import, relocation, chunk update & invalid PNG rollback check.
    run_png_checks_in_dir(&val_bin, &cli_bin, root + "") >>>

    // Optional real GPU preview check.
    if cfg.preview.len > 0 {
        prev_bin := filepath.abs(&cfg.preview) >>>
        cap_png := filepath.join([root + "", "preview.png"])
        _ := must_cmd(
            &prev_bin,
            &["--scene", pub_gallery3 + "", "--shaders", "build/mesh-shaders", "--frames", "2", "--capture", cap_png + ""],
            "gpu preview capture"
        )
        png_bytes := snapshot.read(cap_png + "", snapshot.MAX_BYTES) >>>
        check(is_valid_png(&png_bytes), "gpu preview produced valid PNG") >>>
        println("PASS: project_import_checks (CPU + Metal preview)")
    } else {
        println("PASS: project_import_checks (CPU pipeline, caching, relocate, rollback)")
    }
    << 0
}

fn main() int {
    cfg := parse_args(os.args()) >>> (err) {
        eprintln(err.msg())
        << 1
    }
    _ := run_checks(&cfg) >>> (err) {
        eprintln(err.msg())
        << 1
    }
    << 0
}
