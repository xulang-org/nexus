@main
codec #"github.com/xulang-org/nexus/formats/scene"
#os
#strings

fn rejected(raw &string) bool { codec.decode(raw) >>> (err) { << true }
    << false }
fn run() int {
    for path in ["build/scene-script-fixtures/base.xuscene", "build/scene-script-fixtures/full.xuscene", "build/scene-scripts/world.xuscene"] {
        raw := os.read(path) >>>
        document := codec.decode(&raw) >>>
        assert(document.script_count() >= 2 && document.script_connection_count() > 0)
        encoded := codec.encode(&document) >>>
        restored := codec.decode(&encoded) >>>
        assert(encoded == (codec.encode(&restored) >>>))
    }
    failures := os.read("build/scene-script-fixtures/reject-list.txt") >>>
    $count := 0
    for name in strings.split(&failures, "\n") {
        if name.len == 0 { -> }
        raw := os.read("build/scene-script-fixtures/" + name) >>>
        if !rejected(&raw) { println("Accepted invalid script scene " + name)
            assert(false) }
        count = count + 1
    }
    println("PASS: script/initial/stable-route and combined scene roundtrip, 32 scripts/32 routes and " + str(count) + " strict rejects")
    << 0
}
fn main() int { << run() >>> (err) { eprintln(err.msg())
    << 1 } }
