@main

#gpu
#math

fm #"github.com/xulang-org/nexus/foundation/math"
gpu_info #"github.com/xulang-org/nexus/platform/gpu"
light_data #"github.com/xulang-org/nexus/resources/lighting"
meshes #"github.com/xulang-org/nexus/resources/mesh"
mesh_shaders #"github.com/xulang-org/nexus/assets/shaders/three_d"
gltf #"github.com/xulang-org/nexus/formats/gltf"
assets #"github.com/xulang-org/nexus/assets/gltf"
ren #"github.com/xulang-org/nexus/rendering/three_d"
scene_render #"github.com/xulang-org/nexus/integration/rendering/three_d"
glb #"github.com/xulang-org/nexus/integration/gltf_render"
nexus #"github.com/xulang-org/nexus/scene"

fn channel(pixel int, index int) int {
    if index == 0 { << pixel / 16777216 % 256 }
    if index == 1 { << pixel / 65536 % 256 }
    << pixel / 256 % 256
}

fn check_mirrored_uv_seam() int {
    // Two triangles share seam vertices 1 and 2 along x = 0, with mirrored U on the right half.
    $mesh := meshes.new_mesh_data_3d()
    n := fm.vec3(0.0, 0.0, 1.0)
    white := 4294967295
    mesh.vertex_lit_uv(fm.vec3(-1.0, 0.0, 0.0), white, n, fm.vec2(0.0, 0.0)) >>>
    mesh.vertex_lit_uv(fm.vec3(0.0, 0.0, 0.0), white, n, fm.vec2(1.0, 0.0)) >>>
    mesh.vertex_lit_uv(fm.vec3(0.0, 1.0, 0.0), white, n, fm.vec2(1.0, 1.0)) >>>
    mesh.vertex_lit_uv(fm.vec3(1.0, 0.0, 0.0), white, n, fm.vec2(0.0, 0.0)) >>>
    mesh.triangle(0, 1, 2) >>>
    mesh.triangle(1, 3, 2) >>>

    stats := mesh.generate_mikktspace_tangents() >>>
    mesh.validate() >>>
    assert(stats.original_vertices == 4)
    assert(stats.mirrored_seams == 2)
    assert(stats.split_vertices == 2)
    assert(stats.final_vertices == 6)

    // First triangle keeps canonical +1 winding; mirrored second triangle splits seam corners to -1.
    assert(mesh.vertices[mesh.indices[0]].tangent.w != mesh.vertices[mesh.indices[3]].tangent.w)
    for t in 0:mesh.triangle_count() {
        wa := mesh.vertices[mesh.indices[t * 3]].tangent.w
        wb := mesh.vertices[mesh.indices[t * 3 + 1]].tangent.w
        wc := mesh.vertices[mesh.indices[t * 3 + 2]].tangent.w
        assert(wa == wb && wb == wc && (wa == 1.0 || wa == -1.0))
    }
    << 0
}

fn naive_generate_fails(mesh $&meshes.MeshData3D) bool {
    mesh.generate_tangents() >>> (err) { << true }
    << false
}

fn check_opposing_uv_fold_and_degenerates() int {
    // Share center vertex across 180-deg rotated UV triangles (same winding w=+1, opposing T).
    // Simple generate_tangents cancels out and errors; MikkTSpace splits the corner by angle.
    $mesh := meshes.new_mesh_data_3d()
    n := fm.vec3(0.0, 0.0, 1.0)
    white := 4294967295
    mesh.vertex_lit_uv(fm.vec3(0.0, 0.0, 0.0), white, n, fm.vec2(0.5, 0.5)) >>>
    mesh.vertex_lit_uv(fm.vec3(1.0, 0.0, 0.0), white, n, fm.vec2(1.0, 0.5)) >>>
    mesh.vertex_lit_uv(fm.vec3(0.0, 1.0, 0.0), white, n, fm.vec2(0.5, 1.0)) >>>
    mesh.vertex_lit_uv(fm.vec3(-1.0, 0.0, 0.0), white, n, fm.vec2(1.0, 0.5)) >>>
    mesh.vertex_lit_uv(fm.vec3(0.0, -1.0, 0.0), white, n, fm.vec2(0.5, 1.0)) >>>
    mesh.triangle(0, 1, 2) >>>
    mesh.triangle(0, 3, 4) >>>

    assert(naive_generate_fails($&mesh))
    stats := mesh.generate_mikktspace_tangents() >>>
    mesh.validate() >>>
    assert(stats.split_vertices >= 1)

    // Degenerate zero-area UVs + unreferenced vertex still produce a clean orthonormal TBN basis.
    $deg := meshes.new_mesh_data_3d()
    deg.vertex_lit_uv(fm.vec3(0.0, 0.0, 0.0), white, n, fm.vec2(0.25, 0.25)) >>>
    deg.vertex_lit_uv(fm.vec3(1.0, 0.0, 0.0), white, n, fm.vec2(0.25, 0.25)) >>>
    deg.vertex_lit_uv(fm.vec3(0.0, 1.0, 0.0), white, n, fm.vec2(0.25, 0.25)) >>>
    deg.vertex_lit_uv(fm.vec3(5.0, 5.0, 0.0), white, n, fm.vec2(0.0, 0.0)) >>>
    deg.triangle(0, 1, 2) >>>
    dstats := deg.generate_mikktspace_tangents() >>>
    deg.validate() >>>
    assert(dstats.degenerate_corners >= 3 && dstats.final_vertices == 4)
    for v in deg.vertices {
        assert(v.has_tangent && math.abs(v.normal.dot(v.tangent.xyz())) <= 0.0001)
    }
    << 0
}

fn strict_glb_rejects(device &ren.Device3D, asset &gltf.GlbGeometry) bool {
    glb.upload_model(device, asset) >>> (err) { << true }
    << false
}

fn check_glb_auto_mikktspace_gpu() int {
    mesh_program := mesh_shaders.load_mesh("build/mesh-shaders") >>>
    $device := ren.open_3d("Xu MikkTSpace GLB GPU checks", 64, 64, gpu.AUTO, &mesh_program) >>>
    println("MikkTSpace GPU backend: " + gpu_info.backend_name(device.backend() >>>))

    no_tan := assets.load_glb_geometry("build/glb-material-fixtures/no-tangent.glb") >>>
    // Default strict upload still preserves backwards-compatible rejection.
    assert(strict_glb_rejects(&device, &no_tan))

    // CPU build helper generates MikkTSpace tangents on every vertex.
    cpu_mesh := glb.build_primitive_mesh(&no_tan, 0, true) >>>
    assert(cpu_mesh.vertex_count() >= 3)
    for v in cpu_mesh.vertices { assert(v.has_tangent) }

    // GPU upload + Metal lit draw on previously tangent-less normal-mapped GLB.
    $model := glb.upload_model_with_mikktspace(&device, &no_tan) >>>
    $tree := nexus.new_scene_tree_3d("MikkTSpaceGLB", 32) >>>
    root := tree.root()
    instance := assets.instantiate(&no_tan, $&tree, root, "NoTan") >>>
    node := instance.source_node(0) >>>
    tree.set_transform_3d(node, fm.identity_3d()) >>>

    zero := fm.vec3(0.0, 0.0, 0.0)
    light := light_data.environment(
        fm.vec3(0.15, 0.15, 0.15),
        fm.vec3(0.0, 0.0, 2.0),
        1.0,
        [light_data.directional(fm.vec3(0.0, 0.0, -1.0), fm.vec3(1.0, 1.0, 1.0)) >>>]
    ) >>>

    $scene := scene_render.new_scene_3d(&device) >>>
    assert((model.bind($&scene, &tree, &instance) >>>) == 1)
    device.begin(255) >>>
    drawn := scene.draw_lit($&device, &tree, fm.identity_3d(), &light) >>>
    assert(drawn.instances == 1)
    pixel := device.read_pixel(32, 32) >>>
    device.present() >>>

    // Verify lit non-background shading on the surface center.
    assert(channel(pixel, 0) > 10 || channel(pixel, 1) > 10 || channel(pixel, 2) > 10)
    assert(zero.length() == 0.0)
    model.close() >>>
    device.close() >>>
    << 0
}

fn run() int {
    check_mirrored_uv_seam() >>>
    check_opposing_uv_fold_and_degenerates() >>>
    check_glb_auto_mikktspace_gpu() >>>
    println("PASS: mikktspace_gpu_checks (MikkTSpace Mirrored Seams + Fold Splits + Degenerate Fallbacks + Auto-MikkTSpace GLB Metal)")
    << 0
}

fn main() int {
    << run() >>> (err) {
        eprintln(err.msg())
        << 1
    }
}
