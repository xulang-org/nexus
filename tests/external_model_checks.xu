@main
assets #"github.com/xulang-org/nexus/assets/gltf"
fm #"github.com/xulang-org/nexus/foundation/math"
#encoding/json
#os
#math
fn close(a f64,b f64) bool { << math.abs(a-b)<0.00001*math.max(1.0,math.abs(b)) }
fn integer(doc &json.Doc,node int,key string) int { << doc.as_int(doc.get(node,key)) or >> }
fn run() int {
    raw := os.read("build/external-models/pose-oracle.json") or >>
    doc := json.parse_max(&raw,8388608)
    assert(doc.ok())
    cases := doc.get(doc.root(),"cases")
    $points := 0
    for ci in 0:doc.count(cases) {
        item := doc.at(cases,ci)
        path := doc.as_string(doc.get(item,"path")) or >>
        asset := assets.load_glb_geometry(path) or >>
        clip := integer(&doc,item,"clip") or >>
        time := doc.as_f64(doc.get(item,"time")) or >>
        locals := asset.sample_pose(clip,time) or >>
        worlds := asset.world_pose(&locals) or >>
        expected := doc.get(item,"worlds")
        assert(worlds.len==doc.count(expected))
        for i in 0:worlds.len {
            matrix := worlds[i]
            values := [matrix.c0,matrix.c1,matrix.c2,matrix.c3]
            oracle := doc.at(expected,i)
            for c in 0:4 {
                column := values[c]
                numbers := [column.x,column.y,column.z,column.w]
                for r in 0:4 { assert(close(numbers[r],doc.as_f64(doc.at(oracle,c*4+r)) or >>)) }
            }
        }
        expected_points := doc.get(item,"points")
        for i in 0:doc.count(expected_points) {
            p := doc.at(expected_points,i)
            node := integer(&doc,p,"node") or >>
            primitive := integer(&doc,p,"primitive") or >>
            vertex := integer(&doc,p,"vertex") or >>
            v := asset.position(primitive,vertex) or >>
            $position := fm.vec4(v.x,v.y,v.z,1.0)
            if (asset.node_skin(node) or >>)>=0 {
                palette := asset.skin_palette(node,&worlds) or >>
                matrix := asset.skin_matrix(primitive,vertex,&palette) or >>
                position=matrix.transform(position)
            }
            position=worlds[node].transform(position)
            xyz := [position.x,position.y,position.z]
            oracle := doc.get(p,"position")
            for c in 0:3 { assert(close(xyz[c],doc.as_f64(doc.at(oracle,c)) or >>)) }
            points+=1
        }
    }
    println("PASS: "+str(doc.count(cases))+" independent glTF poses and "+str(points)+" sampled skin/world points; all source animation clips")
    << 0
}
fn main() int { << run() or(err){ eprintln(err.msg())
    << 1 } }
