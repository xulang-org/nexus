@main

inp #"github.com/xulang-org/nexus/input"
#math

fn run() int {
    // 1. Multi-slot hot-plug events (4 slots) & deadzone shaping
    $gm := inp.new_gamepad_manager()
    assert(gm.connected_count() == 0)
    gm.connect(0, inp.LAYOUT_SWITCH, "Switch Pro") or >>
    gm.connect(1, inp.LAYOUT_XBOX, "Xbox Series") or >>
    assert(gm.connected_count() == 2 && gm.is_connected(0) && gm.is_connected(1))
    evs := gm.drain_events()
    assert(evs.len == 2 && evs[0].kind == inp.GP_EVENT_CONNECTED && evs[0].layout == inp.LAYOUT_SWITCH)

    shaped0 := inp.shape_stick_radial(0.05, 0.05, 0.15, 0.05, 1.0) or >>
    assert(shaped0.x == 0.0 && shaped0.y == 0.0)
    shaped1 := inp.shape_stick_radial(0.98, 0.0, 0.15, 0.05, 1.0) or >>
    assert(math.abs(shaped1.x - 1.0) < 1e-6)
    shaped_lin := inp.shape_stick_radial(0.55, 0.0, 0.15, 0.05, 1.0) or >>
    shaped_pow := inp.shape_stick_radial(0.55, 0.0, 0.15, 0.05, 2.0) or >>
    assert(shaped_pow.x < shaped_lin.x && shaped_pow.x > 0.0)

    // 2. Platform layout template sync -> Switch EAST confirm vs Xbox SOUTH confirm
    $imap := inp.new_input_map()
    gm.bind_template_to_input_map(0, $&imap, 0) or >>
    gm.bind_template_to_input_map(1, $&imap, 16) or >>

    gm.begin_frame()
    gm.set_button(0, inp.BTN_EAST, true) or >>
    gm.set_axis(0, inp.AXIS_RT, 0.8) or >>
    assert(gm.button_just_pressed(0, inp.BTN_EAST))
    gm.sync_slot_to_input_map(0, $&imap, 0) or >>
    assert(imap.pressed("confirm") && !imap.pressed("cancel") && imap.pressed("fire"))

    // Xbox Slot 1 presses BTN_EAST -> Cancel
    $imap_xb := inp.new_input_map()
    gm.bind_template_to_input_map(1, $&imap_xb, 16) or >>
    gm.set_button(1, inp.BTN_EAST, true) or >>
    gm.sync_slot_to_input_map(1, $&imap_xb, 16) or >>
    assert(!imap_xb.pressed("confirm") && imap_xb.pressed("cancel"))

    // Disconnect slot 0 -> clears InputMap sources & emits disconnect event
    gm.disconnect(0) or >>
    gm.sync_slot_to_input_map(0, $&imap, 0) or >>
    assert(!imap.pressed("confirm") && !imap.pressed("fire") && gm.connected_count() == 1)
    devs := gm.drain_events()
    assert(devs.len == 1 && devs[0].kind == inp.GP_EVENT_DISCONNECTED && devs[0].slot == 0)

    // 3. InputBuffer coyote/jump buffering & motion sequence matching
    $ib := inp.new_input_buffer(12)
    ib.push_frame(10, &["down"])
    ib.push_frame(13, &["right"])
    ib.push_frame(15, &["jump", "attack"])
    assert(ib.match_sequence(&["down", "right", "attack"], 18, 4))
    assert(!ib.match_sequence(&["down", "right", "attack"], 18, 1))
    assert(ib.consume_buffered("jump", 20))
    assert(!ib.consume_buffered("jump", 20))
    assert(!ib.consume_buffered("jump", 35))

    println("PASS: gamepad_input_checks")
    << 0
}

fn main() int {
    run() or (err) {
        println("FAIL: " + err.msg())
        << 1
    }
    << 0
}
