@main
#gpu
#os
#math
ren #"github.com/xulang-org/nexus/rendering/three_d"
meshes #"github.com/xulang-org/nexus/resources/mesh"
shaders #"github.com/xulang-org/nexus/assets/shaders/three_d"
fm #"github.com/xulang-org/nexus/foundation/math"
nexus #"github.com/xulang-org/nexus/scene"
scene_render #"github.com/xulang-org/nexus/integration/rendering/three_d"
lights #"github.com/xulang-org/nexus/resources/lighting"
fn bad_draw(scene &scene_render.Scene3D,device $&ren.Device3D,tree &nexus.SceneTree,view fm.Mat4) bool {
    scene.draw(device,tree,view) >>> (err){ << true }
    << false
}
fn bad_lit(scene &scene_render.Scene3D,device $&ren.Device3D,tree &nexus.SceneTree,view fm.Mat4,env &lights.Environment3D) bool {
    scene.draw_lit(device,tree,view,env) >>> (err){ << true }
    << false
}
fn bad_query(owner &ren.DeviceRef3D,mesh ren.MeshRef3D,view fm.Mat4) bool {
    owner.mesh_in_view(mesh,view) >>> (err){ << true }
    << false
}
fn run() int {
    program := shaders.load_mesh("build/mesh-shaders") >>>
    $device := ren.open_3d("Frustum submission checks",64,64,gpu.AUTO,&program) >>>
    zero := fm.vec3(0.0,0.0,0.0)
    one := fm.vec3(1.0,1.0,1.0)
    $source := meshes.new_mesh_data_3d()
    for p in [fm.vec3(-0.25,0.25,0.0),fm.vec3(0.25,0.25,0.0),fm.vec3(0.25,-0.25,0.0),fm.vec3(-0.25,-0.25,0.0)] {
        source.vertex_lit_uv(p,4294967295,fm.vec3(0.0,0.0,1.0),fm.vec2(p.x+0.25,p.y+0.25)) >>>
    }
    source.triangle(0,2,1) >>>
    source.triangle(0,3,2) >>>
    $mesh := device.upload(&source) >>>
    material := ren.material_3d(one,0.0,1.0,zero) >>>
    environment := lights.environment(one,fm.vec3(0.0,0.0,2.0),1.0,[]lights.Light3D{}) >>>
    $tree := nexus.new_scene_tree_3d("Clip",256) >>>
    node := tree.add_child_3d(tree.root(),"Visible") >>>
    $scene := scene_render.new_scene_3d(&device) >>>
    scene.attach_mesh(&tree,node,&mesh) >>>
    view := fm.translation_3d(fm.vec3(0.0,0.0,0.5))
    assert(bad_draw(&scene,$&device,&tree,view))
    for p in [fm.vec3(-2.0,0.0,0.0),fm.vec3(2.0,0.0,0.0),fm.vec3(0.0,-2.0,0.0),
              fm.vec3(0.0,2.0,0.0),fm.vec3(0.0,0.0,-2.0),fm.vec3(0.0,0.0,2.0)] {
        tree.set_position_3d(node,p) >>>
        device.begin(255) >>>
        report := scene.draw($&device,&tree,view) >>>
        assert(report.instances==0 && report.triangles==0 && report.culled_instances==1 && report.culled_triangles==2)
        assert((device.read_pixel(32,32) >>>)==255)
        assert(bad_draw(&scene,$&device,&tree,view))
        device.present() >>>
    }
    // Contact with a clip face is retained, even if depth/raster rules later
    // give it no covered samples. No false-negative epsilon-edge decision.
    for p in [fm.vec3(-1.25,0.0,0.0),fm.vec3(1.25,0.0,0.0),fm.vec3(0.0,-1.25,0.0),
              fm.vec3(0.0,1.25,0.0),fm.vec3(0.0,0.0,-0.5),fm.vec3(0.0,0.0,0.5)] {
        tree.set_position_3d(node,p) >>>
        device.begin(255) >>>
        report := scene.draw($&device,&tree,view) >>>
        assert(report.instances==1 && report.culled_instances==0)
        device.present() >>>
    }
    perspective := nexus.perspective_3d(math.pi()/2.0,1.0,1.0,10.0) >>>
    for z in [-0.5,2.0,-12.0] {
        tree.set_position_3d(node,fm.vec3(0.0,0.0,z)) >>>
        device.begin(255) >>>
        assert((scene.draw($&device,&tree,perspective) >>>).culled_instances==1)
        device.present() >>>
    }
    for z in [-1.0,-2.0,-10.0] {
        tree.set_position_3d(node,fm.vec3(0.0,0.0,z)) >>>
        device.begin(255) >>>
        assert((scene.draw($&device,&tree,perspective) >>>).instances==1)
        device.present() >>>
    }
    for sign in [-1.0,1.0] {
        $world := fm.rotation_y(0.4).multiply(fm.scale_3d(fm.vec3(sign*2.0,1.2,1.0)))
        world.c1.x+=0.4
        world.c3.x=sign*0.85
        tree.set_transform_3d(node,world) >>>
        device.begin(255) >>>
        device.draw(&mesh,view.multiply(world)) >>>
        device.capture("build/frustum-affine-direct.png") >>>
        device.present() >>>
        device.begin(255) >>>
        assert((scene.draw($&device,&tree,view) >>>).instances==1)
        device.capture("build/frustum-affine-scene.png") >>>
        device.present() >>>
        assert((os.read("build/frustum-affine-direct.png") >>>)==(os.read("build/frustum-affine-scene.png") >>>))
    }
    tree.set_transform_3d(node,fm.identity_3d()) >>>
    $ids := []int{}
    for i in 0:128 {
        id := tree.add_child_3d(tree.root(),"Outside"+str(i)) >>>
        tree.set_position_3d(id,fm.vec3(100.0+f64(i),0.0,0.0)) >>>
        scene.attach_mesh(&tree,id,&mesh) >>>
        ids.push(id)
    }
    // The raw reference path deliberately remains an explicit GPU submission.
    device.begin(255) >>>
    device.draw(&mesh,view) >>>
    device.capture("build/frustum-direct.png") >>>
    device.present() >>>
    device.begin(255) >>>
    report := scene.draw($&device,&tree,view) >>>
    assert(report.instances==1 && report.triangles==2 && report.culled_instances==128 && report.culled_triangles==256)
    device.capture("build/frustum-scene.png") >>>
    device.present() >>>
    assert((os.read("build/frustum-direct.png") >>>)==(os.read("build/frustum-scene.png") >>>))
    for id in ids { scene.set_material(&tree,id,material) >>> }
    scene.set_material(&tree,node,material) >>>
    device.begin(255) >>>
    device.draw_material(&mesh,fm.identity_3d(),view,&material,&environment) >>>
    device.capture("build/frustum-material-direct.png") >>>
    device.present() >>>
    device.begin(255) >>>
    lit := scene.draw_lit($&device,&tree,view,&environment) >>>
    assert(lit.instances==1 && lit.culled_instances==128)
    summary := device.lighting_stats() >>>
    assert(summary.draws==1)
    device.capture("build/frustum-material-scene.png") >>>
    device.present() >>>
    assert((os.read("build/frustum-material-direct.png") >>>)==(os.read("build/frustum-material-scene.png") >>>))
    // Hidden/queued sources do not count as frustum culled candidates.
    tree.set_visible(ids[0],false) >>>
    tree.queue_free(ids[1]) >>>
    device.begin(255) >>>
    reduced := scene.draw_lit($&device,&tree,view,&environment) >>>
    assert(reduced.instances==1 && reduced.culled_instances==126)
    device.present() >>>
    // An entirely offscreen scene needs no per-mesh light selection/upload.
    tree.set_visible(node,false) >>>
    $sources := []lights.Light3D{}
    for i in 0:17 { sources.push(lights.directional(fm.vec3(0.0,0.0,1.0),one) >>>) }
    overload := lights.environment(zero,one,1.0,sources) >>>
    device.begin(255) >>>
    assert((scene.draw_lit($&device,&tree,view,&overload) >>>).instances==0)
    assert((device.lighting_stats() >>>).draws==0)
    tree.set_position_3d(ids[2],zero) >>>
    assert(bad_lit(&scene,$&device,&tree,view,&overload))
    assert((device.lighting_stats() >>>).draws==0)
    assert((scene.draw_lit($&device,&tree,view,&environment) >>>).instances==1)
    device.present() >>>
    tree.set_position_3d(ids[2],fm.vec3(100.0,0.0,0.0)) >>>
    // Offscreen invalid maps/transforms still fail, before any submission.
    pixels := [4294967295]
    $texture := device.texture_rgba(1,1,&pixels,true,false,false) >>>
    textured := material.with_base_texture(&texture) >>>
    scene.set_material(&tree,ids[2],textured) >>>
    texture.close() >>>
    device.begin(255) >>>
    assert(bad_lit(&scene,$&device,&tree,view,&environment))
    assert((device.lighting_stats() >>>).draws==0)
    scene.set_material(&tree,ids[2],material) >>>
    $singular := fm.scale_3d(fm.vec3(0.0,1.0,1.0))
    singular.c3.x=100.0
    tree.set_transform_3d(ids[2],singular) >>>
    assert(bad_lit(&scene,$&device,&tree,view,&environment))
    tree.set_transform_3d(ids[2],fm.translation_3d(fm.vec3(1e12,0.0,0.0))) >>>
    assert(bad_lit(&scene,$&device,&tree,view,&environment))
    tree.set_transform_3d(ids[2],fm.translation_3d(fm.vec3(100.0,0.0,0.0))) >>>
    assert((scene.draw_lit($&device,&tree,view,&environment) >>>).instances==0)
    device.present() >>>
    // f64 constants outside the right plane both round to the same binary32
    // value. Visibility must use the packed MVP, retaining the boundary.
    packed_edge := fm.Mat4{c0: fm.vec4(0.0,0.0,0.0,0.0),c1: fm.vec4(0.0,0.0,0.0,0.0),
        c2: fm.vec4(0.0,0.0,0.0,0.0),c3: fm.vec4(100000002.0,0.0,0.5,100000001.0)}
    assert(device.reference().mesh_in_view(mesh.reference(),packed_edge) >>>)
    mesh.close() >>>
    device.begin(255) >>>
    assert(bad_lit(&scene,$&device,&tree,view,&environment))
    device.present() >>>
    $other := ren.open_3d("Foreign clip query",16,16,gpu.AUTO,&program) >>>
    $foreign := other.upload(&source) >>>
    assert(bad_query(&device.reference(),foreign.reference(),view))
    foreign.close() >>>
    other.close() >>>
    device.close() >>>
    println("PASS: Metal six-face/reverse-Z clipping, boundary retention, affine/reflected/sheared partial boxes, 129->1 scene submissions with exact raw-path PNGs, hidden/queued accounting, offscreen light-budget bypass, frame/resource/map/transform error recovery and packed-MVP rounding")
    << 0
}
fn main() int { << run() >>> (err){ eprintln(err.msg())
    << 1 } }
