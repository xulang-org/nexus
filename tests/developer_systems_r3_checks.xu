@main

bt #"github.com/xulang-org/nexus/ai/bt"
diag #"github.com/xulang-org/nexus/foundation/diagnostics"
fm #"github.com/xulang-org/nexus/foundation/math"
sp #"github.com/xulang-org/nexus/foundation/spatial"
nav #"github.com/xulang-org/nexus/navigation"
persist #"github.com/xulang-org/nexus/resources/persistence"
#errors
#math
#strings

fn near_f(a f64, b f64, eps f64) bool {
    << math.abs(a - b) <= eps
}

fn build_flat_quad_tile(
    tnav $&nav.TiledNavMesh3D,
    tx int,
    tz int,
    x0 f64,
    z0 f64,
    x1 f64,
    z1 f64,
    y f64
) int {
    verts := [
        fm.vec3(x0, y, z0),
        fm.vec3(x1, y, z0),
        fm.vec3(x1, y, z1),
        fm.vec3(x0, y, z1)
    ]
    tris := [0, 3, 2, 0, 2, 1]
    areas := [0, 0]
    flags := [1, 1]
    << tnav.build_tile(tx, tz, &verts, &tris, &areas, &flags) or >>
}

fn rejects_bad_tile_cost(tnav $&nav.TiledNavMesh3D) bool {
    _ := tnav.set_tile_cost_multiplier(0, 0, -1.0) or (err) {
        _ := err
        << true
    }
    << false
}

fn rejects_bad_utility_curve() bool {
    _ := bt.eval_response_curve(0.5, 99, 1.0, 1.0, 0.0, 0.0, false) or (err) {
        _ := err
        << true
    }
    << false
}

fn rejects_bad_slot_id(cat $&persist.SaveSlotCatalog) bool {
    _ := cat.save_manual_slot("../escape", "Bad", "s", 1, 100, 10, "{}") or (err) {
        _ := err
        << true
    }
    << false
}

fn rejects_manual_slot_limit(cat $&persist.SaveSlotCatalog) bool {
    _ := cat.save_manual_slot("slot_extra", "Over", "s", 1, 500, 5, "{}") or (err) {
        _ := err
        << true
    }
    << false
}

fn rejects_nested_cmd_group(hist $&diag.CommandHistory) bool {
    _ := hist.begin_group("Nested") or (err) {
        _ := err
        << true
    }
    << false
}

fn rejects_empty_undo(hist $&diag.CommandHistory) bool {
    _ := hist.undo() or (err) {
        _ := err
        << true
    }
    << false
}

fn rejects_bad_quadtree_bounds() bool {
    _ := sp.new_quadtree_2d(10.0, 0.0, 5.0, 10.0, 4, 4) or (err) {
        _ := err
        << true
    }
    << false
}

fn test_tiled_navmesh() int {
    $tn := nav.new_tiled_navmesh(10.0, 0.78, 0.05, 0.5) or >>
    assert(build_flat_quad_tile($&tn, 0, 0, 0.0, 0.0, 10.0, 10.0, 0.0) == 2)
    assert(build_flat_quad_tile($&tn, 1, 0, 10.0, 0.0, 20.0, 10.0, 0.1) == 2)
    assert(build_flat_quad_tile($&tn, 1, 1, 10.0, 10.0, 20.0, 20.0, 0.1) == 2)
    assert(build_flat_quad_tile($&tn, 0, 1, 0.0, 10.0, 10.0, 20.0, 0.0) == 2)
    assert(tn.tile_count() == 4 && tn.portal_count() >= 4)
    assert(rejects_bad_tile_cost($&tn))

    // Lower route (1, 0) is normal cost -> prefer 0,0 -> 1,0 -> 1,1 vs expensive 0,1
    tn.set_tile_cost_multiplier(0, 1, 8.0) or >>
    p1 := tn.find_path(fm.vec3(2.0, 0.0, 5.0), fm.vec3(15.0, 0.1, 15.0), &[]f64{}) or >>
    assert(p1.found && p1.tiles_traversed == 3 && p1.waypoints.len >= 4)

    // Remove tile (1, 0) dynamically -> route automatically detours through (0, 1)!
    assert(tn.remove_tile(1, 0))
    assert(!tn.has_tile(1, 0) && tn.tile_count() == 3)
    p2 := tn.find_path(fm.vec3(2.0, 0.0, 5.0), fm.vec3(15.0, 0.1, 15.0), &[]f64{}) or >>
    assert(p2.found && p2.tiles_traversed == 3 && p2.total_cost > p1.total_cost)

    // Remove bridge tile (0, 1) -> islands disconnected
    assert(tn.remove_tile(0, 1))
    p3 := tn.find_path(fm.vec3(2.0, 0.0, 5.0), fm.vec3(15.0, 0.1, 15.0), &[]f64{}) or >>
    assert(!p3.found)
    << 0
}

fn test_utility_reasoner() int {
    assert(rejects_bad_utility_curve())
    lin := bt.eval_response_curve(0.5, bt.CURVE_LINEAR, 1.0, 1.0, 0.0, 0.0, false) or >>
    assert(near_f(lin, 0.5, 1e-6))
    inv := bt.eval_response_curve(0.25, bt.CURVE_LINEAR, 1.0, 1.0, 0.0, 0.0, true) or >>
    assert(near_f(inv, 0.75, 1e-6))

    $ur := bt.new_utility_reasoner()
    ur.add_action("heal", 1.2, 2.0, 0.15) or >>
    ur.add_action("attack", 1.0, 0.0, 0.25) or >>
    ur.add_action("patrol", 0.4, 0.0, 0.0) or >>

    // heal wants low HP + mana > 0
    ur.add_consideration("heal", bt.UtilityConsideration{
        name: "low_hp", bb_key: "hp", min_val: 0.0, max_val: 100.0,
        curve: bt.CURVE_QUADRATIC, slope: 1.0, exponent: 2.0,
        offset_x: 0.0, offset_y: 0.0, invert: true
    }) or >>
    ur.add_consideration("heal", bt.UtilityConsideration{
        name: "has_mana", bb_key: "mana", min_val: 0.0, max_val: 100.0,
        curve: bt.CURVE_STEP, slope: 1.0, exponent: 1.0,
        offset_x: -0.3, offset_y: 0.0, invert: false
    }) or >>

    // attack wants close enemy
    ur.add_consideration("attack", bt.UtilityConsideration{
        name: "enemy_close", bb_key: "enemy_prox", min_val: 0.0, max_val: 1.0,
        curve: bt.CURVE_LOGISTIC, slope: 1.2, exponent: 1.0,
        offset_x: 0.0, offset_y: 0.0, invert: false
    }) or >>

    // patrol is always baseline fallback
    ur.add_consideration("patrol", bt.UtilityConsideration{
        name: "always", bb_key: "patrol_ready", min_val: 0.0, max_val: 1.0,
        curve: bt.CURVE_LINEAR, slope: 1.0, exponent: 1.0,
        offset_x: 0.0, offset_y: 0.0, invert: false
    }) or >>

    $bb := bt.new_blackboard()
    bb.set_f64("hp", 15.0)
    bb.set_f64("mana", 50.0)
    bb.set_f64("enemy_prox", 0.7)
    bb.set_f64("patrol_ready", 1.0)

    d1 := ur.select_and_commit(&bb) or >>
    assert(d1.found && d1.action_name == "heal")

    // Now heal is on cooldown (2.0s) -> attack wins!
    d2 := ur.select_and_commit(&bb) or >>
    assert(d2.found && d2.action_name == "attack")
    assert(d2.candidates[2].action_name == "heal" && d2.candidates[2].on_cooldown)

    // Hysteresis keeps attack ahead of marginal tie, and cooldown decays after tick
    ur.tick_cooldowns(2.5) or >>
    bb.set_f64("hp", 10.0)
    d3 := ur.select_and_commit(&bb) or >>
    assert(d3.found && d3.action_name == "heal")
    << 0
}

fn test_save_slots_and_recovery() int {
    $cat := persist.new_save_catalog(2, 2) or >>
    assert(rejects_bad_slot_id($&cat))

    m1 := cat.save_manual_slot("slot_a", "Camp", "world.xuscene", 1, 1000, 120, "{\"hp\":80}") or >>
    m2 := cat.save_manual_slot("slot_b", "Boss", "boss.xuscene", 1, 2000, 240, "{\"hp\":95}") or >>
    assert(rejects_manual_slot_limit($&cat))

    a0 := cat.save_autosave("Auto 0", "boss.xuscene", 1, 3000, 260, "{\"hp\":60}") or >>
    a1 := cat.save_autosave("Auto 1", "boss.xuscene", 1, 4000, 280, "{\"hp\":50}") or >>
    // 3rd autosave wraps cursor to overwrite autosave-0!
    a2 := cat.save_autosave("Auto 2", "final.xuscene", 1, 5000, 300, "{\"hp\":40}") or >>
    assert(a2.meta.slot_id == "autosave-0" && a2.meta.generation == 2)
    assert(cat.slot_count() == 4)

    ordered := cat.list_slots_newest_first()
    assert(ordered.len == 4 && ordered[0].slot_id == "autosave-0" && ordered[1].slot_id == "autosave-1")

    // Catalog JSON roundtrip
    cjson := cat.encode_catalog_json()
    cat_rt := persist.decode_catalog_json(&cjson) or >>
    assert(cat_rt.slot_count() == 4 && cat_rt.has_slot("slot_b"))

    // Corrupt newest two autosaves (autosave-0 missing, autosave-1 checksum-tampered) -> recover slot_b!
    $disk := map[string]string{}
    disk["autosave-1"] = strings.replace(&a1.envelope_json, "50", "99", 1)
    disk["slot_b"] = m2.envelope_json + ""
    disk["slot_a"] = m1.envelope_json + ""
    _ := a0

    rec := cat_rt.recover_newest_valid(&disk)
    assert(rec.found && rec.slot_id == "slot_b")
    assert(rec.skipped_corrupt.len == 2 && rec.skipped_corrupt[0] == "autosave-0" && rec.skipped_corrupt[1] == "autosave-1")
    assert(rec.envelope.payload == "{\"hp\":95}")
    assert(cat.delete_slot("slot_a") && cat.slot_count() == 3)
    << 0
}

fn test_command_history() int {
    $h := diag.new_command_history(16, 250) or >>
    assert(rejects_empty_undo($&h))
    assert(!h.is_dirty())

    // Rapid edits within 250ms merge_window coalesce!
    _ := h.push("Move X", "pos:node1", 1000, "x=0", "x=1") or >>
    _ := h.push("Move X", "pos:node1", 1120, "x=1", "x=2") or >>
    _ := h.push("Move X", "pos:node1", 1220, "x=2", "x=3") or >>
    assert(h.undo_count() == 1)
    h.mark_saved()
    assert(!h.is_dirty())

    // Next edit with same merge_key must NOT coalesce across saved checkpoint!
    _ := h.push("Move X", "pos:node1", 1250, "x=3", "x=4") or >>
    assert(h.undo_count() == 2 && h.is_dirty())

    // Undo back to saved checkpoint clears dirty!
    ub := h.undo() or >>
    assert(ub.commands[0].before_payload == "x=3" && ub.commands[0].after_payload == "x=4")
    assert(!h.is_dirty() && h.can_redo() && h.redo_label() == "Move X")

    // Transaction group commit & rollback
    h.begin_group("MultiEdit") or >>
    assert(rejects_nested_cmd_group($&h))
    _ := h.push("Step 1", "", 2000, "a=0", "a=1") or >>
    _ := h.push("Step 2", "", 2010, "b=0", "b=2") or >>
    rb := h.rollback_group() or >>
    assert(rb.len == 2 && rb[0].label == "Step 2" && rb[1].label == "Step 1")
    assert(h.undo_count() == 1)

    h.begin_group("AtomicBatch") or >>
    _ := h.push("Scale", "", 2100, "s=1", "s=2") or >>
    _ := h.push("Tint", "", 2105, "c=w", "c=r") or >>
    _ := h.commit_group() or >>
    assert(h.undo_count() == 2 && !h.can_redo() && h.undo_label() == "AtomicBatch")
    gb := h.undo() or >>
    assert(gb.commands.len == 2 && h.can_redo())
    _ := h.redo() or >>
    assert(h.undo_count() == 2 && !h.can_redo())
    h.clear()
    assert(!h.can_undo() && !h.is_dirty())
    << 0
}

fn test_quadtree_2d() int {
    assert(rejects_bad_quadtree_bounds())
    $qt := sp.new_quadtree_2d(-100.0, -100.0, 100.0, 100.0, 5, 2) or >>
    qt.insert(1, -20.0, -20.0, -10.0, -10.0) or >>
    qt.insert(2, 10.0, 10.0, 25.0, 25.0) or >>
    qt.insert(3, 40.0, -5.0, 55.0, 10.0) or >>
    // Center-straddling box
    qt.insert(4, -5.0, -5.0, 5.0, 5.0) or >>
    qt.insert(5, -50.0, 40.0, -35.0, 55.0) or >>
    assert(qt.count() == 5 && qt.node_count() >= 5)

    r_hits := qt.query_rect(-6.0, -6.0, 12.0, 12.0) or >>
    assert(r_hits.len == 2 && r_hits[0] == 2 && r_hits[1] == 4)

    c_hits := qt.query_circle(0.0, 0.0, 6.0) or >>
    assert(c_hits.len == 1 && c_hits[0] == 4)

    // Ray from (-30, 0) in +X direction hits id 4 at t=25 and id 3 at t=70
    rhits := qt.raycast_2d(-30.0, 0.0, 1.0, 0.0, 100.0) or >>
    assert(rhits.len == 2 && rhits[0].id == 4 && near_f(rhits[0].t, 25.0, 1e-6))
    assert(rhits[1].id == 3 && near_f(rhits[1].t, 70.0, 1e-6))

    // Move item 2 onto the ray path and remove 4
    qt.update(2, 5.0, -4.0, 15.0, 4.0) or >>
    assert(qt.remove(4))
    rhits2 := qt.raycast_2d(-30.0, 0.0, 1.0, 0.0, 100.0) or >>
    assert(rhits2.len == 2 && rhits2[0].id == 2 && near_f(rhits2[0].t, 35.0, 1e-6))
    assert(rhits2[1].id == 3)

    qt.clear()
    assert(qt.count() == 0 && qt.node_count() == 1)
    << 0
}

fn run() int {
    test_tiled_navmesh() or >>
    test_utility_reasoner() or >>
    test_save_slots_and_recovery() or >>
    test_command_history() or >>
    test_quadtree_2d() or >>
    println("PASS: developer_systems_r3_checks (TiledNavMesh3D, UtilityReasoner, SaveSlotCatalog/Recovery, CommandHistory, Loose Quadtree2D)")
    << 0
}

fn main() int {
    << run() or (err) {
        eprintln("FAIL: " + err.msg())
        << 1
    }
}
