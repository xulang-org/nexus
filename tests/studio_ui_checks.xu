@main

gltf #"github.com/xulang-org/nexus/formats/gltf"
codec #"github.com/xulang-org/nexus/formats/scene"
rs #"github.com/xulang-org/nexus/resources/scene"
project #"github.com/xulang-org/nexus/integration/project"
snapshot #"github.com/xulang-org/nexus/internal/file_snapshot"
#crypto/sha256
#encoding/json
#errors
#math
#os
#os/exec
#path/filepath
#strings

fn check(cond bool, label string) {
    if !cond {
        eprintln("FAIL: " + label)
        <<< 1
    }
}

fn is_valid_png(raw &string) bool {
    if raw.len <= 100 { << false }
    << (raw[0] & 255) == 137 &&
        (raw[1] & 255) == 80 &&
        (raw[2] & 255) == 78 &&
        (raw[3] & 255) == 71 &&
        (raw[4] & 255) == 13 &&
        (raw[5] & 255) == 10 &&
        (raw[6] & 255) == 26 &&
        (raw[7] & 255) == 10
}

fn copy_file(src string, dst string) int {
    raw := snapshot.read(src, snapshot.MAX_BYTES) >>>
    snapshot.write_atomic(dst, &raw) >>>
    << 0
}

fn remove_dir_quiet(p string) {
    _ := os.remove_all(p + "") >>> (err) {
        _ := err
        <<
    }
}

fn must_cmd(bin &string, args &[]string, label string) string {
    $cmd := exec.command(*bin + "")
    for i in 0:args.len { cmd.args.push(args[i] + "") }
    out := cmd.combined_output() >>> (err) {
        eprintln("FAIL [" + label + "]: " + err.msg())
        <<< 1
    }
    << out
}

fn find_node_index(doc &rs.Document, name string) int {
    for i in 0:doc.node_count() {
        n := doc.describe_node(i) >>>
        if n.name == name { << i }
    }
    << -1
}

fn is_hex32(s &string) bool {
    if s.len != 32 { << false }
    for i in 0:s.len {
        b := s[i]
        ok := (b >= 48 && b <= 57) || (b >= 97 && b <= 102) || (b >= 65 && b <= 70)
        if !ok { << false }
    }
    << true
}

fn run_checks(studio_bin string, vp_bin string, val_bin string, cli_bin string) int {
    work := filepath.abs(&"build/studio-ui-test") >>>
    remove_dir_quiet(work + "")
    os.mkdir_all(work + "/assets/models") >>>

    proj_json := work + "/project.json"
    world_src := work + "/assets/world.xuscene"
    copy_file("examples/scene_assets/project.json", proj_json + "") >>>
    copy_file("examples/scene_assets/assets/world.xuscene", world_src + "") >>>
    copy_file("examples/scene_assets/assets/panels.glb", work + "/assets/panels.glb") >>>

    // Run 1: Split viewport, UI button & slider automation, whitebox ops, Scene v10 save, GLB export.
    single_png := work + "/single.png"
    split_png := work + "/split.png"
    wb_before_png := work + "/wb_before.png"
    edited_png := work + "/edited.png"
    ui_full_png := work + "/studio_ui_full.png"
    ui_single_png := work + "/studio_ui_single.png"
    out_v10 := work + "/assets/out_v10.xuscene"
    glb_rel := "assets/models/studio_wb.glb"
    glb_abs := work + "/" + glb_rel
    script1_path := work + "/script1.ndjson"

    script1_lines := [
        "{\"cmd\":\"set_layout\",\"mode\":\"single\"}",
        "{\"cmd\":\"capture\",\"path\":" + json.quote(&single_png) + "}",
        "{\"cmd\":\"ui_click\",\"target\":\"layout\"}",
        "{\"cmd\":\"capture\",\"path\":" + json.quote(&split_png) + "}",
        "{\"cmd\":\"ui_click\",\"target\":\"box\"}",
        "{\"cmd\":\"capture\",\"path\":" + json.quote(&wb_before_png) + "}",
        "{\"cmd\":\"ui_click\",\"target\":\"mode_face\"}",
        "{\"cmd\":\"pick_persp\",\"rel\":[0.5,0.5]}",
        "{\"cmd\":\"select_subobject\",\"indices\":[0]}",
        "{\"cmd\":\"ui_click\",\"target\":\"extrude\"}",
        "{\"cmd\":\"model_op\",\"op\":\"inset\",\"amount\":0.25,\"value\":0.15}",
        "{\"cmd\":\"model_op\",\"op\":\"bevel\",\"value\":0.14}",
        "{\"cmd\":\"ui_click\",\"target\":\"box_uv\"}",
        "{\"cmd\":\"ui_slide\",\"target\":\"pos_x\",\"ratio\":0.65}",
        "{\"cmd\":\"ui_slide\",\"target\":\"metallic\",\"ratio\":0.45}",
        "{\"cmd\":\"ui_slide\",\"target\":\"roughness\",\"ratio\":0.35}",
        "{\"cmd\":\"ui_slide\",\"target\":\"base_r\",\"ratio\":0.9}",
        "{\"cmd\":\"ui_click\",\"target\":\"ortho_axis\"}",
        "{\"cmd\":\"ui_click\",\"target\":\"toggle_grid\"}",
        "{\"cmd\":\"ui_click\",\"target\":\"toggle_grid\"}",
        "{\"cmd\":\"ui_click\",\"target\":\"toggle_wire\"}",
        "{\"cmd\":\"ui_click\",\"target\":\"toggle_wire\"}",
        "{\"cmd\":\"capture\",\"path\":" + json.quote(&edited_png) + "}",
        "{\"cmd\":\"capture_ui\",\"path\":" + json.quote(&ui_full_png) + "}",
        "{\"cmd\":\"ui_click\",\"target\":\"layout\"}",
        "{\"cmd\":\"capture_ui\",\"path\":" + json.quote(&ui_single_png) + "}",
        "{\"cmd\":\"ui_click\",\"target\":\"layout\"}",
        "{\"cmd\":\"model_op\",\"op\":\"undo\"}",
        "{\"cmd\":\"model_op\",\"op\":\"redo\"}",
        "{\"cmd\":\"save_v10\",\"path\":" + json.quote(&out_v10) + "}",
        "{\"cmd\":\"export_glb\",\"rel\":" + json.quote(&glb_rel) + "}",
        "{\"cmd\":\"quit\"}"
    ]
    s1_txt := strings.join(script1_lines, "\n") + "\n"
    snapshot.write_atomic(script1_path + "", &s1_txt) >>>

    _ := must_cmd(&studio_bin, &[
        "--project", proj_json + "",
        "--scene", world_src + "",
        "--output", out_v10 + "",
        "--export-glb", glb_rel + "",
        "--validator", val_bin + "",
        "--script", script1_path + ""
    ], "nexus-studio run 1")

    single_raw := snapshot.read(single_png + "", snapshot.MAX_BYTES) >>>
    split_raw := snapshot.read(split_png + "", snapshot.MAX_BYTES) >>>
    before_raw := snapshot.read(wb_before_png + "", snapshot.MAX_BYTES) >>>
    edited_raw := snapshot.read(edited_png + "", snapshot.MAX_BYTES) >>>
    ui_full_raw := snapshot.read(ui_full_png + "", snapshot.MAX_BYTES) >>>
    ui_single_raw := snapshot.read(ui_single_png + "", snapshot.MAX_BYTES) >>>
    check(is_valid_png(&single_raw), "single.png is valid PNG")
    check(is_valid_png(&split_raw), "split.png is valid PNG")
    check(is_valid_png(&before_raw), "wb_before.png is valid PNG")
    check(is_valid_png(&edited_raw), "edited.png is valid PNG")
    check(is_valid_png(&ui_full_raw), "studio_ui_full.png is valid PNG")
    check(is_valid_png(&ui_single_raw), "studio_ui_single.png is valid PNG")
    check(sha256.sum256(single_raw + "") != sha256.sum256(split_raw + ""), "Single vs Split viewport renders distinct GPU pixels")
    check(sha256.sum256(before_raw + "") != sha256.sum256(edited_raw + ""), "Extrude/inset/bevel/slider/ortho changes GPU pixels")
    check(sha256.sum256(ui_full_raw + "") != sha256.sum256(edited_raw + ""), "Composited Studio UI screenshot differs from raw 3D capture")
    check(sha256.sum256(ui_full_raw + "") != sha256.sum256(ui_single_raw + ""), "Split vs Single composited Studio UI screenshots differ")

    v10_raw := snapshot.read(out_v10 + "", snapshot.MAX_BYTES) >>>
    doc10 := codec.decode(&v10_raw) >>>
    check(doc10.has_modeling_attachments(), "Saved v10 scene has modeling attachments")
    check(doc10.editable_mesh_count() == 1, "Saved v10 scene has 1 editable mesh")
    check(doc10.material_override_count() == 1, "Saved v10 scene has 1 material override")
    em0 := doc10.editable_mesh(0) >>>
    check(em0.mesh.vertices.len > 8, "Saved editable mesh has extrude/inset/bevel vertices (>8)")
    mo0 := doc10.material_override(0) >>>
    check(mo0.material.metallic > 0.2, "Live metallic slider persisted to MaterialOverrideAttachment")
    wb_idx := find_node_index(&doc10, "StudioWhitebox")
    check(wb_idx > 0, "StudioWhitebox node exists in saved v10 scene")
    wb_node := doc10.describe_node(wb_idx) >>>
    check(wb_node.local_3d.c3.x > 0.5, "Live Pos X slider persisted to SceneTree node local_3d")

    _ := must_cmd(&val_bin, &["scene", out_v10 + ""], "validate out_v10.xuscene")

    glb_raw := snapshot.read(glb_abs + "", gltf.MAX_GLB_BYTES) >>>
    glb_dec := gltf.decode_glb_geometry(&glb_raw) >>>
    check(glb_dec.primitive_count() >= 1, "Exported GLB has >= 1 primitive")
    _ := must_cmd(&val_bin, &["glb", glb_abs + ""], "validate exported studio_wb.glb")

    proj := project.load_project(proj_json + "") >>>
    uid := proj.find_asset_uid_by_rel(&glb_rel)
    check(is_hex32(&uid), "Exported GLB registered with 32-hex UID in project.json")
    _ := must_cmd(&cli_bin, &["build", proj_json + "", "--output", work + "/dist", "--validator", val_bin + ""], "nexus-project build")

    // Run 2: Reload Scene v10, create CSG Hollow brush, save Scene v10, verify in both Studio and Viewport.
    reopened_png := work + "/reopened_v10.png"
    csg_png := work + "/csg_v10.png"
    out_csg_v10 := work + "/assets/out_csg_v10.xuscene"
    script2_path := work + "/script2.ndjson"
    script2_lines := [
        "{\"cmd\":\"capture\",\"path\":" + json.quote(&reopened_png) + "}",
        "{\"cmd\":\"ui_click\",\"target\":\"csg_hollow\"}",
        "{\"cmd\":\"set_material\",\"base\":[0.15,0.72,0.68],\"metallic\":0.1,\"roughness\":0.45}",
        "{\"cmd\":\"save_v10\",\"path\":" + json.quote(&out_csg_v10) + "}",
        "{\"cmd\":\"capture\",\"path\":" + json.quote(&csg_png) + "}",
        "{\"cmd\":\"quit\"}"
    ]
    s2_txt := strings.join(script2_lines, "\n") + "\n"
    snapshot.write_atomic(script2_path + "", &s2_txt) >>>

    _ := must_cmd(&studio_bin, &[
        "--project", proj_json + "",
        "--scene", out_v10 + "",
        "--output", out_csg_v10 + "",
        "--script", script2_path + ""
    ], "nexus-studio run 2 CSG + v10 reload")

    reopened_raw := snapshot.read(reopened_png + "", snapshot.MAX_BYTES) >>>
    csg_raw := snapshot.read(csg_png + "", snapshot.MAX_BYTES) >>>
    check(is_valid_png(&reopened_raw), "reopened_v10.png valid PNG")
    check(is_valid_png(&csg_raw), "csg_v10.png valid PNG")
    check(sha256.sum256(reopened_raw + "") != sha256.sum256(csg_raw + ""), "CSG hollow spawn renders distinct GPU pixels")

    csg_v10_raw := snapshot.read(out_csg_v10 + "", snapshot.MAX_BYTES) >>>
    doc_csg := codec.decode(&csg_v10_raw) >>>
    check(doc_csg.editable_mesh_count() == 1 && doc_csg.csg_tree_count() == 1,
        "Saved out_csg_v10.xuscene contains both EditableMesh and CsgTree")
    _ := must_cmd(&val_bin, &["scene", out_csg_v10 + ""], "validate out_csg_v10.xuscene")

    // Verify Scene v10 renders cleanly in cmd/project_viewport as well.
    vp_out := work + "/assets/vp_v10_out.xuscene"
    vp_png := work + "/vp_v10.png"
    vp_script_path := work + "/vp_script.ndjson"
    vp_script := "{\"cmd\":\"capture\",\"path\":" + json.quote(&vp_png) + "}\n{\"cmd\":\"apply\"}\n"
    snapshot.write_atomic(vp_script_path + "", &vp_script) >>>

    _ := must_cmd(&vp_bin, &[
        "--scene", out_csg_v10 + "",
        "--output", vp_out + "",
        "--live-script", vp_script_path + ""
    ], "project-viewport reload Scene v10")

    vp_raw := snapshot.read(vp_png + "", snapshot.MAX_BYTES) >>>
    check(is_valid_png(&vp_raw), "vp_v10.png valid PNG")

    println("PASS: studio_ui_checks (Metal split viewports, UiControlTree buttons/sliders, whitebox/CSG ops, Scene v10 & GLB roundtrip)")
    << 0
}

fn main() int {
    args := os.args()
    $studio_bin := "build/nexus-studio"
    $vp_bin := "build/nexus-project-viewport"
    $val_bin := "build/nexus-project-validate"
    $cli_bin := "build/nexus-project"
    if args.len == 5 && (args[1].len < 2 || args[1][0:2] != "--") {
        studio_bin = args[1] + ""
        vp_bin = args[2] + ""
        val_bin = args[3] + ""
        cli_bin = args[4] + ""
    } else {
        $i := 1
        while i + 1 < args.len {
            if args[i] == "--studio" { studio_bin = args[i + 1] + "" }
            else if args[i] == "--viewport" { vp_bin = args[i + 1] + "" }
            else if args[i] == "--validator" { val_bin = args[i + 1] + "" }
            else if args[i] == "--project-cli" { cli_bin = args[i + 1] + "" }
            i += 2
        }
    }
    << run_checks(studio_bin, vp_bin, val_bin, cli_bin) >>> (err) {
        eprintln("FAIL: " + err.msg())
        << 1
    }
}
