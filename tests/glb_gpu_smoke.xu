@main

#gpu

gpu_info #"github.com/xulang-org/nexus/platform/gpu"

mesh_shaders #"github.com/xulang-org/nexus/assets/shaders/three_d"

meshes #"github.com/xulang-org/nexus/resources/mesh"

gltf #"github.com/xulang-org/nexus/formats/gltf"
ren #"github.com/xulang-org/nexus/rendering/three_d"
scene_render #"github.com/xulang-org/nexus/integration/rendering/three_d"
colors #"github.com/xulang-org/nexus/foundation/color"
fm #"github.com/xulang-org/nexus/foundation/math"
assets #"github.com/xulang-org/nexus/assets/gltf"
nexus #"github.com/xulang-org/nexus/scene"
glb #"github.com/xulang-org/nexus/integration/gltf_render"
#math

fn bind_rejected(model &glb.GlbUnlit3D, scene $&scene_render.Scene3D, tree &nexus.SceneTree, instance &assets.GlbInstance) bool {
    model.bind(scene, tree, instance) or (err) { << true }
    << false
}
fn draw_rejected(scene &scene_render.Scene3D, device $&ren.Device3D, tree &nexus.SceneTree, view fm.Mat4) bool {
    scene.draw(device, tree, view) or (err) { << true }
    << false
}
fn upload_rejected(device &ren.Device3D, asset &gltf.GlbGeometry) bool {
    glb.upload_unlit(device, asset) or (err) { << true }
    << false
}
fn temporary_model(device &ren.Device3D, asset &gltf.GlbGeometry, tree &nexus.SceneTree, instance &assets.GlbInstance) scene_render.Scene3D {
    model := glb.upload_unlit(device, asset) or >>
    $scene := scene_render.new_scene_3d(device) or >>
    model.bind($&scene, tree, instance) or >>
    // Dropping the owning model must invalidate these weak scene bindings.
    << scene
}
fn run() int {
    asset := assets.load_glb_geometry("build/glb-fixtures/triangle.glb") or >>
    other_asset := assets.load_glb_geometry("build/glb-fixtures/other.glb") or >>
    tower := assets.load_glb_geometry("examples/glb_preview/assets/tower.glb") or >>
    mesh_program_0 := mesh_shaders.load_mesh("build/mesh-shaders") or >>
    $device := ren.open_3d("GLB GPU validation", 256, 256, gpu.AUTO, &mesh_program_0) or >>
    backend := device.backend() or >>
    println("GLB test GPU backend: " + gpu_info.backend_name(backend))
    $model := glb.upload_unlit(&device, &asset) or >>
    $tree := nexus.new_scene_tree_3d("World", 128) or >>
    root := tree.root()
    a := assets.instantiate(&asset, $&tree, root, "A") or >>
    b := assets.instantiate(&asset, $&tree, root, "B") or >>
    tree.set_position_3d(b.root, fm.vec3(1.4, 0.0, 0.0)) or >>
    camera_node := tree.add_child_3d(root, "Camera") or >>
    $camera := nexus.new_camera_node_3d(&tree, camera_node) or >>
    camera.vertical_fov = math.pi() / 2.0
    view := camera.view_projection(&tree, 1.0) or >>
    $scene := scene_render.new_scene_3d(&device) or >>
    assert((model.bind($&scene, &tree, &a) or >>) == 1)
    assert((model.bind($&scene, &tree, &b) or >>) == 1)
    assert(scene.binding_count() == 2)
    background := colors.rgba8(16, 24, 32, 255) or >>
    red := colors.rgba8(255, 0, 0, 255) or >>
    device.begin(background) or >>
    draws := scene.draw($&device, &tree, view) or >>
    assert(draws.instances == 2 && draws.triangles == 2)
    assert((device.read_pixel(128, 128) or >>) == red && (device.read_pixel(217, 150) or >>) == red)
    device.capture("build/glb-events.png") or >>
    device.present() or >>
    foreign_instance := assets.instantiate(&other_asset, $&tree, root, "WrongSource") or >>
    assert(bind_rejected(&model, $&scene, &tree, &foreign_instance) && scene.binding_count() == 2)
    $tower_model := glb.upload_unlit(&device, &tower) or >>
    tower_instance := assets.instantiate(&tower, $&tree, root, "Tower") or >>
    last_primitive := tower_instance.primitive_node(tower_instance.primitive_count() - 1) or >>
    tree.queue_free(last_primitive) or >>
    $atomic_scene := scene_render.new_scene_3d(&device) or >>
    assert(bind_rejected(&tower_model, $&atomic_scene, &tree, &tower_instance) && atomic_scene.binding_count() == 0)
    tower_model.close() or >>
    dangling := temporary_model(&device, &asset, &tree, &a) or >>
    device.begin(background) or >>
    assert(draw_rejected(&dangling, $&device, &tree, view))
    device.present() or >>
    model.close() or >>
    model.close() or >>
    assert(bind_rejected(&model, $&scene, &tree, &a))
    // Force a partial GLB upload: two slots fit, the third fails. Both temporary
    // meshes must be released, otherwise the following probes cannot allocate.
    $data := meshes.new_mesh_data_3d()
    data.vertex(fm.vec3(-1.0, -1.0, 0.0), red) or >>
    data.vertex(fm.vec3(1.0, -1.0, 0.0), red) or >>
    data.vertex(fm.vec3(0.0, 1.0, 0.0), red) or >>
    data.triangle(0, 1, 2) or >>
    $holders := []ren.Mesh3D{}
    for i in 0:510 { holders.push(device.upload(&data) or >>) }
    assert(upload_rejected(&device, &tower))
    $probe_a := device.upload(&data) or >>
    $probe_b := device.upload(&data) or >>
    probe_a.close() or >>
    probe_b.close() or >>
    for i in 0:holders.len { mesh := $&holders[i]
        mesh.close() or >> }
    $fresh := glb.upload_unlit(&device, &asset) or >>
    fresh.bind($&scene, &tree, &a) or >>
    fresh.bind($&scene, &tree, &b) or >>
    device.begin(background) or >>
    scene.draw($&device, &tree, view) or >>
    assert((device.read_pixel(128, 128) or >>) == red)
    device.present() or >>
    device.close() or >>
    fresh.close() or >>
    println("PASS: GLB GPU upload, shared instances, source hash mismatch, atomic bind failure, owning-array drop, partial-upload rollback, resource reuse and owner shutdown")
    << 0
}
fn main() int { << run() or (err) { eprintln(err.msg())
    << 1 } }
