@main

codec #"github.com/xulang-org/nexus/formats/scene"
resource #"github.com/xulang-org/nexus/resources/scene"
snapshot #"github.com/xulang-org/nexus/internal/file_snapshot"
#errors
#os
#os/exec
#path/filepath
#strings

struct Config {
    editor string
    project_cli string
    validator string
    preview string
    viewport string
    course string
}

struct CmdResult {
    ok bool
    output string
}

fn check(cond bool, msg string) int {
    if !cond {
        >>> errors.new("project_editor_checks: " + msg)
    }
    << 0
}

fn copy_file(src string, dst string) int {
    dir := filepath.dir(&dst)
    if dir.len > 0 && dir != "." {
        os.mkdir_all(dir + "") >>>
    }
    raw := snapshot.read(src + "", snapshot.MAX_BYTES) >>>
    snapshot.write_atomic(dst + "", &raw) >>>
    << 0
}

fn is_valid_png(raw &string) bool {
    if raw.len < 24 { << false }
    << (raw[0] & 255) == 137 &&
        (raw[1] & 255) == 80 &&
        (raw[2] & 255) == 78 &&
        (raw[3] & 255) == 71 &&
        (raw[4] & 255) == 13 &&
        (raw[5] & 255) == 10 &&
        (raw[6] & 255) == 26 &&
        (raw[7] & 255) == 10
}

fn run_cmd(bin &string, args &[]string) CmdResult {
    $cmd := exec.command(*bin + "")
    for i in 0:args.len {
        cmd.args.push(args[i] + "")
    }
    out := cmd.combined_output() >>> (err) {
        << CmdResult{ok: false, output: err.msg()}
    }
    << CmdResult{ok: true, output: out}
}

fn must_cmd(bin &string, args &[]string, label string) string {
    res := run_cmd(bin, args)
    if !res.ok {
        >>> errors.new("project_editor_checks: " + label + " failed: " + res.output)
    }
    << res.output
}

fn parse_args(argv []string) Config {
    $cfg := Config{
        editor: "build/nexus-project-editor",
        project_cli: "build/nexus-project",
        validator: "build/nexus-project-validate",
        preview: "build/nexus-project-preview",
        viewport: "build/nexus-project-viewport",
        course: "build/nexus-character-course"
    }
    $i := 1
    while i < argv.len {
        arg := argv[i] + ""
        if arg == "--editor" {
            i = i + 1
            if i >= argv.len { >>> errors.new("missing value for --editor") }
            cfg.editor = argv[i] + ""
        } else if arg == "--project-cli" {
            i = i + 1
            if i >= argv.len { >>> errors.new("missing value for --project-cli") }
            cfg.project_cli = argv[i] + ""
        } else if arg == "--validator" {
            i = i + 1
            if i >= argv.len { >>> errors.new("missing value for --validator") }
            cfg.validator = argv[i] + ""
        } else if arg == "--preview" {
            i = i + 1
            if i >= argv.len { >>> errors.new("missing value for --preview") }
            cfg.preview = argv[i] + ""
        } else if arg == "--viewport" {
            i = i + 1
            if i >= argv.len { >>> errors.new("missing value for --viewport") }
            cfg.viewport = argv[i] + ""
        } else if arg == "--course" {
            i = i + 1
            if i >= argv.len { >>> errors.new("missing value for --course") }
            cfg.course = argv[i] + ""
        } else {
            >>> errors.new("unknown argument: " + arg)
        }
        i = i + 1
    }
    << cfg
}

fn path_exists(path string) bool {
    _ := os.stat(path + "") >>> (err) {
        _ := err
        << false
    }
    << true
}

fn nudge_course_ramp(scene_path &string, node_name &string, dz f64) int {
    raw := snapshot.read(*scene_path + "", codec.MAX_BYTES) >>>
    doc := codec.decode(&raw) >>>
    $nodes := []resource.NodeData{}
    $found := false
    for i in 0:doc.node_count() {
        $nd := doc.describe_node(i) >>>
        if nd.name == *node_name {
            nd.local_3d.c3.z = nd.local_3d.c3.z + dz
            found = true
        }
        nodes.push(nd)
    }
    check(found, "course ramp node found: " + *node_name) >>>

    $refs := []resource.ResourceReference{}
    for i in 0:doc.resource_count() {
        r := doc.resource(i) >>>
        refs.push(resource.ResourceReference{uid: r.uid + "", kind: r.kind + "", path: r.path + "", content_hash: r.content_hash + ""})
    }
    $surfs := []resource.Surface{}
    for i in 0:doc.surface_count() {
        s := doc.surface(i) >>>
        $lvls := []resource.SurfaceLevel{}
        for k in 0:s.levels.len {
            lv := &s.levels[k]
            lvls.push(resource.SurfaceLevel{distance: lv.distance, resource_uid: lv.resource_uid + "", primitive: lv.primitive})
        }
        surfs.push(resource.Surface{node: s.node, resource_uid: s.resource_uid + "", primitive: s.primitive, levels: lvls, hysteresis: s.hysteresis})
    }
    $buses := []resource.AudioBus{}
    for i in 0:doc.audio_bus_count() { buses.push(doc.audio_bus(i) >>>) }
    $emitters := []resource.AudioEmitter{}
    for i in 0:doc.audio_count() { emitters.push(doc.audio_emitter(i) >>>) }
    $scripts := []resource.ScriptAttachment{}
    for i in 0:doc.script_count() { scripts.push(doc.script(i) >>>) }
    $conns := []resource.ScriptConnection{}
    for i in 0:doc.script_connection_count() { conns.push(doc.script_connection(i) >>>) }
    $lights := []resource.LightAttachment{}
    for i in 0:doc.light_count() { lights.push(doc.light(i) >>>) }
    $sprites := []resource.Sprite3DAttachment{}
    for i in 0:doc.sprite_3d_count() { sprites.push(doc.sprite_3d(i) >>>) }
    $tilemaps := []resource.TileMap2DAttachment{}
    for i in 0:doc.tilemap_2d_count() { tilemaps.push(doc.tilemap_2d(i) >>>) }

    base := resource.make_document(nodes) >>>
    updated := resource.with_all_attachments(&base, refs, surfs, buses, emitters, scripts, conns, lights, sprites, tilemaps) >>>
    encoded := codec.encode(&updated) >>>
    snapshot.write_atomic(*scene_path + "", &encoded) >>>
    << 0
}

fn run_checks(cfg &Config) int {
    ed_bin := filepath.abs(&cfg.editor) >>>
    cli_bin := filepath.abs(&cfg.project_cli) >>>
    val_bin := filepath.abs(&cfg.validator) >>>
    prev_bin := filepath.abs(&cfg.preview) >>>
    vp_bin := filepath.abs(&cfg.viewport) >>>
    course_bin := filepath.abs(&cfg.course) >>>

    root := os.mkdir_temp("", "nexus-project-editor-") >>>
    _ := run_checks_in_dir(
        &ed_bin,
        &cli_bin,
        &val_bin,
        &prev_bin,
        &vp_bin,
        &course_bin,
        root + ""
    ) >>> (err) {
        _ := os.remove_all(root + "")
        >>> err
    }
    os.remove_all(root + "") >>>
    << 0
}

fn run_checks_in_dir(
    ed_bin &string,
    cli_bin &string,
    val_bin &string,
    prev_bin &string,
    vp_bin &string,
    course_bin &string,
    root string
) int {
    gal_dir := filepath.join([root + "", "gallery"])
    course_dir := filepath.join([root + "", "course"])
    os.mkdir_all(filepath.join([gal_dir + "", "assets"])) >>>
    os.mkdir_all(filepath.join([course_dir + "", "assets"])) >>>

    copy_file("examples/scene_assets/project.json", filepath.join([gal_dir + "", "project.json"])) >>>
    copy_file("examples/scene_assets/assets/panels.glb", filepath.join([gal_dir + "", "assets", "panels.glb"])) >>>
    copy_file("examples/scene_assets/assets/world.xuscene", filepath.join([gal_dir + "", "assets", "world.xuscene"])) >>>

    copy_file("examples/character_course/project.json", filepath.join([course_dir + "", "project.json"])) >>>
    copy_file("examples/character_course/assets/course.glb", filepath.join([course_dir + "", "assets", "course.glb"])) >>>
    copy_file("examples/character_course/assets/course.xuscene", filepath.join([course_dir + "", "assets", "course.xuscene"])) >>>

    gal_proj := filepath.join([gal_dir + "", "project.json"])
    gal_world := filepath.join([gal_dir + "", "assets", "world.xuscene"])
    course_proj := filepath.join([course_dir + "", "project.json"])
    course_scene := filepath.join([course_dir + "", "assets", "course.xuscene"])

    // 1. Validate source fixtures via pure-Xu validator.
    _ := must_cmd(val_bin, &["scene", gal_world + ""], "validate gallery world.xuscene")
    _ := must_cmd(val_bin, &["scene", course_scene + ""], "validate course.xuscene")

    // 2. Compiled native XUUI editor headless check + Paper PNG capture on both projects.
    ed_gal_out := filepath.join([root + "", "ed_gal"])
    ed_course_out := filepath.join([root + "", "ed_course"])
    ed1 := must_cmd(ed_bin, &[gal_proj + "", "--headless-check", "--output", ed_gal_out + "", "--validator", *val_bin + ""], "headless editor check gallery")
    check(strings.contains(&ed1, "HEADLESS_CHECK_OK"), "editor gallery headless ok: " + ed1) >>>
    ed1_png := snapshot.read(filepath.join([ed_gal_out + "", "editor-check.png"]), snapshot.MAX_BYTES) >>>
    check(is_valid_png(&ed1_png), "editor gallery PNG valid") >>>

    // Pre-seed snap JSON in ed_course_out and verify editor loads it cleanly on startup.
    os.mkdir_all(ed_course_out + "") >>>
    snap_json := "{\"format\":\"nexus.editor_snap\",\"version\":1,\"move\":1.25,\"rotate\":30,\"scale\":25}\n"
    snapshot.write_atomic(filepath.join([ed_course_out + "", "editor-snap.json"]), &snap_json) >>>
    ed2 := must_cmd(ed_bin, &[course_proj + "", "--headless-check", "--output", ed_course_out + "", "--validator", *val_bin + ""], "headless editor check course")
    check(strings.contains(&ed2, "HEADLESS_CHECK_OK"), "editor course headless ok: " + ed2) >>>
    ed2_png := snapshot.read(filepath.join([ed_course_out + "", "editor-check.png"]), snapshot.MAX_BYTES) >>>
    check(is_valid_png(&ed2_png), "editor course PNG valid") >>>

    // 3. Publish gallery project and capture real Metal preview.
    gal_pub := filepath.join([root + "", "gal_pub"])
    _ := must_cmd(cli_bin, &["build", gal_proj + "", "--output", gal_pub + "", "--validator", *val_bin + ""], "build gallery project")
    pub_gallery := strings.trim_space(&must_cmd(cli_bin, &["scene", "gallery.xuscene", "--output", gal_pub + ""], "resolve published gallery"))
    gal_prev_png := filepath.join([root + "", "gal_preview.png"])
    _ := must_cmd(prev_bin, &["--scene", pub_gallery + "", "--shaders", "build/mesh-shaders", "--frames", "2", "--capture", gal_prev_png + ""], "preview gallery")
    gal_prev_raw := snapshot.read(gal_prev_png + "", snapshot.MAX_BYTES) >>>
    check(is_valid_png(&gal_prev_raw), "gallery preview PNG valid") >>>

    // 4. Native 3D viewport: single-node gizmo edit + Metal capture on world.xuscene.
    vp_world_out := filepath.join([root + "", "world_vp.xuscene"])
    vp_world_png := filepath.join([root + "", "world_vp.png"])
    _ := must_cmd(
        vp_bin,
        &["--scene", gal_world + "", "--output", vp_world_out + "", "--check-node", "Factor", "--capture", vp_world_png + ""],
        "viewport single-node check"
    )
    _ := must_cmd(val_bin, &["scene", vp_world_out + ""], "validate viewport world output")
    vp_world_png_raw := snapshot.read(vp_world_png + "", snapshot.MAX_BYTES) >>>
    check(is_valid_png(&vp_world_png_raw), "viewport world capture valid PNG") >>>
    check((snapshot.read(vp_world_out + "", codec.MAX_BYTES) >>>) != (snapshot.read(gal_world + "", codec.MAX_BYTES) >>>), "viewport modified world.xuscene") >>>

    // 5. Native 3D viewport: multi-select, parent/child & local-axis snapped TRS under default and custom snap.
    vp_course_def := filepath.join([root + "", "course_def.xuscene"])
    vp_course_custom := filepath.join([root + "", "course_custom.xuscene"])
    vp_course_png := filepath.join([root + "", "course_vp.png"])
    _ := must_cmd(
        vp_bin,
        &["--scene", course_scene + "", "--output", vp_course_def + "", "--check-node", "Step 1", "--check-also", "Approach ramp", "--check-local", "--snap-move", "0.5", "--snap-rotate", "15", "--snap-scale", "10", "--capture", vp_course_png + ""],
        "viewport multi-select default snap check"
    )
    _ := must_cmd(val_bin, &["scene", vp_course_def + ""], "validate default snap course output")
    vp_course_png_raw := snapshot.read(vp_course_png + "", snapshot.MAX_BYTES) >>>
    check(is_valid_png(&vp_course_png_raw), "viewport course capture valid PNG") >>>

    _ := must_cmd(
        vp_bin,
        &["--scene", course_scene + "", "--output", vp_course_custom + "", "--check-node", "Step 1", "--check-also", "Approach ramp", "--check-local", "--snap-move", "1.25", "--snap-rotate", "30", "--snap-scale", "25"],
        "viewport multi-select custom snap check"
    )
    _ := must_cmd(val_bin, &["scene", vp_course_custom + ""], "validate custom snap course output")
    check((snapshot.read(vp_course_custom + "", codec.MAX_BYTES) >>>) != (snapshot.read(vp_course_def + "", codec.MAX_BYTES) >>>), "custom snap produces distinct transform") >>>

    // 6. Reject unknown node name in viewport without writing bogus scene file.
    missing_out := filepath.join([root + "", "should_not_exist.xuscene"])
    bad_vp := run_cmd(vp_bin, &["--scene", gal_world + "", "--output", missing_out + "", "--check-node", "NoSuchEditorNode"])
    check(!bad_vp.ok, "viewport rejects missing check node") >>>
    check(!path_exists(missing_out + ""), "failed viewport does not create output scene") >>>

    // 7. Edit course ramp -> publish -> run character_course --autoplay completion regression.
    nudge_course_ramp(&course_scene, &"Approach ramp", 0.05) >>>
    _ := must_cmd(val_bin, &["scene", course_scene + ""], "validate edited course.xuscene")
    course_pub := filepath.join([root + "", "course_pub"])
    _ := must_cmd(cli_bin, &["build", course_proj + "", "--output", course_pub + "", "--validator", *val_bin + ""], "publish edited course")
    pub_course := strings.trim_space(&must_cmd(cli_bin, &["scene", "course.xuscene", "--output", course_pub + ""], "resolve published course"))
    course_play_png := filepath.join([root + "", "course_autoplay.png"])
    _ := must_cmd(course_bin, &["--scene", pub_course + "", "--frames", "240", "--autoplay", "--capture", course_play_png + ""], "character course autoplay on published edited scene")
    course_play_raw := snapshot.read(course_play_png + "", snapshot.MAX_BYTES) >>>
    check(is_valid_png(&course_play_raw), "character course autoplay PNG valid") >>>

    println("PASS: project_editor_checks (native editor, snap persistence, viewport 3D gizmos, publish & course autoplay)")
    << 0
}

fn main() int {
    cfg := parse_args(os.args()) >>> (err) {
        eprintln(err.msg())
        << 1
    }
    _ := run_checks(&cfg) >>> (err) {
        eprintln(err.msg())
        << 1
    }
    << 0
}
