@main
lights #"github.com/xulang-org/nexus/resources/lighting"
meshes #"github.com/xulang-org/nexus/resources/mesh"
fm #"github.com/xulang-org/nexus/foundation/math"
#math
#os
#encoding/binary
fn bad_box(bounds fm.Aabb3) bool { bounds.validate() >>> (err){ << true }
    << false }
fn bad_select(environment &lights.Environment3D,bounds fm.Aabb3) bool { environment.for_bounds(bounds) >>> (err){ << true }
    << false }
fn point(x f64,y f64,z f64) fm.Aabb3 { p := fm.vec3(x,y,z)
    << fm.aabb3(p,p) >>> }
fn oracle(path string) int {
    raw := os.read(path) >>>
    $bytes := []u8{}
    for i in 0:raw.len { bytes.push(u8(raw[i])) }
    assert(bytes.len==512*15*8)
    for i in 0:512 {
        $v := []f64{}
        for j in 0:15 { v.push(binary.little_endian().get_f64(&bytes,(i*15+j)*8) >>>) }
        source := lights.spot_cosines(fm.vec3(v[0],v[1],v[2]),fm.vec3(v[3],v[4],v[5]),fm.vec3(1.0,1.0,1.0),v[6],v[7],v[8]) >>>
        bounds := fm.aabb3(fm.vec3(v[9],v[10],v[11]),fm.vec3(v[12],v[13],v[14])) >>>
        assert(source.affects(bounds) >>>)
    }
    << 0
}
fn run() int {
    zero := fm.vec3(0.0,0.0,0.0)
    one := fm.vec3(1.0,1.0,1.0)
    box := fm.aabb3(one.scaled(-1.0),one) >>>
    assert((box.distance_squared(zero) >>>)==0.0)
    assert((box.distance_squared(fm.vec3(2.0,3.0,4.0)) >>>)==14.0)
    assert(box.contains(one) >>>)
    assert(bad_box(fm.Aabb3{minimum: one,maximum: zero}))
    nan := math.float64_from_bits(9221120237041090560)
    assert(bad_box(fm.Aabb3{minimum: zero,maximum: fm.vec3(nan,1.0,1.0)}))
    $mesh := meshes.new_mesh_data_3d()
    for p in [fm.vec3(-2.0,1.0,0.0),fm.vec3(3.0,-4.0,1.0),fm.vec3(0.0,0.0,-5.0),fm.vec3(7.0,0.0,0.0)] {
        mesh.vertex_lit(p,4294967295,fm.vec3(0.0,0.0,1.0)) >>>
    }
    mesh.triangle(0,1,2) >>>
    bounds := mesh.bounds() >>>
    assert(bounds.minimum.x == -2.0 && bounds.minimum.y == -4.0 && bounds.minimum.z == -5.0 && bounds.maximum.x==7.0)
    directional := lights.directional(one,one) >>>
    assert(directional.affects(box) >>>)
    for x in [0.0,1.0,2.0,2.00001] {
        source := lights.point(fm.vec3(x,0.0,0.0),one,1.0) >>>
        assert(source.affects(box) >>>)
    }
    for p in [fm.vec3(2.01,0.0,0.0),fm.vec3(2.0,2.0,1.0),fm.vec3(-4.0,0.0,0.0)] {
        source := lights.point(p,one,1.0) >>>
        assert(!(source.affects(box) >>>))
    }
    source := lights.spot(zero,fm.vec3(0.0,0.0,1.0),one,10.0,0.1,0.5) >>>
    assert(source.affects(fm.aabb3(fm.vec3(-0.1,-0.1,3.0),fm.vec3(0.1,0.1,4.0)) >>>) >>>)
    assert(!(source.affects(fm.aabb3(fm.vec3(5.0,-0.1,3.0),fm.vec3(6.0,0.1,4.0)) >>>) >>>))
    assert(!(source.affects(fm.aabb3(fm.vec3(-0.1,-0.1,-4.0),fm.vec3(0.1,0.1,-3.0)) >>>) >>>))
    assert(source.affects(fm.aabb3(fm.vec3(1.0,-0.2,3.5),fm.vec3(5.0,0.2,4.5)) >>>) >>>)
    for angle in [0.0,0.49999,0.5,0.50001] {
        assert(source.affects(point(math.sin(angle)*3.0,0.0,math.cos(angle)*3.0) >>>) >>>)
    }
    assert(!(source.affects(point(math.sin(0.51)*3.0,0.0,math.cos(0.51)*3.0) >>>) >>>))
    assert(source.affects(point(0.0,0.0,0.0) >>>) >>>)
    remote := lights.point(fm.vec3(1e9,0.0,0.0),one,0.001) >>>
    assert(remote.affects(point(1e9+0.5,0.0,0.0) >>>) >>>)
    $candidates := [directional]
    for i in 0:254 { candidates.push(lights.point(fm.vec3(f64(i)+100.0,0.0,0.0),one,1.0) >>>) }
    candidates.push(lights.point(zero,one,1.0) >>>)
    environment := lights.environment(one.scaled(0.25),fm.vec3(0.0,0.0,2.0),2.0,candidates) >>>
    selected := environment.for_bounds(box) >>>
    assert(environment.source_count()==256 && selected.source_count()==2 && (selected.source(0) >>>).kind()==lights.DIRECTIONAL && (selected.source(1) >>>).kind()==lights.POINT)
    assert(selected.ambient().x==0.25 && selected.eye().z==2.0 && selected.exposure()==2.0)
    $overlap := []lights.Light3D{}
    for i in 0:17 { overlap.push(directional) }
    full := lights.environment(zero,one,1.0,overlap) >>>
    assert(bad_select(&full,box) && bad_select(&environment,fm.Aabb3{minimum: one,maximum: zero}))
    args := os.args()
    oracle(args[1]+"") >>>
    println("PASS: closed AABB/CPU mesh bounds, sphere range and spot-cone separation, conservative boundaries/large coordinates, stable 256->2 selection, explicit per-mesh overload and 512 independent known-contributing-point boxes")
    << 0
}
fn main() int { << run() >>> (err){ eprintln(err.msg())
    << 1 } }
