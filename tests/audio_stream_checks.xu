@main

mix #"github.com/xulang-org/nexus/audio/mixer"
pcm #"github.com/xulang-org/nexus/resources/audio"
music #"github.com/xulang-org/nexus/integration/audio_stream"
assets #"github.com/xulang-org/nexus/assets/audio"
#os

fn feed_rejected(mixer $&mix.Mixer, id int, samples &[]int) bool { mixer.feed_stream(id, samples, false) >>> (err) { << true }
    << false }
fn commit_rejected(mixer $&mix.Mixer, block &mix.MixBlock) bool { mixer.commit(block) >>> (err) { << true }
    << false }
fn refill_rejected(stream $&music.MusicStream, mixer $&mix.Mixer) bool { stream.refill(mixer, 1) >>> (err) { << true }
    << false }
fn reader_rejected(reader &assets.WavReader) bool { reader.read_frames(0, 1) >>> (err) { << true }
    << false }
fn open_rejected(mixer $&mix.Mixer) bool { mixer.open_stream(48000, 2, 65536) >>> (err) { << true }
    << false }
fn consumer_rejected(mixer $&mix.Mixer, source int) bool { mixer.play_stream(source, 0, 1.0, 0.0) >>> (err) { << true }
    << false }
fn run() int {
    $mixer := mix.new_mixer(48000, 4) >>>
    source := mixer.open_stream(24000, 1, 2) >>>
    first := [0, 10000]
    mixer.feed_stream(source, &first, false) >>>
    voice := mixer.play_stream(source, 0, 1.0, 0.0) >>>
    pending := mixer.prepare(4) >>>
    assert(pending.samples[0] == 0 && pending.samples[2] == 5000 && pending.samples[4] == 10000 && pending.samples[6] == 0)
    assert(pending.underruns == 1 && (mixer.stream_info(source) >>>).consumed_frames == 0)
    assert((mixer.position_frames(voice) >>>) == 0.0)
    assert(consumer_rejected($&mixer, source))
    mixer.commit(&pending) >>>
    assert((mixer.position_frames(voice) >>>) == 1.5 && (mixer.stream_info(source) >>>).room_frames == 1)
    second := [20000]
    mixer.feed_stream(source, &second, false) >>>
    next := mixer.render(2) >>>
    assert(next[0] == 15000 && next[2] == 20000)
    tail := [30000]
    mixer.feed_stream(source, &tail, true) >>>
    final := mixer.render(4) >>>
    assert(final[0] == 25000 && final[2] == 30000 && final[4] == 30000 && final[6] == 0)
    assert(!(mixer.is_playing(voice) >>>))
    mixer.close_stream(source) >>>
    fresh := mixer.open_stream(48000, 1, 4) >>>
    assert(source != fresh && !mixer.is_stream(source))
    bad := [-40000]
    before := mixer.prepare(1) >>>
    assert(feed_rejected($&mixer, fresh, &bad))
    mixer.commit(&before) >>>
    stale := mixer.prepare(1) >>>
    pair := [100, -200]
    mixer.feed_stream(fresh, &pair, false) >>>
    assert(commit_rejected($&mixer, &stale))
    streamed := mixer.play_stream(fresh, 0, 1.0, 0.0) >>>
    initial := mixer.render(2) >>>
    assert(initial[0] == 100 && initial[2] == -200)
    for i in 0:100 {
        mixer.feed_stream(fresh, &pair, false) >>>
        block := mixer.render(2) >>>
        assert(block[0] == 100 && block[2] == -200 && (mixer.stream_info(fresh) >>>).room_frames == 4)
    }
    empty := []int{}
    mixer.feed_stream(fresh, &empty, true) >>>
    mixer.render(1) >>>
    assert(!(mixer.is_playing(streamed) >>>))
    mixer.close_stream(fresh) >>>
    // Fades advance only on committed, unpaused source frames.
    clip_data := pcm.pcm16(48000, 1, [1000]) >>>
    clip := mixer.add_clip(clip_data) >>>
    fading := mixer.play(clip, 0, 1.0, 0.0, true) >>>
    mixer.fade_volume(fading, 0.0, 4, true) >>>
    preview := mixer.prepare(2) >>>
    assert(preview.samples[0] == 750 && preview.samples[2] == 500 && (mixer.volume(fading) >>>) == 1.0)
    mixer.commit(&preview) >>>
    assert((mixer.volume(fading) >>>) == 0.5)
    mixer.pause_voice(fading, true) >>>
    mixer.render(8) >>>
    assert((mixer.volume(fading) >>>) == 0.5)
    mixer.pause_voice(fading, false) >>>
    faded := mixer.render(2) >>>
    assert(faded[0] == 250 && faded[2] == 0 && !(mixer.is_playing(fading) >>>))
    old := mixer.play(clip, 0, 1.0, 0.0, true) >>>
    new := mixer.play(clip, 0, 0.0, 0.0, true) >>>
    mixer.crossfade(old, new, 4, 1.0) >>>
    for i in 0:4 { sample := mixer.render(1) >>>
        assert(sample[0] == 1000) }
    assert(!(mixer.is_playing(old) >>>) && (mixer.is_playing(new) >>>) && (mixer.volume(new) >>>) == 1.0)
    mixer.stop(new) >>>
    // Stream starvation freezes only that source and its fade; other voices mix.
    waiting := mixer.open_stream(48000, 1, 2) >>>
    silent_voice := mixer.play_stream(waiting, 0, 0.0, 0.0) >>>
    mixer.fade_volume(silent_voice, 1.0, 4, false) >>>
    background := mixer.play(clip, 0, 1.0, 0.0, true) >>>
    starved := mixer.prepare(2) >>>
    assert(starved.underruns == 1 && starved.samples[0] == 1000)
    mixer.commit(&starved) >>>
    assert((mixer.volume(silent_voice) >>>) == 0.0 && (mixer.position_frames(silent_voice) >>>) == 0.0)
    constant := [1000, 1000]
    mixer.feed_stream(waiting, &constant, false) >>>
    blended := mixer.render(2) >>>
    assert(blended[0] == 1250 && blended[2] == 1500 && (mixer.volume(silent_voice) >>>) == 0.5)
    mixer.stop(background) >>>
    frozen := mixer.render(2) >>>
    assert(frozen[0] == 0 && (mixer.volume(silent_voice) >>>) == 0.5)
    mixer.feed_stream(waiting, &constant, true) >>>
    resumed := mixer.render(2) >>>
    assert(resumed[0] == 750 && resumed[2] == 1000)
    mixer.close_stream(waiting) >>>
    // The shared ring budget is reclaimed on close, rather than per-file sized.
    $large_sources := []int{}
    for i in 0:4 { large_sources.push(mixer.open_stream(48000, 2, 65536) >>>) }
    assert(open_rejected($&mixer))
    for id in large_sources { mixer.close_stream(id) >>> }
    reclaimed := mixer.open_stream(48000, 2, 65536) >>>
    mixer.close_stream(reclaimed) >>>
    // Read and normalize far ends without loading the 48 MB source.
    $reader := assets.open_wav_reader("build/audio-fixtures/large.wav") >>>
    assert(reader.frame_count() == 12000000)
    start := reader.read_frames(0, 1) >>>
    end := reader.read_frames(11999998, 2) >>>
    assert(start[0] == 11 && start[1] == -11 && end[0] == 1000 && end[3] == -2000)
    reader.close() >>>
    assert(reader_rejected(&reader))
    $zero := assets.WavReader{}
    assert(reader_rejected(&zero))
    zero.close() >>>
    // Rejected reads/decodes preserve producer and mixer cursors.
    raw := os.read("build/audio-fixtures/pcm16.wav") >>>
    write_file("build/audio-fixtures/live.wav", raw + "") >>>
    $file_stream := music.open($&mixer, "build/audio-fixtures/live.wav", 8, false) >>>
    assert((file_stream.refill($&mixer, 1) >>>) == 1 && file_stream.read_position() == 1)
    write_file("build/audio-fixtures/live.wav", "truncated") >>>
    assert(refill_rejected($&file_stream, $&mixer) && file_stream.read_position() == 1)
    assert((mixer.stream_info(file_stream.source_id()) >>>).written_frames == 1)
    write_file("build/audio-fixtures/live.wav", raw + "") >>>
    assert((file_stream.refill($&mixer, 1) >>>) == 1 && file_stream.read_position() == 2)
    file_stream.close($&mixer) >>>
    file_stream.close($&mixer) >>>
    $invalid := music.open($&mixer, "build/audio-fixtures/nan.wav", 8, false) >>>
    assert(refill_rejected($&invalid, $&mixer) && invalid.read_position() == 0)
    assert((mixer.stream_info(invalid.source_id()) >>>).written_frames == 0)
    invalid.close($&mixer) >>>
    // Tiny loop assets fill one whole block from a bounded cache, without a
    // file seek for every one/two sample cycle.
    $tiny := music.open($&mixer, "build/audio-fixtures/order.wav", 16, true) >>>
    assert((tiny.refill($&mixer, 16) >>>) == 16)
    tiny_voice := mixer.play_stream(tiny.source_id(), 0, 1.0, 0.0) >>>
    tiny_block := mixer.prepare(16) >>>
    assert(tiny_block.underruns == 0 && tiny_block.samples[0] == 100 && tiny_block.samples[2] == 150 && tiny_block.samples[4] == 200)
    mixer.commit(&tiny_block) >>>
    assert((mixer.is_playing(tiny_voice) >>>))
    tiny.close($&mixer) >>>
    // Replacing a pathname must not silently switch the existing descriptor.
    write_file("build/audio-fixtures/pinned.wav", raw + "") >>>
    $pinned := assets.open_wav_reader("build/audio-fixtures/pinned.wav") >>>
    alternate := os.read("build/audio-fixtures/order.wav") >>>
    write_file("build/audio-fixtures/replacement.wav", alternate) >>>
    os.rename("build/audio-fixtures/replacement.wav", "build/audio-fixtures/pinned.wav") >>>
    original := pinned.read_frames(0, 1) >>>
    assert(original[0] == -32768 && pinned.frame_count() == 3)
    pinned.close() >>>
    println("PASS: bounded WAV/ring streaming, cross-block resampling, starvation, EOF, 100 wraps, stale receipts, failure recovery, fades/crossfade and pinned descriptor")
    << 0
}
fn main() int { << run() >>> (err) { eprintln(err.msg())
    << 1 } }
