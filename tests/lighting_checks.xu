@main
lights #"github.com/xulang-org/nexus/resources/lighting"
scene_lights #"github.com/xulang-org/nexus/integration/lighting"
scene #"github.com/xulang-org/nexus/scene"
fm #"github.com/xulang-org/nexus/foundation/math"
#math

fn near(a f64,b f64) bool { << math.abs(a-b)<0.000001 }
fn bad_source(source lights.Light3D) bool { source.validate() >>> (err){ << true }
    << false }
fn bad_direction(direction fm.Vec3) bool { lights.directional(direction,fm.vec3(1.0,1.0,1.0)) >>> (err){ << true }
    << false }
fn bad_point(position fm.Vec3,radiance fm.Vec3,radius f64) bool { lights.point(position,radiance,radius) >>> (err){ << true }
    << false }
fn bad_spot(direction fm.Vec3,inner f64,outer f64) bool {
    lights.spot(fm.vec3(0.0,0.0,0.0),direction,fm.vec3(1.0,1.0,1.0),4.0,inner,outer) >>> (err){ << true }
    << false
}
fn bad_environment(sources []lights.Light3D) bool {
    lights.environment(fm.vec3(0.0,0.0,0.0),fm.vec3(0.0,0.0,1.0),1.0,sources) >>> (err){ << true }
    << false
}
fn bad_gather(world &scene_lights.SceneLights3D,tree &scene.SceneTree) bool { world.gather(tree) >>> (err){ << true }
    << false }
fn bad_attach(world $&scene_lights.SceneLights3D,tree &scene.SceneTree,node int,source lights.Light3D) bool {
    world.attach(tree,node,source) >>> (err){ << true }
    << false
}
fn run() int {
    zero := fm.vec3(0.0,0.0,0.0)
    white := fm.vec3(1.0,1.0,1.0)
    directional := lights.directional(fm.vec3(0.0,0.0,1e200),white) >>>
    assert(near(directional.direction().z,1.0) && directional.kind()==lights.DIRECTIONAL)
    tiny := lights.directional(fm.vec3(1e-300,0.0,0.0),white) >>>
    assert(near(tiny.direction().x,1.0) && bad_direction(zero))
    assert(bad_source(lights.Light3D{}))
    assert(bad_point(zero,white,0.0) && bad_point(zero,white,1000001.0))
    assert(bad_point(fm.vec3(1e10,0.0,0.0),white,4.0) && bad_point(zero,fm.vec3(-1.0,0.0,0.0),4.0))
    nan := math.float64_from_bits(9221120237041090560)
    assert(bad_point(zero,white,nan) && bad_point(zero,fm.vec3(nan,0.0,0.0),4.0))
    assert(bad_spot(zero,0.1,0.5) && bad_spot(white,0.5,0.1) && bad_spot(white,-0.1,0.5))
    assert(bad_spot(white,0.1,2.0) && bad_spot(white,0.0,0.00001))
    point := lights.point(fm.vec3(1.0,2.0,3.0),white,5.0) >>>
    transform := fm.translation_3d(fm.vec3(10.0,20.0,30.0)).multiply(fm.scale_3d(fm.vec3(2.0,3.0,4.0)))
    moved := point.transformed(transform) >>>
    assert(moved.position().x==12.0 && moved.position().y==26.0 && moved.position().z==42.0 && moved.radius()==5.0)
    rotated := directional.transformed(fm.translation_3d(white).multiply(fm.rotation_y(math.pi()/2.0))) >>>
    assert(near(rotated.direction().x,1.0) && near(rotated.direction().z,0.0))
    diagonal := lights.directional(white,white) >>>
    scaled := diagonal.transformed(transform) >>>
    assert(near(scaled.direction().x,2.0/math.sqrt(29.0)) && near(scaled.direction().z,4.0/math.sqrt(29.0)))
    $shear := fm.identity_3d()
    shear.c1.x=2.0
    vertical := lights.directional(fm.vec3(0.0,1.0,0.0),white) >>>
    skewed := vertical.transformed(shear) >>>
    assert(near(skewed.direction().x,2.0/math.sqrt(5.0)) && near(skewed.direction().y,1.0/math.sqrt(5.0)))
    reflected := tiny.transformed(fm.scale_3d(fm.vec3(-1.0,1.0,1.0))) >>>
    assert(near(reflected.direction().x,-1.0))
    spot := lights.spot(zero,fm.vec3(0.0,0.0,-1.0),white,4.0,0.2,0.6) >>>
    changed := spot.transformed(transform) >>>
    assert(changed.radius()==4.0 && near(changed.direction().z,-1.0) && changed.inner_cosine()==spot.inner_cosine())
    $sources := [point]
    environment := lights.environment(zero,white,1.0,~sources) >>>
    sources[0]=directional
    assert((environment.source(0) >>>).kind()==lights.POINT)
    assert((lights.environment(zero,white,1.0,[]lights.Light3D{}) >>>).source_count()==0)
    for i in 0:lights.MAX_SOURCES { sources.push(point) }
    assert(bad_environment(sources))
    $tree := scene.new_scene_tree_3d("World",512) >>>
    $world := scene_lights.new_scene_lights_3d()
    parent := tree.add_child_3d(tree.root(),"Parent") >>>
    tree.set_position_3d(parent,fm.vec3(10.0,20.0,30.0)) >>>
    node := tree.add_child_3d(parent,"Point") >>>
    tree.set_position_3d(node,fm.vec3(1.0,0.0,0.0)) >>>
    world.attach(&tree,node,point) >>>
    collected := world.gather(&tree) >>>
    assert(collected.len==1 && collected[0].position().x==12.0 && collected[0].position().y==22.0)
    assert(bad_attach($&world,&tree,node,lights.Light3D{}) && world.binding_count()==1)
    node2d := tree.add_child(tree.root(),"TwoD") >>>
    assert(bad_attach($&world,&tree,node2d,point))
    tree.set_visible(parent,false) >>>
    assert((world.gather(&tree) >>>).len==0)
    tree.set_visible(parent,true) >>>
    tree.paused=true
    assert((world.gather(&tree) >>>).len==1)
    tree.queue_free(node) >>>
    assert((world.gather(&tree) >>>).len==0 && (world.prune(&tree) >>>)==1)
    tree.flush_free() >>>
    replacement := tree.add_child_3d(parent,"Replacement") >>>
    assert(replacement!=node && (world.gather(&tree) >>>).len==0)
    world.attach(&tree,replacement,directional) >>>
    tree.set_transform_3d(replacement,fm.scale_3d(zero)) >>>
    assert(bad_gather(&world,&tree))
    tree.set_visible(replacement,false) >>>
    assert((world.gather(&tree) >>>).len==0)
    assert((world.detach(replacement) >>>)==1 && (world.detach(replacement) >>>)==0)
    $nodes := []int{}
    for i in 0:257 { nodes.push(tree.add_child_3d(tree.root(),"Light"+str(i)) >>>) }
    // Reverse attachment still gathers in stable scene order.
    for i in 0:257 { index := 256-i
        value := lights.point(fm.vec3(f64(index),0.0,0.0),white,1.0) >>>
        world.attach(&tree,nodes[index],value) >>> }
    assert(bad_gather(&world,&tree) && world.binding_count()==257)
    last := nodes[256]
    tree.set_visible(last,false) >>>
    ordered := world.gather(&tree) >>>
    assert(ordered.len==256 && ordered[0].position().x==0.0 && ordered[255].position().x==255.0)
    println("PASS: immutable light descriptions, cone/radius/finite bounds, affine transforms, scene visibility/pause/deletion/order and atomic 256-candidate budget without GPU/native code")
    << 0
}
fn main() int { << run() >>> (err){ eprintln(err.msg())
    << 1 } }
