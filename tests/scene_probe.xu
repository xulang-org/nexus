@main
#unicode/utf8
r #"github.com/xulang-org/nexus/resources/scene"

fn main() int {
    x := "World"
    println(utf8.valid(&x))
    n := r.node(-1, "World", r.NODE_3D)
    println(n.name)
    d := r.make_document([n]) or (e) { println(e.msg())
        << 1 }
    println(d.node_count())
    << 0
}
