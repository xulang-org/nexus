@main

#gpu
#math
#errors
#window
fm #"github.com/xulang-org/nexus/foundation/math"
mesh #"github.com/xulang-org/nexus/resources/mesh"
lights #"github.com/xulang-org/nexus/resources/lighting"
nexus #"github.com/xulang-org/nexus/scene"
ren #"github.com/xulang-org/nexus/rendering/three_d"
shd #"github.com/xulang-org/nexus/assets/shaders/three_d"
modern #"github.com/xulang-org/nexus/integration/rendering/three_d"

fn ch_r(c int) int { << (c >> 24) & 255 }
fn ch_g(c int) int { << (c >> 16) & 255 }
fn ch_b(c int) int { << (c >> 8) & 255 }
fn luma(c int) int { << ch_r(c) + ch_g(c) + ch_b(c) }

fn make_box_mesh(hx f64, hy f64, hz f64) mesh.MeshData3D {
    $d := mesh.new_mesh_data_3d()
    white := (255 << 24) | (255 << 16) | (255 << 8) | 255
    p0 := fm.vec3(-hx, -hy, hz)
    p1 := fm.vec3(hx, -hy, hz)
    p2 := fm.vec3(hx, hy, hz)
    p3 := fm.vec3(-hx, hy, hz)
    p4 := fm.vec3(-hx, -hy, -hz)
    p5 := fm.vec3(hx, -hy, -hz)
    p6 := fm.vec3(hx, hy, -hz)
    p7 := fm.vec3(-hx, hy, -hz)

    nf := fm.vec3(0.0, 0.0, 1.0)
    nb := fm.vec3(0.0, 0.0, -1.0)
    nr := fm.vec3(1.0, 0.0, 0.0)
    nl := fm.vec3(-1.0, 0.0, 0.0)
    nu := fm.vec3(0.0, 1.0, 0.0)
    nd := fm.vec3(0.0, -1.0, 0.0)

    faces := [p0, p1, p2, p3, nf, p5, p4, p7, p6, nb, p1, p5, p6, p2, nr, p4, p0, p3, p7, nl, p3, p2, p6, p7, nu, p4, p5, p1, p0, nd]
    for f in 0:6 {
        base := d.vertices.len
        fi := f * 5
        n := faces[fi + 4]
        pts := [faces[fi], faces[fi + 1], faces[fi + 2], faces[fi + 3]]
        uvs := [fm.vec2(0.0, 0.0), fm.vec2(1.0, 0.0), fm.vec2(1.0, 1.0), fm.vec2(0.0, 1.0)]
        for k in 0:4 {
            d.vertices.push(mesh.Vertex3D{
                position: pts[k],
                color: white,
                normal: n,
                uv: uvs[k],
                tangent: fm.vec4(0.0, 0.0, 0.0, 0.0),
                has_uv: true,
                has_tangent: false
            })
        }
        d.triangle(base, base + 1, base + 2) >>>
        d.triangle(base, base + 2, base + 3) >>>
    }
    d.validate() >>>
    << d
}

fn add_cornell_box_to_scene(
    scene $&ren.DdgiScene3D,
    left_mat &ren.Material3D,
    right_mat &ren.Material3D,
    white_mat &ren.Material3D,
    ceil_emissive &ren.Material3D
) int {
    slab_x := make_box_mesh(0.2, 2.2, 3.2) >>>
    slab_y := make_box_mesh(3.2, 0.2, 3.2) >>>
    slab_z := make_box_mesh(3.2, 2.2, 0.2) >>>
    lamp := make_box_mesh(1.0, 0.08, 1.0) >>>
    cube := make_box_mesh(0.65, 0.65, 0.65) >>>

    scene.clear()
    // Left wall at x = -3.0 (inner face at x = -2.8)
    _ := scene.add_mesh(&slab_x, fm.translation_3d(fm.vec3(-3.0, 2.0, 0.0)), left_mat) >>>
    // Right wall at x = +3.0 (inner face at x = +2.8)
    _ := scene.add_mesh(&slab_x, fm.translation_3d(fm.vec3(3.0, 2.0, 0.0)), right_mat) >>>
    // Floor at y = -0.2 (inner face at y = 0.0)
    _ := scene.add_mesh(&slab_y, fm.translation_3d(fm.vec3(0.0, -0.2, 0.0)), white_mat) >>>
    // Ceiling at y = 4.2 (inner face at y = 4.0)
    _ := scene.add_mesh(&slab_y, fm.translation_3d(fm.vec3(0.0, 4.2, 0.0)), white_mat) >>>
    // Back wall at z = -3.0 (inner face at z = -2.8)
    _ := scene.add_mesh(&slab_z, fm.translation_3d(fm.vec3(0.0, 2.0, -3.0)), white_mat) >>>
    // Front closing wall at z = +3.0
    _ := scene.add_mesh(&slab_z, fm.translation_3d(fm.vec3(0.0, 2.0, 3.0)), white_mat) >>>
    // Bright ceiling emitter panel at y = 3.92
    _ := scene.add_mesh(&lamp, fm.translation_3d(fm.vec3(0.0, 3.92, 0.0)), ceil_emissive) >>>
    // Central white cube on floor
    _ := scene.add_mesh(&cube, fm.translation_3d(fm.vec3(0.0, 0.65, 0.0)), white_mat) >>>
    << scene.triangle_count()
}

fn run_checks() int {
    w := 256
    h := 256
    aspect := f64(w) / f64(h)
    z_near := 0.25
    z_far := 64.0

    prog := shd.load_mesh("build/mesh-shaders") >>>
    cprog := shd.load_clustered_program("build/mesh-shaders") >>>
    iprog := shd.load_indirect_program("build/mesh-shaders") >>>
    pprog := shd.load_postprocess_program("build/mesh-shaders") >>>
    vprog := shd.load_particle_program("build/mesh-shaders") >>>
    ddgi_prog := shd.load_ddgi_program("build/mesh-shaders") >>>

    win_opts := window.Options{
        title: "DDGI GI GPU Checks",
        width: w,
        height: h,
        resizable: false,
        high_pixel_density: false,
        hidden: true
    }
    $device := ren.open_3d_window(win_opts, gpu.METAL, &prog) >>>
    $mp := modern.new_modern_pipeline_3d(&device, &cprog, &iprog, &pprog) >>>
    empty_tq := ren.new_transparent_queue_3d()
    $empty_ps := device.gpu_particle_system(&vprog, 1, 1) >>>

    $pp_cfg := ren.post_process_defaults_3d()
    pp_cfg.ao_enabled = false
    pp_cfg.ssr_enabled = false
    pp_cfg.bloom_enabled = false
    pp_cfg.taa_enabled = false

    // =========================================================================
    // CHECK 1: Cornell-Box Color Bleeding (Real-Time BVH Ray-Traced Bounce)
    // =========================================================================
    $cfg := ren.default_ddgi_config_3d(fm.vec3(-2.0, 0.8, -1.6), fm.vec3(2.0, 1.4, 1.6), 3, 2, 3) >>>
    cfg.hysteresis = 0.78
    cfg.rays_per_probe = 64
    cfg.bounce_scale = 0.75
    cfg.sky_radiance = fm.vec3(0.0, 0.0, 0.0)
    cfg.ground_radiance = fm.vec3(0.0, 0.0, 0.0)

    $ddgi := device.ddgi_volume(&ddgi_prog, &cfg) >>>

    red_mat := ren.material_3d(fm.vec3(0.95, 0.05, 0.05), 0.0, 0.85, fm.vec3(0.0, 0.0, 0.0)) >>>
    green_mat := ren.material_3d(fm.vec3(0.05, 0.92, 0.08), 0.0, 0.85, fm.vec3(0.0, 0.0, 0.0)) >>>
    white_mat := ren.material_3d(fm.vec3(0.88, 0.88, 0.88), 0.0, 0.85, fm.vec3(0.0, 0.0, 0.0)) >>>
    ceil_light_mat := ren.material_3d(fm.vec3(1.0, 1.0, 1.0), 0.0, 0.9, fm.vec3(6.5, 6.5, 6.5)) >>>

    $cornell := ren.new_ddgi_scene_3d()
    cornell_tris := add_cornell_box_to_scene($&cornell, &red_mat, &green_mat, &white_mat, &ceil_light_mat) >>>
    _ := ddgi.upload_scene(&device, &cornell) >>>

    eye := fm.vec3(0.0, 1.8, 2.3)
    view := nexus.look_at_3d(eye, fm.vec3(0.0, 1.1, 0.0), fm.vec3(0.0, 1.0, 0.0)) >>>
    proj := nexus.perspective_3d(0.95, aspect, z_near, z_far) >>>

    room_light := lights.point(fm.vec3(0.0, 3.2, 0.0), fm.vec3(24.0, 24.0, 24.0), 9.0) >>>
    room_lights := [room_light]
    mp.prepare_lights(&device, fm.vec3(0.0, 0.0, 0.0), eye, 1.0, &room_lights, view, proj, z_near, z_far) >>>

    for _ in 0:16 {
        _ := mp.update_ddgi(&device, $&ddgi) >>>
    }

    p_left := ddgi.readback_probe(&device, 0, 0, 1) >>>  // at x=-2.0 (near red wall)
    p_right := ddgi.readback_probe(&device, 2, 0, 1) >>> // at x=+2.0 (near green wall)
    if p_left.validity < 0.5 || p_right.validity < 0.5 {
        >> errors.new("DDGI Check 1 failed: valid interior probes marked invalid")
    }
    if p_left.dc.x <= p_left.dc.z * 1.45 {
        >> errors.new("DDGI Check 1 failed: left probe did not accumulate strong red bounce from red wall")
    }
    if p_right.dc.y <= p_right.dc.z * 1.35 {
        >> errors.new("DDGI Check 1 failed: right probe did not accumulate strong green bounce from green wall")
    }
    irr_from_left := p_left.eval_irradiance(fm.vec3(-1.0, 0.0, 0.0))
    irr_from_opp := p_left.eval_irradiance(fm.vec3(1.0, 0.0, 0.0))
    redness_left := irr_from_left.x - irr_from_left.z
    redness_opp := irr_from_opp.x - irr_from_opp.z
    if redness_left <= redness_opp * 1.15 || redness_left <= 0.1 {
        >> errors.new("DDGI Check 1 failed: directional L1 SH redness does not face red wall (left=" +
            str(int(irr_from_left.x * 100.0)) + "," + str(int(irr_from_left.z * 100.0)) +
            " opp=" + str(int(irr_from_opp.x * 100.0)) + "," + str(int(irr_from_opp.z * 100.0)) + ")")
    }

    // Render central white cube illuminated ONLY by DDGI (no direct lights, 0 ambient) via draw_clustered_ddgi.
    cube_cpu := make_box_mesh(0.65, 0.65, 0.65) >>>
    $cube_gpu := device.upload(&cube_cpu) >>>
    eye_c1 := fm.vec3(-2.5, 0.9, 0.1)
    view_c1 := nexus.look_at_3d(eye_c1, fm.vec3(-1.0, 0.9, 0.0), fm.vec3(0.0, 1.0, 0.0)) >>>
    no_lights := []lights.Light3D{}
    mp.prepare_lights(&device, fm.vec3(0.0, 0.0, 0.0), eye_c1, 1.0, &no_lights, view_c1, proj, z_near, z_far) >>>

    c_refs := [cube_gpu.reference()]
    c_worlds := [fm.translation_3d(fm.vec3(-1.0, 0.9, 0.0))]
    c_mats := [white_mat]
    mp.render_unified_ddgi_frame(
        $&device, &c_refs, &c_worlds, &c_mats,
        $&ddgi, false, false, false, 1.0, fm.vec3(1.0, 1.0, 1.0),
        false, &empty_tq, false, &empty_ps,
        eye_c1, view_c1, proj, z_near, z_far, 255, &pp_cfg
    ) >>>
    px_bleed := device.read_pixel(w / 2, h / 2) >>>
    device.present() >>>
    if ch_r(px_bleed) <= ch_b(px_bleed) + 20 {
        >> errors.new("DDGI Check 1 failed: rendered white cube did not receive red color bleeding (rgb=" +
            str(ch_r(px_bleed)) + "," + str(ch_g(px_bleed)) + "," + str(ch_b(px_bleed)) + ")")
    }

    // =========================================================================
    // CHECK 2: Dynamic Emissive Relighting & Temporal Hysteresis Convergence
    // =========================================================================
    cyan_emit := ren.material_3d(fm.vec3(0.1, 0.9, 0.9), 0.0, 0.85, fm.vec3(0.0, 4.5, 6.0)) >>>
    _ := add_cornell_box_to_scene($&cornell, &cyan_emit, &green_mat, &white_mat, &ceil_light_mat) >>>
    // Upload updated scene WITHOUT resetting probe history to verify temporal tracking!
    _ := ddgi.upload_scene(&device, &cornell) >>>
    mp.prepare_lights(&device, fm.vec3(0.0, 0.0, 0.0), eye, 1.0, &room_lights, view, proj, z_near, z_far) >>>

    for _ in 0:22 {
        _ := mp.update_ddgi(&device, $&ddgi) >>>
    }
    p_dyn := ddgi.readback_probe(&device, 0, 0, 1) >>>
    if p_dyn.dc.z <= p_dyn.dc.x * 1.4 || p_dyn.dc.y <= p_dyn.dc.x * 1.4 {
        >> errors.new("DDGI Check 2 failed: probe did not dynamically converge from red to cyan")
    }

    // =========================================================================
    // CHECK 3: Recursive Multi-Bounce Second-Order GI Gain
    // =========================================================================
    neutral_wall := ren.material_3d(fm.vec3(0.85, 0.85, 0.85), 0.0, 0.85, fm.vec3(0.0, 0.0, 0.0)) >>>
    _ := add_cornell_box_to_scene($&cornell, &neutral_wall, &neutral_wall, &white_mat, &ceil_light_mat) >>>
    _ := ddgi.upload_scene(&device, &cornell) >>>

    // Pass A: single-bounce (bounce_scale = 0.0)
    $cfg_1b := cfg
    cfg_1b.bounce_scale = 0.0
    cfg_1b.hysteresis = 0.72
    ddgi.set_config(&cfg_1b) >>>
    ddgi.reset_history(&device) >>>
    for _ in 0:12 {
        _ := mp.update_ddgi(&device, $&ddgi) >>>
    }
    p_1b := ddgi.readback_probe(&device, 0, 0, 1) >>>
    luma_1b := p_1b.dc.x + p_1b.dc.y + p_1b.dc.z

    // Pass B: multi-bounce (bounce_scale = 0.85)
    $cfg_mb := cfg
    cfg_mb.bounce_scale = 0.85
    cfg_mb.hysteresis = 0.72
    ddgi.set_config(&cfg_mb) >>>
    ddgi.reset_history(&device) >>>
    for _ in 0:16 {
        _ := mp.update_ddgi(&device, $&ddgi) >>>
    }
    p_mb := ddgi.readback_probe(&device, 0, 0, 1) >>>
    luma_mb := p_mb.dc.x + p_mb.dc.y + p_mb.dc.z

    if p_1b.validity < 0.5 || p_mb.validity < 0.5 || luma_mb <= luma_1b * 1.15 {
        >> errors.new("DDGI Check 3 failed: multi-bounce did not increase indirect irradiance over single-bounce (1b=" +
            str(int(luma_1b * 100.0)) + " mb=" + str(int(luma_mb * 100.0)) + ")")
    }

    // =========================================================================
    // CHECK 4: Chebyshev Octahedral Visibility Anti-Light-Leak Across Thin Wall
    // =========================================================================
    $wall_cfg := ren.default_ddgi_config_3d(fm.vec3(-3.0, 0.8, -2.0), fm.vec3(2.0, 1.5, 2.0), 4, 2, 3) >>>
    wall_cfg.hysteresis = 0.75
    wall_cfg.rays_per_probe = 96
    wall_cfg.bounce_scale = 0.45
    wall_cfg.max_probe_distance = 6.0
    wall_cfg.depth_sharpness = 48.0
    wall_cfg.normal_bias = 0.12
    wall_cfg.view_bias = 0.08
    wall_cfg.sky_radiance = fm.vec3(0.0, 0.0, 0.0)
    wall_cfg.ground_radiance = fm.vec3(0.0, 0.0, 0.0)

    $ddgi_wall := device.ddgi_volume(&ddgi_prog, &wall_cfg) >>>
    $two_rooms := ren.new_ddgi_scene_3d()

    wide_floor := make_box_mesh(4.5, 0.2, 3.5) >>>
    wide_ceil := make_box_mesh(4.5, 0.2, 3.5) >>>
    end_wall := make_box_mesh(0.2, 2.0, 3.5) >>>
    side_wall := make_box_mesh(4.5, 2.0, 0.2) >>>
    divider := make_box_mesh(0.25, 2.0, 3.5) >>>
    lit_panel := make_box_mesh(0.08, 1.4, 2.4) >>>

    bright_emit := ren.material_3d(fm.vec3(0.9, 0.9, 0.9), 0.0, 0.85, fm.vec3(8.5, 7.5, 6.0)) >>>
    dark_room_mat := ren.material_3d(fm.vec3(0.75, 0.75, 0.75), 0.0, 0.90, fm.vec3(0.0, 0.0, 0.0)) >>>

    // Enclose both rooms cleanly (x in [-4.5, +4.5], y in [0, 3.6], z in [-3.5, +3.5])
    _ := two_rooms.add_mesh(&wide_floor, fm.translation_3d(fm.vec3(0.0, -0.2, 0.0)), &dark_room_mat) >>>
    _ := two_rooms.add_mesh(&wide_ceil, fm.translation_3d(fm.vec3(0.0, 3.8, 0.0)), &dark_room_mat) >>>
    _ := two_rooms.add_mesh(&end_wall, fm.translation_3d(fm.vec3(-4.5, 1.8, 0.0)), &dark_room_mat) >>>
    _ := two_rooms.add_mesh(&end_wall, fm.translation_3d(fm.vec3(4.5, 1.8, 0.0)), &dark_room_mat) >>>
    _ := two_rooms.add_mesh(&side_wall, fm.translation_3d(fm.vec3(0.0, 1.8, -3.5)), &dark_room_mat) >>>
    _ := two_rooms.add_mesh(&side_wall, fm.translation_3d(fm.vec3(0.0, 1.8, 3.5)), &dark_room_mat) >>>
    // Opaque divider wall at x in [-0.25, +0.25]
    _ := two_rooms.add_mesh(&divider, fm.translation_3d(fm.vec3(0.0, 1.8, 0.0)), &dark_room_mat) >>>
    // Bright emissive wall panel inside the lit room (x = -3.8)
    _ := two_rooms.add_mesh(&lit_panel, fm.translation_3d(fm.vec3(-3.8, 1.6, 0.0)), &bright_emit) >>>
    _ := ddgi_wall.upload_scene(&device, &two_rooms) >>>

    // Point light strictly inside the lit room with radius 1.75 (never crosses x = -0.25 in raster)
    lit_pt := lights.point(fm.vec3(-2.0, 1.8, 0.0), fm.vec3(18.0, 16.0, 12.0), 1.75) >>>
    lit_list := [lit_pt]

    // Floor & divider GPU meshes for camera inspection
    $floor_gpu := device.upload(&wide_floor) >>>
    $div_gpu := device.upload(&divider) >>>
    $panel_gpu := device.upload(&lit_panel) >>>
    room_refs := [floor_gpu.reference(), div_gpu.reference(), panel_gpu.reference()]
    room_worlds := [fm.translation_3d(fm.vec3(0.0, -0.2, 0.0)), fm.translation_3d(fm.vec3(0.0, 1.8, 0.0)), fm.translation_3d(fm.vec3(-3.8, 1.6, 0.0))]
    room_mats := [dark_room_mat, dark_room_mat, bright_emit]

    eye_dark := fm.vec3(0.65, 1.2, 1.6)
    view_dark := nexus.look_at_3d(eye_dark, fm.vec3(0.60, 0.0, 0.0), fm.vec3(0.0, 1.0, 0.0)) >>>
    mp.prepare_lights(&device, fm.vec3(0.0, 0.0, 0.0), eye_dark, 1.0, &lit_list, view_dark, proj, z_near, z_far) >>>

    for _ in 0:18 {
        _ := mp.update_ddgi(&device, $&ddgi_wall) >>>
    }

    p_lit_side := ddgi_wall.readback_probe(&device, 1, 0, 1) >>>  // x = -1.0
    p_dark_side := ddgi_wall.readback_probe(&device, 2, 0, 1) >>> // x = +1.0
    if p_lit_side.dc.x <= p_dark_side.dc.x * 5.0 {
        >> errors.new("DDGI Check 4 failed: lit probe vs dark probe separation too weak")
    }
    vis_m := ddgi_wall.readback_vis_moments(&device, 1, 0, 1) >>>
    $min_vis_dist := 999.0
    for m in vis_m {
        if m.x < min_vis_dist { min_vis_dist = m.x }
    }
    if min_vis_dist >= 2.0 {
        >> errors.new("DDGI Check 4 failed: lit probe octahedral visibility did not record divider wall distance")
    }

    // Naive trilinear (use_chebyshev = false) on dark room floor near wall: expect bright leak!
    mp.render_unified_ddgi_frame(
        $&device, &room_refs, &room_worlds, &room_mats,
        $&ddgi_wall, false, true, false, 1.4, fm.vec3(0.75, 0.75, 0.75),
        false, &empty_tq, false, &empty_ps,
        eye_dark, view_dark, proj, z_near, z_far, 255, &pp_cfg
    ) >>>
    px_leak := device.read_pixel(w / 2, h / 2) >>>
    device.present() >>>

    // Chebyshev octahedral visibility (use_chebyshev = true) on same dark floor: leak suppressed!
    mp.render_unified_ddgi_frame(
        $&device, &room_refs, &room_worlds, &room_mats,
        $&ddgi_wall, false, true, true, 1.4, fm.vec3(0.75, 0.75, 0.75),
        false, &empty_tq, false, &empty_ps,
        eye_dark, view_dark, proj, z_near, z_far, 255, &pp_cfg
    ) >>>
    px_cheb := device.read_pixel(w / 2, h / 2) >>>
    device.present() >>>

    leak_luma := luma(px_leak)
    cheb_luma := luma(px_cheb)
    if leak_luma < 45 {
        >> errors.new("DDGI Check 4 setup error: expected naive trilinear pass to exhibit visible wall leak (leak=" +
            str(leak_luma) + " cheb=" + str(cheb_luma) + ")")
    }
    if cheb_luma * 4 >= leak_luma {
        >> errors.new("DDGI Check 4 failed: Chebyshev octahedral visibility did not suppress wall light leak by >=4x (leak=" +
            str(leak_luma) + " cheb=" + str(cheb_luma) + ")")
    }

    // Confirm lit room remains brightly lit with Chebyshev enabled!
    eye_lit := fm.vec3(-1.3, 1.2, 1.6)
    view_lit := nexus.look_at_3d(eye_lit, fm.vec3(-1.2, 0.0, 0.0), fm.vec3(0.0, 1.0, 0.0)) >>>
    mp.prepare_lights(&device, fm.vec3(0.0, 0.0, 0.0), eye_lit, 1.0, &lit_list, view_lit, proj, z_near, z_far) >>>
    mp.render_unified_ddgi_frame(
        $&device, &room_refs, &room_worlds, &room_mats,
        $&ddgi_wall, false, true, true, 1.4, fm.vec3(0.75, 0.75, 0.75),
        false, &empty_tq, false, &empty_ps,
        eye_lit, view_lit, proj, z_near, z_far, 255, &pp_cfg
    ) >>>
    px_lit_ok := device.read_pixel(w / 2, h / 2) >>>
    device.present() >>>
    if luma(px_lit_ok) < 120 {
        >> errors.new("DDGI Check 4 failed: lit room dimmed under Chebyshev DDGI")
    }

    // =========================================================================
    // CHECK 5: Backface Detection Invalidates Buried Probe
    // =========================================================================
    $bury_cfg := ren.default_ddgi_config_3d(fm.vec3(0.0, 1.0, 0.0), fm.vec3(2.0, 2.0, 2.0), 2, 1, 1) >>>
    bury_cfg.rays_per_probe = 64
    bury_cfg.backface_threshold = 0.25
    $ddgi_bury := device.ddgi_volume(&ddgi_prog, &bury_cfg) >>>
    $bury_scene := ren.new_ddgi_scene_3d()
    solid_block := make_box_mesh(0.6, 0.6, 0.6) >>>
    // Enclose probe 0 at (0, 1, 0); probe 1 at (2, 1, 0) stays outside!
    _ := bury_scene.add_mesh(&solid_block, fm.translation_3d(fm.vec3(0.0, 1.0, 0.0)), &white_mat) >>>
    _ := ddgi_bury.upload_scene(&device, &bury_scene) >>>
    _ := mp.update_ddgi(&device, $&ddgi_bury) >>>

    pb_in := ddgi_bury.readback_probe(&device, 0, 0, 0) >>>
    pb_out := ddgi_bury.readback_probe(&device, 1, 0, 0) >>>
    if pb_in.validity > 0.5 || pb_out.validity < 0.5 {
        >> errors.new("DDGI Check 5 failed: buried probe should have validity=0 while open probe has validity=1")
    }

    println("PASS: Real-Time DDGI GPU GI (cornell_tris=" + str(cornell_tris) +
        ", red_bleed=" + str(ch_r(px_bleed)) + ">" + str(ch_b(px_bleed)) +
        ", 1b->mb=" + str(int(luma_1b * 100.0)) + "->" + str(int(luma_mb * 100.0)) +
        ", wall_leak_luma=" + str(leak_luma) + "->cheb=" + str(cheb_luma) +
        ", lit_room=" + str(luma(px_lit_ok)) +
        ", buried_val=" + str(int(pb_in.validity)) + ")")

    ddgi_bury.close() >>>
    ddgi_wall.close() >>>
    ddgi.close() >>>
    panel_gpu.close() >>>
    div_gpu.close() >>>
    floor_gpu.close() >>>
    cube_gpu.close() >>>
    empty_ps.close() >>>
    mp.close() >>>
    device.close() >>>
    << 0
}

fn main() int {
    run_checks() >>> (err) {
        println("FAIL: " + err.msg())
        << 1
    }
    << 0
}
