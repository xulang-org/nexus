@main

// Verifies nexus/integration/ui InputBridge, UiFrame, #ui/widgets rendering,
// XDF1 replay, error contracts, and 3D + Overlay2D compositing across GPU,
// CPU software RGBA8, and headless fallback modes.

#encoding/binary
#errors
#gpu
#math
#os
#strings
#time
#ui
#ui/draw
#ui/layout
phone #ui/phone
widgets #ui/widgets
#window
wev #window/events
fm #"github.com/xulang-org/nexus/foundation/math"
ui_bridge #"github.com/xulang-org/nexus/integration/ui"
scene_render #"github.com/xulang-org/nexus/integration/rendering/three_d"
lights #"github.com/xulang-org/nexus/resources/lighting"
meshes #"github.com/xulang-org/nexus/resources/mesh"
platform_present #"github.com/xulang-org/nexus/platform/present"
ren2 #"github.com/xulang-org/nexus/rendering/two_d"
ren3 #"github.com/xulang-org/nexus/rendering/three_d"
scene #"github.com/xulang-org/nexus/scene"
shaders2 #"github.com/xulang-org/nexus/assets/shaders/two_d"
shaders3 #"github.com/xulang-org/nexus/assets/shaders/three_d"

const PX_BG = 269754367 // 0x10141FFF
const PX_PANEL = 404498431 // 0x181C27FF

fn check(cond bool, msg string) int {
    if !cond { >> errors.new("ui hud check failed: " + msg) }
    << 0
}

fn px_r(c int) int { << (c >> 24) & 255 }
fn px_g(c int) int { << (c >> 16) & 255 }
fn px_b(c int) int { << (c >> 8) & 255 }
fn px_a(c int) int { << c & 255 }

fn rejects_pop_clip(f $&ui_bridge.UiFrame) bool {
    _ := f.pop_clip() >>> (err) { << true }
    << false
}

fn rejects_push_clip(f $&ui_bridge.UiFrame, r layout.Rect) bool {
    _ := f.push_clip(&r) >>> (err) { << true }
    << false
}

fn rejects_draw_panel(f $&ui_bridge.UiFrame) bool {
    r := layout.Rect{x: 0.0, y: 0.0, width: 20.0, height: 20.0}
    _ := f.draw_panel(&r, 4.0, draw.rgb(40, 40, 40), draw.rgb(80, 80, 80), 1.0) >>> (err) { << true }
    << false
}

fn rejects_flush_2d(f $&ui_bridge.UiFrame, r $&ren2.Renderer2D, m $&ren2.MaskTexture2D) bool {
    _ := f.flush_2d(r, m) >>> (err) { << true }
    << false
}

fn rejects_replay_xdf(f $&ui_bridge.UiFrame, blob &string, vp &layout.Rect) bool {
    _ := f.replay_xdf(blob, vp) >>> (err) { << true }
    << false
}

fn make_op22_xdf() string {
    $buf := []u8{}
    for _ in 0:40 { buf.push(u8(0)) }
    buf[0] = u8(88)  // 'X'
    buf[1] = u8(68)  // 'D'
    buf[2] = u8(70)  // 'F'
    buf[3] = u8(49)  // '1'
    le := binary.little_endian()
    le.put_u32_bytes($&buf, 4, 1) >>>
    le.put_u32_bytes($&buf, 8, 40) >>>
    le.put_u32_bytes($&buf, 12, 1) >>>
    buf[32] = u8(22) // XDF_OP_IMAGE (host-owned)
    buf[33] = u8(0)
    le.put_u32_bytes($&buf, 36, 8) >>>
    $sb := strings.new_byte_builder(40)
    for b in buf { sb.write_byte(int(b)) }
    << sb.to_string()
}

fn make_wev(kind int) wev.Event {
    $ev := wev.empty()
    ev.kind = kind
    ev.window_id = 1
    ev.timestamp_ns = 1000000
    << ev
}

fn test_input_bridge() int {
    $bridge := ui_bridge.default_input_bridge()
    id := bridge.canvas_identity()
    check(id.window_id == 1 && id.canvas_id == 1 && id.generation == 1, "default identity") >>>

    // Mouse RIGHT/MIDDLE button and bitmask swap + modifiers.
    $ev_r := make_wev(wev.EVENT_POINTER_DOWN)
    ev_r.button = wev.BUTTON_RIGHT
    ev_r.buttons = 4 // wev right bit
    ev_r.x = 24.0
    ev_r.y = 40.0
    ev_r.modifiers = wev.MOD_LEFT_SHIFT | wev.MOD_LEFT_CTRL
    ui_r := bridge.translate(&ev_r)
    check(ui_bridge.is_ui_input(&ui_r), "right down is UI input") >>>
    check(ui_r.kind == ui.EV_POINTER_DOWN, "right down kind") >>>
    check(ui_r.button == ui.BUTTON_RIGHT, "right button mapped") >>>
    check(ui_r.buttons == 2, "right bitmask swapped to ui bit 2") >>>
    check(ui_r.modifiers == (ui.MOD_SHIFT | ui.MOD_CONTROL), "shift+ctrl mod") >>>

    $ev_md := make_wev(wev.EVENT_POINTER_DOWN)
    ev_md.button = wev.BUTTON_MIDDLE
    ev_md.buttons = 2 // wev middle bit
    ui_md := bridge.translate(&ev_md)
    check(ui_md.kind == ui.EV_POINTER_DOWN && ui_md.button == ui.BUTTON_MIDDLE, "middle down") >>>
    check(ui_md.buttons == 4, "middle bitmask swapped to ui bit 4") >>>

    $ev_m := make_wev(wev.EVENT_POINTER_MOVE)
    ev_m.buttons = 2 // wev middle bit during drag
    ui_m := bridge.translate(&ev_m)
    check(ui_m.kind == ui.EV_POINTER_MOVE && ui_m.buttons == 4, "move preserves swapped buttons mask") >>>

    $ev_mu := make_wev(wev.EVENT_POINTER_UP)
    ev_mu.button = wev.BUTTON_MIDDLE
    ev_mu.buttons = 0
    ui_mu := bridge.translate(&ev_mu)
    check(ui_mu.kind == ui.EV_POINTER_UP && ui_mu.button == ui.BUTTON_MIDDLE && ui_mu.buttons == 0, "middle up") >>>

    // Wheel scroll.
    $ev_w := make_wev(wev.EVENT_WHEEL)
    ev_w.x = 50.0
    ev_w.y = 60.0
    ev_w.dx = 2.5
    ev_w.dy = -3.5
    ui_w := bridge.translate(&ev_w)
    check(ui_w.kind == ui.EV_POINTER_SCROLL && ui_w.dx == 2.5 && ui_w.dy == -3.5, "wheel scroll") >>>

    // Keyboard special keys + uppercase ASCII.
    keys := [wev.KEY_TAB, wev.KEY_ENTER, wev.KEY_ESCAPE, wev.KEY_LEFT, wev.KEY_RIGHT, wev.KEY_UP, wev.KEY_DOWN]
    ui_keys := [ui.KEY_TAB, ui.KEY_ENTER, ui.KEY_ESCAPE, ui.KEY_LEFT, ui.KEY_RIGHT, ui.KEY_UP, ui.KEY_DOWN]
    for ki in 0:keys.len {
        $kev := make_wev(wev.EVENT_KEY_DOWN)
        kev.physical_key = keys[ki]
        uk := bridge.translate(&kev)
        check(uk.kind == ui.EV_KEY_DOWN && uk.key == ui_keys[ki], "special key map") >>>
    }
    $ka := make_wev(wev.EVENT_KEY_DOWN)
    ka.physical_key = wev.KEY_A
    ka.logical_key = 97
    uka := bridge.translate(&ka)
    check(uka.kind == ui.EV_KEY_DOWN && uka.key == 65, "letter ASCII upper") >>>

    // Primary-touch tracking rejects secondary finger until primary ends or focus resets.
    $t1 := make_wev(wev.EVENT_TOUCH_DOWN)
    t1.touch_id = 101
    t1.x = 30.0
    t1.y = 40.0
    ut1 := bridge.translate(&t1)
    check(ut1.kind == ui.EV_POINTER_DOWN && ut1.button == ui.BUTTON_LEFT && ut1.buttons == 1,
        "primary touch down kind=" + str(ut1.kind) + " btn=" + str(ut1.button) + " btns=" + str(ut1.buttons)) >>>

    $t2 := make_wev(wev.EVENT_TOUCH_DOWN)
    t2.touch_id = 202
    t2.x = 90.0
    t2.y = 90.0
    check(!ui_bridge.is_ui_input(&bridge.translate(&t2)), "secondary touch down ignored") >>>

    $t2m := make_wev(wev.EVENT_TOUCH_MOVE)
    t2m.touch_id = 202
    check(!ui_bridge.is_ui_input(&bridge.translate(&t2m)), "secondary touch move ignored") >>>

    $t1m := make_wev(wev.EVENT_TOUCH_MOVE)
    t1m.touch_id = 101
    t1m.x = 35.0
    t1m.y = 45.0
    ut1m := bridge.translate(&t1m)
    check(ut1m.kind == ui.EV_POINTER_MOVE && ut1m.x == 35.0 && ut1m.buttons == 1, "primary touch move") >>>

    $fl := make_wev(wev.EVENT_FOCUS_LOST)
    ufl := bridge.translate(&fl)
    check(ufl.kind == ui.EV_POINTER_CANCEL && ufl.buttons == 0, "focus lost cancels pointer") >>>

    // After cancel, a new touch_id becomes primary.
    $t3 := make_wev(wev.EVENT_TOUCH_DOWN)
    t3.touch_id = 303
    t3.x = 12.0
    t3.y = 14.0
    check(bridge.translate(&t3).kind == ui.EV_POINTER_DOWN, "touch 303 after cancel") >>>
    $t3u := make_wev(wev.EVENT_TOUCH_UP)
    t3u.touch_id = 303
    check(bridge.translate(&t3u).kind == ui.EV_POINTER_UP, "touch 303 up") >>>

    // Interactive round-trip into #ui/widgets controls.
    $btn := widgets.button(&id, 1, &layout.Rect{x: 20.0, y: 20.0, width: 120.0, height: 36.0})
    $sw := widgets.switch_control(&id, 2, &layout.Rect{x: 20.0, y: 70.0, width: 120.0, height: 30.0}, false)
    $sli := widgets.slider(&id, 3, &layout.Rect{x: 20.0, y: 110.0, width: 140.0, height: 28.0}, 0.0, 1.0, 0.2)

    $pd := make_wev(wev.EVENT_POINTER_DOWN)
    pd.button = wev.BUTTON_LEFT
    pd.buttons = 1
    pd.x = 60.0
    pd.y = 38.0
    _ := btn.input(&bridge.translate(&pd))
    $pu := make_wev(wev.EVENT_POINTER_UP)
    pu.button = wev.BUTTON_LEFT
    pu.buttons = 0
    pu.x = 60.0
    pu.y = 38.0
    check(btn.input(&bridge.translate(&pu)).kind == widgets.ACTION_ACTIVATE, "button activate via InputBridge") >>>

    pd.y = 85.0
    pu.y = 85.0
    _ := sw.input(&bridge.translate(&pd))
    _ := sw.input(&bridge.translate(&pu))
    check(sw.value(), "switch toggled via InputBridge") >>>

    pd.x = 140.0
    pd.y = 124.0
    pu.x = 140.0
    pu.y = 124.0
    _ := sli.input(&bridge.translate(&pd))
    _ := sli.input(&bridge.translate(&pu))
    check(sli.value() > 0.6, "slider updated via InputBridge") >>>
    << 0
}

fn ui_key_down(bridge $&ui_bridge.InputBridge, pkey int) ui.InputEvent {
    $k := wev.empty()
    k.kind = wev.EVENT_KEY_DOWN
    k.physical_key = pkey
    << bridge.translate(&k)
}

fn has_non_bg_pixel(r $&ren2.Renderer2D, x0 int, y0 int, bw int, bh int, bg int) bool {
    $y := y0
    while y < y0 + bh {
        $x := x0
        while x < x0 + bw {
            px := r.read_pixel(x, y) >>> (err) { << false }
            dr := math.abs(f64(px_r(px) - px_r(bg)))
            dg := math.abs(f64(px_g(px) - px_g(bg)))
            db := math.abs(f64(px_b(px) - px_b(bg)))
            if dr + dg + db > 28.0 { << true }
            x = x + 3
        }
        y = y + 3
    }
    << false
}

fn test_hud_router_and_text_field() int {
    // Safe-area and anchor layout checks.
    safe := ui_bridge.safe_viewport(320.0, 240.0, &layout.Insets{left: 16.0, top: 20.0, right: 12.0, bottom: 24.0}) >>>
    check(safe.x == 16.0 && safe.y == 20.0 && safe.width == 292.0 && safe.height == 196.0, "safe_viewport insets") >>>
    tr := ui_bridge.anchor_rect(&safe, &layout.Size{width: 100.0, height: 40.0}, 1.0, 0.0, 8.0, 6.0) >>>
    check(math.abs(tr.x - 200.0) < 0.01 && math.abs(tr.y - 26.0) < 0.01, "anchor_rect top-right") >>>

    // HudRouter arbitration between HUD rects, nexus captures, modal, text focus, and multi-touch.
    $bridge := ui_bridge.default_input_bridge()
    $router := ui_bridge.new_hud_router()
    $hud_box := layout.Rect{x: 10.0, y: 10.0, width: 120.0, height: 100.0}
    router.add_rect(&hud_box) >>>

    $pd := wev.empty()
    pd.kind = wev.EVENT_POINTER_DOWN
    pd.button = wev.BUTTON_LEFT
    pd.buttons = 1
    pd.x = 30.0
    pd.y = 30.0
    d1 := router.route_event($&bridge, &pd)
    check(d1.to_ui && !d1.to_game && d1.owner == ui_bridge.ROUTE_UI, "ui pointer down captured by UI") >>>

    // Drag outside HUD remains owned by UI and never leaks to nexus.
    $pm := wev.empty()
    pm.kind = wev.EVENT_POINTER_MOVE
    pm.buttons = 1
    pm.x = 240.0
    pm.y = 190.0
    d2 := router.route_event($&bridge, &pm)
    check(d2.to_ui && !d2.to_game && router.mouse_capture() == ui_bridge.ROUTE_UI, "ui drag outside keeps UI capture") >>>

    $pu := wev.empty()
    pu.kind = wev.EVENT_POINTER_UP
    pu.button = wev.BUTTON_LEFT
    pu.buttons = 0
    pu.x = 240.0
    pu.y = 190.0
    d3 := router.route_event($&bridge, &pu)
    check(d3.to_ui && !d3.to_game && router.mouse_capture() == ui_bridge.ROUTE_NONE, "ui pointer up releases capture") >>>

    // Game drag starting outside HUD must NOT hover/press UI when crossing into HUD rect.
    pd.x = 220.0
    pd.y = 180.0
    d4 := router.route_event($&bridge, &pd)
    check(!d4.to_ui && d4.to_game && router.mouse_capture() == ui_bridge.ROUTE_GAME, "outside down captured by nexus") >>>
    pm.x = 40.0
    pm.y = 40.0
    d5 := router.route_event($&bridge, &pm)
    check(!d5.to_ui && d5.to_game && d5.owner == ui_bridge.ROUTE_GAME, "nexus drag entering HUD cannot steal UI") >>>
    pu.x = 40.0
    pu.y = 40.0
    d6 := router.route_event($&bridge, &pu)
    check(!d6.to_ui && d6.to_game && router.mouse_capture() == ui_bridge.ROUTE_NONE, "nexus up releases nexus capture") >>>

    // Unpressed hover enters HUD, then cleanly notifies UI once upon exit.
    pm.buttons = 0
    pm.x = 25.0
    pm.y = 25.0
    h1 := router.route_event($&bridge, &pm)
    check(h1.to_ui && !h1.to_game, "hover inside HUD blocks nexus hover") >>>
    pm.x = 200.0
    pm.y = 200.0
    h2 := router.route_event($&bridge, &pm)
    check(h2.to_ui && h2.to_game, "leaving HUD delivers single leave to UI and move to nexus") >>>
    h3 := router.route_event($&bridge, &pm)
    check(!h3.to_ui && h3.to_game, "subsequent outside move stays nexus-only") >>>

    // Simultaneous multi-touch with independent negative 64-bit touch IDs.
    $td1 := wev.empty()
    td1.kind = wev.EVENT_TOUCH_DOWN
    td1.device_id = 1
    td1.touch_id = 101
    td1.x = 50.0
    td1.y = 50.0
    t_ui := router.route_event($&bridge, &td1)
    check(t_ui.to_ui && !t_ui.to_game, "touch 101 inside HUD captured by UI") >>>

    $td2 := wev.empty()
    td2.kind = wev.EVENT_TOUCH_DOWN
    td2.device_id = 1
    td2.touch_id = -9
    td2.x = 250.0
    td2.y = 180.0
    t_gm := router.route_event($&bridge, &td2)
    check(!t_gm.to_ui && t_gm.to_game && router.active_touch_count() == 2, "touch -9 outside captured by nexus") >>>

    $tm2 := wev.empty()
    tm2.kind = wev.EVENT_TOUCH_MOVE
    tm2.device_id = 1
    tm2.touch_id = -9
    tm2.x = 45.0
    tm2.y = 45.0
    t_gm2 := router.route_event($&bridge, &tm2)
    check(!t_gm2.to_ui && t_gm2.to_game, "touch -9 crossing HUD stays nexus-owned") >>>

    $tu1 := wev.empty()
    tu1.kind = wev.EVENT_TOUCH_UP
    tu1.device_id = 1
    tu1.touch_id = 101
    tu1.x = 200.0
    tu1.y = 200.0
    _ := router.route_event($&bridge, &tu1)
    check(router.active_touch_count() == 1, "releasing touch 101 preserves nexus touch -9") >>>

    // Focus stealing for keyboard & EVENT_TEXT_INPUT.
    router.set_text_focused(true)
    $te := wev.empty()
    te.kind = wev.EVENT_TEXT_INPUT
    te.text = "Xu!"
    tk := router.route_event($&bridge, &te)
    check(tk.to_ui && !tk.to_game && tk.text == "Xu!", "focused text input routes to UI only") >>>
    router.set_text_focused(false)

    // Interactive UiTextField UTF-8 insertion, Left/Right/Home/End/Backspace/Delete/Enter/Escape.
    styles := widgets.dark_styles()
    uf := ui_bridge.new_ui_frame(&styles) >>>
    $tf := ui_bridge.new_text_field(42, &layout.Rect{x: 16.0, y: 16.0, width: 180.0, height: 34.0}, "ab", "type") >>>
    tf.set_focus(true)
    empty_ev := bridge.translate(&wev.empty())
    ins := "Xu字"
    check(tf.handle_input(&uf, &empty_ev, &ins), "UiTextField inserts UTF-8 text") >>>
    check(tf.text == "abXu字" && tf.caret == tf.text.len, "UiTextField text after UTF-8 insert") >>>

    empty_s := ""
    left_ev := ui_key_down($&bridge, wev.KEY_LEFT)
    _ := tf.handle_input(&uf, &left_ev, &empty_s)
    bk_ev := ui_key_down($&bridge, wev.KEY_BACKSPACE)
    _ := tf.handle_input(&uf, &bk_ev, &empty_s)
    check(tf.text == "abX字", "UiTextField Left + Backspace keeps UTF-8 codepoint integrity") >>>

    home_ev := ui_key_down($&bridge, wev.KEY_HOME)
    _ := tf.handle_input(&uf, &home_ev, &empty_s)
    del_ev := ui_key_down($&bridge, wev.KEY_DELETE)
    _ := tf.handle_input(&uf, &del_ev, &empty_s)
    check(tf.text == "bX字" && tf.caret == 0, "UiTextField Home + Delete") >>>

    end_ev := ui_key_down($&bridge, wev.KEY_END)
    _ := tf.handle_input(&uf, &end_ev, &empty_s)
    check(tf.caret == tf.text.len, "UiTextField End moves to byte len") >>>

    ent_ev := ui_key_down($&bridge, wev.KEY_ENTER)
    _ := tf.handle_input(&uf, &ent_ev, &empty_s)
    check(tf.clear_submitted() && !tf.clear_submitted(), "UiTextField Enter toggles submitted once") >>>
    << 0
}

fn test_styled_widgets_and_phone_xdf_2d(mode_id int, mode_tag string, canvas_prog &ren2.ShaderProgram2D,
        sdf_prog &ren2.SdfProgram2D, text_prog &ren2.TextProgram2D) int {
    w := 360
    h := 280
    styles := widgets.dark_styles()
    id := ui_bridge.default_input_bridge().canvas_identity()
    ctx := draw.default_context()

    // 1. Live integration/ui widgets: card, badge, divider, and focused UiTextField.
    $uf := ui_bridge.new_ui_frame(&styles) >>>
    left_card := widgets.card(&layout.Rect{x: 10.0, y: 10.0, width: 165.0, height: 260.0})
    mode_bg := widgets.badge(&layout.Rect{x: 20.0, y: 46.0, width: 145.0, height: 24.0})
    div := widgets.divider(&layout.Rect{x: 20.0, y: 78.0, width: 145.0, height: 6.0}, widgets.AXIS_HORIZONTAL)
    $tf := ui_bridge.new_text_field(51, &layout.Rect{x: 20.0, y: 92.0, width: 145.0, height: 34.0}, "HUD-99", "cmd") >>>
    tf.set_focus(true)

    // 2. Hostless #ui/widgets styled painting -> draw.Frame -> XDF1.
    $wframe := ctx.new_frame(4096)
    wframe.begin() >>>
    wcard := widgets.card(&layout.Rect{x: 184.0, y: 10.0, width: 166.0, height: 122.0})
    whead := "STYLED"
    $whead_lbl := widgets.styled_label(&ctx, &whead)
    wcard.paint_header_styled($&wframe, $&whead_lbl, &styles) >>>
    whead_lbl.dispose()

    $wbtn := widgets.button(&id, 11, &layout.Rect{x: 194.0, y: 46.0, width: 146.0, height: 32.0})
    wbtn_txt := "RUN"
    $wbtn_lbl := widgets.styled_label(&ctx, &wbtn_txt)
    wbtn.paint_styled($&wframe, $&wbtn_lbl, &styles) >>>
    wbtn_lbl.dispose()

    $wcb := widgets.checkbox(&id, 12, &layout.Rect{x: 194.0, y: 86.0, width: 146.0, height: 28.0}, true)
    wcb_txt := "ON"
    $wcb_lbl := widgets.styled_label(&ctx, &wcb_txt)
    wcb.paint_styled($&wframe, $&wcb_lbl, &styles) >>>
    wcb_lbl.dispose()
    widgets_xdf := wframe.export_xdf() >>>

    // 3. Hostless #ui/phone Canvas -> XDF1.
    $pc := phone.canvas(&ctx)
    th := phone.dark_theme()
    pc.begin(&th) >>>
    pc.card(layout.Rect{x: 184.0, y: 142.0, width: 166.0, height: 128.0}, &th) >>>
    pc.row(layout.Rect{x: 192.0, y: 150.0, width: 150.0, height: 40.0}, &th, "PHONE", "ACTIVE", phone.ICON_ACTIVITY, false) >>>
    pc.chip(layout.Rect{x: 194.0, y: 196.0, width: 70.0, height: 28.0}, &th, "SYNC", true, false) >>>
    pc.button(layout.Rect{x: 270.0, y: 196.0, width: 70.0, height: 30.0}, &th, "GO", true, false) >>>
    _ := pc.paragraph(layout.Rect{x: 194.0, y: 232.0, width: 146.0, height: 30.0}, "XDF1 OK", 12.0, 400, 16.0, th.ink, 0) >>>
    phone_xdf := pc.export_xdf() >>>

    $r := open_2d_for_mode(mode_id, w, h, canvas_prog, sdf_prog, text_prog) >>>
    $mask := uf.create_mask_2d(&r) >>>
    uf.begin() >>>
    lt := "HOST CARD"
    uf.card(&left_card, &lt) >>>
    bt := "MODE LIVE"
    uf.badge(&mode_bg, &bt) >>>
    uf.divider(&div) >>>
    uf.text_field(&tf) >>>
    uf.replay_xdf(&widgets_xdf, &layout.Rect{x: 184.0, y: 10.0, width: 166.0, height: 122.0}) >>>
    uf.replay_xdf(&phone_xdf, &layout.Rect{x: 184.0, y: 142.0, width: 166.0, height: 128.0}) >>>

    r.begin(PX_BG) >>>
    uf.flush_2d($&r, $&mask) >>>
    r.capture("build/ui-phone-widgets-" + mode_tag + ".png") >>>

    check(has_non_bg_pixel($&r, 24, 98, 120, 22, PX_BG), "UiTextField glyphs/caret rendered") >>>
    check(has_non_bg_pixel($&r, 198, 50, 130, 24, PX_BG), "Styled widgets Button XDF1 rendered") >>>
    check(has_non_bg_pixel($&r, 198, 198, 136, 26, PX_BG), "Phone Canvas chip/button XDF1 rendered") >>>

    r.present() >>>
    mask.close() >>>
    r.close() >>>
    << 0
}

fn test_error_contracts() int {
    styles := widgets.dark_styles()
    $f0 := ui_bridge.new_ui_frame(&styles) >>>
    check(rejects_draw_panel($&f0), "draw before begin rejected") >>>

    $f := ui_bridge.new_ui_frame(&styles) >>>
    f.begin() >>>
    check(rejects_pop_clip($&f), "empty pop_clip rejected") >>>
    check(rejects_push_clip($&f, layout.Rect{x: 0.0, y: 0.0, width: -10.0, height: 20.0}), "negative clip rejected") >>>

    // Unclosed push_clip must fail flush_2d.
    $hr := ren2.open_2d_headless(32, 32) >>>
    $hm := f.create_mask_2d(&hr) >>>
    f.push_clip(&layout.Rect{x: 0.0, y: 0.0, width: 16.0, height: 16.0}) >>>
    hr.begin(PX_BG) >>>
    check(rejects_flush_2d($&f, $&hr, $&hm), "unclosed push_clip flush rejected") >>>
    hr.present() >>>
    hm.close() >>>
    hr.close() >>>

    // Corrupt / short / host-owned XDF1 rejection.
    $fx := ui_bridge.new_ui_frame(&styles) >>>
    vp := layout.Rect{x: 0.0, y: 0.0, width: 100.0, height: 100.0}
    fx.begin() >>>
    bad_short := "XDF1"
    check(rejects_replay_xdf($&fx, &bad_short, &vp), "short XDF rejected") >>>
    bad_magic := "BAD10000000000000000000000000000"
    check(rejects_replay_xdf($&fx, &bad_magic, &vp), "bad XDF magic rejected") >>>
    op22 := make_op22_xdf() >>>
    check(rejects_replay_xdf($&fx, &op22, &vp), "host-owned XDF op 22 rejected") >>>
    << 0
}

fn open_2d_for_mode(mode_id int, w int, h int, canvas_prog &ren2.ShaderProgram2D,
    sdf_prog &ren2.SdfProgram2D, text_prog &ren2.TextProgram2D) ren2.Renderer2D {
    opts := window.Options{title: "UI Check", width: w, height: h,
        resizable: false, high_pixel_density: false, hidden: true}
    $r := ren2.open_2d_window_adaptive(opts, gpu.AUTO, canvas_prog) >>>
    actual := r.backend_mode() >>>
    check(actual == mode_id, "renderer2d backend mode mismatch") >>>
    r.enable_sdf(sdf_prog) >>>
    r.enable_text(text_prog) >>>
    << r
}

fn test_widgets_2d(mode_id int, mode_tag string, canvas_prog &ren2.ShaderProgram2D,
    sdf_prog &ren2.SdfProgram2D, text_prog &ren2.TextProgram2D) int {
    w := 320
    h := 260
    $r := open_2d_for_mode(mode_id, w, h, canvas_prog, sdf_prog, text_prog) >>>
    styles := widgets.dark_styles()
    $uf := ui_bridge.new_ui_frame(&styles) >>>
    $mask := uf.create_mask_2d(&r) >>>
    id := ui_bridge.default_input_bridge().canvas_identity()

    $btn := widgets.button(&id, 1, &layout.Rect{x: 20.0, y: 56.0, width: 128.0, height: 32.0})
    btn.set_focus(true)
    sw_on := widgets.switch_control(&id, 2, &layout.Rect{x: 20.0, y: 96.0, width: 128.0, height: 28.0}, true)
    sw_off := widgets.switch_control(&id, 3, &layout.Rect{x: 164.0, y: 96.0, width: 128.0, height: 28.0}, false)
    cb_on := widgets.checkbox(&id, 4, &layout.Rect{x: 20.0, y: 132.0, width: 128.0, height: 26.0}, true)
    $cb_ind := widgets.checkbox(&id, 5, &layout.Rect{x: 164.0, y: 132.0, width: 128.0, height: 26.0}, false)
    cb_ind.set_indeterminate(true)
    rd_on := widgets.radio(&id, 6, &layout.Rect{x: 20.0, y: 166.0, width: 64.0, height: 26.0}, 0, true)
    rd_off := widgets.radio(&id, 7, &layout.Rect{x: 88.0, y: 166.0, width: 64.0, height: 26.0}, 1, false)
    sli := widgets.slider(&id, 8, &layout.Rect{x: 20.0, y: 204.0, width: 128.0, height: 28.0}, 0.0, 1.0, 0.55)
    prog := widgets.progress(&layout.Rect{x: 164.0, y: 210.0, width: 128.0, height: 14.0}, 0.65)
    $modal := widgets.modal(&id, 9, &layout.Rect{x: 70.0, y: 50.0, width: 180.0, height: 120.0},
        &layout.Rect{x: 0.0, y: 0.0, width: f64(w), height: f64(h)})

    // Frame 1: Full #ui/widgets showcase + clipped overflow text + style_box.
    uf.begin() >>>
    uf.draw_panel(&layout.Rect{x: 8.0, y: 8.0, width: 304.0, height: 244.0}, 10.0,
        draw.rgb(24, 28, 39), draw.rgb(72, 92, 128), 1.5) >>>
    hdr := "WIDGETS 2D SUITE"
    uf.draw_label(&layout.Rect{x: 20.0, y: 14.0, width: 150.0, height: 22.0}, &hdr, draw.rgb(235, 240, 250), 14.0, 0.0, 0.5) >>>
    sub := "Wrapped note inside card bounds"
    uf.draw_label_wrapped(&layout.Rect{x: 170.0, y: 14.0, width: 126.0, height: 34.0}, &sub, draw.rgb(170, 188, 214), 11.0, 0) >>>

    // Clipped text test: long label must stay strictly inside x <= 212.
    uf.push_clip(&layout.Rect{x: 164.0, y: 56.0, width: 48.0, height: 28.0}) >>>
    clip_msg := "CLIPPED_LONG_LABEL_TEXT"
    uf.draw_label(&layout.Rect{x: 164.0, y: 56.0, width: 140.0, height: 28.0}, &clip_msg, draw.rgb(255, 190, 90), 13.0, 0.0, 0.5) >>>
    uf.pop_clip() >>>

    btn_txt := "Activate"
    uf.button(&btn, &btn_txt) >>>
    sw1_txt := "Enabled"
    sw2_txt := "Paused"
    uf.switch_control(&sw_on, &sw1_txt) >>>
    uf.switch_control(&sw_off, &sw2_txt) >>>
    cb1_txt := "Checked"
    cb2_txt := "Mixed"
    uf.checkbox(&cb_on, &cb1_txt) >>>
    uf.checkbox(&cb_ind, &cb2_txt) >>>
    r1_txt := "A"
    r2_txt := "B"
    uf.radio(&rd_on, &r1_txt) >>>
    uf.radio(&rd_off, &r2_txt) >>>
    uf.slider(&sli) >>>
    uf.progress(&prog) >>>
    box_style := btn.style_or(&styles)
    uf.style_box(&layout.Rect{x: 164.0, y: 166.0, width: 60.0, height: 26.0}, &box_style, widgets.STATE_FOCUSED) >>>
    uf.style_box(&layout.Rect{x: 232.0, y: 166.0, width: 60.0, height: 26.0}, &box_style, widgets.STATE_DISABLED) >>>

    r.begin(PX_BG) >>>
    uf.flush_2d($&r, $&mask) >>>

    // Outer corner = background; panel interior at clipped-out text pos (250, 70) = untouched panel color.
    corner := r.read_pixel(2, 2) >>>
    check(px_r(corner) == 16 && px_g(corner) == 20 && px_b(corner) == 31, "widgets outer bg") >>>
    clipped_out := r.read_pixel(250, 70) >>>
    check(px_r(clipped_out) <= 28 && px_g(clipped_out) <= 32 && px_b(clipped_out) <= 44, "clip overflow stayed clean") >>>
    // Progress filled part (around x=190, y=217) has accent hue (r > 150) vs unfilled end (x=280, y=217).
    prog_fill := r.read_pixel(190, 217) >>>
    prog_empty := r.read_pixel(280, 217) >>>
    check(px_r(prog_fill) > px_r(prog_empty) + 80, "progress fill vs track") >>>

    r.capture("build/ui-widgets-" + mode_tag + ".png") >>>
    r.present() >>>

    // Frame 2: Modal backdrop + scrim verification.
    modal.open(time.zero_instant(), true, 1) >>>
    uf.begin() >>>
    uf.draw_panel(&layout.Rect{x: 16.0, y: 16.0, width: 120.0, height: 120.0}, 0.0,
        draw.rgb(240, 240, 240), draw.rgb(240, 240, 240), 0.0) >>>
    uf.modal_backdrop(&layout.Rect{x: 0.0, y: 0.0, width: f64(w), height: f64(h)}, &modal) >>>
    r.begin(PX_BG) >>>
    uf.flush_2d($&r, $&mask) >>>
    scrimmed := r.read_pixel(30, 30) >>>
    check(px_r(scrimmed) > 50 && px_r(scrimmed) < 200, "modal scrim attenuates bright panel") >>>
    r.present() >>>

    mask.close() >>>
    r.close() >>>
    << 0
}

fn test_xdf_replay_2d(mode_id int, mode_tag string, canvas_prog &ren2.ShaderProgram2D,
    sdf_prog &ren2.SdfProgram2D, text_prog &ren2.TextProgram2D) int {
    w := 320
    h := 240
    ctx := draw.default_context()
    $df := ctx.new_frame(4096)
    df.begin() >>>
    df.set_bg(draw.rgb(18, 24, 38)) >>>

    // Push + Translate + Clip + fill_rect extending past clip -> Pop unwinds clip+transform.
    df.push() >>>
    df.translate(16.0, 16.0) >>>
    df.clip_rect(0.0, 0.0, 76.0, 48.0) >>>
    df.fill_rect(8.0, 8.0, 120.0, 32.0, draw.rgb(220, 65, 65)) >>>
    df.pop() >>>

    // Unclipped after pop, plus rotated orange rect.
    df.fill_rect(108.0, 20.0, 36.0, 30.0, draw.rgb(60, 200, 110)) >>>
    df.push() >>>
    df.translate(174.0, 36.0) >>>
    df.rotate(18.0) >>>
    df.scale(1.1, 0.9) >>>
    df.fill_rect(-14.0, -10.0, 28.0, 20.0, draw.rgb(235, 130, 50)) >>>
    df.pop() >>>

    // Circle, ellipse (cx, cy, rx, ry), triangle, line, round rects.
    df.fill_circle(236.0, 38.0, 18.0, draw.rgb(70, 150, 240)) >>>
    df.fill_ellipse(284.0, 38.0, 22.0, 16.0, draw.rgb(240, 185, 65)) >>>
    df.fill_triangle(20.0, 88.0, 68.0, 88.0, 44.0, 132.0, draw.rgb(190, 90, 220)) >>>
    df.line(82.0, 92.0, 136.0, 128.0, draw.rgb(240, 244, 250), 4.0) >>>
    df.fill_round_rect(150.0, 88.0, 60.0, 40.0, 8.0, draw.rgb(44, 72, 110)) >>>
    df.stroke_round_rect(150.0, 88.0, 60.0, 40.0, 8.0, draw.rgb(90, 220, 210), 2.5) >>>

    // Curved filled polygon Path (quad_to + cubic_to + close) + dashed curved stroke Path.
    $fill_p := draw.new_path(256)
    fill_p.move_to(224.0, 92.0) >>>
    fill_p.quad_to(260.0, 76.0, 294.0, 94.0) >>>
    fill_p.cubic_to(306.0, 116.0, 270.0, 140.0, 224.0, 128.0) >>>
    fill_p.close() >>>
    df.fill_path(&fill_p, draw.rgb(95, 195, 165), draw.FILL_NONZERO) >>>

    $dash_p := draw.new_path(128)
    dash_p.move_to(20.0, 154.0) >>>
    dash_p.cubic_to(80.0, 136.0, 130.0, 174.0, 180.0, 150.0) >>>
    dash_opts := draw.dashed_stroke(3.0, 10.0, 6.0)
    df.stroke_path(&dash_p, draw.rgb(245, 220, 110), &dash_opts) >>>

    txt := "XDF1 PATH + WIDGETS"
    df.text(20.0, 174.0, 13.0, draw.rgb(236, 242, 252), &txt) >>>

    // Direct #ui/widgets painting into draw.Frame -> XDF1 -> replay_xdf.
    styles := widgets.dark_styles()
    id := ui_bridge.default_input_bridge().canvas_identity()
    btn_st := styles.overlay_style()
    widgets.style_box($&df, &layout.Rect{x: 20.0, y: 198.0, width: 84.0, height: 28.0}, &btn_st, 1.0, widgets.STATE_FOCUSED) >>>
    sli := widgets.slider(&id, 1, &layout.Rect{x: 114.0, y: 200.0, width: 96.0, height: 24.0}, 0.0, 1.0, 0.7)
    sli.paint_styled($&df, &styles) >>>
    prog := widgets.progress(&layout.Rect{x: 220.0, y: 206.0, width: 84.0, height: 12.0}, 0.55)
    prog.paint_styled($&df, &styles) >>>

    xdf_blob := df.export_xdf() >>>

    $r := open_2d_for_mode(mode_id, w, h, canvas_prog, sdf_prog, text_prog) >>>
    $uf := ui_bridge.new_ui_frame(&styles) >>>
    $mask := uf.create_mask_2d(&r) >>>
    uf.begin() >>>
    uf.replay_xdf(&xdf_blob, &layout.Rect{x: 0.0, y: 0.0, width: f64(w), height: f64(h)}) >>>

    r.begin(PX_BG) >>>
    uf.flush_2d($&r, $&mask) >>>
    r.capture("build/ui-xdf-" + mode_tag + ".png") >>>

    // Clipped red box: (36, 36) is red; (98, 36) was outside clip_rect [16..92] and must be background!
    red_in := r.read_pixel(36, 36) >>>
    red_clipped := r.read_pixel(98, 36) >>>
    check(px_r(red_in) >= 200 && px_g(red_in) <= 80, "xdf translated red in clip") >>>
    check(px_r(red_clipped) <= 30 && px_b(red_clipped) >= 30, "xdf clip_rect cropped right edge") >>>

    // After restore(), unclipped green rect at (124, 34) and circle/ellipse fills render cleanly.
    green_restored := r.read_pixel(124, 34) >>>
    check(px_g(green_restored) >= 180 && px_r(green_restored) <= 80, "xdf restore unclipped green") >>>
    circ_px := r.read_pixel(236, 38) >>>
    check(px_b(circ_px) >= 220 && px_r(circ_px) <= 90, "xdf fill_circle blue") >>>
    ell_px := r.read_pixel(284, 38) >>>
    check(px_r(ell_px) >= 220 && px_g(ell_px) >= 170,
        "xdf fill_ellipse gold rgba=" + str(px_r(ell_px)) + "," + str(px_g(ell_px)) + "," + str(px_b(ell_px)) + "," + str(px_a(ell_px))) >>>
    poly_px := r.read_pixel(260, 108) >>>
    check(px_g(poly_px) >= 175 && px_b(poly_px) >= 145, "xdf filled curved Path") >>>

    r.present() >>>
    mask.close() >>>
    r.close() >>>
    << 0
}

fn test_overlay_3d_compositing(mode_id int, mode_tag string, mesh_prog &ren3.ShaderProgram3D,
    canvas_prog &ren2.ShaderProgram2D, sdf_prog &ren2.SdfProgram2D, text_prog &ren2.TextProgram2D) int {
    w := 256
    h := 192
    wopts := window.Options{title: "UI 3D Composite", width: w, height: h,
        resizable: false, high_pixel_density: false, hidden: true}
    $dev := ren3.open_3d_window_adaptive(wopts, gpu.AUTO, mesh_prog) >>>
    check((dev.backend_mode() >>>) == mode_id, "device3d backend mode mismatch") >>>
    $overlay := ren2.open_overlay(dev.present_session() >>>, canvas_prog, sdf_prog) >>>
    overlay.enable_text(dev.present_session() >>>, text_prog) >>>

    $core_mesh := dev.upload(&meshes.sphere_mesh_3d(1.1, 8, 5, 4294967295) >>>) >>>
    $tree := scene.new_scene_tree_3d("CompositeScene", 8) >>>
    core := tree.add_child_3d(tree.root(), "Core") >>>
    $sc := scene_render.new_scene_3d(&dev) >>>
    sc.attach_mesh(&tree, core, &core_mesh) >>>
    sc.set_material(&tree, core, ren3.material_3d(fm.vec3(0.25, 0.58, 0.94), 0.25, 0.35, fm.vec3(0.0, 0.0, 0.0)) >>>) >>>
    tree.set_transform_3d(core, fm.rotation_y(0.55).multiply(fm.rotation_x(0.35))) >>>

    sun := lights.directional(fm.vec3(0.6, 0.8, 0.4), fm.vec3(2.4, 2.2, 2.0)) >>>
    lighting := lights.environment(fm.vec3(0.14, 0.17, 0.24), fm.vec3(0.0, 0.8, 3.8), 1.0, [sun]) >>>
    view := scene.look_at_3d(fm.vec3(0.0, 0.8, 3.8), fm.vec3(0.0, 0.0, 0.0), fm.vec3(0.0, 1.0, 0.0)) >>>
    vp := (scene.perspective_3d(0.75, f64(w) / f64(h), 0.1, 100.0) >>>).multiply(view)

    styles := widgets.dark_styles()
    $hud := ui_bridge.new_ui_frame(&styles) >>>
    id := ui_bridge.default_input_bridge().canvas_identity()
    $btn := widgets.button(&id, 1, &layout.Rect{x: 16.0, y: 18.0, width: 92.0, height: 26.0})
    btn.set_focus(true)
    prog := widgets.progress(&layout.Rect{x: 16.0, y: 52.0, width: 92.0, height: 12.0}, 0.7)

    ctx := draw.default_context()
    $df := ctx.new_frame(512)
    df.begin() >>>
    df.fill_round_rect(144.0, 16.0, 96.0, 42.0, 6.0, draw.rgb(22, 34, 52)) >>>
    df.stroke_round_rect(144.0, 16.0, 96.0, 42.0, 6.0, draw.rgb(80, 170, 240), 1.5) >>>
    xdf_txt := "3D+XDF"
    df.text(156.0, 28.0, 12.0, draw.rgb(240, 244, 255), &xdf_txt) >>>
    xdf_blob := df.export_xdf() >>>

    hud.begin() >>>
    hud.draw_panel(&layout.Rect{x: 8.0, y: 8.0, width: 108.0, height: 68.0}, 8.0,
        draw.rgba(16, 20, 32, 230), draw.rgb(80, 108, 148), 1.5) >>>
    btxt := "HUD"
    hud.button(&btn, &btxt) >>>
    hud.progress(&prog) >>>
    hud.replay_xdf(&xdf_blob, &layout.Rect{x: 140.0, y: 12.0, width: 104.0, height: 50.0}) >>>

    dev.begin(PX_BG) >>>
    sc.draw_lit($&dev, &tree, vp, &lighting) >>>
    overlay.clear() >>>
    hud.flush_overlay(dev.present_session() >>>, $&overlay) >>>

    if dev.is_gpu() {
        $pf := dev.begin_present_frame() >>>
        overlay.flush_gpu_frame(dev.gpu_device() >>>, $&pf, w, h, gpu.LOAD, 0) >>>
        dev.finish_present_frame($&pf) >>>
    } else {
        dev.software_prepare_present() >>>
        overlay.flush_software(dev.software_pixels_mut() >>>, w, h, false, 0) >>>
        sess := dev.present_session() >>>
        sky_px := sess.read_software_pixel(12, 160) >>>
        check(px_r(sky_px) < 40 && px_b(sky_px) >= 24, "3D composite sky region") >>>
        mesh_px := sess.read_software_pixel(128, 118) >>>
        check(px_b(mesh_px) > 70, "3D lit sphere rendered below overlay") >>>
        prog_px := sess.read_software_pixel(40, 58) >>>
        check(px_r(prog_px) > 150, "overlay progress fill rendered above 3D") >>>
        xdf_px := sess.read_software_pixel(228, 42) >>>
        check(px_b(xdf_px) >= 45 && px_b(xdf_px) < 120, "overlay XDF card rendered above 3D") >>>
        sess.capture_software_png("build/ui-composite-" + mode_tag + ".png") >>>
        dev.present_software_frame() >>>
    }

    overlay.close() >>>
    core_mesh.close() >>>
    dev.close() >>>
    << 0
}

fn run() int {
    args := os.args()
    $mode_arg := "gpu"
    if args.len > 1 { mode_arg = args[1] + "" }
    $mode_id := platform_present.MODE_GPU
    if mode_arg == "gpu" {
        mode_id = platform_present.MODE_GPU
    } else if mode_arg == "software" {
        mode_id = platform_present.MODE_SOFTWARE
    } else if mode_arg == "headless" {
        mode_id = platform_present.MODE_HEADLESS
    } else {
        >> errors.new("ui hud checks: expected gpu, software, or headless mode")
    }

    test_input_bridge() >>>
    test_hud_router_and_text_field() >>>
    test_error_contracts() >>>

    canvas_prog := shaders2.load_canvas("build/canvas-shaders") >>>
    sdf_prog := shaders2.load_ui_sdf("build/canvas-shaders") >>>
    text_prog := shaders2.load_ui_text("build/canvas-shaders") >>>
    mesh_prog := shaders3.load_mesh("build/mesh-shaders") >>>

    test_widgets_2d(mode_id, mode_arg + "", &canvas_prog, &sdf_prog, &text_prog) >>>
    test_xdf_replay_2d(mode_id, mode_arg + "", &canvas_prog, &sdf_prog, &text_prog) >>>
    test_styled_widgets_and_phone_xdf_2d(mode_id, mode_arg + "", &canvas_prog, &sdf_prog, &text_prog) >>>
    test_overlay_3d_compositing(mode_id, mode_arg + "", &mesh_prog, &canvas_prog, &sdf_prog, &text_prog) >>>

    println("PASS: UI HUD widgets, input, XDF1 replay, and 3D+Overlay2D verified in " + mode_arg + " mode")
    << 0
}

fn main() int {
    << run() >>> (err) {
        eprintln(err.msg())
        << 1
    }
}
