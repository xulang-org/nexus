@main

light_data #"github.com/xulang-org/nexus/resources/lighting"

#gpu

mesh_shaders #"github.com/xulang-org/nexus/assets/shaders/three_d"
worlds #"github.com/xulang-org/nexus/integration/scene_audio"
loader #"github.com/xulang-org/nexus/integration/scene_render"
files #"github.com/xulang-org/nexus/integration/scene"
ren #"github.com/xulang-org/nexus/rendering/three_d"
scene_render #"github.com/xulang-org/nexus/integration/rendering/three_d"
fm #"github.com/xulang-org/nexus/foundation/math"
nexus #"github.com/xulang-org/nexus/scene"

fn bad_graphics(device &ren.Device3D) bool { loader.load(device, "build/scene-av/world.xuscene") >>> (err) { << true }
    << false }
fn bad_audio() bool { worlds.load("build/scene-av/world.xuscene", 48000) >>> (err) { << true }
    << false }
fn run() int {
    mesh_program_0 := mesh_shaders.load_mesh("build/mesh-shaders") >>>
    $device := ren.open_3d("Scene audio and GPU restore", 128, 96, gpu.AUTO, &mesh_program_0) >>>
    assert(bad_graphics(&device) && bad_audio())
    $world := worlds.load_audio("build/scene-av/world.xuscene", 48000) >>>
    document := world.capture() >>>
    $models := loader.prepare_surfaces(&device, document, world.base_directory()) >>>
    $scene := scene_render.new_scene_3d(&device) >>>
    assert((models.bind($&scene, &world.tree, world.root()) >>>) == 8)
    camera_node := world.tree.find_child(world.root(), "Camera") >>>
    camera := nexus.new_camera_node_3d(&world.tree, camera_node) >>>
    view := camera.view_projection(&world.tree, 128.0 / 96.0) >>>
    lighting := light_data.environment(fm.vec3(0.15, 0.15, 0.15), fm.vec3(0.0, 0.0, 9.5), 1.0, [light_data.directional(fm.vec3(0.4, 0.7, 1.0), fm.vec3(2.0, 2.0, 2.0)) >>>]) >>>
    device.begin(255) >>>
    assert((scene.draw_lit($&device, &world.tree, view, &lighting) >>>).instances == 8)
    device.present() >>>
    assert(world.clip_count() == 1 && (world.is_playing(0) >>>))
    world.render(16) >>>
    assert((world.position_frames(0) >>>) > 0.0)
    models.save("build/scene-av/model-saved.xuscene", &world.tree, world.root()) >>>
    saved := files.load("build/scene-av/model-saved.xuscene") >>>
    assert(saved.audio_count() == 1 && saved.resource_count() == 2 && saved.surface_count() == 8)
    $reloaded := worlds.load_audio("build/scene-av/model-saved.xuscene", 48000) >>>
    assert((reloaded.position_frames(0) >>>) == 0.0 && reloaded.clip_count() == 1)
    reloaded.close() >>>
    world.close() >>>
    models.close() >>>
    device.close() >>>
    println("PASS: combined scene restores audio and 8 GPU surfaces with explicit composition, both partial-default loaders reject omissions, renderer save preserves WAV/bus/emitter metadata and restart begins at zero")
    << 0
}
fn main() int { << run() >>> (err) { eprintln(err.msg())
    << 1 } }
