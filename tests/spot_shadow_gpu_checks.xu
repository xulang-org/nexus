@main
#gpu
#os
fm #"github.com/xulang-org/nexus/foundation/math"
policy #"github.com/xulang-org/nexus/resources/shadow"
mesh #"github.com/xulang-org/nexus/resources/mesh"
lights #"github.com/xulang-org/nexus/resources/lighting"
nexus #"github.com/xulang-org/nexus/scene"
ren #"github.com/xulang-org/nexus/rendering/three_d"
bridge #"github.com/xulang-org/nexus/integration/rendering/three_d"
shaders #"github.com/xulang-org/nexus/assets/shaders/three_d"

fn quad(size f64,slope bool) mesh.MeshData3D {
    $data := mesh.new_mesh_data_3d()
    for xy in [fm.vec2(-size,-size),fm.vec2(size,-size),fm.vec2(size,size),fm.vec2(-size,size)] {
        $z := 0.0
        if slope { z=xy.x*0.2+xy.y*0.1 }
        // Smoothed normal intentionally differs from the actual sloped plane.
        data.vertex_lit(fm.vec3(xy.x,xy.y,z),4294967295,fm.vec3(0.0,0.0,1.0)) >>>
    }
    data.triangle(0,1,2) >>>
    data.triangle(0,2,3) >>>
    << data
}
fn capture(device $&ren.Device3D,scene &bridge.Scene3D,tree &nexus.SceneTree,vp fm.Mat4,env &lights.Environment3D,
    shadow &ren.ShadowMap3D,enabled bool,name string,values $&[]int) string {
    device.begin(255) >>>
    if enabled { scene.draw_lit_shadowed(device,tree,vp,env,shadow,1) >>>
    } else { scene.draw_lit(device,tree,vp,env) >>> }
    values.push(device.read_pixel(32,32) >>>)
    path := "build/spot-shadow-"+name+".png"
    device.capture(path+"") >>>
    device.present() >>>
    << os.read(path) >>>
}
fn failed_binding(shadow &ren.ShadowMap3D,env &lights.Environment3D) bool {
    shadow.binding(env,1) >>> (err){ << true }
    << false
}
fn failed_draw(device $&ren.Device3D,receiver &ren.Mesh3D,material &ren.Material3D,env &lights.Environment3D,binding &ren.ShadowBinding3D,vp fm.Mat4) bool {
    device.draw_material_shadowed_reference(receiver.reference(),fm.identity_3d(),vp,material,env,binding) >>> (err){ << true }
    << false
}
fn run() int {
    program := shaders.load_mesh("build/mesh-shaders") >>>
    shadow_program := shaders.load_shadow("build/mesh-shaders") >>>
    $device := ren.open_3d("Spot shadow checks",64,64,gpu.METAL,&program) >>>
    origin := fm.vec3(0.0,0.0,4.0)
    forward := fm.vec3(0.0,0.0,-1.0)
    white := fm.vec3(48.0,48.0,48.0)
    spot := lights.spot(origin,forward,white,8.0,0.35,0.52) >>>
    description := policy.spot(spot,0.1,128) >>>
    $shadow := device.shadow_map(description,&shadow_program) >>>
    distant := lights.point(fm.vec3(100.0,100.0,100.0),fm.vec3(1.0,1.0,1.0),1.0) >>>
    env := lights.environment(fm.vec3(0.08,0.08,0.08),origin,1.0,[distant,spot]) >>>
    assert(failed_binding(&shadow,&env))
    data := quad(2.0,false) >>>
    small := quad(0.5,false) >>>
    slope := quad(2.0,true) >>>
    $receiver := device.upload(&data) >>>
    $occluder := device.upload(&small) >>>
    $sloped := device.upload(&slope) >>>
    $tree := nexus.new_scene_tree_3d("World",16) >>>
    floor := tree.add_child_3d(tree.root(),"Receiver") >>>
    $scene := bridge.new_scene_3d(&device) >>>
    scene.attach_mesh(&tree,floor,&receiver) >>>
    material := ren.material_3d(fm.vec3(0.6,0.6,0.6),0.0,0.8,fm.vec3(0.0,0.0,0.0)) >>>
    scene.set_material(&tree,floor,material) >>>
    view := nexus.look_at_3d(origin,fm.vec3(0.0,0.0,0.0),fm.vec3(0.0,1.0,0.0)) >>>
    vp := (nexus.perspective_3d(0.8,1.0,0.1,100.0) >>>).multiply(view)
    caster := ren.shadow_caster(occluder.reference(), fm.translation_3d(fm.vec3(0.0,0.0,1.0)))
    casters := [caster]
    assert((shadow.render(&device,&casters,description) >>>)==2)
    $values := []int{}
    lit := capture($&device,&scene,&tree,vp,&env,&shadow,false,"lit",$&values) >>>
    dark := capture($&device,&scene,&tree,vp,&env,&shadow,true,"occluded",$&values) >>>
    assert(values[1]<values[0] && dark!=lit)
    duplicate := lights.environment(fm.vec3(0.08,0.08,0.08),origin,1.0,[distant,spot,spot]) >>>
    capture($&device,&scene,&tree,vp,&duplicate,&shadow,true,"one-of-two",$&values) >>>
    assert(values[2]==values[0])
    // Validate map/source compatibility both at binding and actual draw time.
    binding := shadow.binding(&env,1) >>>
    for changed in [lights.spot(fm.vec3(0.1,0.0,4.0),forward,white,8.0,0.35,0.52) >>>,
        lights.spot(origin,fm.vec3(0.1,0.0,-1.0),white,8.0,0.35,0.52) >>>,
        lights.spot(origin,forward,white,7.0,0.35,0.52) >>>,
        lights.spot(origin,forward,white,8.0,0.35,0.6) >>>,
        lights.point(origin,white,8.0) >>>] {
        changed_env := lights.environment(fm.vec3(0.08,0.08,0.08),origin,1.0,[distant,changed]) >>>
        assert(failed_binding(&shadow,&changed_env))
        device.begin(255) >>>
        assert(failed_draw($&device,&receiver,&material,&changed_env,&binding,vp))
        scene.draw_lit_shadowed($&device,&tree,vp,&env,&shadow,1) >>>
        device.present() >>>
    }
    dimmed := lights.spot(origin,forward,fm.vec3(1.0,2.0,3.0),8.0,0.2,0.52) >>>
    dim_env := lights.environment(fm.vec3(0.08,0.08,0.08),origin,1.0,[distant,dimmed]) >>>
    assert(!failed_binding(&shadow,&dim_env))
    // Perspective depth gradients must also remove acne on authored smooth normals.
    scene.attach_mesh(&tree,floor,&sloped) >>>
    self_casters := scene.shadow_casters(&tree) >>>
    tilted_source := lights.spot(fm.vec3(1.0,1.5,4.0),fm.vec3(-1.0,-1.5,-4.0),white,8.0,0.35,0.65) >>>
    tilted := policy.spot(tilted_source,0.1,128) >>>
    shadow.render(&device,&self_casters,tilted) >>>
    tilted_env := lights.environment(fm.vec3(0.08,0.08,0.08),origin,1.0,[distant,tilted_source]) >>>
    control := capture($&device,&scene,&tree,vp,&tilted_env,&shadow,false,"plane-control",$&values) >>>
    self := capture($&device,&scene,&tree,vp,&tilted_env,&shadow,true,"plane-self",$&values) >>>
    assert(control==self)
    // Removing all casters clears old occlusion without reallocating the map.
    scene.attach_mesh(&tree,floor,&receiver) >>>
    empty := []ren.ShadowCaster3D{}
    shadow.render(&device,&empty,description) >>>
    restored := capture($&device,&scene,&tree,vp,&env,&shadow,true,"empty",$&values) >>>
    assert(restored==lit)
    shadow.close() >>>
    assert(failed_binding(&shadow,&env))
    receiver.close() >>>
    occluder.close() >>>
    sloped.close() >>>
    device.close() >>>
    println("PASS: actual perspective spot shadows, filtered/duplicate source identity, stale position/direction/range/cone rejection with frame recovery, intensity/inner-cone reuse, sloped-plane self projection and empty/closed maps")
    << 0
}
fn main() int { << run() >>> (err){ eprintln(err.msg())
    << 1 } }
