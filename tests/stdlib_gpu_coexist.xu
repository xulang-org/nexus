@main

canvas_shaders #"github.com/xulang-org/nexus/assets/shaders/two_d"
#gpu
ren #"github.com/xulang-org/nexus/rendering/two_d"
fn transfer(device &gpu.Device) int {
    $buffer := device.buffer(4,gpu.BUFFER_VERTEX) >>>
    bytes := [u8(0),u8(128),u8(255),u8(17)]
    $upload := device.upload(&buffer,0,&bytes) >>>
    $readback := device.download(&buffer,0,4) >>>
    readback.wait() >>>
    $output := [u8(0),u8(0),u8(0),u8(0)]
    readback.read($&output) >>>
    assert(output[0]==u8(0) && output[1]==u8(128) && output[2]==u8(255) && output[3]==u8(17))
    << 0
}
fn run() int {
    canvas_program_0 := canvas_shaders.load_canvas("build/canvas-shaders") >>>
    $renderer := ren.open_2d("Standard GPU coexistence",64,64,1,&canvas_program_0) >>>
    $first := gpu.open(gpu.DeviceOptions{backend: gpu.METAL,debug: true,shader_formats: 0}) >>>
    transfer(&first) >>>
    first.close() >>>
    renderer.begin(287454207) >>>
    assert((renderer.read_pixel(0,0) >>>)==287454207)
    renderer.present() >>>
    $second := gpu.open(gpu.DeviceOptions{backend: gpu.METAL,debug: true,shader_formats: 0}) >>>
    renderer.close() >>>
    transfer(&second) >>>
    second.close() >>>
    println("PASS: standard GPU and engine renderer coexist; closing either preserves the other SDL device")
    << 0
}
fn main() int { << run() >>> (err) { eprintln(err.msg())
    << 1 } }
