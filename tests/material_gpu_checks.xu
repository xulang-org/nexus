@main

light_data #"github.com/xulang-org/nexus/resources/lighting"

#gpu

gpu_info #"github.com/xulang-org/nexus/platform/gpu"

mesh_shaders #"github.com/xulang-org/nexus/assets/shaders/three_d"

meshes #"github.com/xulang-org/nexus/resources/mesh"

ren #"github.com/xulang-org/nexus/rendering/three_d"
scene_render #"github.com/xulang-org/nexus/integration/rendering/three_d"
colors #"github.com/xulang-org/nexus/foundation/color"
fm #"github.com/xulang-org/nexus/foundation/math"
nexus #"github.com/xulang-org/nexus/scene"
assets #"github.com/xulang-org/nexus/assets/gltf"
glb #"github.com/xulang-org/nexus/integration/gltf_render"
#math

fn triangle(normal fm.Vec3, scale f64) meshes.MeshData3D {
    $data := meshes.new_mesh_data_3d()
    white := colors.rgba8(255, 255, 255, 255) >>>
    for position in [fm.vec3(-scale, -1.0, 0.0), fm.vec3(scale, -1.0, 0.0), fm.vec3(0.0, 1.0, 0.0)] {
        data.vertex_lit(position, white, normal) >>>
    }
    data.triangle(0, 1, 2) >>>
    << data
}
fn channel(color int, index int) int {
    if index == 0 { << (color / 16777216) % 256 }
    if index == 1 { << (color / 65536) % 256 }
    << (color / 256) % 256
}
fn sample(device $&ren.Device3D, mesh &ren.Mesh3D, world fm.Mat4, projection fm.Mat4,
    material &ren.Material3D, lighting &light_data.Environment3D) int {
    device.begin(255) >>>
    device.draw_material(mesh, world, projection, material, lighting) >>>
    result := device.read_pixel(128, 128) >>>
    device.present() >>>
    << result
}
fn rejected(device $&ren.Device3D, mesh &ren.Mesh3D, world fm.Mat4, material &ren.Material3D, lighting &light_data.Environment3D) bool {
    device.draw_material(mesh, world, fm.identity_3d(), material, lighting) >>> (err) { << true }
    << false
}
fn bad_material(roughness f64) bool {
    ren.material_3d(fm.vec3(0.5, 0.5, 0.5), 0.0, roughness, fm.vec3(0.0, 0.0, 0.0)) >>> (err) { << true }
    << false
}
fn bad_replacement(scene $&scene_render.Scene3D, tree &nexus.SceneTree, node int, mesh &ren.Mesh3D) bool {
    scene.attach_mesh(tree, node, mesh) >>> (err) { << true }
    << false
}
fn bad_preflight(scene &scene_render.Scene3D, tree &nexus.SceneTree, node int, mesh &ren.Mesh3D) bool {
    scene.check_mesh_binding(tree, node, mesh) >>> (err) { << true }
    << false
}
fn bad_model_bind(model &glb.GlbUnlit3D, scene $&scene_render.Scene3D, tree &nexus.SceneTree, instance &assets.GlbInstance) bool {
    model.bind(scene, tree, instance) >>> (err) { << true }
    << false
}
fn run() int {
    mesh_program_0 := mesh_shaders.load_mesh("build/mesh-shaders") >>>
    $device := ren.open_3d("Xu material GPU validation", 256, 256, gpu.AUTO, &mesh_program_0) >>>
    println("Material GPU checks backend: " + gpu_info.backend_name(device.backend() >>>))
    zero := fm.vec3(0.0, 0.0, 0.0)
    normal := fm.vec3(0.0, 0.0, 1.0)
    projection := nexus.perspective_3d(math.pi() / 2.0, 1.0, 0.1, 100.0) >>>
    world := fm.translation_3d(fm.vec3(0.0, 0.0, -2.0))
    source := triangle(normal, 1.0) >>>
    $mesh := device.upload(&source) >>>
    rough := ren.material_3d(fm.vec3(0.5, 0.5, 0.5), 0.0, 1.0, zero) >>>
    smooth := ren.material_3d(fm.vec3(0.5, 0.5, 0.5), 0.0, 0.2, zero) >>>
    front := light_data.environment(zero, zero, 1.0, [light_data.directional(normal, fm.vec3(3.0, 3.0, 3.0)) >>>]) >>>
    back := light_data.environment(zero, zero, 1.0, [light_data.directional(fm.vec3(0.0, 0.0, -1.0), fm.vec3(3.0, 3.0, 3.0)) >>>]) >>>
    lit := sample($&device, &mesh, world, projection, &rough, &front) >>>
    dark := sample($&device, &mesh, world, projection, &rough, &back) >>>
    shiny := sample($&device, &mesh, world, projection, &smooth, &front) >>>
    assert(channel(lit, 0) > 130 && dark == 255 && channel(shiny, 0) > channel(lit, 0) + 30)
    flipped := world.multiply(fm.rotation_y(math.pi()))
    assert((sample($&device, &mesh, flipped, projection, &rough, &front) >>>) == 255)
    double := rough.with_double_sided(true)
    double_back := sample($&device, &mesh, flipped, projection, &double, &front) >>>
    assert(channel(double_back, 0) > 130)
    single := double.with_double_sided(false)
    assert((sample($&device, &mesh, flipped, projection, &single, &front) >>>) == 255)
    // Culling must expose the outward-lit front hemisphere, not the dark far side.
    sphere_data := meshes.sphere_mesh_3d(0.75, 32, 16, 4294967295) >>>
    $lit_sphere := device.upload(&sphere_data) >>>
    sphere_pixel := sample($&device, &lit_sphere, world, projection, &rough, &front) >>>
    assert(channel(sphere_pixel, 0) > 130)
    emission := ren.material_3d(zero, 0.0, 0.5, fm.vec3(1.0, 0.25, 0.0)) >>>
    no_light := light_data.environment(zero, zero, 1.0, [light_data.directional(normal, zero) >>>]) >>>
    emitted := sample($&device, &mesh, world, projection, &emission, &no_light) >>>
    assert(math.abs(f64(channel(emitted, 0) - 188)) <= 2.0 && math.abs(f64(channel(emitted, 1) - 124)) <= 2.0 && channel(emitted, 2) == 0)
    brighter := light_data.environment(zero, zero, 2.0, [light_data.directional(normal, fm.vec3(3.0, 3.0, 3.0)) >>>]) >>>
    exposed := sample($&device, &mesh, world, projection, &rough, &brighter) >>>
    assert(channel(exposed, 0) > channel(lit, 0) + 20)
    metal := ren.material_3d(fm.vec3(0.8, 0.2, 0.05), 1.0, 1.0, zero) >>>
    metallic := sample($&device, &mesh, world, projection, &metal, &front) >>>
    assert(channel(metallic, 0) > channel(metallic, 1) + 15 && channel(metallic, 1) > channel(metallic, 2) + 10)
    // Independent baked-normal reference catches using model instead of its
    // inverse transpose under nonuniform scale.
    tilted_source := triangle(fm.vec3(1.0, 0.0, 1.0), 1.0) >>>
    reference_source := triangle(fm.vec3(0.25, 0.0, 2.0), 4.0) >>>
    $tilted := device.upload(&tilted_source) >>>
    $reference := device.upload(&reference_source) >>>
    scaled := world.multiply(fm.scale_3d(fm.vec3(4.0, 1.0, 0.5)))
    actual := sample($&device, &tilted, scaled, projection, &rough, &front) >>>
    expected := sample($&device, &reference, world, projection, &rough, &front) >>>
    for i in 0:3 { assert(math.abs(f64(channel(actual, i) - channel(expected, i))) <= 2.0) }
    assert(channel(actual, 0) > 130)
    $tiny_source := meshes.new_mesh_data_3d()
    for point in [fm.vec3(-0.0000001, -0.0000001, 0.0), fm.vec3(0.0000001, -0.0000001, 0.0), fm.vec3(0.0, 0.0000001, 0.0)] {
        tiny_source.vertex_lit(point, 4294967295, normal) >>> }
    tiny_source.triangle(0, 1, 2) >>>
    $tiny := device.upload(&tiny_source) >>>
    huge_world := world.multiply(fm.scale_3d(fm.vec3(10000000.0, 10000000.0, 10000000.0)))
    huge_scale := sample($&device, &tiny, huge_world, projection, &rough, &front) >>>
    println("Material normal scale reference=" + str(lit) + " scaled=" + str(huge_scale))
    for i in 0:3 { assert(math.abs(f64(channel(huge_scale, i) - channel(lit, i))) <= 2.0) }
    $unlit_data := meshes.new_mesh_data_3d()
    for point in [fm.vec3(-1.0, -1.0, 0.0), fm.vec3(1.0, -1.0, 0.0), fm.vec3(0.0, 1.0, 0.0)] {
        unlit_data.vertex(point, 4294967295) >>> }
    unlit_data.triangle(0, 1, 2) >>>
    $unlit := device.upload(&unlit_data) >>>
    assert(bad_material(0.0) && bad_material(1.1))
    assert(rejected($&device, &mesh, world, &rough, &front))
    device.begin(255) >>>
    assert(rejected($&device, &unlit, world, &rough, &front))
    assert(rejected($&device, &mesh, fm.scale_3d(zero), &rough, &front))
    empty_material := ren.Material3D{}
    empty_light := light_data.Environment3D{}
    assert(rejected($&device, &mesh, world, &empty_material, &front))
    assert(rejected($&device, &mesh, world, &rough, &empty_light))
    device.draw_material(&mesh, world, projection, &rough, &front) >>>
    assert((device.read_pixel(128, 128) >>>) == lit)
    assert(rejected($&device, &mesh, world, &rough, &front))
    device.present() >>>
    $tree := nexus.new_scene_tree_3d("Lit", 4) >>>
    node := tree.add_child_3d(tree.root(), "Triangle") >>>
    tree.set_transform_3d(node, world) >>>
    $scene := scene_render.new_scene_3d(&device) >>>
    scene.attach_mesh(&tree, node, &mesh) >>>
    scene.set_material(&tree, node, rough) >>>
    assert(bad_preflight(&scene, &tree, node, &unlit))
    assert(bad_replacement($&scene, &tree, node, &unlit) && scene.binding_count() == 1)
    device.begin(255) >>>
    draws := scene.draw_lit($&device, &tree, projection, &front) >>>
    assert(draws.instances == 1 && draws.triangles == 1 && (device.read_pixel(128, 128) >>>) == lit)
    device.present() >>>
    asset := assets.load_glb_geometry("build/glb-fixtures/mixed-normals.glb") >>>
    $import_tree := nexus.new_scene_tree_3d("Import", 32) >>>
    import_root := import_tree.root()
    instance := assets.instantiate(&asset, $&import_tree, import_root, "Mixed") >>>
    $model := glb.upload_unlit(&device, &asset) >>>
    $import_scene := scene_render.new_scene_3d(&device) >>>
    no_normals := instance.primitive_node(1) >>>
    import_scene.attach_mesh(&import_tree, no_normals, &mesh) >>>
    import_scene.set_material(&import_tree, no_normals, rough) >>>
    assert(bad_model_bind(&model, $&import_scene, &import_tree, &instance) && import_scene.binding_count() == 1)
    model.close() >>>
    device.begin(255) >>>
    device.draw_material(&mesh, world, projection, &rough, &front) >>>
    device.draw(&unlit, projection.multiply(fm.translation_3d(fm.vec3(1.4, 0.0, -2.0)))) >>>
    assert((device.read_pixel(128, 128) >>>) == lit && (device.read_pixel(217, 150) >>>) == 4294967295)
    device.present() >>>
    assert(scene.clear_material(node) == 1 && scene.clear_material(node) == 0)
    scene.set_material(&tree, node, rough) >>>
    tree.queue_free(node) >>>
    assert((scene.prune(&tree) >>>) == 1)
    device.begin(255) >>>
    assert((scene.draw($&device, &tree, projection) >>>).instances == 0)
    device.capture("build/material-checks.png") >>>
    device.present() >>>
    sphere := meshes.sphere_mesh_3d(1.0, 8, 4, 4294967295) >>>
    assert(sphere.vertex_count() == 45 && sphere.triangle_count() == 48)
    mesh.close() >>>
    tilted.close() >>>
    reference.close() >>>
    tiny.close() >>>
    unlit.close() >>>
    device.close() >>>
    println("PASS: GPU direct light, roughness, metallic tint, emission/sRGB, exposure, inverse-transpose normals, scene material lifecycle, bounds and frame validation")
    << 0
}
fn main() int { << run() >>> (err) { eprintln(err.msg())
    << 1 } }
