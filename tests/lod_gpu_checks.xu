@main
#gpu
#os
#math
lod #"github.com/xulang-org/nexus/resources/lod"
ren #"github.com/xulang-org/nexus/rendering/three_d"
meshes #"github.com/xulang-org/nexus/resources/mesh"
shaders #"github.com/xulang-org/nexus/assets/shaders/three_d"
fm #"github.com/xulang-org/nexus/foundation/math"
nexus #"github.com/xulang-org/nexus/scene"
scene_render #"github.com/xulang-org/nexus/integration/rendering/three_d"
lights #"github.com/xulang-org/nexus/resources/lighting"
fn geometry(level int, uv bool, offset f64) meshes.MeshData3D {
    $mesh := meshes.new_mesh_data_3d()
    $points := [fm.vec3(-0.5,0.5,0.0),fm.vec3(0.5,0.5,0.0),fm.vec3(0.5,-0.5,0.0),fm.vec3(-0.5,-0.5,0.0),fm.vec3(0.0,0.0,0.0)]
    if level==2 { points=[fm.vec3(-0.5,-0.5,0.0),fm.vec3(0.5,-0.5,0.0),fm.vec3(0.0,0.5,0.0)] }
    for p in points {
        position := p.add(fm.vec3(offset,0.0,0.0))
        if uv { mesh.vertex_lit_uv(position,4294967295,fm.vec3(0.0,0.0,1.0),fm.vec2(p.x+0.5,p.y+0.5)) or >>
        } else { mesh.vertex_lit(position,4294967295,fm.vec3(0.0,0.0,1.0)) or >> }
    }
    if level==0 { for i in 0:4 { mesh.triangle(i,4,(i+1)%4) or >> }
    } else if level==1 { mesh.triangle(0,2,1) or >>
        mesh.triangle(0,3,2) or >>
    } else { mesh.triangle(0,1,2) or >> }
    << mesh
}
fn bad_draw(scene &scene_render.Scene3D,device $&ren.Device3D,tree &nexus.SceneTree,view fm.Mat4) bool {
    scene.draw(device,tree,view) or(err){ << true }
    << false
}
fn bad_lods(scene $&scene_render.Scene3D,tree &nexus.SceneTree,node int,refs []ren.MeshRef3D,policy &lod.DistanceLod) bool {
    scene.attach_lods(tree,node,refs,policy) or(err){ << true }
    << false
}
fn bad_material(scene $&scene_render.Scene3D,tree &nexus.SceneTree,node int,material ren.Material3D) bool {
    scene.set_material(tree,node,material) or(err){ << true }
    << false
}
fn bad_select(scene $&scene_render.Scene3D,tree &nexus.SceneTree,eye fm.Vec3) bool {
    scene.select_lods(tree,eye) or(err){ << true }
    << false
}
fn bad_level(scene &scene_render.Scene3D,node int) bool { scene.lod_level(node) or(err){ << true }
    << false }
fn compare(scene &scene_render.Scene3D,device $&ren.Device3D,tree &nexus.SceneTree,mesh &ren.Mesh3D,triangles int,saved int) int {
    view := fm.translation_3d(fm.vec3(0.0,0.0,0.5))
    device.begin(255) or >>
    device.draw(mesh,view) or >>
    device.capture("build/lod-direct.png") or >>
    device.present() or >>
    device.begin(255) or >>
    report := scene.draw(device,tree,view) or >>
    assert(report.instances==1 && report.triangles==triangles && report.lod_triangles_saved==saved)
    if saved>0 { assert(report.lod_instances==1)
    } else { assert(report.lod_instances==0) }
    device.capture("build/lod-scene.png") or >>
    device.present() or >>
    assert((os.read("build/lod-direct.png") or >>)==(os.read("build/lod-scene.png") or >>))
    << 0
}
fn run() int {
    program := shaders.load_mesh("build/mesh-shaders") or >>
    $device := ren.open_3d("Distance LOD checks",64,64,gpu.AUTO,&program) or >>
    high_data := geometry(0,true,0.0) or >>
    medium_data := geometry(1,true,0.0) or >>
    low_data := geometry(2,false,0.0) or >>
    shifted_data := geometry(2,false,2.0) or >>
    $high := device.upload(&high_data) or >>
    $medium := device.upload(&medium_data) or >>
    $low := device.upload(&low_data) or >>
    $shifted := device.upload(&shifted_data) or >>
    policy := lod.distance_lod([10.0,20.0],0.1) or >>
    pair := lod.distance_lod([10.0],0.1) or >>
    $tree := nexus.new_scene_tree_3d("LOD",16) or >>
    parent := tree.add_child_3d(tree.root(),"Parent") or >>
    node := tree.add_child_3d(parent,"Object") or >>
    $scene := scene_render.new_scene_3d(&device) or >>
    scene.attach_lods(&tree,node,[high.reference(),medium.reference(),low.reference()],&policy) or >>
    assert(scene.binding_count()==1 && (scene.lod_level(node) or >>) == -1)
    view := fm.translation_3d(fm.vec3(0.0,0.0,0.5))
    device.begin(255) or >>
    assert(bad_draw(&scene,$&device,&tree,view))
    device.present() or >>
    first := scene.select_lods(&tree,fm.vec3(0.0,0.0,5.0)) or >>
    assert(first.nodes==1 && first.changed==1 && first.levels[0]==1)
    compare(&scene,$&device,&tree,&high,4,0) or >>
    scene.select_lods(&tree,fm.vec3(0.0,0.0,15.0)) or >>
    assert((scene.lod_level(node) or >>)==1)
    compare(&scene,$&device,&tree,&medium,2,2) or >>
    scene.select_lods(&tree,fm.vec3(0.0,0.0,10.0)) or >>
    assert((scene.lod_level(node) or >>)==1)
    scene.select_lods(&tree,fm.vec3(0.0,0.0,8.0)) or >>
    assert((scene.lod_level(node) or >>)==0)
    scene.select_lods(&tree,fm.vec3(0.0,0.0,25.0)) or >>
    compare(&scene,$&device,&tree,&low,1,3) or >>
    assert(bad_lods($&scene,&tree,node,[low.reference(),high.reference()],&pair))
    assert(bad_lods($&scene,&tree,node,[high.reference(),low.reference()],&policy))
    assert((scene.lod_level(node) or >>)==2 && scene.binding_count()==1)
    // World origin distance includes parent transforms; scaling has no implicit
    // projected-size effect on this authored world-distance policy.
    tree.set_position_3d(parent,fm.vec3(10.0,0.0,0.0)) or >>
    tree.set_position_3d(node,fm.vec3(5.0,0.0,0.0)) or >>
    scene.select_lods(&tree,fm.vec3(0.0,0.0,0.0)) or >>
    assert((scene.lod_level(node) or >>)==1)
    device.begin(255) or >>
    culled := scene.draw($&device,&tree,view) or >>
    assert(culled.instances==0 && culled.culled_triangles==2 && culled.lod_triangles_saved==0)
    device.present() or >>
    tree.set_position_3d(parent,fm.vec3(0.0,0.0,0.0)) or >>
    tree.set_position_3d(node,fm.vec3(0.0,0.0,0.0)) or >>
    // Selection uses the chosen mesh's own bounds for frustum and light tests.
    scene.attach_lods(&tree,node,[high.reference(),shifted.reference()],&pair) or >>
    scene.select_lods(&tree,fm.vec3(0.0,0.0,25.0)) or >>
    device.begin(255) or >>
    assert((scene.draw($&device,&tree,view) or >>).culled_instances==1)
    device.present() or >>
    material := ren.material_3d(fm.vec3(1.0,1.0,1.0),0.0,1.0,fm.vec3(0.0,0.0,0.0)) or >>
    scene.set_material(&tree,node,material) or >>
    env := lights.environment(fm.vec3(0.0,0.0,0.0),fm.vec3(2.0,0.0,2.0),1.0,
        [lights.point(fm.vec3(2.0,0.0,1.0),fm.vec3(1.0,1.0,1.0),1.2) or >>]) or >>
    device.begin(255) or >>
    lit := scene.draw_lit($&device,&tree,fm.translation_3d(fm.vec3(-2.0+1.0/64.0,-1.0/64.0,0.5)),&env) or >>
    assert(lit.instances==1 && lit.triangles==1 && lit.lod_triangles_saved==3)
    assert((device.lighting_stats() or >>).selected==1 && (device.read_pixel(32,32) or >>)!=255)
    device.present() or >>
    scene.attach_lods(&tree,node,[high.reference(),medium.reference(),low.reference()],&policy) or >>
    scene.select_lods(&tree,fm.vec3(0.0,0.0,5.0)) or >>
    pixels := [4294967295]
    $texture := device.texture_rgba(1,1,&pixels,true,false,false) or >>
    textured := material.with_base_texture(&texture) or >>
    assert(bad_material($&scene,&tree,node,textured))
    texture.close() or >>
    scene.clear_material(node) or >>
    // A later invalid group cannot publish an earlier group's level change.
    $unused := device.upload(&medium_data) or >>
    other := tree.add_child_3d(tree.root(),"Other") or >>
    scene.attach_lods(&tree,other,[high.reference(),unused.reference()],&pair) or >>
    tree.set_position_3d(other,fm.vec3(15.0,0.0,0.0)) or >>
    selection := scene.select_lods(&tree,fm.vec3(0.0,0.0,0.0)) or >>
    assert(selection.levels[0]==1 && selection.levels[1]==1)
    tree.set_position_3d(other,fm.vec3(0.0,0.0,0.0)) or >>
    scene.select_lods(&tree,fm.vec3(0.0,0.0,0.0)) or >>
    unused.close() or >>
    assert(bad_select($&scene,&tree,fm.vec3(0.0,0.0,30.0)))
    assert((scene.lod_level(node) or >>)==0 && (scene.lod_level(other) or >>)==0)
    tree.set_visible(node,false) or >>
    device.begin(255) or >>
    assert(bad_draw(&scene,$&device,&tree,view))
    assert((device.read_pixel(32,32) or >>)==255)
    device.present() or >>
    // Replacement with a single mesh or complete surface clears the LOD state.
    scene.attach_mesh(&tree,other,&high) or >>
    assert((scene.lod_level(other) or >>)==0)
    scene.attach_lods(&tree,other,[high.reference(),medium.reference()],&pair) or >>
    scene.attach_surface(&tree,other,&high,material) or >>
    scene.clear_material(other) or >>
    assert((scene.lod_level(other) or >>)==0)
    tree.set_visible(node,true) or >>
    scene.select_lods(&tree,fm.vec3(0.0,0.0,30.0)) or >>
    assert((scene.lod_level(node) or >>)==2)
    tree.queue_free(other) or >>
    assert((scene.select_lods(&tree,fm.vec3(0.0,0.0,30.0)) or >>).nodes==1)
    assert((scene.prune(&tree) or >>)==1 && (scene.lod_level(node) or >>)==2)
    tree.flush_free() or >>
    replacement := tree.add_child_3d(tree.root(),"Replacement") or >>
    assert(replacement!=other && bad_level(&scene,replacement))
    compare(&scene,$&device,&tree,&low,1,3) or >>
    // Prune direct surface and LOD bindings after their nodes have been flushed.
    lod_node := tree.add_child_3d(tree.root(),"RetiredLod") or >>
    scene.attach_lods(&tree,lod_node,[high.reference(),medium.reference()],&pair) or >>
    scene.attach_surface(&tree,replacement,&high,material) or >>
    assert(scene.binding_count()==3)
    tree.queue_free(lod_node) or >>
    tree.queue_free(replacement) or >>
    tree.flush_free() or >>
    assert((scene.prune(&tree) or >>)==2 && scene.binding_count()==1)
    assert((scene.prune(&tree) or >>)==0 && (scene.lod_level(node) or >>)==2)
    compare(&scene,$&device,&tree,&low,1,3) or >>
    $foreign_device := ren.open_3d("Foreign LOD",16,16,gpu.AUTO,&program) or >>
    $foreign := foreign_device.upload(&low_data) or >>
    assert(bad_lods($&scene,&tree,node,[high.reference(),foreign.reference()],&pair))
    assert((scene.lod_level(node) or >>)==2 && scene.binding_count()==1)
    foreign.close() or >>
    foreign_device.close() or >>
    scene.detach_mesh(node) or >>
    assert(scene.binding_count()==0 && bad_level(&scene,node))
    device.begin(255) or >>
    device.draw(&high,view) or >>
    device.draw(&low,view) or >>
    device.present() or >>
    shifted.close() or >>
    low.close() or >>
    medium.close() or >>
    high.close() or >>
    device.close() or >>
    println("PASS: Metal LOD 4/2/1 triangles, exact selected-mesh PNGs, hysteresis/world distance, chosen frustum/light bounds, all-level material/resource preflight, atomic selection/binding failures, independent nodes, replacement, prune/generation and non-owning detach")
    << 0
}
fn main() int { << run() or(err){ eprintln(err.msg())
    << 1 } }
