@main

#gpu

canvas_shaders #"github.com/xulang-org/nexus/assets/shaders/two_d"

ren_data #"github.com/xulang-org/nexus/resources/canvas"

ren #"github.com/xulang-org/nexus/rendering/two_d"
fm #"github.com/xulang-org/nexus/foundation/math"
colors #"github.com/xulang-org/nexus/foundation/color"
images #"github.com/xulang-org/nexus/assets/image"
image_render #"github.com/xulang-org/nexus/integration/image_render/two_d"
#os

fn rejected(renderer $&ren.Renderer2D, batch &ren_data.Batch2D, texture &ren.Texture2D) bool {
    renderer.submit_texture(batch, texture) or (err) { << true }
    << false
}
fn invalid_quad(batch $&ren_data.Batch2D, white int) bool {
    batch.quad_region(fm.rect2(0.0, 0.0, 10.0, 10.0), fm.identity(), white,
        fm.rect2(0.9, 0.0, 0.2, 1.0)) or (err) { << true }
    << false
}
fn run() int {
    args := os.args()
    assert(args.len == 2)
    $image := images.load_png(args[1] + "") or >>
    canvas_program_0 := canvas_shaders.load_canvas("build/canvas-shaders") or >>
    $renderer := ren.open_2d("Independent 2D service", 128, 128, gpu.AUTO, &canvas_program_0) or >>
    white := colors.rgba8(255, 255, 255, 255) or >>
    black := colors.rgba8(0, 0, 0, 255) or >>
    red := colors.rgba8(255, 0, 0, 255) or >>
    $texture := image_render.upload_image_2d(&renderer, &image, false) or >>
    // The uploader must copy CPU pixels synchronously, with independent storage.
    image.pixels[0] = black
    $batch := ren_data.new_batch()
    batch.quad(fm.rect2(0.0, 0.0, 128.0, 128.0), fm.identity(), white) or >>
    renderer.begin(black) or >>
    assert((renderer.submit_texture(&batch, &texture) or >>) == 2)
    assert((renderer.read_pixel(16, 16) or >>) == red)
    assert((renderer.read_pixel(96, 16) or >>) == 16711935)
    renderer.present() or >>
    // Scene-free geometry validation leaves an existing batch intact on failure.
    before := batch.vertex_count()
    assert(invalid_quad($&batch, white))
    assert(batch.vertex_count() == before)
    canvas_program_1 := canvas_shaders.load_canvas("build/canvas-shaders") or >>
    $other := ren.open_2d("Foreign 2D owner", 64, 64, gpu.AUTO, &canvas_program_1) or >>
    other.begin(black) or >>
    assert(rejected($&other, &batch, &texture))
    other.present() or >>
    other.close() or >>
    texture.close() or >>
    $fresh := image_render.upload_image_2d(&renderer, &image, false) or >>
    renderer.begin(black) or >>
    assert(rejected($&renderer, &batch, &texture))
    renderer.submit_texture(&batch, &fresh) or >>
    assert((renderer.read_pixel(16, 16) or >>) == black)
    renderer.present() or >>
    renderer.close() or >>
    fresh.close() or >>
    println("PASS: independent 2D service build without scene package or bindings, immutable upload, GPU sampling, foreign/closed resources")
    << 0
}
fn main() int { << run() or (err) { eprintln(err.msg())
    << 1 } }
