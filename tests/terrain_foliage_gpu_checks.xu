@main

#gpu
#math
#errors
fm #"github.com/xulang-org/nexus/foundation/math"
mesh #"github.com/xulang-org/nexus/resources/mesh"
lights #"github.com/xulang-org/nexus/resources/lighting"
terr #"github.com/xulang-org/nexus/resources/terrain"
phys #"github.com/xulang-org/nexus/physics3d"
nexus #"github.com/xulang-org/nexus/scene"
ren #"github.com/xulang-org/nexus/rendering/three_d"
shd #"github.com/xulang-org/nexus/assets/shaders/three_d"
modern #"github.com/xulang-org/nexus/integration/rendering/three_d"
tbridge #"github.com/xulang-org/nexus/integration/terrain"

fn ch_r(c int) int { << (c >> 24) & 255 }
fn ch_g(c int) int { << (c >> 16) & 255 }
fn ch_b(c int) int { << (c >> 8) & 255 }
fn abs_i(v int) int { if v < 0 { << -v } << v }
fn luma(c int) int { << ch_r(c) + ch_g(c) + ch_b(c) }

fn check_heightmap_lod_physics_and_scatter() int {
    // 1. Procedural terrain + exact triangle-aligned height/normal sampling.
    cfg := terr.TerrainConfig{
        width: 65,
        depth: 65,
        origin: fm.vec3(-32.0, 0.0, -32.0),
        cell_size: 1.0,
        height_scale: 1.0
    }
    terrain := terr.generate_procedural_terrain(cfg, 4242, 4, 0.06, 8.0, 0.40) or >>

    // Verify exact vertex match and interior triangle barycentric height.
    vh := terrain.vertex_height(20, 24)
    sh := terrain.sample_height(-12.0, -8.0)
    if math.abs(vh - sh) > 1e-6 {
        >> errors.new("terrain vertex/sample height mismatch")
    }
    sn := terrain.sample_normal(-10.3, -6.7)
    if !sn.is_finite() || math.abs(sn.length() - 1.0) > 1e-3 || sn.y <= 0.0 {
        >> errors.new("terrain sampled normal invalid")
    }

    // 2. Chunked LOD meshes (0, 1, 2) + crack-preventing skirts.
    dims := terrain.chunk_grid_dims(16) or >>
    if dims[0] != 4 || dims[1] != 4 {
        >> errors.new("terrain expected 4x4 chunks for 65x65 grid at chunk_cells=16")
    }
    m0 := terrain.build_chunk_mesh(terr.TerrainChunkSpec{
        chunk_x: 0, chunk_z: 0, start_x: 0, start_z: 0,
        cells_x: 16, cells_z: 16, lod: 0, skirt_depth: 1.5, bake_splat_tint: false
    }) or >>
    m1 := terrain.build_chunk_mesh(terr.TerrainChunkSpec{
        chunk_x: 0, chunk_z: 0, start_x: 0, start_z: 0,
        cells_x: 16, cells_z: 16, lod: 1, skirt_depth: 1.5, bake_splat_tint: false
    }) or >>
    m2 := terrain.build_chunk_mesh(terr.TerrainChunkSpec{
        chunk_x: 0, chunk_z: 0, start_x: 0, start_z: 0,
        cells_x: 16, cells_z: 16, lod: 2, skirt_depth: 1.5, bake_splat_tint: false
    }) or >>
    if m0.triangle_count() <= m1.triangle_count() || m1.triangle_count() <= m2.triangle_count() {
        >> errors.new("terrain LOD triangle reduction broken")
    }
    $edge_min_y := 1e30
    for gx in 0:17 {
        h0 := terrain.vertex_height(gx, 0)
        h1 := terrain.vertex_height(gx, 16)
        if h0 < edge_min_y { edge_min_y = h0 }
        if h1 < edge_min_y { edge_min_y = h1 }
    }
    for gz in 0:17 {
        h0 := terrain.vertex_height(0, gz)
        h1 := terrain.vertex_height(16, gz)
        if h0 < edge_min_y { edge_min_y = h0 }
        if h1 < edge_min_y { edge_min_y = h1 }
    }
    $min_vert_y := 1e30
    for i in 0:m0.vertices.len {
        if m0.vertices[i].position.y < min_vert_y {
            min_vert_y = m0.vertices[i].position.y
        }
    }
    if min_vert_y > edge_min_y - 1.49 {
        >> errors.new("terrain chunk skirt vertices did not extend downward")
    }

    // 3. Exact heightfield raycast & Physics3D RigidWorld3D collision on central 32x32 slice (2048 tris).
    tris := tbridge.terrain_region_static_triangles(&terrain, 16, 16, 32, 32, 0, 1) or >>
    if tris.len != 2048 {
        >> errors.new("terrain_region_static_triangles expected 2048 triangles")
    }
    $rworld := phys.new_rigid_world(fm.vec3(0.0, -9.8, 0.0), []phys.StaticBox3D{}, []phys.StaticRamp3D{}, tris) or >>

    // Compare heightfield DDA raycast vs BVH StaticTriangle3D raycast on tilted rays.
    origins := [fm.vec3(-8.0, 25.0, -8.0), fm.vec3(4.5, 25.0, 3.2)]
    dirs := [fm.vec3(0.15, -1.0, 0.12), fm.vec3(-0.1, -1.0, 0.08)]
    for ri in 0:2 {
        thit := terrain.raycast(origins[ri], dirs[ri], 60.0) or >>
        phit := rworld.raycast_all(origins[ri], dirs[ri], 60.0, 1) or >>
        if !thit.hit || phit.kind != phys.HIT_STATIC_TRIANGLE {
            >> errors.new("terrain raycast or physics raycast missed terrain")
        }
        if math.abs(thit.distance - phit.distance) > 0.002 {
            >> errors.new("terrain raycast distance diverged from Physics3D triangle raycast")
        }
    }

    // Find a sloped spot inside [-14, 14]^2 and drop a dynamic sphere onto terrain triangles.
    $drop_x := 0.0
    $drop_z := 0.0
    $best_slope := 1.0
    for sz in -12:12 {
        for sx in -12:12 {
            wx := f64(sx) + 0.3
            wz := f64(sz) + 0.3
            n := terrain.sample_normal(wx, wz)
            if n.y < best_slope {
                best_slope = n.y
                drop_x = wx
                drop_z = wz
            }
        }
    }
    start_h := terrain.sample_height(drop_x, drop_z)
    sph_id := rworld.add_body(phys.dynamic_sphere_3d(fm.vec3(drop_x, start_h + 2.2, drop_z), 0.45, 1.0, 0.2, 0.15) or >>) or >>
    $had_contact := false
    for _ in 0:90 {
        rep := rworld.step(0.016, 4, 8) or >>
        if rep.contacts > 0 || rep.ccd_hits > 0 { had_contact = true }
    }
    b := rworld.body(sph_id) or >>
    surf_at_b := terrain.sample_height(b.position.x, b.position.z)
    horiz_move := math.sqrt((b.position.x - drop_x) * (b.position.x - drop_x) + (b.position.z - drop_z) * (b.position.z - drop_z))
    if !had_contact || horiz_move < 0.08 || b.position.y < surf_at_b + 0.25 {
        >> errors.new("RigidWorld3D sphere failed to collide/roll cleanly on terrain triangles")
    }

    // 4. Procedural terrain filtered scatter (slope & splat checks).
    $scfg_f := terr.default_foliage_scatter_config(99)
    scfg_f.spacing = 1.2
    scfg_f.min_normal_y = 0.82
    scfg_f.splat_channel = 0
    scfg_f.min_splat_weight = 0.35
    scfg_f.max_instances = 4096
    filt := terrain.scatter_foliage(&scfg_f) or >>
    if filt.len < 50 {
        >> errors.new("filtered procedural terrain scatter yielded too few placements")
    }
    for i in 0:filt.len {
        p := &filt[i]
        ey := terrain.sample_height(p.position.x, p.position.z)
        en := terrain.sample_normal(p.position.x, p.position.z)
        esp := terrain.sample_splat(p.position.x, p.position.z)
        if math.abs(p.position.y - ey) > 1e-5 || en.y < 0.82 || esp.x < 0.35 {
            >> errors.new("foliage scatter violated height, slope, or splat mask constraint")
        }
    }

    << m0.triangle_count()
}

fn check_gpu_terrain_splat_and_foliage(lod0_tris int) int {
    prog := shd.load_mesh("build/mesh-shaders") or >>
    cprog := shd.load_clustered_program("build/mesh-shaders") or >>
    iprog := shd.load_indirect_program("build/mesh-shaders") or >>
    pprog := shd.load_postprocess_program("build/mesh-shaders") or >>
    vprog := shd.load_particle_program("build/mesh-shaders") or >>
    tprog := shd.load_terrain_program("build/mesh-shaders") or >>
    fprog := shd.load_foliage_program("build/mesh-shaders") or >>

    $device := ren.open_3d("Terrain + Foliage GPU Checks", 256, 192, gpu.METAL, &prog) or >>
    $mp := modern.new_modern_pipeline_3d(&device, &cprog, &iprog, &pprog) or >>
    $tren := device.terrain_renderer(&tprog) or >>

    $irr_grid := ren.irradiance_grid_3d(fm.vec3(-40.0, -5.0, -40.0), fm.vec3(80.0, 20.0, 80.0), 2, 2, 2) or >>
    irr_grid.bake_hemisphere(fm.vec3(0.3, 0.35, 0.45), fm.vec3(0.12, 0.12, 0.10), fm.vec3(0.0, 1.0, 0.0), fm.vec3(0.2, 0.2, 0.2)) or >>
    $irr_gpu := irr_grid.upload(&device) or >>
    empty_tq := ren.new_transparent_queue_3d()
    $empty_ps := device.gpu_particle_system(&vprog, 1, 1) or >>

    $pp_cfg := ren.post_process_defaults_3d()
    pp_cfg.ao_enabled = false
    pp_cfg.ssr_enabled = false
    pp_cfg.bloom_enabled = false
    pp_cfg.taa_enabled = false

    // --- 5. Multi-Layer Terrain Splatting + Chunk LOD Selection ---
    qcfg := terr.TerrainConfig{
        width: 33,
        depth: 33,
        origin: fm.vec3(-16.0, 0.0, -16.0),
        cell_size: 1.0,
        height_scale: 1.0
    }
    $qheights := []f64{}
    for _ in 0:(33 * 33) { qheights.push(0.0) }
    $qterrain := terr.new_heightmap_terrain(qcfg, qheights) or >>
    for iz in 0:33 {
        for ix in 0:33 {
            if ix < 16 && iz < 16 {
                qterrain.set_splat(ix, iz, 1.0, 0.0, 0.0, 0.0) or >>
            } else if ix >= 16 && iz < 16 {
                qterrain.set_splat(ix, iz, 0.0, 1.0, 0.0, 0.0) or >>
            } else if ix < 16 && iz >= 16 {
                qterrain.set_splat(ix, iz, 0.0, 0.0, 1.0, 0.0) or >>
            } else {
                qterrain.set_splat(ix, iz, 0.0, 0.0, 0.0, 1.0) or >>
            }
        }
    }
    $tc_quad := tbridge.new_terrain_chunked_gpu_3d(&device, &qterrain, 8, 3, 1.0, false) or >>

    z_near := 0.25
    z_far := 120.0
    aspect := 256.0 / 192.0
    top_eye := fm.vec3(0.0, 18.0, 0.01)
    top_view := nexus.look_at_3d(top_eye, fm.vec3(0.0, 0.0, 0.0), fm.vec3(0.0, 0.0, -1.0)) or >>
    top_proj := nexus.perspective_3d(1.0, aspect, z_near, z_far) or >>
    top_vp := top_proj.multiply(top_view)
    lod_dists := [12.0, 22.0]

    // Verify LOD distance selection & frustum culling across angled view.
    side_eye := fm.vec3(-15.0, 4.0, -15.0)
    side_view := nexus.look_at_3d(side_eye, fm.vec3(10.0, 0.0, 10.0), fm.vec3(0.0, 1.0, 0.0)) or >>
    side_sel := tc_quad.select_visible_chunks(side_eye, top_proj.multiply(side_view), &lod_dists) or >>
    if side_sel.stats.lod0_chunks == 0 || (side_sel.stats.lod1_chunks + side_sel.stats.lod2_plus_chunks) == 0 {
        >> errors.new("terrain chunk LOD selection did not mix LOD0 and higher LODs")
    }

    top_sel := tc_quad.select_visible_chunks(top_eye, top_vp, &lod_dists) or >>
    top_sun := lights.directional(fm.vec3(0.0, 1.0, 0.0), fm.vec3(1.8, 1.8, 1.8)) or >>
    top_suns := [top_sun]
    mp.prepare_lights(&device, fm.vec3(0.25, 0.25, 0.25), top_eye, 1.0, &top_suns, top_view, top_proj, z_near, z_far) or >>

    $tmat := ren.default_terrain_material_3d(-16.0, -16.0, 32.0, 32.0)
    tmat.splat_texture = tc_quad.splat_texture_ref()
    tmat.layers[0].albedo = fm.vec3(0.05, 0.92, 0.05) // Grass (Green)
    tmat.layers[1].albedo = fm.vec3(0.92, 0.35, 0.05) // Dirt (Warm Brown/Orange)
    tmat.layers[2].albedo = fm.vec3(0.10, 0.25, 0.95) // Rock (Slate Blue)
    tmat.layers[3].albedo = fm.vec3(0.95, 0.95, 0.95) // Snow (White)
    tmat.blend_sharpness = 0.0

    $dummy_batch_inst := [ren.FoliageInstance3D{position: fm.vec3(0.0, -100.0, 0.0), yaw: 0.0, scale: 1.0, height_scale: 1.0, bend_phase: 0.0, tint: fm.vec3(1.0, 1.0, 1.0), variation: 0.0}]
    dummy_grass := terr.build_grass_clump_mesh(1, 0.1, 0.1) or >>
    $dummy_fol := device.foliage_batch(&fprog, &dummy_grass, &dummy_batch_inst) or >>
    dummy_wind := ren.default_foliage_wind_3d()
    dummy_fmat := ren.default_foliage_material_3d()

    mp.render_terrain_foliage_frame(
        $&device, &tren, &top_sel.refs, &top_sel.worlds, &tmat,
        false, &dummy_fol, &dummy_wind, &dummy_fmat,
        false, &irr_gpu, 0.0, false, &empty_tq, false, &empty_ps,
        top_eye, top_view, top_proj, z_near, z_far, 255, &pp_cfg
    ) or >>
    px_q0 := device.read_pixel(64, 48) or >>
    px_q1 := device.read_pixel(192, 48) or >>
    px_q2 := device.read_pixel(64, 144) or >>
    px_q3 := device.read_pixel(192, 144) or >>
    device.present() or >>

    if ch_g(px_q0) <= ch_r(px_q0) + 40 || ch_g(px_q0) <= ch_b(px_q0) + 40 {
        >> errors.new("terrain splat Q0 (grass) not green-dominant")
    }
    if ch_r(px_q1) <= ch_b(px_q1) + 40 {
        >> errors.new("terrain splat Q1 (dirt) not warm R>B")
    }
    if ch_b(px_q2) <= ch_r(px_q2) + 40 {
        >> errors.new("terrain splat Q2 (rock) not slate blue B>R")
    }
    if ch_r(px_q3) < 160 || ch_g(px_q3) < 160 || ch_b(px_q3) < 160 {
        >> errors.new("terrain splat Q3 (snow) not bright white")
    }
    dummy_fol.close() or >>
    tc_quad.close() or >>

    // --- 6. 16,384 GPU Instanced Foliage: Compute Cull + Wind Sway + Backlit SSS ---
    fcfg := terr.TerrainConfig{
        width: 65,
        depth: 65,
        origin: fm.vec3(-32.0, 0.0, -32.0),
        cell_size: 1.0,
        height_scale: 1.0
    }
    $mheights := []f64{}
    for iz in 0:65 {
        for ix in 0:65 {
            mheights.push(0.08 * math.sin(f64(ix) * 0.25) * math.cos(f64(iz) * 0.25))
        }
    }
    meadow := terr.new_heightmap_terrain(fcfg, mheights) or >>
    $tc_meadow := tbridge.new_terrain_chunked_gpu_3d(&device, &meadow, 16, 2, 0.5, false) or >>

    $scfg := terr.default_foliage_scatter_config(2026)
    scfg.spacing = 0.44
    scfg.min_normal_y = 0.5
    scfg.splat_channel = -1
    scfg.density_probability = 1.0
    scfg.scale_min = 1.0
    scfg.scale_max = 1.25
    scfg.height_scale_min = 0.95
    scfg.height_scale_max = 1.30
    scfg.max_instances = 16384
    placements := meadow.scatter_foliage(&scfg) or >>
    if placements.len != 16384 {
        >> errors.new("expected 16384 grass clump placements for GPU batch test")
    }

    grass_mesh := terr.build_grass_clump_mesh(3, 0.28, 1.15) or >>
    $fol_batch := tbridge.upload_foliage_placements(&device, &fprog, &grass_mesh, &placements) or >>

    f_eye := fm.vec3(0.0, 1.35, 8.0)
    f_view := nexus.look_at_3d(f_eye, fm.vec3(0.0, 0.55, -6.0), fm.vec3(0.0, 1.0, 0.0)) or >>
    f_proj := nexus.perspective_3d(0.95, aspect, z_near, z_far) or >>
    f_vp := f_proj.multiply(f_view)

    fol_batch.cull(&device, f_eye, f_vp, 14.0, 22.0) or >>
    cstats := fol_batch.readback_stats(&device) or >>
    if cstats.visible + cstats.frustum_culled + cstats.distance_culled != 16384 ||
        cstats.visible <= 500 || cstats.frustum_culled <= 500 || cstats.distance_culled <= 500 {
        >> errors.new("GPU compute foliage culling stats check failed")
    }

    m_lods := [20.0, 40.0]
    m_sel := tc_meadow.select_visible_chunks(f_eye, f_vp, &m_lods) or >>
    // Backlit sun (pointing -Z behind grass field toward camera).
    back_sun := lights.directional(fm.vec3(0.0, 0.25, -0.968).normalized() or >>, fm.vec3(2.8, 2.7, 2.4)) or >>
    back_suns := [back_sun]
    mp.prepare_lights(&device, fm.vec3(0.18, 0.20, 0.22), f_eye, 1.0, &back_suns, f_view, f_proj, z_near, z_far) or >>

    $m_mat := ren.default_terrain_material_3d(-32.0, -32.0, 64.0, 64.0)
    m_mat.splat_texture = tc_meadow.splat_texture_ref()
    m_mat.layers[0].albedo = fm.vec3(0.20, 0.16, 0.12) // Dark soil so green grass stands out clearly

    $wind := ren.default_foliage_wind_3d()
    wind.strength = 0.0
    wind.gust_strength = 0.0
    wind.time = 0.0

    $fmat := ren.default_foliage_material_3d()
    fmat.translucency = 0.0
    fmat.dither_fade = true

    // 6a. Bare terrain vs terrain + foliage.
    mp.render_terrain_foliage_frame(
        $&device, &tren, &m_sel.refs, &m_sel.worlds, &m_mat,
        false, &fol_batch, &wind, &fmat,
        false, &irr_gpu, 0.0, false, &empty_tq, false, &empty_ps,
        f_eye, f_view, f_proj, z_near, z_far, 255, &pp_cfg
    ) or >>
    $bare_px := []int{}
    for py in 72:176 {
        for px in 24:232 {
            bare_px.push(device.read_pixel(px, py) or >>)
        }
    }
    device.present() or >>

    mp.render_terrain_foliage_frame(
        $&device, &tren, &m_sel.refs, &m_sel.worlds, &m_mat,
        true, &fol_batch, &wind, &fmat,
        false, &irr_gpu, 0.0, false, &empty_tq, false, &empty_ps,
        f_eye, f_view, f_proj, z_near, z_far, 255, &pp_cfg
    ) or >>
    $fol0_px := []int{}
    $fol_diff := 0
    $base_luma_sum := 0
    for py in 72:176 {
        for px in 24:232 {
            c := device.read_pixel(px, py) or >>
            b := bare_px[fol0_px.len]
            if abs_i(ch_r(c) - ch_r(b)) + abs_i(ch_g(c) - ch_g(b)) + abs_i(ch_b(c) - ch_b(b)) > 20 {
                fol_diff += 1
            }
            base_luma_sum += luma(c)
            fol0_px.push(c)
        }
    }
    device.present() or >>
    if fol_diff < 500 {
        >> errors.new("GPU instanced foliage failed to draw noticeably over terrain")
    }

    // 6b. GPU Wind Vertex Sway check (t=0, str=0 vs t=1.4, str=0.85).
    wind.strength = 0.85
    wind.gust_strength = 0.25
    wind.time = 1.4
    mp.render_terrain_foliage_frame(
        $&device, &tren, &m_sel.refs, &m_sel.worlds, &m_mat,
        true, &fol_batch, &wind, &fmat,
        false, &irr_gpu, 0.0, false, &empty_tq, false, &empty_ps,
        f_eye, f_view, f_proj, z_near, z_far, 255, &pp_cfg
    ) or >>
    $wind_diff := 0
    $wind_luma_sum := 0
    $idx := 0
    for py in 72:176 {
        for px in 24:232 {
            c := device.read_pixel(px, py) or >>
            c0 := fol0_px[idx]
            if abs_i(ch_r(c) - ch_r(c0)) + abs_i(ch_g(c) - ch_g(c0)) + abs_i(ch_b(c) - ch_b(c0)) > 12 {
                wind_diff += 1
            }
            wind_luma_sum += luma(c)
            idx += 1
        }
    }
    device.present() or >>
    if wind_diff < 100 {
        >> errors.new("GPU wind animation produced insufficient pixel delta")
    }

    // 6c. Backlit Subsurface Scattering check (translucency=0 vs 2.2 at same wind pose).
    fmat.translucency = 2.2
    mp.render_terrain_foliage_frame(
        $&device, &tren, &m_sel.refs, &m_sel.worlds, &m_mat,
        true, &fol_batch, &wind, &fmat,
        false, &irr_gpu, 0.0, false, &empty_tq, false, &empty_ps,
        f_eye, f_view, f_proj, z_near, z_far, 255, &pp_cfg
    ) or >>
    $sss_luma_sum := 0
    for py in 72:176 {
        for px in 24:232 {
            c := device.read_pixel(px, py) or >>
            sss_luma_sum += luma(c)
        }
    }
    device.present() or >>
    if sss_luma_sum <= wind_luma_sum + 20000 {
        >> errors.new("backlit foliage SSS translucency did not increase backlit radiance")
    }

    fol_batch.close() or >>
    tc_meadow.close() or >>
    empty_ps.close() or >>
    irr_gpu.close() or >>
    tren.close() or >>
    mp.close() or >>
    device.close() or >>

    println("PASS: Heightmap/LOD+Skirts + Physics3D Triangles + 16384 Foliage Compute Cull/Wind/SSS (lod0_tris=" + str(lod0_tris) +
        ", vis=" + str(cstats.visible) + ", f_culled=" + str(cstats.frustum_culled) +
        ", d_culled=" + str(cstats.distance_culled) + ", fol_px=" + str(fol_diff) +
        ", wind_px=" + str(wind_diff) + ", sss_delta=" + str(sss_luma_sum - wind_luma_sum) + ")")
    << 0
}

fn main() int {
    lod0_tris := check_heightmap_lod_physics_and_scatter() or (err) {
        println("FAIL CPU terrain/physics: " + err.msg())
        << 1
    }
    check_gpu_terrain_splat_and_foliage(lod0_tris) or (err) {
        println("FAIL GPU terrain/foliage: " + err.msg())
        << 1
    }
    << 0
}
