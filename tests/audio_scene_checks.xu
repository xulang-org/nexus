@main

fm #"github.com/xulang-org/nexus/foundation/math"
#math
nexus #"github.com/xulang-org/nexus/scene"
scene_audio #"github.com/xulang-org/nexus/integration/audio"
mix #"github.com/xulang-org/nexus/audio/mixer"
pcm #"github.com/xulang-org/nexus/resources/audio"

fn run() int {
    $tree := nexus.new_scene_tree("World", 8) >>>
    node := tree.add_child(tree.root(), "Sound") >>>
    $mixer := mix.new_mixer(48000, 4) >>>
    source := pcm.pcm16(48000, 1, [1000, -1000]) >>>
    clip := mixer.add_clip(source) >>>
    $scene := scene_audio.new_scene_audio()
    voice := scene.play(&tree, $&mixer, node, clip, 0, 1.0, 0.0, true) >>>
    first := mixer.render(1) >>>
    assert(first[0] == 1000)
    listener := tree.add_child(tree.root(), "Listener") >>>
    tree.set_position(node, fm.vec2(5.0, 0.0)) >>>
    spatial := scene.spatial_2d(&tree, $&mixer, node, listener, 10.0, 1.0) >>>
    assert(spatial.volume == 0.25 && spatial.pan == 1.0)
    balanced := mixer.render(2) >>>
    assert(balanced[0] == 0 && balanced[1] == -250)
    tree.set_position(node, fm.vec2(0.0, 0.0)) >>>
    scene.spatial_2d(&tree, $&mixer, node, listener, 10.0, 1.0) >>>
    tree.paused = true
    scene.sync(&tree, $&mixer) >>>
    paused := mixer.render(1) >>>
    assert(paused[0] == 0 && (mixer.position_frames(voice) >>>) == 1.0)
    tree.set_process_mode(node, nexus.PROCESS_ALWAYS) >>>
    scene.sync(&tree, $&mixer) >>>
    active := mixer.render(1) >>>
    assert(active[0] == -1000)
    tree.queue_free(node) >>>
    assert((scene.sync(&tree, $&mixer) >>>) == 1 && !(mixer.is_playing(voice) >>>))
    tree.flush_free() >>>
    replacement := tree.add_child(tree.root(), "NewSound") >>>
    assert(replacement != node)
    fresh := scene.play(&tree, $&mixer, replacement, clip, 0, 1.0, 0.0, true) >>>
    mixer.stop(fresh) >>>
    independent := mixer.play(clip, 0, 1.0, 0.0, true) >>>
    assert(!mixer.is_voice(fresh))
    assert((scene.sync(&tree, $&mixer) >>>) == 1 && (mixer.is_playing(independent) >>>))
    assert(scene.binding_count() == 0 && (scene.detach($&mixer, replacement) >>>) == 0)
    source3d := tree.add_child_3d(tree.root(), "Source3D") >>>
    listener3d := tree.add_child_3d(tree.root(), "Listener3D") >>>
    scene.play(&tree, $&mixer, source3d, clip, 0, 1.0, 0.0, true) >>>
    tree.set_position_3d(source3d, fm.vec3(5.0, 0.0, 0.0)) >>>
    right := scene.spatial_3d(&tree, $&mixer, source3d, listener3d, 10.0, 1.0) >>>
    assert(right.pan == 1.0 && right.volume == 0.25)
    tree.set_transform_3d(listener3d, fm.rotation_y(math.pi())) >>>
    left := scene.spatial_3d(&tree, $&mixer, source3d, listener3d, 10.0, 1.0) >>>
    assert(left.pan < -0.999999 && left.volume == 0.25)
    far := mix.spatial_3d(fm.vec3(0.0, 20.0, 0.0), fm.vec3(0.0, 0.0, 0.0), fm.vec3(1.0, 0.0, 0.0), 10.0) >>>
    assert(far.volume == 0.0)
    scene.detach($&mixer, source3d) >>>
    mixer.stop(independent) >>>
    ring := mixer.open_stream(48000, 1, 2) >>>
    samples := [1000, -1000]
    mixer.feed_stream(ring, &samples, true) >>>
    tree.paused = false
    stream_voice := scene.play_stream(&tree, $&mixer, listener3d, ring, 0, 1.0, 0.0) >>>
    first_stream := mixer.render(1) >>>
    assert(first_stream[0] == 1000)
    tree.paused = true
    scene.sync(&tree, $&mixer) >>>
    paused_stream := mixer.render(1) >>>
    assert(paused_stream[0] == 0 && (mixer.position_frames(stream_voice) >>>) == 1.0)
    replacement_pcm := [2000, -2000]
    mixer.reset_stream(ring, &replacement_pcm, true, false) >>>
    assert(mixer.is_voice(stream_voice) && scene.binding_count() == 1)
    tree.paused = false
    scene.sync(&tree, $&mixer) >>>
    positioned := mixer.render(1) >>>
    assert(positioned[0] == 2000)
    tree.queue_free(listener3d) >>>
    scene.sync(&tree, $&mixer) >>>
    assert(!(mixer.is_playing(stream_voice) >>>))
    mixer.close_stream(ring) >>>
    println("PASS: node audio pause/process modes, queue/free, and node/voice generation isolation")
    << 0
}
fn main() int { << run() >>> (err) { eprintln(err.msg())
    << 1 } }
