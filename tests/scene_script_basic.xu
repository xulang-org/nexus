@main
scripts #"github.com/xulang-org/nexus/integration/scene_script"
files #"github.com/xulang-org/nexus/integration/scene"
nexus #"github.com/xulang-org/nexus/scene"

fn run() int {
    $set := scripts.load_scripts("build/scene-scripts/world.xuscene") >>>
    document := files.load("build/scene-scripts/world.xuscene") >>>
    $tree := nexus.new_scene_tree_3d("World", 32) >>>
    parent := tree.root()
    packed := files.to_packed_nodes(&document) >>>
    root := packed.instantiate($&tree, parent, "Gallery") >>>
    assert((set.bind(&tree, root) >>>) == 2)
    assert((set.state(0, 3) >>>) == 0.9 && (set.state(1, 3) >>>) == 5.0)
    result := set.physics_process(&tree, 0, 0.1, 1.0) >>>
    assert(result > 0.089 && result < 0.091)
    report := set.dispatch(&tree, 64) >>>
    assert(report.delivered == 1 && (set.state(1, 1) >>>) == 1.0 && set.connection_count() == 1)
    println("PASS: script scene initial fields and stable signal route")
    << 0
}
fn main() int { << run() >>> (err) { eprintln(err.msg())
    << 1 } }
