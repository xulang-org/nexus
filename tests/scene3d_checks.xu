@main

ren_data #"github.com/xulang-org/nexus/resources/canvas"

scene_render #"github.com/xulang-org/nexus/integration/rendering/two_d"
fm #"github.com/xulang-org/nexus/foundation/math"
nexus #"github.com/xulang-org/nexus/scene"
#math

fn near(a f64, b f64) bool { << math.abs(a - b) < 0.000001 }
fn same(a fm.Mat4, b fm.Mat4) bool {
    for point in [fm.vec4(0.0, 0.0, 0.0, 1.0), fm.vec4(1.0, 0.0, 0.0, 1.0),
        fm.vec4(0.0, 1.0, 0.0, 1.0), fm.vec4(0.0, 0.0, 1.0, 1.0)] {
        x := a.transform(point)
        y := b.transform(point)
        if !near(x.x, y.x) || !near(x.y, y.y) || !near(x.z, y.z) || !near(x.w, y.w) { << false }
    }
    << true
}
fn inverse_rejected(value fm.Mat4) bool { value.affine_inverse() >>> (err) { << true }
    << false }
fn reparent_rejected(tree $&nexus.SceneTree, node int, parent int, keep bool) bool {
    tree.reparent(node, parent, keep) >>> (err) { << true }
    << false
}
fn wrong_dimension(tree &nexus.SceneTree, node int) bool { tree.node(node) >>> (err) { << true }
    << false }
fn transform_rejected(tree $&nexus.SceneTree, node int, value fm.Mat4) bool {
    tree.set_transform_3d(node, value) >>> (err) { << true }
    << false
}
fn world_rejected(tree &nexus.SceneTree, node int) bool { tree.global_transform_3d(node) >>> (err) { << true }
    << false }
fn instance_rejected(scene &nexus.PackedScene, tree $&nexus.SceneTree) bool {
    root := tree.root()
    scene.instantiate(tree, root, "TooLarge") >>> (err) { << true }
    << false
}
fn camera_rejected(camera nexus.CameraNode3D, tree &nexus.SceneTree) bool {
    camera.view_projection(tree, 1.0) >>> (err) { << true }
    << false
}

fn affine_case() int {
    matrix := fm.Mat4{c0: fm.vec4(2.0, 0.0, 0.0, 0.0), c1: fm.vec4(1.0, 3.0, 0.0, 0.0),
        c2: fm.vec4(0.0, 2.0, -4.0, 0.0), c3: fm.vec4(5.0, -2.0, 7.0, 1.0)}
    inverse := matrix.affine_inverse() >>>
    restored := inverse.transform(fm.vec4(9.0, 10.0, -5.0, 1.0))
    assert(near(restored.x, 1.0) && near(restored.y, 2.0) && near(restored.z, 3.0))
    assert(same(inverse.multiply(matrix), fm.identity_3d()))
    assert(inverse_rejected(fm.scale_3d(fm.vec3(1.0, 0.0, 2.0))))
    projection := nexus.perspective_3d(1.0, 1.0, 0.1, 100.0) >>>
    assert(inverse_rejected(projection))
    << 0
}
fn hierarchy_case() int {
    $tree := nexus.new_scene_tree_3d("World", 24) >>>
    root := tree.root()
    tree.set_position_3d(root, fm.vec3(10.0, 0.0, 0.0)) >>>
    parent := tree.add_child_3d(root, "Parent") >>>
    group := tree.add_group(parent, "Group") >>>
    child := tree.add_child_3d(group, "Child") >>>
    local := fm.translation_3d(fm.vec3(1.0, 2.0, 3.0)).multiply(fm.rotation_y(math.pi() / 2.0)).multiply(fm.scale_3d(fm.vec3(2.0, 3.0, -4.0)))
    tree.set_transform_3d(parent, local) >>>
    tree.set_position_3d(child, fm.vec3(1.0, 2.0, 3.0)) >>>
    world := tree.global_transform_3d(child) >>>
    assert(near(world.c3.x, -1.0) && near(world.c3.y, 8.0) && near(world.c3.z, 1.0))
    snapshot := tree.node_3d(child) >>>
    assert(snapshot.parent == group && snapshot.transform.c3.x == 1.0)
    assert((tree.node_kind(group) >>>) == nexus.NODE_GROUP && wrong_dimension(&tree, child))
    projection := nexus.perspective_3d(1.0, 1.0, 0.1, 100.0) >>>
    assert(transform_rejected($&tree, child, projection))
    assert(same(tree.global_transform_3d(child) >>>, world))
    other := tree.add_child_3d(root, "Other") >>>
    tree.set_transform_3d(other, fm.translation_3d(fm.vec3(-5.0, 4.0, 2.0)).multiply(fm.rotation_x(0.7)).multiply(fm.scale_3d(fm.vec3(3.0, 2.0, 1.0)))) >>>
    other_group := tree.add_group(other, "Container") >>>
    tree.reparent(child, other_group, true) >>>
    assert(same(tree.global_transform_3d(child) >>>, world))
    assert(reparent_rejected($&tree, other, child, false))
    assert(reparent_rejected($&tree, other_group, parent, true))
    singular := tree.add_child_3d(root, "Singular") >>>
    tree.set_transform_3d(singular, fm.scale_3d(fm.vec3(0.0, 1.0, 1.0))) >>>
    assert(reparent_rejected($&tree, child, singular, true))
    unchanged := tree.node_3d(child) >>>
    assert(unchanged.parent == other_group && same(tree.global_transform_3d(child) >>>, world))
    overlay := tree.add_child(root, "Overlay") >>>
    tree.set_position(overlay, fm.vec2(100.0, 200.0)) >>>
    independent := tree.add_child_3d(overlay, "Independent3D") >>>
    tree.set_position_3d(independent, fm.vec3(4.0, 5.0, 6.0)) >>>
    independent_world := tree.global_transform_3d(independent) >>>
    overlay_world := tree.global_transform(overlay) >>>
    assert(independent_world.c3.x == 4.0 && independent_world.c3.z == 6.0 && overlay_world.tx == 100.0)
    tree.set_visible(other, false) >>>
    assert(!(tree.is_visible(child) >>>))
    tree.paused = true
    assert(!(tree.can_process(child) >>>))
    tree.set_process_mode(other, nexus.PROCESS_ALWAYS) >>>
    assert(tree.can_process(child) >>>)
    // Canvas ignores 3D/group nodes while still recording 2D geometry.
    $canvas := scene_render.new_canvas_2d()
    canvas.add_rect(overlay, fm.rect2(0.0, 0.0, 2.0, 3.0), 4294967295) >>>
    $batch := ren_data.new_batch()
    canvas.record(&tree, fm.identity(), $&batch) >>>
    assert(batch.triangle_count() == 2)
    << 0
}
fn reuse_case() int {
    $tree := nexus.new_scene_tree_3d("World", 4) >>>
    root := tree.root()
    stable := tree.add_child(root, "Stable2D") >>>
    tree.set_position(stable, fm.vec2(9.0, 11.0)) >>>
    for cycle in 0:100 {
        node := tree.add_child_3d(root, "Temporary") >>>
        initial := tree.node_3d(node) >>>
        assert(same(initial.transform, fm.identity_3d()))
        tree.set_position_3d(node, fm.vec3(99.0, 88.0, 77.0)) >>>
        leaf := tree.add_child_3d(node, "Leaf") >>>
        tree.queue_free(node) >>>
        assert(!(tree.is_visible(leaf) >>>))
        assert(transform_rejected($&tree, node, fm.identity_3d()))
        freed := tree.flush_free() >>>
        assert(freed.len == 2 && freed[0] == leaf && freed[1] == node)
        assert(world_rejected(&tree, node) && !tree.is_alive(leaf))
        group := tree.add_group(root, "Temporary") >>>
        assert(group != node)
        tree.queue_free(group) >>>
        tree.flush_free() >>>
        two_d := tree.add_child(root, "Temporary") >>>
        initial_2d := tree.node(two_d) >>>
        assert(initial_2d.transform.tx == 0.0 && initial_2d.transform.a == 1.0)
        tree.set_position(two_d, fm.vec2(44.0, 55.0)) >>>
        tree.queue_free(two_d) >>>
        tree.flush_free() >>>
        unchanged := tree.global_transform(stable) >>>
        assert(unchanged.tx == 9.0 && unchanged.ty == 11.0)
    }
    << 0
}
fn packed_case() int {
    $source := nexus.new_scene_tree_3d("Prefab", 8) >>>
    source_root := source.root()
    source.set_position_3d(source_root, fm.vec3(1.0, 0.0, 0.0)) >>>
    group := source.add_group(source_root, "Group") >>>
    leaf := source.add_child_3d(group, "Leaf") >>>
    source.set_position_3d(leaf, fm.vec3(0.0, 2.0, 3.0)) >>>
    overlay := source.add_child(source_root, "Overlay") >>>
    source.set_position(overlay, fm.vec2(8.0, 9.0)) >>>
    packed := nexus.pack_scene(&source, source_root) >>>
    $target := nexus.new_scene_tree_3d("Target", 16) >>>
    target_root := target.root()
    target.set_position_3d(target_root, fm.vec3(10.0, 0.0, 0.0)) >>>
    a := packed.instantiate($&target, target_root, "A") >>>
    b := packed.instantiate($&target, target_root, "B") >>>
    a_leaf := target.find_node(a, "Group/Leaf") >>>
    b_leaf := target.find_node(b, "Group/Leaf") >>>
    target.set_position_3d(a_leaf, fm.vec3(3.0, 4.0, 5.0)) >>>
    aw := target.global_transform_3d(a_leaf) >>>
    bw := target.global_transform_3d(b_leaf) >>>
    assert(aw.c3.x == 14.0 && aw.c3.y == 4.0 && bw.c3.x == 11.0 && bw.c3.y == 2.0)
    group_copy := target.find_node(a, "Group") >>>
    assert((target.node_kind(group_copy) >>>) == nexus.NODE_GROUP)
    overlay_copy := target.find_node(a, "Overlay") >>>
    overlay_world := target.global_transform(overlay_copy) >>>
    assert(overlay_world.tx == 8.0 && overlay_world.ty == 9.0)
    $small := nexus.new_scene_tree_3d("Small", 2) >>>
    assert(instance_rejected(&packed, $&small))
    small_nodes := small.subtree(small.root()) >>>
    assert(small_nodes.len == 1)
    << 0
}
fn camera_case() int {
    $tree := nexus.new_scene_tree_3d("World", 8) >>>
    root := tree.root()
    tree.set_position_3d(root, fm.vec3(10.0, 0.0, 0.0)) >>>
    rig := tree.add_child_3d(root, "Rig") >>>
    tree.set_position_3d(rig, fm.vec3(0.0, 0.0, 2.0)) >>>
    node := tree.add_child_3d(rig, "Camera") >>>
    tree.set_position_3d(node, fm.vec3(0.0, 0.0, 3.0)) >>>
    camera := nexus.new_camera_node_3d(&tree, node) >>>
    view := camera.view_projection(&tree, 1.0) >>>
    center := view.transform(fm.vec4(10.0, 0.0, 0.0, 1.0))
    near_plane := view.transform(fm.vec4(10.0, 0.0, 4.9, 1.0))
    assert(near(center.x, 0.0) && near(center.y, 0.0) && near(center.w, 5.0))
    assert(near(near_plane.z / near_plane.w, 1.0))
    pose := fm.translation_3d(fm.vec3(0.0, 0.0, 2.0)).multiply(fm.rotation_y(math.pi() / 2.0))
    tree.set_transform_3d(rig, pose) >>>
    rotated_view := camera.view_projection(&tree, 1.0) >>>
    rotated_center := rotated_view.transform(fm.vec4(10.0, 0.0, 2.0, 1.0))
    assert(near(rotated_center.x, 0.0) && near(rotated_center.w, 3.0))
    tree.set_transform_3d(rig, fm.scale_3d(fm.vec3(0.0, 1.0, 1.0))) >>>
    assert(camera_rejected(camera, &tree))
    tree.set_transform_3d(rig, fm.identity_3d()) >>>
    tree.queue_free(node) >>>
    assert(camera_rejected(camera, &tree))
    tree.flush_free() >>>
    assert(camera_rejected(camera, &tree))
    << 0
}
fn run() int {
    affine_case() >>>
    hierarchy_case() >>>
    reuse_case() >>>
    packed_case() >>>
    camera_case() >>>
    println("PASS: 3D affine inverse, shared node hierarchy, dimension boundaries, keep-world reparent atomicity, 100 pool reuse cycles, mixed PackedScene, camera rig, 2D canvas")
    << 0
}
fn main() int { << run() >>> (err) { eprintln(err.msg())
    << 1 } }
