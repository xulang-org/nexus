@main

#errors
#gpu
#math
#strings
#window
colors #"github.com/xulang-org/nexus/foundation/color"
fm #"github.com/xulang-org/nexus/foundation/math"
codec #"github.com/xulang-org/nexus/formats/scene"
sc2 #"github.com/xulang-org/nexus/integration/rendering/two_d"
sc3 #"github.com/xulang-org/nexus/integration/rendering/three_d"
ren2 #"github.com/xulang-org/nexus/rendering/two_d"
ren3 #"github.com/xulang-org/nexus/rendering/three_d"
canvas #"github.com/xulang-org/nexus/resources/canvas"
lights #"github.com/xulang-org/nexus/resources/lighting"
l2d #"github.com/xulang-org/nexus/resources/lighting2d"
meshes #"github.com/xulang-org/nexus/resources/mesh"
scene_res #"github.com/xulang-org/nexus/resources/scene"
sp3 #"github.com/xulang-org/nexus/resources/sprite3d"
nexus #"github.com/xulang-org/nexus/scene"
shd2 #"github.com/xulang-org/nexus/assets/shaders/two_d"
shd3 #"github.com/xulang-org/nexus/assets/shaders/three_d"

fn px_r(c int) int { << (c >> 24) & 255 }
fn px_g(c int) int { << (c >> 16) & 255 }
fn px_b(c int) int { << (c >> 8) & 255 }
fn abs_i(v int) int { if v < 0 { << -v } << v }

fn bad_point_light(r f64) bool {
    _ := l2d.point_light_2d(fm.vec2(0.0, 0.0), fm.vec3(1.0, 1.0, 1.0), 1.0, r) >>> (err) { << true }
    << false
}

fn bad_sprite_blend(opacity f64, cutoff f64) bool {
    s := sp3.Sprite3D{
        size: fm.vec2(1.0, 1.0),
        pivot: fm.vec2(0.5, 0.0),
        region: fm.rect2(0.0, 0.0, 1.0, 1.0),
        billboard: sp3.BILLBOARD_Y_AXIS,
        alpha_mode: sp3.ALPHA_MODE_BLEND,
        alpha_cutoff: cutoff,
        opacity: opacity,
        double_sided: true,
        cast_shadow: false,
        shaded: true,
        flip_x: false,
        flip_y: false,
        tint: fm.vec3(1.0, 1.0, 1.0),
        pixel_art: true
    }
    _ := s.validate() >>> (err) { << true }
    << false
}

fn test_cpu_2d_lighting_and_shadows() int {
    assert(bad_point_light(-10.0))
    assert(bad_point_light(0.0))

    $env := l2d.new_environment_2d(fm.vec3(0.05, 0.05, 0.08)) >>>
    pt := l2d.point_light_2d(fm.vec2(50.0, 100.0), fm.vec3(1.0, 0.8, 0.4), 1.4, 150.0) >>>
    env.add_light(pt) >>>
    wall := l2d.occluder_segment_2d(fm.vec2(100.0, 60.0), fm.vec2(100.0, 140.0)) >>>
    env.add_occluder(wall) >>>

    assert(!l2d.segment_occluded(fm.vec2(50.0, 100.0), fm.vec2(75.0, 100.0), &env.occluders, 1, 0.5))
    assert(l2d.segment_occluded(fm.vec2(50.0, 100.0), fm.vec2(140.0, 100.0), &env.occluders, 1, 0.5))

    // Soft penumbra check: ray from (50,100) through top edge (100,60) reaches (140,28), so (140,29) straddles the edge!
    soft_pt := pt.with_shadows(true, 16.0) >>>
    f_center := l2d.point_shadow_factor(&soft_pt, fm.vec2(140.0, 100.0), &env.occluders, 0.5)
    f_edge := l2d.point_shadow_factor(&soft_pt, fm.vec2(140.0, 29.0), &env.occluders, 0.5)
    f_open := l2d.point_shadow_factor(&soft_pt, fm.vec2(75.0, 100.0), &env.occluders, 0.5)
    assert(f_center < 0.05 && f_open > 0.95 && f_edge > 0.1 && f_edge < 0.95)

    // Visibility polygon clipped cleanly by the wall.
    poly := l2d.visibility_polygon_2d(fm.vec2(50.0, 100.0), 150.0, &env.occluders, 1, 64) >>>
    assert(poly.len >= 64)
    $clipped := false
    for i in 0:poly.len {
        if math.abs(poly[i].x - 100.0) < 0.5 && poly[i].y >= 59.0 && poly[i].y <= 141.0 {
            clipped = true
        }
    }
    assert(clipped)

    // SceneLights2D transform & visibility integration.
    $tree := nexus.new_scene_tree("World2D", 16) >>>
    rig := tree.add_child(tree.root(), "Rig") >>>
    ln := tree.add_child(rig, "Torch") >>>
    wn := tree.add_child(rig, "Wall") >>>
    tree.set_position(rig, fm.vec2(100.0, 50.0)) >>>

    $sl := sc2.new_scene_lights_2d()
    sl.attach_light(&tree, ln, pt) >>>
    sl.attach_occluder_box(&tree, wn, fm.rect2(10.0, 10.0, 20.0, 20.0), 1) >>>
    col := sl.collect(&tree, fm.vec3(0.1, 0.1, 0.1), 1.0, 0.5) >>>
    assert(col.lights.len == 1 && col.occluders.len == 4)
    assert(math.abs(col.lights[0].position.x - 150.0) < 1e-6 && math.abs(col.lights[0].position.y - 150.0) < 1e-6)

    tree.set_visible(ln, false) >>>
    col_hidden := sl.collect(&tree, fm.vec3(0.1, 0.1, 0.1), 1.0, 0.5) >>>
    assert(col_hidden.lights.len == 0 && col_hidden.occluders.len == 4)
    << 0
}

fn build_lighting_test_env() l2d.LightEnvironment2D {
    $env := l2d.new_environment_2d(fm.vec3(0.06, 0.06, 0.09)) >>>
    warm := l2d.point_light_2d(fm.vec2(72.0, 96.0), fm.vec3(1.0, 0.68, 0.20), 1.35, 95.0) >>>
    cool := l2d.spot_light_2d(
        fm.vec2(188.0, 36.0), fm.vec2(0.0, 1.0),
        fm.vec3(0.20, 0.55, 1.0), 1.45, 120.0, 0.35, 0.65
    ) >>>
    env.add_light(warm) >>>
    env.add_light(cool) >>>
    wall := l2d.occluder_segment_2d(fm.vec2(116.0, 52.0), fm.vec2(116.0, 140.0)) >>>
    env.add_occluder(wall) >>>
    << env
}

fn test_2d_lighting_gpu_vs_software(cprog &ren2.ShaderProgram2D, lprog &ren2.LightingProgram2D) int {
    w := 256
    h := 192
    env := build_lighting_test_env() >>>
    floor_col := colors.rgba8(220, 220, 220, 255) >>>
    ui_red := colors.rgba8(235, 28, 28, 255) >>>

    // 1. GPU Metal lighting + shadow + post-lighting HUD overlay.
    opts := window.Options{title: "2D Lighting GPU", width: w, height: h, resizable: false, high_pixel_density: false, hidden: true}
    $r_gpu := ren2.open_2d_window(opts, gpu.METAL, cprog) >>>
    r_gpu.enable_lighting_2d(lprog) >>>

    $b_scene := canvas.new_batch()
    b_scene.quad(fm.rect2(0.0, 0.0, f64(w), f64(h)), fm.identity(), floor_col) >>>
    $b_hud := canvas.new_batch()
    b_hud.quad(fm.rect2(220.0, 156.0, 24.0, 24.0), fm.identity(), ui_red) >>>

    r_gpu.begin(255) >>>
    r_gpu.submit(&b_scene) >>>
    r_gpu.apply_lighting_2d(&env, fm.vec2(0.0, 0.0), fm.vec2(f64(w), f64(h)), 1) >>>
    // Unlit HUD submitted after lighting remains full bright!
    r_gpu.submit(&b_hud) >>>

    gpu_warm := r_gpu.read_pixel(84, 96) >>>
    gpu_shadow := r_gpu.read_pixel(138, 96) >>>
    gpu_spot := r_gpu.read_pixel(188, 64) >>>
    gpu_dark := r_gpu.read_pixel(240, 140) >>>
    gpu_hud := r_gpu.read_pixel(232, 168) >>>
    r_gpu.present() >>>

    assert(px_r(gpu_warm) > 150 && px_r(gpu_warm) > px_b(gpu_warm) + 50)
    assert(px_r(gpu_shadow) < 40 && px_g(gpu_shadow) < 40 && px_b(gpu_shadow) < 45)
    assert(px_b(gpu_spot) > 120 && px_b(gpu_spot) > px_r(gpu_spot) + 40)
    assert(px_r(gpu_dark) < 35 && px_g(gpu_dark) < 35 && px_b(gpu_dark) < 45)
    assert(px_r(gpu_hud) > 210 && px_g(gpu_hud) < 50)

    // 2. Normal-mapped GPU lighting check: right-facing normal (+0.8, 0, 0.6) -> RGBA(230, 128, 204, 255).
    norm_col := (230 << 24) | (128 << 16) | (204 << 8) | 255
    $norm_px := []int{}
    for _ in 0:16 { norm_px.push(norm_col) }
    $n_tex := r_gpu.texture_rgba(4, 4, &norm_px, false) >>>
    $env_norm := l2d.new_environment_2d(fm.vec3(0.04, 0.04, 0.04)) >>>
    nlight := l2d.point_light_2d(fm.vec2(128.0, 96.0), fm.vec3(1.0, 1.0, 1.0), 1.4, 180.0) >>>
    env_norm.add_light(nlight.with_height(18.0) >>>) >>>

    r_gpu.begin(255) >>>
    r_gpu.submit(&b_scene) >>>
    r_gpu.apply_lighting_2d_normal(&env_norm, fm.vec2(0.0, 0.0), fm.vec2(f64(w), f64(h)), 1, &n_tex) >>>
    px_facing := r_gpu.read_pixel(64, 96) >>>
    px_away := r_gpu.read_pixel(192, 96) >>>
    r_gpu.present() >>>
    assert(px_r(px_facing) > 100 && px_r(px_away) < 40 && px_r(px_facing) > px_r(px_away) + 60)

    n_tex.close() >>>
    r_gpu.close() >>>

    // 3. Software headless parity check against GPU pixels.
    $r_soft := ren2.open_2d_headless(w, h) >>>
    el := ren2.empty_lighting_program_2d()
    r_soft.enable_lighting_2d(&el) >>>
    r_soft.begin(255) >>>
    r_soft.submit(&b_scene) >>>
    r_soft.apply_lighting_2d(&env, fm.vec2(0.0, 0.0), fm.vec2(f64(w), f64(h)), 1) >>>
    r_soft.submit(&b_hud) >>>
    soft_warm := r_soft.read_pixel(84, 96) >>>
    soft_shadow := r_soft.read_pixel(138, 96) >>>
    soft_spot := r_soft.read_pixel(188, 64) >>>
    soft_dark := r_soft.read_pixel(240, 140) >>>
    r_soft.present() >>>
    r_soft.close() >>>

    assert(abs_i(px_r(gpu_warm) - px_r(soft_warm)) <= 6)
    assert(abs_i(px_r(gpu_shadow) - px_r(soft_shadow)) <= 6)
    assert(abs_i(px_b(gpu_spot) - px_b(soft_spot)) <= 6)
    assert(abs_i(px_b(gpu_dark) - px_b(soft_dark)) <= 6)
    << 0
}

fn test_sprite3d_blend_format_and_gpu(mprog &ren3.ShaderProgram3D, cprog &ren3.ClusteredProgram3D,
    iprog &ren3.IndirectProgram3D, pprog &ren3.PostProcessProgram3D) int {
    assert(bad_sprite_blend(1.2, 0.0))
    assert(bad_sprite_blend(0.5, 0.5))

    // 1. Scene JSON round-trip for ALPHA_MODE_BLEND Sprite3D.
    n0 := scene_res.node(-1, "Root", scene_res.NODE_3D)
    n1 := scene_res.node(0, "Ghost", scene_res.NODE_3D)
    doc_base := scene_res.make_document([n0, n1]) >>>
    uid := "11111111222222223333333344444444"
    hash := "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
    refs := [scene_res.ResourceReference{uid: uid + "", kind: "image_rgba", path: "ghost.png", content_hash: hash}]
    base_spec := sp3.sprite_3d(fm.vec2(1.2, 1.2)) >>>
    blend_spec := base_spec.with_alpha_blend(0.55) >>>
    assert(blend_spec.is_alpha_blended() && !blend_spec.cast_shadow)
    doc := scene_res.with_sprites_3d(&doc_base, refs, [scene_res.sprite_3d_attachment(1, uid + "", blend_spec)]) >>>
    enc := codec.encode(&doc) >>>
    assert(strings.contains(&enc, "\"alpha_mode\":\"blend\"") && strings.contains(&enc, "\"opacity\":0.55"))
    dec := codec.decode(&enc) >>>
    assert((codec.encode(&dec) >>>) == enc)

    // 2. Forward Device3D back-to-front sorted alpha-blended Sprite3D on Metal GPU.
    w := 160
    h := 120
    opts := window.Options{title: "2.5D Blend GPU", width: w, height: h, resizable: false, high_pixel_density: false, hidden: true}
    $dev := ren3.open_3d_window(opts, gpu.METAL, mprog) >>>
    $sp_mgr := sc3.new_scene_sprites_3d(&dev) >>>

    // 2x2 white RGBA8 texture so sprite tint controls linear color directly.
    tex_px := [4294967295, 4294967295, 4294967295, 4294967295]
    $sp_tex := dev.texture_rgba(2, 2, &tex_px, false, false, false) >>>
    $pillar_cpu := meshes.quad_mesh_3d(1.6, 2.2, fm.vec2(0.0, 0.0), 4294967295) >>>
    $pillar_mesh := dev.upload(&pillar_cpu) >>>

    $tree := nexus.new_scene_tree_3d("World3D", 16) >>>
    s_near := tree.add_child_3d(tree.root(), "NearRed") >>>
    s_far := tree.add_child_3d(tree.root(), "FarBlue") >>>
    tree.set_position_3d(s_near, fm.vec3(0.0, -0.6, 1.0)) >>>
    tree.set_position_3d(s_far, fm.vec3(0.0, -0.6, -1.0)) >>>

    $red_sp := sp3.sprite_3d(fm.vec2(1.4, 1.4)) >>>
    red_sp = red_sp.with_alpha_blend(0.6) >>>
    red_sp = red_sp.with_tint(fm.vec3(0.95, 0.05, 0.05)) >>>
    red_sp = red_sp.with_shaded(false) >>>
    $blue_sp := sp3.sprite_3d(fm.vec2(1.4, 1.4)) >>>
    blue_sp = blue_sp.with_alpha_blend(0.6) >>>
    blue_sp = blue_sp.with_tint(fm.vec3(0.05, 0.05, 0.95)) >>>
    blue_sp = blue_sp.with_shaded(false) >>>

    // Attach NEAR red FIRST and FAR blue SECOND -> SceneSprites3D MUST sort FarBlue before NearRed!
    sp_mgr.attach(&tree, s_near, red_sp, &sp_tex) >>>
    sp_mgr.attach(&tree, s_far, blue_sp, &sp_tex) >>>

    eye := fm.vec3(0.0, 0.0, 4.0)
    view := nexus.look_at_3d(eye, fm.vec3(0.0, 0.0, 0.0), fm.vec3(0.0, 1.0, 0.0)) >>>
    cam_world := view.affine_inverse() >>>
    proj := nexus.perspective_3d(0.85, f64(w) / f64(h), 0.2, 40.0) >>>
    vp := proj.multiply(view)
    sun := lights.directional(fm.vec3(0.0, 0.2, 0.98).normalized() >>>, fm.vec3(1.5, 1.5, 1.5)) >>>
    l_env := lights.environment(fm.vec3(0.3, 0.3, 0.3), eye, 1.0, [sun]) >>>
    bg_mat := (ren3.material_3d(fm.vec3(0.25, 0.25, 0.25), 0.0, 0.9, fm.vec3(0.0, 0.0, 0.0)) >>>).with_shaded(false) >>>

    // Shadow casters must exclude ALPHA_MODE_BLEND sprites.
    assert((sp_mgr.shadow_casters(&tree, cam_world) >>>).len == 0)

    dev.begin(255) >>>
    dev.draw_material(&pillar_mesh, fm.translation_3d(fm.vec3(-0.8, -1.1, -3.0)), vp, &bg_mat, &l_env) >>>
    _ := sp_mgr.draw_lit($&dev, &tree, cam_world, vp, &l_env) >>>
    px_red_front := dev.read_pixel(w / 2, h / 2) >>>
    dev.present() >>>
    assert(px_r(px_red_front) > px_b(px_red_front) + 25)

    // Swap depths so blue is in front (+1.0) and red is behind (-1.0) without changing attach order!
    tree.set_position_3d(s_near, fm.vec3(0.0, -0.6, -1.0)) >>>
    tree.set_position_3d(s_far, fm.vec3(0.0, -0.6, 1.0)) >>>
    dev.begin(255) >>>
    dev.draw_material(&pillar_mesh, fm.translation_3d(fm.vec3(-0.8, -1.1, -3.0)), vp, &bg_mat, &l_env) >>>
    _ := sp_mgr.draw_lit($&dev, &tree, cam_world, vp, &l_env) >>>
    px_blue_front := dev.read_pixel(w / 2, h / 2) >>>
    dev.present() >>>
    assert(px_b(px_blue_front) > px_r(px_blue_front) + 25)

    // Opaque blocker in front (z=+2.0) depth-rejects blended sprites behind it!
    blocker_mat := (ren3.material_3d(fm.vec3(0.1, 0.85, 0.1), 0.0, 0.9, fm.vec3(0.0, 0.0, 0.0)) >>>).with_shaded(false) >>>
    dev.begin(255) >>>
    dev.draw_material(&pillar_mesh, fm.translation_3d(fm.vec3(-0.8, -1.1, 2.0)), vp, &blocker_mat, &l_env) >>>
    _ := sp_mgr.draw_lit($&dev, &tree, cam_world, vp, &l_env) >>>
    px_blocked := dev.read_pixel(w / 2, h / 2) >>>
    dev.present() >>>
    assert(px_g(px_blocked) > px_r(px_blocked) + 60 && px_g(px_blocked) > px_b(px_blocked) + 60)

    // 3. HDR + TransparentQueue3D path for SceneSprites3D!
    $clustered := dev.clustered_renderer(cprog) >>>
    $hiz := dev.hiz_pyramid(iprog) >>>
    $hdr := dev.hdr_target(pprog) >>>
    $pp := dev.postprocess_pipeline(pprog) >>>
    irr_grid := ren3.irradiance_grid_3d(fm.vec3(-4.0, -4.0, -4.0), fm.vec3(4.0, 4.0, 4.0), 2, 2, 2) >>>
    $irr := irr_grid.upload(&dev) >>>
    $cfg := ren3.post_process_defaults_3d()
    cfg.ao_enabled = false
    cfg.ssr_enabled = false
    cfg.bloom_enabled = false
    cfg.taa_enabled = false
    cfg.taa_blend = 0.0

    clustered.bin_lights(&dev, fm.vec3(0.3, 0.3, 0.3), eye, 1.0, &[sun], view, proj, 0.2, 40.0, 0) >>>
    $tq := ren3.new_transparent_queue_3d()
    enqueued := sp_mgr.enqueue_transparent(&tree, cam_world, $&tq, 0.0) >>>
    assert(enqueued == 2)

    hdr.begin(&dev, 255) >>>
    hdr.draw_clustered(&dev, &clustered, pillar_mesh.reference(), fm.translation_3d(fm.vec3(-0.8, -1.1, -3.0)), view, vp, &bg_mat) >>>
    _ := sp_mgr.draw_opaque_into_hdr(&dev, $&hdr, &clustered, &tree, cam_world, view, vp) >>>
    hdr.end() >>>
    tq.flush_into_hdr(&dev, $&hdr, &clustered, false, &irr, 0.0, view, vp) >>>

    dev.begin(255) >>>
    pp.apply($&dev, &hdr, $&hiz, view, proj, 0.2, 40.0, &cfg) >>>
    px_hdr_blue := dev.read_pixel(w / 2, h / 2) >>>
    dev.present() >>>
    assert(px_b(px_hdr_blue) > px_r(px_hdr_blue) + 25)

    irr.close() >>>
    pp.close() >>>
    hdr.close() >>>
    hiz.close() >>>
    clustered.close() >>>
    pillar_mesh.close() >>>
    sp_tex.close() >>>
    sp_mgr.close() >>>
    dev.close() >>>
    << 0
}

fn run() int {
    test_cpu_2d_lighting_and_shadows() >>>
    cprog := shd2.load_canvas("build/canvas-shaders") >>>
    lprog := shd2.load_lighting_2d("build/canvas-shaders") >>>
    test_2d_lighting_gpu_vs_software(&cprog, &lprog) >>>

    mprog := shd3.load_mesh("build/mesh-shaders") >>>
    clprog := shd3.load_clustered_program("build/mesh-shaders") >>>
    iprog := shd3.load_indirect_program("build/mesh-shaders") >>>
    pprog := shd3.load_postprocess_program("build/mesh-shaders") >>>
    test_sprite3d_blend_format_and_gpu(&mprog, &clprog, &iprog, &pprog) >>>

    println("PASS: lighting_2d_gpu_checks (2D Lights+Shadows+NormalMap Metal/Soft + Alpha-Blended Back-to-Front 2.5D Sprite3D)")
    << 0
}

fn main() int {
    << run() >>> (err) {
        eprintln("FAIL: " + err.msg())
        << 1
    }
}
