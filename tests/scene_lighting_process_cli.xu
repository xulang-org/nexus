@main
files #"github.com/xulang-org/nexus/integration/scene"
persist #"github.com/xulang-org/nexus/integration/scene_lighting"
lights #"github.com/xulang-org/nexus/resources/lighting"
bindings #"github.com/xulang-org/nexus/integration/lighting"
fm #"github.com/xulang-org/nexus/foundation/math"
nexus #"github.com/xulang-org/nexus/scene"
#os
fn run() int {
    args := os.args()
    document := files.load(args[2]+"") >>>
    $tree := nexus.new_scene_tree_3d("World",32) >>>
    parent := tree.root()
    tree.set_position_3d(parent,fm.vec3(20.0,0.0,0.0)) >>>
    $world := bindings.new_scene_lights_3d()
    root := persist.instantiate(&document,$&world,$&tree,parent,"Loaded") >>>
    if args[1]=="write" {
        point := tree.find_node(root,"Pivot/Point") >>>
        source := lights.point(fm.vec3(0.75,0.0,1.0),fm.vec3(9.0,8.0,7.0),4.0) >>>
        world.attach(&tree,point,source) >>>
        tree.set_position_3d(point,fm.vec3(4.0,0.0,0.0)) >>>
        captured := persist.capture(&document,&world,&tree,root) >>>
        files.save(args[3]+"",&captured) >>>
        println("saved")
    } else {
        assert(document.light_count()==4 && !(document.describe_node(5) >>>).visible)
        sun := tree.find_node(root, "Pivot/Directional") >>>
        binding := world.binding(&tree, sun) >>>
        settings := binding.cascades.settings() >>>
        assert(settings.count == 3 && settings.resolution == 256 && settings.distance == 42.98765432101234)
        point := world.binding(&tree, tree.find_node(root, "Pivot/Point") >>>) >>>
        if point.punctual.enabled() {
            profile := point.punctual.settings() >>>
            assert(profile.resolution == 512 && profile.near == 0.12345678901234567)
            spot := world.binding(&tree, tree.find_node(root, "Pivot/Spot") >>>) >>>
            assert((spot.punctual.settings() >>>).resolution == 1024)
        }
        source := (document.light(1) >>>).source
        assert(source.position().x==0.75 && source.radius()==4.0 && source.radiance().x==9.0)
        sources := world.gather(&tree) >>>
        assert(sources.len==3 && sources[1].position().x==32.75)
        assert(sources[2].inner_cosine()==0.9751234567890123 && sources[2].outer_cosine()==0.7001234567890123)
        println("loaded")
    }
    << 0
}
fn main() int { << run() >>> (err){ eprintln(err.msg())
    << 1 } }
