@main

fm #"github.com/xulang-org/nexus/foundation/math"
physics #"github.com/xulang-org/nexus/physics3d"

fn box(x f64,y f64,z f64,xx f64,yy f64,zz f64) fm.Aabb3 {
    << fm.Aabb3{minimum: fm.vec3(x,y,z), maximum: fm.vec3(xx,yy,zz)}
}
fn static_box(bounds fm.Aabb3, layer int, trigger bool) physics.StaticBox3D {
    << physics.StaticBox3D{bounds: bounds, layer: layer, trigger: trigger}
}
fn test() int {
    body := box(0.0,0.0,0.0,0.5,1.25,0.5)
    floor := static_box(box(-10.0,-1.0,-10.0,10.0,0.0,10.0), 1, false)
    step := static_box(box(0.75,0.0,-1.0,2.0,0.25,1.0), 2, false)
    trigger := static_box(box(1.0,0.0,-1.0,2.0,1.0,1.0), 4, true)
    world := physics.new_static_world([floor, step, trigger]) or >>
    motion := fm.vec3(1.0,-0.0625,0.0)
    raised := world.move_character(body, motion, 3, 4, 0.5, 0.015625) or >>
    assert(raised.grounded && raised.stepped && raised.motion.bounds.minimum.y == 0.25)
    assert(raised.motion.travelled.x == 1.0 && raised.triggers.len == 1 && raised.triggers[0] == 2)
    masked := world.move_character(body, motion, 1, 1, 0.5, 0.015625) or >>
    assert(masked.grounded && !masked.stepped && masked.motion.travelled.x == 1.0 && masked.triggers.len == 0)
    blocked := world.move_character(body, motion, 3, 4, 0.125, 0.015625) or >>
    assert(blocked.grounded && !blocked.stepped && blocked.motion.travelled.x == 0.25)
    flying := world.move_character(body, fm.vec3(1.0,0.125,0.0), 3, 4, 0.5, 0.015625) or >>
    assert(!flying.grounded && !flying.stepped && flying.motion.on_wall)
    ceiling := static_box(box(0.0,1.375,-1.0,2.0,2.0,1.0), 1, false)
    low := physics.new_static_world([floor, step, ceiling]) or >>
    stopped := low.move_character(body, motion, 3, 4, 0.5, 0.015625) or >>
    assert(!stopped.stepped && stopped.motion.on_wall)
    << 0
}
fn main() int {
    test() or (err) { eprintln(err.msg())
        << 1 }
    println("PASS: static collision layers, trigger overlap, floor probe, stairs, and blocked headroom")
    << 0
}
