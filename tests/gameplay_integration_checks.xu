@main

// Integrated Gameplay Scenario Verification:
// SceneTree + ScaledClock (hitstop) + GameplayWorld + EquipmentLoadout + InteractableRegistry +
// DialogueGraph + QuestJournal + WaveDirector + LootTable + OrbitCamera3D (Physics3D wall occlusion) +
// Mixer Spatial Audio + ParticleSystem2D + i18n Localization + JSON State Save/Reload.

#errors
#math
#os
#path/filepath
fm #"github.com/xulang-org/nexus/foundation/math"
gp #"github.com/xulang-org/nexus/gameplay"
gpi #"github.com/xulang-org/nexus/integration/gameplay"
scenes #"github.com/xulang-org/nexus/scene"
timing #"github.com/xulang-org/nexus/timing"
phys #"github.com/xulang-org/nexus/physics3d"
vfx #"github.com/xulang-org/nexus/vfx"
pcm #"github.com/xulang-org/nexus/resources/audio"
mix #"github.com/xulang-org/nexus/audio/mixer"
ri #"github.com/xulang-org/nexus/resources/i18n"
li #"github.com/xulang-org/nexus/i18n"

fn check(cond bool, msg string) int {
    if !cond { >> errors.new("gameplay integration check failed: " + msg) }
    << 0
}

fn near(a f64, b f64, eps f64) bool {
    << math.abs(a - b) <= eps
}

fn run_checks() int {
    // 1. Setup SceneTree + Physics3D arena wall behind player (z in 2.6..3.8).
    $tree := scenes.new_scene_tree_3d("EncounterArena", 64) or >>
    hero_node := tree.add_child_3d(tree.root(), "Hero") or >>
    goblin1_node := tree.add_child_3d(tree.root(), "Goblin_1") or >>
    goblin2_node := tree.add_child_3d(tree.root(), "Goblin_2") or >>
    tree.set_transform_3d(hero_node, fm.translation_3d(fm.vec3(0.0, 0.0, 0.0))) or >>
    tree.set_transform_3d(goblin1_node, fm.translation_3d(fm.vec3(1.8, 0.0, 0.0))) or >>
    tree.set_transform_3d(goblin2_node, fm.translation_3d(fm.vec3(6.0, 0.0, 0.0))) or >>

    back_wall := phys.StaticBox3D{
        bounds: fm.aabb3(fm.vec3(-6.0, -1.0, 2.6), fm.vec3(6.0, 4.0, 3.8)) or >>,
        layer: 1,
        trigger: false
    }
    arena_boxes := [back_wall]

    // 2. Setup i18n catalog for localized prompts & quest titles.
    $cat := ri.new_catalog("en-US") or >>
    cat.set_entry("en-US", "prompt.elder", "Talk to Elder [E]") or >>
    cat.set_entry("zh-Hans-CN", "prompt.elder", "与长老交谈 [E]") or >>
    cat.set_entry("en-US", "quest.hunt", "Clear the GoblinAmbush") or >>
    cat.set_entry("zh-Hans-CN", "quest.hunt", "清除哥布林伏兵") or >>
    tmp := filepath.join(["build", "gameplay-int-tmp"])
    os.remove_all(tmp + "") or (err) {
        _ := err.msg()
        << 0
    }
    os.mkdir_all(tmp + "") or >>
    cat_path := filepath.join([tmp + "", "i18n.json"])
    cat_raw := ri.encode_catalog_json(&cat)
    $cf := os.create(cat_path + "") or >>
    _ := cf.write(cat_raw + "") or >>
    cf.close() or >>
    $loc := li.load_json_file(cat_path + "", "en-US") or >>

    // 3. ItemRegistry, Hero Inventory + EquipmentLoadout, Quests, Dialogue, WaveDirector, LootTable.
    $reg := gp.new_item_registry()
    reg.register(gp.ItemDef{
        id: "sun_blade", name_key: "item.sun_blade", category: gp.ITEM_WEAPON, rarity: gp.RARITY_EPIC,
        max_stack: 1, weight: 3.0, equip_slot: gp.EQUIP_MAIN_HAND,
        modifiers: [gp.StatModifier{id: "sb_atk", source: "", stat: "attack", op: gp.MOD_FLAT, value: 30.0, priority: 0}]
    }) or >>
    reg.register(gp.ItemDef{
        id: "goblin_tooth", name_key: "item.goblin_tooth", category: gp.ITEM_MATERIAL, rarity: gp.RARITY_COMMON,
        max_stack: 20, weight: 0.2, equip_slot: gp.EQUIP_NONE, modifiers: []gp.StatModifier{}
    }) or >>

    $hero_inv := gp.new_inventory(8, 50.0) or >>
    _ := hero_inv.add_item(&reg, "sun_blade", 1) or >>
    $hero_eq := gp.new_equipment_loadout()

    $journal := gp.new_quest_journal()
    q_hunt := gp.QuestDef{
        id: "goblin_ambush", title_key: "quest.hunt", prereq_ids: []string{},
        objectives: [gp.QuestObjective{id: "kill_2", desc_key: "obj.g", kind: gp.OBJ_KILL, target_id: "goblin", required: 2, current: 0, optional: false}],
        reward: gp.QuestReward{xp: 250, gold: 120, items: []gp.ItemStack{}}
    }
    q_next := gp.QuestDef{
        id: "aftermath", title_key: "quest.aftermath", prereq_ids: ["goblin_ambush"],
        objectives: [gp.QuestObjective{id: "talk_end", desc_key: "obj.e", kind: gp.OBJ_TALK, target_id: "elder", required: 1, current: 0, optional: false}],
        reward: gp.QuestReward{xp: 100, gold: 40, items: []gp.ItemStack{}}
    }
    journal.register(&q_hunt) or >>
    journal.register(&q_next) or >>
    check(gpi.localized_quest_title($&loc, &q_hunt) == "Clear the GoblinAmbush", "localized quest title en-US mismatch") or >>
    loc.set_locale("zh-Hans-CN") or >>
    check(gpi.localized_quest_title($&loc, &q_hunt) == "清除哥布林伏兵", "localized quest title zh-Hans-CN mismatch") or >>

    $dlg := gp.new_dialogue_graph("elder_intro") or >>
    dlg.add_node(gp.DialogueNode{
        id: "start", speaker_key: "npc.elder", text_key: "dlg.ambush",
        on_enter: []gp.DialogueEffect{},
        choices: [
            gp.DialogueChoice{
                text_key: "c.accept", next_node: "",
                condition: gp.cond_none(),
                effects: [gp.DialogueEffect{kind: gp.DEFF_START_QUEST, key: "goblin_ambush", amount: 1}]
            }
        ]
    }) or >>

    // Interact with Elder -> localized prompt + complete choice -> accept quest!
    $iregs := gp.new_interactable_registry()
    iregs.register(gp.Interactable{
        id: "elder", prompt_key: "prompt.elder", position: fm.vec3(0.0, 0.0, 1.5),
        radius: 3.0, hold_duration: 0.0, cooldown: 0.0, priority: 2, one_shot: true, enabled: true
    }) or >>
    sel := iregs.step(fm.vec3(0.0, 0.0, 0.0), fm.vec3(0.0, 0.0, 1.0), 0.5, true, 0.016)
    check(sel.found && sel.triggered && gpi.localized_interact_prompt($&loc, &sel) == "与长老交谈 [E]",
        "localized Elder interact trigger failed") or >>
    empty_flags := []string{}
    empty_st := gp.new_stat_sheet()
    tr := dlg.select_choice("start", 0, &empty_flags, &empty_st, &hero_inv, &journal) or >>
    check(tr.ended && tr.effects.len == 1 && tr.effects[0].kind == gp.DEFF_START_QUEST, "dialogue start_quest effect missing") or >>
    journal.accept("goblin_ambush") or >>

    // 4. Populate GameplayWorld + equip Sun Blade onto Hero + spawn WaveDirector enemies.
    $clock := timing.new_scaled_clock(60, 4) or >>
    $world := gpi.new_gameplay_world(42)

    $hero_stats := gp.new_stat_sheet()
    hero_stats.define("attack", 20.0, 0.0, 500.0) or >>
    hero_stats.define("defense", 30.0, 0.0, 500.0) or >>
    hero_id := world.spawn_actor(hero_node, "hero", gp.TEAM_PLAYER, 0.5, hero_stats, gp.new_health(250.0, 50.0, 50.0) or >>, "idle") or >>
    _ := world.equip_actor_item_from_inventory(hero_id, $&hero_eq, $&hero_inv, &reg, "sun_blade", gp.EQUIP_NONE) or >>
    check(near(world.actor_stat(hero_id, "attack") or >>, 50.0, 1e-6), "equipping sun_blade must raise actor attack from 20 to 50") or >>

    world.register_actor_ability(hero_id, gp.AbilityDef{id: "fire_slash", cooldown: 1.5, max_charges: 2, cost: 15.0, cast_time: 0.0, gcd: 0.25, combo_steps: 2, combo_window: 1.5}) or >>

    $waves := gp.new_wave_director(2) or >>
    waves.add_wave(gp.WaveDef{name: "ambush", start_delay: 0.0, max_concurrent: 4, rules: [gp.WaveSpawnRule{enemy_type: "goblin", count: 2, interval: 0.0, boss: false}]}) or >>
    waves.start() or >>
    spawns := waves.step(0.016)
    check(spawns.len == 2 && waves.alive_count() == 2, "WaveDirector should spawn 2 goblins") or >>

    $g_stats1 := gp.new_stat_sheet()
    g_stats1.define("defense", 0.0, 0.0, 500.0) or >>
    g_stats1.define("fire_res", -0.25, -1.0, 0.90) or >> // Weak to fire!
    g_stats2 := g_stats1.clone()
    g1_id := world.spawn_actor(goblin1_node, "goblin", gp.TEAM_ENEMY, 0.7, g_stats1, gp.new_health(60.0, 0.0, 20.0) or >>, "idle") or >>
    g2_id := world.spawn_actor(goblin2_node, "goblin", gp.TEAM_ENEMY, 0.7, g_stats2, gp.new_health(65.0, 0.0, 20.0) or >>, "idle") or >>

    $loot := gp.new_loot_table("goblin_drop", 1, 2) or >>
    loot.add_entry(gp.LootEntry{item_id: "goblin_tooth", min_count: 1, max_count: 2, weight: 10.0, guaranteed: true, is_rare_pity: true}) or >>

    // 5. Setup OrbitCamera3D (wall pull-in check), Spatial Mixer + 2D ParticleSystem.
    $cam := gp.new_orbit_camera_3d(6.0, fm.vec3(0.0, 1.4, 0.0)) or >>
    $pose := gpi.sync_orbit_camera_with_static_boxes($&cam, &tree, hero_node, &arena_boxes, 0.016)
    for _ in 0:10 {
        pose = gpi.sync_orbit_camera_with_static_boxes($&cam, &tree, hero_node, &arena_boxes, 0.033)
    }
    check(pose.occluded && pose.arm_distance < 2.6, "Physics3D back_wall must pull OrbitCamera3D spring arm inward") or >>

    $aud := mix.new_mixer(48000, 16) or >>
    $sine_pcm := []int{}
    for k in 0:8192 {
        t := f64(k) / 48000.0
        sine_pcm.push(int(math.round_to_even(math.sin(6.283185307179586 * 320.0 * t) * 18000.0)))
    }
    hit_clip := aud.add_clip(pcm.pcm16(48000, 1, sine_pcm) or >>) or >>
    sfx_bus := aud.add_bus(0, "SFX", 1.0) or >>
    $sparks_e := vfx.default_emitter_2d(fm.vec2(200.0, 200.0))
    sparks_e.emitting = false
    sparks_e.life_min = 0.8
    sparks_e.life_max = 1.2
    $sparks := vfx.new_particle_system_2d(64, 17, sparks_e) or >>

    // 6. Hero casts Fire Slash combo 1 -> strikes Goblin 1 (crit + stagger triggers ScaledClock hitstop + AV feedback!)
    cast1 := world.cast_actor_ability(hero_id, "fire_slash", 100.0)
    check(cast1.started && cast1.combo_step == 1, "Hero fire_slash cast failed") or >>
    $slash_spec := gp.default_damage_spec(hero_id, gp.TEAM_PLAYER, world.actor_stat(hero_id, "attack") or >>)
    slash_spec.element = gp.DMG_FIRE
    slash_spec.crit_rate = 1.0 // Force crit + hitstop!
    slash_spec.crit_mult = 1.5
    slash_spec.poise_damage = 30.0
    _ := world.spawn_attack_hitbox(hero_id, fm.vec3(1.9, 0.0, 0.0), 0.9, slash_spec) or >>

    _ := world.step_frame(&tree, $&clock, 1.0 / 60.0, $&cam, $&journal, $&waves, $&loot, $&hero_inv, &reg) or >>
    world.clear_hitboxes()
    evs1 := world.drain_feedback()
    av1 := gpi.trigger_feedback_av(&evs1, fm.vec3(0.0, 1.4, 2.0), fm.vec3(1.0, 0.0, 0.0), fm.vec3(0.0, 0.0, -1.0), $&aud, hit_clip, sfx_bus, $&sparks) or >>
    sparks.step(1.0 / 60.0) or >>
    g1_alive := world.actor_alive(g1_id) or >>
    check(!g1_alive && waves.alive_count() == 1, "Crit fire slash should kill Goblin 1") or >>
    check(clock.in_hitstop() && av1 >= 2 && sparks.alive_count() >= 16,
        "Crit+Kill feedback mismatch av1=" + str(av1) + " sparks=" + str(sparks.alive_count())) or >>
    pcm1 := aud.render(256) or >>
    $pcm_energy := 0.0
    for si in 0:pcm1.len { pcm_energy += math.abs(f64(pcm1[si])) }
    check(pcm_energy > 1000.0, "spatial hit SFX should produce non-silent audio output") or >>

    // Step past 0.09s stagger hitstop freeze!
    for _ in 0:8 {
        st_hs := world.step_frame(&tree, $&clock, 1.0 / 60.0, $&cam, $&journal, $&waves, $&loot, $&hero_inv, &reg) or >>
        _ := st_hs.in_hitstop
    }
    check(!clock.in_hitstop(), "hitstop should clear cleanly after 8 frames") or >>

    // 7. Apply burning DoT to Goblin 2 and let step_frame DoT ticks kill Goblin 2 -> Wave cleared + Quest READY + Loot dropped!
    burn_spec := gp.StatusSpec{
        id: "burn", category: gp.STATUS_CAT_DEBUFF, stack_policy: gp.STACK_REFRESH, max_stacks: 1,
        duration: 1.5, max_duration: 1.5, tick_interval: 0.25, tick_damage: 30.0, tick_heal: 0.0,
        damage_element: gp.DMG_FIRE, tags: []string{}, modifiers: []gp.StatModifier{}
    }
    world.apply_status_to_actor(g2_id, &burn_spec) or >>
    for _ in 0:45 {
        _ := world.step_frame(&tree, $&clock, 1.0 / 60.0, $&cam, $&journal, $&waves, $&loot, $&hero_inv, &reg) or >>
    }
    g2_alive := world.actor_alive(g2_id) or >>
    g2_fsm := world.actor_fsm_state(g2_id) or >>
    check(!g2_alive && g2_fsm == "dead", "burn DoT must kill Goblin 2 and set FSM dead") or >>
    check(waves.is_cleared() && journal.state_of("goblin_ambush") == gp.QUEST_READY,
        "killing both goblins must clear WaveDirector and set goblin_ambush READY") or >>
    check(hero_inv.count_of("goblin_tooth") >= 2, "loot drops from 2 killed goblins should enter hero inventory") or >>

    // Complete quest -> unlocks aftermath & awards gold!
    rew := journal.complete("goblin_ambush") or >>
    hero_inv.gold += rew.gold
    check(journal.state_of("aftermath") == gp.QUEST_AVAILABLE && hero_inv.gold == 120, "quest completion reward + prereq unlock mismatch") or >>

    // 8. Save/Reload JSON snapshots across StatSheet, Inventory, QuestJournal
    inv_j := gp.encode_inventory_json(&hero_inv)
    j_j := gp.encode_journal_json(&journal)
    inv_dec := gp.decode_inventory_json(&inv_j) or >>
    j_dec := gp.decode_journal_json(&j_j, &[q_hunt, q_next]) or >>
    check(inv_dec.gold == 120 && inv_dec.count_of("goblin_tooth") >= 2, "inventory reload state mismatch") or >>
    check(j_dec.state_of("goblin_ambush") == gp.QUEST_COMPLETED && j_dec.state_of("aftermath") == gp.QUEST_AVAILABLE,
        "journal reload state mismatch") or >>

    os.remove_all(tmp + "") or (err) {
        _ := err.msg()
        << 0
    }
    << 0
}

fn main() int {
    run_checks() or (err) {
        println("FAIL: " + err.msg())
        << 1
    }
    println("PASS: gameplay_integration_checks")
    << 0
}
