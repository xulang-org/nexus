@main
loader #"github.com/xulang-org/nexus/integration/scene_script"
nexus #"github.com/xulang-org/nexus/scene"
#os

fn run() int {
    args := os.args()
    assert(args.len == 4)
    $scripts := loader.load(args[2] + "") >>>
    $tree := nexus.new_scene_tree("World", 8) >>>
    root := tree.root()
    scripts.instantiate($&tree, root, "Instance") >>>
    assert((scripts.calls(0) >>>) == 0 && (scripts.state(0, 3) >>>) == 0.9)
    scripts.physics_process(&tree, 0, 0.1, 1.0) >>>
    assert((scripts.dispatch(&tree, 64) >>>).delivered == 1 && (scripts.state(1, 1) >>>) == 1.0)
    if args[1] == "write" { scripts.save(args[3] + "", &tree) >>>
        println("saved")
    } else { println("loaded") }
    << 0
}
fn main() int { << run() >>> (err) { eprintln(err.msg())
    << 1 } }
