@main
loader #"github.com/xulang-org/nexus/integration/scene_script"
nexus #"github.com/xulang-org/nexus/scene"
#os

fn run() int {
    args := os.args()
    assert(args.len == 4)
    $scripts := loader.load(args[2] + "") or >>
    $tree := nexus.new_scene_tree("World", 8) or >>
    root := tree.root()
    scripts.instantiate($&tree, root, "Instance") or >>
    assert((scripts.calls(0) or >>) == 0 && (scripts.state(0, 3) or >>) == 0.9)
    scripts.physics_process(&tree, 0, 0.1, 1.0) or >>
    assert((scripts.dispatch(&tree, 64) or >>).delivered == 1 && (scripts.state(1, 1) or >>) == 1.0)
    if args[1] == "write" { scripts.save(args[3] + "", &tree) or >>
        println("saved")
    } else { println("loaded") }
    << 0
}
fn main() int { << run() or (err) { eprintln(err.msg())
    << 1 } }
