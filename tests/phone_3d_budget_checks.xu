@main

#gpu
#window
ren #"github.com/xulang-org/nexus/rendering/three_d"
mesh #"github.com/xulang-org/nexus/resources/mesh"
fm #"github.com/xulang-org/nexus/foundation/math"
shaders #"github.com/xulang-org/nexus/assets/shaders/three_d"

fn rejects_budget(device $&ren.Device3D, limit int) bool {
    device.set_max_render_pixels(limit) >>> (err) { << true }
    << false
}

fn run() int {
    program := shaders.load_mesh("build/mesh-shaders") >>>
    opts := window.Options{title: "Budget3D", width: 320, height: 240,
        resizable: true, high_pixel_density: false, hidden: true}
    $dev := ren.open_3d_window(opts, gpu.AUTO, &program) >>>
    assert((dev.max_render_pixels() >>>) == 4194304)
    assert((dev.render_width() >>>) == 320 && (dev.render_height() >>>) == 240)

    dev.set_max_render_pixels(19200) >>>
    assert((dev.max_render_pixels() >>>) == 19200)
    assert((dev.render_width() >>>) == 160 && (dev.render_height() >>>) == 120)
    assert(rejects_budget($&dev, 0))
    assert(rejects_budget($&dev, 4194305))

    $data := mesh.new_mesh_data_3d()
    data.vertex(fm.vec3(-0.7, -0.7, 0.5), 4294967295) >>>
    data.vertex(fm.vec3(0.7, -0.7, 0.5), 4294967295) >>>
    data.vertex(fm.vec3(0.0, 0.7, 0.5), 4294967295) >>>
    data.triangle(0, 1, 2) >>>
    $tri := dev.upload(&data) >>>

    dev.begin(255) >>>
    assert(rejects_budget($&dev, 76800))
    dev.draw(&tri, fm.identity_3d()) >>>
    px := dev.read_pixel(80, 60) >>>
    assert(px != 0)
    dev.present() >>>

    dev.set_render_scale(2) >>>
    assert((dev.render_width() >>>) == 80 && (dev.render_height() >>>) == 60)
    dev.begin(255) >>>
    dev.draw(&tri, fm.identity_3d()) >>>
    dev.present() >>>

    tri.close() >>>
    dev.close() >>>
    println("phone 3D budget: capped render targets, SSAA interaction and smooth present PASS")
    << 0
}

fn main() int {
    << run() >>> (err) {
        eprintln(err.msg())
        << 1
    }
}
