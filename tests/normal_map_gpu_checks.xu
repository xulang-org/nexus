@main

light_data #"github.com/xulang-org/nexus/resources/lighting"

#gpu

gpu_info #"github.com/xulang-org/nexus/platform/gpu"

mesh_shaders #"github.com/xulang-org/nexus/assets/shaders/three_d"

meshes #"github.com/xulang-org/nexus/resources/mesh"

ren #"github.com/xulang-org/nexus/rendering/three_d"
fm #"github.com/xulang-org/nexus/foundation/math"
colors #"github.com/xulang-org/nexus/foundation/color"
scene_render #"github.com/xulang-org/nexus/integration/rendering/three_d"
assets #"github.com/xulang-org/nexus/assets/gltf"
glb #"github.com/xulang-org/nexus/integration/gltf_render"
nexus #"github.com/xulang-org/nexus/scene"
#math

fn source(flags int, sign f64, size f64) meshes.MeshData3D {
    $mesh := meshes.new_mesh_data_3d()
    for p in [fm.vec3(-0.6, 0.6, 0.5), fm.vec3(0.6, 0.6, 0.5), fm.vec3(0.6, -0.6, 0.5), fm.vec3(-0.6, -0.6, 0.5)] {
        if flags == 0 { mesh.vertex_lit(p.scaled(size), 4294967295, fm.vec3(0.0, 0.0, 1.0)) >>>
        } else if flags == 1 || (flags == 3 && mesh.vertex_count() == 3) { mesh.vertex_lit_uv(p.scaled(size), 4294967295, fm.vec3(0.0, 0.0, 1.0), fm.vec2(0.25, 0.5)) >>>
        } else { mesh.vertex_tangent(p.scaled(size), 4294967295, fm.vec3(0.0, 0.0, 1.0), fm.vec2(0.25, 0.5), fm.vec4(1.0, 0.0, 0.0, sign)) >>> }
    }
    mesh.triangle(0, 2, 1) >>>
    mesh.triangle(0, 3, 2) >>>
    << mesh
}
fn generated_source(sign f64, size f64) meshes.MeshData3D {
    $mesh := meshes.new_mesh_data_3d()
    for p in [fm.vec3(-0.6, 0.6, 0.5), fm.vec3(0.6, 0.6, 0.5), fm.vec3(0.6, -0.6, 0.5), fm.vec3(-0.6, -0.6, 0.5)] {
        $v := (p.y / 0.6 + 1.0) * 0.5
        if sign < 0.0 { v = 1.0 - v }
        mesh.vertex_lit_uv(p.scaled(size), 4294967295, fm.vec3(0.0, 0.0, 1.0), fm.vec2((p.x / 0.6 + 1.0) * 0.5, v)) >>>
    }
    mesh.triangle(0, 2, 1) >>>
    mesh.triangle(0, 3, 2) >>>
    assert((mesh.generate_tangents() >>>) == 0)
    << mesh
}
// Independent reference: bake positions and the expected world normal into a
// mesh. Reflection sign is an explicit oracle, not inferred from transformed B.
fn reference(world fm.Mat4, sampled fm.Vec3, scale f64, sign f64, orientation f64, size f64) meshes.MeshData3D {
    inverse := world.affine_inverse() >>>
    n := inverse.transposed().transform(fm.vec4(0.0, 0.0, 1.0, 0.0)).xyz().normalized() >>>
    raw_t := world.transform(fm.vec4(1.0, 0.0, 0.0, 0.0)).xyz()
    t := raw_t.sub(n.scaled(raw_t.dot(n))).normalized() >>>
    b := n.cross(t).scaled(sign * orientation)
    $normal := n
    if scale != 0.0 {
        normal = t.scaled(sampled.x * scale).add(b.scaled(sampled.y * scale)).add(n.scaled(sampled.z)).normalized() >>>
    }
    $mesh := meshes.new_mesh_data_3d()
    for p in [fm.vec3(-0.6, 0.6, 0.5), fm.vec3(0.6, 0.6, 0.5), fm.vec3(0.6, -0.6, 0.5), fm.vec3(-0.6, -0.6, 0.5)] {
        point := p.scaled(size)
        transformed := world.transform(fm.vec4(point.x, point.y, point.z, 1.0)).xyz()
        mesh.vertex_lit(transformed, 4294967295, normal) >>>
    }
    if orientation < 0.0 {
        mesh.triangle(0, 1, 2) >>>
        mesh.triangle(0, 2, 3) >>>
    } else {
        mesh.triangle(0, 2, 1) >>>
        mesh.triangle(0, 3, 2) >>>
    }
    << mesh
}
fn sample(device $&ren.Device3D, mesh &ren.Mesh3D, world fm.Mat4, projection fm.Mat4, material &ren.Material3D, light &light_data.Environment3D) int {
    device.begin(255) >>>
    device.draw_material(mesh, world, projection, material, light) >>>
    pixel := device.read_pixel(32, 32) >>>
    device.present() >>>
    << pixel
}
fn channel(color int, index int) int {
    if index == 0 { << color / 16777216 % 256 }
    if index == 1 { << color / 65536 % 256 }
    << color / 256 % 256
}
fn equal(left int, right int) {
    for i in 0:3 {
        if math.abs(f64(channel(left, i) - channel(right, i))) > 2.0 { println("Normal reference mismatch " + str(left) + " != " + str(right)) }
        assert(math.abs(f64(channel(left, i) - channel(right, i))) <= 2.0)
    }
}
fn bad_normal(material &ren.Material3D, texture &ren.Texture3D, scale f64) bool {
    material.with_normal_texture(texture, scale) >>> (err) { << true }
    << false
}
fn bad_set(scene $&scene_render.Scene3D, tree &nexus.SceneTree, node int, material ren.Material3D) bool {
    scene.set_material(tree, node, material) >>> (err) { << true }
    << false
}
fn bad_replace(scene $&scene_render.Scene3D, tree &nexus.SceneTree, node int, mesh &ren.Mesh3D) bool {
    scene.attach_mesh(tree, node, mesh) >>> (err) { << true }
    << false
}
fn bad_model(model &glb.GlbUnlit3D, scene $&scene_render.Scene3D, tree &nexus.SceneTree, instance &assets.GlbInstance) bool {
    model.bind(scene, tree, instance) >>> (err) { << true }
    << false
}
fn bad_draw(device $&ren.Device3D, mesh &ren.Mesh3D, material &ren.Material3D, light &light_data.Environment3D) bool {
    device.draw_material(mesh, fm.identity_3d(), fm.identity_3d(), material, light) >>> (err) { << true }
    << false
}
fn bad_vertex(mesh $&meshes.MeshData3D, tangent fm.Vec4) bool {
    mesh.vertex_tangent(fm.vec3(0.0, 0.0, 0.5), 4294967295, fm.vec3(0.0, 0.0, 1.0), fm.vec2(0.0, 0.0), tangent) >>> (err) { << true }
    << false
}
fn bad_triangle(mesh $&meshes.MeshData3D) bool { mesh.triangle(0, 2, 1) >>> (err) { << true }
    << false }
fn generated_seam(device $&ren.Device3D) int {
    positions := [fm.vec3(0.0, -0.8, 0.5), fm.vec3(0.8, -0.8, 0.5), fm.vec3(0.0, 0.8, 0.5), fm.vec3(-0.8, -0.8, 0.5)]
    uvs := [fm.vec2(0.0, 0.0), fm.vec2(1.0, 0.0), fm.vec2(0.0, 1.0), fm.vec2(1.0, 0.0)]
    ids := [0, 1, 2, 0, 2, 3]
    $source := meshes.new_mesh_data_3d()
    $reference := meshes.new_mesh_data_3d()
    for i in 0:4 { source.vertex_lit_uv(positions[i], 4294967295, fm.vec3(0.0, 0.0, 1.0), uvs[i]) >>> }
    source.triangle(0, 1, 2) >>>
    source.triangle(0, 2, 3) >>>
    assert((source.generate_tangents() >>>) == 2)
    for triangle in 0:2 {
        $sign := 1.0
        if triangle == 1 { sign = -1.0 }
        normal := fm.vec3(sign, 1.0 / 255.0, 1.0).normalized() >>>
        for corner in 0:3 { reference.vertex_lit(positions[ids[triangle * 3 + corner]], 4294967295, normal) >>> }
        reference.triangle(triangle * 3, triangle * 3 + 1, triangle * 3 + 2) >>>
    }
    $generated := device.upload(&source) >>>
    $baked := device.upload(&reference) >>>
    pixels := [colors.rgba8(255, 128, 255, 255) >>>]
    $texture := device.texture_rgba(1, 1, &pixels, false, false, false) >>>
    zero := fm.vec3(0.0, 0.0, 0.0)
    base := ren.material_3d(fm.vec3(0.6, 0.35, 0.15), 0.0, 0.75, zero) >>>
    mapped := base.with_normal_texture(&texture, 1.0) >>>
    light := light_data.environment(zero, fm.vec3(0.0, 0.0, 2.0), 1.0, [light_data.directional(fm.vec3(0.5, 0.2, 1.0), fm.vec3(3.0, 3.0, 3.0)) >>>]) >>>
    identity := fm.identity_3d()
    device.begin(255) >>>
    device.draw_material(&generated, identity, identity, &mapped, &light) >>>
    right := device.read_pixel(40, 40) >>>
    left := device.read_pixel(24, 40) >>>
    device.present() >>>
    device.begin(255) >>>
    device.draw_material(&baked, identity, identity, &base, &light) >>>
    equal(right, device.read_pixel(40, 40) >>>)
    equal(left, device.read_pixel(24, 40) >>>)
    device.present() >>>
    assert(math.abs(f64(channel(right, 0) - channel(left, 0))) > 20.0)
    << 0
}
fn run() int {
    mesh_program_0 := mesh_shaders.load_mesh("build/mesh-shaders") >>>
    $device := ren.open_3d("Xu tangent normal GPU checks", 64, 64, gpu.AUTO, &mesh_program_0) >>>
    println("Normal map GPU backend: " + gpu_info.backend_name(device.backend() >>>))
    generated_seam($&device) >>>
    zero := fm.vec3(0.0, 0.0, 0.0)
    base := ren.material_3d(fm.vec3(0.6, 0.35, 0.15), 0.0, 0.75, zero) >>>
    light := light_data.environment(zero, fm.vec3(0.0, 0.0, 2.0), 1.0, [light_data.directional(fm.vec3(0.2, 0.2, 1.0), fm.vec3(3.0, 3.0, 3.0)) >>>]) >>>
    identity := fm.identity_3d()
    shear := fm.Mat4{c0: fm.vec4(1.4, 0.1, 0.3, 0.0), c1: fm.vec4(0.4, 0.75, 0.15, 0.0), c2: fm.vec4(0.1, 0.2, 0.6, 0.0), c3: fm.vec4(0.0, 0.0, 0.0, 1.0)}
    transforms := [identity, fm.scale_3d(fm.vec3(1.3, 0.7, 0.4)), fm.scale_3d(fm.vec3(-1.2, 0.8, 0.4)), shear,
        fm.rotation_y(0.35).multiply(fm.scale_3d(fm.vec3(1.2, 0.8, 0.4))), fm.scale_3d(fm.vec3(10000000.0, 10000000.0, 10000000.0)), fm.scale_3d(fm.vec3(0.0000001, 0.0000001, 0.0000001))]
    for axis in 0:2 {
        $pixels := [colors.rgba8(255, 128, 255, 0) >>>]
        $sampled := fm.vec3(1.0, 1.0 / 255.0, 1.0)
        if axis == 1 { pixels[0] = colors.rgba8(128, 255, 255, 0) >>>
            sampled = fm.vec3(1.0 / 255.0, 1.0, 1.0) }
        $texture := device.texture_rgba(1, 1, &pixels, false, false, false) >>>
        for sign in [1.0, -1.0] {
            for scale in [0.0, 1.0, 2.0] {
                mapped := base.with_normal_texture(&texture, scale) >>>
                for i in 0:transforms.len {
                    world := transforms[i]
                    $orientation := 1.0
                    $size := 1.0
                    if i == 2 { orientation = -1.0 }
                    if i == 5 { size = 0.0000001 }
                    if i == 6 { size = 10000000.0 }
                    source_data := generated_source(sign, size) >>>
                    reference_data := reference(world, sampled, scale, sign, orientation, size) >>>
                    $mesh := device.upload(&source_data) >>>
                    $baked := device.upload(&reference_data) >>>
                    actual := sample($&device, &mesh, world, identity, &mapped, &light) >>>
                    expected := sample($&device, &baked, identity, identity, &base, &light) >>>
                    assert(channel(expected, 0) > 10)
                    equal(actual, expected)
                }
            }
        }
    }
    flat_pixels := [colors.rgba8(128, 128, 255, 255) >>>]
    $flat := device.texture_rgba(1, 1, &flat_pixels, false, true, false) >>>
    $encoded := device.texture_rgba(1, 1, &flat_pixels, true, true, false) >>>
    assert(bad_normal(&base, &encoded, 1.0))
    for scale in [-0.1, 8.1, math.nan(), math.inf(1), math.inf(-1)] { assert(bad_normal(&base, &flat, scale)) }
    source_data := source(2, 1.0, 1.0) >>>
    $mesh := device.upload(&source_data) >>>
    $mapped := base.with_normal_texture(&flat, 1.0) >>>
    equal(sample($&device, &mesh, identity, identity, &mapped, &light) >>>, sample($&device, &mesh, identity, identity, &base, &light) >>>)
    // Every constructor and removal keeps the fourth reference/scale intact.
    white_pixels := [4294967295]
    $white := device.texture_rgba(1, 1, &white_pixels, false, false, false) >>>
    tilt_pixels := [colors.rgba8(255, 128, 255, 255) >>>]
    $tilt := device.texture_rgba(1, 1, &tilt_pixels, false, false, false) >>>
    copy_source := base.with_normal_texture(&tilt, 2.0) >>>
    after_base := copy_source.with_base_texture(&white) >>>
    after_orm := after_base.with_orm_texture(&white, 1.0) >>>
    after_emission := after_orm.with_emission_texture(&white) >>>
    assert(after_emission.has_normal_texture() && after_emission.has_base_texture() && after_emission.has_orm_texture() && after_emission.has_emission_texture())
    equal(sample($&device, &mesh, identity, identity, &after_emission, &light) >>>, sample($&device, &mesh, identity, identity, &copy_source, &light) >>>)
    stripped := after_emission.without_base_texture().without_orm_texture().without_emission_texture()
    assert(stripped.has_normal_texture())
    equal(sample($&device, &mesh, identity, identity, &stripped, &light) >>>, sample($&device, &mesh, identity, identity, &copy_source, &light) >>>)
    removed := after_emission.without_normal_texture()
    assert(!removed.has_normal_texture() && removed.has_base_texture() && removed.has_orm_texture() && removed.has_emission_texture())
    // All 16 combinations, with normal attached FIRST so later map setters
    // must preserve it. Ambient-only expected values are independent of N.
    red_pixels := [colors.rgba8(255, 0, 0, 0) >>>]
    green_pixels := [colors.rgba8(0, 255, 0, 0) >>>]
    orm_pixels := [colors.rgba8(128, 255, 0, 0) >>>]
    $red := device.texture_rgba(1, 1, &red_pixels, true, false, false) >>>
    $green := device.texture_rgba(1, 1, &green_pixels, true, false, false) >>>
    $orm := device.texture_rgba(1, 1, &orm_pixels, false, false, false) >>>
    ambient := light_data.environment(fm.vec3(1.0, 1.0, 1.0), fm.vec3(0.0, 0.0, 2.0), 1.0, [light_data.directional(fm.vec3(0.0, 0.0, 1.0), zero) >>>]) >>>
    uniform_base := ren.material_3d(fm.vec3(1.0, 1.0, 1.0), 0.0, 1.0, fm.vec3(0.25, 0.25, 0.25)) >>>
    rs := [198, 198, 175, 175, 188, 188, 156, 156]
    gs := [198, 124, 175, 124, 198, 124, 175, 124]
    bs := [198, 124, 175, 124, 188, 0, 156, 0]
    for mask in 0:16 {
        $material := uniform_base
        if mask >= 8 { material = material.with_normal_texture(&tilt, 2.0) >>> }
        if mask % 2 == 1 { material = material.with_base_texture(&red) >>> }
        if mask / 2 % 2 == 1 { material = material.with_orm_texture(&orm, 1.0) >>> }
        if mask / 4 % 2 == 1 { material = material.with_emission_texture(&green) >>> }
        assert(material.has_normal_texture() == (mask >= 8))
        pixel := sample($&device, &mesh, identity, identity, &material, &ambient) >>>
        equal(pixel, colors.rgba8(rs[mask % 8], gs[mask % 8], bs[mask % 8], 255) >>>)
    }
    $data := meshes.new_mesh_data_3d()
    for tangent in [fm.vec4(0.0, 0.0, 0.0, 1.0), fm.vec4(0.0, 0.0, 1.0, 1.0), fm.vec4(1.0, 0.0, 0.0, 0.0), fm.vec4(1.0, 0.0, 0.0, 2.0), fm.vec4(math.nan(), 0.0, 0.0, 1.0)] {
        assert(bad_vertex($&data, tangent) && data.vertex_count() == 0)
    }
    for sign in [1.0, -1.0, 1.0] { data.vertex_tangent(fm.vec3(f64(data.vertex_count()) * 0.1, 0.0, 0.5), 4294967295, fm.vec3(0.0, 0.0, 1.0), fm.vec2(0.0, 0.0), fm.vec4(1.0, 0.0, 0.0, sign)) >>> }
    assert(bad_triangle($&data) && data.triangle_count() == 0)
    $tree := nexus.new_scene_tree_3d("Normal maps", 16) >>>
    node := tree.add_child_3d(tree.root(), "Quad") >>>
    $scene := scene_render.new_scene_3d(&device) >>>
    scene.attach_mesh(&tree, node, &mesh) >>>
    scene.set_material(&tree, node, mapped) >>>
    for flag in [0, 1, 3] {
        missing_data := source(flag, 1.0, 1.0) >>>
        $missing := device.upload(&missing_data) >>>
        assert(bad_replace($&scene, &tree, node, &missing))
        device.begin(255) >>>
        assert(bad_draw($&device, &missing, &mapped, &light))
        assert((scene.draw_lit($&device, &tree, identity, &light) >>>).instances == 1)
        device.present() >>>
    }
    // Tangents survive format -> scene adapter -> GPU upload. Mirrored
    // sign changes normal mapping, and a mixed asset fails whole-batch preflight.
    asset := assets.load_glb_geometry("build/glb-fixtures/mixed-tangents.glb") >>>
    $import_tree := nexus.new_scene_tree_3d("Import", 32) >>>
    import_root := import_tree.root()
    instance := assets.instantiate(&asset, $&import_tree, import_root, "Asset") >>>
    $model := glb.upload_unlit(&device, &asset) >>>
    $import_scene := scene_render.new_scene_3d(&device) >>>
    second := instance.primitive_node(1) >>>
    import_scene.attach_mesh(&import_tree, second, &mesh) >>>
    import_scene.set_material(&import_tree, second, mapped) >>>
    assert(bad_model(&model, $&import_scene, &import_tree, &instance) && import_scene.binding_count() == 1)
    green_normal_pixels := [colors.rgba8(128, 255, 255, 255) >>>]
    $green_normal := device.texture_rgba(1, 1, &green_normal_pixels, false, false, false) >>>
    imported_material := base.with_normal_texture(&green_normal, 1.0) >>>
    red_base := ren.material_3d(fm.vec3(0.6, 0.0, 0.0), 0.0, 0.75, zero) >>>
    projection := nexus.perspective_3d(math.pi() / 2.0, 1.0, 0.1, 100.0) >>>
    for name in ["tangents", "tangents-mirrored"] {
        imported_asset := assets.load_glb_geometry("build/glb-fixtures/" + name + ".glb") >>>
        $imported := glb.upload_primitive(&device, &imported_asset, 0) >>>
        probe_node := import_tree.add_child_3d(import_tree.root(), name + "") >>>
        import_scene.attach_mesh(&import_tree, probe_node, &imported) >>>
        import_scene.set_material(&import_tree, probe_node, mapped) >>>
        import_scene.detach_mesh(probe_node) >>>
        $sign := 1.0
        if name == "tangents-mirrored" { sign = -1.0 }
        baked_data := reference(fm.translation_3d(fm.vec3(0.0, 0.0, -2.5)), fm.vec3(1.0 / 255.0, 1.0, 1.0), 1.0, sign, 1.0, 1.0) >>>
        $baked := device.upload(&baked_data) >>>
        actual := sample($&device, &imported, fm.translation_3d(fm.vec3(0.0, 0.0, -2.0)), projection, &imported_material, &light) >>>
        expected := sample($&device, &baked, identity, projection, &red_base, &light) >>>
        equal(actual, expected)
    }
    // Opposite X perturbations must average as LINEAR data in the generated mip,
    // then be renormalized for lighting; encoded-color averaging would tilt X.
    mip_pixels := [colors.rgba8(255, 128, 255, 255) >>>, colors.rgba8(0, 128, 255, 255) >>>]
    sampling := ren.TextureSampling3D{min_linear: true, mag_linear: true, repeat_u: true, repeat_v: true, mip_filter: ren.MIP_LINEAR}
    $mip_texture := device.texture_rgba_sampled(2, 1, &mip_pixels, false, sampling) >>>
    $mip_data := meshes.new_mesh_data_3d()
    us := [0.0, 128.0, 128.0, 0.0]
    ps := [fm.vec3(-0.6, 0.6, 0.5), fm.vec3(0.6, 0.6, 0.5), fm.vec3(0.6, -0.6, 0.5), fm.vec3(-0.6, -0.6, 0.5)]
    for i in 0:4 { mip_data.vertex_tangent(ps[i], 4294967295, fm.vec3(0.0, 0.0, 1.0), fm.vec2(us[i], 0.5), fm.vec4(1.0, 0.0, 0.0, 1.0)) >>> }
    mip_data.triangle(0, 2, 1) >>>
    mip_data.triangle(0, 3, 2) >>>
    $mip_mesh := device.upload(&mip_data) >>>
    mip_material := base.with_normal_texture(&mip_texture, 1.0) >>>
    equal(sample($&device, &mip_mesh, identity, identity, &mip_material, &light) >>>, sample($&device, &mip_mesh, identity, identity, &base, &light) >>>)
    mesh_program_1 := mesh_shaders.load_mesh("build/mesh-shaders") >>>
    $other := ren.open_3d("Foreign normal owner", 32, 32, gpu.AUTO, &mesh_program_1) >>>
    $foreign := other.texture_rgba(1, 1, &flat_pixels, false, false, false) >>>
    foreign_material := base.with_normal_texture(&foreign, 1.0) >>>
    assert(bad_set($&scene, &tree, node, foreign_material))
    device.begin(255) >>>
    assert(bad_draw($&device, &mesh, &foreign_material, &light))
    device.present() >>>
    flat.close() >>>
    $reused := device.texture_rgba(1, 1, &flat_pixels, false, false, false) >>>
    assert(bad_set($&scene, &tree, node, mapped) && bad_normal(&base, &flat, 1.0))
    device.begin(255) >>>
    assert(bad_draw($&device, &mesh, &mapped, &light))
    device.present() >>>
    other.close() >>>
    device.close() >>>
    println("PASS: generated tangent seam splits and baked normal reference for X/Y, scale 0/1/2, both tangent signs, rotation/nonuniform/reflection/shear/1e±7 transforms; four-map preservation, complete tangent preflight, GLB upload, malformed basis and stale/foreign normal maps")
    << 0
}
fn main() int { << run() >>> (err) { eprintln(err.msg())
    << 1 } }
