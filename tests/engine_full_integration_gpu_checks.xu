@main

#gpu
#math
#errors
#window
fm #"github.com/xulang-org/nexus/foundation/math"
mesh #"github.com/xulang-org/nexus/resources/mesh"
lights #"github.com/xulang-org/nexus/resources/lighting"
terr #"github.com/xulang-org/nexus/resources/terrain"
phys #"github.com/xulang-org/nexus/physics3d"
nexus #"github.com/xulang-org/nexus/scene"
inp #"github.com/xulang-org/nexus/input"
pcm #"github.com/xulang-org/nexus/resources/audio"
mixer #"github.com/xulang-org/nexus/audio/mixer"
nav #"github.com/xulang-org/nexus/navigation"
vfx #"github.com/xulang-org/nexus/vfx"
netw #"github.com/xulang-org/nexus/networking"
bc #"github.com/xulang-org/nexus/script/bytecode"
sc #"github.com/xulang-org/nexus/script/compiler"
host #"github.com/xulang-org/nexus/script/host"
rt #"github.com/xulang-org/nexus/integration/script_runtime"
tbridge #"github.com/xulang-org/nexus/integration/terrain"
netbridge #"github.com/xulang-org/nexus/integration/networking"
ren #"github.com/xulang-org/nexus/rendering/three_d"
shd #"github.com/xulang-org/nexus/assets/shaders/three_d"
modern #"github.com/xulang-org/nexus/integration/rendering/three_d"

fn ch_r(c int) int { << (c >> 24) & 255 }
fn ch_g(c int) int { << (c >> 16) & 255 }
fn ch_b(c int) int { << (c >> 8) & 255 }
fn abs_i(v int) int { if v < 0 { << -v } << v }
fn luma(c int) int { << ch_r(c) + ch_g(c) + ch_b(c) }

fn make_box_mesh(hx f64, hy f64, hz f64) mesh.MeshData3D {
    $d := mesh.new_mesh_data_3d()
    white := (255 << 24) | (255 << 16) | (255 << 8) | 255
    p0 := fm.vec3(-hx, -hy, hz)
    p1 := fm.vec3(hx, -hy, hz)
    p2 := fm.vec3(hx, hy, hz)
    p3 := fm.vec3(-hx, hy, hz)
    p4 := fm.vec3(-hx, -hy, -hz)
    p5 := fm.vec3(hx, -hy, -hz)
    p6 := fm.vec3(hx, hy, -hz)
    p7 := fm.vec3(-hx, hy, -hz)

    nf := fm.vec3(0.0, 0.0, 1.0)
    nb := fm.vec3(0.0, 0.0, -1.0)
    nr := fm.vec3(1.0, 0.0, 0.0)
    nl := fm.vec3(-1.0, 0.0, 0.0)
    nu := fm.vec3(0.0, 1.0, 0.0)
    nd := fm.vec3(0.0, -1.0, 0.0)

    faces := [p0, p1, p2, p3, nf, p5, p4, p7, p6, nb, p1, p5, p6, p2, nr, p4, p0, p3, p7, nl, p3, p2, p6, p7, nu, p4, p5, p1, p0, nd]
    for f in 0:6 {
        base := d.vertices.len
        fi := f * 5
        n := faces[fi + 4]
        pts := [faces[fi], faces[fi + 1], faces[fi + 2], faces[fi + 3]]
        uvs := [fm.vec2(0.0, 0.0), fm.vec2(1.0, 0.0), fm.vec2(1.0, 1.0), fm.vec2(0.0, 1.0)]
        for k in 0:4 {
            d.vertices.push(mesh.Vertex3D{
                position: pts[k],
                color: white,
                normal: n,
                uv: uvs[k],
                tangent: fm.vec4(0.0, 0.0, 0.0, 0.0),
                has_uv: true,
                has_tangent: false
            })
        }
        d.triangle(base, base + 1, base + 2) >>>
        d.triangle(base, base + 2, base + 3) >>>
    }
    d.validate() >>>
    << d
}

fn make_water_quad(hx f64, hz f64) mesh.MeshData3D {
    $d := mesh.new_mesh_data_3d()
    white := (255 << 24) | (255 << 16) | (255 << 8) | 255
    n := fm.vec3(0.0, 1.0, 0.0)
    uvs := [fm.vec2(0.0, 0.0), fm.vec2(1.0, 0.0), fm.vec2(1.0, 1.0), fm.vec2(0.0, 1.0)]
    pts := [fm.vec3(-hx, 0.0, -hz), fm.vec3(-hx, 0.0, hz), fm.vec3(hx, 0.0, hz), fm.vec3(hx, 0.0, -hz)]
    for k in 0:4 {
        d.vertices.push(mesh.Vertex3D{
            position: pts[k],
            color: white,
            normal: n,
            uv: uvs[k],
            tangent: fm.vec4(0.0, 0.0, 0.0, 0.0),
            has_uv: true,
            has_tangent: false
        })
    }
    d.triangle(0, 1, 2) >>>
    d.triangle(0, 2, 3) >>>
    d.validate() >>>
    << d
}

fn telemetry_schema() string {
    << "{\"profile\":\"xu-scalar-v1\",\"module\":\"veh_fx\",\"class\":\"VehFx\"," +
       "\"fields\":[{\"id\":1,\"name\":\"bursts\",\"type\":\"f64\",\"default\":0.0}]," +
       "\"signals\":[],\"coroutines\":[{\"id\":100,\"name\":\"exhaust_watch\"}]}"
}

fn telemetry_source() string {
    << "@veh_fx\n" +
       "struct VehFx {\n    bursts f64\n}\n" +
       "pub fn (self \$&VehFx) physics_process(delta f64, axis f64) f64 {\n" +
       "    << delta * 0.0 + axis * 0.0\n" +
       "}\n" +
       "pub fn (self \$&VehFx) exhaust_watch(min_spd f64) f64 {\n" +
       "    spd := bb_get(10.0)\n" +
       "    if spd >= min_spd {\n" +
       "        vfx_burst(0.0, 24.0)\n" +
       "        self.bursts += 1.0\n" +
       "    }\n" +
       "    yield_frame()\n" +
       "    spd2 := bb_get(10.0)\n" +
       "    << spd2 + self.bursts\n" +
       "}\n"
}

fn run_integration() int {
    // =========================================================================
    // 1. Procedural 33x33 Terrain (Valley Drive Lane + Water Basin + Ridge)
    // =========================================================================
    tcfg := terr.TerrainConfig{
        width: 33,
        depth: 33,
        origin: fm.vec3(-16.0, 0.0, -16.0),
        cell_size: 1.0,
        height_scale: 1.0
    }
    $heights := []f64{}
    for iz in 0:33 {
        wz := -16.0 + f64(iz)
        for ix in 0:33 {
            wx := -16.0 + f64(ix)
            // Driving road along x ~ [-4..+3] rises gently toward -Z; water basin at x > 4.5.
            $h := 0.25 * math.sin(wx * 0.15) + math.max(0.0, (-wz - 2.0) * 0.08)
            if wx > 4.5 && wz > -6.0 && wz < 8.0 {
                // Carved lake basin down to y = -2.2
                edge := math.min(1.0, (wx - 4.5) / 2.5)
                h -= 2.4 * edge
            } else if wx < -6.0 {
                // Scenic hillside ridge on -X side
                h += ((-6.0 - wx) * 0.35)
            }
            heights.push(h)
        }
    }
    $terrain := terr.new_heightmap_terrain(tcfg, heights) >>>
    terrain.auto_generate_splat(-1.5, 4.5, 0.45) >>>

    // Extract live Physics3D triangle mesh (32*32*2 = 2048 triangles <= 4096 limit).
    terrain_tris := tbridge.terrain_region_static_triangles(&terrain, 0, 0, 32, 32, 0, 1) >>>

    // =========================================================================
    // 2. Shared Physics3D World: Vehicle Driving on Terrain + Buoyant Crate
    // =========================================================================
    gravity := fm.vec3(0.0, -9.81, 0.0)
    $phys_world := phys.new_jointed_world_3d(gravity, 0.02, 0.05, &[]fm.Aabb3{}, &[]int{}, &terrain_tris) >>>
    ident_q := fm.quaternion(0.0, 0.0, 0.0, 1.0)
    car_he := fm.vec3(0.95, 0.42, 2.0)
    car_id := phys_world.add_body(fm.vec3(0.0, 1.4, 8.0), ident_q, car_he, 1200.0, 0.05, 0.6, 1, 1) >>>
    $car := phys.default_four_wheel_car_3d(car_id, car_he, 1200.0) >>>

    crate_he := fm.vec3(0.5, 0.5, 0.5)
    crate_id := phys_world.add_body(fm.vec3(9.0, 0.8, 1.0), ident_q, crate_he, 500.0, 0.1, 0.4, 1, 1) >>>
    b_crate := phys.new_buoyancy_body_3d(crate_id, phys.buoyancy_pontoons_for_box(crate_he, 2, 2, 2) >>>) >>>
    $buoy_list := [b_crate]
    $fluid := phys.default_fluid_volume_3d(-0.35)
    fluid.wave_amplitude = 0.12
    fluid.wave_frequency = 0.9
    fluid.wave_speed = 2.0
    fluid.flow_velocity = fm.vec3(0.3, 0.0, 0.0)

    dt := 1.0 / 60.0
    // Settle car onto terrain triangles.
    for _ in 0:60 {
        fluid.advance(dt) >>>
        phys.apply_buoyancy_to_jointed_world($&phys_world, &fluid, $&buoy_list, dt) >>>
        _ := car.step($&phys_world, dt, 0.0, 0.0, 0.0, false) >>>
        phys_world.step(dt, 4, 4) >>>
    }
    if car.grounded_wheel_count() != 4 {
        >>> errors.new("Integration: vehicle failed to ground all 4 wheels on HeightmapTerrain triangles")
    }

    // Drive car forward along terrain valley + track wheel contact.
    for _ in 0:90 {
        fluid.advance(dt) >>>
        phys.apply_buoyancy_to_jointed_world($&phys_world, &fluid, $&buoy_list, dt) >>>
        _ := car.step($&phys_world, dt, 0.80, 0.0, 0.0, false) >>>
        phys_world.step(dt, 4, 4) >>>
    }
    car_pos := phys_world.position(car_id) >>>
    car_spd := car.forward_speed_mps(&phys_world) >>>
    car_xform := phys_world.transform_matrix(car_id) >>>
    crate_pos := phys_world.position(crate_id) >>>
    crate_xform := phys_world.transform_matrix(crate_id) >>>

    if car_spd < 4.5 || car_pos.z > 2.0 {
        >>> errors.new("Integration: vehicle did not accelerate forward across terrain triangles")
    }
    if math.abs(crate_pos.y - (-0.35)) > 0.30 || buoy_list[0].submerged_ratio < 0.20 {
        >>> errors.new("Integration: buoyant crate failed to float in terrain basin")
    }

    // Soft-body cargo + wind banner XPBD check on the terrain triangles.
    $xpbd := phys.new_xpbd_world_3d(gravity, 0.10, &[]fm.Aabb3{}, &[]int{}, &terrain_tris) >>>
    xpbd.set_wind(fm.vec3(6.0, 0.2, 2.5), 1.225) >>>
    soft_cargo := xpbd.add_soft_tetra_box(fm.vec3(-1.8, 1.5, 1.0), fm.vec3(0.8, 0.8, 0.8), 2, 2, 2, 0.04, 0.12, 0.0002, 0.00005, 1, 1) >>>
    for _ in 0:60 { xpbd.step(dt, 5, 4) >>> }
    soft_v_err := math.abs((xpbd.current_soft_volume(&soft_cargo) >>>) - soft_cargo.rest_volume) / soft_cargo.rest_volume
    if soft_v_err > 0.05 {
        >>> errors.new("Integration: XPBD soft cargo volume error exceeded 5%")
    }

    // =========================================================================
    // 3. Networking Replication -> SceneTree + XuScript Coroutine Host Runtime
    // =========================================================================
    $server := netw.new_server_session()
    icfg := netw.default_interest_config()
    server.add_peer(1, icfg) >>>
    server.spawn_entity(netw.default_entity_state(1, 1, 1, fm.vec3(0.0, 0.0, 0.0))) >>>
    server.spawn_entity(netw.default_entity_state(2, 1, 2, fm.vec3(0.0, 1.0, 8.0))) >>>
    $client := netw.new_client_session(1, 1, netw.initial_body_state(fm.vec3(0.0, 0.0, 0.0), 0.0), 0.05, 0.10)
    $net_link := netw.new_simulated_link(netw.SimLinkConfig{seed: 77, latency_ms: 15.0, jitter_ms: 4.0, loss_rate: 0.10, duplicate_rate: 0.0, reorder_rate: 0.05}) >>>

    // Push live vehicle entity position over simulated lossy network link to ClientSession.
    for tick in 1:16 {
        now_ms := f64(tick) * 33.333
        $veh_ent := server.entity(2) >>>
        veh_ent.position = car_pos
        server.update_entity(veh_ent) >>>

        out_pkts := server.build_outbound_for_peer(1, tick, fm.vec3(0.0, 0.0, 0.0), now_ms) >>>
        for k in 0:out_pkts.len { net_link.send_b_to_a(&out_pkts[k].data, now_ms) }
        in_pkts := net_link.recv_for_a(now_ms)
        for k in 0:in_pkts.len {
            _ := client.on_packet_from_server(&in_pkts[k].data, now_ms, now_ms * 0.001) >>>
        }
    }

    $tree := nexus.new_scene_tree_3d("EngineWorld", 32) >>>
    car_node := tree.add_child_3d(tree.root(), "PlayerCar") >>>
    $bindings := [netbridge.NetNodeBinding{net_id: 2, node_id: car_node}]
    synced_cnt := netbridge.sync_scene_from_client_session($&tree, &client, &bindings, 15.0 * 0.03333) >>>
    replicated_car_node := tree.node_3d(car_node) >>>
    if synced_cnt != 1 || replicated_car_node.transform.c3.xyz().sub(car_pos).length() > 0.35 {
        >>> errors.new("Integration: SceneTree failed to track replicated vehicle across SimulatedLink")
    }

    // Script Coroutine reacting to live vehicle speed on blackboard -> emits VFX burst!
    sc_mod := sc.compile(telemetry_source(), telemetry_schema(), "veh_fx.xus") >>>
    sc_raw := sc_mod.encode() >>>
    sc_prog := bc.decode(&sc_raw) >>>
    $scripts := host.new_scene_scripts(8) >>>
    sid := scripts.attach(&tree, car_node, sc_prog) >>>
    $imap := inp.new_input_map()
    $empty_phys := phys.new_rigid_world(gravity, []phys.StaticBox3D{}, []phys.StaticRamp3D{}, []phys.StaticTriangle3D{}) >>>
    $aud := mixer.new_mixer(48000, 4) >>>
    pcm_samples := [0, 1000, -1000, 0]
    _ := aud.add_clip(pcm.pcm16(48000, 1, pcm_samples) >>>) >>>
    nv := [fm.vec3(-1.0, 0.0, -1.0), fm.vec3(1.0, 0.0, -1.0), fm.vec3(1.0, 0.0, 1.0), fm.vec3(-1.0, 0.0, 1.0)]
    ni := [0, 2, 1, 0, 3, 2]
    na := [0, 0]
    nf := [1, 1]
    nav_m := nav.build_navmesh(&nv, &ni, 0.78, &na, &nf) >>>
    $vfx2 := vfx.new_particle_system_2d(32, 7, vfx.default_emitter_2d(fm.vec2(0.0, 0.0))) >>>

    $sctx := rt.new_script_host_context()
    sctx.set_bb(10, car_spd) >>>
    $sched := host.new_coroutine_scheduler()
    cid := sched.spawn($&scripts, &tree, sid, "exhaust_watch", 3.0) >>>
    sctx.tick_coroutines($&sched, $&scripts, $&tree, 0.016, &imap, false, $&empty_phys, false, $&aud, false, &nav_m, true, $&vfx2) >>>
    sctx.tick_coroutines($&sched, $&scripts, $&tree, 0.016, &imap, false, $&empty_phys, false, $&aud, false, &nav_m, true, $&vfx2) >>>
    vfx_ev := sctx.drain_vfx_events()
    if sched.status(cid) != host.CORO_COMPLETED || vfx_ev.len != 1 || vfx_ev[0].count != 24 {
        >>> errors.new("Integration: XuScript coroutine failed to trigger exhaust VFX burst from vehicle speed")
    }

    // =========================================================================
    // 4. Master Unified GPU Pipeline Frame (All P0-P2 Rendering Passes Together)
    // =========================================================================
    w := 256
    h := 192
    aspect := f64(w) / f64(h)
    z_near := 0.25
    z_far := 140.0

    prog := shd.load_mesh("build/mesh-shaders") >>>
    cprog := shd.load_clustered_program("build/mesh-shaders") >>>
    iprog := shd.load_indirect_program("build/mesh-shaders") >>>
    pprog := shd.load_postprocess_program("build/mesh-shaders") >>>
    tprog := shd.load_terrain_program("build/mesh-shaders") >>>
    fprog := shd.load_foliage_program("build/mesh-shaders") >>>
    dprog := shd.load_decal_program("build/mesh-shaders") >>>
    aprog := shd.load_atmosphere_program("build/mesh-shaders") >>>
    vprog := shd.load_particle_program("build/mesh-shaders") >>>
    ddgi_prog := shd.load_ddgi_program("build/mesh-shaders") >>>

    win_opts := window.Options{
        title: "Nexus Engine Full Integration",
        width: w,
        height: h,
        resizable: false,
        high_pixel_density: false,
        hidden: true
    }
    $device := ren.open_3d_window(win_opts, gpu.METAL, &prog) >>>
    $mp := modern.new_modern_pipeline_3d(&device, &cprog, &iprog, &pprog) >>>
    $tren := device.terrain_renderer(&tprog) >>>
    $dren := device.decal_renderer(&dprog) >>>
    $aren := device.atmosphere_renderer(&aprog) >>>

    $tc := tbridge.new_terrain_chunked_gpu_3d(&device, &terrain, 16, 2, 1.0, false) >>>
    $tmat := ren.default_terrain_material_3d(-16.0, -16.0, 32.0, 32.0)
    tmat.splat_texture = tc.splat_texture_ref()

    $f_scatter := terr.default_foliage_scatter_config(777)
    f_scatter.spacing = 0.75
    f_scatter.max_instances = 512
    f_scatter.splat_channel = -1
    f_scatter.min_normal_y = 0.70
    placements := terrain.scatter_foliage(&f_scatter) >>>
    grass_cpu := terr.build_grass_clump_mesh(3, 0.25, 0.85) >>>
    $foliage := tbridge.upload_foliage_placements(&device, &fprog, &grass_cpu, &placements) >>>
    wind_cfg := ren.default_foliage_wind_3d()
    fmat := ren.default_foliage_material_3d()

    // Vehicle chassis + floating crate + landmark beacon + water quad
    chassis_cpu := make_box_mesh(car_he.x, car_he.y, car_he.z) >>>
    crate_cpu := make_box_mesh(crate_he.x, crate_he.y, crate_he.z) >>>
    beacon_cpu := make_box_mesh(0.5, 2.5, 0.5) >>>
    water_cpu := make_water_quad(6.5, 7.0) >>>

    $chassis_gpu := device.upload(&chassis_cpu) >>>
    $crate_gpu := device.upload(&crate_cpu) >>>
    $beacon_gpu := device.upload(&beacon_cpu) >>>
    $water_gpu := device.upload(&water_cpu) >>>

    car_mat := ren.material_3d(fm.vec3(0.85, 0.16, 0.12), 0.2, 0.35, fm.vec3(0.0, 0.0, 0.0)) >>>
    crate_mat := ren.material_3d(fm.vec3(0.65, 0.45, 0.22), 0.0, 0.8, fm.vec3(0.0, 0.0, 0.0)) >>>
    beacon_mat := ren.material_3d(fm.vec3(0.95, 0.85, 0.75), 0.0, 0.6, fm.vec3(3.5, 2.2, 0.8)) >>>
    $water_mat := ren.material_3d(fm.vec3(0.10, 0.42, 0.65), 0.1, 0.15, fm.vec3(0.0, 0.0, 0.0)) >>>
    water_mat = water_mat.with_alpha(0.55) >>>
    water_mat = water_mat.with_alpha_blend(true) >>>

    // Build DDGI scene from LOD2 terrain mesh + chassis + beacon
    $ddgi_cfg := ren.default_ddgi_config_3d(fm.vec3(-12.0, 0.8, -12.0), fm.vec3(8.0, 2.5, 8.0), 4, 2, 4) >>>
    ddgi_cfg.rays_per_probe = 32
    ddgi_cfg.sky_radiance = fm.vec3(0.35, 0.55, 0.85)
    ddgi_cfg.ground_radiance = fm.vec3(0.18, 0.16, 0.12)
    $ddgi := device.ddgi_volume(&ddgi_prog, &ddgi_cfg) >>>
    $ddgi_scene := ren.new_ddgi_scene_3d()
    terr_lod_cpu := terrain.build_chunk_mesh(terr.TerrainChunkSpec{
        chunk_x: 0, chunk_z: 0, start_x: 0, start_z: 0,
        cells_x: 32, cells_z: 32, lod: 2, skirt_depth: 0.0, bake_splat_tint: false
    }) >>>
    terr_ddgi_mat := ren.material_3d(fm.vec3(0.35, 0.50, 0.25), 0.0, 0.9, fm.vec3(0.0, 0.0, 0.0)) >>>
    _ := ddgi_scene.add_mesh(&terr_lod_cpu, fm.identity_3d(), &terr_ddgi_mat) >>>
    _ := ddgi_scene.add_mesh(&chassis_cpu, car_xform, &car_mat) >>>
    beacon_world := fm.translation_3d(fm.vec3(-3.5, 2.5, car_pos.z - 5.0))
    _ := ddgi_scene.add_mesh(&beacon_cpu, beacon_world, &beacon_mat) >>>
    _ := ddgi.upload_scene(&device, &ddgi_scene) >>>

    // Static fallback Irr + Camera + Clustered Sun/Beacon lights
    $irr_grid := ren.irradiance_grid_3d(fm.vec3(-20.0, -5.0, -20.0), fm.vec3(40.0, 20.0, 40.0), 2, 2, 2) >>>
    irr_grid.bake_hemisphere(fm.vec3(0.35, 0.50, 0.70), fm.vec3(0.12, 0.14, 0.10), fm.vec3(0.4, 0.75, 0.52), fm.vec3(1.2, 1.1, 1.0)) >>>
    $static_irr := irr_grid.upload(&device) >>>

    eye := fm.vec3(car_pos.x + 2.5, car_pos.y + 4.5, car_pos.z + 11.0)
    target := fm.vec3(car_pos.x + 1.5, car_pos.y + 0.6, car_pos.z - 4.0)
    view := nexus.look_at_3d(eye, target, fm.vec3(0.0, 1.0, 0.0)) >>>
    proj := nexus.perspective_3d(0.95, aspect, z_near, z_far) >>>
    vp := proj.multiply(view)

    sun := lights.directional(fm.vec3(0.35, 0.72, -0.59).normalized() >>>, fm.vec3(2.4, 2.25, 2.0)) >>>
    beacon_pt := lights.point(fm.vec3(-3.5, 3.2, car_pos.z - 5.0), fm.vec3(10.0, 6.5, 3.0), 16.0) >>>
    scene_lights := [sun, beacon_pt]
    mp.prepare_lights(&device, fm.vec3(0.10, 0.12, 0.16), eye, 1.0, &scene_lights, view, proj, z_near, z_far) >>>

    // Cull terrain chunks & foliage
    lod_dists := [24.0, 50.0]
    t_sel := tc.select_visible_chunks(eye, vp, &lod_dists) >>>
    foliage.cull(&device, eye, vp, 18.0, 35.0) >>>

    // Tire track decal at wheel 2 contact point + lake water surface + exhaust GPU particles
    $dq := ren.new_decal_queue_3d()
    wpt := car.states[2].contact_point
    $tire_decal := ren.default_decal_3d(fm.translation_3d(wpt).multiply(fm.scale_3d(fm.vec3(0.9, 1.2, 2.4))))
    tire_decal.albedo = fm.vec3(0.08, 0.08, 0.08)
    tire_decal.opacity = 0.85
    tire_decal.blend_mode = ren.DECAL_BLEND_STAIN
    dq.submit(tire_decal) >>>

    $tq := ren.new_transparent_queue_3d()
    water_world := fm.translation_3d(fm.vec3(10.0, fluid.surface_y, 1.0))
    tq.submit(water_gpu.reference(), water_world, water_mat, 0.0) >>>

    $ps := device.gpu_particle_system(&vprog, 512, 1337) >>>
    $emit := ren.default_particle_emitter_3d(fm.vec3(car_pos.x, car_pos.y + 0.3, car_pos.z + 2.2))
    emit.emitting = false
    emit.life_min = 1.0
    emit.life_max = 1.5
    emit.size_start_min = 0.35
    emit.size_start_max = 0.55
    ps.set_emitter(&emit) >>>
    ps.burst(vfx_ev[0].count * 8) >>>
    ps.step(&device, 0.016) >>>

    $atm_cfg := ren.default_atmosphere_config_3d()
    atm_cfg.fog_density = 0.008

    $pp_cfg := ren.post_process_defaults_3d()
    pp_cfg.ao_enabled = false
    pp_cfg.ssr_enabled = false
    pp_cfg.taa_enabled = false

    opaque_refs := [chassis_gpu.reference(), crate_gpu.reference(), beacon_gpu.reference()]
    opaque_worlds := [car_xform, crate_xform, beacon_world]
    opaque_mats := [car_mat, crate_mat, beacon_mat]

    $opts := modern.default_master_frame_options_3d()
    opts.has_terrain = true
    opts.has_foliage = true
    opts.has_ddgi = true
    opts.update_ddgi = true
    opts.apply_ddgi_chebyshev = true
    opts.ddgi_use_chebyshev = true
    opts.gi_strength = 0.55
    opts.has_decals = true
    opts.has_atmosphere = true
    opts.has_transparent = true
    opts.has_particles = true

    // Warm DDGI 3 frames then render full master world frame!
    for _ in 0:3 { _ := mp.update_ddgi(&device, $&ddgi) >>> }
    opts.update_ddgi = true
    stats := mp.render_master_world_frame(
        $&device, &tren, &t_sel.refs, &t_sel.worlds, &tmat,
        &foliage, &wind_cfg, &fmat,
        &opaque_refs, &opaque_worlds, &opaque_mats,
        $&ddgi, &static_irr,
        &dren, &dq, &aren, &atm_cfg, &tq, &ps,
        eye, view, proj, z_near, z_far, &pp_cfg, &opts
    ) >>>
    px_sky := device.read_pixel(w / 2, 16) >>>
    px_mid := device.read_pixel(w / 2, h / 2 + 24) >>>
    device.present() >>>

    if ch_b(px_sky) < 70 {
        >>> errors.new("Integration GPU: upper sky pixel lacks physical Rayleigh blue scattering")
    }
    if luma(px_mid) < 85 || stats.terrain_triangles <= 0 || stats.opaque_draws != 3 {
        >>> errors.new("Integration GPU: unified scene render output dark or missing terrain/opaque draws")
    }

    // Toggle Atmosphere + DDGI off and confirm framebuffer delta confirms every stage contributed.
    opts.update_ddgi = false
    opts.has_atmosphere = false
    opts.apply_ddgi_chebyshev = false
    _ := mp.render_master_world_frame(
        $&device, &tren, &t_sel.refs, &t_sel.worlds, &tmat,
        &foliage, &wind_cfg, &fmat,
        &opaque_refs, &opaque_worlds, &opaque_mats,
        $&ddgi, &static_irr,
        &dren, &dq, &aren, &atm_cfg, &tq, &ps,
        eye, view, proj, z_near, z_far, &pp_cfg, &opts
    ) >>>
    px_sky_off := device.read_pixel(w / 2, 16) >>>
    px_mid_off := device.read_pixel(w / 2, h / 2 + 24) >>>
    device.present() >>>

    if abs_i(ch_b(px_sky) - ch_b(px_sky_off)) < 40 || abs_i(luma(px_mid) - luma(px_mid_off)) < 15 {
        >>> errors.new("Integration GPU: toggling DDGI/Atmosphere did not produce expected pixel delta")
    }

    println("PASS: Full-Engine Integration (car_spd=" + str(int(car_spd * 10.0)) +
        "dm/s, soft_v_err=" + str(int(soft_v_err * 1000.0)) + "e-3, net_sync=" + str(synced_cnt) +
        ", coro_bursts=" + str(vfx_ev[0].count) + ", tris=" + str(stats.terrain_triangles) +
        ", sky_b=" + str(ch_b(px_sky)) + "->off=" + str(ch_b(px_sky_off)) +
        ", mid_luma=" + str(luma(px_mid)) + "->off=" + str(luma(px_mid_off)) + ")")

    ps.close() >>>
    static_irr.close() >>>
    ddgi.close() >>>
    water_gpu.close() >>>
    beacon_gpu.close() >>>
    crate_gpu.close() >>>
    chassis_gpu.close() >>>
    foliage.close() >>>
    tc.close() >>>
    aren.close() >>>
    dren.close() >>>
    tren.close() >>>
    mp.close() >>>
    device.close() >>>
    << 0
}

fn main() int {
    << run_integration() >>> (err) {
        println("FAIL: " + err.msg())
        << 1
    }
}
