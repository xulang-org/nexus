@main

light_data #"github.com/xulang-org/nexus/resources/lighting"
#gpu
#window
#window/events
#math
ren #"github.com/xulang-org/nexus/rendering/three_d"
canvas #"github.com/xulang-org/nexus/rendering/two_d"
shaders #"github.com/xulang-org/nexus/assets/shaders/three_d"
canvas_shaders #"github.com/xulang-org/nexus/assets/shaders/two_d"
meshes #"github.com/xulang-org/nexus/resources/mesh"
fm #"github.com/xulang-org/nexus/foundation/math"

fn bad_open(program &ren.ShaderProgram3D) bool {
    ren.open_3d("Rejected 3D shader",32,32,gpu.AUTO,program) or(err){ << true }
    << false
}
fn bad_draw(device $&ren.Device3D, mesh ren.MeshRef3D) bool {
    device.draw_reference(mesh,fm.identity_3d()) or(err){ << true }
    << false
}
fn drain_3d(device &ren.Device3D) int {
    id := (device.window() or >>).id()
    for {
        event := device.poll() or >>
        if event.kind==events.EVENT_NONE { <- }
        assert(event.window_id==id)
    }
    << 0
}
fn drain_2d(renderer &canvas.Renderer2D) int {
    id := (renderer.window() or >>).id()
    for {
        event := renderer.poll() or >>
        if event.kind==events.EVENT_NONE { <- }
        assert(event.window_id==id)
    }
    << 0
}
fn run() int {
    program := shaders.load_mesh("build/mesh-shaders") or >>
    invalid := ren.ShaderProgram3D{format: program.format,entrypoint: program.entrypoint+"",vertex: []u8{},fragment: []u8{},
        present_vertex: []u8{},present_fragment: []u8{}}
    before := window.live_count() or >>
    for i in 0:12 { assert(bad_open(&invalid)) }
    assert((window.live_count() or >>)==before)
    $device := ren.open_3d("Independent 3D service",64,64,gpu.AUTO,&program) or >>
    presentation := canvas_shaders.load_canvas("build/mesh-shaders") or >>
    $renderer := canvas.open_2d("2D/3D shared standard event pump",64,64,gpu.AUTO,&presentation) or >>
    $source := meshes.new_mesh_data_3d()
    for point in [fm.vec3(-1.0,-1.0,0.5),fm.vec3(1.0,-1.0,0.5),fm.vec3(0.0,1.0,0.5)] {
        source.vertex_lit_uv(point,4294967295,fm.vec3(0.0,0.0,1.0),fm.vec2(0.0,0.0)) or >>
    }
    source.triangle(0,1,2) or >>
    $mesh := device.upload(&source) or >>
    ref := mesh.reference()
    pixels := [4278190335]
    $texture := device.texture_rgba(1,1,&pixels,true,false,false) or >>
    base := ren.material_3d(fm.vec3(1.0,1.0,1.0),0.0,1.0,fm.vec3(0.0,0.0,0.0)) or >>
    material := base.with_base_texture(&texture) or >>
    light := light_data.environment(fm.vec3(1.0,1.0,1.0), fm.vec3(0.0,0.0,2.0), 1.0, [light_data.directional(fm.vec3(0.0,0.0,1.0), fm.vec3(0.0,0.0,0.0)) or >>]) or >>
    device.begin(255) or >>
    device.draw_material(&mesh,fm.identity_3d(),fm.identity_3d(),&material,&light) or >>
    // Recording retains allocations, but future weak uses reject closed owners.
    mesh.close() or >>
    texture.close() or >>
    assert(bad_draw($&device,ref))
    pixel := device.read_pixel(32,32) or >>
    assert((pixel >> 24)>=186 && (pixel >> 24)<=190 && (pixel & 16777215)==255)
    device.capture("build/independent-3d.png") or >>
    device.present() or >>
    target := device.window() or >>
    target.resize(96,80) or >>
    canvas_window := renderer.window() or >>
    canvas_window.resize(80,72) or >>
    for i in 0:4 { window.pump() or >>
        drain_3d(&device) or >>
        drain_2d(&renderer) or >> }
    device.begin(16711935) or >>
    assert((device.read_pixel(95,79) or >>)==16711935)
    device.present() or >>
    device.close() or >>
    renderer.begin(65535) or >>
    assert((renderer.read_pixel(0,0) or >>)==65535)
    renderer.present() or >>
    renderer.close() or >>
    assert((window.live_count() or >>)==before)
    println("PASS: independent standard 3D material/texture pixels, recorded resource lifetime, shader rollback, resize, shared 2D/3D event pump and shutdown without nexus native code or scene")
    << 0
}
fn main() int { << run() or(err){ eprintln(err.msg())
    << 1 } }
