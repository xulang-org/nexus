@main

fm #"github.com/xulang-org/nexus/foundation/math"
physics #"github.com/xulang-org/nexus/physics3d"
#math

fn box(x f64, y f64, z f64, xx f64, yy f64, zz f64) fm.Aabb3 {
    << fm.Aabb3{minimum: fm.vec3(x, y, z), maximum: fm.vec3(xx, yy, zz)}
}
fn close(a f64, b f64) bool { << math.abs(a - b) < 0.000000001 }

fn rays() int {
    target := box(2.0, 0.0, -1.0, 3.0, 2.0, 1.0)
    farther := box(5.0, 0.0, -1.0, 6.0, 2.0, 1.0)
    origin := fm.vec3(0.0, 1.0, 0.0)
    right := fm.vec3(4.0, 0.0, 0.0)
    solids := [farther, target, target]
    hit := physics.raycast(origin, right, 2.0, &solids) or >>
    assert(hit.collider == 1 && hit.distance == 2.0 && hit.point.x == 2.0 && hit.normal.x == -1.0)
    miss := physics.raycast(origin, right, 1.99, &solids) or >>
    assert(miss.collider == -1 && miss.distance == 1.99 && !miss.started_inside)
    back := physics.raycast(fm.vec3(7.0, 1.0, 0.0), fm.vec3(-1.0, 0.0, 0.0), 8.0, &solids) or >>
    assert(back.collider == 0 && back.distance == 1.0 && back.normal.x == 1.0)
    inside := physics.raycast(fm.vec3(2.0, 1.0, 0.0), right, 3.0, &solids) or >>
    assert(inside.collider == 1 && inside.distance == 0.0 && inside.started_inside && inside.normal.x == 0.0)

    corner := [box(1.0, -1.0, 0.0, 2.0, 1.0, 1.0)]
    graze := physics.raycast(fm.vec3(0.0, 0.0, 0.5), fm.vec3(1.0, 1.0, 0.0), 4.0, &corner) or >>
    assert(graze.collider == 0 && close(graze.point.x, 1.0) && close(graze.point.y, 1.0))
    boundary := physics.raycast(fm.vec3(0.0, 2.0, 1.0), right, 2.0, &solids) or >>
    assert(boundary.collider == 1 && boundary.normal.x == -1.0)
    << 0
}

fn sweeps() int {
    body := box(0.0, 0.0, 0.0, 1.0, 1.0, 1.0)
    thin := box(2.25, -1.0, -1.0, 2.2501, 2.0, 2.0)
    fast := physics.sweep_aabb(body, fm.vec3(100.0, 0.0, 0.0), thin) or >>
    assert(fast.hit && !fast.started_overlapping && close(fast.time, 0.0125) && fast.normal.x == -1.0)
    contact := physics.sweep_aabb(body, fm.vec3(1.25, 0.0, 0.0), thin) or >>
    assert(contact.hit && contact.time == 1.0)
    flush := box(0.0, -1.0, -1.0, 2.0, 0.0, 2.0)
    down := physics.sweep_aabb(body, fm.vec3(0.0, -1.0, 0.0), flush) or >>
    assert(down.hit && !down.started_overlapping && down.time == 0.0 && down.normal.y == 1.0)
    away := physics.sweep_aabb(body, fm.vec3(0.0, 1.0, 0.0), flush) or >>
    assert(!away.hit)
    tangent := physics.sweep_aabb(body, fm.vec3(0.0, 0.0, 2.0), flush) or >>
    assert(!tangent.hit)
    graze := physics.sweep_aabb(body, fm.vec3(4.0, 4.0, 0.0), box(2.0, -2.0, 0.0, 3.0, 1.0, 1.0)) or >>
    assert(!graze.hit)
    overlap := physics.sweep_aabb(body, fm.vec3(-1.0, 0.0, 0.0), body) or >>
    assert(overlap.hit && overlap.time == 0.0 && overlap.started_overlapping && overlap.normal.x == 0.0)
    small := physics.sweep_aabb(body, fm.vec3(0.00000000000001, 0.0, 0.0), thin) or >>
    assert(!small.hit)
    << 0
}

fn sliding() int {
    body := box(0.0, 1.0, 0.0, 1.0, 2.0, 1.0)
    floor := box(-8.0, -1.0, -8.0, 8.0, 0.0, 8.0)
    wall := box(2.0, 0.0, -8.0, 2.01, 3.0, 8.0)
    step := fm.vec3(2.0, -2.0, 3.0)
    solids := [floor, wall]
    result := physics.move_and_slide(body, step, &solids) or >>
    assert(result.collisions == 1 && result.on_wall && result.on_floor && !result.on_ceiling)
    assert(result.travelled.x == 1.0 && result.travelled.y == -1.0 && result.travelled.z == 3.0)
    assert(result.bounds.maximum.x == 2.0 && result.bounds.minimum.y == 0.0)
    reversed := [wall, floor]
    same := physics.move_and_slide(body, step, &reversed) or >>
    assert(same.travelled.x == result.travelled.x && same.travelled.y == result.travelled.y && same.travelled.z == result.travelled.z)

    ceiling := [box(-8.0, 3.0, -8.0, 8.0, 4.0, 8.0)]
    stopped := physics.move_and_slide(body, fm.vec3(0.0, 10.0, -1.0), &ceiling) or >>
    assert(stopped.on_ceiling && !stopped.on_floor && stopped.bounds.maximum.y == 3.0 && stopped.travelled.z == -1.0)
    corridor := [box(-1.0, 0.0, -8.0, 0.0, 4.0, 8.0), box(1.0, 0.0, -8.0, 2.0, 4.0, 8.0)]
    through := physics.move_and_slide(body, fm.vec3(0.0, 0.0, 3.0), &corridor) or >>
    assert(through.collisions == 0 && through.travelled.z == 3.0 && through.travelled.x == 0.0)
    snug_body := box(-0.37, 1.0, 0.0, 1.33, 2.0, 1.0)
    snug_corridor := [box(-1.0, 0.0, -8.0, -0.37, 4.0, 8.0), box(1.33, 0.0, -8.0, 2.0, 4.0, 8.0)]
    along := physics.move_and_slide(snug_body, fm.vec3(1.0, 0.0, 3.0), &snug_corridor) or >>
    assert(along.on_wall && along.travelled.x == 0.0 && along.travelled.z == 3.0)
    assert(along.bounds.minimum.x == snug_body.minimum.x && along.bounds.maximum.x == snug_body.maximum.x)
    back_wall := box(-8.0, 0.0, 4.0, 8.0, 3.0, 4.01)
    corner := [wall, back_wall, floor]
    corner_result := physics.move_and_slide(body, fm.vec3(8.0, -2.0, 5.0), &corner) or >>
    assert(corner_result.collisions == 3 && corner_result.bounds.maximum.x == 2.0 &&
        corner_result.bounds.minimum.y == 0.0 && corner_result.bounds.maximum.z == 4.0)
    << 0
}

fn rejects_motion(body fm.Aabb3, motion fm.Vec3, solids &[]fm.Aabb3) bool {
    physics.move_and_slide(body, motion, solids) or (err) { << true }
    << false
}
fn rejects_ray(direction fm.Vec3, distance f64, solids &[]fm.Aabb3) bool {
    physics.raycast(fm.vec3(0.0, 0.0, 0.0), direction, distance, solids) or (err) { << true }
    << false
}
fn budgets() int {
    body := box(0.0, 0.0, 0.0, 1.0, 1.0, 1.0)
    ahead := fm.vec3(1.0, 0.0, 0.0)
    overlapping := [body]
    assert(rejects_motion(body, ahead, &overlapping))
    empty := []fm.Aabb3{}
    assert(rejects_motion(body, fm.vec3(1000000001.0, 0.0, 0.0), &empty))
    zero := fm.vec3(0.0, 0.0, 0.0)
    assert(rejects_ray(zero, 1.0, &empty) && rejects_ray(ahead, -1.0, &empty))
    invalid := [box(2.0, 0.0, 0.0, 3.0, 0.0, 1.0)]
    assert(rejects_ray(ahead, 1.0, &invalid))
    $solids := []fm.Aabb3{}
    target := box(2.0, 0.0, 0.0, 3.0, 1.0, 1.0)
    for i in 0:physics.MAX_COLLIDERS { solids.push(target) }
    found := physics.raycast(zero, ahead, 2.0, &solids) or >>
    assert(found.collider == 0)
    solids.push(target)
    assert(rejects_ray(ahead, 2.0, &solids) && rejects_motion(body, ahead, &solids))
    << 0
}

fn run() int {
    rays() or >>
    sweeps() or >>
    sliding() or >>
    budgets() or >>
    println("PASS: 3D rays and continuous AABB sweeps, floor/wall/ceiling sliding, corner ties, thin walls and rejected inputs")
    << 0
}
fn main() int { << run() or (err) { eprintln(err.msg())
    << 1 } }
