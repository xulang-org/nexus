@main

meshes #"github.com/xulang-org/nexus/resources/mesh"

fm #"github.com/xulang-org/nexus/foundation/math"
nexus #"github.com/xulang-org/nexus/scene"
#math

fn close(a f64, b f64) bool { << math.abs(a - b) < 0.000001 }
fn invalid_camera() bool {
    nexus.look_at_3d(fm.vec3(0.0, 0.0, 0.0), fm.vec3(0.0, 0.0, 0.0), fm.vec3(0.0, 1.0, 0.0)) >>> (err) { << true }
    << false
}
fn invalid_up() bool {
    nexus.look_at_3d(fm.vec3(0.0, 0.0, 1.0), fm.vec3(0.0, 0.0, 0.0), fm.vec3(0.0, 0.0, 1.0)) >>> (err) { << true }
    << false
}
fn invalid_projection() bool {
    nexus.perspective_3d(1.0, 1.0, 1.0, 0.5) >>> (err) { << true }
    << false
}
fn invalid_index(mesh $&meshes.MeshData3D) bool {
    mesh.triangle(0, 1, 999) >>> (err) { << true }
    << false
}
fn run() int {
    assert((fm.identity_3d().determinant_sign() >>>) == 1)
    assert((fm.scale_3d(fm.vec3(-2.0, 3.0, 4.0)).determinant_sign() >>>) == -1)
    assert((fm.scale_3d(fm.vec3(0.0, 1.0, 1.0)).determinant_sign() >>>) == 0)
    determinant_projection := nexus.perspective_3d(1.0, 1.5, 0.1, 100.0) >>>
    assert((determinant_projection.determinant_sign() >>>) == 1)
    assert((fm.scale_3d(fm.vec3(-1.0, 1.0, 1.0)).multiply(determinant_projection).determinant_sign() >>>) == -1)

    cross := fm.vec3(1.0, 0.0, 0.0).cross(fm.vec3(0.0, 1.0, 0.0))
    assert(cross.x == 0.0 && cross.y == 0.0 && cross.z == 1.0)
    normalized := fm.vec3(3.0, 4.0, 0.0).normalized() >>>
    assert(close(normalized.length(), 1.0))
    tiny := fm.vec3(math.ldexp(3.0, -800), math.ldexp(4.0, -800), 0.0).normalized() >>>
    huge := fm.vec3(math.ldexp(3.0, 800), math.ldexp(4.0, 800), 0.0).normalized() >>>
    assert(close(tiny.x, 0.6) && close(tiny.y, 0.8) && close(huge.x, 0.6) && close(huge.y, 0.8))
    rotation := fm.rotation_y(math.pi() / 2.0)
    forward := rotation.transform(fm.vec4(0.0, 0.0, -1.0, 0.0))
    assert(close(forward.x, -1.0) && close(forward.z, 0.0))
    transform := fm.translation_3d(fm.vec3(3.0, 4.0, 5.0)).multiply(rotation).multiply(fm.scale_3d(fm.vec3(2.0, 3.0, 4.0)))
    point := transform.transform(fm.vec4(0.0, 0.0, -1.0, 1.0))
    assert(close(point.x, -1.0) && close(point.y, 4.0) && close(point.z, 5.0) && point.w == 1.0)
    projection := nexus.perspective_3d(math.pi() / 2.0, 2.0, 0.1, 100.0) >>>
    near := projection.transform(fm.vec4(0.0, 0.0, -0.1, 1.0))
    far := projection.transform(fm.vec4(0.0, 0.0, -100.0, 1.0))
    assert(close(near.z / near.w, 1.0) && close(far.z / far.w, 0.0))
    right := projection.transform(fm.vec4(2.0, 0.0, -1.0, 1.0))
    top := projection.transform(fm.vec4(0.0, 1.0, -1.0, 1.0))
    assert(close(right.x / right.w, 1.0) && close(top.y / top.w, 1.0))
    view := nexus.look_at_3d(fm.vec3(3.0, 4.0, 5.0), fm.vec3(3.0, 4.0, 4.0), fm.vec3(0.0, 1.0, 0.0)) >>>
    origin := view.transform(fm.vec4(3.0, 4.0, 5.0, 1.0))
    assert(close(origin.x, 0.0) && close(origin.y, 0.0) && close(origin.z, 0.0))
    assert(invalid_camera() && invalid_up() && invalid_projection())
    $mesh := meshes.new_mesh_data_3d()
    for position in [fm.vec3(-1.0, -1.0, 0.0), fm.vec3(1.0, -1.0, 0.0), fm.vec3(0.0, 1.0, 0.0)] {
        mesh.vertex(position, 4294967295) >>>
    }
    assert(invalid_index($&mesh) && mesh.triangle_count() == 0)
    mesh.triangle(0, 1, 2) >>>
    assert(mesh.vertex_count() == 3 && mesh.triangle_count() == 1)
    println("3D CPU checks passed: basis, composition, camera, reverse-Z, aspect, invalid inputs, mesh indices")
    << 0
}
fn main() int { << run() >>> (err) { eprintln(err.msg())
    << 1 } }
