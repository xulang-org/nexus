@main

fm #"github.com/xulang-org/nexus/foundation/math"
p #"github.com/xulang-org/nexus/physics3d"
#math

fn box(x f64, y f64, z f64, xx f64, yy f64, zz f64) fm.Aabb3 {
    << fm.Aabb3{minimum: fm.vec3(x, y, z), maximum: fm.vec3(xx, yy, zz)}
}
fn solid(bounds fm.Aabb3, layer int) p.StaticBox3D {
    << p.StaticBox3D{bounds: bounds, layer: layer, trigger: false}
}
fn near(a f64, b f64, tol f64) bool { << math.abs(a - b) <= tol }

fn triangle_geometry_and_rays() int {
    // 1. Closest point across all 7 Voronoi regions of a tilted 3D triangle.
    tri := p.static_triangle_3d(fm.vec3(0.0, 0.0, 0.0), fm.vec3(2.0, 0.0, 0.0), fm.vec3(0.0, 1.0, 2.0), 1) >>>
    n := tri.normal() >>>
    // (2,0,0) x (0,1,2) = (0, -4, 2) -> wait: ab x ac = (0, -4, 2) -> unit (0, -2/sqrt(5), 1/sqrt(5))
    assert(near(n.length(), 1.0, 0.000001))
    // Vertex A, B, C regions
    qa := p.closest_point_triangle(fm.vec3(-1.0, -1.0, -1.0), tri) >>>
    assert(near(qa.x, 0.0, 0.000001) && near(qa.y, 0.0, 0.000001) && near(qa.z, 0.0, 0.000001))
    qb := p.closest_point_triangle(fm.vec3(4.0, -0.5, -0.5), tri) >>>
    assert(near(qb.x, 2.0, 0.000001) && near(qb.y, 0.0, 0.000001) && near(qb.z, 0.0, 0.000001))
    qc := p.closest_point_triangle(fm.vec3(-0.5, 3.0, 5.0), tri) >>>
    assert(near(qc.x, 0.0, 0.000001) && near(qc.y, 1.0, 0.000001) && near(qc.z, 2.0, 0.000001))
    // Edge AB midpoint region
    qab := p.closest_point_triangle(fm.vec3(1.0, -2.0, -1.0), tri) >>>
    assert(near(qab.x, 1.0, 0.000001) && near(qab.y, 0.0, 0.000001) && near(qab.z, 0.0, 0.000001))
    // Interior point projected along face normal
    centroid := fm.vec3(2.0 / 3.0, 1.0 / 3.0, 2.0 / 3.0)
    offset := centroid.add(n.scaled(3.5))
    qface := p.closest_point_triangle(offset, tri) >>>
    assert(near(qface.x, centroid.x, 0.000001) && near(qface.y, centroid.y, 0.000001) && near(qface.z, centroid.z, 0.000001))

    // 2. Transform triangle by rotation + translation.
    xf := fm.translation_3d(fm.vec3(1.0, 2.0, 3.0)).multiply(fm.rotation_y(0.7))
    moved := p.transform_triangle_3d(fm.vec3(0.0, 0.0, 0.0), fm.vec3(0.0, 0.0, 2.0), fm.vec3(2.0, 0.0, 0.0), xf, 1) >>>
    mn := moved.normal() >>>
    assert(near(mn.y, 1.0, 0.000001))

    // 3. Raycast against arbitrary triangles (both sides, miss, started_inside).
    wall_tri := p.static_triangle_3d(fm.vec3(3.0, -1.0, -2.0), fm.vec3(3.0, 3.0, -2.0), fm.vec3(3.0, -1.0, 4.0), 1) >>>
    tris := [wall_tri]
    front := p.raycast_triangles(fm.vec3(0.0, 0.0, 0.0), fm.vec3(1.0, 0.0, 0.0), 10.0, &tris) >>>
    assert(front.collider == 0 && near(front.distance, 3.0, 0.000001) && near(front.normal.x, -1.0, 0.000001))
    back := p.raycast_triangles(fm.vec3(5.0, 0.0, 0.0), fm.vec3(-1.0, 0.0, 0.0), 10.0, &tris) >>>
    assert(back.collider == 0 && near(back.distance, 2.0, 0.000001) && near(back.normal.x, 1.0, 0.000001))
    miss := p.raycast_triangles(fm.vec3(0.0, 5.0, 0.0), fm.vec3(1.0, 0.0, 0.0), 10.0, &tris) >>>
    assert(miss.collider == -1)
    on_face := p.raycast_triangles(fm.vec3(3.0, 0.0, 0.0), fm.vec3(1.0, 0.0, 0.0), 5.0, &tris) >>>
    assert(on_face.collider == 0 && on_face.started_inside && on_face.distance == 0.0)
    << 0
}

fn capsule_arbitrary_mesh_tests() int {
    // 1. High-speed upright capsule vs 0-thickness diagonally oriented 3D wall triangle.
    // Wall lies on plane x + z = 4.0 (normal (-sqrt(0.5), 0, -sqrt(0.5))).
    diag_wall := p.static_triangle_3d(fm.vec3(0.0, -2.0, 4.0), fm.vec3(4.0, -2.0, 0.0), fm.vec3(2.0, 6.0, 2.0), 1) >>>
    cap := p.capsule_3d(fm.vec3(0.0, 0.6, 0.0), 0.5, 0.3) >>>
    // Distance from (0,0) to plane x+z=4 is 4/sqrt(2) = 2*sqrt(2).
    // Moving along (1,0,1) of total length 40*sqrt(2): hit at (2*sqrt(2) - 0.5) / (40*sqrt(2)).
    hit := p.sweep_capsule_triangle(cap, fm.vec3(40.0, 0.0, 40.0), diag_wall) >>>
    expected_t := (2.0 * math.sqrt(2.0) - 0.5) / (40.0 * math.sqrt(2.0))
    assert(hit.hit && !hit.started_overlapping && near(hit.time, expected_t, 0.0001))
    assert(near(hit.normal.x, -math.sqrt(0.5), 0.001) && near(hit.normal.z, -math.sqrt(0.5), 0.001))

    // 2. Capsule character walking up an arbitrary rotated 3D triangle ramp (35 deg yaw, gentle slope).
    xf := fm.rotation_y(0.6)
    // Local quad rising +1 in Y over 4 units along +X (slope = 14 deg, walkable).
    a := fm.vec3(-2.0, 0.0, -2.0)
    b := fm.vec3(2.0, 1.0, -2.0)
    c := fm.vec3(2.0, 1.0, 2.0)
    d := fm.vec3(-2.0, 0.0, 2.0)
    t0 := p.transform_triangle_3d(a, c, b, xf, 1) >>>
    t1 := p.transform_triangle_3d(a, d, c, xf, 1) >>>
    world := p.new_capsule_mesh_world([]p.StaticBox3D{}, []p.StaticRamp3D{}, [t0, t1]) >>>
    policy := p.CapsuleController3D{solid_mask: 1, trigger_mask: 0, step_height: 0.0, ground_snap: 0.08, min_floor_y: 0.7}

    // Drop capsule onto the rotated triangle ramp.
    uphill_dir := xf.transform(fm.vec4(1.0, 0.0, 0.0, 0.0)).xyz()
    start_xz := uphill_dir.scaled(-1.0)
    spawn := p.capsule_3d(fm.vec3(start_xz.x, 2.5, start_xz.z), 0.25, 0.35) >>>
    landed := world.move_capsule(spawn, fm.vec3(0.0, -2.5, 0.0), policy) >>>
    assert(landed.grounded && landed.floor_triangle >= 0 && landed.floor_ramp == -1 && landed.floor_normal.y > 0.9)

    // Walk uphill along rotated direction for 12 steps.
    $body := landed.body
    start_y := body.center.y
    step_move := fm.vec3(uphill_dir.x * 0.12, -0.01, uphill_dir.z * 0.12)
    for i in 0:12 {
        res := world.move_capsule(body, step_move, policy) >>>
        assert(res.grounded && !res.on_wall && res.floor_triangle >= 0)
        assert(near(res.travelled.y, 0.03, 0.002))
        body = res.body
    }
    assert(near(body.center.y - start_y, 0.36, 0.01))

    // 3. Steep arbitrary triangle (65 deg) blocks uphill climbing.
    steep_t := p.static_triangle_3d(fm.vec3(1.0, 0.0, -2.0), fm.vec3(1.0, 0.0, 2.0), fm.vec3(2.0, 2.2, 0.0), 1) >>>
    deck := solid(box(-3.0, -0.5, -3.0, 3.0, 0.0, 3.0), 1)
    steep_world := p.new_capsule_mesh_world([deck], []p.StaticRamp3D{}, [steep_t]) >>>
    walker := p.capsule_3d(fm.vec3(0.0, 0.6, 0.0), 0.25, 0.35) >>>
    blocked := steep_world.move_capsule(walker, fm.vec3(2.0, -0.02, 0.0), policy) >>>
    assert(blocked.on_wall && blocked.body.center.x < 1.1)

    // 4. Slanted arbitrary 3D triangle ceiling stops upward jump cleanly.
    ceil_tri := p.static_triangle_3d(fm.vec3(-2.0, 2.0, -2.0), fm.vec3(2.0, 2.2, -2.0), fm.vec3(0.0, 2.0, 2.0), 1) >>>
    ceil_world := p.new_capsule_mesh_world([deck], []p.StaticRamp3D{}, [ceil_tri]) >>>
    jumper := p.capsule_3d(fm.vec3(0.0, 0.6, 0.0), 0.25, 0.35) >>>
    bumped := ceil_world.move_capsule(jumper, fm.vec3(0.0, 3.0, 0.0), policy) >>>
    assert(bumped.on_ceiling && bumped.body.center.y < 1.55)

    // 5. Starting overlap with a static triangle is rejected.
    inside_cap := p.capsule_3d(fm.vec3(0.0, 2.0, 0.0), 0.25, 0.35) >>>
    assert(rejects_capsule_mesh(&ceil_world, inside_cap, fm.vec3(0.0, -0.1, 0.0), policy))
    << 0
}

fn rejects_capsule_mesh(world &p.CapsuleWorld3D, body p.Capsule3D, motion fm.Vec3, policy p.CapsuleController3D) bool {
    world.move_capsule(body, motion, policy) >>> (err) { << true }
    << false
}

fn rigid_bounce_and_momentum() int {
    // 1. Free-fall bounce with restitution = 0.8 vs 0.0.
    floor := solid(box(-10.0, -1.0, -10.0, 10.0, 0.0, 10.0), 1)
    $w := p.new_rigid_world(fm.vec3(0.0, -9.8, 0.0), [floor], []p.StaticRamp3D{}, []p.StaticTriangle3D{}) >>>
    $bouncy := p.dynamic_sphere_3d(fm.vec3(-2.0, 3.0, 0.0), 0.5, 1.0, 0.8, 0.2) >>>
    bouncy.linear_damping = 0.0
    $dead := p.dynamic_sphere_3d(fm.vec3(2.0, 3.0, 0.0), 0.5, 1.0, 0.0, 0.2) >>>
    dead.linear_damping = 0.0
    b_id := w.add_body(bouncy) >>>
    d_id := w.add_body(dead) >>>
    $max_rebound_y := 0.0
    $hit_floor := false
    for frame in 0:120 {
        w.step(1.0 / 60.0, 4, 8) >>>
        sb := w.body(b_id) >>>
        if sb.velocity.y > 1.0 { hit_floor = true }
        if hit_floor && sb.position.y > max_rebound_y { max_rebound_y = sb.position.y }
    }
    // Initial drop height above rest = 2.5m; e=0.8 -> rebound height = 0.5 + 0.64 * 2.5 = 2.1m.
    assert(hit_floor && max_rebound_y > 1.9 && max_rebound_y < 2.3)
    sd := w.body(d_id) >>>
    assert(sd.grounded && near(sd.position.y, 0.5, 0.01) && math.abs(sd.velocity.y) < 0.05)

    // 2. Elastic head-on Sphere-Sphere collision: exact momentum exchange in zero gravity.
    $space := p.new_rigid_world(fm.vec3(0.0, 0.0, 0.0), []p.StaticBox3D{}, []p.StaticRamp3D{}, []p.StaticTriangle3D{}) >>>
    $s0 := p.dynamic_sphere_3d(fm.vec3(-2.0, 0.0, 0.0), 0.5, 1.0, 1.0, 0.0) >>>
    s0.linear_damping = 0.0
    s0.velocity = fm.vec3(6.0, 0.0, 0.0)
    $s1 := p.dynamic_sphere_3d(fm.vec3(0.0, 0.0, 0.0), 0.5, 1.0, 1.0, 0.0) >>>
    s1.linear_damping = 0.0
    i0 := space.add_body(s0) >>>
    i1 := space.add_body(s1) >>>
    for step in 0:30 { space.step(1.0 / 60.0, 4, 8) >>> }
    r0 := space.body(i0) >>>
    r1 := space.body(i1) >>>
    assert(near(r0.velocity.x, 0.0, 0.05) && near(r1.velocity.x, 6.0, 0.05))

    // 3. Unequal mass Box-Box momentum conservation (m1=2, v1=4 vs m2=6, v2=0; total p = 8).
    $b0 := p.dynamic_box_3d(fm.vec3(-2.0, 5.0, 0.0), fm.vec3(0.5, 0.5, 0.5), 2.0, 0.5, 0.0) >>>
    b0.linear_damping = 0.0
    b0.velocity = fm.vec3(4.0, 0.0, 0.0)
    $b1 := p.dynamic_box_3d(fm.vec3(0.0, 5.0, 0.0), fm.vec3(0.5, 0.5, 0.5), 6.0, 0.5, 0.0) >>>
    b1.linear_damping = 0.0
    j0 := space.add_body(b0) >>>
    j1 := space.add_body(b1) >>>
    for step in 0:40 { space.step(1.0 / 60.0, 4, 8) >>> }
    rb0 := space.body(j0) >>>
    rb1 := space.body(j1) >>>
    momentum := 2.0 * rb0.velocity.x + 6.0 * rb1.velocity.x
    assert(near(momentum, 8.0, 0.05) && rb1.velocity.x > 1.0 && rb0.velocity.x < rb1.velocity.x)

    // 4. Dynamic Sphere vs Dynamic Box momentum conservation (m_s=1, v=6 vs m_b=3, v=0; p = 6).
    $sb_s := p.dynamic_sphere_3d(fm.vec3(-2.0, 10.0, 0.0), 0.5, 1.0, 0.6, 0.0) >>>
    sb_s.linear_damping = 0.0
    sb_s.velocity = fm.vec3(6.0, 0.0, 0.0)
    $sb_b := p.dynamic_box_3d(fm.vec3(0.0, 10.0, 0.0), fm.vec3(0.5, 0.5, 0.5), 3.0, 0.6, 0.0) >>>
    sb_b.linear_damping = 0.0
    assert(near(sb_s.kinetic_energy(), 18.0, 0.001))
    ks := space.add_body(sb_s) >>>
    kb := space.add_body(sb_b) >>>
    for step in 0:40 { space.step(1.0 / 60.0, 4, 8) >>> }
    rs := space.body(ks) >>>
    rb := space.body(kb) >>>
    assert(near(1.0 * rs.velocity.x + 3.0 * rb.velocity.x, 6.0, 0.05) && rb.velocity.x > 2.0 && rs.velocity.x < 0.0)

    // 5. Rotated rigid box OBB SAT collision & bounds (45-deg rotated boxes).
    s45 := math.sin(0.39269908169872414) // sin(22.5 deg) -> 45 deg Z rotation
    c45 := math.cos(0.39269908169872414)
    q45 := fm.vec4(0.0, 0.0, s45, c45)
    $rot_a := p.dynamic_box_3d(fm.vec3(-1.3, 20.0, 0.0), fm.vec3(0.5, 0.5, 0.5), 1.0, 0.8, 0.0) >>>
    rot_a.orientation = q45
    rot_a.linear_damping = 0.0
    rot_a.velocity = fm.vec3(2.0, 0.0, 0.0)
    $rot_b := p.dynamic_box_3d(fm.vec3(0.0, 20.0, 0.0), fm.vec3(0.5, 0.5, 0.5), 1.0, 0.8, 0.0) >>>
    rot_b.orientation = q45
    rot_b.linear_damping = 0.0
    // Verify rotated world AABB reflects 45-deg extent (~0.707 > 0.5).
    rb_aabb := rot_a.bounds() >>>
    assert((rb_aabb.maximum.x - rb_aabb.minimum.x) > 1.35)
    ra_id := space.add_body(rot_a) >>>
    rb_id := space.add_body(rot_b) >>>
    for step in 0:20 { space.step(1.0 / 60.0, 4, 8) >>> }
    ra_after := space.body(ra_id) >>>
    rb_after := space.body(rb_id) >>>
    // Two 45-deg tilted boxes collide along their 45-deg face normal and separate cleanly.
    assert(rb_after.velocity.length() > 1.0 && ra_after.velocity.length() < 1.7)
    assert(rb_after.position.sub(ra_after.position).length() > 1.35)

    // Rotated box (45 deg) vs unrotated box colliding past axis-aligned extent (> 1.0).
    $mix_w := p.new_rigid_world(fm.vec3(0.0, 0.0, 0.0), []p.StaticBox3D{}, []p.StaticRamp3D{}, []p.StaticTriangle3D{}) >>>
    $tilted := p.dynamic_box_3d(fm.vec3(-1.35, 0.0, 0.0), fm.vec3(0.5, 0.5, 0.5), 1.0, 0.8, 0.0) >>>
    tilted.orientation = q45
    tilted.linear_damping = 0.0
    tilted.velocity = fm.vec3(2.0, 0.0, 0.0)
    $flat := p.dynamic_box_3d(fm.vec3(0.0, 0.0, 0.0), fm.vec3(0.5, 0.5, 0.5), 1.0, 0.8, 0.0) >>>
    flat.linear_damping = 0.0
    ti_id := mix_w.add_body(tilted) >>>
    fl_id := mix_w.add_body(flat) >>>
    for step in 0:20 { mix_w.step(1.0 / 60.0, 4, 8) >>> }
    assert((mix_w.body(fl_id) >>>).velocity.x > 1.2 && (mix_w.body(ti_id) >>>).velocity.x < 0.8)
    assert((mix_w.body(fl_id) >>>).position.x - (mix_w.body(ti_id) >>>).position.x > 1.2)

    // Diagonal separation check: AABBs overlap (0.8 < 1.414), but OBBs do NOT (dist=1.131 > 1.0)!
    $sep_world := p.new_rigid_world(fm.vec3(0.0, 0.0, 0.0), []p.StaticBox3D{}, []p.StaticRamp3D{}, []p.StaticTriangle3D{}) >>>
    $diag_a := p.dynamic_box_3d(fm.vec3(0.0, 0.0, 0.0), fm.vec3(0.5, 0.5, 0.5), 1.0, 0.8, 0.0) >>>
    diag_a.orientation = q45
    $diag_b := p.dynamic_box_3d(fm.vec3(0.8, 0.8, 0.0), fm.vec3(0.5, 0.5, 0.5), 1.0, 0.8, 0.0) >>>
    diag_b.orientation = q45
    _ := sep_world.add_body(diag_a) >>>
    _ := sep_world.add_body(diag_b) >>>
    sep_rep := sep_world.step(1.0 / 60.0, 2, 4) >>>
    assert(sep_rep.contacts == 0)
    << 0
}

fn rigid_arbitrary_triangle_and_ccd() int {
    // 1. Sphere and Box sliding down a 30-degree diagonally rotated 3D triangle slope.
    // Local slope drops along +X: y = 3.0 - x * tan(30 deg), width in Z = [-4, 4].
    tan30 := 1.0 / math.sqrt(3.0)
    xf := fm.rotation_y(0.55)
    v0 := fm.vec3(-3.0, 3.0 + 3.0 * tan30, -4.0)
    v1 := fm.vec3(5.0, 3.0 - 5.0 * tan30, -4.0)
    v2 := fm.vec3(5.0, 3.0 - 5.0 * tan30, 4.0)
    v3 := fm.vec3(-3.0, 3.0 + 3.0 * tan30, 4.0)
    t0 := p.transform_triangle_3d(v0, v2, v1, xf, 1) >>>
    t1 := p.transform_triangle_3d(v0, v3, v2, xf, 1) >>>
    floor := solid(box(-20.0, -1.0, -20.0, 20.0, 0.0, 20.0), 1)
    $w := p.new_rigid_world(fm.vec3(0.0, -9.8, 0.0), [floor], []p.StaticRamp3D{}, [t0, t1]) >>>

    // Drop a low-friction sphere and a low-friction box onto the tilted triangle surface.
    sphere := p.dynamic_sphere_3d(fm.vec3(0.0, 4.0, 0.0), 0.4, 1.0, 0.1, 0.05) >>>
    crate := p.dynamic_box_3d(fm.vec3(0.0, 4.2, 1.4), fm.vec3(0.35, 0.35, 0.35), 2.0, 0.0, 0.08) >>>
    sp_id := w.add_body(sphere) >>>
    bx_id := w.add_body(crate) >>>
    for f in 0:90 { w.step(1.0 / 60.0, 4, 10) >>> }
    down_dir := xf.transform(fm.vec4(1.0, 0.0, 0.0, 0.0)).xyz()
    sp := w.body(sp_id) >>>
    bx := w.body(bx_id) >>>
    // Both must have slid significantly downhill along down_dir and never tunneled below floor y=0.
    assert(sp.position.dot(down_dir) > 1.5 && sp.position.y >= 0.38)
    assert(bx.position.dot(down_dir) > 1.0 && bx.position.y >= 0.33)

    // 2. High-friction vs low-friction box on a gentle 14-degree arbitrary triangle slope.
    // tan(14 deg) ~= 0.25 -> friction 0.7 holds still, friction 0.05 slides!
    g0 := p.static_triangle_3d(fm.vec3(-4.0, 2.0, -4.0), fm.vec3(4.0, 0.0, 4.0), fm.vec3(4.0, 0.0, -4.0), 1) >>>
    g1 := p.static_triangle_3d(fm.vec3(-4.0, 2.0, -4.0), fm.vec3(-4.0, 2.0, 4.0), fm.vec3(4.0, 0.0, 4.0), 1) >>>
    $fw := p.new_rigid_world(fm.vec3(0.0, -9.8, 0.0), []p.StaticBox3D{}, []p.StaticRamp3D{}, [g0, g1]) >>>
    sticky := p.dynamic_box_3d(fm.vec3(0.0, 1.32, -1.5), fm.vec3(0.3, 0.3, 0.3), 1.0, 0.0, 0.8) >>>
    slick := p.dynamic_box_3d(fm.vec3(0.0, 1.32, 1.5), fm.vec3(0.3, 0.3, 0.3), 1.0, 0.0, 0.05) >>>
    st_id := fw.add_body(sticky) >>>
    sl_id := fw.add_body(slick) >>>
    for f in 0:90 { fw.step(1.0 / 60.0, 4, 12) >>> }
    assert((fw.body(st_id) >>>).position.x < 0.25)
    assert((fw.body(sl_id) >>>).position.x > 1.2)

    // 3. High-speed anti-tunneling CCD for both sphere and box against a 0-thickness triangle wall AND a 0.01m box wall.
    // At 300 m/s over dt=1/60s, motion is 5.0m (far past the 0.01m wall at x=3.0).
    thin_box := solid(box(3.0, -5.0, -5.0, 3.01, 5.0, 5.0), 1)
    thin_tri := p.static_triangle_3d(fm.vec3(3.0, -5.0, -5.0), fm.vec3(3.0, 10.0, -5.0), fm.vec3(3.0, -5.0, 15.0), 1) >>>
    $cw1 := p.new_rigid_world(fm.vec3(0.0, 0.0, 0.0), [thin_box], []p.StaticRamp3D{}, []p.StaticTriangle3D{}) >>>
    $fast_sp := p.dynamic_sphere_3d(fm.vec3(0.0, 0.0, 0.0), 0.3, 1.0, 0.5, 0.0) >>>
    fast_sp.velocity = fm.vec3(300.0, 0.0, 0.0)
    $fast_bx := p.dynamic_box_3d(fm.vec3(0.0, 2.0, 0.0), fm.vec3(0.3, 0.3, 0.3), 1.0, 0.5, 0.0) >>>
    fast_bx.velocity = fm.vec3(300.0, 0.0, 0.0)
    fsp := cw1.add_body(fast_sp) >>>
    fbx := cw1.add_body(fast_bx) >>>
    rep1 := cw1.step(1.0 / 60.0, 1, 8) >>>
    assert(rep1.ccd_hits >= 2)
    assert((cw1.body(fsp) >>>).position.x < 3.0 && (cw1.body(fsp) >>>).velocity.x < 0.0)
    assert((cw1.body(fbx) >>>).position.x < 3.0 && (cw1.body(fbx) >>>).velocity.x < 0.0)

    $cw2 := p.new_rigid_world(fm.vec3(0.0, 0.0, 0.0), []p.StaticBox3D{}, []p.StaticRamp3D{}, [thin_tri]) >>>
    fsp2 := cw2.add_body(fast_sp) >>>
    fbx2 := cw2.add_body(fast_bx) >>>
    rep2 := cw2.step(1.0 / 60.0, 1, 8) >>>
    assert(rep2.ccd_hits >= 2)
    assert((cw2.body(fsp2) >>>).position.x < 3.0 && (cw2.body(fsp2) >>>).velocity.x < 0.0)
    assert((cw2.body(fbx2) >>>).position.x < 3.0 && (cw2.body(fbx2) >>>).velocity.x < 0.0)
    << 0
}

fn rigid_stacking_sleep_wake_and_queries() int {
    // 1. 3-box vertical stack settles cleanly and enters sleep.
    floor := solid(box(-10.0, -1.0, -10.0, 10.0, 0.0, 10.0), 1)
    trigger := p.StaticBox3D{bounds: box(-1.0, 0.0, -1.0, 1.0, 1.2, 1.0), layer: 4, trigger: true}
    ramp := p.StaticRamp3D{bounds: box(4.0, 0.0, -2.0, 8.0, 2.0, 2.0), direction: p.RAMP_POSITIVE_X, layer: 2}
    tri := p.static_triangle_3d(fm.vec3(-6.0, 0.0, -2.0), fm.vec3(-6.0, 3.0, -2.0), fm.vec3(-6.0, 0.0, 2.0), 2) >>>
    $w := p.new_rigid_world(fm.vec3(0.0, -9.8, 0.0), [floor, trigger], [ramp], [tri]) >>>

    b0 := w.add_body(p.dynamic_box_3d(fm.vec3(0.0, 0.5, 0.0), fm.vec3(0.5, 0.5, 0.5), 1.0, 0.0, 0.6) >>>) >>>
    b1 := w.add_body(p.dynamic_box_3d(fm.vec3(0.0, 1.51, 0.0), fm.vec3(0.5, 0.5, 0.5), 1.0, 0.0, 0.6) >>>) >>>
    b2 := w.add_body(p.dynamic_box_3d(fm.vec3(0.0, 2.52, 0.0), fm.vec3(0.5, 0.5, 0.5), 1.0, 0.0, 0.6) >>>) >>>
    $last_report := p.RigidStepReport3D{substeps: 0, broadphase_pairs: 0, contacts: 0, ccd_hits: 0, awake_bodies: 0, sleeping_bodies: 0}
    for f in 0:150 {
        last_report = w.step(1.0 / 60.0, 4, 16) >>>
    }
    s0 := w.body(b0) >>>
    s1 := w.body(b1) >>>
    s2 := w.body(b2) >>>
    assert(near(s0.position.y, 0.5, 0.01) && near(s1.position.y, 1.5, 0.02) && near(s2.position.y, 2.5, 0.03))
    assert(s0.sleeping && s1.sleeping && s2.sleeping && last_report.sleeping_bodies == 3 && last_report.awake_bodies == 0)

    // Trigger overlap check on bottom box.
    trigs0 := w.body_triggers(b0) >>>
    assert(trigs0.len == 1 && trigs0[0] == 1)
    trigs2 := w.body_triggers(b2) >>>
    assert(trigs2.len == 0)

    // 1b. Regression: a gentle awake box settling onto an already-sleeping bottom box
    // must never push the sleeping support through the static floor.
    $sw := p.new_rigid_world(fm.vec3(0.0, -9.8, 0.0), [floor], []p.StaticRamp3D{}, []p.StaticTriangle3D{}) >>>
    sb0 := sw.add_body(p.dynamic_box_3d(fm.vec3(0.0, 0.35, 0.0), fm.vec3(0.35, 0.35, 0.35), 2.0, 0.1, 0.55) >>>) >>>
    sb1 := sw.add_body(p.dynamic_box_3d(fm.vec3(0.0, 1.06, 0.0), fm.vec3(0.35, 0.35, 0.35), 2.0, 0.1, 0.55) >>>) >>>
    for f in 0:120 { sw.step(1.0 / 60.0, 4, 10) >>> }
    assert(near((sw.body(sb0) >>>).position.y, 0.35, 0.01) && (sw.body(sb0) >>>).sleeping)
    assert(near((sw.body(sb1) >>>).position.y, 1.05, 0.015) && (sw.body(sb1) >>>).sleeping)

    // 2. Wake island propagation by projectile impact + pulling support out.
    $bullet := p.dynamic_sphere_3d(fm.vec3(-3.0, 0.5, 0.0), 0.3, 2.0, 0.5, 0.1) >>>
    bullet.velocity = fm.vec3(10.0, 0.0, 0.0)
    bullet_id := w.add_body(bullet) >>>
    for f in 0:20 { w.step(1.0 / 60.0, 4, 12) >>> }
    assert(!(w.body(b0) >>>).sleeping && !(w.body(b1) >>>).sleeping && !(w.body(b2) >>>).sleeping)
    assert((w.body(b0) >>>).position.x > 0.2 && (w.body(bullet_id) >>>).velocity.x < 10.0)

    // Move bottom box aside completely and verify upper boxes drop cleanly onto floor!
    w.set_position(b0, fm.vec3(-8.0, 0.5, 0.0)) >>>
    w.set_position(b1, fm.vec3(0.0, 1.5, 0.0)) >>>
    w.set_position(b2, fm.vec3(0.0, 2.5, 0.0)) >>>
    w.set_velocity(b1, fm.vec3(0.0, 0.0, 0.0)) >>>
    w.set_velocity(b2, fm.vec3(0.0, 0.0, 0.0)) >>>
    for f in 0:90 { w.step(1.0 / 60.0, 4, 12) >>> }
    assert(near((w.body(b1) >>>).position.y, 0.5, 0.02))
    assert(near((w.body(b2) >>>).position.y, 1.5, 0.03))

    // 2b. Dynamic sphere and box rolling/sliding down a StaticRamp3D.
    ramp_sp := w.add_body(p.dynamic_sphere_3d(fm.vec3(7.0, 2.6, -0.8), 0.35, 1.0, 0.1, 0.05) >>>) >>>
    ramp_bx := w.add_body(p.dynamic_box_3d(fm.vec3(7.0, 2.6, 0.8), fm.vec3(0.3, 0.3, 0.3), 1.0, 0.0, 0.05) >>>) >>>
    for f in 0:75 { w.step(1.0 / 60.0, 4, 10) >>> }
    assert((w.body(ramp_sp) >>>).position.x < 5.5 && (w.body(ramp_sp) >>>).position.y >= 0.33)
    assert((w.body(ramp_bx) >>>).position.x < 5.8 && (w.body(ramp_bx) >>>).position.y >= 0.28)

    // 3. Kinematic body pushing a dynamic sphere + layer/mask filtering.
    $kin := p.kinematic_box_3d(fm.vec3(0.0, 0.5, 5.0), fm.vec3(0.5, 0.5, 0.5), 1) >>>
    kin.velocity = fm.vec3(3.0, 0.0, 0.0)
    k_id := w.add_body(kin) >>>
    pushed_id := w.add_body(p.dynamic_sphere_3d(fm.vec3(1.5, 0.5, 5.0), 0.5, 1.0, 0.2, 0.1) >>>) >>>
    $ghost := p.dynamic_sphere_3d(fm.vec3(1.5, 0.5, 5.0), 0.5, 1.0, 0.2, 0.1) >>>
    ghost.layer = 8
    ghost.mask = 8
    g_id := w.add_body(ghost) >>>
    for f in 0:30 { w.step(1.0 / 60.0, 4, 8) >>> }
    assert((w.body(pushed_id) >>>).position.x > 2.2)
    assert(near((w.body(g_id) >>>).position.x, 1.5, 0.01))
    assert((w.body(k_id) >>>).position.x > 1.4)

    // 4. Unified raycast_all hits static box, static ramp, static triangle, and rigid body with mask.
    hit_ramp := w.raycast_all(fm.vec3(6.0, 5.0, 0.0), fm.vec3(0.0, -1.0, 0.0), 10.0, 2) >>>
    assert(hit_ramp.kind == p.HIT_STATIC_RAMP && hit_ramp.index == 0 && near(hit_ramp.point.y, 1.0, 0.001))
    hit_tri := w.raycast_all(fm.vec3(-4.0, 0.5, 0.0), fm.vec3(-1.0, 0.0, 0.0), 10.0, 2) >>>
    assert(hit_tri.kind == p.HIT_STATIC_TRIANGLE && hit_tri.index == 0 && near(hit_tri.distance, 2.0, 0.001))
    hit_body := w.raycast_all(fm.vec3(0.0, 0.5, -3.0), fm.vec3(0.0, 0.0, 1.0), 10.0, 1) >>>
    assert(hit_body.kind == p.HIT_RIGID_BODY && hit_body.index == b1 && near(hit_body.distance, 2.5, 0.05))
    hit_floor := w.raycast_all(fm.vec3(0.0, 5.0, -5.0), fm.vec3(0.0, -1.0, 0.0), 10.0, 1) >>>
    assert(hit_floor.kind == p.HIT_STATIC_BOX && hit_floor.index == 0 && near(hit_floor.distance, 5.0, 0.001))
    << 0
}

fn rejects_degenerate_tri() bool {
    p.static_triangle_3d(fm.vec3(0.0, 0.0, 0.0), fm.vec3(1.0, 0.0, 0.0), fm.vec3(2.0, 0.0, 0.0), 1) >>> (err) { << true }
    << false
}
fn rejects_bad_mass() bool {
    p.dynamic_sphere_3d(fm.vec3(0.0, 0.0, 0.0), 0.5, 0.0, 0.5, 0.5) >>> (err) { << true }
    << false
}
fn rejects_bad_restitution() bool {
    p.dynamic_box_3d(fm.vec3(0.0, 0.0, 0.0), fm.vec3(0.5, 0.5, 0.5), 1.0, 1.5, 0.5) >>> (err) { << true }
    << false
}
fn rejects_bad_step(world $&p.RigidWorld3D, dt f64, substeps int, iters int) bool {
    world.step(dt, substeps, iters) >>> (err) { << true }
    << false
}
fn rejects_bad_index(world &p.RigidWorld3D, idx int) bool {
    world.body(idx) >>> (err) { << true }
    << false
}
fn rejects_add_body(world $&p.RigidWorld3D, body p.RigidBody3D) bool {
    world.add_body(body) >>> (err) { << true }
    << false
}
fn rejects_bad_transform() bool {
    bad := fm.Mat4{c0: fm.vec4(1.0, 0.0, 0.0, 1.0), c1: fm.vec4(0.0, 1.0, 0.0, 0.0),
        c2: fm.vec4(0.0, 0.0, 1.0, 0.0), c3: fm.vec4(0.0, 0.0, 0.0, 1.0)}
    p.transform_triangle_3d(fm.vec3(0.0, 0.0, 0.0), fm.vec3(1.0, 0.0, 0.0), fm.vec3(0.0, 1.0, 0.0), bad, 1) >>> (err) { << true }
    << false
}
fn rejects_bad_gravity() bool {
    p.new_rigid_world(fm.vec3(0.0, -5000.0, 0.0), []p.StaticBox3D{}, []p.StaticRamp3D{}, []p.StaticTriangle3D{}) >>> (err) { << true }
    << false
}

fn failure_paths() int {
    assert(rejects_degenerate_tri())
    assert(rejects_bad_mass())
    assert(rejects_bad_restitution())
    assert(rejects_bad_transform())
    assert(rejects_bad_gravity())
    $w := p.new_rigid_world(fm.vec3(0.0, -9.8, 0.0), []p.StaticBox3D{}, []p.StaticRamp3D{}, []p.StaticTriangle3D{}) >>>
    assert(rejects_bad_step($&w, 0.0, 1, 4))
    assert(rejects_bad_step($&w, 0.5, 1, 4))
    assert(rejects_bad_step($&w, 0.016, 0, 4))
    assert(rejects_bad_step($&w, 0.016, 1, 64))
    assert(rejects_bad_index(&w, 0))
    // Rigid body capacity boundary: MAX_RIGID_BODIES succeeds, next fails.
    sample := p.dynamic_sphere_3d(fm.vec3(0.0, 1.0, 0.0), 0.25, 1.0, 0.5, 0.5) >>>
    for i in 0:p.MAX_RIGID_BODIES {
        w.add_body(sample) >>>
    }
    assert(w.body_count() == p.MAX_RIGID_BODIES)
    assert(rejects_add_body($&w, sample))
    << 0
}

fn run() int {
    triangle_geometry_and_rays() >>>
    capsule_arbitrary_mesh_tests() >>>
    rigid_bounce_and_momentum() >>>
    rigid_arbitrary_triangle_and_ccd() >>>
    rigid_stacking_sleep_wake_and_queries() >>>
    failure_paths() >>>
    println("PASS: arbitrary 3D triangle collision, capsule mesh sweeps, dynamic rigid bodies, CCD, friction, stacking, sleeping, triggers and unified raycasts")
    << 0
}

fn main() int { << run() >>> (err) { eprintln(err.msg())
    << 1 } }
