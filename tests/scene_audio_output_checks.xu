@main
worlds #"github.com/xulang-org/nexus/integration/scene_audio"
audio #"github.com/xulang-org/nexus/audio"

fn bad_pump(world $&worlds.AudioScene, output &audio.Output) bool { world.pump(output, 3, 2) >>> (err) { << true }
    << false }
fn run() int {
    $world := worlds.load("build/scene-audio-fixtures/base.xuscene", 8000) >>>
    $output := audio.open_output(8000) >>>
    report := world.pump(&output, 3, 2) >>>
    assert(report.submitted_frames == 3 && report.blocks == 2 && (world.position_frames(0) >>>) == 3.0)
    output.close() >>>
    assert(bad_pump($&world, &output) && (world.position_frames(0) >>>) == 3.0)
    $other := audio.open_output(16000) >>>
    assert(bad_pump($&world, &other) && (world.position_frames(0) >>>) == 3.0 && (other.queued_frames() >>>) == 0)
    other.close() >>>
    println("PASS: restored world pumps bounded PCM to output, closed/rate-mismatched outputs preserve voice cursors and queues")
    << 0
}
fn main() int { << run() >>> (err) { eprintln(err.msg())
    << 1 } }
