@main

light_data #"github.com/xulang-org/nexus/resources/lighting"

#gpu

gpu_info #"github.com/xulang-org/nexus/platform/gpu"

mesh_shaders #"github.com/xulang-org/nexus/assets/shaders/three_d"

meshes #"github.com/xulang-org/nexus/resources/mesh"

ren #"github.com/xulang-org/nexus/rendering/three_d"
fm #"github.com/xulang-org/nexus/foundation/math"
images #"github.com/xulang-org/nexus/resources/image"
image_render #"github.com/xulang-org/nexus/integration/image_render/three_d"
#math

fn settings(min_linear bool, mag_linear bool, u bool, v bool, mip int) ren.TextureSampling3D {
    << ren.TextureSampling3D{min_linear: min_linear, mag_linear: mag_linear, repeat_u: u, repeat_v: v, mip_filter: mip}
}
// UV at pixel (32,32) is center, derivative across a 64-pixel viewport is span/64.
// This permits known implicit LOD without adding a diagnostic shader or LOD bias.
fn quad(center fm.Vec2, span fm.Vec2) meshes.MeshData3D {
    $mesh := meshes.new_mesh_data_3d()
    positions := [fm.vec3(-1.0, 1.0, 0.5), fm.vec3(1.0, 1.0, 0.5), fm.vec3(1.0, -1.0, 0.5), fm.vec3(-1.0, -1.0, 0.5)]
    start := fm.vec2(center.x - span.x * 32.5 / 64.0, center.y - span.y * 32.5 / 64.0)
    uvs := [start, fm.vec2(start.x + span.x, start.y), fm.vec2(start.x + span.x, start.y + span.y), fm.vec2(start.x, start.y + span.y)]
    for i in 0:4 { mesh.vertex_lit_uv(positions[i], 4294967295, fm.vec3(0.0, 0.0, 1.0), uvs[i]) >>> }
    mesh.triangle(0, 2, 1) >>>
    mesh.triangle(0, 3, 2) >>>
    << mesh
}
fn channel(color int, index int) int {
    if index == 0 { << color / 16777216 % 256 }
    if index == 1 { << color / 65536 % 256 }
    << color / 256 % 256
}
fn check(pixel int, red int, green int, blue int) {
    values := [red, green, blue]
    for i in 0:3 {
        if math.abs(f64(channel(pixel, i) - values[i])) > 3.0 {
            println("Pixel=" + str(channel(pixel, 0)) + "," + str(channel(pixel, 1)) + "," + str(channel(pixel, 2)) +
                " expected=" + str(red) + "," + str(green) + "," + str(blue))
        }
        assert(math.abs(f64(channel(pixel, i) - values[i])) <= 3.0)
    }
    assert(pixel % 256 == 255)
}
fn sample(device $&ren.Device3D, mesh &ren.Mesh3D, base &ren.Material3D, light &light_data.Environment3D, texture &ren.Texture3D) int {
    material := base.with_base_texture(texture) >>>
    device.begin(255) >>>
    device.draw_material(mesh, fm.identity_3d(), fm.identity_3d(), &material, light) >>>
    pixel := device.read_pixel(32, 32) >>>
    device.present() >>>
    << pixel
}
fn bad_texture(device &ren.Device3D, width int, height int, pixels &[]int, sampling ren.TextureSampling3D) bool {
    device.texture_rgba_sampled(width, height, pixels, true, sampling) >>> (err) { << true }
    << false
}
fn bad_levels(texture &ren.Texture3D) bool {
    texture.mip_levels() >>> (err) { << true }
    << false
}
fn bad_storage(texture &ren.Texture3D) bool {
    texture.storage_bytes() >>> (err) { << true }
    << false
}
fn budget_checks() int {
    mesh_program_0 := mesh_shaders.load_mesh("build/mesh-shaders") >>>
    $device := ren.open_3d("Mip-chain budget validation", 32, 32, gpu.AUTO, &mesh_program_0) >>>
    $pixels := []int{}
    for i in 0:4194304 { pixels.push(4294967295) }
    sampling := settings(true, true, true, true, ren.MIP_LINEAR)
    $textures := []ren.Texture3D{}
    // Each 2048-square mip chain has 5,592,405 texels. Three leave exactly
    // one RGBA8 texel in a 64 MiB budget; counting only base levels is wrong.
    for i in 0:3 {
        $texture := device.texture_rgba_sampled(2048, 2048, &pixels, true, sampling) >>>
        assert((texture.mip_levels() >>>) == 12 && (texture.storage_bytes() >>>) == 22369620)
        textures.push(texture)
    }
    assert(bad_texture(&device, 2048, 2048, &pixels, sampling))
    single := [4294967295]
    $last := device.texture_rgba_sampled(1, 1, &single, true, sampling) >>>
    assert((last.mip_levels() >>>) == 1 && (last.storage_bytes() >>>) == 4)
    assert(bad_texture(&device, 1, 1, &single, sampling))
    first := $&textures[0]
    first.close() >>>
    $reused := device.texture_rgba_sampled(2048, 2048, &pixels, true, sampling) >>>
    assert((reused.storage_bytes() >>>) == 22369620)
    assert(bad_texture(&device, 1, 1, &single, sampling))
    device.close() >>>
    assert(bad_levels(&last) && bad_storage(&reused))
    last.close() >>>
    reused.close() >>>
    << 0
}
fn run() int {
    mesh_program_1 := mesh_shaders.load_mesh("build/mesh-shaders") >>>
    $device := ren.open_3d("Xu mipmaps and sampler GPU checks", 64, 64, gpu.AUTO, &mesh_program_1) >>>
    println("Mipmap GPU backend: " + gpu_info.backend_name(device.backend() >>>))
    zero := fm.vec3(0.0, 0.0, 0.0)
    white := fm.vec3(1.0, 1.0, 1.0)
    base := ren.material_3d(white, 0.0, 1.0, zero) >>>
    light := light_data.environment(white, fm.vec3(0.0, 0.0, 2.0), 1.0, [light_data.directional(fm.vec3(0.0, 0.0, 1.0), zero) >>>]) >>>
    pixels := [255, 4294967295]
    $plain := device.texture_rgba(2, 1, &pixels, true, false, true) >>>
    nearest := settings(false, false, true, true, ren.MIP_NEAREST)
    trilinear := settings(true, false, true, true, ren.MIP_LINEAR)
    $mipped := device.texture_rgba_sampled(2, 1, &pixels, true, nearest) >>>
    $smooth := device.texture_rgba_sampled(2, 1, &pixels, true, trilinear) >>>
    assert((plain.mip_levels() >>>) == 1 && (plain.storage_bytes() >>>) == 8)
    assert((mipped.mip_levels() >>>) == 2 && (mipped.storage_bytes() >>>) == 12)
    assert((smooth.mip_levels() >>>) == 2)
    // Strong minification selects the final generated level. Black+white sRGB
    // must average to linear 0.5 (output 156), not encoded 0.5 (output 117).
    $min_data := quad(fm.vec2(0.25, 0.5), fm.vec2(128.0, 0.0)) >>>
    $min_mesh := device.upload(&min_data) >>>
    check(sample($&device, &min_mesh, &base, &light, &plain) >>>, 0, 0, 0)
    check(sample($&device, &min_mesh, &base, &light, &mipped) >>>, 156, 156, 156)
    check(sample($&device, &min_mesh, &base, &light, &smooth) >>>, 156, 156, 156)
    // LODs 0.25 and 0.75 distinguish level rounding from interpolation.
    // At the black texel center, level 0 is 0, level 1 is linear 0.5;
    // interpolation yields 0.125 / 0.375 -> SDR output 94 / 143.
    for lod in [0.25, 0.75] {
        span := 32.0 * math.exp(math.log(2.0) * lod)
        data := quad(fm.vec2(0.25, 0.5), fm.vec2(span, 0.0)) >>>
        $mesh := device.upload(&data) >>>
        pixel := sample($&device, &mesh, &base, &light, &smooth) >>>
        discrete := sample($&device, &mesh, &base, &light, &mipped) >>>
        if lod < 0.5 { check(pixel, 94, 94, 94)
            check(discrete, 0, 0, 0)
        } else { check(pixel, 143, 143, 143)
            check(discrete, 156, 156, 156) }
    }
    // Independent min/mag texel filters, without a mip chain.
    $asymmetric := device.texture_rgba_sampled(2, 1, &pixels, true, settings(false, true, true, true, ren.MIP_NONE)) >>>
    mag_data := quad(fm.vec2(0.5, 0.5), fm.vec2(1.0, 0.0)) >>>
    $mag_mesh := device.upload(&mag_data) >>>
    check(sample($&device, &mag_mesh, &base, &light, &asymmetric) >>>, 156, 156, 156)
    min_nearest_data := quad(fm.vec2(0.6, 0.5), fm.vec2(128.0, 0.0)) >>>
    $min_nearest := device.upload(&min_nearest_data) >>>
    check(sample($&device, &min_nearest, &base, &light, &asymmetric) >>>, 188, 188, 188)
    // U repeats while V clamps, and the reverse, at constant outside UVs.
    corners := [4278190335, 16711935, 65535, 4294967295]
    $u_repeat := device.texture_rgba_sampled(2, 2, &corners, true, settings(false, false, true, false, ren.MIP_NONE)) >>>
    $v_repeat := device.texture_rgba_sampled(2, 2, &corners, true, settings(false, false, false, true, ren.MIP_NONE)) >>>
    outside_data := quad(fm.vec2(1.25, 1.25), fm.vec2(0.0, 0.0)) >>>
    $outside := device.upload(&outside_data) >>>
    check(sample($&device, &outside, &base, &light, &u_repeat) >>>, 0, 0, 188)
    check(sample($&device, &outside, &base, &light, &v_repeat) >>>, 0, 188, 0)
    // Constant images test every NPOT and 1D mip shape without assumptions
    // about implementation-defined odd-edge resampling weights.
    for width in [1, 7, 4096] {
        $height := 3
        $levels := 3
        $bytes := 16
        if width == 1 { height = 5
            levels = 3
            bytes = 32 }
        if width == 7 { bytes = 100 }
        if width == 4096 { height = 1
            levels = 13
            bytes = 32764 }
        $solid := []int{}
        for i in 0:width * height { solid.push(4278190335) }
        image := images.ImageRGBA8{width: width, height: height, pixels: solid}
        $texture := image_render.upload_image_3d_sampled(&device, &image, true, trilinear) >>>
        assert((texture.mip_levels() >>>) == levels && (texture.storage_bytes() >>>) == bytes)
        check(sample($&device, &min_mesh, &base, &light, &texture) >>>, 188, 0, 0)
    }
    assert(bad_texture(&device, 2, 1, &pixels, settings(true, true, true, true, -1)))
    assert(bad_texture(&device, 2, 1, &pixels, settings(true, true, true, true, 3)))
    assert(bad_texture(&device, 0, 1, &pixels, trilinear))
    invalid := [255, -1]
    assert(bad_texture(&device, 2, 1, &invalid, trilinear))
    device.begin(255) >>>
    assert(bad_texture(&device, 2, 1, &pixels, trilinear))
    device.present() >>>
    smooth.close() >>>
    assert(bad_levels(&smooth) && bad_storage(&smooth))
    device.close() >>>
    assert(bad_levels(&mipped) && bad_storage(&plain))
    budget_checks() >>>
    println("PASS: GPU mip generation/sRGB averaging, nearest vs trilinear LOD, independent min/mag and U/V, NPOT/1D/1x1 layout, full-chain 64 MiB budget/recovery, image adapter, stale resources and failure bounds")
    << 0
}
fn main() int { << run() >>> (err) { eprintln(err.msg())
    << 1 } }
