@main

plat #"github.com/xulang-org/nexus/platform/steam"
st #"github.com/xulang-org/nexus/steam"
rs #"github.com/xulang-org/nexus/resources/steam"
#os
#strings

fn from_u8(buf &[]u8) string {
    << plat.u8_to_str(buf, buf.len)
}

fn run() int {
    expect_native := os.getenv("NEXUS_EXPECT_NATIVE_STEAM") == "1"
    avail := plat.raw_is_available()
    $cfg := rs.default_config(480, 481)
    cfg.dlc_ids = [482]
    cfg.achievement_ids = ["ACH_TRAVEL_FAR"]
    cfg.stat_defs = [
        rs.SteamStatDef{id: "NumGames", is_float: false, default_int: 0, default_float: 0.0},
        rs.SteamStatDef{id: "MaxFeetTraveled", is_float: true, default_int: 0, default_float: 0.0}
    ]

    if !expect_native {
        assert(avail == 0)
        $client := st.init_auto(cfg, "") >>>
        assert(!client.is_native() && client.backend_name() == "steam_mock")
        client.shutdown() >>>
        println("PASS: steam_native_checks missing-lib fallback")
        << 0
    }

    assert(avail == 1)
    assert(plat.raw_restart_if_necessary(480) == 0)
    $client := st.init_native(cfg) >>>
    assert(client.is_initialized() && client.is_native() && client.backend_name() == "steam_native")
    assert(plat.raw_app_id() == 480)
    prof := client.profile()
    assert(prof.steam_id > 0 && prof.persona_name == "FakeSteamUser")
    assert(prof.language == "english" && prof.logged_on && prof.on_steam_deck && prof.overlay_enabled)
    assert(client.friend_count() == 5)

    // Achievements & Stats over real dlopen C ABI
    client.unlock_achievement("ACH_TRAVEL_FAR") >>>
    assert(client.has_achievement("ACH_TRAVEL_FAR"))
    client.set_stat_int("NumGames", 19) >>>
    assert(client.get_stat_int("NumGames") == 19)
    client.set_stat_float("MaxFeetTraveled", 123.5) >>>
    assert(client.get_stat_float("MaxFeetTraveled") == 123.5)
    client.store_stats() >>>

    // Cloud I/O & Quota
    assert(client.cloud_enabled())
    payload := plat.str_to_u8(&"steam-native-cloud-save")
    client.cloud_write("native.sav", &payload) >>>
    assert(client.cloud_exists("native.sav"))
    readback := client.cloud_read("native.sav") >>>
    assert(from_u8(&readback) == "steam-native-cloud-save")
    assert(client.cloud_quota_total() == 1048576 && client.cloud_quota_used() > 0)

    // DLC, UGC, Lobby & Rich Presence
    assert(client.is_dlc_installed(482))
    ugc := client.installed_workshop_items()
    assert(ugc.len == 1 && ugc[0].published_file_id == 9001 && strings.contains(&ugc[0].install_path, "ugc_9001"))
    lid := client.create_lobby(rs.LOBBY_PUBLIC, 4) >>>
    assert(lid > 0)
    client.set_lobby_data("map", "nexus_arena") >>>
    assert(client.get_lobby_data("map") == "nexus_arena")
    assert(plat.raw_lobby_member_count(lid) == 1)
    client.set_rich_presence("steam_display", "#StatusPlaying") >>>
    client.tick() >>>
    client.shutdown() >>>
    assert(plat.raw_is_running() == 0)

    println("PASS: steam_native_checks dlopen ABI live")
    << 0
}

fn main() int {
    run() >>> (err) {
        println("FAIL: " + err.msg())
        << 1
    }
    << 0
}
