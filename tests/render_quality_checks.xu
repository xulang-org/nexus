@main
#gpu
#window
ren #"github.com/xulang-org/nexus/rendering/three_d"
mesh #"github.com/xulang-org/nexus/resources/mesh"
fm #"github.com/xulang-org/nexus/foundation/math"
shaders #"github.com/xulang-org/nexus/assets/shaders/three_d"
fn failed_scale(device $&ren.Device3D,scale int) bool { device.set_render_scale(scale) >>>(err){ << true }
    << false }
fn frame(device $&ren.Device3D,mesh &ren.Mesh3D,path string) int {
    device.begin(255) >>>
    assert(failed_scale(device,1))
    device.draw(mesh,fm.identity_3d()) >>>
    device.capture(path) >>>
    device.present() >>>
    << 0
}
fn run() int {
    program := shaders.load_mesh("build/mesh-shaders") >>>
    $low := ren.open_3d("Quality",64,48,gpu.AUTO,&program) >>>
    $high := ren.open_3d("Reference",128,96,gpu.AUTO,&program) >>>
    $data := mesh.new_mesh_data_3d()
    data.vertex(fm.vec3(-0.72,-0.7,0.5),4294967295) >>>
    data.vertex(fm.vec3(0.67,-0.42,0.5),4294967295) >>>
    data.vertex(fm.vec3(0.08,0.8,0.5),4294967295) >>>
    data.triangle(0,1,2) >>>
    $a := low.upload(&data) >>>
    $b := high.upload(&data) >>>
    frame($&high,&b,"build/quality-reference.png") >>>
    frame($&low,&a,"build/quality-1x.png") >>>
    low.set_render_scale(2) >>>
    assert((low.render_scale() >>>)==2 && failed_scale($&low,0) && failed_scale($&low,3))
    frame($&low,&a,"build/quality-2x.png") >>>
    target := low.window() >>>
    target.resize(80,60) >>>
    window.pump() >>>
    frame($&low,&a,"build/quality-resized.png") >>>
    low.set_render_scale(1) >>>
    frame($&low,&a,"build/quality-restored.png") >>>
    a.close() >>>
    b.close() >>>
    low.close() >>>
    high.close() >>>
    assert(failed_scale($&low,2))
    println("PASS: GPU 2x supersampling, unchanged output dimensions, mode/resize transitions and invalid frame/scale/closed-device rejection")
    << 0
}
fn main() int { << run() >>>(err){ eprintln(err.msg())
    << 1 } }
