@main

fm #"github.com/xulang-org/nexus/foundation/math"
stl #"github.com/xulang-org/nexus/formats/stl"
inp #"github.com/xulang-org/nexus/input"
iscene #"github.com/xulang-org/nexus/integration/scene"
physics3d #"github.com/xulang-org/nexus/physics3d"
meshes #"github.com/xulang-org/nexus/resources/mesh"
timing #"github.com/xulang-org/nexus/timing"
#errors
#math
#strings

fn near_f(a f64, b f64, eps f64) bool {
    << math.abs(a - b) <= eps
}

fn rejects_zero_rng_state() bool {
    _ := fm.rng_from_state(0, 0, 0, 0) or (err) {
        _ := err
        << true
    }
    << false
}

fn rejects_bad_range_int(r $&fm.Rng) bool {
    _ := r.range_int(5, 5) or (err) {
        _ := err
        << true
    }
    << false
}

fn rejects_zero_weights(r $&fm.Rng) bool {
    _ := r.weighted_pick(&[0.0, 0.0, 0.0]) or (err) {
        _ := err
        << true
    }
    << false
}

fn rejects_bad_chance(r $&fm.Rng) bool {
    _ := r.chance(1.5) or (err) {
        _ := err
        << true
    }
    << false
}

fn rejects_empty_stl_bin(m &meshes.MeshData3D) bool {
    _ := stl.encode_binary(m, "Empty") or (err) {
        _ := err
        << true
    }
    << false
}

fn rejects_bad_stl_name(m &meshes.MeshData3D) bool {
    _ := stl.encode_ascii(m, "bad name") or (err) {
        _ := err
        << true
    }
    << false
}

fn rejects_neg_trigger_actor(tr $&physics3d.TriggerTracker3D) bool {
    _ := tr.update_actor(-1, &[0]) or (err) {
        _ := err
        << true
    }
    << false
}

fn rejects_bad_job_dep(q $&timing.BudgetedJobQueue) bool {
    _ := q.enqueue("bad", 1, 1, [9999], 0) or (err) {
        _ := err
        << true
    }
    << false
}

fn rejects_conflict_rebind(
    st $&inp.InputContextStack,
    im $&inp.InputMap,
    ctx string,
    act string,
    old_k int,
    new_k int
) bool {
    _ := st.rebind_in_context(im, ctx, act, old_k, new_k, false) or (err) {
        _ := err
        << true
    }
    << false
}

fn test_prng() int {
    assert(rejects_zero_rng_state())
    $r1 := fm.new_rng(424242)
    $r2 := fm.new_rng(424242)
    assert(rejects_bad_range_int($&r1))
    assert(rejects_zero_weights($&r1))
    assert(rejects_bad_chance($&r1))

    for _ in 0:32 {
        assert(r1.next_u32() == r2.next_u32())
    }
    saved := r1.state()
    assert(saved.len == 4)
    $restored := fm.rng_from_state(saved[0], saved[1], saved[2], saved[3]) or >>
    for _ in 0:16 {
        assert(near_f(r1.next_f64(), restored.next_f64(), 0.0))
    }

    $fa := r1.fork(1)
    $fb := r1.fork(2)
    assert(fa.next_u32() != fb.next_u32())
    assert(!r1.chance(0.0) && r1.chance(1.0))

    // Normal mean & cone / sphere invariants
    $sum_n := 0.0
    for _ in 0:400 {
        nval := r1.normal(10.0, 2.0) or >>
        sum_n += nval
        ev := r1.exponential(2.0) or >>
        assert(ev >= 0.0)
        iv := r1.range_int(-3, 8) or >>
        assert(iv >= -3 && iv < 8)
    }
    mean_n := sum_n / 400.0
    assert(mean_n > 9.3 && mean_n < 10.7)

    axis := fm.vec3(0.0, 1.0, 0.0)
    cos_lim := math.cos(0.35)
    for _ in 0:64 {
        c2 := r1.vec2_on_unit_circle()
        assert(near_f(c2.length(), 1.0, 1e-6))
        d2 := r1.vec2_in_unit_circle()
        assert(d2.length() <= 1.0 + 1e-9)
        s3 := r1.vec3_on_unit_sphere()
        assert(near_f(s3.length(), 1.0, 1e-6))
        v3 := r1.vec3_in_unit_sphere()
        assert(v3.length() <= 1.0 + 1e-9)
        cn := r1.vec3_in_cone(axis, 0.35) or >>
        assert(near_f(cn.length(), 1.0, 1e-6) && cn.dot(axis) >= cos_lim - 1e-6)
    }

    $counts := [0, 0, 0]
    w := [0.1, 0.7, 0.2]
    for _ in 0:600 {
        idx := r1.weighted_pick(&w) or >>
        counts[idx] += 1
    }
    assert(counts[1] > counts[2] && counts[2] > counts[0] && counts[0] > 15)

    $arr := [10, 20, 30, 40, 50, 60]
    r1.shuffle_ints($&arr)
    $sum_arr := 0
    for x in arr { sum_arr += x }
    assert(sum_arr == 210)

    picked := r1.sample_indices(20, 8) or >>
    assert(picked.len == 8)
    $seen := map[int]bool{}
    for p in picked {
        assert(p >= 0 && p < 20 && !seen.has(p))
        seen[p] = true
    }

    pts := r1.poisson_disk_2d(40.0, 40.0, 3.0, 24, 300) or >>
    assert(pts.len >= 40)
    for i in 0:pts.len {
        assert(pts[i].x >= 0.0 && pts[i].x < 40.0 && pts[i].y >= 0.0 && pts[i].y < 40.0)
        for j in (i + 1):pts.len {
            assert(pts[i].distance(pts[j]) >= 3.0 - 1e-6)
        }
    }
    << 0
}

fn test_stl_export() int {
    empty := meshes.new_mesh_data_3d()
    assert(rejects_empty_stl_bin(&empty))
    box := meshes.box_mesh_3d(fm.vec3(2.0, 3.0, 4.0), 4294967295) or >>
    assert(rejects_bad_stl_name(&box))

    bin := stl.encode_binary(&box, "NexusBoxBin") or >>
    assert(bin.len == 84 + 12 * 50)
    dec_bin := stl.decode(&bin) or >>
    assert(dec_bin.triangle_count() == 12)
    bb_bin := dec_bin.bounds() or >>
    assert(near_f(bb_bin.minimum.x, -1.0, 1e-4) && near_f(bb_bin.maximum.x, 1.0, 1e-4))
    assert(near_f(bb_bin.minimum.y, -1.5, 1e-4) && near_f(bb_bin.maximum.z, 2.0, 1e-4))

    asc := stl.encode_ascii(&box, "nexus_box") or >>
    assert(strings.has_prefix(&asc, "solid nexus_box"))
    dec_asc := stl.decode(&asc) or >>
    assert(dec_asc.triangle_count() == 12)
    bb_asc := dec_asc.bounds() or >>
    assert(near_f(bb_asc.minimum.y, -1.5, 1e-4) && near_f(bb_asc.maximum.y, 1.5, 1e-4))
    << 0
}

fn test_physics_triggers() int {
    trig0 := physics3d.StaticBox3D{
        bounds: fm.aabb3(fm.vec3(-2.0, 0.0, -2.0), fm.vec3(2.0, 3.0, 2.0)) or >>,
        layer: 1,
        trigger: true
    }
    trig1 := physics3d.StaticBox3D{
        bounds: fm.aabb3(fm.vec3(1.0, 0.0, -2.0), fm.vec3(5.0, 3.0, 2.0)) or >>,
        layer: 1,
        trigger: true
    }
    world := physics3d.new_static_world([trig0, trig1]) or >>
    $tr := physics3d.new_trigger_tracker_3d()
    assert(rejects_neg_trigger_actor($&tr))

    // Step 1: enter trigger 0
    b0 := fm.aabb3(fm.vec3(-0.5, 0.5, -0.5), fm.vec3(0.5, 1.5, 0.5)) or >>
    e1 := tr.update_box(10, &world, b0, 1) or >>
    assert(e1.len == 1 && e1[0].trigger_id == 0 && e1[0].kind == physics3d.TRIGGER_ENTER)
    assert(tr.is_inside(10, 0) && !tr.is_inside(10, 1))

    // Step 2: overlap both triggers 0 (STAY) and 1 (ENTER)
    b1 := fm.aabb3(fm.vec3(0.5, 0.5, -0.5), fm.vec3(1.8, 1.5, 0.5)) or >>
    e2 := tr.update_box(10, &world, b1, 1) or >>
    assert(e2.len == 2 && e2[0].trigger_id == 0 && e2[0].kind == physics3d.TRIGGER_STAY)
    assert(e2[1].trigger_id == 1 && e2[1].kind == physics3d.TRIGGER_ENTER)

    // Step 3: exit 0, stay in 1
    b2 := fm.aabb3(fm.vec3(2.5, 0.5, -0.5), fm.vec3(3.5, 1.5, 0.5)) or >>
    e3 := tr.update_box(10, &world, b2, 1) or >>
    assert(e3.len == 2 && e3[0].trigger_id == 0 && e3[0].kind == physics3d.TRIGGER_EXIT)
    assert(e3[1].trigger_id == 1 && e3[1].kind == physics3d.TRIGGER_STAY)

    // Capsule trigger + occupant query + clean removal
    cworld := physics3d.new_capsule_world([trig0, trig1], []physics3d.StaticRamp3D{}) or >>
    cap := physics3d.capsule_3d(fm.vec3(1.5, 1.2, 0.0), 0.7, 0.4) or >>
    ce := tr.update_capsule(20, &cworld, cap, 1) or >>
    assert(ce.len == 2 && ce[0].kind == physics3d.TRIGGER_ENTER && ce[1].kind == physics3d.TRIGGER_ENTER)
    occ1 := tr.occupants_of(1)
    assert(occ1.len == 2 && occ1[0] == 10 && occ1[1] == 20)

    ex := tr.remove_actor(20) or >>
    assert(ex.len == 2 && ex[0].kind == physics3d.TRIGGER_EXIT && ex[1].kind == physics3d.TRIGGER_EXIT)
    assert(tr.active_for_actor(20).len == 0)
    << 0
}

fn test_jobs_and_partition_streaming() int {
    $jq := timing.new_job_queue(5, 2) or >>
    assert(rejects_bad_job_dep($&jq))
    j1 := jq.enqueue("mesh", 1, 3, []int{}, 0) or >>
    j2 := jq.enqueue("tex", 10, 3, []int{}, 1) or >>
    j3 := jq.enqueue("bind", 5, 2, [j1, j2], 0) or >>
    j_big := jq.enqueue("bake", 20, 12, []int{}, 0) or >>

    // Tick 1: j_big has highest priority (20) and queue idle -> dispatched alone without starving
    t1 := jq.dispatch_tick()
    assert(t1.len == 1 && t1[0] == j_big)
    // While j_big running (used against max_in_flight=2? unit budget 5 already exhausted if we check; complete j_big first)
    jq.complete(j_big) or >>

    // Tick 2: j2 (p=10, cost=3) runs, j1 (p=1, cost=3) exceeds remaining budget 2, j3 waits on j1+j2
    t2 := jq.dispatch_tick()
    assert(t2.len == 1 && t2[0] == j2)
    // Test retry path on j2
    assert((jq.fail(j2) or >>) == timing.JOB_PENDING && (jq.retry_count(j2) or >>) == 1)
    t3 := jq.dispatch_tick()
    assert(t3.len == 1 && t3[0] == j2)
    jq.complete(j2) or >>

    // j1 runs & succeeds, unlocking j3
    assert(jq.reprioritize(j1, 15))
    t4 := jq.dispatch_tick()
    assert(t4.len == 1 && t4[0] == j1)
    jq.complete(j1) or >>
    t5 := jq.dispatch_tick()
    assert(t5.len == 1 && t5[0] == j3)
    jq.complete(j3) or >>

    // Cascading cancel when dependency fails permanently
    df := jq.enqueue("root_fail", 1, 1, []int{}, 0) or >>
    dc := jq.enqueue("child", 1, 1, [df], 0) or >>
    _ := jq.dispatch_tick()
    assert((jq.fail(df) or >>) == timing.JOB_FAILED)
    assert((jq.status(dc) or >>) == timing.JOB_CANCELLED)
    st := jq.stats()
    assert(st.done == 4 && st.failed == 1 && st.cancelled == 1)

    // PartitionStreamingScheduler: distance order, byte budget, cancel on retreat, stale completion
    $ps := iscene.new_partition_streaming_scheduler(16.0, 1, 2, iscene.PartitionStreamBudget{
        max_loads_per_tick: 2,
        max_unloads_per_tick: 2,
        io_byte_budget_per_tick: 100
    }) or >>
    ps.set_cell_io_bytes(0, 0, 60) or >>
    ps.set_cell_io_bytes(-1, 0, 60) or >>
    ps.set_cell_io_bytes(0, -1, 60) or >>
    ps.set_cell_io_bytes(0, 1, 60) or >>
    ps.set_cell_io_bytes(1, 0, 60) or >>
    tk1 := ps.update_and_schedule(&[fm.vec3(8.0, 0.0, 8.0)]) or >>
    assert(tk1.dispatch_loads.len == 1 && tk1.dispatch_loads[0].cx == 0 && tk1.dispatch_loads[0].cz == 0)
    assert(tk1.pending_loads == 4)
    assert(ps.complete_load(0, 0))
    assert(ps.loaded_count() == 1 && ps.is_loaded(0, 0))

    // Start loading next cell, then retreat far away so queued + in-flight cancel
    tk2 := ps.update_and_schedule(&[fm.vec3(8.0, 0.0, 8.0)]) or >>
    assert(tk2.dispatch_loads.len >= 1)
    fly_c := tk2.dispatch_loads[0]
    tk3 := ps.update_and_schedule(&[fm.vec3(800.0, 0.0, 800.0)]) or >>
    assert(tk3.cancelled_loads.len >= 3)
    assert(!ps.complete_load(fly_c.cx, fly_c.cz)) // stale completion safely ignored!
    assert(tk3.dispatch_unloads.len == 1 && tk3.dispatch_unloads[0].cx == 0 && tk3.dispatch_unloads[0].cz == 0)
    assert(ps.complete_unload(0, 0))
    assert(!ps.is_loaded(0, 0))
    << 0
}

fn test_input_contexts() int {
    $im := inp.new_input_map()
    im.bind("jump", 32) or >>     // Space
    im.bind("interact", 69) or >> // E
    im.bind("boost", 42) or >>    // Shift
    im.bind("resume", 27) or >>   // Esc

    $st := inp.new_input_context_stack()
    st.register_context("gameplay", 10, false) or >>
    st.register_context("vehicle", 20, false) or >>
    st.register_context("pause", 100, true) or >>

    st.add_action("gameplay", "jump") or >>
    st.add_action("gameplay", "interact") or >>
    st.add_action("vehicle", "boost") or >>
    st.add_action("pause", "resume") or >>

    im.feed_key(32, true) or >>
    im.feed_key(27, true) or >>
    // Pause modal blocks lower layers
    assert(st.active_context_for("jump") == "")
    assert(!st.pressed(&im, "jump"))
    assert(st.active_context_for("resume") == "pause" && st.pressed(&im, "resume"))

    // Disable pause -> vehicle + gameplay both allowed
    st.set_enabled("pause", false) or >>
    assert(st.active_context_for("jump") == "gameplay" && st.pressed(&im, "jump"))
    assert(st.active_context_for("boost") == "vehicle")

    // Rebind conflict detection & swap
    assert(rejects_conflict_rebind($&st, $&im, "gameplay", "jump", 32, 69))
    cf := st.find_key_conflicts(&im, "gameplay", 69, "jump") or >>
    assert(cf.len == 1 && cf[0] == "interact")
    swapped := st.rebind_in_context($&im, "gameplay", "jump", 32, 69, true) or >>
    assert(swapped.len == 1 && swapped[0] == "interact")
    jk := im.action_keys("jump") or >>
    ik := im.action_keys("interact") or >>
    assert(jk.len == 1 && jk[0] == 69 && ik.len == 1 && ik[0] == 32)
    << 0
}

fn run() int {
    test_prng() or >>
    test_stl_export() or >>
    test_physics_triggers() or >>
    test_jobs_and_partition_streaming() or >>
    test_input_contexts() or >>
    println("PASS: developer_systems_r2_checks (Xoshiro128++ PRNG/Poisson, STL encode/decode, Physics3D TriggerTracker3D, BudgetedJobQueue/PartitionStreamingScheduler, InputContextStack)")
    << 0
}

fn main() int {
    << run() or (err) {
        eprintln("FAIL: " + err.msg())
        << 1
    }
}
