@main

images #"github.com/xulang-org/nexus/assets/image"
data #"github.com/xulang-org/nexus/resources/image"
driver #"github.com/xulang-org/nexus/platform/sdl_image"
#os

fn rejected(name string) bool {
    images.load_png("build/png-fixtures/" + name) >>> (err) { << true }
    << false
}
fn invalid_image(image &data.ImageRGBA8) bool { image.validate() >>> (err) { << true }
    << false }
fn bad_bytes(raw &[]int, budget int) bool { images.decode_png_bytes(raw, budget) >>> (err) { << true }
    << false }
fn run() int {
    // Run with an unusable video driver: decoding must not initialize video/GPU.
    rgba := images.load_png("build/png-fixtures/rgba.png") >>>
    rgba.validate() >>>
    assert(rgba.width == 2 && rgba.height == 2 && rgba.pixels.len == 4)
    assert(rgba.pixels[0] == 4278190335 && rgba.pixels[1] == 16711935)
    assert(rgba.pixels[2] == 65535 && rgba.pixels[3] == 1082179712)
    rgb := images.load_png("build/png-fixtures/rgb.png") >>>
    assert(rgb.pixels[0] == rgba.pixels[0] && rgb.pixels[1] == rgba.pixels[1])
    gray := images.load_png("build/png-fixtures/gray.png") >>>
    gray1 := images.load_png("build/png-fixtures/gray1.png") >>>
    gray16 := images.load_png("build/png-fixtures/gray16.png") >>>
    assert(gray.pixels[0] == 255 && gray.pixels[1] == 4294967295)
    assert(gray1.pixels[0] == gray.pixels[0] && gray1.pixels[1] == gray.pixels[1])
    assert(gray16.pixels[0] == gray.pixels[0] && gray16.pixels[1] == gray.pixels[1])
    alpha := images.load_png("build/png-fixtures/gray-alpha.png") >>>
    assert(alpha.pixels[0] == 2155905088 && alpha.pixels[1] == 4294967040)
    palette := images.load_png("build/png-fixtures/palette.png") >>>
    assert(palette.pixels[0] == 4278190335 && palette.pixels[1] == 16711808)
    for name in ["missing.png", "not-png.png", "truncated.png", "too-wide.png", "zero-height.png", "pixel-budget.png", "bad-deflate.png"] {
        assert(rejected(name + ""))
    }
    invalid := data.ImageRGBA8{width: 2, height: 2, pixels: [0]}
    invalid_color := data.ImageRGBA8{width: 1, height: 1, pixels: [-1]}
    assert(invalid_image(&invalid) && invalid_image(&invalid_color))
    raw := os.read("build/png-fixtures/rgba.png") >>>
    $bytes := []int{}
    for i in 0:raw.len { bytes.push(raw[i] & 255) }
    embedded := images.decode_png_bytes(&bytes, 4) >>>
    assert(embedded.pixels[3] == rgba.pixels[3])
    assert(bad_bytes(&bytes, 3) && bad_bytes(&bytes, 0))
    $compact := []u8{}
    for value in bytes { compact.push(u8(value)) }
    $pixels := [7, 7, 7, 7]
    $short := [7]
    assert(driver.raw_decode_png(&compact, 2, 2, $&short) < 0 && short[0] == 7)
    assert(driver.raw_decode_png(&compact, 1, 4, $&pixels) < 0 && pixels[0] == 7)
    bytes[bytes.len - 1] = 300
    assert(bad_bytes(&bytes, 4))
    compact[0] = u8(0)
    assert(driver.raw_decode_png(&compact, 2, 2, $&pixels) < 0 && pixels[0] == 7)
    println("PASS: CPU PNG decode without video/GPU, RGBA/RGB/gray/palette/alpha/1-bit/16-bit, bounded and malformed rejection, native spans")
    << 0
}
fn main() int { << run() >>> (err) { eprintln(err.msg())
    << 1 } }
