@main

app_run #"github.com/xulang-org/nexus/integration/application"
controls #"github.com/xulang-org/nexus/input"
input_bridge #"github.com/xulang-org/nexus/integration/input"
fm #"github.com/xulang-org/nexus/foundation/math"
#window

fn rejects_host(min_w int, min_h int) bool {
    app_run.new_app_host(60, 8, min_w, min_h) >>> (err) { << true }
    << false
}

fn rejects_resource(rel string, root string) bool {
    app_run.resolve_resource(rel, root) >>> (err) { << true }
    << false
}

fn rejects_data(rel string, root string) bool {
    app_run.resolve_data(rel, root) >>> (err) { << true }
    << false
}

fn run() int {
    assert(rejects_host(0, 100))
    assert(rejects_host(100, 0))
    $host := app_run.new_app_host(60, 8, 100, 80) >>>
    assert(!host.is_hosted())
    assert(host.running())
    assert(host.next_frame() >>>)

    res := app_run.resolve_resource("canvas/format", "build/desktop-res") >>>
    assert(res == "build/desktop-res/canvas/format")
    sav := app_run.resolve_data("arena-v1.json", "build/desktop-data") >>>
    assert(sav == "build/desktop-data/arena-v1.json")
    assert(rejects_resource("../secret", "build"))
    assert(rejects_resource("/abs", "build"))
    assert(rejects_resource("ok.png", ""))
    assert(rejects_data("bad//path", "build"))
    assert(rejects_data("ok.json", ""))

    wopts := window.Options{title: "AppHostTest", width: 320, height: 240,
        resizable: true, high_pixel_density: false, hidden: true}
    $win := window.open(&wopts) >>>
    $input := controls.new_input_map()
    $touch := input_bridge.new_touch_controls(fm.vec2(60.0, 180.0), 40.0, 0.1, 0) >>>
    step1 := host.begin_step(&win, $&input, $&touch, 1000000000) >>>
    assert(step1.running && step1.drawable && step1.layout_changed && !step1.resumed)
    assert(step1.viewport.logical_width == 320.0 && step1.viewport.logical_height == 240.0)
    t1 := host.finish_step(false) >>>
    assert(t1.steps == 0)

    step2 := host.begin_step(&win, $&input, $&touch, 1016666667) >>>
    assert(step2.running && step2.drawable && !step2.layout_changed)
    t2 := host.finish_step(false) >>>
    assert(t2.steps == 1)

    host.request_exit()
    assert(!host.running())
    assert(!(host.next_frame() >>>))
    win.close() >>>

    println("phone application host: desktop/phone runner, path resolution and step lifecycle PASS")
    << 0
}

fn main() int {
    << run() >>> (err) {
        eprintln(err.msg())
        << 1
    }
}
