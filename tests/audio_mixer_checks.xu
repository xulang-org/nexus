@main

mix #"github.com/xulang-org/nexus/audio/mixer"
pcm #"github.com/xulang-org/nexus/resources/audio"
#math

fn make_clip(rate int, channels int, samples []int) pcm.Clip { << pcm.pcm16(rate, channels, samples) or >> }
fn commit_rejected(mixer $&mix.Mixer, block &mix.MixBlock) bool { mixer.commit(block) or (err) { << true }
    << false }
fn play_rejected(mixer $&mix.Mixer, clip int, volume f64) bool { mixer.play(clip, 0, volume, 0.0, false) or (err) { << true }
    << false }
fn run() int {
    $mixer := mix.new_mixer(48000, 4) or >>
    source := make_clip(24000, 1, [0, 10000, 20000, 30000]) or >>
    clip := mixer.add_clip(source) or >>
    bus := mixer.add_bus(0, "Music", 0.5) or >>
    child := mixer.add_bus(bus, "Detail", 0.5) or >>
    voice := mixer.play(clip, child, 1.0, 0.0, false) or >>
    pending := mixer.prepare(4) or >>
    assert(pending.samples[0] == 0 && pending.samples[2] == 1250 && pending.samples[4] == 2500 && pending.samples[6] == 3750)
    assert((mixer.position_frames(voice) or >>) == 0.0)
    mixer.commit(&pending) or >>
    assert((mixer.position_frames(voice) or >>) == 2.0 && commit_rejected($&mixer, &pending))
    mixer.pause_bus(bus, true) or >>
    paused := mixer.render(4) or >>
    assert(paused[0] == 0 && (mixer.position_frames(voice) or >>) == 2.0)
    mixer.pause_bus(bus, false) or >>
    mixer.mute_bus(bus, true) or >>
    muted := mixer.render(4) or >>
    assert(muted[0] == 0 && !(mixer.is_playing(voice) or >>))
    mixer.mute_bus(bus, false) or >>
    loop := mixer.play(clip, 0, 1.0, -1.0, true) or >>
    assert(!mixer.is_voice(voice))
    cycle := mixer.render(10) or >>
    assert(cycle[2] == 5000 && cycle[3] == 0 && cycle[16] == 0 && (mixer.is_playing(loop) or >>))
    mixer.pause_voice(loop, true) or >>
    position := mixer.position_frames(loop) or >>
    mixer.render(16) or >>
    assert((mixer.position_frames(loop) or >>) == position)
    mixer.pause_voice(loop, false) or >>
    stale := mixer.prepare(8) or >>
    mixer.set_pan(loop, 1.0) or >>
    assert(commit_rejected($&mixer, &stale))
    mixer.stop(loop) or >>
    stereo_source := make_clip(48000, 2, [30000, -30000, 30000, -30000]) or >>
    stereo := mixer.add_clip(stereo_source) or >>
    a := mixer.play(stereo, 0, 1.0, 0.0, false) or >>
    b := mixer.play(stereo, 0, 1.0, 0.0, false) or >>
    clipped := mixer.render(2) or >>
    assert(clipped[0] == 32767 && clipped[1] == -32768 && !(mixer.is_playing(a) or >>) && !(mixer.is_playing(b) or >>))
    assert(play_rejected($&mixer, stereo, math.sqrt(-1.0)))
    // Equal revisions do not let a different immutable PCM bank accept a receipt.
    $other := mix.new_mixer(48000, 4) or >>
    $equivalent_revision := mix.new_mixer(48000, 4) or >>
    reference_source := make_clip(24000, 1, [0, 10000, 20000, 30000]) or >>
    equivalent_revision.add_clip(reference_source) or >>
    alien_source := make_clip(24000, 1, [1, 2, 3, 4]) or >>
    other.add_clip(alien_source) or >>
    alien := other.prepare(4) or >>
    assert(commit_rejected($&equivalent_revision, &alien))
    for i in 0:100 {
        old := mixer.play(stereo, 0, 0.0, 0.0, false) or >>
        mixer.stop(old) or >>
        fresh := mixer.play(stereo, 0, 0.0, 0.0, false) or >>
        assert(old != fresh && !mixer.is_voice(old))
        mixer.stop(fresh) or >>
    }
    println("PASS: pure Xu stereo mixer, linear resampling, hierarchical gain/pan, clipping, looping, pause/mute, stale receipts and 100 voice reuse cycles")
    << 0
}
fn main() int { << run() or (err) { eprintln(err.msg())
    << 1 } }
