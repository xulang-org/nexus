@main

mix #"github.com/xulang-org/nexus/audio/mixer"
pcm #"github.com/xulang-org/nexus/resources/audio"
#math

fn make_clip(rate int, channels int, samples []int) pcm.Clip { << pcm.pcm16(rate, channels, samples) >>> }
fn commit_rejected(mixer $&mix.Mixer, block &mix.MixBlock) bool { mixer.commit(block) >>> (err) { << true }
    << false }
fn play_rejected(mixer $&mix.Mixer, clip int, volume f64) bool { mixer.play(clip, 0, volume, 0.0, false) >>> (err) { << true }
    << false }
fn run() int {
    $mixer := mix.new_mixer(48000, 4) >>>
    source := make_clip(24000, 1, [0, 10000, 20000, 30000]) >>>
    clip := mixer.add_clip(source) >>>
    bus := mixer.add_bus(0, "Music", 0.5) >>>
    child := mixer.add_bus(bus, "Detail", 0.5) >>>
    voice := mixer.play(clip, child, 1.0, 0.0, false) >>>
    pending := mixer.prepare(4) >>>
    assert(pending.samples[0] == 0 && pending.samples[2] == 1250 && pending.samples[4] == 2500 && pending.samples[6] == 3750)
    assert((mixer.position_frames(voice) >>>) == 0.0)
    mixer.commit(&pending) >>>
    assert((mixer.position_frames(voice) >>>) == 2.0 && commit_rejected($&mixer, &pending))
    mixer.pause_bus(bus, true) >>>
    paused := mixer.render(4) >>>
    assert(paused[0] == 0 && (mixer.position_frames(voice) >>>) == 2.0)
    mixer.pause_bus(bus, false) >>>
    mixer.mute_bus(bus, true) >>>
    muted := mixer.render(4) >>>
    assert(muted[0] == 0 && !(mixer.is_playing(voice) >>>))
    mixer.mute_bus(bus, false) >>>
    loop := mixer.play(clip, 0, 1.0, -1.0, true) >>>
    assert(!mixer.is_voice(voice))
    cycle := mixer.render(10) >>>
    assert(cycle[2] == 5000 && cycle[3] == 0 && cycle[16] == 0 && (mixer.is_playing(loop) >>>))
    mixer.pause_voice(loop, true) >>>
    position := mixer.position_frames(loop) >>>
    mixer.render(16) >>>
    assert((mixer.position_frames(loop) >>>) == position)
    mixer.pause_voice(loop, false) >>>
    stale := mixer.prepare(8) >>>
    mixer.set_pan(loop, 1.0) >>>
    assert(commit_rejected($&mixer, &stale))
    mixer.stop(loop) >>>
    stereo_source := make_clip(48000, 2, [30000, -30000, 30000, -30000]) >>>
    stereo := mixer.add_clip(stereo_source) >>>
    a := mixer.play(stereo, 0, 1.0, 0.0, false) >>>
    b := mixer.play(stereo, 0, 1.0, 0.0, false) >>>
    clipped := mixer.render(2) >>>
    assert(clipped[0] == 32767 && clipped[1] == -32768 && !(mixer.is_playing(a) >>>) && !(mixer.is_playing(b) >>>))
    assert(play_rejected($&mixer, stereo, math.sqrt(-1.0)))
    // Equal revisions do not let a different immutable PCM bank accept a receipt.
    $other := mix.new_mixer(48000, 4) >>>
    $equivalent_revision := mix.new_mixer(48000, 4) >>>
    reference_source := make_clip(24000, 1, [0, 10000, 20000, 30000]) >>>
    equivalent_revision.add_clip(reference_source) >>>
    alien_source := make_clip(24000, 1, [1, 2, 3, 4]) >>>
    other.add_clip(alien_source) >>>
    alien := other.prepare(4) >>>
    assert(commit_rejected($&equivalent_revision, &alien))
    for i in 0:100 {
        old := mixer.play(stereo, 0, 0.0, 0.0, false) >>>
        mixer.stop(old) >>>
        fresh := mixer.play(stereo, 0, 0.0, 0.0, false) >>>
        assert(old != fresh && !mixer.is_voice(old))
        mixer.stop(fresh) >>>
    }
    // Regression: DSP render() matches prepare()+commit(), and DSP mutation invalidates prepared receipt.
    $m_ren := mix.new_mixer(48000, 4) >>>
    $m_prep := mix.new_mixer(48000, 4) >>>
    dsp_clip_a := make_clip(48000, 1, [16000, -16000, 16000, -16000, 16000, -16000, 16000, -16000]) >>>
    dsp_clip_b := make_clip(48000, 1, [16000, -16000, 16000, -16000, 16000, -16000, 16000, -16000]) >>>
    c_ren := m_ren.add_clip(dsp_clip_a) >>>
    c_prep := m_prep.add_clip(dsp_clip_b) >>>
    m_ren.enable_bus_lowpass(0, 1500.0, 0.707) >>>
    m_prep.enable_bus_lowpass(0, 1500.0, 0.707) >>>
    m_ren.enable_bus_delay(0, 0.01, 0.4, 0.5) >>>
    m_prep.enable_bus_delay(0, 0.01, 0.4, 0.5) >>>
    _ := m_ren.play(c_ren, 0, 1.0, 0.0, false) >>>
    _ := m_prep.play(c_prep, 0, 1.0, 0.0, false) >>>
    out_ren := m_ren.render(16) >>>
    blk_prep := m_prep.prepare(16) >>>
    m_prep.commit(&blk_prep) >>>
    assert(out_ren.len == blk_prep.samples.len)
    for k in 0:out_ren.len { assert(out_ren[k] == blk_prep.samples[k]) }
    blk_stale := m_prep.prepare(8) >>>
    m_prep.disable_bus_delay(0) >>>
    assert(commit_rejected($&m_prep, &blk_stale))
    println("PASS: pure Xu stereo mixer, linear resampling, hierarchical gain/pan, clipping, looping, pause/mute, stale receipts and 100 voice reuse cycles")
    << 0
}
fn main() int { << run() >>> (err) { eprintln(err.msg())
    << 1 } }
