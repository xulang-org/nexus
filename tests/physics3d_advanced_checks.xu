@main

#math
#errors
fm #"github.com/xulang-org/nexus/foundation/math"
phys #"github.com/xulang-org/nexus/physics3d"

fn run_checks() int {
    floor_box := fm.aabb3(fm.vec3(-80.0, -2.0, -120.0), fm.vec3(80.0, 0.0, 120.0)) >>>
    gravity := fm.vec3(0.0, -9.81, 0.0)

    // =========================================================================
    // 1. XPBD Soft-Body Volumetric Preservation (2x2x2 Tetrahedral Cube Drop)
    // =========================================================================
    $soft_world := phys.new_xpbd_world_3d(gravity, 0.08, &[floor_box], &[1], &[]phys.StaticTriangle3D{}) >>>
    // Cube with strong volume preservation (volume_compliance = 0.0001)
    soft_ok := soft_world.add_soft_tetra_box(
        fm.vec3(-0.5, 2.2, -0.5), fm.vec3(1.0, 1.0, 1.0), 2, 2, 2,
        0.04, 0.15, 0.0002, 0.00005, 1, 1
    ) >>>
    // Control cube with soft edges & NO volume preservation (volume_compliance = 1e10 disables tet constraints)
    $no_vol_world := phys.new_xpbd_world_3d(gravity, 0.08, &[floor_box], &[1], &[]phys.StaticTriangle3D{}) >>>
    soft_novol := no_vol_world.add_soft_tetra_box(
        fm.vec3(-0.5, 2.2, -0.5), fm.vec3(1.0, 1.0, 1.0), 2, 2, 2,
        0.04, 0.15, 0.005, 1e10, 1, 1
    ) >>>

    assert(soft_ok.tet_ids.len == 40)
    assert(math.abs(soft_ok.rest_volume - 1.0) < 1e-6)
    assert(soft_novol.tet_ids.len == 0)

    for _ in 0:180 {
        soft_world.step(1.0 / 60.0, 6, 4) >>>
        no_vol_world.step(1.0 / 60.0, 6, 4) >>>
    }
    cur_vol := soft_world.current_soft_volume(&soft_ok) >>>
    vol_err := math.abs(cur_vol - soft_ok.rest_volume) / soft_ok.rest_volume
    com_ok := soft_world.soft_center_of_mass(&soft_ok) >>>
    com_nv := no_vol_world.soft_center_of_mass(&soft_novol) >>>
    if vol_err >= 0.06 {
        >> errors.new("SoftBody Check 1 failed: volume error >= 6% (" + str(int(vol_err * 1000.0)) + "e-3)")
    }
    if com_ok.y < 0.35 || com_ok.y <= com_nv.y {
        >> errors.new("SoftBody Check 1 failed: volumetric cube should hold height better than soft no-volume control")
    }

    // =========================================================================
    // 2. XPBD Dihedral Bending Stiffness & Aerodynamic Cloth Wind Billow
    // =========================================================================
    $wind_world := phys.new_xpbd_world_3d(gravity, 0.15, &[floor_box], &[1], &[]phys.StaticTriangle3D{}) >>>
    wind_world.set_wind(fm.vec3(10.0, 0.4, 3.8), 1.225) >>>
    stiff_ids := wind_world.add_aerodynamic_cloth(
        fm.vec3(0.0, 4.0, -2.0), fm.vec3(0.35, 0.0, 0.0), fm.vec3(0.0, -0.35, 0.0),
        6, 4, 0.03, 0.10, 0.0001, 0.0005, 1.4, 0.6, true, 1, 1
    ) >>>
    limp_ids := wind_world.add_aerodynamic_cloth(
        fm.vec3(0.0, 4.0, 2.0), fm.vec3(0.35, 0.0, 0.0), fm.vec3(0.0, -0.35, 0.0),
        6, 4, 0.03, 0.10, 0.0001, 2.0, 1.4, 0.6, true, 1, 1
    ) >>>
    assert(wind_world.bend_constraint_count() > 20 && wind_world.aero_triangle_count() == 60)

    for _ in 0:120 {
        wind_world.step(1.0 / 60.0, 5, 4) >>>
    }
    // Check free edge tip x and z billow under wind (+Z wind) & stiff vs limp droop in Y.
    $stiff_avg_z := 0.0
    $stiff_tip_y := 0.0
    $limp_tip_y := 0.0
    for r in 0:4 {
        p_s := wind_world.position(stiff_ids[r * 6 + 5]) >>>
        p_l := wind_world.position(limp_ids[r * 6 + 5]) >>>
        stiff_avg_z += (p_s.z - (-2.0))
        stiff_tip_y += p_s.y
        limp_tip_y += p_l.y
    }
    stiff_avg_z *= 0.25
    stiff_tip_y *= 0.25
    limp_tip_y *= 0.25
    if stiff_avg_z < 0.25 {
        >> errors.new("Cloth Wind Check 2 failed: aero wind did not billow flag in +Z (" + str(int(stiff_avg_z * 100.0)) + "cm)")
    }
    if stiff_tip_y <= limp_tip_y + 0.04 {
        >> errors.new("Cloth Bend Check 2 failed: stiff dihedral cloth did not resist droop over limp cloth")
    }

    // =========================================================================
    // 3. Fluid Buoyancy: Archimedes Equilibrium, Sink, Self-Righting & Current
    // =========================================================================
    seabed := fm.aabb3(fm.vec3(-80.0, -6.0, -80.0), fm.vec3(80.0, -4.0, 80.0)) >>>
    $water_world := phys.new_jointed_world_3d(gravity, 0.05, 0.08, &[seabed], &[1], &[]phys.StaticTriangle3D{}) >>>
    box_he := fm.vec3(0.5, 0.5, 0.5) // 1.0 m^3 volume
    ident_q := fm.quaternion(0.0, 0.0, 0.0, 1.0)
    // Wood crate: mass=500kg => half density of water (1000kg/m^3), equilibrates at waterline y=0.0
    wood_id := water_world.add_body(fm.vec3(0.0, 2.5, 0.0), ident_q, box_he, 500.0, 0.1, 0.4, 1, 1) >>>
    // Stone crate: mass=2200kg => sinks to seabed y=-4.0 + 0.5 = -3.5
    stone_id := water_world.add_body(fm.vec3(4.0, 2.5, 0.0), ident_q, box_he, 2200.0, 0.1, 0.5, 1, 1) >>>
    // Tilted raft: wide 2x0.4x1.5 box rolled 28 degrees around Z
    raft_he := fm.vec3(1.0, 0.2, 0.75)
    tilt_q := fm.quaternion(0.0, 0.0, math.sin(0.245), math.cos(0.245))
    raft_id := water_world.add_body(fm.vec3(-5.0, 0.05, 0.0), tilt_q, raft_he, 300.0, 0.1, 0.4, 1, 1) >>>

    $fluid := phys.default_fluid_volume_3d(0.0)
    b0 := phys.new_buoyancy_body_3d(wood_id, phys.buoyancy_pontoons_for_box(box_he, 2, 2, 2) >>>) >>>
    b1 := phys.new_buoyancy_body_3d(stone_id, phys.buoyancy_pontoons_for_box(box_he, 2, 2, 2) >>>) >>>
    b2 := phys.new_buoyancy_body_3d(raft_id, phys.buoyancy_pontoons_for_box(raft_he, 2, 1, 2) >>>) >>>
    $buoy_bodies := [b0, b1, b2]

    dt := 1.0 / 60.0
    for _ in 0:300 {
        phys.apply_buoyancy_to_jointed_world($&water_world, &fluid, $&buoy_bodies, dt) >>>
        water_world.step(dt, 4, 4) >>>
    }
    wood_pos := water_world.position(wood_id) >>>
    wood_sub := buoy_bodies[0].submerged_ratio
    stone_pos := water_world.position(stone_id) >>>
    raft_mat := water_world.transform_matrix(raft_id) >>>
    raft_up_y := raft_mat.c1.y

    if math.abs(wood_pos.y) >= 0.12 || wood_sub < 0.40 || wood_sub > 0.60 {
        >> errors.new("Buoyancy Check 3 failed: wood crate equilibrium error (y=" +
            str(int(wood_pos.y * 100.0)) + "cm, sub=" + str(int(wood_sub * 100.0)) + "%)")
    }
    if stone_pos.y > -2.5 {
        >> errors.new("Buoyancy Check 3 failed: heavy stone did not sink to seabed (y=" + str(int(stone_pos.y * 100.0)) + "cm)")
    }
    if raft_up_y <= 0.96 {
        >> errors.new("Buoyancy Check 3 failed: tilted raft did not self-right (up_y=" + str(int(raft_up_y * 1000.0)) + "e-3)")
    }

    // River current + waves drift check.
    fluid.flow_velocity = fm.vec3(3.2, 0.0, 0.0)
    fluid.wave_amplitude = 0.28
    fluid.wave_frequency = 0.9
    fluid.wave_speed = 2.5
    $min_wave_y := 999.0
    $max_wave_y := -999.0
    for _ in 0:180 {
        fluid.advance(dt) >>>
        phys.apply_buoyancy_to_jointed_world($&water_world, &fluid, $&buoy_bodies, dt) >>>
        water_world.step(dt, 4, 4) >>>
        wy := (water_world.position(wood_id) >>>).y
        if wy < min_wave_y { min_wave_y = wy }
        if wy > max_wave_y { max_wave_y = wy }
    }
    drift_pos := water_world.position(wood_id) >>>
    if drift_pos.x < 1.5 || (max_wave_y - min_wave_y) < 0.08 {
        >> errors.new("Buoyancy Check 3 failed: river drift / wave bobbing insufficient")
    }

    // =========================================================================
    // 4. Raycast Vehicle Suspension Settlement & Triangle Ramp Climbing
    // =========================================================================
    // Ramp leading from z = -8 up to y = 2.0 at z = -22, plus flat road floor y = 0
    r_tri1 := phys.static_triangle_3d(fm.vec3(-8.0, 0.0, -8.0), fm.vec3(8.0, 2.0, -22.0), fm.vec3(8.0, 0.0, -8.0), 1) >>>
    r_tri2 := phys.static_triangle_3d(fm.vec3(-8.0, 0.0, -8.0), fm.vec3(-8.0, 2.0, -22.0), fm.vec3(8.0, 2.0, -22.0), 1) >>>
    plateau := fm.aabb3(fm.vec3(-20.0, 0.0, -110.0), fm.vec3(20.0, 2.0, -22.0)) >>>
    car_he := fm.vec3(0.95, 0.42, 2.0)

    $road_world := phys.new_jointed_world_3d(gravity, 0.02, 0.05, &[floor_box, plateau], &[1, 1], &[r_tri1, r_tri2]) >>>
    car_id := road_world.add_body(fm.vec3(0.0, 1.0, 10.0), ident_q, car_he, 1200.0, 0.05, 0.6, 1, 1) >>>
    $car := phys.default_four_wheel_car_3d(car_id, car_he, 1200.0) >>>

    // Phase A: Drop and settle onto flat road
    for _ in 0:90 {
        _ := car.step($&road_world, dt, 0.0, 0.0, 0.0, false) >>>
        road_world.step(dt, 4, 4) >>>
    }
    settled_pos := road_world.position(car_id) >>>
    settled_vel := road_world.linear_velocity(car_id) >>>
    if car.grounded_wheel_count() != 4 || settled_pos.y < 0.42 || settled_pos.y > 0.98 || math.abs(settled_vel.y) > 0.15 {
        >> errors.new("Vehicle Check 4 failed: suspension settle failed (grounded=" +
            str(car.grounded_wheel_count()) + " y=" + str(int(settled_pos.y * 100.0)) + "cm)")
    }

    // Phase B: Accelerate forward (-Z) up the 12 deg triangle ramp onto plateau (y=2.0)
    $max_spd := 0.0
    for _ in 0:230 {
        _ := car.step($&road_world, dt, 0.90, 0.0, 0.0, false) >>>
        road_world.step(dt, 4, 4) >>>
        spd := car.forward_speed_mps(&road_world) >>>
        if spd > max_spd { max_spd = spd }
    }
    climbed_pos := road_world.position(car_id) >>>
    if max_spd < 6.0 || climbed_pos.z > -22.0 || climbed_pos.y < 2.2 {
        >> errors.new("Vehicle Check 4 failed: ramp climb failed (spd=" + str(int(max_spd)) +
            " z=" + str(int(climbed_pos.z)) + " y=" + str(int(climbed_pos.y * 100.0)) + "cm)")
    }

    // =========================================================================
    // 5. Ackermann Steering Geometry, Pacejka Cornering & Full Braking
    // =========================================================================
    $track_world := phys.new_jointed_world_3d(gravity, 0.02, 0.05, &[floor_box], &[1], &[]phys.StaticTriangle3D{}) >>>
    c2_id := track_world.add_body(fm.vec3(0.0, 0.8, 0.0), ident_q, car_he, 1200.0, 0.05, 0.6, 1, 1) >>>
    $c2 := phys.default_four_wheel_car_3d(c2_id, car_he, 1200.0) >>>

    // Build straight speed first
    for _ in 0:110 {
        _ := c2.step($&track_world, dt, 0.75, 0.0, 0.0, false) >>>
        track_world.step(dt, 4, 4) >>>
    }
    // Corner hard right (+steer = 0.65)
    for _ in 0:150 {
        _ := c2.step($&track_world, dt, 0.55, 0.0, 0.65, false) >>>
        track_world.step(dt, 4, 4) >>>
    }
    fl_ang := math.abs(c2.states[0].steer_angle)
    fr_ang := math.abs(c2.states[1].steer_angle)
    if fr_ang <= fl_ang * 1.05 {
        >> errors.new("Vehicle Check 5 failed: Ackermann inner right wheel should steer sharper than outer left wheel")
    }
    turn_pos := track_world.position(c2_id) >>>
    turn_mat := track_world.transform_matrix(c2_id) >>>
    // Check car steered right (+X) and stayed upright (up.y > 0.88)
    if turn_pos.x < 3.0 || turn_mat.c1.y < 0.88 {
        >> errors.new("Vehicle Check 5 failed: Pacejka cornering insufficient or rolled (x=" +
            str(int(turn_pos.x * 10.0)) + "dm up_y=" + str(int(turn_mat.c1.y * 1000.0)) + "e-3)")
    }

    // Brake + handbrake smoothly to rest
    for _ in 0:180 {
        _ := c2.step($&track_world, dt, 0.0, 1.0, 0.0, true) >>>
        track_world.step(dt, 4, 4) >>>
    }
    stop_spd := c2.speed_mps(&track_world) >>>
    if stop_spd >= 0.45 {
        >> errors.new("Vehicle Check 5 failed: braking did not bring car near stop (spd=" + str(int(stop_spd * 100.0)) + "cm/s)")
    }

    println("PASS: Advanced 3D Physics (soft_vol_err=" + str(int(vol_err * 1000.0)) + "e-3, cloth_z=" +
        str(int(stiff_avg_z * 100.0)) + "cm, wood_y=" + str(int(wood_pos.y * 100.0)) + "cm, raft_up=" +
        str(int(raft_up_y * 1000.0)) + "e-3, ramp_y=" + str(int(climbed_pos.y * 100.0)) + "cm, turn_x=" +
        str(int(turn_pos.x * 10.0)) + "dm, brk=" + str(int(stop_spd * 100.0)) + "cm/s)")
    << 0
}

fn main() int {
    << run_checks() >>> (err) {
        println("FAIL: " + err.msg())
        << 1
    }
}
