@main
resource #"github.com/xulang-org/nexus/resources/scene"
codec #"github.com/xulang-org/nexus/formats/scene"
files #"github.com/xulang-org/nexus/integration/scene"
persist #"github.com/xulang-org/nexus/integration/scene_lighting"
lights #"github.com/xulang-org/nexus/resources/lighting"
bindings #"github.com/xulang-org/nexus/integration/lighting"
shadows #"github.com/xulang-org/nexus/resources/shadow"
fm #"github.com/xulang-org/nexus/foundation/math"
nexus #"github.com/xulang-org/nexus/scene"
#os
#strings
#math
fn rejected(raw &string) bool { codec.decode(raw) or(err){ << true }
    << false }
fn bad_lights(document &resource.Document, attachments []resource.LightAttachment) bool {
    resource.with_lights(document,attachments) or(err){ << true }
    << false
}
fn bad_batch(world $&bindings.SceneLights3D, tree &nexus.SceneTree, nodes []int, sources []lights.Light3D) bool {
    world.attach_batch(tree,nodes,sources) or(err){ << true }
    << false
}
fn bad_configured_batch(world $&bindings.SceneLights3D, tree &nexus.SceneTree, nodes []int,
    configured []bindings.LightBinding3D) bool {
    world.attach_bindings(tree, nodes, configured) or (err) { << true }
    << false
}
fn bad_mount(document &resource.Document, world $&bindings.SceneLights3D, tree $&nexus.SceneTree, parent int, name string) bool {
    persist.instantiate(document,world,tree,parent,name) or(err){ << true }
    << false
}
fn bad_bind(document &resource.Document, world $&bindings.SceneLights3D, tree &nexus.SceneTree, root int) bool {
    persist.bind(document,world,tree,root) or(err){ << true }
    << false
}
fn bad_nodes(document &resource.Document) bool { files.to_packed(document) or(err){ << true }
    << false }
fn bad_capture(world &bindings.SceneLights3D, tree &nexus.SceneTree, root int) bool {
    persist.capture_nodes(world,tree,root) or(err){ << true }
    << false
}
fn bad_selection(environment &lights.Environment3D) bool {
    environment.for_bounds(fm.Aabb3{minimum: fm.vec3(0.0,0.0,0.0),maximum: fm.vec3(0.0,0.0,0.0)}) or(err){ << true }
    << false
}
fn snapshot(tree &nexus.SceneTree) string {
    document := files.capture_nodes(tree,tree.root()) or >>
    << codec.encode(&document) or >>
}
fn corpus() int {
    document := files.load("build/scene-lighting-fixtures/base.xuscene") or >>
    assert(document.node_count()==7 && document.light_count()==4)
    point := (document.light(1) or >>).source
    spot := (document.light(2) or >>).source
    assert(point.position().x==0.125 && point.radius()==8.123456789012345)
    assert(spot.inner_cosine()==0.9751234567890123 && spot.outer_cosine()==0.7001234567890123)
    raw := codec.encode(&document) or >>
    decoded := codec.decode(&raw) or >>
    assert((codec.encode(&decoded) or >>)==raw)
    assert((decoded.light(0) or >>).source.radiance().x==0.12345678901234567)
    full := files.load("build/scene-lighting-fixtures/full.xuscene") or >>
    encoded := codec.encode(&full) or >>
    assert((codec.decode(&encoded) or >>).light_count()==256)
    $world := bindings.new_scene_lights_3d()
    $tree := nexus.new_scene_tree_3d("Full",300) or >>
    parent := tree.root()
    root := persist.instantiate(&full,$&world,$&tree,parent,"Loaded") or >>
    assert(world.binding_count()==256 && (world.gather(&tree) or >>).len==0)
    captured := persist.capture_nodes(&world,&tree,root) or >>
    assert(captured.light_count()==256)
    visible := files.load("build/scene-lighting-fixtures/visible17.xuscene") or >>
    $visible_world := bindings.new_scene_lights_3d()
    $visible_tree := nexus.new_scene_tree_3d("Visible",32) or >>
    visible_parent := visible_tree.root()
    persist.instantiate(&visible,$&visible_world,$&visible_tree,visible_parent,"Loaded") or >>
    candidates := visible_world.gather(&visible_tree) or >>
    assert(candidates.len==17)
    environment := lights.environment(fm.vec3(0.0,0.0,0.0),fm.vec3(0.0,0.0,1.0),1.0,candidates) or >>
    assert(bad_selection(&environment))
    text := os.read("build/scene-lighting-fixtures/reject-list.txt") or >>
    $count := 0
    for name in strings.split(&text,"\n") {
        if name.len==0 { -> }
        candidate := os.read("build/scene-lighting-fixtures/"+name) or >>
        if !rejected(&candidate) { println("Accepted invalid scene light: "+name)
            assert(false) }
        count+=1
    }
    $plain := resource.make_document([resource.node(-1,"Root",resource.NODE_3D)]) or >>
    valid := lights.point(fm.vec3(0.0,0.0,0.0),fm.vec3(1.0,2.0,3.0),5.0) or >>
    assert(bad_lights(&plain,[resource.light_attachment(0, lights.Light3D{})]))
    assert(bad_lights(&plain,[resource.light_attachment(1, valid)]))
    assert(bad_lights(&plain,[resource.light_attachment(0, valid),resource.light_attachment(0, valid)]))
    immutable := resource.with_lights(&plain,[resource.light_attachment(0, valid)]) or >>
    $returned := immutable.light(0) or >>
    returned.node=9
    assert((immutable.light(0) or >>).node==0 && plain.light_count()==0)
    println("PASS: light scene schema, exact scalar/cosine roundtrip, immutable attachments, 256 authored candidates / 16 affecting one mesh budgets and "+str(count)+" independent strict rejects")
    << 0
}
fn runtime() int {
    document := files.load("build/scene-lighting-fixtures/base.xuscene") or >>
    $tree := nexus.new_scene_tree_3d("Target",64) or >>
    parent := tree.root()
    tree.set_position_3d(parent,fm.vec3(20.0,0.0,0.0)) or >>
    $world := bindings.new_scene_lights_3d()
    root := persist.instantiate(&document,$&world,$&tree,parent,"First") or >>
    assert(world.binding_count()==4 && (world.gather(&tree) or >>).len==3)
    sources := world.gather(&tree) or >>
    assert(sources[1].position().x==30.125 && sources[2].position().x==28.0)
    first := persist.capture(&document,&world,&tree,root) or >>
    // The external parent's translation must never be baked into a local light.
    assert((first.light(1) or >>).source.position().x==0.125)
    assert((first.describe_node(0) or >>).local_3d.c3.x==5.0)
    assert(!(first.describe_node(5) or >>).visible && first.light_count()==4)
    second := persist.instantiate(&document,$&world,$&tree,parent,"Second") or >>
    point := tree.find_node(root,"Pivot/Point") or >>
    second_point := tree.find_node(second,"Pivot/Point") or >>
    replacement := lights.point(fm.vec3(0.75,0.0,1.0),fm.vec3(9.0,8.0,7.0),4.0) or >>
    world.attach(&tree,point,replacement) or >>
    tree.set_position_3d(point,fm.vec3(4.0,0.0,0.0)) or >>
    hidden := tree.find_node(root,"Hidden") or >>
    world.detach(hidden) or >>
    hud := tree.find_node(root,"HUD") or >>
    // A late bad source/node/duplicate cannot replace a valid earlier binding.
    assert(bad_batch($&world,&tree,[point,hud],[sources[0],replacement]))
    assert((world.source(&tree,point) or >>).radiance().x==9.0)
    assert(bad_batch($&world,&tree,[point,point],[replacement,replacement]))
    assert(bad_batch($&world,&tree,[point,second_point],[replacement,lights.Light3D{}]))
    assert(bad_batch($&world,&tree,[point],[]lights.Light3D{}))
    assert((world.source(&tree,second_point) or >>).position().x==0.125)
    current := persist.capture(&document,&world,&tree,root) or >>
    assert(current.light_count()==3 && (current.light(1) or >>).source.position().x==0.75)
    assert((current.describe_node(3) or >>).local_3d.c3.x==4.0)
    assert((document.light(1) or >>).source.position().x==0.125)
    // Explicit metadata preservation composes light edits with other systems.
    combined := files.load("examples/scene_av/assets/world.xuscene") or >>
    $combined_tree := nexus.new_scene_tree_3d("Combined",64) or >>
    packed := files.to_packed_nodes(&combined) or >>
    cp := combined_tree.root()
    cr := packed.instantiate($&combined_tree,cp,"Room") or >>
    ids := files.matching_nodes(&combined,&combined_tree,cr) or >>
    $combined_world := bindings.new_scene_lights_3d()
    combined_world.attach(&combined_tree,ids[0],replacement) or >>
    composed := persist.capture(&combined,&combined_world,&combined_tree,cr) or >>
    assert(composed.surface_count()==combined.surface_count() && composed.audio_count()==combined.audio_count() && composed.resource_count()==combined.resource_count() && composed.light_count()==1)
    $references := []resource.ResourceReference{}
    for i in 0:composed.resource_count() { references.push(composed.resource(i) or >>) }
    preserved := resource.with_references(&composed,&composed,references) or >>
    assert(preserved.light_count()==1 && (preserved.light(0) or >>).source.radius()==4.0)
    // Full convenience loaders must reject attachments they cannot restore.
    assert(bad_nodes(&document))
    before := snapshot(&tree) or >>
    count := world.binding_count()
    tree.take_ready() or >>
    assert(bad_mount(&document,$&world,$&tree,parent,"First"))
    assert(bad_mount(&composed,$&world,$&tree,parent,"Composed"))
    assert(bad_bind(&document,$&world,&tree,second_point))
    assert(before==(snapshot(&tree) or >>) && count==world.binding_count() && (tree.take_ready() or >>).len==0)
    $small := nexus.new_scene_tree_3d("Small",3) or >>
    sp := small.root()
    assert(bad_mount(&document,$&world,$&small,sp,"TooLarge"))
    assert((small.subtree(sp) or >>).len==1 && world.binding_count()==count)
    // Whole generation IDs protect bindings when slots are reused.
    tree.queue_free(root) or >>
    assert(bad_capture(&world,&tree,root))
    tree.flush_free() or >>
    third := persist.instantiate(&document,$&world,$&tree,parent,"Third") or >>
    assert(!tree.is_alive(point) && tree.is_alive(third))
    assert((world.prune(&tree) or >>)==3)
    assert(world.binding_count()==8)
    println("PASS: local/world source separation, hidden capture, independent instances/live edits, metadata preservation, batch and mount failure atomicity, stale IDs and explicit attachment restoration")
    << 0
}
fn cascade_profiles() int {
    document := files.load("build/scene-lighting-fixtures/cascades.xuscene") or >>
    authored := document.light(0) or >>
    config := authored.cascades.settings() or >>
    assert(config.count == 3 && config.resolution == 256 && config.distance == 42.98765432101234)
    assert(config.split_lambda == 0.71 && config.blend_fraction == 0.19 && config.caster_padding == 7.5)
    assert(config.stabilization_step == 0.03125 && config.raster_bias_texels == 0.0078125)
    original := codec.encode(&document) or >>
    restored := codec.decode(&original) or >>
    assert((codec.encode(&restored) or >>) == original)
    point := (document.light(1) or >>).source
    ordinary := resource.light_attachment(authored.node, point)
    $wrong_kind := ordinary
    wrong_kind.cascades = authored.cascades
    assert(bad_lights(&document, [wrong_kind]))

    $tree := nexus.new_scene_tree_3d("World", 32) or >>
    root := tree.root()
    prefix := tree.add_child_3d(root, "Unshadowed") or >>
    $world := bindings.new_scene_lights_3d()
    world.attach(&tree, prefix, point) or >>
    first := persist.instantiate(&document, $&world, $&tree, root, "First") or >>
    second := persist.instantiate(&document, $&world, $&tree, root, "Second") or >>
    first_sun := tree.find_node(first, "Pivot/Directional") or >>
    second_sun := tree.find_node(second, "Pivot/Directional") or >>
    first_point := tree.find_node(first, "Pivot/Point") or >>
    $selected := bindings.no_shadow_selection()
    sources := world.gather_with_shadows(&tree, $&selected) or >>
    assert(sources.len == 7 && selected.source == 1 && sources[1].kind() == lights.DIRECTIONAL)
    assert((selected.cascades.settings() or >>).distance == config.distance)
    hidden := tree.find_node(first, "Hidden") or >>
    retained := world.binding(&tree, hidden) or >>
    assert((retained.cascades.settings() or >>).count == 4)

    sun_edit := lights.directional(fm.vec3(0.0,1.0,0.0), fm.vec3(5.0,5.0,5.0)) or >>
    world.attach(&tree, first_sun, sun_edit) or >>
    assert((world.binding(&tree, first_sun) or >>).cascades.enabled())
    plain_sun := bindings.LightBinding3D{source: sun_edit, cascades: shadows.CascadeProfile3D{}, punctual: shadows.PunctualProfile3D{}}
    invalid_point := bindings.LightBinding3D{source: point, cascades: authored.cascades, punctual: shadows.PunctualProfile3D{}}
    assert(bad_configured_batch($&world, &tree, [first_sun, first_point], [plain_sun, invalid_point]))
    assert((world.binding(&tree, first_sun) or >>).cascades.enabled())
    tree.set_visible(first_sun, false) or >>
    after_hide := world.gather_with_shadows(&tree, $&selected) or >>
    assert(after_hide.len == 6 && selected.source == 3)
    assert((selected.cascades.settings() or >>).count == 3)
    world.attach(&tree, first_sun, point) or >>
    assert(!(world.binding(&tree, first_sun) or >>).cascades.enabled())
    assert((world.binding(&tree, second_sun) or >>).cascades.enabled())
    captured := persist.capture(&document, &world, &tree, first) or >>
    assert(!(captured.light(0) or >>).cascades.enabled())
    assert(((captured.light(3) or >>).cascades.settings() or >>).count == 4)
    println("PASS: cascade profiles round-trip exactly, hidden profiles persist, selection follows visible candidate identity, instances and failed batches stay isolated")
    << 0
}
fn punctual_profiles() int {
    document := files.load("build/scene-lighting-fixtures/punctual.xuscene") or >>
    original := codec.encode(&document) or >>
    restored := codec.decode(&original) or >>
    assert((codec.encode(&restored) or >>) == original)
    $tree := nexus.new_scene_tree_3d("World", 32) or >>
    root := tree.root()
    tree.set_position_3d(root, fm.vec3(20.0,0.0,0.0)) or >>
    $world := bindings.new_scene_lights_3d()
    first := persist.instantiate(&restored, $&world, $&tree, root, "First") or >>
    second := persist.instantiate(&restored, $&world, $&tree, root, "Second") or >>
    sun := tree.find_node(first, "Pivot/Directional") or >>
    point_node := tree.find_node(first, "Pivot/Point") or >>
    spot_node := tree.find_node(first, "Pivot/Spot") or >>
    second_point := tree.find_node(second, "Pivot/Point") or >>
    $selected := bindings.no_shadow_selection()
    world.gather_with_shadows(&tree, $&selected) or >>
    assert(selected.source == 0 && selected.cascades.enabled() && !selected.punctual.enabled())
    tree.set_visible(sun, false) or >>
    sources := world.gather_with_shadows(&tree, $&selected) or >>
    point := selected.punctual.description(sources[selected.source]) or >>
    assert(selected.source == 0 && !selected.cascades.enabled() && point.face_count() == 6)
    assert(point.resolution() == 512 && point.receiver_reference().x == 30.125)
    assert(point.constant_bias() == 0.00002 && point.slope_bias() == 0.00005)
    assert((selected.punctual.settings() or >>).near == 0.12345678901234567)
    tree.set_visible(point_node, false) or >>
    spots := world.gather_with_shadows(&tree, $&selected) or >>
    spot := selected.punctual.description(spots[selected.source]) or >>
    assert(selected.source == 0 && spot.face_count() == 1 && spot.resolution() == 1024)
    assert(spot.direction().z == -1.0 && spot.constant_bias() == 0.00003 && spot.slope_bias() == 0.00004)

    replacement := lights.point(fm.vec3(0.75,0.0,0.0), fm.vec3(9.0,8.0,7.0), 4.0) or >>
    world.attach(&tree, point_node, replacement) or >>
    original_point := world.binding(&tree, point_node) or >>
    assert(original_point.punctual.enabled() && original_point.source.position().x == 0.75)
    $invalid := original_point
    invalid.source = lights.point(fm.vec3(0.0,0.0,0.0), fm.vec3(1.0,1.0,1.0), 0.01) or >>
    spot_binding := world.binding(&tree, spot_node) or >>
    $clear_spot := spot_binding
    clear_spot.punctual = shadows.PunctualProfile3D{}
    assert(bad_configured_batch($&world, &tree, [spot_node, point_node], [clear_spot, invalid]))
    assert((world.binding(&tree, spot_node) or >>).punctual.enabled())
    assert((world.binding(&tree, point_node) or >>).source.radius() == 4.0)

    captured := persist.capture(&restored, &world, &tree, first) or >>
    assert(!(captured.describe_node(3) or >>).visible && (captured.light(1) or >>).punctual.enabled())
    assert((captured.light(1) or >>).source.position().x == 0.75)
    assert((world.binding(&tree, second_point) or >>).source.position().x == 0.125)
    world.attach(&tree, point_node, spot_binding.source) or >>
    assert(!(world.binding(&tree, point_node) or >>).punctual.enabled())
    assert((world.binding(&tree, second_point) or >>).punctual.enabled())
    println("PASS: point and spot shadow profiles round-trip, follow world pose and visible source identity, and retain atomic edits")
    << 0
}
fn main() int { << run() or(err){ eprintln(err.msg())
    << 1 } }
fn run() int { corpus() or >>
    runtime() or >>
    cascade_profiles() or >>
    punctual_profiles() or >>
    << 0 }
