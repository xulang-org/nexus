@main
#os
#strings
images #"github.com/xulang-org/nexus/assets/image"
fn rejected(raw &string,limit int) bool { images.decode_jpeg(raw,limit) >>>(err){ << true }
    << false }
fn run() int {
    for name in ["rgb444","rgb420","gray"] {
        raw := os.read("build/jpeg-fixtures/"+name+".jpg") >>>
        image := images.decode_jpeg(&raw,209) >>>
        assert(image.width==19 && image.height==11 && image.pixels.len==209)
        $output := strings.new_byte_builder(836)
        for pixel in image.pixels { for shift in [24,16,8,0] { output.write_byte((pixel >> shift) & 255) } }
        write_file("build/jpeg-fixtures/"+name+".rgba",output.to_string()) >>>
        assert(rejected(&raw,208) && rejected(&raw,0))
        truncated := raw[0:raw.len/2]+""
        assert(rejected(&truncated,209))
    }
    for name in ["progressive","cmyk","oversized","bad-marker","not-jpeg"] {
        raw := os.read("build/jpeg-fixtures/"+name+".jpg") >>>
        assert(rejected(&raw,4194304))
    }
    println("PASS: JPEG 444/420/gray, dimension and pixel budgets, malformed/truncated/progressive/CMYK rejection")
    << 0
}
fn main() int { << run() >>>(err){ eprintln(err.msg())
    << 1 } }
