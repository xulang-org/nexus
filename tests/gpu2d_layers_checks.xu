@main

#gpu

canvas_shaders #"github.com/xulang-org/nexus/assets/shaders/two_d"

ren_data #"github.com/xulang-org/nexus/resources/canvas"

nexus #"github.com/xulang-org/nexus/scene"
ren #"github.com/xulang-org/nexus/rendering/two_d"
scene_render #"github.com/xulang-org/nexus/integration/rendering/two_d"
image_render #"github.com/xulang-org/nexus/integration/image_render/two_d"
images #"github.com/xulang-org/nexus/assets/image"
fm #"github.com/xulang-org/nexus/foundation/math"
colors #"github.com/xulang-org/nexus/foundation/color"

// Returning without close exercises the owning field, including error unwinding.
fn window_scope() int {
    canvas_program_0 := canvas_shaders.load_canvas("build/canvas-shaders") >>>
    renderer := ren.open_2d("Standard canvas owning field", 64, 64, gpu.AUTO, &canvas_program_0) >>>
    renderer.backend() >>>
    << 0
}
fn texture_scope(renderer &ren.Renderer2D) int {
    $textures := []ren.Texture2D{}
    pixels := [4294967295]
    for i in 0:4 { texture := renderer.texture_rgba(1, 1, &pixels, false) >>>
        textures.push(texture) }
    << textures.len
}
fn run() int {
    for i in 0:12 { window_scope() >>> }
    canvas_program_1 := canvas_shaders.load_canvas("build/canvas-shaders") >>>
    $lifetime := ren.open_2d("Texture lifetime validation", 64, 64, gpu.AUTO, &canvas_program_1) >>>
    for i in 0:270 { assert((texture_scope(&lifetime) >>>) == 4) }
    lifetime.close() >>>
    image := images.load_png("build/png-fixtures/rgba.png") >>>
    canvas_program_2 := canvas_shaders.load_canvas("build/canvas-shaders") >>>
    $renderer := ren.open_2d("2D scene adapter validation", 128, 128, gpu.AUTO, &canvas_program_2) >>>
    $texture := image_render.upload_image_2d(&renderer, &image, false) >>>
    $tree := nexus.new_scene_tree("World", 8) >>>
    parent := tree.add_child(tree.root(), "Parent") >>>
    tree.set_position(parent, fm.vec2(8.0, 8.0)) >>>
    node := tree.add_child(parent, "Sprite") >>>
    tree.set_position(node, fm.vec2(8.0, 8.0)) >>>
    white := colors.rgba8(255, 255, 255, 255) >>>
    black := colors.rgba8(0, 0, 0, 255) >>>
    blue := colors.rgba8(0, 0, 255, 255) >>>
    sprite := scene_render.Sprite2D{node: node, bounds: fm.rect2(0.0, 0.0, 64.0, 64.0), region: fm.rect2(0.0, 0.0, 0.5, 0.5), tint: white}
    $canvas := scene_render.new_canvas_2d()
    canvas.add_rect(parent, fm.rect2(0.0, 0.0, 96.0, 96.0), blue) >>>
    $batch := ren_data.new_batch()
    $sprites := ren_data.new_batch()
    camera := fm.transform_2d(fm.vec2(4.0, 4.0), 0.0, fm.vec2(1.0, 1.0))
    canvas.record(&tree, camera, $&batch) >>>
    sprite.record(&tree, camera, $&sprites) >>>
    assert(batch.triangle_count() == 2 && sprites.triangle_count() == 2)
    renderer.begin(black) >>>
    renderer.submit(&batch) >>>
    renderer.submit_texture(&sprites, &texture) >>>
    assert((renderer.read_pixel(16, 16) >>>) == blue)
    assert((renderer.read_pixel(24, 24) >>>) == 4278190335)
    renderer.present() >>>
    tree.set_visible(parent, false) >>>
    batch.clear()
    sprites.clear()
    canvas.record(&tree, camera, $&batch) >>>
    sprite.record(&tree, camera, $&sprites) >>>
    assert(batch.vertex_count() == 0 && sprites.vertex_count() == 0)
    tree.set_visible(parent, true) >>>
    tree.paused = true
    sprite.record(&tree, camera, $&sprites) >>>
    assert(sprites.vertex_count() == 6)
    tree.queue_free(node) >>>
    tree.flush_free() >>>
    replacement := tree.add_child(parent, "Replacement") >>>
    assert(replacement != node)
    sprites.clear()
    sprite.record(&tree, camera, $&sprites) >>>
    assert(sprites.vertex_count() == 0)
    renderer.close() >>>
    texture.close() >>>
    println("PASS: 2D scene bridge transforms/visibility/pause/node generation; resource drop across 12 windows and 1080 textures")
    << 0
}
fn main() int { << run() >>> (err) { eprintln(err.msg())
    << 1 } }
