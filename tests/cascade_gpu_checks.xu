@main
#gpu
#os
fm #"github.com/xulang-org/nexus/foundation/math"
camera_data #"github.com/xulang-org/nexus/resources/camera"
policy #"github.com/xulang-org/nexus/resources/shadow"
mesh #"github.com/xulang-org/nexus/resources/mesh"
lights #"github.com/xulang-org/nexus/resources/lighting"
nexus #"github.com/xulang-org/nexus/scene"
ren #"github.com/xulang-org/nexus/rendering/three_d"
bridge #"github.com/xulang-org/nexus/integration/rendering/three_d"
shaders #"github.com/xulang-org/nexus/assets/shaders/three_d"

fn quad(size f64,receiver bool) mesh.MeshData3D {
    $data := mesh.new_mesh_data_3d()
    for xy in [fm.vec2(-size,-size),fm.vec2(size,-size),fm.vec2(size,size),fm.vec2(-size,size)] {
        $z := 0.0
        if receiver { z= -6.0+2.0*xy.x }
        data.vertex_lit(fm.vec3(xy.x,xy.y,z),4294967295,fm.vec3(0.0,0.0,1.0)) >>>
    }
    data.triangle(0,1,2) >>>
    data.triangle(0,2,3) >>>
    << data
}
fn capture(device $&ren.Device3D,scene &bridge.Scene3D,tree &nexus.SceneTree,vp fm.Mat4,env &lights.Environment3D,
    shadow &ren.ShadowMap3D,enabled bool,name string) string {
    device.begin(255) >>>
    if enabled { scene.draw_lit_shadowed(device,tree,vp,env,shadow,1) >>>
    } else { scene.draw_lit(device,tree,vp,env) >>> }
    path := "build/cascade-"+name+".png"
    device.capture(path+"") >>>
    device.present() >>>
    << os.read(path) >>>
}
fn rejected(scene &bridge.Scene3D,device $&ren.Device3D,tree &nexus.SceneTree,vp fm.Mat4,env &lights.Environment3D,shadow &ren.ShadowMap3D) bool {
    scene.draw_lit_shadowed(device,tree,vp,env,shadow,1) >>> (err){ assert(err.msg()=="nexus shadow: cascades belong to a different camera; refresh before drawing")
        << true }
    << false
}
fn rejected_direct(device $&ren.Device3D,receiver &ren.Mesh3D,vp fm.Mat4,material &ren.Material3D,env &lights.Environment3D,binding &ren.ShadowBinding3D) bool {
    device.draw_material_shadowed_reference(receiver.reference(),fm.identity_3d(),vp,material,env,binding) >>> (err){ assert(err.msg()=="nexus shadow: cascades belong to a different camera; refresh before drawing")
        << true }
    << false
}
fn failed_create(device &ren.Device3D,description policy.ShadowDescription3D,program &ren.ShadowProgram3D) bool {
    device.shadow_map(description,program) >>> (err){ << true }
    << false
}
fn failed_update(shadow $&ren.ShadowMap3D,device &ren.Device3D,description policy.ShadowDescription3D) bool {
    empty := []ren.ShadowCaster3D{}
    shadow.render(device,&empty,description) >>> (err){ << true }
    << false
}
fn run() int {
    program := shaders.load_mesh("build/mesh-shaders") >>>
    shadow_program := shaders.load_shadow("build/mesh-shaders") >>>
    $device := ren.open_3d("Cascade checks",128,96,gpu.METAL,&program) >>>
    projection := nexus.perspective_3d(0.8,1.0,1.0,40.0) >>>
    camera := policy.cascade_camera(fm.identity_3d(),projection) >>>
    source := lights.directional(fm.vec3(0.0,0.0,1.0),fm.vec3(3.0,3.0,3.0)) >>>
    distant := lights.point(fm.vec3(100.0,100.0,100.0),fm.vec3(1.0,1.0,1.0),1.0) >>>
    env := lights.environment(fm.vec3(0.08,0.08,0.08),fm.vec3(0.0,0.0,0.0),1.0,[distant,source]) >>>
    $settings := policy.default_cascades()
    settings.resolution=128
    settings.distance=30.0
    settings.blend_fraction=0.2
    settings.caster_padding=5.0
    data := quad(30.0,true) >>>
    small := quad(1.0,false) >>>
    $receiver := device.upload(&data) >>>
    $occluder := device.upload(&small) >>>
    $tree := nexus.new_scene_tree_3d("World",16) >>>
    node := tree.add_child_3d(tree.root(),"Receiver") >>>
    $scene := bridge.new_scene_3d(&device) >>>
    scene.attach_mesh(&tree,node,&receiver) >>>
    material := ren.material_3d(fm.vec3(0.6,0.6,0.6),0.0,0.8,fm.vec3(0.0,0.0,0.0)) >>>
    scene.set_material(&tree,node,material) >>>
    $casters := []ren.ShadowCaster3D{}
    centers := [fm.vec2(1.0,0.2),fm.vec2(0.3,-0.3),fm.vec2(-1.0,0.5),fm.vec2(-3.4,-0.7001),fm.vec2(-5.0,0.6),fm.vec2(-8.0004,-0.9),fm.vec2(-11.1969,0.2525)]
    for i in 0:centers.len {
        c := centers[i]
        $half_x := 0.6
        if i==6 { half_x=1.8 }
        world := fm.translation_3d(fm.vec3(c.x,c.y,-1.0+2.0*c.x)).multiply(fm.scale_3d(fm.vec3(half_x,2.5,1.0)))
        casters.push(ren.shadow_caster(occluder.reference(), world))
    }
    $maps := []ren.ShadowMap3D{}
    for count in [2,3,4] {
        settings.count=count
        description := policy.cascaded(source,camera,settings) >>>
        item := device.shadow_map(description,&shadow_program) >>>
        maps.push(item)
        index := maps.len-1
        shadow := $&maps[index]
        assert((shadow.render(&device,&casters,description) >>>)==count*14)
        lit := capture($&device,&scene,&tree,projection,&env,shadow,false,str(count)+"-lit") >>>
        dark := capture($&device,&scene,&tree,projection,&env,shadow,true,str(count)+"-shadow") >>>
        assert(lit!=dark)
    }
    shadow := $&maps[2]
    invalid_camera := policy.cascade_camera(fm.scale_3d(fm.vec3(10000000000.0,10000000000.0,10000000000.0)),projection) >>>
    invalid_description := policy.cascaded(source,invalid_camera,settings) >>>
    assert(failed_create(&device,invalid_description,&shadow_program))
    assert(failed_update(shadow,&device,invalid_description))
    saved := os.read("build/cascade-4-shadow.png") >>>
    unchanged := capture($&device,&scene,&tree,projection,&env,shadow,true,"after-invalid") >>>
    assert(saved==unchanged)
    moved_view := fm.translation_3d(fm.vec3(-0.25,0.0,0.0))
    moved_vp := projection.multiply(moved_view)
    moved_camera := policy.cascade_camera(moved_view,projection) >>>
    moved_env := lights.environment(fm.vec3(0.08,0.08,0.08),fm.vec3(0.25,0.0,0.0),1.0,[distant,source]) >>>
    device.begin(255) >>>
    assert(rejected(&scene,$&device,&tree,moved_vp,&moved_env,shadow))
    binding := shadow.binding(&env,1) >>>
    assert(rejected_direct($&device,&receiver,moved_vp,&material,&moved_env,&binding))
    scene.draw_lit_shadowed($&device,&tree,projection,&env,shadow,1) >>>
    device.present() >>>
    moved_description := policy.cascaded(source,moved_camera,settings) >>>
    shadow.render(&device,&casters,moved_description) >>>
    capture($&device,&scene,&tree,moved_vp,&moved_env,shadow,false,"moved-lit") >>>
    capture($&device,&scene,&tree,moved_vp,&moved_env,shadow,true,"moved-shadow") >>>
    settings.blend_fraction=0.0
    hard := policy.cascaded(source,camera,settings) >>>
    shadow.render(&device,&casters,hard) >>>
    capture($&device,&scene,&tree,projection,&env,shadow,false,"hard-lit") >>>
    capture($&device,&scene,&tree,projection,&env,shadow,true,"hard-shadow") >>>
    settings.blend_fraction=0.2
    description := policy.cascaded(source,camera,settings) >>>
    self_casters := scene.shadow_casters(&tree) >>>
    shadow.render(&device,&self_casters,description) >>>
    self := capture($&device,&scene,&tree,projection,&env,shadow,true,"plane-self") >>>
    control := capture($&device,&scene,&tree,projection,&env,shadow,false,"plane-control") >>>
    assert(self==control)
    empty := []ren.ShadowCaster3D{}
    shadow.render(&device,&empty,description) >>>
    cleared := capture($&device,&scene,&tree,projection,&env,shadow,true,"empty") >>>
    assert(cleared==control)
    // A camera node's parent transform must participate in cascade fitting.
    parent := tree.add_child_3d(tree.root(),"CameraParent") >>>
    tree.set_transform_3d(parent,fm.translation_3d(fm.vec3(0.25,0.0,0.0))) >>>
    camera_node := tree.add_child_3d(parent,"Camera") >>>
    $lens := nexus.new_camera_node_3d(&tree,camera_node) >>>
    lens.vertical_fov=0.8
    lens.near=1.0
    lens.far=40.0
    adapted := bridge.cascade_node_camera(&lens,&tree,1.0) >>>
    assert((policy.cascaded(source,adapted,settings) >>>).matches_camera(moved_vp))

    // Reuse the same atlas layouts with a scene-attached orthographic lens.
    ortho_aspect := 15.5 / 5.0
    tree.set_orthographic_camera_3d(camera_node, camera_data.orthographic(10.0, 0.0, 40.0) >>>) >>>
    tree.set_position_3d(parent, fm.vec3(0.0, 0.0, 0.0)) >>>
    ortho_camera := bridge.cascade_scene_camera(&tree, camera_node, ortho_aspect) >>>
    ortho_vp := tree.camera_view_projection_3d(camera_node, ortho_aspect) >>>
    for count in [2, 3, 4] {
        settings.count = count
        ortho_description := policy.cascaded(source, ortho_camera, settings) >>>
        assert(ortho_description.matches_camera(ortho_vp))
        index := count - 2
        item := $&maps[index]
        assert((item.render(&device, &casters, ortho_description) >>>) == count * 14)
        name := "ortho-" + str(count)
        plain := capture($&device, &scene, &tree, ortho_vp, &env, item, false, name + "-lit") >>>
        shaded := capture($&device, &scene, &tree, ortho_vp, &env, item, true, name + "-shadow") >>>
        assert(plain != shaded)
    }
    tree.set_position_3d(parent, fm.vec3(0.25, 0.0, 0.0)) >>>
    ortho_moved := bridge.cascade_scene_camera(&tree, camera_node, ortho_aspect) >>>
    ortho_moved_vp := tree.camera_view_projection_3d(camera_node, ortho_aspect) >>>
    item := $&maps[2]
    device.begin(255) >>>
    assert(rejected(&scene, $&device, &tree, ortho_moved_vp, &moved_env, item))
    device.present() >>>
    ortho_updated := policy.cascaded(source, ortho_moved, settings) >>>
    item.render(&device, &casters, ortho_updated) >>>
    capture($&device, &scene, &tree, ortho_moved_vp, &moved_env, item, false, "ortho-moved-lit") >>>
    capture($&device, &scene, &tree, ortho_moved_vp, &moved_env, item, true, "ortho-moved-shadow") >>>
    item.render(&device, &self_casters, ortho_updated) >>>
    ortho_self := capture($&device, &scene, &tree, ortho_moved_vp, &moved_env, item, true, "ortho-plane-self") >>>
    ortho_control := capture($&device, &scene, &tree, ortho_moved_vp, &moved_env, item, false, "ortho-plane-control") >>>
    assert(ortho_self == ortho_control)

    settings.resolution=1024
    huge := policy.cascaded(source,camera,settings) >>>
    assert(failed_create(&device,huge,&shadow_program))
    for i in 0:maps.len { item := $&maps[i]
        item.close() >>> }
    $recovered := device.shadow_map(huge,&shadow_program) >>>
    recovered.close() >>>
    receiver.close() >>>
    occluder.close() >>>
    device.close() >>>
    println("PASS: actual perspective/orthographic 2/3/4 CSM, overlap and far fade, camera refresh/stale rejection, parented camera adapter, sloped self projection, clear and 64 MiB map budget recovery")
    << 0
}
fn main() int { << run() >>> (err){ eprintln(err.msg())
    << 1 } }
