@main
controls #"github.com/xulang-org/nexus/input"
bridge #"github.com/xulang-org/nexus/integration/input"
frames #"github.com/xulang-org/nexus/integration/frame"
fm #"github.com/xulang-org/nexus/foundation/math"
events #window/events
fn touch_event(kind int) events.Event {
    $event := events.empty()
    event.kind = kind
    event.device_id = -1
    event.touch_id = 0
    event.x = 80.0
    event.y = 50.0
    << event
}
fn run() int {
    $input := controls.new_input_map()
    names := ["left", "right", "up", "down"]
    for i in 0:4 { input.bind_source(names[i] + "", i) >>> }
    $touch := bridge.new_touch_controls(fm.vec2(50.0, 50.0), 40.0, 0.1, 0) >>>
    $loop := frames.new_frame_loop(60, 8) >>>
    assert(!(loop.begin_frame($&input, $&touch, 1000000000, 0) >>>))
    down := touch_event(events.EVENT_TOUCH_DOWN)
    loop.feed($&input, $&touch, &down) >>>
    assert(input.pressed("right") >>>)
    first := loop.finish_frame(false) >>>
    assert(first.steps == 0)
    loop.begin_frame($&input, $&touch, 1016666667, 0) >>>
    tick := loop.finish_frame(false) >>>
    assert(tick.steps == 1)
    // Background time must neither catch up nor resurrect an active finger.
    assert(loop.begin_frame($&input, $&touch, 91000000000, 1) >>>)
    assert(!(input.pressed("right") >>>))
    stale := touch_event(events.EVENT_TOUCH_MOVE)
    loop.feed($&input, $&touch, &stale) >>>
    assert(!(input.pressed("right") >>>))
    resumed := loop.finish_frame(false) >>>
    assert(resumed.steps == 0 && resumed.dropped_seconds == 0.0)
    loop.begin_frame($&input, $&touch, 91016666667, 1) >>>
    loop.feed($&input, $&touch, &down) >>>
    reset := touch_event(events.EVENT_INPUT_RESET)
    loop.feed($&input, $&touch, &reset) >>>
    assert(!(input.just_pressed("right") >>>))
    cleared := loop.finish_frame(false) >>>
    assert(cleared.steps == 0)
    loop.begin_frame($&input, $&touch, 91033333334, 1) >>>
    paused := loop.finish_frame(true) >>>
    assert(paused.steps == 0)
    loop.begin_frame($&input, $&touch, 100000000000, 1) >>>
    unpaused := loop.finish_frame(false) >>>
    assert(unpaused.steps == 0)
    loop.begin_frame($&input, $&touch, 100016666667, 1) >>>
    next := loop.finish_frame(false) >>>
    assert(next.steps == 1)
    loop.begin_frame($&input, $&touch, 100033333334, 1) >>>
    close := touch_event(events.EVENT_CLOSE_REQUESTED)
    loop.feed($&input, $&touch, &close) >>>
    assert(!loop.running())
    ended := loop.finish_frame(false) >>>
    assert(ended.steps == 0)
    println("frame loop: fixed ticks, resume/input reset, pause transitions and close PASS")
    << 0
}
fn main() int { << run() >>> (err) { eprintln(err.msg())
    << 1 } }
