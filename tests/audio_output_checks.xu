@main

music #"github.com/xulang-org/nexus/integration/audio_stream"
audio #"github.com/xulang-org/nexus/audio"
mix #"github.com/xulang-org/nexus/audio/mixer"
pcm #"github.com/xulang-org/nexus/resources/audio"
driver #"github.com/xulang-org/nexus/platform/sdl_audio"
#os

fn rejected(output &audio.Output, samples &[]int) bool { output.submit(samples) >>> (err) { << true }
    << false }
fn pump_rejected(output &audio.Output, mixer $&mix.Mixer) bool { audio.pump(output, mixer, 2048, 512) >>> (err) { << true }
    << false }
fn scope() int { output := audio.open_output(48000) >>>
    assert((output.queued_frames() >>>) == 0)
    << 0 }
fn run() int {
    args := os.args()
    if args.len == 2 {
        audio.open_output(48000) >>> (err) { println("PASS: unavailable audio runtime/driver fails explicitly")
            << 0 }
        << 1
    }
    for i in 0:12 { scope() >>> }
    $output := audio.open_output(48000) >>>
    assert((output.driver_name() >>>) == "dummy")
    $mixer := mix.new_mixer(48000, 2) >>>
    source := pcm.pcm16(48000, 1, [1000, -1000]) >>>
    clip := mixer.add_clip(source) >>>
    voice := mixer.play(clip, 0, 1.0, 0.0, true) >>>
    pending := mixer.prepare(4) >>>
    invalid := [40000, 0]
    assert(rejected(&output, &invalid) && (mixer.position_frames(voice) >>>) == 0.0)
    assert((output.submit(&pending.samples) >>>) == 4)
    mixer.commit(&pending) >>>
    assert((output.queued_frames() >>>) == 4)
    output.clear() >>>
    assert((output.queued_frames() >>>) == 0)
    report := audio.pump(&output, $&mixer, 2048, 512) >>>
    assert(report.blocks == 4 && report.submitted_frames == 2048 && report.queued_frames == 2048)
    output.clear() >>>
    block := mixer.prepare(4096) >>>
    for i in 0:5 { output.submit(&block.samples) >>> }
    tail := mixer.prepare(3520) >>>
    output.submit(&tail.samples) >>>
    assert((output.queued_frames() >>>) == audio.MAX_QUEUED_FRAMES)
    assert(rejected(&output, &block.samples) && (output.queued_frames() >>>) == audio.MAX_QUEUED_FRAMES)
    output.pause(false) >>>
    deadline := now_ns() + 1000000000
    $consumed := false
    while now_ns() < deadline {
        if (output.queued_frames() >>>) < audio.MAX_QUEUED_FRAMES { consumed = true
            <- }
        sleep_ns(10000000)
    }
    assert(consumed)
    output.pause(true) >>>
    output.clear() >>>
    // Source seek does not silently clear already submitted shared output.
    $track := music.open($&mixer, "build/audio-fixtures/pcm16.wav", 4, false) >>>
    track.refill($&mixer, 4) >>>
    music_voice := mixer.play_stream(track.source_id(), 0, 1.0, 0.0) >>>
    audio.pump(&output, $&mixer, 4, 4) >>>
    assert((output.queued_frames() >>>) == 4)
    track.seek_frames($&mixer, 1) >>>
    assert((output.queued_frames() >>>) == 4 && (mixer.position_frames(music_voice) >>>) == 0.0)
    unchanged_queue := audio.pump(&output, $&mixer, 4, 4) >>>
    assert(unchanged_queue.submitted_frames == 0)
    output.clear() >>>
    audio.pump(&output, $&mixer, 2, 2) >>>
    assert((mixer.position_frames(music_voice) >>>) == 1.0)
    track.close($&mixer) >>>
    output.clear() >>>
    before := mixer.position_frames(voice) >>>
    output.close() >>>
    output.close() >>>
    assert(pump_rejected(&output, $&mixer) && (mixer.position_frames(voice) >>>) == before)
    old := driver.raw_open(48000)
    assert(old > 0 && driver.raw_close(old) == 0)
    fresh := driver.raw_open(48000)
    assert(fresh != old && driver.raw_queued(old) < 0 && driver.raw_close(old) < 0 && driver.raw_queued(fresh) == 0)
    assert(driver.raw_close(fresh) == 0)
    println("PASS: independent audio device queue/pause/resume/clear/budget, failure cursor preservation, generation reuse and 12 automatic closes")
    << 0
}
fn main() int { << run() >>> (err) { eprintln(err.msg())
    << 1 } }
