@main

music #"github.com/xulang-org/nexus/integration/audio_stream"
audio #"github.com/xulang-org/nexus/audio"
mix #"github.com/xulang-org/nexus/audio/mixer"
pcm #"github.com/xulang-org/nexus/resources/audio"
driver #"github.com/xulang-org/nexus/platform/sdl_audio"
#os

fn rejected(output &audio.Output, samples &[]int) bool { output.submit(samples) or (err) { << true }
    << false }
fn pump_rejected(output &audio.Output, mixer $&mix.Mixer) bool { audio.pump(output, mixer, 2048, 512) or (err) { << true }
    << false }
fn scope() int { output := audio.open_output(48000) or >>
    assert((output.queued_frames() or >>) == 0)
    << 0 }
fn run() int {
    args := os.args()
    if args.len == 2 {
        audio.open_output(48000) or (err) { println("PASS: unavailable audio runtime/driver fails explicitly")
            << 0 }
        << 1
    }
    for i in 0:12 { scope() or >> }
    $output := audio.open_output(48000) or >>
    assert((output.driver_name() or >>) == "dummy")
    $mixer := mix.new_mixer(48000, 2) or >>
    source := pcm.pcm16(48000, 1, [1000, -1000]) or >>
    clip := mixer.add_clip(source) or >>
    voice := mixer.play(clip, 0, 1.0, 0.0, true) or >>
    pending := mixer.prepare(4) or >>
    invalid := [40000, 0]
    assert(rejected(&output, &invalid) && (mixer.position_frames(voice) or >>) == 0.0)
    assert((output.submit(&pending.samples) or >>) == 4)
    mixer.commit(&pending) or >>
    assert((output.queued_frames() or >>) == 4)
    output.clear() or >>
    assert((output.queued_frames() or >>) == 0)
    report := audio.pump(&output, $&mixer, 2048, 512) or >>
    assert(report.blocks == 4 && report.submitted_frames == 2048 && report.queued_frames == 2048)
    output.clear() or >>
    block := mixer.prepare(4096) or >>
    for i in 0:5 { output.submit(&block.samples) or >> }
    tail := mixer.prepare(3520) or >>
    output.submit(&tail.samples) or >>
    assert((output.queued_frames() or >>) == audio.MAX_QUEUED_FRAMES)
    assert(rejected(&output, &block.samples) && (output.queued_frames() or >>) == audio.MAX_QUEUED_FRAMES)
    output.pause(false) or >>
    deadline := now_ns() + 1000000000
    $consumed := false
    while now_ns() < deadline {
        if (output.queued_frames() or >>) < audio.MAX_QUEUED_FRAMES { consumed = true
            <- }
        sleep_ns(10000000)
    }
    assert(consumed)
    output.pause(true) or >>
    output.clear() or >>
    // Source seek does not silently clear already submitted shared output.
    $track := music.open($&mixer, "build/audio-fixtures/pcm16.wav", 4, false) or >>
    track.refill($&mixer, 4) or >>
    music_voice := mixer.play_stream(track.source_id(), 0, 1.0, 0.0) or >>
    audio.pump(&output, $&mixer, 4, 4) or >>
    assert((output.queued_frames() or >>) == 4)
    track.seek_frames($&mixer, 1) or >>
    assert((output.queued_frames() or >>) == 4 && (mixer.position_frames(music_voice) or >>) == 0.0)
    unchanged_queue := audio.pump(&output, $&mixer, 4, 4) or >>
    assert(unchanged_queue.submitted_frames == 0)
    output.clear() or >>
    audio.pump(&output, $&mixer, 2, 2) or >>
    assert((mixer.position_frames(music_voice) or >>) == 1.0)
    track.close($&mixer) or >>
    output.clear() or >>
    before := mixer.position_frames(voice) or >>
    output.close() or >>
    output.close() or >>
    assert(pump_rejected(&output, $&mixer) && (mixer.position_frames(voice) or >>) == before)
    old := driver.raw_open(48000)
    assert(old > 0 && driver.raw_close(old) == 0)
    fresh := driver.raw_open(48000)
    assert(fresh != old && driver.raw_queued(old) < 0 && driver.raw_close(old) < 0 && driver.raw_queued(fresh) == 0)
    assert(driver.raw_close(fresh) == 0)
    println("PASS: independent audio device queue/pause/resume/clear/budget, failure cursor preservation, generation reuse and 12 automatic closes")
    << 0
}
fn main() int { << run() or (err) { eprintln(err.msg())
    << 1 } }
