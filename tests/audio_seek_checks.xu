@main

mix #"github.com/xulang-org/nexus/audio/mixer"
pcm #"github.com/xulang-org/nexus/resources/audio"
music #"github.com/xulang-org/nexus/integration/audio_stream"
#os
#math

fn close(a f64, b f64) bool { << math.abs(a - b) < 0.000000001 }
fn rejected(mixer $&mix.Mixer, voice int, frame int) bool { mixer.seek_voice(voice, frame) or (err) { << true }
    << false }
fn stream_rejected(stream $&music.MusicStream, mixer $&mix.Mixer, frame int) bool { stream.seek_frames(mixer, frame) or (err) { << true }
    << false }
fn restart_rejected(stream $&music.MusicStream, mixer $&mix.Mixer) bool { stream.restart(mixer) or (err) { << true }
    << false }
fn time_rejected(stream $&music.MusicStream, mixer $&mix.Mixer) bool { stream.seek_seconds(mixer, math.sqrt(-1.0)) or (err) { << true }
    << false }
fn stale(mixer $&mix.Mixer, block &mix.MixBlock) bool { mixer.commit(block) or (err) { << true }
    << false }
fn run() int {
    $mixer := mix.new_mixer(48000, 8) or >>
    data := pcm.pcm16(24000, 1, [1000, 2000, 3000, 4000]) or >>
    clip := mixer.add_clip(data) or >>
    voice := mixer.play(clip, 0, 1.0, 0.0, false) or >>
    mixer.render(1) or >>
    mixer.fade_volume(voice, 0.0, 4, true) or >>
    mixer.render(2) or >>
    assert((mixer.volume(voice) or >>) == 0.5)
    old := mixer.prepare(2) or >>
    assert((mixer.seek_voice(voice, 2) or >>) == 2 && mixer.is_voice(voice) && stale($&mixer, &old))
    sought := mixer.render(2) or >>
    assert(sought[0] == 1500 && sought[2] == 1750 && (mixer.is_playing(voice) or >>))
    mixer.render(2) or >>
    assert(!(mixer.is_playing(voice) or >>))
    mixer.seek_voice(voice, 1) or >>
    stopped := mixer.render(1) or >>
    assert(stopped[0] == 0 && (mixer.position_frames(voice) or >>) == 1.0)
    mixer.restart_voice(voice) or >>
    first := mixer.render(1) or >>
    assert(first[0] == 500)
    mixer.pause_voice(voice, true) or >>
    assert((mixer.seek_voice_seconds(voice, 2.0 / 24000.0) or >>) == 2)
    paused := mixer.render(1) or >>
    assert(paused[0] == 0 && (mixer.position_frames(voice) or >>) == 2.0)
    mixer.pause_voice(voice, false) or >>
    after := mixer.render(1) or >>
    assert(after[0] == 1500)
    unchanged := mixer.prepare(1) or >>
    assert(rejected($&mixer, voice, 99))
    mixer.commit(&unchanged) or >>
    mixer.stop(voice) or >>
    // An in-flight ramp may be between control quantization steps. Transport
    // must retain that exact gain, rather than re-rounding it to 0.001.
    fractional := mixer.play(clip, 0, 1.0, 0.0, true) or >>
    mixer.fade_volume(fractional, 0.0, 3, true) or >>
    mixer.render(1) or >>
    exact := mixer.volume(fractional) or >>
    mixer.seek_voice(fractional, 1) or >>
    assert((mixer.volume(fractional) or >>) == exact)
    held := mixer.render(1) or >>
    assert(held[0] == 1333 && (mixer.volume(fractional) or >>) == exact)
    mixer.stop(fractional) or >>
    // Cached loops rebase the source timeline without changing the voice ID.
    $cached := music.open($&mixer, "build/audio-fixtures/order.wav", 4, true) or >>
    cached.refill($&mixer, 4) or >>
    cv := mixer.play_stream(cached.source_id(), 0, 1.0, 0.0) or >>
    mixer.render(1) or >>
    assert(close(cached.position_seconds(&mixer) or >>, 0.5 / 24000.0))
    previous := mixer.prepare(2) or >>
    assert((cached.seek_frames($&mixer, 1) or >>) == 1 && stale($&mixer, &previous))
    assert(mixer.is_voice(cv) && close(cached.position_seconds(&mixer) or >>, 1.0 / 24000.0))
    step := mixer.render(1) or >>
    assert(step[0] == 200 && close(cached.position_seconds(&mixer) or >>, 1.5 / 24000.0))
    assert(rejected($&mixer, cv, 0))
    mixer.pause_voice(cv, true) or >>
    cached.restart($&mixer) or >>
    still_paused := mixer.render(2) or >>
    assert(still_paused[0] == 0 && (cached.position_seconds(&mixer) or >>) == 0.0)
    mixer.pause_voice(cv, false) or >>
    assert((cached.seek_seconds($&mixer, cached.duration_seconds()) or >>) == 0)
    cached.close($&mixer) or >>
    // Seeking EOF stops immediately; seeking back does not implicitly resume.
    $file := music.open($&mixer, "build/audio-fixtures/pcm16.wav", 4, false) or >>
    file.refill($&mixer, 4) or >>
    fv := mixer.play_stream(file.source_id(), 0, 1.0, 0.0) or >>
    mixer.render(6) or >>
    assert(!(mixer.is_playing(fv) or >>))
    file.seek_frames($&mixer, 1) or >>
    assert(!(mixer.is_playing(fv) or >>))
    file.restart($&mixer) or >>
    assert((mixer.is_playing(fv) or >>))
    replay := mixer.render(1) or >>
    assert(replay[0] == -32768)
    file.seek_frames($&mixer, 3) or >>
    assert(!(mixer.is_playing(fv) or >>) && close(file.position_seconds(&mixer) or >>, file.duration_seconds()))
    file.restart($&mixer) or >>
    assert(mixer.is_voice(fv))
    stable := mixer.prepare(1) or >>
    assert(time_rejected($&file, $&mixer) && stream_rejected($&file, $&mixer, -1))
    mixer.commit(&stable) or >>
    file.close($&mixer) or >>
    assert(stream_rejected($&file, $&mixer, 0))
    // A source has no restartable voice before first play; rejection is atomic.
    $unplayed := music.open($&mixer, "build/audio-fixtures/pcm16.wav", 4, false) or >>
    unplayed.refill($&mixer, 1) or >>
    empty_voice := mixer.prepare(1) or >>
    assert(restart_rejected($&unplayed, $&mixer) && unplayed.read_position() == 1)
    mixer.commit(&empty_voice) or >>
    unplayed.close($&mixer) or >>
    // Random seek near the far end primes only a bounded window.
    $large := music.open($&mixer, "build/audio-fixtures/large.wav", 2, false) or >>
    large.seek_frames($&mixer, 11999998) or >>
    lv := mixer.play_stream(large.source_id(), 0, 1.0, 0.0) or >>
    end := mixer.render(1) or >>
    assert(end[0] == 1000 && end[1] == -1000)
    assert(close(large.position_seconds(&mixer) or >>, 11999999.0 / 48000.0))
    for i in 0:100 {
        large.seek_frames($&mixer, 0) or >>
        beginning := mixer.render(1) or >>
        assert(beginning[0] == 11 && mixer.is_voice(lv))
        large.seek_frames($&mixer, 11999998) or >>
        ending := mixer.render(1) or >>
        assert(ending[0] == 1000 && ending[1] == -1000)
    }
    large.close($&mixer) or >>
    // An unrelated voice may reuse an ended consumer slot; the source retains
    // its committed position and restart must not control that unrelated voice.
    $retained := music.open($&mixer, "build/audio-fixtures/pcm16.wav", 4, false) or >>
    retained.refill($&mixer, 4) or >>
    retired_voice := mixer.play_stream(retained.source_id(), 0, 1.0, 0.0) or >>
    mixer.render(6) or >>
    unrelated := mixer.play(clip, 0, 1.0, 0.0, true) or >>
    assert(!mixer.is_voice(retired_voice))
    assert(close(retained.position_seconds(&mixer) or >>, retained.duration_seconds()))
    assert(restart_rejected($&retained, $&mixer) && (mixer.is_playing(unrelated) or >>))
    retained.close($&mixer) or >>
    assert((mixer.is_playing(unrelated) or >>))
    mixer.stop(unrelated) or >>
    // A failed read preserves buffered PCM, position, envelopes and old receipts.
    raw := os.read("build/audio-fixtures/pcm16.wav") or >>
    write_file("build/audio-fixtures/seek-live.wav", raw + "") or >>
    $live := music.open($&mixer, "build/audio-fixtures/seek-live.wav", 4, false) or >>
    live.refill($&mixer, 4) or >>
    pv := mixer.play_stream(live.source_id(), 0, 1.0, 0.0) or >>
    mixer.render(1) or >>
    mixer.fade_volume(pv, 0.0, 4, true) or >>
    receipt := mixer.prepare(1) or >>
    position := live.position_seconds(&mixer) or >>
    write_file("build/audio-fixtures/seek-live.wav", "truncated") or >>
    assert(stream_rejected($&live, $&mixer, 2))
    assert((live.position_seconds(&mixer) or >>) == position && live.read_position() == 3 && (mixer.volume(pv) or >>) == 1.0)
    mixer.commit(&receipt) or >>
    write_file("build/audio-fixtures/seek-live.wav", raw + "") or >>
    live.seek_frames($&mixer, 2) or >>
    recovered := mixer.render(1) or >>
    assert(recovered[0] == 24575 && (mixer.volume(pv) or >>) == 0.75)
    live.close($&mixer) or >>
    // Equal-length corrupt PCM fails before discarding the previous valid ring.
    floats := os.read("build/audio-fixtures/float.wav") or >>
    write_file("build/audio-fixtures/seek-float.wav", floats + "") or >>
    $bad := music.open($&mixer, "build/audio-fixtures/seek-float.wav", 4, false) or >>
    bad.refill($&mixer, 4) or >>
    bv := mixer.play_stream(bad.source_id(), 0, 1.0, 0.0) or >>
    corrupt := floats[0:44] + string_from_byte(0) + string_from_byte(0) + string_from_byte(192) + string_from_byte(127) + floats[48:floats.len]
    write_file("build/audio-fixtures/seek-float.wav", corrupt) or >>
    same := mixer.prepare(1) or >>
    assert(stream_rejected($&bad, $&mixer, 0))
    mixer.commit(&same) or >>
    assert((mixer.position_frames(bv) or >>) == 0.5)
    bad.close($&mixer) or >>
    println("PASS: clip/stream seek and restart, stable voices, pause/EOF, fade cancellation, bounded 48 MB random seek, 100 resets and failure atomicity")
    << 0
}
fn main() int { << run() or (err) { eprintln(err.msg())
    << 1 } }
