@main

mix #"github.com/xulang-org/nexus/audio/mixer"
pcm #"github.com/xulang-org/nexus/resources/audio"
music #"github.com/xulang-org/nexus/integration/audio_stream"
#os
#math

fn close(a f64, b f64) bool { << math.abs(a - b) < 0.000000001 }
fn rejected(mixer $&mix.Mixer, voice int, frame int) bool { mixer.seek_voice(voice, frame) >>> (err) { << true }
    << false }
fn stream_rejected(stream $&music.MusicStream, mixer $&mix.Mixer, frame int) bool { stream.seek_frames(mixer, frame) >>> (err) { << true }
    << false }
fn restart_rejected(stream $&music.MusicStream, mixer $&mix.Mixer) bool { stream.restart(mixer) >>> (err) { << true }
    << false }
fn time_rejected(stream $&music.MusicStream, mixer $&mix.Mixer) bool { stream.seek_seconds(mixer, math.sqrt(-1.0)) >>> (err) { << true }
    << false }
fn stale(mixer $&mix.Mixer, block &mix.MixBlock) bool { mixer.commit(block) >>> (err) { << true }
    << false }
fn run() int {
    $mixer := mix.new_mixer(48000, 8) >>>
    data := pcm.pcm16(24000, 1, [1000, 2000, 3000, 4000]) >>>
    clip := mixer.add_clip(data) >>>
    voice := mixer.play(clip, 0, 1.0, 0.0, false) >>>
    mixer.render(1) >>>
    mixer.fade_volume(voice, 0.0, 4, true) >>>
    mixer.render(2) >>>
    assert((mixer.volume(voice) >>>) == 0.5)
    old := mixer.prepare(2) >>>
    assert((mixer.seek_voice(voice, 2) >>>) == 2 && mixer.is_voice(voice) && stale($&mixer, &old))
    sought := mixer.render(2) >>>
    assert(sought[0] == 1500 && sought[2] == 1750 && (mixer.is_playing(voice) >>>))
    mixer.render(2) >>>
    assert(!(mixer.is_playing(voice) >>>))
    mixer.seek_voice(voice, 1) >>>
    stopped := mixer.render(1) >>>
    assert(stopped[0] == 0 && (mixer.position_frames(voice) >>>) == 1.0)
    mixer.restart_voice(voice) >>>
    first := mixer.render(1) >>>
    assert(first[0] == 500)
    mixer.pause_voice(voice, true) >>>
    assert((mixer.seek_voice_seconds(voice, 2.0 / 24000.0) >>>) == 2)
    paused := mixer.render(1) >>>
    assert(paused[0] == 0 && (mixer.position_frames(voice) >>>) == 2.0)
    mixer.pause_voice(voice, false) >>>
    after := mixer.render(1) >>>
    assert(after[0] == 1500)
    unchanged := mixer.prepare(1) >>>
    assert(rejected($&mixer, voice, 99))
    mixer.commit(&unchanged) >>>
    mixer.stop(voice) >>>
    // An in-flight ramp may be between control quantization steps. Transport
    // must retain that exact gain, rather than re-rounding it to 0.001.
    fractional := mixer.play(clip, 0, 1.0, 0.0, true) >>>
    mixer.fade_volume(fractional, 0.0, 3, true) >>>
    mixer.render(1) >>>
    exact := mixer.volume(fractional) >>>
    mixer.seek_voice(fractional, 1) >>>
    assert((mixer.volume(fractional) >>>) == exact)
    held := mixer.render(1) >>>
    assert(held[0] == 1333 && (mixer.volume(fractional) >>>) == exact)
    mixer.stop(fractional) >>>
    // Cached loops rebase the source timeline without changing the voice ID.
    $cached := music.open($&mixer, "build/audio-fixtures/order.wav", 4, true) >>>
    cached.refill($&mixer, 4) >>>
    cv := mixer.play_stream(cached.source_id(), 0, 1.0, 0.0) >>>
    mixer.render(1) >>>
    assert(close(cached.position_seconds(&mixer) >>>, 0.5 / 24000.0))
    previous := mixer.prepare(2) >>>
    assert((cached.seek_frames($&mixer, 1) >>>) == 1 && stale($&mixer, &previous))
    assert(mixer.is_voice(cv) && close(cached.position_seconds(&mixer) >>>, 1.0 / 24000.0))
    step := mixer.render(1) >>>
    assert(step[0] == 200 && close(cached.position_seconds(&mixer) >>>, 1.5 / 24000.0))
    assert(rejected($&mixer, cv, 0))
    mixer.pause_voice(cv, true) >>>
    cached.restart($&mixer) >>>
    still_paused := mixer.render(2) >>>
    assert(still_paused[0] == 0 && (cached.position_seconds(&mixer) >>>) == 0.0)
    mixer.pause_voice(cv, false) >>>
    assert((cached.seek_seconds($&mixer, cached.duration_seconds()) >>>) == 0)
    cached.close($&mixer) >>>
    // Seeking EOF stops immediately; seeking back does not implicitly resume.
    $file := music.open($&mixer, "build/audio-fixtures/pcm16.wav", 4, false) >>>
    file.refill($&mixer, 4) >>>
    fv := mixer.play_stream(file.source_id(), 0, 1.0, 0.0) >>>
    mixer.render(6) >>>
    assert(!(mixer.is_playing(fv) >>>))
    file.seek_frames($&mixer, 1) >>>
    assert(!(mixer.is_playing(fv) >>>))
    file.restart($&mixer) >>>
    assert((mixer.is_playing(fv) >>>))
    replay := mixer.render(1) >>>
    assert(replay[0] == -32768)
    file.seek_frames($&mixer, 3) >>>
    assert(!(mixer.is_playing(fv) >>>) && close(file.position_seconds(&mixer) >>>, file.duration_seconds()))
    file.restart($&mixer) >>>
    assert(mixer.is_voice(fv))
    stable := mixer.prepare(1) >>>
    assert(time_rejected($&file, $&mixer) && stream_rejected($&file, $&mixer, -1))
    mixer.commit(&stable) >>>
    file.close($&mixer) >>>
    assert(stream_rejected($&file, $&mixer, 0))
    // A source has no restartable voice before first play; rejection is atomic.
    $unplayed := music.open($&mixer, "build/audio-fixtures/pcm16.wav", 4, false) >>>
    unplayed.refill($&mixer, 1) >>>
    empty_voice := mixer.prepare(1) >>>
    assert(restart_rejected($&unplayed, $&mixer) && unplayed.read_position() == 1)
    mixer.commit(&empty_voice) >>>
    unplayed.close($&mixer) >>>
    // Random seek near the far end primes only a bounded window.
    $large := music.open($&mixer, "build/audio-fixtures/large.wav", 2, false) >>>
    large.seek_frames($&mixer, 11999998) >>>
    lv := mixer.play_stream(large.source_id(), 0, 1.0, 0.0) >>>
    end := mixer.render(1) >>>
    assert(end[0] == 1000 && end[1] == -1000)
    assert(close(large.position_seconds(&mixer) >>>, 11999999.0 / 48000.0))
    for i in 0:100 {
        large.seek_frames($&mixer, 0) >>>
        beginning := mixer.render(1) >>>
        assert(beginning[0] == 11 && mixer.is_voice(lv))
        large.seek_frames($&mixer, 11999998) >>>
        ending := mixer.render(1) >>>
        assert(ending[0] == 1000 && ending[1] == -1000)
    }
    large.close($&mixer) >>>
    // An unrelated voice may reuse an ended consumer slot; the source retains
    // its committed position and restart must not control that unrelated voice.
    $retained := music.open($&mixer, "build/audio-fixtures/pcm16.wav", 4, false) >>>
    retained.refill($&mixer, 4) >>>
    retired_voice := mixer.play_stream(retained.source_id(), 0, 1.0, 0.0) >>>
    mixer.render(6) >>>
    unrelated := mixer.play(clip, 0, 1.0, 0.0, true) >>>
    assert(!mixer.is_voice(retired_voice))
    assert(close(retained.position_seconds(&mixer) >>>, retained.duration_seconds()))
    assert(restart_rejected($&retained, $&mixer) && (mixer.is_playing(unrelated) >>>))
    retained.close($&mixer) >>>
    assert((mixer.is_playing(unrelated) >>>))
    mixer.stop(unrelated) >>>
    // A failed read preserves buffered PCM, position, envelopes and old receipts.
    raw := os.read("build/audio-fixtures/pcm16.wav") >>>
    write_file("build/audio-fixtures/seek-live.wav", raw + "") >>>
    $live := music.open($&mixer, "build/audio-fixtures/seek-live.wav", 4, false) >>>
    live.refill($&mixer, 4) >>>
    pv := mixer.play_stream(live.source_id(), 0, 1.0, 0.0) >>>
    mixer.render(1) >>>
    mixer.fade_volume(pv, 0.0, 4, true) >>>
    receipt := mixer.prepare(1) >>>
    position := live.position_seconds(&mixer) >>>
    write_file("build/audio-fixtures/seek-live.wav", "truncated") >>>
    assert(stream_rejected($&live, $&mixer, 2))
    assert((live.position_seconds(&mixer) >>>) == position && live.read_position() == 3 && (mixer.volume(pv) >>>) == 1.0)
    mixer.commit(&receipt) >>>
    write_file("build/audio-fixtures/seek-live.wav", raw + "") >>>
    live.seek_frames($&mixer, 2) >>>
    recovered := mixer.render(1) >>>
    assert(recovered[0] == 24575 && (mixer.volume(pv) >>>) == 0.75)
    live.close($&mixer) >>>
    // Equal-length corrupt PCM fails before discarding the previous valid ring.
    floats := os.read("build/audio-fixtures/float.wav") >>>
    write_file("build/audio-fixtures/seek-float.wav", floats + "") >>>
    $bad := music.open($&mixer, "build/audio-fixtures/seek-float.wav", 4, false) >>>
    bad.refill($&mixer, 4) >>>
    bv := mixer.play_stream(bad.source_id(), 0, 1.0, 0.0) >>>
    corrupt := floats[0:44] + string_from_byte(0) + string_from_byte(0) + string_from_byte(192) + string_from_byte(127) + floats[48:floats.len]
    write_file("build/audio-fixtures/seek-float.wav", corrupt) >>>
    same := mixer.prepare(1) >>>
    assert(stream_rejected($&bad, $&mixer, 0))
    mixer.commit(&same) >>>
    assert((mixer.position_frames(bv) >>>) == 0.5)
    bad.close($&mixer) >>>
    println("PASS: clip/stream seek and restart, stable voices, pause/EOF, fade cancellation, bounded 48 MB random seek, 100 resets and failure atomicity")
    << 0
}
fn main() int { << run() >>> (err) { eprintln(err.msg())
    << 1 } }
