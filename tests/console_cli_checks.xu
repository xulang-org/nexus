@main

rc #"github.com/xulang-org/nexus/resources/console"
snapshot #"github.com/xulang-org/nexus/internal/file_snapshot"
#errors
#os
exec #os/exec
#path/filepath
#strings

struct CmdOutcome {
    ok bool
    output string
}

fn check(ok bool, msg string) int {
    if !ok { >> errors.new("console_cli_checks: " + msg) }
    << 0
}

fn clean_dir(path string) int {
    os.remove_all(path) or (err) {
        _ := err.msg()
        << 0
    }
    << 0
}

fn run_cmd(bin string, args &[]string) CmdOutcome {
    $cmd := exec.command(bin + "")
    for i in 0:args.len { cmd.args.push(args[i] + "") }
    out := cmd.combined_output() or (err) {
        << CmdOutcome{ok: false, output: err.msg()}
    }
    << CmdOutcome{ok: true, output: out}
}

fn resolve_cli() string {
    args := os.args()
    $i := 1
    while i < args.len {
        if args[i] == "--project-cli" && i + 1 < args.len { << args[i + 1] + "" }
        i = i + 1
    }
    << "build/nexus-project"
}

fn run() int {
    cli := resolve_cli()
    tmp := filepath.join(["build", "console-cli-tmp"])
    clean_dir(tmp + "")
    os.mkdir_all(tmp + "") or >>

    // Xbox validate + stage
    $xcfg := rc.default_xbox_config()
    xcfg.achievement_ids = ["XB_START"]
    xbox_json := filepath.join([tmp + "", "xbox.json"])
    xraw := rc.encode_xbox_config_json(&xcfg) or >>
    snapshot.write_atomic(xbox_json + "", &xraw) or >>

    xv_args := ["xbox-validate", xbox_json + ""]
    xv := run_cmd(cli + "", &xv_args)
    check(xv.ok && strings.contains(&xv.output, "VALID_XBOX store_id=9NX0DEMO0001 title_id=75C31B92"),
        "xbox-validate: " + xv.output) or >>

    xout := filepath.join([tmp + "", "xbox-stage"])
    xs_args := ["xbox-stage", "examples/modern_sandbox/project.json", "--xbox", xbox_json + "", "--output", xout + ""]
    xs := run_cmd(cli + "", &xs_args)
    check(xs.ok && strings.contains(&xs.output, "STAGED_XBOX title_id=75C31B92"), "xbox-stage: " + xs.output) or >>

    mgc := snapshot.read(filepath.join([xout + "", "content", "MicrosoftGame.config"]), 65536) or >>
    check(strings.contains(&mgc, "<TitleId>75C31B92</TitleId>"), "MicrosoftGame.config") or >>
    lxml := snapshot.read(filepath.join([xout + "", "layout.xml"]), 65536) or >>
    check(strings.contains(&lxml, "MicrosoftGame.config"), "layout.xml") or >>

    // PlayStation validate + stage
    $pcfg := rc.default_ps_config()
    pcfg.trophies = [rc.PsTrophyDef{trophy_id: 1, grade: rc.TROPHY_GOLD, name: "Launch", is_progress: false, target_value: 0, hidden: false}]
    pcfg.activities = [rc.PsActivityDef{activity_id: "main_story", name: "Main Story", category: "progress"}]
    ps_json := filepath.join([tmp + "", "ps.json"])
    praw := rc.encode_ps_config_json(&pcfg) or >>
    snapshot.write_atomic(ps_json + "", &praw) or >>

    pv_args := ["ps-validate", ps_json + ""]
    pv := run_cmd(cli + "", &pv_args)
    check(pv.ok && strings.contains(&pv.output, "VALID_PS title_id=PPSA01234"), "ps-validate: " + pv.output) or >>

    pout := filepath.join([tmp + "", "ps-stage"])
    ps_args := ["ps-stage", "examples/modern_sandbox/project.json", "--ps", ps_json + "", "--output", pout + ""]
    ps_res := run_cmd(cli + "", &ps_args)
    check(ps_res.ok && strings.contains(&ps_res.output, "STAGED_PS title_id=PPSA01234"), "ps-stage: " + ps_res.output) or >>

    param := snapshot.read(filepath.join([pout + "", "content", "sce_sys", "param.json"]), 65536) or >>
    check(strings.contains(&param, "\"titleId\": \"PPSA01234\""), "sce_sys/param.json") or >>
    uds := snapshot.read(filepath.join([pout + "", "content", "sce_sys", "trophy2", "uds_schema.json"]), 65536) or >>
    check(strings.contains(&uds, "\"main_story\""), "uds_schema.json") or >>
    gp5 := snapshot.read(filepath.join([pout + "", "package.gp5"]), 65536) or >>
    check(strings.contains(&gp5, "sce_sys/param.json"), "package.gp5") or >>

    // Invalid PS config rejection
    bad_ps := filepath.join([tmp + "", "bad_ps.json"])
    bad_raw := "{\"format\":\"nexus.playstation\",\"version\":1,\"title_id\":\"bad\"}"
    snapshot.write_atomic(bad_ps + "", &bad_raw) or >>
    bad_args := ["ps-validate", bad_ps + ""]
    bad_pv := run_cmd(cli + "", &bad_args)
    check(!bad_pv.ok, "ps-validate should reject invalid title_id") or >>

    // Nintendo Switch validate + stage
    $swcfg := rc.default_switch_config()
    swcfg.aoc_indices = [1, 2]
    sw_json := filepath.join([tmp + "", "switch.json"])
    swraw := rc.encode_switch_config_json(&swcfg) or >>
    snapshot.write_atomic(sw_json + "", &swraw) or >>

    swv_args := ["switch-validate", sw_json + ""]
    swv := run_cmd(cli + "", &swv_args)
    check(swv.ok && strings.contains(&swv.output, "VALID_SWITCH app_id=0100abcd12340000"),
        "switch-validate: " + swv.output) or >>

    swout := filepath.join([tmp + "", "switch-stage"])
    sws_args := ["switch-stage", "examples/modern_sandbox/project.json", "--switch", sw_json + "", "--output", swout + ""]
    sws := run_cmd(cli + "", &sws_args)
    check(sws.ok && strings.contains(&sws.output, "STAGED_SWITCH app_id=0100abcd12340000"),
        "switch-stage: " + sws.output) or >>

    nmeta := snapshot.read(filepath.join([swout + "", "meta", "application.nmeta"]), 65536) or >>
    check(strings.contains(&nmeta, "<ApplicationId>0x0100abcd12340000</ApplicationId>"), "application.nmeta") or >>
    romproj := snapshot.read(filepath.join([swout + "", "romfs", "project.json"]), 65536) or >>
    check(romproj.len > 10, "romfs/project.json") or >>
    swman := snapshot.read(filepath.join([swout + "", "switch_stage_manifest.json"]), 1048576) or >>
    check(strings.contains(&swman, "\"lotcheck_passed\": true"), "switch_stage_manifest.json") or >>

    bad_sw := filepath.join([tmp + "", "bad_switch.json"])
    bad_sw_raw := "{\"format\":\"nexus.switch\",\"version\":1,\"application_id_hex\":\"short\"}"
    snapshot.write_atomic(bad_sw + "", &bad_sw_raw) or >>
    bad_sw_args := ["switch-validate", bad_sw + ""]
    bad_swv := run_cmd(cli + "", &bad_sw_args)
    check(!bad_swv.ok, "switch-validate should reject short application_id_hex") or >>

    clean_dir(tmp + "")
    println("PASS: console_cli_checks")
    << 0
}

fn main() int {
    run() or (err) {
        println("FAIL: " + err.msg())
        << 1
    }
    << 0
}
