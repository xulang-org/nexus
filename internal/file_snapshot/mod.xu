@"github.com/xulang-org/nexus/internal/file_snapshot"

#os
#strings
#errors

pub const MAX_BYTES = 33554432
// Bounded snapshot from one open descriptor, including a limit+1 EOF probe.
pub fn read(path string, limit int) string {
    if limit < 1 || limit > MAX_BYTES { >> errors.new("nexus file: invalid snapshot limit") }
    $file := os.open(path) >>>
    $builder := strings.new_byte_builder(4096)
    $count := 0
    while count <= limit {
        $request := limit + 1 - count
        if request > 65536 { request = 65536 }
        chunk := file.read(request) >>>
        if chunk.len == 0 { <- }
        count = count + chunk.len
        if count > limit { >> errors.new("nexus file: snapshot exceeds byte limit") }
        builder.write_str(chunk)
    }
    file.close() >>>
    << builder.to_string()
}
fn cleanup_file(file $&os.File) { file.close() >>> (err) { << } }
fn cleanup_path(path string) { os.remove(path) >>> (err) { << } }
pub fn write_atomic(path string, raw &string) int {
    if raw.len > MAX_BYTES { >> errors.new("nexus file: output exceeds byte limit") }
    temporary := path + ".tmp-" + str(os.getpid()) + "-" + str(now_ns())
    $file := os.create_excl(temporary + "") >>>
    $offset := 0
    while offset < raw.len {
        part := raw[offset:raw.len] + ""
        written := file.write(part) >>> (err) { cleanup_file($&file)
            cleanup_path(temporary + "")
            >> err }
        if written < 1 || written > raw.len - offset { cleanup_file($&file)
            cleanup_path(temporary + "")
            >> errors.new("nexus file: no/invalid write progress") }
        offset = offset + written
    }
    file.close() >>> (err) { cleanup_path(temporary + "")
        >> err }
    os.rename(temporary + "", path) >>> (err) { cleanup_path(temporary + "")
        >> err }
    << 0
}
