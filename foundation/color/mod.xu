@"github.com/xulang-org/game/foundation/color"

#errors

pub fn rgba8(red int, green int, blue int, alpha int) int {
    if red < 0 || red > 255 || green < 0 || green > 255 || blue < 0 || blue > 255 || alpha < 0 || alpha > 255 {
        >> errors.new("color component outside 0...255")
    }
    << (red << 24) | (green << 16) | (blue << 8) | alpha
}
