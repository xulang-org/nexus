@"github.com/xulang-org/game/foundation/math"

#math
#errors

pub struct Vec2 {
    pub x f64
    pub y f64
}

pub fn vec2(x f64, y f64) Vec2 { << Vec2{x: x, y: y} }
pub fn (v Vec2) add(other Vec2) Vec2 { << vec2(v.x + other.x, v.y + other.y) }
pub fn (v Vec2) sub(other Vec2) Vec2 { << vec2(v.x - other.x, v.y - other.y) }
pub fn (v Vec2) scaled(amount f64) Vec2 { << vec2(v.x * amount, v.y * amount) }
pub fn (v Vec2) dot(other Vec2) f64 { << v.x * other.x + v.y * other.y }
pub fn (v Vec2) length() f64 { << math.sqrt(v.dot(v)) }
pub fn (v Vec2) normalized() Vec2 {
    length := v.length()
    if length <= 0.000000001 { << vec2(0.0, 0.0) }
    << v.scaled(1.0 / length)
}
pub fn (v Vec2) lerp(other Vec2, weight f64) Vec2 {
    << v.add(other.sub(v).scaled(weight))
}
pub fn finite(value f64) bool { << !math.is_nan(value) && !math.is_inf(value) }

// Column-vector affine algebra; angles are radians. Screen-axis conventions
// belong to the calling camera/scene layer.
pub struct Transform2D {
    pub a f64
    pub b f64
    pub c f64
    pub d f64
    pub tx f64
    pub ty f64
}

pub fn identity() Transform2D {
    << Transform2D{a: 1.0, b: 0.0, c: 0.0, d: 1.0, tx: 0.0, ty: 0.0}
}
pub fn transform_2d(position Vec2, rotation f64, scale Vec2) Transform2D {
    cs := math.cos(rotation)
    sn := math.sin(rotation)
    << Transform2D{a: cs * scale.x, b: sn * scale.x, c: -sn * scale.y, d: cs * scale.y,
        tx: position.x, ty: position.y}
}
pub fn (t Transform2D) point(v Vec2) Vec2 {
    << vec2(t.a * v.x + t.c * v.y + t.tx, t.b * v.x + t.d * v.y + t.ty)
}
pub fn (t Transform2D) multiply(other Transform2D) Transform2D {
    << Transform2D{a: t.a * other.a + t.c * other.b, b: t.b * other.a + t.d * other.b,
        c: t.a * other.c + t.c * other.d, d: t.b * other.c + t.d * other.d,
        tx: t.a * other.tx + t.c * other.ty + t.tx, ty: t.b * other.tx + t.d * other.ty + t.ty}
}
pub fn (t Transform2D) is_finite() bool {
    << finite(t.a) && finite(t.b) && finite(t.c) && finite(t.d) && finite(t.tx) && finite(t.ty)
}
pub fn (t Transform2D) inverse() Transform2D {
    det := t.a * t.d - t.b * t.c
    if !t.is_finite() || !finite(det) || math.abs(det) <= 0.000000001 {
        >> errors.new("game: transform is not invertible")
    }
    << Transform2D{a: t.d / det, b: -t.b / det, c: -t.c / det, d: t.a / det,
        tx: (t.c * t.ty - t.d * t.tx) / det, ty: (t.b * t.tx - t.a * t.ty) / det}
}

pub struct Rect2 {
    pub position Vec2
    pub size Vec2
}
pub fn rect2(x f64, y f64, width f64, height f64) Rect2 {
    << Rect2{position: vec2(x, y), size: vec2(width, height)}
}
pub fn (r Rect2) valid() bool {
    << finite(r.position.x) && finite(r.position.y) && finite(r.size.x) && finite(r.size.y) &&
        r.size.x > 0.0 && r.size.y > 0.0 && finite(r.position.x + r.size.x) && finite(r.position.y + r.size.y)
}
// Half-open bounds: touching edges have no overlap.
pub fn (r Rect2) contains(point Vec2) bool {
    << point.x >= r.position.x && point.y >= r.position.y &&
        point.x < r.position.x + r.size.x && point.y < r.position.y + r.size.y
}
pub fn (r Rect2) overlaps(other Rect2) bool {
    << r.position.x < other.position.x + other.size.x && r.position.x + r.size.x > other.position.x &&
        r.position.y < other.position.y + other.size.y && r.position.y + r.size.y > other.position.y
}
