@"github.com/xulang-org/nexus/foundation/math"

#math
#errors

pub const EASE_LINEAR = 0
pub const EASE_IN_SINE = 1
pub const EASE_OUT_SINE = 2
pub const EASE_IN_OUT_SINE = 3
pub const EASE_IN_QUAD = 4
pub const EASE_OUT_QUAD = 5
pub const EASE_IN_OUT_QUAD = 6
pub const EASE_IN_CUBIC = 7
pub const EASE_OUT_CUBIC = 8
pub const EASE_IN_OUT_CUBIC = 9
pub const EASE_IN_QUART = 10
pub const EASE_OUT_QUART = 11
pub const EASE_IN_OUT_QUART = 12
pub const EASE_IN_QUINT = 13
pub const EASE_OUT_QUINT = 14
pub const EASE_IN_OUT_QUINT = 15
pub const EASE_IN_EXPO = 16
pub const EASE_OUT_EXPO = 17
pub const EASE_IN_OUT_EXPO = 18
pub const EASE_IN_CIRC = 19
pub const EASE_OUT_CIRC = 20
pub const EASE_IN_OUT_CIRC = 21
pub const EASE_IN_BACK = 22
pub const EASE_OUT_BACK = 23
pub const EASE_IN_OUT_BACK = 24
pub const EASE_IN_ELASTIC = 25
pub const EASE_OUT_ELASTIC = 26
pub const EASE_IN_OUT_ELASTIC = 27
pub const EASE_IN_BOUNCE = 28
pub const EASE_OUT_BOUNCE = 29
pub const EASE_IN_OUT_BOUNCE = 30

pub fn clamp(v f64, lo f64, hi f64) f64 {
    if v < lo { << lo }
    if v > hi { << hi }
    << v
}

pub fn clamp01(v f64) f64 {
    << clamp(v, 0.0, 1.0)
}

pub fn lerp(a f64, b f64, t f64) f64 {
    << a + (b - a) * t
}

pub fn inverse_lerp(a f64, b f64, v f64) f64 {
    span := b - a
    if math.abs(span) <= 1e-12 { << 0.0 }
    << (v - a) / span
}

pub fn remap(in_lo f64, in_hi f64, out_lo f64, out_hi f64, v f64) f64 {
    u := inverse_lerp(in_lo, in_hi, v)
    << lerp(out_lo, out_hi, u)
}

pub fn smoothstep(edge0 f64, edge1 f64, x f64) f64 {
    t := clamp01(inverse_lerp(edge0, edge1, x))
    << t * t * (3.0 - 2.0 * t)
}

pub fn smootherstep(edge0 f64, edge1 f64, x f64) f64 {
    t := clamp01(inverse_lerp(edge0, edge1, x))
    << t * t * t * (t * (t * 6.0 - 15.0) + 10.0)
}

pub fn move_towards(current f64, target f64, max_delta f64) f64 {
    if !finite(max_delta) || max_delta <= 0.0 { << current }
    diff := target - current
    if math.abs(diff) <= max_delta { << target }
    if diff > 0.0 { << current + max_delta }
    << current - max_delta
}

// Framerate-independent exponential smoothing (half-life / damping lambda >= 0).
pub fn damp(a f64, b f64, lambda f64, dt f64) f64 {
    if !finite(lambda) || !finite(dt) || lambda <= 0.0 || dt <= 0.0 { << a }
    << lerp(a, b, 1.0 - math.exp(-lambda * dt))
}

pub fn wrap(v f64, lo f64, hi f64) f64 {
    span := hi - lo
    if !finite(span) || span <= 1e-12 { << lo }
    shifted := v - lo
    n := math.floor(shifted / span)
    out := lo + shifted - n * span
    if out >= hi { << lo }
    << out
}

pub fn ping_pong(t f64, length f64) f64 {
    if !finite(length) || length <= 1e-12 { << 0.0 }
    wrapped := wrap(t, 0.0, length * 2.0)
    << length - math.abs(wrapped - length)
}

pub fn deg_to_rad(deg f64) f64 { << deg * 0.017453292519943295 }
pub fn rad_to_deg(rad f64) f64 { << rad * 57.29577951308232 }

pub fn normalize_angle(rad f64) f64 {
    if !finite(rad) { << 0.0 }
    two_pi := math.pi() * 2.0
    $a := wrap(rad + math.pi(), 0.0, two_pi) - math.pi()
    if a <= -math.pi() { a = math.pi() }
    << a
}

pub fn delta_angle(from f64, to f64) f64 {
    << normalize_angle(to - from)
}

pub fn lerp_angle(a f64, b f64, t f64) f64 {
    << normalize_angle(a + delta_angle(a, b) * t)
}

pub fn approx_eq(a f64, b f64, eps f64) bool {
    << math.abs(a - b) <= math.max(0.0, eps)
}

fn ease_out_bounce_raw(x f64) f64 {
    n1 := 7.5625
    d1 := 2.75
    if x < 1.0 / d1 {
        << n1 * x * x
    } else if x < 2.0 / d1 {
        u := x - 1.5 / d1
        << n1 * u * u + 0.75
    } else if x < 2.5 / d1 {
        u := x - 2.25 / d1
        << n1 * u * u + 0.9375
    }
    u := x - 2.625 / d1
    << n1 * u * u + 0.984375
}

pub fn ease(kind int, t f64) f64 {
    if !finite(t) { << 0.0 }
    x := clamp01(t)
    pi := math.pi()
    c1 := 1.70158
    c2 := c1 * 1.525
    c3 := c1 + 1.0
    c4 := 2.0 * pi / 3.0
    c5 := 2.0 * pi / 4.5

    if kind == EASE_LINEAR { << x }
    if kind == EASE_IN_SINE { << 1.0 - math.cos(x * pi * 0.5) }
    if kind == EASE_OUT_SINE { << math.sin(x * pi * 0.5) }
    if kind == EASE_IN_OUT_SINE { << -(math.cos(pi * x) - 1.0) * 0.5 }
    if kind == EASE_IN_QUAD { << x * x }
    if kind == EASE_OUT_QUAD { << 1.0 - (1.0 - x) * (1.0 - x) }
    if kind == EASE_IN_OUT_QUAD {
        if x < 0.5 { << 2.0 * x * x }
        u := -2.0 * x + 2.0
        << 1.0 - u * u * 0.5
    }
    if kind == EASE_IN_CUBIC { << x * x * x }
    if kind == EASE_OUT_CUBIC {
        u := 1.0 - x
        << 1.0 - u * u * u
    }
    if kind == EASE_IN_OUT_CUBIC {
        if x < 0.5 { << 4.0 * x * x * x }
        u := -2.0 * x + 2.0
        << 1.0 - u * u * u * 0.5
    }
    if kind == EASE_IN_QUART { << x * x * x * x }
    if kind == EASE_OUT_QUART {
        u := 1.0 - x
        << 1.0 - u * u * u * u
    }
    if kind == EASE_IN_OUT_QUART {
        if x < 0.5 { << 8.0 * x * x * x * x }
        u := -2.0 * x + 2.0
        << 1.0 - u * u * u * u * 0.5
    }
    if kind == EASE_IN_QUINT { << x * x * x * x * x }
    if kind == EASE_OUT_QUINT {
        u := 1.0 - x
        << 1.0 - u * u * u * u * u
    }
    if kind == EASE_IN_OUT_QUINT {
        if x < 0.5 { << 16.0 * x * x * x * x * x }
        u := -2.0 * x + 2.0
        << 1.0 - u * u * u * u * u * 0.5
    }
    if kind == EASE_IN_EXPO {
        if x == 0.0 { << 0.0 }
        << math.pow_f64(2.0, 10.0 * x - 10.0)
    }
    if kind == EASE_OUT_EXPO {
        if x == 1.0 { << 1.0 }
        << 1.0 - math.pow_f64(2.0, -10.0 * x)
    }
    if kind == EASE_IN_OUT_EXPO {
        if x == 0.0 { << 0.0 }
        if x == 1.0 { << 1.0 }
        if x < 0.5 { << math.pow_f64(2.0, 20.0 * x - 10.0) * 0.5 }
        << (2.0 - math.pow_f64(2.0, -20.0 * x + 10.0)) * 0.5
    }
    if kind == EASE_IN_CIRC { << 1.0 - math.sqrt(math.max(0.0, 1.0 - x * x)) }
    if kind == EASE_OUT_CIRC {
        u := x - 1.0
        << math.sqrt(math.max(0.0, 1.0 - u * u))
    }
    if kind == EASE_IN_OUT_CIRC {
        if x < 0.5 {
            u := 2.0 * x
            << (1.0 - math.sqrt(math.max(0.0, 1.0 - u * u))) * 0.5
        }
        u := -2.0 * x + 2.0
        << (math.sqrt(math.max(0.0, 1.0 - u * u)) + 1.0) * 0.5
    }
    if kind == EASE_IN_BACK { << c3 * x * x * x - c1 * x * x }
    if kind == EASE_OUT_BACK {
        u := x - 1.0
        << 1.0 + c3 * u * u * u + c1 * u * u
    }
    if kind == EASE_IN_OUT_BACK {
        if x < 0.5 {
            u := 2.0 * x
            << (u * u * ((c2 + 1.0) * u - c2)) * 0.5
        }
        u := 2.0 * x - 2.0
        << (u * u * ((c2 + 1.0) * u + c2) + 2.0) * 0.5
    }
    if kind == EASE_IN_ELASTIC {
        if x == 0.0 { << 0.0 }
        if x == 1.0 { << 1.0 }
        << -math.pow_f64(2.0, 10.0 * x - 10.0) * math.sin((x * 10.0 - 10.75) * c4)
    }
    if kind == EASE_OUT_ELASTIC {
        if x == 0.0 { << 0.0 }
        if x == 1.0 { << 1.0 }
        << math.pow_f64(2.0, -10.0 * x) * math.sin((x * 10.0 - 0.75) * c4) + 1.0
    }
    if kind == EASE_IN_OUT_ELASTIC {
        if x == 0.0 { << 0.0 }
        if x == 1.0 { << 1.0 }
        if x < 0.5 {
            << -(math.pow_f64(2.0, 20.0 * x - 10.0) * math.sin((20.0 * x - 11.125) * c5)) * 0.5
        }
        << math.pow_f64(2.0, -20.0 * x + 10.0) * math.sin((20.0 * x - 11.125) * c5) * 0.5 + 1.0
    }
    if kind == EASE_IN_BOUNCE { << 1.0 - ease_out_bounce_raw(1.0 - x) }
    if kind == EASE_OUT_BOUNCE { << ease_out_bounce_raw(x) }
    if kind == EASE_IN_OUT_BOUNCE {
        if x < 0.5 { << (1.0 - ease_out_bounce_raw(1.0 - 2.0 * x)) * 0.5 }
        << (1.0 + ease_out_bounce_raw(2.0 * x - 1.0)) * 0.5
    }
    << x
}

pub fn bezier2_vec2(p0 Vec2, p1 Vec2, p2 Vec2, t f64) Vec2 {
    u := 1.0 - t
    << p0.scaled(u * u).add(p1.scaled(2.0 * u * t)).add(p2.scaled(t * t))
}

pub fn bezier3_vec2(p0 Vec2, p1 Vec2, p2 Vec2, p3 Vec2, t f64) Vec2 {
    u := 1.0 - t
    u2 := u * u
    t2 := t * t
    << p0.scaled(u2 * u).add(p1.scaled(3.0 * u2 * t)).add(p2.scaled(3.0 * u * t2)).add(p3.scaled(t2 * t))
}

pub fn bezier2_vec3(p0 Vec3, p1 Vec3, p2 Vec3, t f64) Vec3 {
    u := 1.0 - t
    << p0.scaled(u * u).add(p1.scaled(2.0 * u * t)).add(p2.scaled(t * t))
}

pub fn bezier3_vec3(p0 Vec3, p1 Vec3, p2 Vec3, p3 Vec3, t f64) Vec3 {
    u := 1.0 - t
    u2 := u * u
    t2 := t * t
    << p0.scaled(u2 * u).add(p1.scaled(3.0 * u2 * t)).add(p2.scaled(3.0 * u * t2)).add(p3.scaled(t2 * t))
}

pub fn catmull_rom_vec2(p0 Vec2, p1 Vec2, p2 Vec2, p3 Vec2, t f64) Vec2 {
    t2 := t * t
    t3 := t2 * t
    a := p1.scaled(2.0)
    b := p2.sub(p0).scaled(t)
    c := p0.scaled(2.0).sub(p1.scaled(5.0)).add(p2.scaled(4.0)).sub(p3).scaled(t2)
    d := p0.neg().add(p1.scaled(3.0)).sub(p2.scaled(3.0)).add(p3).scaled(t3)
    << a.add(b).add(c).add(d).scaled(0.5)
}

pub fn catmull_rom_vec3(p0 Vec3, p1 Vec3, p2 Vec3, p3 Vec3, t f64) Vec3 {
    t2 := t * t
    t3 := t2 * t
    a := p1.scaled(2.0)
    b := p2.sub(p0).scaled(t)
    c := p0.scaled(2.0).sub(p1.scaled(5.0)).add(p2.scaled(4.0)).sub(p3).scaled(t2)
    d := p0.neg().add(p1.scaled(3.0)).sub(p2.scaled(3.0)).add(p3).scaled(t3)
    << a.add(b).add(c).add(d).scaled(0.5)
}

pub struct SplinePath3D {
    points []Vec3
    closed bool
    lut_points []Vec3
    lut_cum_dist []f64
    length f64
}

fn eval_catmull_segment_point(points &[]Vec3, closed bool, seg int, local_t f64) Vec3 {
    n := points.len
    if n <= 0 { << vec3(0.0, 0.0, 0.0) }
    $i0 := seg - 1
    $i1 := seg
    $i2 := seg + 1
    $i3 := seg + 2
    if closed {
        i0 = (seg - 1 + n) % n
        i1 = seg % n
        i2 = (seg + 1) % n
        i3 = (seg + 2) % n
    } else {
        if i0 < 0 { i0 = 0 }
        if i2 >= n { i2 = n - 1 }
        if i3 >= n { i3 = n - 1 }
    }
    << catmull_rom_vec3(points[i0], points[i1], points[i2], points[i3], local_t)
}

pub fn new_spline_path_3d(points []Vec3, closed bool, samples_per_segment int) SplinePath3D {
    if points.len < 2 || samples_per_segment < 2 || samples_per_segment > 128 {
        >> errors.new("nexus math: SplinePath3D requires >= 2 finite points and 2..128 samples/segment")
    }
    $copied := []Vec3{}
    for p in points {
        if !p.is_finite() { >> errors.new("nexus math: SplinePath3D points must be finite") }
        copied.push(p)
    }
    $seg_count := copied.len - 1
    if closed { seg_count = copied.len }
    $lut_p := []Vec3{}
    $lut_d := []f64{}
    $total := 0.0
    first := eval_catmull_segment_point(&copied, closed, 0, 0.0)
    lut_p.push(first)
    lut_d.push(0.0)
    $prev := first
    for s in 0:seg_count {
        for step in 1:(samples_per_segment + 1) {
            u := f64(step) / f64(samples_per_segment)
            pt := eval_catmull_segment_point(&copied, closed, s, u)
            total = total + pt.distance(prev)
            lut_p.push(pt)
            lut_d.push(total)
            prev = pt
        }
    }
    << SplinePath3D{
        points: copied,
        closed: closed,
        lut_points: lut_p,
        lut_cum_dist: lut_d,
        length: total
    }
}

pub fn (s &SplinePath3D) total_length() f64 { << s.length }

pub fn (s &SplinePath3D) sample_by_distance(dist f64) Vec3 {
    if s.lut_points.len == 0 { << vec3(0.0, 0.0, 0.0) }
    if s.length <= 1e-12 { << s.lut_points[0] }
    $d := dist
    if s.closed {
        d = wrap(dist, 0.0, s.length)
    } else {
        d = clamp(dist, 0.0, s.length)
    }
    if d <= 0.0 { << s.lut_points[0] }
    last := s.lut_points.len - 1
    if d >= s.lut_cum_dist[last] { << s.lut_points[last] }
    for i in 0:last {
        d0 := s.lut_cum_dist[i]
        d1 := s.lut_cum_dist[i + 1]
        if d <= d1 {
            span := d1 - d0
            if span <= 1e-12 { << s.lut_points[i] }
            alpha := (d - d0) / span
            << s.lut_points[i].lerp(s.lut_points[i + 1], alpha)
        }
    }
    << s.lut_points[last]
}

pub fn (s &SplinePath3D) sample_by_t(u f64) Vec3 {
    t := clamp01(u)
    << s.sample_by_distance(t * s.length)
}

pub fn (s &SplinePath3D) tangent_by_distance(dist f64) Vec3 {
    if s.length <= 1e-9 { << vec3(0.0, 0.0, 1.0) }
    eps := math.min(0.01, s.length * 0.01)
    p0 := s.sample_by_distance(dist - eps)
    p1 := s.sample_by_distance(dist + eps)
    << p1.sub(p0).normalized_or_zero()
}
