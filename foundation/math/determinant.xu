@"github.com/xulang-org/nexus/foundation/math"

#math
#errors

fn determinant_column(value Vec4) Vec4 {
    scale := math.max(math.max(math.abs(value.x), math.abs(value.y)), math.max(math.abs(value.z), math.abs(value.w)))
    if scale == 0.0 { << vec4(0.0, 0.0, 0.0, 0.0) }
    << vec4(value.x / scale, value.y / scale, value.z / scale, value.w / scale)
}
fn determinant3(a f64, b f64, c f64, d f64, e f64, f f64, g f64, h f64, i f64) f64 {
    << a * (e * i - f * h) - b * (d * i - f * g) + c * (d * h - e * g)
}
// Scaled floating-point sign, not an exact robust predicate near singularity.
// Positive column scaling avoids overflow without changing determinant sign.
pub fn (matrix Mat4) determinant_sign() int {
    if !matrix.is_finite() { >>> errors.new("nexus: determinant requires a finite matrix") }
    a := determinant_column(matrix.c0)
    b := determinant_column(matrix.c1)
    c := determinant_column(matrix.c2)
    d := determinant_column(matrix.c3)
    determinant := a.x * determinant3(b.y, c.y, d.y, b.z, c.z, d.z, b.w, c.w, d.w) -
        b.x * determinant3(a.y, c.y, d.y, a.z, c.z, d.z, a.w, c.w, d.w) +
        c.x * determinant3(a.y, b.y, d.y, a.z, b.z, d.z, a.w, b.w, d.w) -
        d.x * determinant3(a.y, b.y, c.y, a.z, b.z, c.z, a.w, b.w, c.w)
    if determinant < 0.0 { << -1 }
    if determinant > 0.0 { << 1 }
    << 0
}
