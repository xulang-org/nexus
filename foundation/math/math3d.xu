@"github.com/xulang-org/nexus/foundation/math"

#math
#errors

// Column-vector algebra, radians. Camera and projection policy live separately.
pub struct Vec3 {
    pub x f64
    pub y f64
    pub z f64
}
pub fn vec3(x f64, y f64, z f64) Vec3 { << Vec3{x: x, y: y, z: z} }
pub fn (v Vec3) add(other Vec3) Vec3 { << vec3(v.x + other.x, v.y + other.y, v.z + other.z) }
pub fn (v Vec3) sub(other Vec3) Vec3 { << vec3(v.x - other.x, v.y - other.y, v.z - other.z) }
pub fn (v Vec3) scaled(amount f64) Vec3 { << vec3(v.x * amount, v.y * amount, v.z * amount) }
pub fn (v Vec3) dot(other Vec3) f64 { << v.x * other.x + v.y * other.y + v.z * other.z }
pub fn (v Vec3) cross(other Vec3) Vec3 {
    << vec3(v.y * other.z - v.z * other.y, v.z * other.x - v.x * other.z, v.x * other.y - v.y * other.x)
}
pub fn (v Vec3) length() f64 { << math.sqrt(v.dot(v)) }
pub fn (v Vec3) is_finite() bool { << finite(v.x) && finite(v.y) && finite(v.z) }
pub fn (v Vec3) normalized() Vec3 {
    if !v.is_finite() {
        >>> errors.new("nexus: cannot normalize a zero or non-finite Vec3")
    }
    scale := math.max(math.abs(v.x), math.max(math.abs(v.y), math.abs(v.z)))
    if scale == 0.0 { >>> errors.new("nexus: cannot normalize a zero Vec3") }
    // Rescale before squaring: tiny and large finite vectors remain usable.
    unit := vec3(v.x / scale, v.y / scale, v.z / scale)
    length := unit.length()
    if length <= 0.0 { >>> errors.new("nexus: invalid vector magnitude") }
    << unit.scaled(1.0 / length)
}

pub struct Vec4 {
    pub x f64
    pub y f64
    pub z f64
    pub w f64
}
pub fn vec4(x f64, y f64, z f64, w f64) Vec4 { << Vec4{x: x, y: y, z: z, w: w} }
pub fn (v Vec4) xyz() Vec3 { << vec3(v.x, v.y, v.z) }
pub fn (v Vec4) is_finite() bool { << finite(v.x) && finite(v.y) && finite(v.z) && finite(v.w) }
pub struct Mat4 {
    pub c0 Vec4
    pub c1 Vec4
    pub c2 Vec4
    pub c3 Vec4
}
pub fn identity_3d() Mat4 {
    << Mat4{c0: vec4(1.0, 0.0, 0.0, 0.0), c1: vec4(0.0, 1.0, 0.0, 0.0),
        c2: vec4(0.0, 0.0, 1.0, 0.0), c3: vec4(0.0, 0.0, 0.0, 1.0)}
}
pub fn (m Mat4) transform(v Vec4) Vec4 {
    << vec4(m.c0.x * v.x + m.c1.x * v.y + m.c2.x * v.z + m.c3.x * v.w,
        m.c0.y * v.x + m.c1.y * v.y + m.c2.y * v.z + m.c3.y * v.w,
        m.c0.z * v.x + m.c1.z * v.y + m.c2.z * v.z + m.c3.z * v.w,
        m.c0.w * v.x + m.c1.w * v.y + m.c2.w * v.z + m.c3.w * v.w)
}
pub fn (m Mat4) multiply(other Mat4) Mat4 {
    << Mat4{c0: m.transform(other.c0), c1: m.transform(other.c1), c2: m.transform(other.c2), c3: m.transform(other.c3)}
}
pub fn (m Mat4) transposed() Mat4 {
    << Mat4{c0: vec4(m.c0.x, m.c1.x, m.c2.x, m.c3.x), c1: vec4(m.c0.y, m.c1.y, m.c2.y, m.c3.y),
        c2: vec4(m.c0.z, m.c1.z, m.c2.z, m.c3.z), c3: vec4(m.c0.w, m.c1.w, m.c2.w, m.c3.w)}
}
pub fn (m Mat4) is_finite() bool { << m.c0.is_finite() && m.c1.is_finite() && m.c2.is_finite() && m.c3.is_finite() }
pub fn (m Mat4) is_affine() bool {
    << m.is_finite() && m.c0.w == 0.0 && m.c1.w == 0.0 && m.c2.w == 0.0 && m.c3.w == 1.0
}
// Affine only. Reject singular/ill-conditioned normalized determinants <= 1e-12.
pub fn (m Mat4) affine_inverse() Mat4 {
    if !m.is_affine() { >>> errors.new("nexus: inverse requires a finite affine matrix") }
    $scale := 0.0
    for column in [m.c0, m.c1, m.c2] {
        scale = math.max(scale, math.max(math.abs(column.x), math.max(math.abs(column.y), math.abs(column.z))))
    }
    if scale == 0.0 { >>> errors.new("nexus: singular affine matrix") }
    a := vec3(m.c0.x / scale, m.c0.y / scale, m.c0.z / scale)
    b := vec3(m.c1.x / scale, m.c1.y / scale, m.c1.z / scale)
    c := vec3(m.c2.x / scale, m.c2.y / scale, m.c2.z / scale)
    bc := b.cross(c)
    determinant := a.dot(bc)
    if math.abs(determinant) <= 0.000000000001 { >>> errors.new("nexus: singular or ill-conditioned affine matrix") }
    ca := c.cross(a)
    ab := a.cross(b)
    r0 := vec3(bc.x / determinant / scale, bc.y / determinant / scale, bc.z / determinant / scale)
    r1 := vec3(ca.x / determinant / scale, ca.y / determinant / scale, ca.z / determinant / scale)
    r2 := vec3(ab.x / determinant / scale, ab.y / determinant / scale, ab.z / determinant / scale)
    position := m.c3.xyz()
    result := Mat4{c0: vec4(r0.x, r1.x, r2.x, 0.0), c1: vec4(r0.y, r1.y, r2.y, 0.0),
        c2: vec4(r0.z, r1.z, r2.z, 0.0), c3: vec4(-r0.dot(position), -r1.dot(position), -r2.dot(position), 1.0)}
    if !result.is_affine() { >>> errors.new("nexus: affine inverse overflow") }
    << result
}
pub fn translation_3d(position Vec3) Mat4 {
    $m := identity_3d()
    m.c3 = vec4(position.x, position.y, position.z, 1.0)
    << m
}
pub fn scale_3d(scale Vec3) Mat4 {
    << Mat4{c0: vec4(scale.x, 0.0, 0.0, 0.0), c1: vec4(0.0, scale.y, 0.0, 0.0),
        c2: vec4(0.0, 0.0, scale.z, 0.0), c3: vec4(0.0, 0.0, 0.0, 1.0)}
}
pub fn rotation_y(angle f64) Mat4 {
    cs := math.cos(angle)
    sn := math.sin(angle)
    << Mat4{c0: vec4(cs, 0.0, -sn, 0.0), c1: vec4(0.0, 1.0, 0.0, 0.0),
        c2: vec4(sn, 0.0, cs, 0.0), c3: vec4(0.0, 0.0, 0.0, 1.0)}
}
pub fn rotation_x(angle f64) Mat4 {
    cs := math.cos(angle)
    sn := math.sin(angle)
    << Mat4{c0: vec4(1.0, 0.0, 0.0, 0.0), c1: vec4(0.0, cs, sn, 0.0),
        c2: vec4(0.0, -sn, cs, 0.0), c3: vec4(0.0, 0.0, 0.0, 1.0)}
}
