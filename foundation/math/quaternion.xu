@"github.com/xulang-org/nexus/foundation/math"

#math
#errors

pub struct Quaternion {
    pub x f64
    pub y f64
    pub z f64
    pub w f64
}
pub fn quaternion(x f64, y f64, z f64, w f64) Quaternion { << Quaternion{x: x, y: y, z: z, w: w} }
pub fn (q Quaternion) normalized() Quaternion {
    if !finite(q.x) || !finite(q.y) || !finite(q.z) || !finite(q.w) { >> errors.new("nexus: non-finite quaternion") }
    scale := math.max(math.max(math.abs(q.x), math.abs(q.y)), math.max(math.abs(q.z), math.abs(q.w)))
    if scale == 0.0 { >> errors.new("nexus: zero quaternion") }
    x := q.x / scale
    y := q.y / scale
    z := q.z / scale
    w := q.w / scale
    length := math.sqrt(x * x + y * y + z * z + w * w)
    if length <= 0.0 { >> errors.new("nexus: invalid quaternion magnitude") }
    << quaternion(x / length, y / length, z / length, w / length)
}
pub fn (q Quaternion) rotation_matrix() Mat4 {
    n := q.normalized() or >>
    xx := n.x * n.x
    yy := n.y * n.y
    zz := n.z * n.z
    xy := n.x * n.y
    xz := n.x * n.z
    yz := n.y * n.z
    wx := n.w * n.x
    wy := n.w * n.y
    wz := n.w * n.z
    << Mat4{c0: vec4(1.0 - 2.0 * (yy + zz), 2.0 * (xy + wz), 2.0 * (xz - wy), 0.0),
        c1: vec4(2.0 * (xy - wz), 1.0 - 2.0 * (xx + zz), 2.0 * (yz + wx), 0.0),
        c2: vec4(2.0 * (xz + wy), 2.0 * (yz - wx), 1.0 - 2.0 * (xx + yy), 0.0),
        c3: vec4(0.0, 0.0, 0.0, 1.0)}
}
