@main

fm #"github.com/xulang-org/nexus/foundation/math"
snapshot #"github.com/xulang-org/nexus/internal/file_snapshot"
codec #"github.com/xulang-org/nexus/formats/scene"
tiles #"github.com/xulang-org/nexus/resources/tilemap"
#errors
#image/png
#os
#path/filepath
#ui
#ui/draw

fn click_center(rect fm.Rect2) fm.Vec2 { << rect.position.add(rect.size.scaled(0.5)) }

fn rejects_stale_save(draft $&TileDraft) bool {
    save_draft(draft) >>> (err) { << true }
    << false
}

fn run_editor_check(context &draw.Context, editor $&TileEditor, frame $&draw.Frame, output string) int {
    assert(editor.layer_names.len == 2)
    editor.input(context, ui.EV_POINTER_DOWN, ui.BUTTON_LEFT, click_center(editor.layer_row(1)), 0.0, 0, 0) >>>
    assert(editor.index == 1)
    editor.input(context, ui.EV_POINTER_DOWN, ui.BUTTON_LEFT, click_center(editor.swatch(2)), 0.0, 0, 0) >>>
    assert(editor.tile == 2 && (editor.layer.grid.cell(3, 4) >>>) == tiles.EMPTY_TILE)
    start := editor.screen(editor.layer.grid.cell_center(3, 4))
    end := editor.screen(editor.layer.grid.cell_center(3, 6))
    editor.input(context, ui.EV_POINTER_DOWN, ui.BUTTON_LEFT, start, 0.0, 0, 0) >>>
    editor.input(context, ui.EV_POINTER_MOVE, 0, end, 0.0, 0, 0) >>>
    editor.input(context, ui.EV_POINTER_UP, ui.BUTTON_LEFT, end, 0.0, 0, 0) >>>
    assert(editor.draft.undo.len == 1 && editor.draft.dirty())
    for row in 4:7 { assert((editor.layer.grid.cell(3, row) >>>) == 2) }

    editor.input(context, ui.EV_KEY_DOWN, 0, end, 0.0, 122, ui.MOD_CONTROL) >>>
    assert(!editor.draft.dirty() && editor.draft.redo.len == 1)
    for row in 4:7 { assert((editor.layer.grid.cell(3, row) >>>) == tiles.EMPTY_TILE) }
    editor.input(context, ui.EV_KEY_DOWN, 0, end, 0.0, 122, ui.MOD_CONTROL | ui.MOD_SHIFT) >>>
    for row in 4:7 { assert((editor.layer.grid.cell(3, row) >>>) == 2) }

    editor.input(context, ui.EV_POINTER_DOWN, ui.BUTTON_LEFT, click_center(editor.palette_control(1)), 0.0, 0, 0) >>>
    editor.input(context, ui.EV_POINTER_DOWN, ui.BUTTON_LEFT, end, 0.0, 0, 0) >>>
    editor.input(context, ui.EV_KEY_DOWN, 0, end, 0.0, ui.KEY_ESCAPE, 0) >>>
    assert((editor.layer.grid.cell(3, 6) >>>) == 2 && editor.draft.undo.len == 1)
    editor.input(context, ui.EV_POINTER_DOWN, ui.BUTTON_LEFT, end, 0.0, 0, 0) >>>
    editor.input(context, ui.EV_POINTER_UP, ui.BUTTON_LEFT, end, 0.0, 0, 0) >>>
    assert((editor.layer.grid.cell(3, 6) >>>) == tiles.EMPTY_TILE && editor.draft.undo.len == 2)

    original := editor.draft.path + ""
    initial := editor.draft.disk + ""
    directory := filepath.abs(&output) >>>
    test_scene := filepath.join([directory + "", "edited.xuscene"])
    if original == test_scene { >>> errors.new("editor check output must differ from the input scene") }
    os.mkdir_all(directory + "") >>>
    editor.draft.path = test_scene + ""
    external := initial + "\n"
    snapshot.write_atomic(test_scene + "", &external) >>>
    assert(rejects_stale_save($&editor.draft) && editor.draft.dirty())
    assert((snapshot.read(test_scene + "", codec.MAX_BYTES) >>>) == external)
    snapshot.write_atomic(test_scene + "", &initial) >>>
    editor.input(context, ui.EV_KEY_DOWN, 0, end, 0.0, 115, ui.MOD_CONTROL) >>>
    reopened := open_draft(test_scene + "") >>>
    document := reopened.document() >>>
    layer := document.tilemap_2d(1) >>>
    assert(document.has_solid_tiles_2d() && (layer.grid.cell_is_solid(3, 4) >>>))
    assert((layer.grid.cell(3, 5) >>>) == 2 && (layer.grid.cell(3, 6) >>>) == tiles.EMPTY_TILE)
    ground := document.tilemap_2d(0) >>>
    assert((ground.grid.elevation(3, 3) >>>) == 1.0 && (ground.grid.tint(2, 1) >>>) == 0xEDF4EBFF)
    assert(!editor.draft.dirty() && reopened.current == editor.draft.current)
    assert((snapshot.read(original + "", codec.MAX_BYTES) >>>) == initial)
    editor.draft.path = original

    editor.record(frame) >>>
    $surface := frame.snapshot(editor.size.x, editor.size.y, 1.0) >>>
    pixels := surface.rgba_bytes() >>>
    content := png.encode_rgba_bytes(&pixels, surface.pixel_width, surface.pixel_height) >>>
    surface.dispose() >>>
    frame.present_wait() >>>
    png_path := filepath.join([directory, "editor.png"])
    snapshot.write_atomic(png_path, &content) >>>
    println("PASS: native tile editor brush stroke, undo/redo, erase/cancel, stale save rejection and v8 save/reopen")
    << 0
}
