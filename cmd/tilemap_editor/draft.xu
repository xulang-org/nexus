@main

codec #"github.com/xulang-org/nexus/formats/scene"
snapshot #"github.com/xulang-org/nexus/internal/file_snapshot"
resource #"github.com/xulang-org/nexus/resources/scene"
#errors
#path/filepath

const MAX_HISTORY = 32

struct TileDraft {
    path string
    disk string
    saved string
    current string
    undo []string
    redo []string
}

fn open_draft(path string) TileDraft {
    source := filepath.abs(&path) >>>
    raw := snapshot.read(source + "", codec.MAX_BYTES) >>>
    document := codec.decode(&raw) >>>
    if document.tilemap_2d_count() == 0 { >>> errors.new("scene has no TileMap2D layers") }
    canonical := codec.encode(&document) >>>
    << TileDraft{path: source, disk: raw, saved: canonical + "", current: canonical, undo: []string{}, redo: []string{}}
}

fn (draft &TileDraft) document() resource.Document { << codec.decode(&draft.current) >>> }
fn (draft &TileDraft) dirty() bool { << draft.saved != draft.current }

fn copy_layer(layer &resource.TileMap2DAttachment) resource.TileMap2DAttachment {
    grid := layer.grid.clone() >>>
    << resource.tilemap_2d_attachment(layer.node, layer.resource_uid + "", layer.z_index, layer.y_sort_cells,
        layer.y_offset, layer.pixel_art, grid)
}

fn save_stroke(draft $&TileDraft, index int, layer &resource.TileMap2DAttachment) bool {
    before := draft.document() >>>
    if index < 0 || index >= before.tilemap_2d_count() || (before.tilemap_2d(index) >>>).node != layer.node {
        >>> errors.new("tile layer does not match the scene")
    }
    $refs := []resource.ResourceReference{}
    for i in 0:before.resource_count() { refs.push(before.resource(i) >>>) }
    $layers := []resource.TileMap2DAttachment{}
    for i in 0:before.tilemap_2d_count() {
        if i == index { layers.push(copy_layer(layer) >>>) }
        else { layers.push(before.tilemap_2d(i) >>>) }
    }
    document := resource.with_tilemaps_2d(&before, refs, layers) >>>
    next := codec.encode(&document) >>>
    if next == draft.current { << false }
    $history := []string{}
    $start := 0
    if draft.undo.len >= MAX_HISTORY { start = draft.undo.len - MAX_HISTORY + 1 }
    for i in start:draft.undo.len { history.push(draft.undo[i] + "") }
    history.push(draft.current + "")
    draft.undo = history
    draft.redo = []string{}
    draft.current = next
    << true
}

fn (draft $&TileDraft) undo_edit() bool {
    if draft.undo.len == 0 { << false }
    last := draft.undo.len - 1
    previous := draft.undo[last] + ""
    $remaining := []string{}
    for i in 0:last { remaining.push(draft.undo[i] + "") }
    draft.redo.push(draft.current + "")
    draft.current = previous
    draft.undo = remaining
    << true
}

fn (draft $&TileDraft) redo_edit() bool {
    if draft.redo.len == 0 { << false }
    last := draft.redo.len - 1
    next := draft.redo[last] + ""
    $remaining := []string{}
    for i in 0:last { remaining.push(draft.redo[i] + "") }
    draft.undo.push(draft.current + "")
    draft.current = next
    draft.redo = remaining
    << true
}

fn change_history(draft $&TileDraft, redo bool) bool {
    if redo { << draft.redo_edit() }
    << draft.undo_edit()
}

fn save_draft(draft $&TileDraft) int {
    if !draft.dirty() { << 0 }
    disk := snapshot.read(draft.path + "", codec.MAX_BYTES) >>>
    if disk != draft.disk { >>> errors.new("scene changed on disk. Reopen it before saving") }
    snapshot.write_atomic(draft.path + "", &draft.current) >>>
    draft.saved = draft.current + ""
    draft.disk = draft.current + ""
    << 0
}
