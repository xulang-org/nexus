@main

proj #"github.com/xulang-org/nexus/integration/project"
rp #"github.com/xulang-org/nexus/resources/project"
bm #"github.com/xulang-org/nexus/integration/bundle"
rc #"github.com/xulang-org/nexus/resources/console"
rs #"github.com/xulang-org/nexus/resources/steam"
rt #"github.com/xulang-org/nexus/resources/taptap"
snapshot #"github.com/xulang-org/nexus/internal/file_snapshot"
#crypto/sha256
#encoding/json
#path/filepath
#os
#strconv
#strings
#errors

fn print_help() {
    println("usage: nexus-project <command> [args]")
    println("  init <dir> --name <Name> [--id <com.studio.game>] [--module <mod>] [--template 3d|2d|25d|blank] [--locale <en-US>] [--platforms <all|none|csv>] [--nexus-path <path>] [--force]")
    println("  doctor <project.json> [--json] [--strict]")
    println("  layout")
    println("  build <project.json> --output <dir> [--validator <bin>]")
    println("  scene <name> --output <dir>")
    println("  register <project.json> <source>")
    println("  relocate <project.json> <uid> <source>")
    println("  bundle-pack <project.json> --output <dir> --bundle-id <id> --sequence <N> --key <secret>")
    println("  bundle-verify <bundle_dir> --key <secret>")
    println("  steam-validate <steam.json>")
    println("  steam-stage <project.json> [--steam <steam.json>] --output <dir> [--desc <text>] [--preview] [--binary <path>]")
    println("  xbox-validate <xbox.json>")
    println("  xbox-stage <project.json> [--xbox <xbox.json>] --output <dir> [--binary <path>]")
    println("  ps-validate <ps.json>")
    println("  ps-stage <project.json> [--ps <ps.json>] --output <dir> [--binary <path>]")
    println("  switch-validate <switch.json>")
    println("  switch-stage <project.json> [--switch <switch.json>] --output <dir> [--binary <path>]")
    println("  taptap-validate <taptap.json>")
    println("  taptap-stage <project.json> [--taptap <taptap.json>] --output <dir> [--binary <path>]")
}

fn has_help_flag(args &[]string, start int) bool {
    for i in start:args.len {
        if args[i] == "-h" || args[i] == "--help" {
            << true
        }
    }
    << false
}

fn run_build(args &[]string) int {
    if has_help_flag(args, 2) {
        println("usage: nexus-project build <project.json> --output <dir> [--validator <bin>]")
        << 0
    }
    $project_path := ""
    $output_dir := ""
    $validator := ""
    $i := 2
    while i < args.len {
        arg := args[i] + ""
        if arg == "--output" {
            i = i + 1
            if i >= args.len { >> errors.new("missing value for --output") }
            output_dir = args[i] + ""
        } else if arg == "--validator" {
            i = i + 1
            if i >= args.len { >> errors.new("missing value for --validator") }
            validator = args[i] + ""
        } else if project_path.len == 0 {
            project_path = arg
        } else {
            >> errors.new("unexpected argument: " + arg)
        }
        i = i + 1
    }
    if project_path.len == 0 || output_dir.len == 0 {
        >> errors.new("usage: nexus-project build <project.json> --output <dir> [--validator <bin>]")
    }
    res := proj.publish(project_path, output_dir, validator) >>>
    println(res.generation + " rebuilt=" + str(res.rebuilt_assets) + " reused=" + str(res.reused_assets))
    << 0
}

fn run_scene(args &[]string) int {
    if has_help_flag(args, 2) {
        println("usage: nexus-project scene <name> --output <dir>")
        << 0
    }
    $name := ""
    $output_dir := ""
    $i := 2
    while i < args.len {
        arg := args[i] + ""
        if arg == "--output" {
            i = i + 1
            if i >= args.len { >> errors.new("missing value for --output") }
            output_dir = args[i] + ""
        } else if name.len == 0 {
            name = arg
        } else {
            >> errors.new("unexpected argument: " + arg)
        }
        i = i + 1
    }
    if name.len == 0 || output_dir.len == 0 {
        >> errors.new("usage: nexus-project scene <name> --output <dir>")
    }
    resolved := proj.published_scene(output_dir, name) >>>
    println(resolved)
    << 0
}

fn run_register(args &[]string) int {
    if has_help_flag(args, 2) {
        println("usage: nexus-project register <project.json> <source>")
        << 0
    }
    if args.len != 4 {
        >> errors.new("usage: nexus-project register <project.json> <source>")
    }
    uid := proj.register_asset(args[2] + "", args[3] + "") >>>
    println(uid)
    << 0
}

fn run_relocate(args &[]string) int {
    if has_help_flag(args, 2) {
        println("usage: nexus-project relocate <project.json> <uid> <source>")
        << 0
    }
    if args.len != 5 {
        >> errors.new("usage: nexus-project relocate <project.json> <uid> <source>")
    }
    proj.relocate_asset(args[2] + "", args[3] + "", args[4] + "") >>>
    println(args[3] + "")
    << 0
}

fn run_bundle_pack(args &[]string) int {
    if has_help_flag(args, 2) {
        println("usage: nexus-project bundle-pack <project.json> --output <dir> --bundle-id <id> --sequence <N> --key <secret>")
        << 0
    }
    $project_path := ""
    $output_dir := ""
    $bundle_id := ""
    $seq_str := ""
    $signing_key := ""
    $i := 2
    while i < args.len {
        arg := args[i] + ""
        if arg == "--output" && i + 1 < args.len {
            output_dir = args[i + 1] + ""
            i = i + 2
        } else if arg == "--bundle-id" && i + 1 < args.len {
            bundle_id = args[i + 1] + ""
            i = i + 2
        } else if arg == "--sequence" && i + 1 < args.len {
            seq_str = args[i + 1] + ""
            i = i + 2
        } else if arg == "--key" && i + 1 < args.len {
            signing_key = args[i + 1] + ""
            i = i + 2
        } else if project_path.len == 0 {
            project_path = arg
            i = i + 1
        } else {
            >> errors.new("unexpected argument in bundle-pack: " + arg)
        }
    }
    if project_path.len == 0 || output_dir.len == 0 || bundle_id.len == 0 || seq_str.len == 0 || signing_key.len == 0 {
        >> errors.new("usage: nexus-project bundle-pack <project.json> --output <dir> --bundle-id <id> --sequence <N> --key <secret>")
    }
    seq := strconv.atoi(&seq_str) >>>
    project := proj.load_project(project_path + "") >>>
    $sources := []bm.BundleSource{}
    proj_bytes := snapshot.read(project.path + "", bm.MAX_ASSET_BYTES) >>>
    sources.push(bm.BundleSource{key: "project", rel_path: "project.json", bytes: proj_bytes})
    for si in 0:project.scenes.len {
        ent := &project.scenes[si]
        raw := snapshot.read(ent.resolved + "", bm.MAX_ASSET_BYTES) >>>
        sources.push(bm.BundleSource{key: "scene:" + ent.key, rel_path: ent.path + "", bytes: raw})
    }
    for ai in 0:project.assets.len {
        ent := &project.assets[ai]
        raw := snapshot.read(ent.resolved + "", bm.MAX_ASSET_BYTES) >>>
        sources.push(bm.BundleSource{key: "asset:" + ent.key, rel_path: ent.path + "", bytes: raw})
    }
    cfgs := collect_project_runtime_configs(&project)
    for ci in 0:cfgs.len {
        ent := &cfgs[ci]
        raw := snapshot.read(ent.resolved + "", bm.MAX_ASSET_BYTES) >>>
        sources.push(bm.BundleSource{key: "config:" + ent.key, rel_path: ent.path + "", bytes: raw})
    }
    manifest := bm.pack_bundle(output_dir + "", bundle_id + "", seq, &sources, &signing_key) >>>
    println("PACKED " + manifest.bundle_id + " seq=" + str(manifest.sequence) + " entries=" + str(manifest.entries.len))
    << 0
}

fn run_bundle_verify(args &[]string) int {
    if has_help_flag(args, 2) {
        println("usage: nexus-project bundle-verify <bundle_dir> --key <secret>")
        << 0
    }
    $bundle_dir := ""
    $signing_key := ""
    $i := 2
    while i < args.len {
        arg := args[i] + ""
        if arg == "--key" && i + 1 < args.len {
            signing_key = args[i + 1] + ""
            i = i + 2
        } else if bundle_dir.len == 0 {
            bundle_dir = arg
            i = i + 1
        } else {
            >> errors.new("unexpected argument in bundle-verify: " + arg)
        }
    }
    if bundle_dir.len == 0 || signing_key.len == 0 {
        >> errors.new("usage: nexus-project bundle-verify <bundle_dir> --key <secret>")
    }
    $mount := bm.new_mount()
    mount.verify_and_stage(bundle_dir + "", &signing_key) >>>
    println("VERIFIED " + mount.manifest.bundle_id + " seq=" + str(mount.manifest.sequence) + " entries=" + str(mount.manifest.entries.len))
    << 0
}

fn run_steam_validate(args &[]string) int {
    if has_help_flag(args, 2) {
        println("usage: nexus-project steam-validate <steam.json>")
        << 0
    }
    if args.len != 3 {
        >> errors.new("usage: nexus-project steam-validate <steam.json>")
    }
    raw := snapshot.read(args[2] + "", 1048576) >>>
    cfg := rs.decode_config_json(&raw) >>>
    println("VALID app_id=" + str(cfg.app_id) + " depot_id=" + str(cfg.depot_id) +
        " achievements=" + str(cfg.achievement_ids.len) +
        " stats=" + str(cfg.stat_defs.len) +
        " dlcs=" + str(cfg.dlc_ids.len))
    << 0
}

fn write_staged_file(content_dir &string, rel_path &string, raw &string, manifest_entries $&[]string) int {
    clean := proj.relative_file(rel_path) >>>
    dest := filepath.join([content_dir + "", clean + ""])
    os.mkdir_all(filepath.dir(dest)) >>>
    snapshot.write_atomic(dest + "", raw) >>>
    digest := sha256.sum256(raw + "")
    c_s := clean + ""
    d_s := digest + ""
    manifest_entries.push("    {\"path\": " + json.quote(&c_s) + ", \"bytes\": " + str(raw.len) + ", \"sha256\": " + json.quote(&d_s) + "}")
    << 0
}

fn try_optional_config_entry(project &proj.Project, key string, rel &string, out $&[]proj.Entry) {
    if rel.len == 0 { << }
    resolved := proj.project_source(&project.directory, rel) >>> (err) {
        _ := err.msg()
        <<
    }
    out.push(proj.Entry{key: key + "", path: *rel + "", resolved: resolved})
}

fn collect_project_runtime_configs(project &proj.Project) []proj.Entry {
    $out := []proj.Entry{}
    if !project.has_paths { << out }
    try_optional_config_entry(project, "locales", &project.paths.locales, $&out)
    try_optional_config_entry(project, "input_bindings", &project.paths.input_bindings, $&out)
    try_optional_config_entry(project, "perf_budgets", &project.paths.perf_budgets, $&out)
    try_optional_config_entry(project, "platform_mapping", &project.paths.platform_mapping, $&out)
    << out
}

fn resolve_platform_cfg(project &proj.Project, explicit &string, configured &string, flag_name string) string {
    if explicit.len > 0 {
        << *explicit + ""
    }
    if project.has_platforms && configured.len > 0 {
        << proj.project_source(&project.directory, configured) >>>
    }
    >> errors.new("missing required " + flag_name + " (or declare it in project.json platforms)")
    << ""
}

fn run_init(args &[]string) int {
    if has_help_flag(args, 2) {
        println("usage: nexus-project init <dir> --name <Name> [--id <com.studio.game>] [--module <mod>] [--template 3d|2d|25d|blank] [--locale <en-US>] [--platforms <all|none|csv>] [--nexus-path <path>] [--force]")
        << 0
    }
    $dir := ""
    $name := ""
    $id := ""
    $mod_name := ""
    $template := "3d"
    $locale := "en-US"
    $plats_raw := "all"
    $nexus_path := ""
    $force := false
    $i := 2
    while i < args.len {
        arg := args[i] + ""
        if arg == "--name" && i + 1 < args.len {
            name = args[i + 1] + ""
            i = i + 2
        } else if arg == "--id" && i + 1 < args.len {
            id = args[i + 1] + ""
            i = i + 2
        } else if arg == "--module" && i + 1 < args.len {
            mod_name = args[i + 1] + ""
            i = i + 2
        } else if arg == "--template" && i + 1 < args.len {
            template = args[i + 1] + ""
            i = i + 2
        } else if arg == "--locale" && i + 1 < args.len {
            locale = args[i + 1] + ""
            i = i + 2
        } else if arg == "--platforms" && i + 1 < args.len {
            plats_raw = args[i + 1] + ""
            i = i + 2
        } else if arg == "--nexus-path" && i + 1 < args.len {
            nexus_path = args[i + 1] + ""
            i = i + 2
        } else if arg == "--force" {
            force = true
            i = i + 1
        } else if dir.len == 0 {
            dir = arg
            i = i + 1
        } else {
            >> errors.new("unexpected argument in init: " + arg)
        }
    }
    if dir.len == 0 || name.len == 0 {
        >> errors.new("usage: nexus-project init <dir> --name <Name> [--id <com.studio.game>] [--module <mod>] [--template 3d|2d|25d|blank] [--locale <en-US>] [--platforms <all|none|csv>] [--nexus-path <path>] [--force]")
    }
    plats := rp.parse_platform_list(&plats_raw) >>>
    opts := proj.InitOptions{
        dir: dir,
        name: name,
        id: id,
        module_name: mod_name,
        template: template + "",
        default_locale: locale,
        nexus_path: nexus_path,
        platforms: plats,
        force: force
    }
    res := proj.init_project(&opts) >>>
    println("INITIALIZED " + res.project_dir + " template=" + template +
        " dirs=" + str(res.dirs_created) + " files=" + str(res.files_created.len))
    << 0
}

fn println_block(text &string) {
    if text.len > 0 && (text[text.len - 1] & 255) == 10 {
        println(text[0 : text.len - 1] + "")
        <<
    }
    println(*text + "")
}

fn run_doctor(args &[]string) int {
    if has_help_flag(args, 2) {
        println("usage: nexus-project doctor <project.json> [--json] [--strict]")
        << 0
    }
    $project_path := ""
    $as_json := false
    $strict := false
    $i := 2
    while i < args.len {
        arg := args[i] + ""
        if arg == "--json" {
            as_json = true
            i = i + 1
        } else if arg == "--strict" {
            strict = true
            i = i + 1
        } else if project_path.len == 0 {
            project_path = arg
            i = i + 1
        } else {
            >> errors.new("unexpected argument in doctor: " + arg)
        }
    }
    if project_path.len == 0 {
        >> errors.new("usage: nexus-project doctor <project.json> [--json] [--strict]")
    }
    rep := proj.diagnose_project(project_path)
    if as_json {
        println_block(&proj.encode_doctor_report_json(&rep))
    } else {
        println_block(&proj.format_doctor_report(&rep))
    }
    if !rep.passed || (strict && rep.warning_count > 0) {
        >> errors.new("nexus project doctor found errors=" + str(rep.error_count) + " warnings=" + str(rep.warning_count))
    }
    << 0
}

fn run_layout(args &[]string) int {
    _ := args
    println_block(&rp.format_layout_spec())
    << 0
}

fn run_steam_stage(args &[]string) int {
    if has_help_flag(args, 2) {
        println("usage: nexus-project steam-stage <project.json> [--steam <steam.json>] --output <dir> [--desc <text>] [--preview] [--binary <path>]")
        << 0
    }
    $project_path := ""
    $steam_path := ""
    $output_dir := ""
    $desc := "Nexus SteamPipe build"
    $preview := false
    $bin_path := ""
    $i := 2
    while i < args.len {
        arg := args[i] + ""
        if arg == "--steam" && i + 1 < args.len {
            steam_path = args[i + 1] + ""
            i = i + 2
        } else if arg == "--output" && i + 1 < args.len {
            output_dir = args[i + 1] + ""
            i = i + 2
        } else if arg == "--desc" && i + 1 < args.len {
            desc = args[i + 1] + ""
            i = i + 2
        } else if arg == "--binary" && i + 1 < args.len {
            bin_path = args[i + 1] + ""
            i = i + 2
        } else if arg == "--preview" {
            preview = true
            i = i + 1
        } else if project_path.len == 0 {
            project_path = arg
            i = i + 1
        } else {
            >> errors.new("unexpected argument in steam-stage: " + arg)
        }
    }
    if project_path.len == 0 || output_dir.len == 0 {
        >> errors.new("usage: nexus-project steam-stage <project.json> [--steam <steam.json>] --output <dir> [--desc <text>] [--preview] [--binary <path>]")
    }
    project := proj.load_project(project_path + "") >>>
    resolved_steam := resolve_platform_cfg(&project, &steam_path, &project.platforms.steam, "--steam") >>>
    steam_raw := snapshot.read(resolved_steam + "", 1048576) >>>
    $cfg := rs.decode_config_json(&steam_raw) >>>
    cfg.content_root = "../content"
    cfg.build_output = "../output"
    content_dir := filepath.join([output_dir + "", "content"])
    scripts_dir := filepath.join([output_dir + "", "scripts"])
    depot_out_dir := filepath.join([output_dir + "", "output"])
    os.mkdir_all(content_dir + "") >>>
    os.mkdir_all(scripts_dir + "") >>>
    os.mkdir_all(depot_out_dir + "") >>>

    $manifest_entries := []string{}
    proj_raw := snapshot.read(project.path + "", bm.MAX_ASSET_BYTES) >>>
    write_staged_file(&content_dir, &"project.json", &proj_raw, $&manifest_entries) >>>
    for si in 0:project.scenes.len {
        ent := &project.scenes[si]
        raw := snapshot.read(ent.resolved + "", bm.MAX_ASSET_BYTES) >>>
        write_staged_file(&content_dir, &ent.path, &raw, $&manifest_entries) >>>
    }
    for ai in 0:project.assets.len {
        ent := &project.assets[ai]
        raw := snapshot.read(ent.resolved + "", bm.MAX_ASSET_BYTES) >>>
        write_staged_file(&content_dir, &ent.path, &raw, $&manifest_entries) >>>
    }
    cfgs := collect_project_runtime_configs(&project)
    for ci in 0:cfgs.len {
        ent := &cfgs[ci]
        raw := snapshot.read(ent.resolved + "", bm.MAX_ASSET_BYTES) >>>
        write_staged_file(&content_dir, &ent.path, &raw, $&manifest_entries) >>>
    }
    if bin_path.len > 0 {
        b_raw := snapshot.read(bin_path + "", bm.MAX_ASSET_BYTES) >>>
        bin_arg := bin_path + ""
        b_name := filepath.base(bin_arg)
        write_staged_file(&content_dir, &b_name, &b_raw, $&manifest_entries) >>>
    }
    appid_txt := rs.generate_steam_appid_txt(cfg.app_id) >>>
    write_staged_file(&content_dir, &"steam_appid.txt", &appid_txt, $&manifest_entries) >>>

    depot_vdf := rs.generate_depot_build_vdf(&cfg) >>>
    app_vdf := rs.generate_app_build_vdf(&cfg, desc + "", preview) >>>
    snapshot.write_atomic(filepath.join([scripts_dir + "", "depot_build_" + str(cfg.depot_id) + ".vdf"]), &depot_vdf) >>>
    snapshot.write_atomic(filepath.join([scripts_dir + "", "app_build_" + str(cfg.app_id) + ".vdf"]), &app_vdf) >>>

    br_s := cfg.branch + ""
    staged_count := manifest_entries.len
    $mb := strings.new_byte_builder(512)
    mb.write_str("{\n")
    mb.write_str("  \"app_id\": " + str(cfg.app_id) + ",\n")
    mb.write_str("  \"depot_id\": " + str(cfg.depot_id) + ",\n")
    mb.write_str("  \"branch\": " + json.quote(&br_s) + ",\n")
    mb.write_str("  \"files\": [\n")
    mb.write_str(strings.join(manifest_entries, ",\n"))
    mb.write_str("\n  ]\n}\n")
    mraw := mb.to_string()
    snapshot.write_atomic(filepath.join([output_dir + "", "steam_stage_manifest.json"]), &mraw) >>>

    println("STAGED app_id=" + str(cfg.app_id) + " depot_id=" + str(cfg.depot_id) + " files=" + str(staged_count))
    << 0
}

fn copy_project_into_content(project &proj.Project, content_dir &string, bin_path &string,
        manifest_entries $&[]string, rel_list $&[]string) int {
    proj_raw := snapshot.read(project.path + "", bm.MAX_ASSET_BYTES) >>>
    write_staged_file(content_dir, &"project.json", &proj_raw, manifest_entries) >>>
    rel_list.push("project.json")
    for si in 0:project.scenes.len {
        ent := &project.scenes[si]
        raw := snapshot.read(ent.resolved + "", bm.MAX_ASSET_BYTES) >>>
        write_staged_file(content_dir, &ent.path, &raw, manifest_entries) >>>
        rel_list.push(ent.path + "")
    }
    for ai in 0:project.assets.len {
        ent := &project.assets[ai]
        raw := snapshot.read(ent.resolved + "", bm.MAX_ASSET_BYTES) >>>
        write_staged_file(content_dir, &ent.path, &raw, manifest_entries) >>>
        rel_list.push(ent.path + "")
    }
    cfgs := collect_project_runtime_configs(project)
    for ci in 0:cfgs.len {
        ent := &cfgs[ci]
        raw := snapshot.read(ent.resolved + "", bm.MAX_ASSET_BYTES) >>>
        write_staged_file(content_dir, &ent.path, &raw, manifest_entries) >>>
        rel_list.push(ent.path + "")
    }
    if bin_path.len > 0 {
        b_raw := snapshot.read(bin_path + "", bm.MAX_ASSET_BYTES) >>>
        bin_arg := bin_path + ""
        b_name := filepath.base(bin_arg)
        write_staged_file(content_dir, &b_name, &b_raw, manifest_entries) >>>
        rel_list.push(b_name)
    }
    << 0
}

fn run_xbox_validate(args &[]string) int {
    if has_help_flag(args, 2) {
        println("usage: nexus-project xbox-validate <xbox.json>")
        << 0
    }
    if args.len != 3 { >> errors.new("usage: nexus-project xbox-validate <xbox.json>") }
    raw := snapshot.read(args[2] + "", 1048576) >>>
    cfg := rc.decode_xbox_config_json(&raw) >>>
    rep := rc.audit_xbox_certification(&cfg, 90)
    if !rep.passed {
        >> errors.new("nexus xbox: certification audit failed: " + rep.issues[0].message)
    }
    println("VALID_XBOX store_id=" + cfg.store_id + " title_id=" + cfg.title_id_hex +
        " achievements=" + str(cfg.achievement_ids.len) + " dlcs=" + str(cfg.dlc_store_ids.len) + " xr_pass=true")
    << 0
}

fn run_xbox_stage(args &[]string) int {
    if has_help_flag(args, 2) {
        println("usage: nexus-project xbox-stage <project.json> --xbox <xbox.json> --output <dir> [--binary <path>]")
        << 0
    }
    $project_path := ""
    $xbox_path := ""
    $output_dir := ""
    $bin_path := ""
    $i := 2
    while i < args.len {
        arg := args[i] + ""
        if arg == "--xbox" && i + 1 < args.len {
            xbox_path = args[i + 1] + ""
            i = i + 2
        } else if arg == "--output" && i + 1 < args.len {
            output_dir = args[i + 1] + ""
            i = i + 2
        } else if arg == "--binary" && i + 1 < args.len {
            bin_path = args[i + 1] + ""
            i = i + 2
        } else if project_path.len == 0 {
            project_path = arg
            i = i + 1
        } else {
            >> errors.new("unexpected argument in xbox-stage: " + arg)
        }
    }
    if project_path.len == 0 || output_dir.len == 0 {
        >> errors.new("usage: nexus-project xbox-stage <project.json> [--xbox <xbox.json>] --output <dir> [--binary <path>]")
    }
    project := proj.load_project(project_path + "") >>>
    resolved_xbox := resolve_platform_cfg(&project, &xbox_path, &project.platforms.xbox, "--xbox") >>>
    xraw := snapshot.read(resolved_xbox + "", 1048576) >>>
    cfg := rc.decode_xbox_config_json(&xraw) >>>
    rep := rc.audit_xbox_certification(&cfg, 90)
    if !rep.passed { >> errors.new("nexus xbox: XR certification failed") }

    content_dir := filepath.join([output_dir + "", "content"])
    os.mkdir_all(content_dir + "") >>>
    $manifest_entries := []string{}
    $rel_list := []string{}
    copy_project_into_content(&project, &content_dir, &bin_path, $&manifest_entries, $&rel_list) >>>

    game_cfg_xml := rc.generate_microsoft_game_config_xml(&cfg) >>>
    write_staged_file(&content_dir, &"MicrosoftGame.config", &game_cfg_xml, $&manifest_entries) >>>
    rel_list.push("MicrosoftGame.config")

    layout_xml := rc.generate_xbox_layout_xml(&cfg, &rel_list) >>>
    snapshot.write_atomic(filepath.join([output_dir + "", "layout.xml"]), &layout_xml) >>>

    tid_s := cfg.title_id_hex + ""
    sid_s := cfg.store_id + ""
    staged_count := manifest_entries.len
    $mb := strings.new_byte_builder(512)
    mb.write_str("{\n")
    mb.write_str("  \"title_id\": " + json.quote(&tid_s) + ",\n")
    mb.write_str("  \"store_id\": " + json.quote(&sid_s) + ",\n")
    mb.write_str("  \"xr_passed\": true,\n")
    mb.write_str("  \"files\": [\n" + strings.join(manifest_entries, ",\n") + "\n  ]\n}\n")
    mraw := mb.to_string()
    snapshot.write_atomic(filepath.join([output_dir + "", "xbox_stage_manifest.json"]), &mraw) >>>

    println("STAGED_XBOX title_id=" + cfg.title_id_hex + " files=" + str(staged_count))
    << 0
}

