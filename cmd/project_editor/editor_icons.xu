@main

#ui
#ui/draw
#ui/layout
widgets #ui/widgets
#math
#time

pub const ICON_OPEN = 1
pub const ICON_SCENE_ADD = 2
pub const ICON_SCENE_MGR = 3
pub const ICON_GLOBALS = 4
pub const ICON_UNDO = 5
pub const ICON_REDO = 6
pub const ICON_SAVE = 7
pub const ICON_PREVIEW = 8
pub const ICON_EXPORT = 9
pub const ICON_UP = 10
pub const ICON_DOWN = 11
pub const ICON_EYE = 12
pub const ICON_EYE_OFF = 13
pub const ICON_ADD_3D = 14
pub const ICON_ADD_2D = 15
pub const ICON_ADD_GRP = 16
pub const ICON_ADD_CAM = 17
pub const ICON_ADD_LGT = 18
pub const ICON_DUP = 19
pub const ICON_DEL = 20
pub const ICON_IMPORT = 21
pub const ICON_RELOCATE = 22
pub const ICON_GRID_SNAP = 23
pub const ICON_FIT = 24
pub const ICON_VIEW3D = 25
pub const ICON_SLIDERS = 26
pub const ICON_BOX = 27
pub const ICON_WEDGE = 28
pub const ICON_STAIR = 29
pub const ICON_CYL = 30
pub const ICON_ARCH = 31
pub const ICON_CSG = 32
pub const ICON_EXTRUDE = 33
pub const ICON_INSET = 34
pub const ICON_BEVEL = 35
pub const ICON_UV = 36
pub const ICON_WIRE = 37
pub const ICON_SPLIT = 38
pub const ICON_TILEMAP = 39
pub const ICON_EXPORT_GLB = 40
pub const ICON_SPHERE = 41
pub const ICON_MOVE = 42
pub const ICON_ROTATE = 43
pub const ICON_SCALE = 44
pub const ICON_SUBDIV = 45
pub const ICON_FLIP = 46
pub const ICON_DEL_FACE = 47
pub const ICON_WELD = 48
pub const ICON_MODE_OBJ = 49
pub const ICON_MODE_VERT = 50
pub const ICON_MODE_EDGE = 51
pub const ICON_MODE_FACE = 52
pub const ICON_GRID_VIEW = 53
pub const ICON_VIEW_TOP = 54
pub const ICON_VIEW_FRONT = 55
pub const ICON_VIEW_RIGHT = 56
pub const ICON_TM_BRUSH = 57
pub const ICON_TM_ERASE = 58
pub const ICON_TM_RECT = 59
pub const ICON_TM_FILL = 60
pub const ICON_TM_PICK = 61
pub const ICON_CHEVRON_LEFT = 62
pub const ICON_CHEVRON_RIGHT = 63
pub const ICON_TWOSIDED = 64

pub fn paint_icon_button(btn &widgets.Button, empty_lbl $&widgets.StyledLabel, icon int, frame $&draw.Frame, styles &widgets.Styles) int {
    btn.paint_styled(frame, empty_lbl, styles) or >>
    c := btn.style_or(styles)
    state := btn.visual_state()
    $fg := c.resolve(state).foreground
    if !btn.is_enabled() {
        fg = c.palette.muted.with_alpha(150)
    }
    b := btn.bounds()
    $sz := 14.0
    if math.min(b.width, b.height) >= 29.0 {
        sz = 15.0
    }
    paint_vector_icon(frame, icon, b.x + b.width * 0.5, b.y + b.height * 0.5, sz, fg) or >>
    << 0
}

fn draw_plus_badge(frame $&draw.Frame, px f64, py f64, r f64, col draw.Color) int {
    frame.line(px - r, py, px + r, py, col, 1.6) or >>
    frame.line(px, py - r, px, py + r, col, 1.6) or >>
    << 0
}

pub fn paint_vector_icon(frame $&draw.Frame, icon int, cx f64, cy f64, sz f64, col draw.Color) int {
    h := sz * 0.5
    s := math.max(1.3, sz * 0.105)
    if icon == ICON_OPEN {
        // Folder open silhouette
        frame.stroke_round_rect(cx - h, cy - h * 0.65, sz, sz * 0.80, 1.6, col, s) or >>
        frame.line(cx - h, cy - h * 0.20, cx + h, cy - h * 0.20, col, s) or >>
        frame.fill_round_rect(cx - h, cy - h * 0.85, sz * 0.44, sz * 0.26, 1.0, col) or >>
    } else if icon == ICON_SCENE_ADD {
        // Document with plus corner
        frame.stroke_round_rect(cx - h * 0.82, cy - h * 0.88, sz * 0.68, sz * 0.88, 1.4, col, s) or >>
        frame.line(cx - h * 0.52, cy - h * 0.25, cx + h * 0.14, cy - h * 0.25, col, 1.2) or >>
        draw_plus_badge(frame, cx + h * 0.56, cy + h * 0.50, sz * 0.22, col) or >>
    } else if icon == ICON_SCENE_MGR {
        // Stacked layers
        frame.stroke_round_rect(cx - h * 0.85, cy - h * 0.82, sz * 0.85, sz * 0.34, 1.2, col, s) or >>
        frame.line(cx - h * 0.78, cy + h * 0.15, cx + h * 0.78, cy + h * 0.15, col, s) or >>
        frame.line(cx - h * 0.78, cy + h * 0.65, cx + h * 0.78, cy + h * 0.65, col, s) or >>
    } else if icon == ICON_GLOBALS {
        // Audio / route mixer nodes
        frame.line(cx - h * 0.48, cy - h * 0.85, cx - h * 0.48, cy + h * 0.85, col, s) or >>
        frame.line(cx + h * 0.48, cy - h * 0.85, cx + h * 0.48, cy + h * 0.85, col, s) or >>
        frame.fill_circle(cx - h * 0.48, cy - h * 0.26, sz * 0.17, col) or >>
        frame.fill_circle(cx + h * 0.48, cy + h * 0.26, sz * 0.17, col) or >>
    } else if icon == ICON_UNDO {
        // Curved left arrow
        frame.arc(cx + h * 0.10, cy + h * 0.16, sz * 0.44, 185.0, 175.0, col, s) or >>
        frame.line(cx - h * 0.65, cy - h * 0.12, cx - h * 0.18, cy - h * 0.12, col, s) or >>
        frame.line(cx - h * 0.65, cy - h * 0.12, cx - h * 0.35, cy - h * 0.52, col, s) or >>
        frame.line(cx - h * 0.65, cy - h * 0.12, cx - h * 0.35, cy + h * 0.24, col, s) or >>
    } else if icon == ICON_REDO {
        // Curved right arrow
        frame.arc(cx - h * 0.10, cy + h * 0.16, sz * 0.44, 180.0, 175.0, col, s) or >>
        frame.line(cx + h * 0.65, cy - h * 0.12, cx + h * 0.18, cy - h * 0.12, col, s) or >>
        frame.line(cx + h * 0.65, cy - h * 0.12, cx + h * 0.35, cy - h * 0.52, col, s) or >>
        frame.line(cx + h * 0.65, cy - h * 0.12, cx + h * 0.35, cy + h * 0.24, col, s) or >>
    } else if icon == ICON_SAVE {
        // Floppy disk
        frame.stroke_round_rect(cx - h * 0.86, cy - h * 0.86, sz * 0.86, sz * 0.86, 1.6, col, s) or >>
        frame.fill_rect(cx - h * 0.44, cy - h * 0.82, sz * 0.44, sz * 0.28, col) or >>
        frame.stroke_round_rect(cx - h * 0.48, cy + h * 0.10, sz * 0.48, sz * 0.36, 1.0, col, 1.2) or >>
    } else if icon == ICON_PREVIEW {
        // Play triangle
        frame.fill_triangle(cx - h * 0.45, cy - h * 0.72, cx + h * 0.72, cy, cx - h * 0.45, cy + h * 0.72, col) or >>
    } else if icon == ICON_EXPORT {
        // Tray + upward arrow
        frame.line(cx - h * 0.82, cy + h * 0.22, cx - h * 0.82, cy + h * 0.78, col, s) or >>
        frame.line(cx - h * 0.82, cy + h * 0.78, cx + h * 0.82, cy + h * 0.78, col, s) or >>
        frame.line(cx + h * 0.82, cy + h * 0.78, cx + h * 0.82, cy + h * 0.22, col, s) or >>
        frame.line(cx, cy + h * 0.32, cx, cy - h * 0.78, col, s) or >>
        frame.line(cx - h * 0.42, cy - h * 0.36, cx, cy - h * 0.78, col, s) or >>
        frame.line(cx + h * 0.42, cy - h * 0.36, cx, cy - h * 0.78, col, s) or >>
    } else if icon == ICON_UP {
        frame.line(cx - h * 0.56, cy + h * 0.26, cx, cy - h * 0.34, col, s * 1.1) or >>
        frame.line(cx, cy - h * 0.34, cx + h * 0.56, cy + h * 0.26, col, s * 1.1) or >>
    } else if icon == ICON_DOWN {
        frame.line(cx - h * 0.56, cy - h * 0.26, cx, cy + h * 0.34, col, s * 1.1) or >>
        frame.line(cx, cy + h * 0.34, cx + h * 0.56, cy - h * 0.26, col, s * 1.1) or >>
    } else if icon == ICON_EYE || icon == ICON_EYE_OFF {
        // Eye outline + pupil (plus slash for off)
        frame.arc(cx, cy + h * 0.52, sz * 0.56, 225.0, 90.0, col, s) or >>
        frame.arc(cx, cy - h * 0.52, sz * 0.56, 45.0, 90.0, col, s) or >>
        frame.fill_circle(cx, cy, sz * 0.14, col) or >>
        if icon == ICON_EYE_OFF {
            frame.line(cx - h * 0.72, cy + h * 0.62, cx + h * 0.72, cy - h * 0.62, col, s) or >>
        }
    } else if icon == ICON_ADD_3D {
        // Isometric wireframe cube + plus
        frame.stroke_triangle(cx, cy - h * 0.85, cx + h * 0.66, cy - h * 0.42, cx, cy, col, 1.2) or >>
        frame.stroke_triangle(cx, cy - h * 0.85, cx - h * 0.66, cy - h * 0.42, cx, cy, col, 1.2) or >>
        frame.line(cx - h * 0.66, cy - h * 0.42, cx - h * 0.66, cy + h * 0.42, col, 1.2) or >>
        frame.line(cx - h * 0.66, cy + h * 0.42, cx, cy + h * 0.82, col, 1.2) or >>
        frame.line(cx, cy, cx, cy + h * 0.82, col, 1.2) or >>
        draw_plus_badge(frame, cx + h * 0.55, cy + h * 0.50, sz * 0.21, col) or >>
    } else if icon == ICON_ADD_2D {
        // 2D rounded frame + plus
        frame.stroke_round_rect(cx - h * 0.80, cy - h * 0.78, sz * 0.64, sz * 0.64, 1.4, col, s) or >>
        draw_plus_badge(frame, cx + h * 0.52, cy + h * 0.48, sz * 0.21, col) or >>
    } else if icon == ICON_ADD_GRP {
        // Folder/Group + plus
        frame.stroke_round_rect(cx - h * 0.84, cy - h * 0.56, sz * 0.74, sz * 0.56, 1.4, col, s) or >>
        frame.fill_rect(cx - h * 0.84, cy - h * 0.78, sz * 0.34, sz * 0.22, col) or >>
        draw_plus_badge(frame, cx + h * 0.52, cy + h * 0.48, sz * 0.21, col) or >>
    } else if icon == ICON_ADD_CAM {
        // Camera body + lens frustum
        frame.stroke_round_rect(cx - h * 0.85, cy - h * 0.48, sz * 0.56, sz * 0.48, 1.4, col, s) or >>
        frame.stroke_triangle(cx + h * 0.32, cy, cx + h * 0.86, cy - h * 0.38, cx + h * 0.86, cy + h * 0.38, col, s) or >>
        frame.fill_circle(cx - h * 0.28, cy, sz * 0.11, col) or >>
    } else if icon == ICON_ADD_LGT {
        // Sun / point light rays
        frame.stroke_circle(cx, cy, sz * 0.22, col, s) or >>
        frame.line(cx, cy - h * 0.86, cx, cy - h * 0.54, col, s) or >>
        frame.line(cx, cy + h * 0.54, cx, cy + h * 0.86, col, s) or >>
        frame.line(cx - h * 0.86, cy, cx - h * 0.54, cy, col, s) or >>
        frame.line(cx + h * 0.54, cy, cx + h * 0.86, cy, col, s) or >>
        frame.line(cx - h * 0.62, cy - h * 0.62, cx - h * 0.40, cy - h * 0.40, col, s) or >>
        frame.line(cx + h * 0.40, cy + h * 0.40, cx + h * 0.62, cy + h * 0.62, col, s) or >>
        frame.line(cx - h * 0.62, cy + h * 0.62, cx - h * 0.40, cy + h * 0.40, col, s) or >>
        frame.line(cx + h * 0.40, cy - h * 0.40, cx + h * 0.62, cy - h * 0.62, col, s) or >>
    } else if icon == ICON_DUP {
        // Overlapping squares
        frame.stroke_round_rect(cx - h * 0.82, cy - h * 0.82, sz * 0.56, sz * 0.56, 1.2, col, s) or >>
        frame.stroke_round_rect(cx - h * 0.24, cy - h * 0.24, sz * 0.56, sz * 0.56, 1.2, col, s) or >>
    } else if icon == ICON_DEL {
        // Trash can
        frame.line(cx - h * 0.72, cy - h * 0.48, cx + h * 0.72, cy - h * 0.48, col, s) or >>
        frame.line(cx - h * 0.26, cy - h * 0.78, cx + h * 0.26, cy - h * 0.78, col, s) or >>
        frame.stroke_round_rect(cx - h * 0.54, cy - h * 0.42, sz * 0.54, sz * 0.66, 1.2, col, s) or >>
        frame.line(cx - h * 0.16, cy - h * 0.12, cx - h * 0.16, cy + h * 0.54, col, 1.1) or >>
        frame.line(cx + h * 0.16, cy - h * 0.12, cx + h * 0.16, cy + h * 0.54, col, 1.1) or >>
    } else if icon == ICON_IMPORT {
        // Tray + downward arrow
        frame.line(cx - h * 0.82, cy + h * 0.22, cx - h * 0.82, cy + h * 0.78, col, s) or >>
        frame.line(cx - h * 0.82, cy + h * 0.78, cx + h * 0.82, cy + h * 0.78, col, s) or >>
        frame.line(cx + h * 0.82, cy + h * 0.78, cx + h * 0.82, cy + h * 0.22, col, s) or >>
        frame.line(cx, cy - h * 0.82, cx, cy + h * 0.34, col, s) or >>
        frame.line(cx - h * 0.40, cy - h * 0.06, cx, cy + h * 0.34, col, s) or >>
        frame.line(cx + h * 0.40, cy - h * 0.06, cx, cy + h * 0.34, col, s) or >>
    } else if icon == ICON_RELOCATE {
        // Folder + curved link arrow
        frame.stroke_round_rect(cx - h * 0.86, cy - h * 0.66, sz * 0.68, sz * 0.56, 1.2, col, s) or >>
        frame.line(cx + h * 0.08, cy + h * 0.48, cx + h * 0.78, cy - h * 0.22, col, s) or >>
        frame.line(cx + h * 0.32, cy - h * 0.22, cx + h * 0.78, cy - h * 0.22, col, s) or >>
        frame.line(cx + h * 0.78, cy + h * 0.24, cx + h * 0.78, cy - h * 0.22, col, s) or >>
    } else if icon == ICON_GRID_SNAP {
        // 3x3 snap grid dots + anchor ring
        frame.line(cx - h * 0.42, cy - h * 0.80, cx - h * 0.42, cy + h * 0.80, col, 1.2) or >>
        frame.line(cx + h * 0.42, cy - h * 0.80, cx + h * 0.42, cy + h * 0.80, col, 1.2) or >>
        frame.line(cx - h * 0.80, cy - h * 0.42, cx + h * 0.80, cy - h * 0.42, col, 1.2) or >>
        frame.line(cx - h * 0.80, cy + h * 0.42, cx + h * 0.80, cy + h * 0.42, col, 1.2) or >>
        frame.fill_circle(cx, cy, sz * 0.16, col) or >>
    } else if icon == ICON_FIT {
        // Four corner brackets
        k := h * 0.78
        arm := sz * 0.24
        frame.line(cx - k, cy - k, cx - k + arm, cy - k, col, s) or >>
        frame.line(cx - k, cy - k, cx - k, cy - k + arm, col, s) or >>
        frame.line(cx + k, cy - k, cx + k - arm, cy - k, col, s) or >>
        frame.line(cx + k, cy - k, cx + k, cy - k + arm, col, s) or >>
        frame.line(cx - k, cy + k, cx - k + arm, cy + k, col, s) or >>
        frame.line(cx - k, cy + k, cx - k, cy + k - arm, col, s) or >>
        frame.line(cx + k, cy + k, cx + k - arm, cy + k, col, s) or >>
        frame.line(cx + k, cy + k, cx + k, cy + k - arm, col, s) or >>
        frame.fill_circle(cx, cy, sz * 0.12, col) or >>
    } else if icon == ICON_VIEW3D {
        // Wireframe isometric 3D cube
        ty := cy - h * 0.88
        by := cy + h * 0.88
        uy := cy - h * 0.40
        ly := cy + h * 0.40
        rx := h * 0.78
        frame.line(cx, ty, cx + rx, uy, col, s) or >>
        frame.line(cx + rx, uy, cx + rx, ly, col, s) or >>
        frame.line(cx + rx, ly, cx, by, col, s) or >>
        frame.line(cx, by, cx - rx, ly, col, s) or >>
        frame.line(cx - rx, ly, cx - rx, uy, col, s) or >>
        frame.line(cx - rx, uy, cx, ty, col, s) or >>
        frame.line(cx - rx, uy, cx, cy, col, 1.2) or >>
        frame.line(cx + rx, uy, cx, cy, col, 1.2) or >>
        frame.line(cx, cy, cx, by, col, 1.2) or >>
    } else if icon == ICON_SLIDERS {
        // Horizontal sliders
        frame.line(cx - h * 0.82, cy - h * 0.46, cx + h * 0.82, cy - h * 0.46, col, s) or >>
        frame.line(cx - h * 0.82, cy, cx + h * 0.82, cy, col, s) or >>
        frame.line(cx - h * 0.82, cy + h * 0.46, cx + h * 0.82, cy + h * 0.46, col, s) or >>
        frame.fill_circle(cx - h * 0.30, cy - h * 0.46, sz * 0.14, col) or >>
        frame.fill_circle(cx + h * 0.32, cy, sz * 0.14, col) or >>
        frame.fill_circle(cx - h * 0.18, cy + h * 0.46, sz * 0.14, col) or >>
    } else if icon == ICON_BOX {
        frame.line(cx, cy - h * 0.86, cx + h * 0.78, cy - h * 0.42, col, s) or >>
        frame.line(cx + h * 0.78, cy - h * 0.42, cx, cy, col, s) or >>
        frame.line(cx, cy, cx - h * 0.78, cy - h * 0.42, col, s) or >>
        frame.line(cx - h * 0.78, cy - h * 0.42, cx, cy - h * 0.86, col, s) or >>
        frame.line(cx - h * 0.78, cy - h * 0.42, cx - h * 0.78, cy + h * 0.42, col, s) or >>
        frame.line(cx - h * 0.78, cy + h * 0.42, cx, cy + h * 0.86, col, s) or >>
        frame.line(cx, cy + h * 0.86, cx + h * 0.78, cy + h * 0.42, col, s) or >>
        frame.line(cx + h * 0.78, cy + h * 0.42, cx + h * 0.78, cy - h * 0.42, col, s) or >>
        frame.line(cx, cy, cx, cy + h * 0.86, col, 1.2) or >>
    } else if icon == ICON_WEDGE {
        frame.line(cx - h * 0.80, cy + h * 0.70, cx + h * 0.80, cy + h * 0.70, col, s) or >>
        frame.line(cx - h * 0.80, cy + h * 0.70, cx - h * 0.80, cy - h * 0.65, col, s) or >>
        frame.line(cx - h * 0.80, cy - h * 0.65, cx + h * 0.80, cy + h * 0.70, col, s) or >>
        frame.line(cx - h * 0.80, cy - h * 0.65, cx + h * 0.25, cy - h * 0.65, col, 1.2) or >>
        frame.line(cx + h * 0.25, cy - h * 0.65, cx + h * 0.80, cy + h * 0.70, col, 1.2) or >>
    } else if icon == ICON_STAIR {
        frame.line(cx - h * 0.82, cy + h * 0.76, cx + h * 0.82, cy + h * 0.76, col, s) or >>
        frame.line(cx - h * 0.82, cy + h * 0.76, cx - h * 0.82, cy + h * 0.22, col, s) or >>
        frame.line(cx - h * 0.82, cy + h * 0.22, cx - h * 0.28, cy + h * 0.22, col, s) or >>
        frame.line(cx - h * 0.28, cy + h * 0.22, cx - h * 0.28, cy - h * 0.30, col, s) or >>
        frame.line(cx - h * 0.28, cy - h * 0.30, cx + h * 0.28, cy - h * 0.30, col, s) or >>
        frame.line(cx + h * 0.28, cy - h * 0.30, cx + h * 0.28, cy - h * 0.76, col, s) or >>
        frame.line(cx + h * 0.28, cy - h * 0.76, cx + h * 0.82, cy - h * 0.76, col, s) or >>
        frame.line(cx + h * 0.82, cy - h * 0.76, cx + h * 0.82, cy + h * 0.76, col, s) or >>
    } else if icon == ICON_CYL {
        frame.stroke_ellipse(cx, cy - h * 0.56, h * 0.68, h * 0.26, col, s) or >>
        frame.arc(cx, cy + h * 0.54, h * 0.68, 0.0, 180.0, col, s) or >>
        frame.line(cx - h * 0.68, cy - h * 0.56, cx - h * 0.68, cy + h * 0.54, col, s) or >>
        frame.line(cx + h * 0.68, cy - h * 0.56, cx + h * 0.68, cy + h * 0.54, col, s) or >>
    } else if icon == ICON_ARCH {
        frame.line(cx - h * 0.78, cy + h * 0.78, cx - h * 0.78, cy - h * 0.16, col, s) or >>
        frame.line(cx + h * 0.78, cy + h * 0.78, cx + h * 0.78, cy - h * 0.16, col, s) or >>
        frame.arc(cx, cy - h * 0.16, h * 0.78, 180.0, 180.0, col, s) or >>
        frame.arc(cx, cy + h * 0.06, h * 0.38, 180.0, 180.0, col, 1.2) or >>
        frame.line(cx - h * 0.38, cy + h * 0.06, cx - h * 0.38, cy + h * 0.78, col, 1.2) or >>
        frame.line(cx + h * 0.38, cy + h * 0.06, cx + h * 0.38, cy + h * 0.78, col, 1.2) or >>
    } else if icon == ICON_CSG {
        frame.stroke_round_rect(cx - h * 0.82, cy - h * 0.82, sz * 0.54, sz * 0.54, 1.2, col, s) or >>
        frame.stroke_round_rect(cx - h * 0.24, cy - h * 0.24, sz * 0.54, sz * 0.54, 1.2, col, s) or >>
    } else if icon == ICON_EXTRUDE {
        frame.stroke_rect(cx - h * 0.72, cy + h * 0.12, sz * 0.72, sz * 0.34, col, s) or >>
        frame.line(cx, cy + h * 0.10, cx, cy - h * 0.82, col, s) or >>
        frame.line(cx - h * 0.36, cy - h * 0.44, cx, cy - h * 0.82, col, s) or >>
        frame.line(cx + h * 0.36, cy - h * 0.44, cx, cy - h * 0.82, col, s) or >>
    } else if icon == ICON_INSET {
        frame.stroke_round_rect(cx - h * 0.80, cy - h * 0.80, sz * 0.80, sz * 0.80, 1.2, col, s) or >>
        frame.stroke_round_rect(cx - h * 0.36, cy - h * 0.36, sz * 0.36, sz * 0.36, 1.0, col, 1.2) or >>
    } else if icon == ICON_BEVEL {
        frame.line(cx - h * 0.80, cy + h * 0.72, cx - h * 0.80, cy - h * 0.20, col, s) or >>
        frame.line(cx - h * 0.80, cy - h * 0.20, cx - h * 0.14, cy - h * 0.76, col, s) or >>
        frame.line(cx - h * 0.14, cy - h * 0.76, cx + h * 0.78, cy - h * 0.76, col, s) or >>
        frame.line(cx + h * 0.78, cy - h * 0.76, cx + h * 0.78, cy + h * 0.72, col, s) or >>
        frame.line(cx - h * 0.80, cy + h * 0.72, cx + h * 0.78, cy + h * 0.72, col, s) or >>
    } else if icon == ICON_UV {
        frame.stroke_rect(cx - h * 0.76, cy - h * 0.76, sz * 0.76, sz * 0.76, col, s) or >>
        frame.line(cx, cy - h * 0.76, cx, cy + h * 0.76, col, 1.1) or >>
        frame.line(cx - h * 0.76, cy, cx + h * 0.76, cy, col, 1.1) or >>
    } else if icon == ICON_WIRE {
        frame.stroke_round_rect(cx - h * 0.76, cy - h * 0.76, sz * 0.76, sz * 0.76, 1.4, col, s) or >>
        frame.line(cx - h * 0.76, cy - h * 0.76, cx + h * 0.76, cy + h * 0.76, col, 1.1) or >>
        frame.line(cx - h * 0.76, cy + h * 0.76, cx + h * 0.76, cy - h * 0.76, col, 1.1) or >>
    } else if icon == ICON_SPLIT {
        frame.stroke_round_rect(cx - h * 0.84, cy - h * 0.68, sz * 0.84, sz * 0.68, 1.4, col, s) or >>
        frame.line(cx + h * 0.04, cy - h * 0.68, cx + h * 0.04, cy + h * 0.68, col, s) or >>
    } else if icon == ICON_TILEMAP {
        frame.stroke_rect(cx - h * 0.78, cy - h * 0.78, sz * 0.34, sz * 0.34, col, 1.2) or >>
        frame.stroke_rect(cx + h * 0.08, cy - h * 0.78, sz * 0.34, sz * 0.34, col, 1.2) or >>
        frame.stroke_rect(cx - h * 0.78, cy + h * 0.08, sz * 0.34, sz * 0.34, col, 1.2) or >>
        frame.stroke_rect(cx + h * 0.08, cy + h * 0.08, sz * 0.34, sz * 0.34, col, 1.2) or >>
    } else if icon == ICON_EXPORT_GLB {
        frame.line(cx - h * 0.78, cy + h * 0.22, cx - h * 0.78, cy + h * 0.76, col, s) or >>
        frame.line(cx - h * 0.78, cy + h * 0.76, cx + h * 0.78, cy + h * 0.76, col, s) or >>
        frame.line(cx + h * 0.78, cy + h * 0.76, cx + h * 0.78, cy + h * 0.22, col, s) or >>
        frame.line(cx, cy + h * 0.28, cx, cy - h * 0.76, col, s) or >>
        frame.line(cx - h * 0.38, cy - h * 0.38, cx, cy - h * 0.76, col, s) or >>
        frame.line(cx + h * 0.38, cy - h * 0.38, cx, cy - h * 0.76, col, s) or >>
    } else if icon == ICON_SPHERE {
        frame.stroke_circle(cx, cy, h * 0.74, col, s) or >>
        frame.line(cx - h * 0.74, cy, cx + h * 0.74, cy, col, 1.0) or >>
        frame.line(cx, cy - h * 0.74, cx, cy + h * 0.74, col, 1.0) or >>
    } else if icon == ICON_MOVE {
        frame.line(cx - h * 0.78, cy, cx + h * 0.78, cy, col, s) or >>
        frame.line(cx, cy - h * 0.78, cx, cy + h * 0.78, col, s) or >>
        frame.line(cx - h * 0.25, cy - h * 0.50, cx, cy - h * 0.78, col, s) or >>
        frame.line(cx + h * 0.25, cy - h * 0.50, cx, cy - h * 0.78, col, s) or >>
        frame.line(cx + h * 0.50, cy - h * 0.25, cx + h * 0.78, cy, col, s) or >>
        frame.line(cx + h * 0.50, cy + h * 0.25, cx + h * 0.78, cy, col, s) or >>
    } else if icon == ICON_ROTATE {
        frame.stroke_circle(cx, cy, h * 0.66, col, s) or >>
        frame.line(cx + h * 0.30, cy - h * 0.74, cx + h * 0.68, cy - h * 0.24, col, s) or >>
        frame.line(cx + h * 0.72, cy - h * 0.68, cx + h * 0.68, cy - h * 0.24, col, s) or >>
    } else if icon == ICON_SCALE {
        frame.stroke_rect(cx - h * 0.70, cy - h * 0.70, sz * 0.70, sz * 0.70, col, s) or >>
        frame.fill_rect(cx + h * 0.16, cy - h * 0.78, sz * 0.30, sz * 0.30, col) or >>
        frame.line(cx - h * 0.10, cy + h * 0.10, cx + h * 0.56, cy - h * 0.56, col, s) or >>
    } else if icon == ICON_SUBDIV {
        frame.stroke_rect(cx - h * 0.74, cy - h * 0.74, sz * 0.74, sz * 0.74, col, s) or >>
        frame.line(cx, cy - h * 0.74, cx, cy + h * 0.74, col, 1.1) or >>
        frame.line(cx - h * 0.74, cy, cx + h * 0.74, cy, col, 1.1) or >>
    } else if icon == ICON_FLIP {
        frame.line(cx - h * 0.72, cy + h * 0.45, cx + h * 0.72, cy + h * 0.45, col, s) or >>
        frame.line(cx, cy + h * 0.45, cx, cy - h * 0.68, col, s) or >>
        frame.line(cx - h * 0.34, cy - h * 0.30, cx, cy - h * 0.68, col, s) or >>
        frame.line(cx + h * 0.34, cy - h * 0.30, cx, cy - h * 0.68, col, s) or >>
    } else if icon == ICON_DEL_FACE {
        frame.stroke_rect(cx - h * 0.70, cy - h * 0.70, sz * 0.70, sz * 0.70, col, 1.1) or >>
        frame.line(cx - h * 0.42, cy - h * 0.42, cx + h * 0.42, cy + h * 0.42, col, s) or >>
        frame.line(cx - h * 0.42, cy + h * 0.42, cx + h * 0.42, cy - h * 0.42, col, s) or >>
    } else if icon == ICON_WELD {
        frame.fill_circle(cx, cy, h * 0.24, col) or >>
        frame.line(cx - h * 0.75, cy, cx - h * 0.24, cy, col, s) or >>
        frame.line(cx + h * 0.24, cy, cx + h * 0.75, cy, col, s) or >>
        frame.line(cx - h * 0.42, cy - h * 0.28, cx - h * 0.20, cy, col, s) or >>
        frame.line(cx + h * 0.42, cy + h * 0.28, cx + h * 0.20, cy, col, s) or >>
    } else if icon == ICON_MODE_OBJ {
        // Object selection corners around solid block
        k := h * 0.80
        arm := sz * 0.24
        frame.line(cx - k, cy - k, cx - k + arm, cy - k, col, s) or >>
        frame.line(cx - k, cy - k, cx - k, cy - k + arm, col, s) or >>
        frame.line(cx + k, cy - k, cx + k - arm, cy - k, col, s) or >>
        frame.line(cx + k, cy - k, cx + k, cy - k + arm, col, s) or >>
        frame.line(cx - k, cy + k, cx - k + arm, cy + k, col, s) or >>
        frame.line(cx - k, cy + k, cx - k, cy + k - arm, col, s) or >>
        frame.line(cx + k, cy + k, cx + k - arm, cy + k, col, s) or >>
        frame.line(cx + k, cy + k, cx + k, cy + k - arm, col, s) or >>
        frame.fill_round_rect(cx - h * 0.36, cy - h * 0.36, sz * 0.36, sz * 0.36, 1.4, col) or >>
    } else if icon == ICON_MODE_VERT {
        // Blender-style wireframe square with 4 emphasized vertex dots
        frame.stroke_rect(cx - h * 0.64, cy - h * 0.64, sz * 0.64, sz * 0.64, col.with_alpha(150), 1.1) or >>
        vr := sz * 0.145
        frame.fill_circle(cx - h * 0.64, cy - h * 0.64, vr, col) or >>
        frame.fill_circle(cx + h * 0.64, cy - h * 0.64, vr, col) or >>
        frame.fill_circle(cx - h * 0.64, cy + h * 0.64, vr, col) or >>
        frame.fill_circle(cx + h * 0.64, cy + h * 0.64, vr, col) or >>
    } else if icon == ICON_MODE_EDGE {
        // Blender-style wireframe square with bold highlighted top edge
        frame.stroke_rect(cx - h * 0.64, cy - h * 0.64, sz * 0.64, sz * 0.64, col.with_alpha(135), 1.0) or >>
        frame.fill_round_rect(cx - h * 0.70, cy - h * 0.76, sz * 0.70, 2.6, 1.0, col) or >>
    } else if icon == ICON_MODE_FACE {
        // Blender-style square with filled inner face quad
        frame.stroke_rect(cx - h * 0.68, cy - h * 0.68, sz * 0.68, sz * 0.68, col, 1.2) or >>
        frame.fill_rect(cx - h * 0.42, cy - h * 0.42, sz * 0.42, sz * 0.42, col.with_alpha(200)) or >>
    } else if icon == ICON_GRID_VIEW {
        // Perspective 3x3 floor grid (distinct from Grid Snap #•)
        y0 := cy - h * 0.58
        y1 := cy + h * 0.04
        y2 := cy + h * 0.66
        frame.line(cx - h * 0.52, y0, cx + h * 0.52, y0, col, 1.2) or >>
        frame.line(cx - h * 0.69, y1, cx + h * 0.69, y1, col, 1.2) or >>
        frame.line(cx - h * 0.86, y2, cx + h * 0.86, y2, col, s) or >>
        frame.line(cx - h * 0.52, y0, cx - h * 0.86, y2, col, s) or >>
        frame.line(cx - h * 0.18, y0, cx - h * 0.29, y2, col, 1.1) or >>
        frame.line(cx + h * 0.18, y0, cx + h * 0.29, y2, col, 1.1) or >>
        frame.line(cx + h * 0.52, y0, cx + h * 0.86, y2, col, s) or >>
    } else if icon == ICON_VIEW_TOP {
        frame.stroke_round_rect(cx - h * 0.76, cy - h * 0.76, sz * 0.76, sz * 0.76, 1.5, col, s) or >>
        frame.fill_rect(cx - h * 0.72, cy - h * 0.72, sz * 0.72, sz * 0.26, col) or >>
    } else if icon == ICON_VIEW_FRONT {
        frame.stroke_round_rect(cx - h * 0.76, cy - h * 0.76, sz * 0.76, sz * 0.76, 1.5, col, s) or >>
        frame.fill_round_rect(cx - h * 0.40, cy - h * 0.40, sz * 0.40, sz * 0.40, 1.0, col) or >>
    } else if icon == ICON_VIEW_RIGHT {
        frame.stroke_round_rect(cx - h * 0.76, cy - h * 0.76, sz * 0.76, sz * 0.76, 1.5, col, s) or >>
        frame.fill_rect(cx + h * 0.22, cy - h * 0.72, sz * 0.26, sz * 0.72, col) or >>
    } else if icon == ICON_TM_BRUSH {
        frame.line(cx + h * 0.72, cy - h * 0.72, cx - h * 0.10, cy + h * 0.10, col, 2.1) or >>
        frame.fill_circle(cx - h * 0.34, cy + h * 0.34, sz * 0.17, col) or >>
        frame.line(cx - h * 0.34, cy + h * 0.34, cx - h * 0.76, cy + h * 0.76, col, 1.7) or >>
    } else if icon == ICON_TM_ERASE {
        frame.line(cx - h * 0.78, cy + h * 0.68, cx + h * 0.78, cy + h * 0.68, col, 1.2) or >>
        frame.line(cx - h * 0.62, cy + h * 0.22, cx + h * 0.12, cy - h * 0.58, col, s) or >>
        frame.line(cx + h * 0.12, cy - h * 0.58, cx + h * 0.70, cy - h * 0.02, col, s) or >>
        frame.line(cx + h * 0.70, cy - h * 0.02, cx - h * 0.04, cy + h * 0.66, col, s) or >>
        frame.line(cx - h * 0.04, cy + h * 0.66, cx - h * 0.62, cy + h * 0.22, col, s) or >>
        frame.line(cx - h * 0.28, cy - h * 0.16, cx + h * 0.30, cy + h * 0.34, col, 1.1) or >>
    } else if icon == ICON_TM_RECT {
        k := h * 0.74
        arm := sz * 0.22
        frame.line(cx - k, cy - k, cx - k + arm, cy - k, col, s) or >>
        frame.line(cx - k, cy - k, cx - k, cy - k + arm, col, s) or >>
        frame.line(cx + k, cy - k, cx + k - arm, cy - k, col, s) or >>
        frame.line(cx + k, cy - k, cx + k, cy - k + arm, col, s) or >>
        frame.line(cx - k, cy + k, cx - k + arm, cy + k, col, s) or >>
        frame.line(cx - k, cy + k, cx - k, cy + k - arm, col, s) or >>
        frame.line(cx + k, cy + k, cx + k - arm, cy + k, col, s) or >>
        frame.line(cx + k, cy + k, cx + k, cy + k - arm, col, s) or >>
        frame.line(cx - h * 0.14, cy - k, cx + h * 0.14, cy - k, col, s) or >>
        frame.line(cx - h * 0.14, cy + k, cx + h * 0.14, cy + k, col, s) or >>
        frame.line(cx - k, cy - h * 0.14, cx - k, cy + h * 0.14, col, s) or >>
        frame.line(cx + k, cy - h * 0.14, cx + k, cy + h * 0.14, col, s) or >>
    } else if icon == ICON_TM_FILL {
        frame.line(cx - h * 0.68, cy - h * 0.06, cx - h * 0.08, cy - h * 0.66, col, s) or >>
        frame.line(cx - h * 0.08, cy - h * 0.66, cx + h * 0.44, cy - h * 0.14, col, s) or >>
        frame.line(cx + h * 0.44, cy - h * 0.14, cx - h * 0.16, cy + h * 0.46, col, s) or >>
        frame.line(cx - h * 0.16, cy + h * 0.46, cx - h * 0.68, cy - h * 0.06, col, s) or >>
        frame.line(cx + h * 0.44, cy - h * 0.14, cx + h * 0.62, cy + h * 0.26, col, 1.3) or >>
        frame.fill_circle(cx + h * 0.62, cy + h * 0.44, sz * 0.15, col) or >>
    } else if icon == ICON_TM_PICK {
        frame.line(cx - h * 0.72, cy + h * 0.72, cx + h * 0.30, cy - h * 0.30, col, 1.8) or >>
        frame.line(cx - h * 0.04, cy - h * 0.36, cx + h * 0.36, cy + h * 0.04, col, 1.6) or >>
        frame.fill_circle(cx + h * 0.52, cy - h * 0.52, sz * 0.19, col) or >>
    } else if icon == ICON_CHEVRON_LEFT {
        frame.line(cx + h * 0.26, cy - h * 0.52, cx - h * 0.30, cy, col, s) or >>
        frame.line(cx - h * 0.30, cy, cx + h * 0.26, cy + h * 0.52, col, s) or >>
    } else if icon == ICON_CHEVRON_RIGHT {
        frame.line(cx - h * 0.26, cy - h * 0.52, cx + h * 0.30, cy, col, s) or >>
        frame.line(cx + h * 0.30, cy, cx - h * 0.26, cy + h * 0.52, col, s) or >>
    } else if icon == ICON_TWOSIDED {
        frame.stroke_round_rect(cx - h * 0.76, cy - h * 0.72, sz * 0.54, sz * 0.54, 1.3, col.with_alpha(165), 1.2) or >>
        frame.fill_round_rect(cx - h * 0.18, cy - h * 0.16, sz * 0.54, sz * 0.54, 1.3, col.with_alpha(190)) or >>
        frame.stroke_round_rect(cx - h * 0.18, cy - h * 0.16, sz * 0.54, sz * 0.54, 1.3, col, 1.2) or >>
    }
    << 0
}

pub struct TooltipHit {
    pub id int
    pub text string
    pub anchor layout.Rect
}

pub fn empty_tooltip_hit() TooltipHit {
    << TooltipHit{id: 0, text: "", anchor: layout.Rect{x: 0.0, y: 0.0, width: 0.0, height: 0.0}}
}

pub struct TooltipState {
    pub target_id int
    pub text string
    pub anchor layout.Rect
    pub hovered_since time.Instant
    pub visible bool
    pub label widgets.StyledLabel
}

pub fn new_tooltip_state(ctx &draw.Context) TooltipState {
    << TooltipState{
        target_id: 0,
        text: "",
        anchor: layout.Rect{x: 0.0, y: 0.0, width: 0.0, height: 0.0},
        hovered_since: time.zero_instant(),
        visible: false,
        label: widgets.styled_label(ctx, &"")
    }
}

pub fn (t $&TooltipState) dispose() {
    dispose_label($&t.label)
}

fn tooltip_delay_dur() time.Duration {
    << time.duration(350000000)
}

fn tooltip_due_after(since time.Instant) time.Instant {
    if since.is_zero() { << time.zero_instant() }
    << since.add(tooltip_delay_dur()) or (err) {
        _ := err
        << time.zero_instant()
    }
}

pub fn (t $&TooltipState) dismiss() bool {
    was := t.visible
    t.target_id = 0
    t.text = ""
    t.hovered_since = time.zero_instant()
    t.visible = false
    << was
}

pub fn (t $&TooltipState) update_hover(hit &TooltipHit, now time.Instant) bool {
    if hit.id <= 0 || hit.text.len == 0 {
        << t.dismiss()
    }
    text_changed := t.text != hit.text
    if hit.id == t.target_id {
        t.anchor = copy_rect(&hit.anchor)
        if text_changed {
            txt := hit.text + ""
            t.text = txt + ""
            set_lbl_text($&t.label, &txt)
        }
        << t.visible && text_changed
    }
    was_vis := t.visible
    t.target_id = hit.id
    t.anchor = copy_rect(&hit.anchor)
    txt := hit.text + ""
    t.text = txt + ""
    set_lbl_text($&t.label, &txt)
    if was_vis {
        t.hovered_since = now
        t.visible = true
        << true
    }
    t.hovered_since = now
    t.visible = false
    << false
}

pub fn (t $&TooltipState) tick(now time.Instant) bool {
    if t.visible || t.target_id <= 0 || t.hovered_since.is_zero() {
        << false
    }
    due := tooltip_due_after(t.hovered_since)
    if due.is_zero() { << false }
    if !now.before(due) {
        t.visible = true
        << true
    }
    << false
}

pub fn (t &TooltipState) next_tick(cur time.Instant) time.Instant {
    if t.visible || t.target_id <= 0 || t.hovered_since.is_zero() {
        << cur
    }
    due := tooltip_due_after(t.hovered_since)
    if due.is_zero() { << cur }
    if cur.is_zero() || due.before(cur) { << due }
    << cur
}

pub fn (t $&TooltipState) paint(frame $&draw.Frame, viewport &layout.Rect, styles &widgets.Styles) int {
    if !t.visible || t.text.len == 0 { << 0 }
    $tip_style := styles.button.clone()
    tip_style.inherit_font = false
    tip_style.font = widgets.font_style(11.5)
    tip_style.padding = layout.Insets{left: 0.0, top: 0.0, right: 0.0, bottom: 0.0}
    tip_style.align_x = 0.0
    tip_style.align_y = 0.5
    tip_style.palette.foreground = draw.rgb(250, 247, 244)
    tip_style.states = []widgets.StatePaint{}

    anc := copy_rect(&t.anchor)
    lbl := $&t.label
    sz := lbl.measure_styled(styles, &tip_style) or >>
    pw := sz.width + 16.0
    ph := math.max(24.0, sz.height + 8.0)

    $px := anc.x + (anc.width - pw) * 0.5
    if px + pw > viewport.width - 6.0 { px = viewport.width - pw - 6.0 }
    if px < 6.0 { px = 6.0 }

    $py := anc.y - ph - 6.0
    if anc.y < 64.0 || py < 6.0 {
        py = anc.y + anc.height + 6.0
    }
    if py + ph > viewport.height - 6.0 {
        py = math.max(6.0, anc.y - ph - 6.0)
    }

    frame.fill_round_rect(px, py + 2.0, pw, ph, 6.0, draw.rgba(20, 15, 22, 46)) or >>
    frame.fill_round_rect(px, py, pw, ph, 6.0, draw.rgb(36, 31, 38)) or >>
    frame.stroke_round_rect(px, py, pw, ph, 6.0, draw.rgba(255, 255, 255, 34), 1.0) or >>
    box := layout.Rect{x: px + 8.0, y: py + 2.0, width: math.max(0.0, pw - 16.0), height: math.max(0.0, ph - 4.0)}
    lbl.paint_text_styled(frame, &box, styles, &tip_style, 0) or >>
    << 0
}
