@main

resource #"github.com/xulang-org/nexus/resources/scene"
fm #"github.com/xulang-org/nexus/foundation/math"
#ui
#ui/draw
#ui/layout
widgets #ui/widgets
#math
#path/filepath
#strconv
#strings
#time
#errors

pub const STATUS_INFO = 0
pub const STATUS_OK = 1
pub const STATUS_ERR = 2

const MIN_WINDOW_W = 940
const MIN_WINDOW_H = 560
const TOOLBAR_H = 44
const FOOTER_H = 28
const SPLITTER_W = 6
const MIN_LEFT_W = 215
const MIN_CENTER_W = 340
const MIN_RIGHT_W = 255

