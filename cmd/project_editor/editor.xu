    pub id_rot_lbl int
    pub id_rot_row int
    pub id_rot_x int
    pub id_rot_y int
    pub id_rot_z int
    pub id_scale_lbl int
    pub id_scale_row int
    pub id_scale_x int
    pub id_scale_y int
    pub id_scale_z int
    pub id_surf_info int
    pub id_apply_btn int
    pub id_footer int
    pub id_status_txt int
    pub id_footer_hint int

    pub scene_select widgets.Select
    pub scene_labels []widgets.StyledLabel
    pub empty_lbl widgets.StyledLabel
    pub no_asset_lbl widgets.StyledLabel
    pub root_parent_lbl widgets.StyledLabel
    pub scene_origin layout.Rect
    pub new_scene_btn widgets.Button
    pub new_scene_lbl widgets.StyledLabel
    pub undo_btn widgets.Button
    pub undo_lbl widgets.StyledLabel
    pub redo_btn widgets.Button
    pub redo_lbl widgets.StyledLabel
    pub save_btn widgets.Button
    pub save_lbl widgets.StyledLabel
    pub preview_btn widgets.Button
    pub preview_lbl widgets.StyledLabel

    pub add_3d_btn widgets.Button
    pub add_3d_lbl widgets.StyledLabel
    pub add_grp_btn widgets.Button
    pub add_grp_lbl widgets.StyledLabel
    pub dup_btn widgets.Button
    pub dup_lbl widgets.StyledLabel
    pub del_btn widgets.Button
    pub del_lbl widgets.StyledLabel
    pub tree widgets.TreeView
    pub tree_origin layout.Rect
    pub tree_to_scene map[int]int
    pub scene_to_tree map[int]int

    pub assets_div widgets.Divider
    pub import_btn widgets.Button
    pub import_lbl widgets.StyledLabel
    pub asset_select widgets.Select
    pub asset_labels []widgets.StyledLabel
    pub asset_origin layout.Rect
    pub prim_field widgets.Field
