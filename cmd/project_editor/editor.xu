    pub id_workspace int
    pub id_left_pane int
    pub id_tree_hdr int
    pub id_tree_btns int
    pub id_add_3d_btn int
    pub id_add_grp_btn int
    pub id_dup_btn int
    pub id_del_btn int
    pub id_tree int
    pub id_assets_div int
    pub id_assets_hdr_row int
    pub id_assets_hdr int
    pub id_import_btn int
    pub id_asset_select int
    pub id_asset_meta int
    pub id_asset_row int
    pub id_prim_field int
    pub id_place_btn int

    pub id_left_split int
    pub id_center_pane int
    pub id_stage_bar int
    pub id_stage_title int
    pub id_fit_btn int
    pub id_view3d_btn int
    pub id_snap_btn int
    pub id_top_view int

    pub id_right_split int
    pub id_right_pane int
    pub id_insp_hdr int
    pub id_name_field int
    pub id_visible_chk int
    pub id_parent_row int
    pub id_parent_select int
    pub id_reparent_btn int
    pub id_pos_lbl int
    pub id_pos_row int
