fn zero_rect() layout.Rect {
    << layout.Rect{x: 0.0, y: 0.0, width: 80.0, height: 28.0}
}

fn leaf_box(w f64, h f64) layout.BoxStyle {
    $b := layout.box_style(layout.BOX_LEAF)
    b.width = w
    b.height = h
    << b
}

fn row_box(w f64, h f64, gap f64) layout.BoxStyle {
    $b := layout.box_style(layout.BOX_ROW)
    b.width = w
    b.height = h
    b.gap = gap
    b.cross_alignment = layout.CROSS_CENTER
    << b
}

fn row_box_end(w f64, h f64, gap f64) layout.BoxStyle {
    $b := layout.box_style(layout.BOX_ROW)
    b.width = w
    b.height = h
    b.gap = gap
    b.cross_alignment = layout.CROSS_END
    << b
}

fn col_box(w f64, h f64, gap f64) layout.BoxStyle {
    $b := layout.box_style(layout.BOX_COLUMN)
    b.width = w
    b.height = h
    b.gap = gap
    b.cross_alignment = layout.CROSS_STRETCH
    << b
}

fn make_plain_field(context &draw.Context, identity &ui.CanvasEvent, id int, label string, val string) widgets.Field {
    $dec := widgets.field_decoration(&label)
    dec.reserve_helper = false
    << widgets.field(context, identity, id, &zero_rect(), &val, &dec) >>>
}

fn make_name_field(context &draw.Context, identity &ui.CanvasEvent, id int, val string) widgets.Field {
    $dec := widgets.field_decoration(&"Node name")
    dec.floating = widgets.LABEL_NEVER
    dec.clearable = true
    dec.reserve_helper = false
    $f := widgets.field(context, identity, id, &zero_rect(), &val, &dec) >>>
    $opts := widgets.field_text_options()
    opts.counter = false
    opts.character_limit = 255
    _ := f.set_text_options(&opts)
    << f
}

fn stage_mode_to_tab(mode int) int {
    if mode == STAGE_MODE_3D { << 0 }
    if mode == STAGE_MODE_SPLIT { << 1 }
    if mode == STAGE_MODE_TILEMAP { << 3 }
    << 2
}

fn stage_tab_to_mode(tab int) int {
    if tab == 0 { << STAGE_MODE_3D }
    if tab == 1 { << STAGE_MODE_SPLIT }
    if tab == 3 { << STAGE_MODE_TILEMAP }
    << STAGE_MODE_2D
}

fn make_stage_tab_labels(ctx &draw.Context, lang int) []widgets.StyledLabel {
    names := [tr(lang, "3D", "3D"), tr(lang, "Split", "分屏"), tr(lang, "2D", "2D"), tr(lang, "Tile", "瓦片")]
    $out := []widgets.StyledLabel{}
    for n in names { out.push(widgets.styled_label(ctx, &n)) }
    << out
}

fn make_left_tab_labels(ctx &draw.Context, lang int) []widgets.StyledLabel {
    names := [tr(lang, "Scene", "大纲"), tr(lang, "Assets", "资源")]
    $out := []widgets.StyledLabel{}
    for n in names { out.push(widgets.styled_label(ctx, &n)) }
    << out
}

fn make_insp_tab_labels(ctx &draw.Context, lang int, comp_cnt int) []widgets.StyledLabel {
    $c_lbl := tr(lang, "Comp", "组件")
    if comp_cnt > 0 { c_lbl = tr(lang, "Comp (" + str(comp_cnt) + ")", "组件 (" + str(comp_cnt) + ")") }
    names := [tr(lang, "Transform", "变换"), tr(lang, "Material", "材质"), c_lbl]
    $out := []widgets.StyledLabel{}
    for n in names { out.push(widgets.styled_label(ctx, &n)) }
    << out
}

fn make_add_node_labels(ctx &draw.Context, lang int) []widgets.StyledLabel {
    $names := ["+ Add Node", "+ Node3D", "+ Node2D", "+ Group", "+ Camera", "+ PointLight", "+ Sun Light", "+ Spot Light", "+ Environment", "+ Particle VFX"]
    if lang == LANG_ZH {
        names = ["+ 添加节点", "+ 3D 节点", "+ 2D 节点", "+ 节点组", "+ 相机", "+ 点光源", "+ 太阳光 (阴影)", "+ 聚光灯 (阴影)", "+ 环境/天空/后处理", "+ 3D 粒子特效"]
    }
    $out := []widgets.StyledLabel{}
    for n in names { out.push(widgets.styled_label(ctx, &n)) }
    << out
}

fn make_add_comp_labels(ctx &draw.Context, lang int) []widgets.StyledLabel {
    $names := ["+ Add Component...", "GLB Surface & LOD", "Camera", "Light & Shadow", "Script (.xubc)", "Audio Emitter", "Sprite3D", "TileMap2D", "Environment", "RigidBody3D", "Terrain", "ParticleEmitter3D", "PrefabInstance"]
    if lang == LANG_ZH {
        names = ["+ 添加组件...", "GLB 表面与 LOD", "相机", "光照与阴影", "脚本 (.xubc)", "音频发射器", "3D 精灵", "2D 瓦片地图", "环境与后处理", "3D 刚体碰撞", "地形网格", "3D 粒子发射器", "预制体实例"]
    }
    $out := []widgets.StyledLabel{}
    for n in names { out.push(widgets.styled_label(ctx, &n)) }
    << out
}

fn add_interactive(view $&widgets.View, parent int, box &layout.BoxStyle, cursor int, focusable bool) int {
    id := view.add(parent, box, &layout.Size{width: 0.0, height: 0.0}) >>>
    view.set_input(id, true, focusable) >>>
    view.set_cursor(id, cursor) >>>
    << id
}

fn add_box(view $&widgets.View, parent int, box &layout.BoxStyle) int {
    << view.add(parent, box, &layout.Size{width: 0.0, height: 0.0}) >>>
}

pub fn create_editor_view(context &draw.Context, identity &ui.CanvasEvent, width f64, height f64) widgets.View {
    pal := default_palette()
    $root_b := col_box(width, height, 0.0)
    root_b.clip = true
    $host := widgets.Host{
        context: context.clone(),
        identity: ui.CanvasEvent{window_id: identity.window_id, canvas_id: identity.canvas_id, generation: identity.generation}
    }
    << host.view(&root_b, pal.canvas) >>>
}

pub fn create_editor(
    view $&widgets.View,
    context &draw.Context,
    identity &ui.CanvasEvent,
    project Project,
    output_dir string,
    validator_bin string,
    preview_bin string,
    viewport_bin string,
    width f64,
    height f64
) Editor {
    pal := default_palette()
    styles := make_paper_styles(&pal)
    snap := load_snap_settings(&output_dir)
    lang := load_editor_lang(&output_dir)

    scene_path := project.scene_source(0) >>>
    draft := open_draft(scene_path) >>>

    id_root := view.root()
    view.set_auto_cursor(false)
    view.set_styles(&styles) >>>
    $panels := new_panels_shell()

    // 1. Toolbar (centered stage mode switcher)
    $tb := row_box(width, f64(TOOLBAR_H), 4.0)
    tb.padding = layout.Insets{left: 8.0, top: 6.0, right: 8.0, bottom: 6.0}
    id_toolbar := add_box(view, id_root, &tb)
    view.set_boundary(id_toolbar, true) >>>

    id_brand := add_box(view, id_toolbar, &leaf_box(54.0, 26.0))
    _ := panels_add_open_btn($&panels, view, id_toolbar, context, identity) >>>
    id_tb_div1 := add_box(view, id_toolbar, &leaf_box(6.0, 22.0))
    id_scene_select := add_interactive(view, id_toolbar, &leaf_box(184.0, 28.0), ui.CURSOR_HAND, true)
    id_new_scene_btn := add_interactive(view, id_toolbar, &leaf_box(28.0, 28.0), ui.CURSOR_HAND, true)
    _ := panels_add_scene_mgr_btn($&panels, view, id_toolbar, context, identity) >>>
    id_globals_btn := add_interactive(view, id_toolbar, &leaf_box(28.0, 28.0), ui.CURSOR_HAND, true)
    id_tb_spacer_l := add_box(view, id_toolbar, &leaf_box(8.0, 24.0))
    id_stage_tabs := add_interactive(view, id_toolbar, &leaf_box(204.0, 28.0), ui.CURSOR_HAND, true)
    id_tb_spacer := add_box(view, id_toolbar, &leaf_box(8.0, 24.0))
    id_undo_btn := add_interactive(view, id_toolbar, &leaf_box(28.0, 28.0), ui.CURSOR_HAND, true)
    id_redo_btn := add_interactive(view, id_toolbar, &leaf_box(28.0, 28.0), ui.CURSOR_HAND, true)
    id_save_btn := add_interactive(view, id_toolbar, &leaf_box(28.0, 28.0), ui.CURSOR_HAND, true)
    id_tb_div2 := add_box(view, id_toolbar, &leaf_box(6.0, 22.0))
    id_preview_btn := add_interactive(view, id_toolbar, &leaf_box(28.0, 28.0), ui.CURSOR_HAND, true)
    _ := panels_add_export_btn($&panels, view, id_toolbar, context, identity) >>>
    id_tb_div3 := add_box(view, id_toolbar, &leaf_box(6.0, 22.0))
    _ := panels_add_lang_btn($&panels, view, id_toolbar, context, identity, lang) >>>
    id_dirty_badge := add_box(view, id_toolbar, &leaf_box(76.0, 24.0))

    // 2. Workspace
    body_h := math.max(200.0, height - f64(TOOLBAR_H) - f64(FOOTER_H))
    left_w := 248.0
    right_w := 300.0
    center_w := math.max(f64(MIN_CENTER_W), width - left_w - right_w - f64(SPLITTER_W) * 2.0)
    $ws := row_box(width, body_h, 0.0)
    ws.cross_alignment = layout.CROSS_STRETCH
    id_workspace := add_box(view, id_root, &ws)

    // Left pane (Dual-Tab: Scene | Assets)
    $lp := col_box(left_w, body_h, 0.0)
    lp.padding = layout.Insets{left: 8.0, top: 8.0, right: 8.0, bottom: 8.0}
    lp.clip = true
    id_left_pane := add_box(view, id_workspace, &lp)
    view.set_boundary(id_left_pane, true) >>>
    inner_lw := left_w - 16.0
    left_body_h := math.max(120.0, body_h - 44.0)
    id_left_tabs := add_interactive(view, id_left_pane, &leaf_box(inner_lw, 28.0), ui.CURSOR_HAND, true)

    $sc_box := col_box(inner_lw, left_body_h, 4.0)
    sc_box.padding = layout.Insets{left: 0.0, top: 6.0, right: 0.0, bottom: 0.0}
    sc_box.clip = true
    id_left_scene_box := add_box(view, id_left_pane, &sc_box)
    id_tree_hdr := panels_create_tree_tools($&panels, view, id_left_scene_box, inner_lw, context, identity) >>>
    id_tree_btns := add_box(view, id_left_scene_box, &row_box(inner_lw, 28.0, 4.0))
    id_add_node_select := add_interactive(view, id_tree_btns, &leaf_box(math.max(70.0, inner_lw - 56.0), 26.0), ui.CURSOR_HAND, true)
    id_dup_btn := add_interactive(view, id_tree_btns, &leaf_box(24.0, 24.0), ui.CURSOR_HAND, true)
    id_del_btn := add_interactive(view, id_tree_btns, &leaf_box(24.0, 24.0), ui.CURSOR_HAND, true)
    tree_h := math.max(84.0, left_body_h - 102.0)
    id_tree := add_interactive(view, id_left_scene_box, &leaf_box(inner_lw, tree_h), ui.CURSOR_DEFAULT, true)
    view.set_capture_outside(id_tree, true) >>>

    $as_box := col_box(inner_lw, 0.0, 0.0)
    as_box.clip = true
    id_left_assets_box := add_box(view, id_left_pane, &as_box)
    id_assets_hdr_row := add_box(view, id_left_assets_box, &row_box(inner_lw, 26.0, 3.0))
    id_assets_hdr := add_box(view, id_assets_hdr_row, &leaf_box(math.max(50.0, inner_lw - 84.0), 24.0))
    id_import_btn := add_interactive(view, id_assets_hdr_row, &leaf_box(25.0, 24.0), ui.CURSOR_HAND, true)
    _ := panels_add_asset_hdr_btns($&panels, view, id_assets_hdr_row, context, identity) >>>
