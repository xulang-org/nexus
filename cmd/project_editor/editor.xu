    pub reparent_lbl widgets.StyledLabel

    pub pos_x widgets.Field
    pub pos_y widgets.Field
    pub pos_z widgets.Field
    pub rot_x widgets.Field
    pub rot_y widgets.Field
    pub rot_z widgets.Field
    pub scale_x widgets.Field
    pub scale_y widgets.Field
    pub scale_z widgets.Field
    pub rot_seed_x string
    pub rot_seed_y string
    pub rot_seed_z string
