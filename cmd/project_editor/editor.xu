        view.set_style(ed.id_pos_y, &leaf_box(0.0, 0.0)) >>>
        view.set_style(ed.id_pos_z, &leaf_box(0.0, 0.0)) >>>
        view.set_style(ed.id_rot_lbl, &leaf_box(0.0, 0.0)) >>>
        view.set_style(ed.id_rot_row, &row_box(scroll_cw, 0.0, 0.0)) >>>
        view.set_style(ed.id_rot_x, &leaf_box(0.0, 0.0)) >>>
        view.set_style(ed.id_rot_y, &leaf_box(0.0, 0.0)) >>>
        view.set_style(ed.id_rot_z, &leaf_box(0.0, 0.0)) >>>
        view.set_style(ed.id_scale_lbl, &leaf_box(0.0, 0.0)) >>>
        view.set_style(ed.id_scale_row, &row_box(scroll_cw, 0.0, 0.0)) >>>
        view.set_style(ed.id_scale_x, &leaf_box(0.0, 0.0)) >>>
        view.set_style(ed.id_scale_y, &leaf_box(0.0, 0.0)) >>>
        view.set_style(ed.id_scale_z, &leaf_box(0.0, 0.0)) >>>
        view.set_style(ed.id_xf_div, &leaf_box(0.0, 0.0)) >>>
        view.set_style(ed.id_parent_row, &row_box(scroll_cw, 0.0, 0.0)) >>>
        view.set_style(ed.id_parent_select, &leaf_box(0.0, 0.0)) >>>
        view.set_style(ed.id_reparent_btn, &leaf_box(0.0, 0.0)) >>>
        view.set_style(ed.id_vis_proc_row, &row_box(scroll_cw, 0.0, 0.0)) >>>
        view.set_style(ed.id_process_select, &leaf_box(0.0, 0.0)) >>>

        $mat_h := 90.0
        if has_node3d_mat { mat_h = 346.0 }
        $tmat := col_box(scroll_cw, mat_h, 4.0)
        tmat.clip = true
        tmat.padding = layout.Insets{left: 0.0, top: 4.0, right: 0.0, bottom: 6.0}
        view.set_style(ed.id_tab_material_box, &tmat) >>>

        $zc := col_box(scroll_cw, 0.0, 0.0)
        zc.clip = true
        view.set_style(ed.id_tab_comp_box, &zc) >>>
        view.set_style(ed.id_add_comp_row, &row_box(scroll_cw, 0.0, 0.0)) >>>
        view.set_style(ed.id_add_comp_select, &leaf_box(0.0, 0.0)) >>>
        $zs := col_box(scroll_cw, 0.0, 0.0)
        zs.clip = true
        view.set_style(ed.id_surf_box, &zs) >>>
        view.set_style(ed.id_surf_div, &leaf_box(0.0, 0.0)) >>>
        view.set_style(ed.id_surf_card_hdr, &leaf_box(0.0, 0.0)) >>>
        view.set_style(ed.id_surf_info, &leaf_box(0.0, 0.0)) >>>
        view.set_style(ed.id_surf_bind_row, &row_box(scroll_cw, 0.0, 0.0)) >>>
        view.set_style(ed.id_surf_asset_select, &leaf_box(0.0, 0.0)) >>>
        view.set_style(ed.id_surf_btn_row, &row_box(scroll_cw, 0.0, 0.0)) >>>
        view.set_style(ed.id_surf_prim_field, &leaf_box(0.0, 0.0)) >>>
        view.set_style(ed.id_surf_bind_btn, &leaf_box(0.0, 0.0)) >>>
        view.set_style(ed.id_surf_clear_btn, &leaf_box(0.0, 0.0)) >>>
        view.set_style(ed.id_lod_info, &leaf_box(0.0, 0.0)) >>>
        view.set_style(ed.id_lod_input_row, &row_box(scroll_cw, 0.0, 0.0)) >>>
        view.set_style(ed.id_lod_hyst_field, &leaf_box(0.0, 0.0)) >>>
        view.set_style(ed.id_lod_dist_field, &leaf_box(0.0, 0.0)) >>>
        view.set_style(ed.id_lod_prim_field, &leaf_box(0.0, 0.0)) >>>
        view.set_style(ed.id_lod_btn_row, &row_box(scroll_cw, 0.0, 0.0)) >>>
        view.set_style(ed.id_lod_asset_select, &leaf_box(0.0, 0.0)) >>>
        view.set_style(ed.id_lod_add_btn, &leaf_box(0.0, 0.0)) >>>
        view.set_style(ed.id_lod_pop_btn, &leaf_box(0.0, 0.0)) >>>
        view.set_style(ed.id_comp_empty_lbl, &leaf_box(scroll_cw, 0.0)) >>>
        $man_open := []bool{}
        for mf in ed.comp_manual_open { man_open.push(mf) }
        _ := sync_comp_layout($&ed.comp, view, scroll_cw, false, &man_open) >>>
        ed.insp_tab_content_h = mat_h
    } else {
        $zxf := col_box(scroll_cw, 0.0, 0.0)
        zxf.clip = true
        view.set_style(ed.id_tab_transform_box, &zxf) >>>
        view.set_style(ed.id_pos_lbl, &leaf_box(0.0, 0.0)) >>>
        view.set_style(ed.id_pos_row, &row_box(scroll_cw, 0.0, 0.0)) >>>
        view.set_style(ed.id_pos_x, &leaf_box(0.0, 0.0)) >>>
        view.set_style(ed.id_pos_y, &leaf_box(0.0, 0.0)) >>>
        view.set_style(ed.id_pos_z, &leaf_box(0.0, 0.0)) >>>
        view.set_style(ed.id_rot_lbl, &leaf_box(0.0, 0.0)) >>>
        view.set_style(ed.id_rot_row, &row_box(scroll_cw, 0.0, 0.0)) >>>
        view.set_style(ed.id_rot_x, &leaf_box(0.0, 0.0)) >>>
        view.set_style(ed.id_rot_y, &leaf_box(0.0, 0.0)) >>>
        view.set_style(ed.id_rot_z, &leaf_box(0.0, 0.0)) >>>
        view.set_style(ed.id_scale_lbl, &leaf_box(0.0, 0.0)) >>>
        view.set_style(ed.id_scale_row, &row_box(scroll_cw, 0.0, 0.0)) >>>
        view.set_style(ed.id_scale_x, &leaf_box(0.0, 0.0)) >>>
        view.set_style(ed.id_scale_y, &leaf_box(0.0, 0.0)) >>>
        view.set_style(ed.id_scale_z, &leaf_box(0.0, 0.0)) >>>
        view.set_style(ed.id_xf_div, &leaf_box(0.0, 0.0)) >>>
        view.set_style(ed.id_parent_row, &row_box(scroll_cw, 0.0, 0.0)) >>>
        view.set_style(ed.id_parent_select, &leaf_box(0.0, 0.0)) >>>
        view.set_style(ed.id_reparent_btn, &leaf_box(0.0, 0.0)) >>>
        view.set_style(ed.id_vis_proc_row, &row_box(scroll_cw, 0.0, 0.0)) >>>
        view.set_style(ed.id_process_select, &leaf_box(0.0, 0.0)) >>>

        $zmat := col_box(scroll_cw, 0.0, 0.0)
        zmat.clip = true
        view.set_style(ed.id_tab_material_box, &zmat) >>>

        view.set_style(ed.id_add_comp_row, &row_box(scroll_cw, 34.0, 0.0)) >>>
        view.set_style(ed.id_add_comp_select, &leaf_box(scroll_cw, 28.0)) >>>

        surf_vis := ed.surf_attached || (ed.comp_manual_open.len > 0 && ed.comp_manual_open[0])
        $surf_h := 0.0
        if surf_vis {
            surf_h = 248.0
            $sbx := col_box(scroll_cw, surf_h, 4.0)
            sbx.padding = layout.Insets{left: 0.0, top: 6.0, right: 0.0, bottom: 6.0}
            sbx.clip = true
            view.set_style(ed.id_surf_box, &sbx) >>>
            view.set_style(ed.id_surf_div, &leaf_box(scroll_cw, 4.0)) >>>
            view.set_style(ed.id_surf_card_hdr, &leaf_box(scroll_cw, 18.0)) >>>
            view.set_style(ed.id_surf_info, &leaf_box(scroll_cw, 18.0)) >>>
            view.set_style(ed.id_surf_bind_row, &row_box(scroll_cw, 30.0, 4.0)) >>>
            view.set_style(ed.id_surf_asset_select, &leaf_box(scroll_cw, 30.0)) >>>
            view.set_style(ed.id_surf_btn_row, &row_box_end(scroll_cw, 44.0, 4.0)) >>>
            view.set_style(ed.id_surf_prim_field, &leaf_box(58.0, 44.0)) >>>
            sbtn_w := math.max(48.0, (scroll_cw - 66.0) * 0.5)
            view.set_style(ed.id_surf_bind_btn, &leaf_box(sbtn_w, 34.0)) >>>
            view.set_style(ed.id_surf_clear_btn, &leaf_box(sbtn_w, 34.0)) >>>
            view.set_style(ed.id_lod_info, &leaf_box(scroll_cw, 18.0)) >>>
            view.set_style(ed.id_lod_input_row, &row_box(scroll_cw, 44.0, 4.0)) >>>
            view.set_style(ed.id_lod_hyst_field, &leaf_box(tri_w, 44.0)) >>>
            view.set_style(ed.id_lod_dist_field, &leaf_box(tri_w, 44.0)) >>>
            view.set_style(ed.id_lod_prim_field, &leaf_box(tri_w, 44.0)) >>>
            view.set_style(ed.id_lod_btn_row, &row_box(scroll_cw, 30.0, 4.0)) >>>
            view.set_style(ed.id_lod_asset_select, &leaf_box(math.max(84.0, scroll_cw - 112.0), 30.0)) >>>
            view.set_style(ed.id_lod_add_btn, &leaf_box(52.0, 30.0)) >>>
            view.set_style(ed.id_lod_pop_btn, &leaf_box(52.0, 30.0)) >>>
        } else {
            $zs := col_box(scroll_cw, 0.0, 0.0)
            zs.clip = true
            view.set_style(ed.id_surf_box, &zs) >>>
            view.set_style(ed.id_surf_div, &leaf_box(0.0, 0.0)) >>>
            view.set_style(ed.id_surf_card_hdr, &leaf_box(0.0, 0.0)) >>>
            view.set_style(ed.id_surf_info, &leaf_box(0.0, 0.0)) >>>
            view.set_style(ed.id_surf_bind_row, &row_box(scroll_cw, 0.0, 0.0)) >>>
            view.set_style(ed.id_surf_asset_select, &leaf_box(0.0, 0.0)) >>>
            view.set_style(ed.id_surf_btn_row, &row_box(scroll_cw, 0.0, 0.0)) >>>
            view.set_style(ed.id_surf_prim_field, &leaf_box(0.0, 0.0)) >>>
            view.set_style(ed.id_surf_bind_btn, &leaf_box(0.0, 0.0)) >>>
            view.set_style(ed.id_surf_clear_btn, &leaf_box(0.0, 0.0)) >>>
            view.set_style(ed.id_lod_info, &leaf_box(0.0, 0.0)) >>>
            view.set_style(ed.id_lod_input_row, &row_box(scroll_cw, 0.0, 0.0)) >>>
            view.set_style(ed.id_lod_hyst_field, &leaf_box(0.0, 0.0)) >>>
            view.set_style(ed.id_lod_dist_field, &leaf_box(0.0, 0.0)) >>>
            view.set_style(ed.id_lod_prim_field, &leaf_box(0.0, 0.0)) >>>
            view.set_style(ed.id_lod_btn_row, &row_box(scroll_cw, 0.0, 0.0)) >>>
            view.set_style(ed.id_lod_asset_select, &leaf_box(0.0, 0.0)) >>>
            view.set_style(ed.id_lod_add_btn, &leaf_box(0.0, 0.0)) >>>
            view.set_style(ed.id_lod_pop_btn, &leaf_box(0.0, 0.0)) >>>
        }
        $man_open := []bool{}
        for mf in ed.comp_manual_open { man_open.push(mf) }
        comp_h := sync_comp_layout($&ed.comp, view, scroll_cw, true, &man_open) >>>
        $stats_h := 0.0
        if ed.modeling.has_active_mesh { stats_h = 20.0 }
        $empty_h := 0.0
        if !surf_vis && comp_h < 1.0 && stats_h < 1.0 { empty_h = 44.0 }
        view.set_style(ed.id_comp_empty_lbl, &leaf_box(scroll_cw, empty_h)) >>>
        comp_total := 12.0 + stats_h + 34.0 + surf_h + comp_h + empty_h
        $tcomp := col_box(scroll_cw, comp_total, 0.0)
        tcomp.padding = layout.Insets{left: 0.0, top: 4.0, right: 0.0, bottom: 8.0}
        tcomp.clip = true
        view.set_style(ed.id_tab_comp_box, &tcomp) >>>
        ed.insp_tab_content_h = comp_total
    }

    if apply_h > 0.5 {
        view.set_style(ed.id_apply_btn, &leaf_box(irw, apply_h)) >>>
    } else {
        view.set_style(ed.id_apply_btn, &leaf_box(0.0, 0.0)) >>>
    }

    $fb := row_box(ed.viewport_w, f64(FOOTER_H), 8.0)
    fb.padding = layout.Insets{left: 10.0, top: 4.0, right: 10.0, bottom: 4.0}
    view.set_style(ed.id_footer, &fb) >>>
    $st_w := math.max(120.0, ed.viewport_w - 20.0)
    $hint_w := 0.0
    if ed.viewport_w >= 900.0 {
        st_w = math.max(180.0, ed.viewport_w - 456.0)
        hint_w = 424.0
    }
    view.set_style(ed.id_status_txt, &leaf_box(st_w, 20.0)) >>>
    view.set_style(ed.id_footer_hint, &leaf_box(hint_w, 20.0)) >>>

    constraints := layout.tight(ed.viewport_w, ed.viewport_h)
    _ := widgets.layout_styled(view, &constraints, ed) >>>

    ed.place_all_controls(view) >>>
    if ed.stage_mode == STAGE_MODE_3D || ed.stage_mode == STAGE_MODE_SPLIT {
        ed.vp3d.dirty_render = true
        ed.req_embed_render = true
    }
    vw := ed.viewport_w
    vh := ed.viewport_h
    st := ed.styles.clone()
    mods := $&ed.modals
    mods.layout(vw, vh, &st)
    << 0
}

fn sync_local_box_button(view &widgets.View, id int, btn $&widgets.Button) int {
    nb := view.node_bounds(id) >>>
    << btn.set_bounds(&layout.Rect{x: 0.0, y: 0.0, width: nb.width, height: nb.height}) >>>
}

fn sync_local_box_select(view &widgets.View, id int, styles &widgets.Styles, canvas_h f64, sel $&widgets.Select) layout.Rect {
    nb := view.node_bounds(id) >>>
    _ := sel.set_bounds(&layout.Rect{x: 0.0, y: 0.0, width: nb.width, height: nb.height}) >>>
    _ := sel.apply_styles(styles) >>>
    pop := sel.popup_bounds(styles)
    sel.set_popup_above(nb.y + nb.height + pop.height + 6.0 > canvas_h)
    << nb
}

fn place_view_field(view &widgets.View, id int, styles &widgets.Styles, vp &layout.Rect, f $&widgets.Field) int {
    nb := view.node_bounds(id) >>>
    _ := f.place(&nb) >>>
    set_field_viewport(f, vp)
    << f.apply_styles(styles) >>>
}

fn place_view_text(view &widgets.View, id int, vp &layout.Rect, s $&widgets.SelectableText) int {
    nb := view.node_bounds(id) >>>
    set_text_bounds(s, &nb)
    set_text_viewport(s, vp)
    << 0
}

fn (ed $&Editor) place_all_controls(view $&widgets.View) int {
    st := ed.styles.clone()
    vh := ed.viewport_h
    vp := layout.Rect{x: 0.0, y: 0.0, width: ed.viewport_w, height: ed.viewport_h}
    sc_id := ed.id_scene_select
    ed.scene_origin = sync_local_box_select(view, sc_id, &st, vh, $&ed.scene_select) >>>
    as_id := ed.id_asset_select
    ed.asset_origin = sync_local_box_select(view, as_id, &st, vh, $&ed.asset_select) >>>
    an_id := ed.id_add_node_select
    ed.add_node_origin = sync_local_box_select(view, an_id, &st, vh, $&ed.add_node_select) >>>
    ac_id := ed.id_add_comp_select
    ed.add_comp_origin = sync_local_box_select(view, ac_id, &st, vh, $&ed.add_comp_select) >>>
    pa_id := ed.id_parent_select
    pr_id := ed.id_process_select
    sa_id := ed.id_surf_asset_select
    la_id := ed.id_lod_asset_select

    sync_local_box_tabs(view, ed.id_stage_tabs, &st, $&ed.stage_tabs) >>>
    sync_local_box_tabs(view, ed.id_left_tabs, &st, $&ed.left_tabs) >>>
    sync_local_box_tabs(view, ed.id_insp_tabs, &st, $&ed.insp_tabs) >>>

    sync_local_box_button(view, ed.id_new_scene_btn, $&ed.new_scene_btn) >>>
    sync_local_box_button(view, ed.id_globals_btn, $&ed.globals_btn) >>>
    sync_local_box_button(view, ed.id_undo_btn, $&ed.undo_btn) >>>
    sync_local_box_button(view, ed.id_redo_btn, $&ed.redo_btn) >>>
    sync_local_box_button(view, ed.id_save_btn, $&ed.save_btn) >>>
    sync_local_box_button(view, ed.id_preview_btn, $&ed.preview_btn) >>>

    sync_local_box_button(view, ed.id_dup_btn, $&ed.dup_btn) >>>
    sync_local_box_button(view, ed.id_del_btn, $&ed.del_btn) >>>

    tb := view.node_bounds(ed.id_tree) >>>
    ed.tree_origin = copy_rect(&tb)
    tr := $&ed.tree
    _ := tr.set_bounds(&layout.Rect{x: 0.0, y: 0.0, width: tb.width, height: tb.height}) >>>
    _ := tr.apply_styles(&st) >>>
    tr.set_viewport(&layout.Rect{x: -tb.x, y: -tb.y, width: vp.width, height: vp.height})

    ab := view.node_bounds(ed.id_asset_list) >>>
    ed.asset_list_origin = copy_rect(&ab)
    al := $&ed.asset_list
    _ := al.set_bounds(&layout.Rect{x: 0.0, y: 0.0, width: ab.width, height: ab.height}) >>>
    _ := al.apply_styles(&st) >>>
    al.set_viewport(&layout.Rect{x: -ab.x, y: -ab.y, width: vp.width, height: vp.height})

    sync_local_box_button(view, ed.id_import_btn, $&ed.import_btn) >>>
    place_view_text(view, ed.id_asset_meta, &vp, $&ed.asset_meta_txt) >>>
    place_view_field(view, ed.id_prim_field, &st, &vp, $&ed.prim_field) >>>
    sync_local_box_button(view, ed.id_place_btn, $&ed.place_btn) >>>

    sync_local_box_button(view, ed.id_stage_axis_btn, $&ed.stage_axis_btn) >>>
    sync_local_box_button(view, ed.id_stage_snap_btn, $&ed.stage_snap_btn) >>>
    sync_local_box_button(view, ed.id_fit_btn, $&ed.fit_btn) >>>
    sync_local_box_button(view, ed.id_snap_btn, $&ed.snap_btn) >>>
    sb_r := view.node_bounds(ed.id_stage_bar) >>>
    if ed.modeling.stage_3d_visible {
        g1a := view.node_bounds(ed.modeling.button_ids[MB_GIZMO_MOVE]) >>>
        g1b := view.node_bounds(ed.modeling.button_ids[MB_GIZMO_SCALE]) >>>
        ed.stage_g1_rect = layout.Rect{x: g1a.x - sb_r.x - 2.0, y: 0.0, width: (g1b.x + g1b.width - g1a.x) + 4.0, height: 28.0}
        g2a := view.node_bounds(ed.modeling.button_ids[MB_BOX]) >>>
        g2b := view.node_bounds(ed.modeling.button_ids[MB_CSG]) >>>
        ed.stage_g2_rect = layout.Rect{x: g2a.x - sb_r.x - 2.0, y: 0.0, width: (g2b.x + g2b.width - g2a.x) + 4.0, height: 28.0}
        ra := view.node_bounds(ed.modeling.button_ids[MB_WIRE]) >>>
        rb_b := view.node_bounds(ed.id_snap_btn) >>>
        ed.stage_r_rect = layout.Rect{x: ra.x - sb_r.x - 2.0, y: 0.0, width: (rb_b.x + rb_b.width - ra.x) + 4.0, height: 28.0}
    } else {
        ed.stage_g1_rect = layout.Rect{x: 0.0, y: 0.0, width: 0.0, height: 0.0}
        ed.stage_g2_rect = layout.Rect{x: 0.0, y: 0.0, width: 0.0, height: 0.0}
        ra := view.node_bounds(ed.id_stage_axis_btn) >>>
        rb_b := view.node_bounds(ed.id_snap_btn) >>>
        ed.stage_r_rect = layout.Rect{x: ra.x - sb_r.x - 2.0, y: 0.0, width: (rb_b.x + rb_b.width - ra.x) + 4.0, height: 28.0}
    }
    tvb := view.node_bounds(ed.id_top_view) >>>
    ed.top_view_local = layout.Rect{x: 0.0, y: 0.0, width: tvb.width, height: tvb.height}

    place_view_text(view, ed.id_insp_hdr, &vp, $&ed.insp_hdr_txt) >>>
    place_view_field(view, ed.id_name_field, &st, &vp, $&ed.name_field) >>>
    vb := view.node_bounds(ed.id_visible_chk) >>>
    vc := $&ed.visible_chk
    _ := vc.set_bounds(&layout.Rect{x: 0.0, y: 0.0, width: vb.width, height: vb.height}) >>>

    update_insp_scroll_extent(ed, view)
    scb := view.node_bounds(ed.id_insp_scroll) >>>
    insp_vp := scb
    ed.parent_origin = sync_local_box_select(view, pa_id, &st, vh, $&ed.parent_select) >>>
    ed.process_origin = sync_local_box_select(view, pr_id, &st, vh, $&ed.process_select) >>>
    ed.surf_asset_origin = sync_local_box_select(view, sa_id, &st, vh, $&ed.surf_asset_select) >>>
    ed.lod_asset_origin = sync_local_box_select(view, la_id, &st, vh, $&ed.lod_asset_select) >>>
    xdb := view.node_bounds(ed.id_xf_div) >>>
    set_div_bounds($&ed.xf_div, &layout.Rect{x: 0.0, y: 0.0, width: xdb.width, height: xdb.height})
    sync_local_box_button(view, ed.id_reparent_btn, $&ed.reparent_btn) >>>

    place_view_field(view, ed.id_pos_x, &st, &insp_vp, $&ed.pos_x) >>>
    place_view_field(view, ed.id_pos_y, &st, &insp_vp, $&ed.pos_y) >>>
    place_view_field(view, ed.id_pos_z, &st, &insp_vp, $&ed.pos_z) >>>
    place_view_field(view, ed.id_rot_x, &st, &insp_vp, $&ed.rot_x) >>>
    place_view_field(view, ed.id_rot_y, &st, &insp_vp, $&ed.rot_y) >>>
    place_view_field(view, ed.id_rot_z, &st, &insp_vp, $&ed.rot_z) >>>
    place_view_field(view, ed.id_scale_x, &st, &insp_vp, $&ed.scale_x) >>>
    place_view_field(view, ed.id_scale_y, &st, &insp_vp, $&ed.scale_y) >>>
    place_view_field(view, ed.id_scale_z, &st, &insp_vp, $&ed.scale_z) >>>
    place_view_text(view, ed.id_surf_info, &insp_vp, $&ed.surf_info_txt) >>>
    sdb := view.node_bounds(ed.id_surf_div) >>>
    sd := $&ed.surf_div
    _ := sd.set_bounds(&layout.Rect{x: 0.0, y: 0.0, width: sdb.width, height: sdb.height}) >>>
    place_view_field(view, ed.id_surf_prim_field, &st, &insp_vp, $&ed.surf_prim_field) >>>
    sync_local_box_button(view, ed.id_surf_bind_btn, $&ed.surf_bind_btn) >>>
    sync_local_box_button(view, ed.id_surf_clear_btn, $&ed.surf_clear_btn) >>>
    place_view_text(view, ed.id_lod_info, &insp_vp, $&ed.lod_info_txt) >>>
    place_view_field(view, ed.id_lod_hyst_field, &st, &insp_vp, $&ed.lod_hyst_field) >>>
    place_view_field(view, ed.id_lod_dist_field, &st, &insp_vp, $&ed.lod_dist_field) >>>
    place_view_field(view, ed.id_lod_prim_field, &st, &insp_vp, $&ed.lod_prim_field) >>>
    sync_local_box_button(view, ed.id_lod_add_btn, $&ed.lod_add_btn) >>>
    sync_local_box_button(view, ed.id_lod_pop_btn, $&ed.lod_pop_btn) >>>
    place_comp_inspector($&ed.comp, view, &st, vh, &insp_vp) >>>
    modeling_place($&ed.modeling, view, &st, &vp, &insp_vp) >>>
    sync_local_box_button(view, ed.id_apply_btn, $&ed.apply_btn) >>>
    place_view_text(view, ed.id_status_txt, &vp, $&ed.status_txt) >>>
    panels_place($&ed.panels, view, &st, &vp) >>>
    << 0
}

fn selected_asset_is_glb(ed &Editor) bool {
    sel := ed.selected_asset
    if sel < 0 || sel >= ed.project.assets.len { << false }
    ext := strings.to_lower(&filepath.ext(&ed.project.assets[sel].path))
    << ext == ".glb"
}

pub fn (ed $&Editor) sync_toolbar_states() {
    c_undo := ed.draft.can_undo()
    c_redo := ed.draft.can_redo()
    c_pv := !ed.preview_active
    c_im := !ed.import_active
    $has_non_root := ed.selected_node > 0
    for i in 0:ed.selected_nodes.len {
        if ed.selected_nodes[i] > 0 {
            has_non_root = true
            <-
        }
    }
    has_sel := ed.selected_node > 0
    is_single_sel := ed.selected_nodes.len <= 1
    can_rep := has_non_root && ed.parent_candidates.len > 0
    has_assets := ed.project.assets.len > 0
    is_glb := selected_asset_is_glb(ed)
    placing := ed.placing_mode
    is_dirty := ed.draft.dirty()
    st_danger := compact_button_style(&ed.styles, widgets.BUTTON_DANGER)
    st_sec := compact_button_style(&ed.styles, widgets.BUTTON_SECONDARY)
    ico_pri := icon_button_style(&ed.styles, widgets.BUTTON_PRIMARY)
    ico_out := icon_button_style(&ed.styles, widgets.BUTTON_OUTLINE)
    ico_sub := icon_button_style(&ed.styles, widgets.BUTTON_SUBTLE)
    ico_act := icon_active_style(&ed.styles, &ed.pal)

    sm_tab := stage_mode_to_tab(ed.stage_mode)
    set_tabs_selected($&ed.stage_tabs, sm_tab)
    ltab := ed.left_tab
    set_tabs_selected($&ed.left_tabs, ltab)
    itab := ed.insp_tab
    set_tabs_selected($&ed.insp_tabs, itab)

    set_btn_enabled($&ed.undo_btn, c_undo)
    set_btn_enabled($&ed.redo_btn, c_redo)
    set_btn_enabled($&ed.preview_btn, c_pv)
    set_btn_enabled($&ed.import_btn, c_im)
    set_btn_enabled($&ed.dup_btn, has_non_root)
    set_btn_enabled($&ed.del_btn, has_non_root)
    if ed.tilemap_active {
        c := $&ed.comp
        set_btn_enabled($&c.buttons[CB_TILEMAP_EDIT], false)
    }
    set_btn_enabled($&ed.reparent_btn, can_rep)
    set_sel_enabled($&ed.parent_select, can_rep)
    set_btn_enabled($&ed.place_btn, placing || is_glb)
    can_reloc := has_assets && !ed.relocate_active
    can_open := !ed.open_proj_active
    can_exp := !ed.export_active
    p := $&ed.panels
    set_btn_enabled($&p.buttons[PB_OPEN_PROJ], can_open)
    set_btn_enabled($&p.buttons[PB_EXPORT], can_exp)
    set_btn_enabled($&p.buttons[PB_NODE_UP], is_single_sel && has_sel)
    set_btn_enabled($&p.buttons[PB_NODE_DN], is_single_sel && has_sel)
    set_btn_enabled($&p.buttons[PB_RELOCATE], can_reloc)
    set_btn_enabled($&p.buttons[PB_REMOVE_ASSET], has_assets)
    if placing {
        set_lbl_text($&ed.place_lbl, &tr(ed.lang, "Cancel Place", "取消放置"))
        set_btn_style($&ed.place_btn, &st_danger)
    } else {
        set_lbl_text($&ed.place_lbl, &tr(ed.lang, "Place GLB", "放置 GLB"))
        set_btn_style($&ed.place_btn, &st_sec)
    }
    if is_dirty {
        set_btn_style($&ed.save_btn, &ico_pri)
    } else {
        set_btn_style($&ed.save_btn, &ico_out)
    }
    if ed.stage_mode == STAGE_MODE_3D {
        if ed.vp3d.show_grid {
            set_btn_style($&ed.stage_axis_btn, &ico_act)
        } else {
            set_btn_style($&ed.stage_axis_btn, &ico_sub)
        }
    } else if ed.stage_mode == STAGE_MODE_SPLIT {
        set_btn_style($&ed.stage_axis_btn, &ico_out)
    } else if ed.stage_mode == STAGE_MODE_TILEMAP {
        if ed.tilemap.show_grid {
            set_btn_style($&ed.stage_axis_btn, &ico_act)
        } else {
            set_btn_style($&ed.stage_axis_btn, &ico_sub)
        }
    } else {
        set_btn_style($&ed.stage_axis_btn, &ico_out)
    }
    if ed.top_snap_enabled {
        set_lbl_text($&ed.stage_snap_lbl, &"Snap:On")
        set_btn_style($&ed.stage_snap_btn, &ico_act)
    } else {
        set_lbl_text($&ed.stage_snap_lbl, &"Snap:Off")
        set_btn_style($&ed.stage_snap_btn, &ico_sub)
    }
}

pub fn (ed $&Editor) refresh_project_selectors() {
    for i in 0:ed.scene_labels.len { dispose_label($&ed.scene_labels[i]) }
    ed.scene_labels = []widgets.StyledLabel{}
    sc_n := min_int_val(ed.project.scenes.len, 64)
    for i in 0:sc_n {
        k := ed.project.scenes[i].key + ""
        ed.scene_labels.push(widgets.styled_label(&ed.context, &k))
    }
    set_sel_count($&ed.scene_select, sc_n)
    if sc_n > 0 && ed.scene_index >= 0 && ed.scene_index < sc_n {
        sidx := ed.scene_index
        set_sel_selected($&ed.scene_select, sidx)
    }

    for i in 0:ed.asset_labels.len { dispose_label($&ed.asset_labels[i]) }
    ed.asset_labels = []widgets.StyledLabel{}
    as_n := min_int_val(ed.project.assets.len, 64)
    $prev_sel := ed.selected_asset
    if prev_sel < 0 { prev_sel = ed.asset_select.selected() }
    for i in 0:as_n {
        b := asset_display_label(&ed.project.assets[i].path)
        ed.asset_labels.push(widgets.styled_label(&ed.context, &b))
    }
    set_sel_count($&ed.asset_select, as_n)
    if as_n > 0 {
        $next_sel := prev_sel
        if next_sel < 0 || next_sel >= as_n { next_sel = 0 }
        ed.selected_asset = next_sel
        set_sel_selected($&ed.asset_select, next_sel)
    } else {
        ed.selected_asset = -1
    }
    ed.rebuild_asset_list()

    ed.glb_indices = collect_glb_indices(&ed.project)
    surf_prev := ed.surf_asset_select.selected()
    for i in 0:ed.surf_asset_labels.len { dispose_label($&ed.surf_asset_labels[i]) }
    ed.surf_asset_labels = make_surface_asset_labels(&ed.context, &ed.project, &ed.glb_indices, tr(ed.lang, "(None)", "(无)"))
    surf_n := min_int_val(ed.surf_asset_labels.len, 64)
    set_sel_count($&ed.surf_asset_select, surf_n)
    $surf_next := surf_prev
    if surf_next < 0 || surf_next >= surf_n { surf_next = 0 }
    set_sel_selected($&ed.surf_asset_select, surf_next)

    lod_prev := ed.lod_asset_select.selected()
    for i in 0:ed.lod_asset_labels.len { dispose_label($&ed.lod_asset_labels[i]) }
    ed.lod_asset_labels = make_surface_asset_labels(&ed.context, &ed.project, &ed.glb_indices, tr(ed.lang, "(Same GLB)", "(同主 GLB)"))
    lod_n := min_int_val(ed.lod_asset_labels.len, 64)
    set_sel_count($&ed.lod_asset_select, lod_n)
    $lod_next := lod_prev
    if lod_next < 0 || lod_next >= lod_n { lod_next = 0 }
    set_sel_selected($&ed.lod_asset_select, lod_next)

    ctx_c := ed.context.clone()
    proj_c := clone_project(&ed.project)
    lang_ci := ed.lang
    refresh_comp_asset_selectors($&ed.comp, &ctx_c, &proj_c, lang_ci)
    modeling_refresh_textures($&ed.modeling, &ctx_c, &proj_c, lang_ci)
    ed.sync_asset_meta_text()
}

fn set_plain_field_label(f $&widgets.Field, lbl string) {
    $dec := widgets.field_decoration(&lbl)
    dec.reserve_helper = false
    set_field_dec(f, &dec)
}

fn (ed $&Editor) refresh_insp_tab_labels() {
    for i in 0:ed.insp_tab_labels.len { dispose_label($&ed.insp_tab_labels[i]) }
    $comp_cnt := comp_attached_count(&ed.comp)
    if ed.surf_attached { comp_cnt = comp_cnt + 1 }
    ed.insp_tab_labels = make_insp_tab_labels(&ed.context, ed.lang, comp_cnt)
}

fn (ed $&Editor) update_apply_btn_label() {
    if ed.selected_nodes.len > 1 {
        set_lbl_text($&ed.apply_lbl, &tr(ed.lang, "Apply to " + str(ed.selected_nodes.len) + " Nodes", "应用到 " + str(ed.selected_nodes.len) + " 个节点"))
    } else {
        set_lbl_text($&ed.apply_lbl, &tr(ed.lang, "Apply Changes", "应用更改"))
    }
}

fn (ed $&Editor) apply_language_internal() {
    lang := ed.lang
    p := $&ed.panels
    panels_apply_lang(p, lang)
    mods := $&ed.modals
    mods.apply_lang(lang)

    for i in 0:ed.stage_tab_labels.len { dispose_label($&ed.stage_tab_labels[i]) }
    ed.stage_tab_labels = make_stage_tab_labels(&ed.context, lang)
    for i in 0:ed.left_tab_labels.len { dispose_label($&ed.left_tab_labels[i]) }
    ed.left_tab_labels = make_left_tab_labels(&ed.context, lang)
    ed.refresh_insp_tab_labels()

    for i in 0:ed.add_node_labels.len { dispose_label($&ed.add_node_labels[i]) }
    ed.add_node_labels = make_add_node_labels(&ed.context, lang)
    for i in 0:ed.add_comp_labels.len { dispose_label($&ed.add_comp_labels[i]) }
    ed.add_comp_labels = make_add_comp_labels(&ed.context, lang)

    set_lbl_text($&ed.no_asset_lbl, &tr(lang, "(No assets)", "(无资源)"))
    set_lbl_text($&ed.root_parent_lbl, &tr(lang, "(root)", "(根节点)"))
    set_lbl_text($&ed.visible_lbl, &tr(lang, "Visible", "可见"))
    set_lbl_text($&ed.reparent_lbl, &tr(lang, "Reparent", "更改父级"))
    set_lbl_text($&ed.surf_bind_lbl, &tr(lang, "Bind GLB", "绑定 GLB"))
    set_lbl_text($&ed.surf_clear_lbl, &tr(lang, "Clear GLB", "清除 GLB"))
    set_lbl_text($&ed.lod_add_lbl, &tr(lang, "+ LOD", "+ LOD"))
    set_lbl_text($&ed.lod_pop_lbl, &tr(lang, "- LOD", "- LOD"))
    ed.update_apply_btn_label()

    proc_prev := ed.process_select.selected()
    for i in 0:ed.process_labels.len { dispose_label($&ed.process_labels[i]) }
    ed.process_labels = make_process_labels(&ed.context, lang)
    proc_n := ed.process_labels.len
    set_sel_count($&ed.process_select, proc_n)
    $proc_next := proc_prev
    if proc_next < 0 || proc_next >= proc_n { proc_next = 0 }
    set_sel_selected($&ed.process_select, proc_next)

    set_plain_field_label($&ed.prim_field, tr(lang, "Prim", "图元"))
    set_plain_field_label($&ed.surf_prim_field, tr(lang, "Prim", "图元"))
    set_plain_field_label($&ed.lod_hyst_field, tr(lang, "Hyst", "滞后"))
    set_plain_field_label($&ed.lod_dist_field, tr(lang, "Dist", "距离"))
    set_plain_field_label($&ed.lod_prim_field, tr(lang, "L.Prim", "LOD图元"))
    ed.refresh_name_decoration(&ed.name_field.value())

    ctx_c := ed.context.clone()
    proj_c := clone_project(&ed.project)
    comp_apply_lang($&ed.comp, &ctx_c, &proj_c, lang)
    modeling_apply_lang($&ed.modeling, lang)
}

pub fn (ed $&Editor) apply_language(view $&widgets.View) {
    ed.apply_language_internal()
    ed.refresh_project_selectors()
    doc := ed.draft.document() >>> (err) {
        _ := err
        ed.sync_toolbar_states()
        ed.repaint_all(view)
        <<
    }
    ed.sync_inspector(&doc)
    ed.sync_toolbar_states()
    ed.repaint_all(view)
}

fn try_save_editor_lang(out &string, lang int) int {
    << save_editor_lang(out, lang) >>> (err) {
        _ := err
        << 0
    }
}

pub fn (ed $&Editor) set_lang(next_lang int, view $&widgets.View) {
    $clamped := LANG_EN
    if next_lang == LANG_ZH { clamped = LANG_ZH }
    ed.lang = clamped
    out_dir := ed.output_dir + ""
    _ := try_save_editor_lang(&out_dir, clamped)
    tip := $&ed.tooltip
    _ := tip.dismiss()
    ed.apply_language(view)
    ed.set_status(STATUS_OK, tr(clamped, "Switched language to English", "已切换为中文界面"), view)
}

fn (ed $&Editor) refresh_node_vis_cache(doc &resource.Document) {
    ed.node_vis_cache = map[int]bool{}
    ed.node_eff_vis_cache = map[int]bool{}
    $parents := []int{}
    for i in 0:doc.node_count() {
        nd := doc.describe_node(i) >>> (err) {
            _ := err
            <-
        }
        ed.node_vis_cache[i] = nd.visible
        parents.push(nd.parent)
    }
    for i in 0:parents.len {
        $cur := i
        $eff := true
        $steps := 0
        while cur >= 0 && cur < parents.len && steps < 64 {
            if !ed.node_vis_cache.get_or(cur, true) {
                eff = false
                <-
            }
            cur = parents[cur]
            steps = steps + 1
        }
        ed.node_eff_vis_cache[i] = eff
    }
}

pub fn (ed $&Editor) rebuild_tree(doc &resource.Document) {
    tree_begin_update($&ed.tree)
    tree_clear($&ed.tree)
    ed.tree_to_scene = map[int]int{}
    ed.scene_to_tree = map[int]int{}
    ed.refresh_node_vis_cache(doc)

    $has_surf := map[int]bool{}
    for i in 0:doc.surface_count() {
        s := doc.surface(i) >>> (err) { <- }
        has_surf[s.node] = true
    }
    $has_light := map[int]bool{}
    for i in 0:doc.light_count() {
        lt := doc.light(i) >>> (err) { <- }
        has_light[lt.node] = true
    }
    $has_script := map[int]bool{}
    for i in 0:doc.script_count() {
        sc := doc.script(i) >>> (err) { <- }
        has_script[sc.node] = true
    }
    $has_audio := map[int]bool{}
    for i in 0:doc.audio_count() {
        ae := doc.audio_emitter(i) >>> (err) { <- }
        has_audio[ae.node] = true
    }
    $has_sprite := map[int]bool{}
    for i in 0:doc.sprite_3d_count() {
        sp := doc.sprite_3d(i) >>> (err) { <- }
        has_sprite[sp.node] = true
    }
    $has_tilemap := map[int]bool{}
    for i in 0:doc.tilemap_2d_count() {
        tm := doc.tilemap_2d(i) >>> (err) { <- }
        has_tilemap[tm.node] = true
    }

    flt := strings.to_lower(&strings.trim_space(&ed.panels.fields[PF_TREE_FILTER].value()))
    ed.tree_filter_active = flt.len > 0
    $match_cnt := 0
    $tags := []string{}
    $parents := []int{}
    $include := []bool{}
    for i in 0:doc.node_count() {
        nd := doc.describe_node(i) >>> (err) { <- }
        $tag := "G"
        if nd.kind == resource.NODE_3D { tag = "3D" }
        else if nd.kind == resource.NODE_2D { tag = "2D" }
        if has_surf.has(i) { tag = tag + " M" }
        if nd.camera.is_set() || nd.orthographic.is_set() || nd.camera_2d.is_set() { tag = tag + " C" }
        if has_light.has(i) { tag = tag + " L" }
        if has_script.has(i) { tag = tag + " S" }
        if has_audio.has(i) { tag = tag + " A" }
        if has_sprite.has(i) { tag = tag + " Sp" }
        if has_tilemap.has(i) { tag = tag + " Tm" }
        if node_has_editable_mesh(doc, i) { tag = tag + " W" }
        if node_has_csg_tree(doc, i) { tag = tag + " CSG" }
        tags.push(tag + "")
        parents.push(nd.parent)
        $hit := flt.len == 0
        if !hit {
            if strings.contains(&strings.to_lower(&nd.name), flt + "") || strings.contains(&strings.to_lower(&tag), flt + "") {
                hit = true
                match_cnt = match_cnt + 1
            }
        }
        include.push(hit)
    }
    ed.tree_filter_matches = match_cnt
    if flt.len > 0 {
        for i in 0:include.len {
            if include[i] {
                $p := parents[i]
                while p >= 0 && p < include.len {
                    include[p] = true
                    p = parents[p]
                }
            }
        }
    }

    for i in 0:doc.node_count() {
        if !include[i] { -> }
        nd := doc.describe_node(i) >>> (err) { <- }
        $tparent := -1
        if nd.parent >= 0 && ed.scene_to_tree.has(nd.parent) {
            tparent = ed.scene_to_tree[nd.parent]
        }
        tid := tree_add_node($&ed.tree, tparent, &nd.name) >>> (err) { <- }
        ed.scene_to_tree[i] = tid
        ed.tree_to_scene[tid] = i
        tag := tags[i] + ""
        tree_set_meta($&ed.tree, tid, &tag)
        tree_set_exp($&ed.tree, tid, true)
        tree_set_action($&ed.tree, tid, true)
    }
    if ed.selected_node < 0 || ed.selected_node >= doc.node_count() {
        ed.selected_node = 0
    }
    $valid_sel := []int{}
    $seen_sel := map[int]bool{}
    for i in 0:ed.selected_nodes.len {
        id := ed.selected_nodes[i]
        if id >= 0 && id < doc.node_count() && !seen_sel.has(id) {
            seen_sel[id] = true
            valid_sel.push(id)
        }
    }
    if valid_sel.len == 0 { valid_sel.push(ed.selected_node) }
    ed.selected_nodes = valid_sel
    ed.sync_tree_selection(false)
    tree_end_update($&ed.tree)
    if ed.selected_node == 0 {
        tree_set_scroll($&ed.tree, 0.0)
    }
}

fn subtree_mask(doc &resource.Document, root_idx int) map[int]bool {
    $mask := map[int]bool{}
    if root_idx < 0 || root_idx >= doc.node_count() { << mask }
    mask[root_idx] = true
    for i in (root_idx + 1):doc.node_count() {
        nd := doc.describe_node(i) >>> (err) { << mask }
        if mask.has(nd.parent) {
            mask[i] = true
        }
    }
    << mask
}

fn (ed &Editor) effective_selected_nodes(doc &resource.Document) []int {
    $out := []int{}
    $seen := map[int]bool{}
    for i in 0:ed.selected_nodes.len {
        id := ed.selected_nodes[i]
        if id >= 0 && id < doc.node_count() && !seen.has(id) {
            seen[id] = true
            out.push(id)
        }
    }
    if out.len == 0 && ed.selected_node >= 0 && ed.selected_node < doc.node_count() {
        out.push(ed.selected_node)
    }
    << out
}

fn (ed &Editor) selected_non_root_targets(doc &resource.Document) []int {
    all := ed.effective_selected_nodes(doc)
    $out := []int{}
    for i in 0:all.len {
        if all[i] > 0 { out.push(all[i]) }
    }
    << out
}

fn (ed &Editor) selected_3d_targets(doc &resource.Document) []int {
    all := ed.effective_selected_nodes(doc)
    $out := []int{}
    for i in 0:all.len {
        nid := all[i]
        if nid <= 0 { -> }
        nd := doc.describe_node(nid) >>> (err) {
            _ := err
            ->
        }
        if nd.kind == resource.NODE_3D {
            out.push(nid)
        }
    }
    << out
}

fn (ed $&Editor) rebuild_parent_choices(doc &resource.Document, cur_parent int) {
    for i in 0:ed.parent_labels.len { dispose_label($&ed.parent_labels[i]) }
    ed.parent_labels = []widgets.StyledLabel{}
    ed.parent_candidates = []int{}

    non_roots := ed.selected_non_root_targets(doc)
    if non_roots.len == 0 {
        ed.parent_labels.push(widgets.styled_label(&ed.context, &tr(ed.lang, "(root)", "(根节点)")))
        set_sel_count($&ed.parent_select, 1)
        set_sel_selected($&ed.parent_select, 0)
        <<
    }

    $blocked := map[int]bool{}
    for k in 0:non_roots.len {
        sub := subtree_mask(doc, non_roots[k])
        for id in 0:doc.node_count() {
            if sub.has(id) { blocked[id] = true }
        }
    }
    $sel_pos := 0
    // Always include current parent & root first so select never exceeds 64 limit without them.
    $added := map[int]bool{}
    $order := []int{}
    if cur_parent >= 0 && cur_parent < doc.node_count() && !blocked.has(cur_parent) {
        order.push(cur_parent)
        added[cur_parent] = true
    }
    if !added.has(0) && !blocked.has(0) {
        order.push(0)
        added[0] = true
    }
    for i in 0:doc.node_count() {
        if order.len >= 64 { <- }
        if !added.has(i) && !blocked.has(i) {
            order.push(i)
            added[i] = true
        }
    }
    for k in 0:order.len {
        cid := order[k]
        nd := doc.describe_node(cid) >>> (err) { -> }
        if cid == cur_parent { sel_pos = ed.parent_candidates.len }
        ed.parent_candidates.push(cid)
        lbl := "[" + str(cid) + "] " + nd.name
        ed.parent_labels.push(widgets.styled_label(&ed.context, &lbl))
    }
    if ed.parent_candidates.len == 0 {
        ed.parent_labels.push(widgets.styled_label(&ed.context, &tr(ed.lang, "(none)", "(无)")))
        set_sel_count($&ed.parent_select, 1)
        set_sel_selected($&ed.parent_select, 0)
        <<
    }
    cand_len := ed.parent_candidates.len
    set_sel_count($&ed.parent_select, cand_len)
    set_sel_selected($&ed.parent_select, sel_pos)
}

fn sync_axis_field(f $&widgets.Field, base_lbl string, vals &[]string, def_val string) string {
    if vals.len == 0 {
        set_plain_field_label(f, base_lbl)
        set_field_val(f, &def_val)
        << def_val + ""
    }
    first := vals[0] + ""
    $same := true
    for i in 1:vals.len {
        if vals[i] != first {
            same = false
            <-
        }
    }
    if same {
        set_plain_field_label(f, base_lbl)
        set_field_val(f, &first)
        << first + ""
    }
    set_plain_field_label(f, base_lbl + " (—)")
    empty_s := ""
    set_field_val(f, &empty_s)
    << ""
}

pub fn (ed $&Editor) sync_inspector(doc &resource.Document) {
    if ed.selected_node < 0 || ed.selected_node >= doc.node_count() {
        ed.selected_node = 0
    }
    sels := ed.effective_selected_nodes(doc)
    is_multi := sels.len > 1
    nd := doc.describe_node(ed.selected_node) >>> (err) { << }
    $any_3d := nd.kind == resource.NODE_3D
    $any_2d := nd.kind == resource.NODE_2D
    $all_3d := true
    for i in 0:sels.len {
        snd := doc.describe_node(sels[i]) >>> (err) {
            _ := err
            ->
        }
        if snd.kind == resource.NODE_3D { any_3d = true } else { all_3d = false }
        if snd.kind == resource.NODE_2D { any_2d = true }
    }
    if is_multi {
        if all_3d {
            ed.insp_kind_text = tr(ed.lang, "Inspector · " + str(sels.len) + " Node3D", "检查器 · 已选 " + str(sels.len) + " 个 3D 节点")
        } else {
            ed.insp_kind_text = tr(ed.lang, "Inspector · " + str(sels.len) + " Nodes", "检查器 · 已选 " + str(sels.len) + " 个节点")
        }
    } else {
        $klabel := tr(ed.lang, "Node (Group)", "节点组")
        if nd.kind == resource.NODE_3D { klabel = tr(ed.lang, "Node3D", "3D 节点") }
        else if nd.kind == resource.NODE_2D { klabel = tr(ed.lang, "Node2D", "2D 节点") }
        if ed.selected_node == 0 { klabel = klabel + tr(ed.lang, " · Root", " · 根节点") }
        ed.insp_kind_text = tr(ed.lang, "Inspector · ", "检查器 · ") + klabel
    }
    hdr_copy := ed.insp_kind_text + ""
    set_text_val($&ed.insp_hdr_txt, &hdr_copy)

    ed.insp_editable = true
    ed.insp_can_trs = any_3d
    ed.insp_can_2d = any_2d
    ed.insp_dirty = false

    ed.name_error = ""
    if is_multi {
        multi_nm := tr(ed.lang, str(sels.len) + " nodes selected", "已选 " + str(sels.len) + " 个节点")
        set_field_val($&ed.name_field, &multi_nm)
        enable_field($&ed.name_field, false)
        ed.refresh_name_decoration(&multi_nm)
    } else {
        enable_field($&ed.name_field, true)
        set_field_val($&ed.name_field, &nd.name)
        ed.refresh_name_decoration(&nd.name)
    }
    ed.vis_seed = nd.visible
    set_chk_val($&ed.visible_chk, nd.visible)
    $pm := nd.process_mode
    if pm < 0 || pm > resource.PROCESS_DISABLED { pm = resource.PROCESS_INHERIT }
    ed.proc_seed = pm
    set_sel_selected($&ed.process_select, pm)
    ed.rebuild_parent_choices(doc, nd.parent)

    $pxs := []string{}
    $pys := []string{}
    $pzs := []string{}
    $rxs := []string{}
    $rys := []string{}
    $rzs := []string{}
    $sxs := []string{}
    $sys := []string{}
    $szs := []string{}
    for i in 0:sels.len {
        snd := doc.describe_node(sels[i]) >>> (err) {
            _ := err
            ->
        }
        if snd.kind == resource.NODE_3D {
            trs := decompose_trs(&snd.local_3d)
            pxs.push(fmt_coord(trs.position.x))
            pys.push(fmt_coord(trs.position.y))
            pzs.push(fmt_coord(trs.position.z))
            rxs.push(fmt_coord(trs.rotation_deg.x))
            rys.push(fmt_coord(trs.rotation_deg.y))
            rzs.push(fmt_coord(trs.rotation_deg.z))
            sxs.push(fmt_coord(trs.scale.x))
            sys.push(fmt_coord(trs.scale.y))
            szs.push(fmt_coord(trs.scale.z))
        } else if snd.kind == resource.NODE_2D {
            t2 := decompose_2d(&snd.local)
            pxs.push(fmt_coord(t2.x))
            pys.push(fmt_coord(t2.y))
            rzs.push(fmt_coord(t2.rot_deg))
            sxs.push(fmt_coord(t2.sx))
            sys.push(fmt_coord(t2.sy))
        }
    }
    ed.pos_seed_x = sync_axis_field($&ed.pos_x, "X", &pxs, "0")
    ed.pos_seed_y = sync_axis_field($&ed.pos_y, "Y", &pys, "0")
    ed.pos_seed_z = sync_axis_field($&ed.pos_z, "Z", &pzs, "0")
    ed.rot_seed_x = sync_axis_field($&ed.rot_x, "RX", &rxs, "0")
    ed.rot_seed_y = sync_axis_field($&ed.rot_y, "RY", &rys, "0")
    ed.rot_seed_z = sync_axis_field($&ed.rot_z, "RZ", &rzs, "0")
    ed.scale_seed_x = sync_axis_field($&ed.scale_x, "SX", &sxs, "1")
    ed.scale_seed_y = sync_axis_field($&ed.scale_y, "SY", &sys, "1")
    ed.scale_seed_z = sync_axis_field($&ed.scale_z, "SZ", &szs, "1")

    can_xy := ed.insp_can_trs || ed.insp_can_2d
    can_3d := ed.insp_can_trs
    enable_field($&ed.pos_x, can_xy)
    enable_field($&ed.pos_y, can_xy)
    enable_field($&ed.pos_z, can_3d)
    enable_field($&ed.rot_x, can_3d)
    enable_field($&ed.rot_y, can_3d)
    enable_field($&ed.rot_z, can_xy)
    enable_field($&ed.scale_x, can_xy)
    enable_field($&ed.scale_y, can_xy)
    enable_field($&ed.scale_z, can_3d)
    ed.update_apply_btn_label()

    ed.surf_text = tr(ed.lang, "No GLB surface attached", "未绑定 GLB 表面")
    for i in 0:doc.surface_count() {
        s := doc.surface(i) >>> (err) { <- }
        if s.node == ed.selected_node {
            $aname := s.resource_uid
            for j in 0:ed.project.assets.len {
                if ed.project.assets[j].key == s.resource_uid {
                    aname = filepath.base(&ed.project.assets[j].path)
                }
            }
            ed.surf_text = tr(ed.lang, "Surface: ", "表面: ") + aname + tr(ed.lang, " · prim ", " · 图元 ") + str(s.primitive)
            <-
        }
    }
    surf_copy := ed.surf_text + ""
    set_text_val($&ed.surf_info_txt, &surf_copy)
    sync_surface_inspector(ed, doc, can_3d)
    ctx_ci := ed.context.clone()
    proj_ci := clone_project(&ed.project)
    sel_ci := ed.selected_node
    $sels_ci := []int{}
    for k in 0:sels.len { sels_ci.push(sels[k]) }
    lang_ci := ed.lang
    sync_comp_inspector($&ed.comp, &ctx_ci, &proj_ci, doc, sel_ci, &sels_ci, lang_ci)
    pal_mod := ed.pal
    st_mod := ed.styles.clone()
    vp_snap := Viewport3DState{
        center: ed.vp3d.center, distance: ed.vp3d.distance, yaw: ed.vp3d.yaw, pitch: ed.vp3d.pitch,
        ortho_size: ed.vp3d.ortho_size, ortho_axis: ed.vp3d.ortho_axis,
        show_grid: ed.vp3d.show_grid, show_wire: ed.vp3d.show_wire, sub_mode: ed.vp3d.sub_mode,
        selected_face: ed.vp3d.selected_face, selected_vert: ed.vp3d.selected_vert,
        selected_e0: ed.vp3d.selected_e0, selected_e1: ed.vp3d.selected_e1,
        dragging_orbit: false, dragging_pan: false, drag_pane: 0,
        drag_start_x: 0.0, drag_start_y: 0.0, drag_last_x: 0.0, drag_last_y: 0.0, drag_moved: false,
        gizmo_hover_axis: 0, gizmo_drag_axis: 0, gizmo_tool: ed.vp3d.gizmo_tool,
        gizmo_origin: fm.vec3(0.0, 0.0, 0.0), gizmo_delta: fm.vec3(0.0, 0.0, 0.0),
        gizmo_rot_deg: fm.vec3(0.0, 0.0, 0.0), gizmo_scale_mul: fm.vec3(1.0, 1.0, 1.0),
        gizmo_screen_dir_x: 1.0, gizmo_screen_dir_y: 0.0, gizmo_world_per_px: 0.01,
        gizmo_triad_hover: 0, live_gizmo_dirty: false,
        has_image: false, images: []draw.Image{}, img_w: 0, img_h: 0,
        backend_name: "", connected: false, scene_rev_sent: "", render_seq: 0,
        in_flight: false, dirty_render: false, pending_pick: false, pick_additive: false, pick_down_additive: false, pick_x: 0.0, pick_y: 0.0,
        pending_capture_3d: "", pending_capture_done: ""
    }
    modeling_sync_state($&ed.modeling, &st_mod, &pal_mod, doc, sel_ci, &sels_ci, &vp_snap, lang_ci)
    ed.refresh_insp_tab_labels()
    tm_src := ed.draft.source + ""
    tm_bounds := copy_rect(&ed.top_view_local)
    tm_ptr := $&ed.tilemap
    tm_ptr.sync_from_document(&ctx_ci, &proj_ci, &tm_src, doc, sel_ci, &tm_bounds)
}

fn (ed $&Editor) refresh_name_decoration(val &string) {
    _ := val
    nm_lbl := tr(ed.lang, "Name", "名称")
    $dec := widgets.field_decoration(&nm_lbl)
    dec.floating = widgets.LABEL_NEVER
    dec.clearable = ed.selected_nodes.len <= 1
    dec.helper = ""
    dec.error = ed.name_error + ""
    name_bad := ed.name_error.len > 0
    dec.reserve_helper = name_bad
    set_field_dec($&ed.name_field, &dec)
    set_field_inv($&ed.name_field, name_bad)
}

pub fn (ed $&Editor) refresh_after_document_change(fit_stage bool, view $&widgets.View) {
    doc := ed.draft.document() >>> (err) {
        ed.set_status(STATUS_ERR, err.msg(), view)
        <<
    }
    ed.stage_pts = extract_stage_points(&doc)
    if fit_stage {
        $fit_b := ed.top_view_local
        if fit_b.width < 40.0 || fit_b.height < 40.0 {
            fit_b = layout.Rect{x: 0.0, y: 0.0, width: 580.0, height: 520.0}
        }
        pts := clone_stage_points(&ed.stage_pts)
        tv := $&ed.top_view
        tv.fit_points(&pts, &fit_b)
        vp_fit := $&ed.vp3d
        vp_fit.fit_scene(&pts, &doc)
    }
    ed.vp3d.dirty_render = true
    ed.req_embed_render = true
    ed.rebuild_tree(&doc)
    ed.sync_inspector(&doc)
    ed.ensure_context_layout(view)
    ed.sync_toolbar_states()
    ed.repaint_all(view)
}

pub fn (ed $&Editor) refresh_after_visibility_change(view $&widgets.View) {
    doc := ed.draft.document() >>> (err) {
        ed.set_status(STATUS_ERR, err.msg(), view)
        <<
    }
    ed.refresh_node_vis_cache(&doc)
    ed.stage_pts = extract_stage_points(&doc)
    ed.vp3d.dirty_render = true
    ed.req_embed_render = true
    ed.sync_inspector(&doc)
    ed.ensure_context_layout(view)
    ed.sync_toolbar_states()
    ed.repaint_all(view)
}

fn (ed $&Editor) set_single_selection(idx int) {
    ed.selected_node = idx
    if idx >= 0 {
        ed.selected_nodes = [idx]
    } else {
        ed.selected_nodes = []int{}
    }
}

fn (ed $&Editor) toggle_selection_node(idx int) {
    if idx < 0 { << }
    $next := []int{}
    $found := false
    for i in 0:ed.selected_nodes.len {
        n := ed.selected_nodes[i]
        if n == idx {
            found = true
        } else {
            next.push(n)
        }
    }
    if !found {
        next.push(idx)
    }
    if next.len == 0 {
        next.push(0)
    }
    ed.selected_node = next[next.len - 1]
    ed.selected_nodes = next
}

fn (ed $&Editor) apply_tree_selection_from_widget(view $&widgets.View) {
    tids := ed.tree.selected_nodes()
    pt := ed.tree.selected()
    $sels := []int{}
    $seen_s := map[int]bool{}
    for i in 0:tids.len {
        tid := tids[i]
        if ed.tree_to_scene.has(tid) {
            sid := ed.tree_to_scene[tid]
            if !seen_s.has(sid) {
                seen_s[sid] = true
                sels.push(sid)
            }
        }
    }
    $primary_s := -1
    if ed.tree_to_scene.has(pt) {
        primary_s = ed.tree_to_scene[pt]
    } else if sels.len > 0 {
        primary_s = sels[sels.len - 1]
    }
    if sels.len == 0 {
        ed.select_scene_node(0, view)
        <<
    }
    ed.selected_nodes = sels
    ed.selected_node = primary_s
    ed.reset_comp_manual_open()
    doc := ed.draft.document() >>> (err) {
        _ := err
        <<
    }
    ed.sync_inspector(&doc)
    ed.ensure_context_layout(view)
    ed.sync_toolbar_states()
    repaint(view, ed.id_left_pane)
    repaint(view, ed.id_top_view)
    repaint(view, ed.id_right_pane)
}

fn (ed $&Editor) sync_tree_selection(reveal bool) {
    $tids := []int{}
    for i in 0:ed.selected_nodes.len {
        sid := ed.selected_nodes[i]
        if ed.scene_to_tree.has(sid) {
            tids.push(ed.scene_to_tree[sid])
        }
    }
    $primary_tid := -1
    if ed.scene_to_tree.has(ed.selected_node) {
        primary_tid = ed.scene_to_tree[ed.selected_node]
    }
    tree_set_sel_nodes($&ed.tree, &tids, primary_tid)
    if reveal && primary_tid >= 0 {
        tree_reveal_sel($&ed.tree)
    }
}

pub fn (ed $&Editor) set_selection_list(nodes &[]int, view $&widgets.View) {
    doc := ed.draft.document() >>> (err) { << }
    $valid := []int{}
    $seen := map[int]bool{}
    for i in 0:nodes.len {
        idx := nodes[i]
        if idx >= 0 && idx < doc.node_count() && !seen.has(idx) {
            seen[idx] = true
            valid.push(idx)
        }
    }
    if valid.len == 0 {
        valid.push(0)
    }
    ed.selected_nodes = valid
    ed.selected_node = ed.selected_nodes[ed.selected_nodes.len - 1]
    ed.sync_tree_selection(true)
    ed.sync_inspector(&doc)
    ed.sync_toolbar_states()
    repaint(view, ed.id_left_pane)
    repaint(view, ed.id_top_view)
    repaint(view, ed.id_right_pane)
}

fn (ed $&Editor) ensure_context_layout(view $&widgets.View) {
    stage_3d_vis := ed.stage_mode == STAGE_MODE_3D || ed.stage_mode == STAGE_MODE_SPLIT
    bar_vis := stage_3d_vis && (ed.modeling.has_active_mesh || ed.modeling.active_is_csg)
    card_vis := (ed.insp_tab == 1) && ed.insp_can_trs
    csg_vis := bar_vis && ed.modeling.active_is_csg
    stats_vis := (ed.insp_tab == 2) && ed.modeling.has_active_mesh
    $want_place := false
    if ed.left_tab == 1 {
        want_place = selected_asset_is_glb(ed) && ed.stage_mode != STAGE_MODE_TILEMAP
    }
    $place_diff := false
    if ed.left_tab == 1 {
        ab := view.node_bounds(ed.id_asset_row) >>> (err) {
            _ := err
            <<
        }
        place_diff = want_place != (ab.height > 1.0)
    }
    $surf_diff := false
    if ed.insp_tab == 2 {
        want_surf := ed.surf_attached || (ed.comp_manual_open.len > 0 && ed.comp_manual_open[0])
        sb := view.node_bounds(ed.id_surf_box) >>> (err) {
            _ := err
            <<
        }
        surf_diff = want_surf != (sb.height > 1.0)
    }
    $want_apply := ed.insp_tab != 2 && (ed.insp_dirty || ed.modeling.mat_dirty)
    ab_apply := view.node_bounds(ed.id_apply_btn) >>> (err) {
        _ := err
        <<
    }
    apply_diff := want_apply != (ab_apply.height > 1.0)
    if stage_3d_vis != ed.modeling.stage_3d_visible ||
       bar_vis != ed.modeling.bar_visible || card_vis != ed.modeling.card_visible ||
       csg_vis != ed.modeling.csg_visible || stats_vis != ed.modeling.stats_visible ||
       place_diff || surf_diff || apply_diff || ed.insp_tab == 2 {
        _ := ed.sync_layout(view, ed.viewport_w, ed.viewport_h) >>> (err) {
            _ := err
            <<
        }
    }
}

pub fn (ed $&Editor) reset_comp_manual_open() {
    for ci in 0:ed.comp_manual_open.len {
        ed.comp_manual_open[ci] = false
    }
}

pub fn (ed $&Editor) select_scene_node(index int, view $&widgets.View) {
    doc := ed.draft.document() >>> (err) { << }
    if index < 0 || index >= doc.node_count() { << }
    ed.reset_comp_manual_open()
    ed.set_single_selection(index)
    ed.sync_tree_selection(true)
    ed.sync_inspector(&doc)
    ed.ensure_context_layout(view)
    ed.sync_toolbar_states()
    repaint(view, ed.id_left_pane)
    repaint(view, ed.id_top_view)
    repaint(view, ed.id_right_pane)
}

pub fn (ed $&Editor) do_apply_visible_only(view $&widgets.View) {
    doc := ed.draft.document() >>> (err) {
        ed.set_status(STATUS_ERR, err.msg(), view)
        <<
    }
    targets := ed.effective_selected_nodes(&doc)
    next_vis := ed.visible_chk.value()
    d := $&ed.draft
    d.set_nodes_visible_only(&targets, next_vis) >>> (err) {
        ed.set_status(STATUS_ERR, err.msg(), view)
        <<
    }
    ed.refresh_after_document_change(false, view)
    if targets.len > 1 {
        if next_vis {
            ed.set_status(STATUS_OK, tr(ed.lang, "Shown " + str(targets.len) + " nodes", "已显示 " + str(targets.len) + " 个节点"), view)
        } else {
            ed.set_status(STATUS_OK, tr(ed.lang, "Hidden " + str(targets.len) + " nodes", "已隐藏 " + str(targets.len) + " 个节点"), view)
        }
    } else {
        ed.set_status(STATUS_OK, tr(ed.lang, "Updated visibility", "已更新可见性"), view)
    }
}

pub fn (ed $&Editor) do_apply_process_only(view $&widgets.View) {
    doc := ed.draft.document() >>> (err) {
        ed.set_status(STATUS_ERR, err.msg(), view)
        <<
    }
    targets := ed.effective_selected_nodes(&doc)
    $proc_mode := ed.process_select.selected()
    if proc_mode < resource.PROCESS_INHERIT || proc_mode > resource.PROCESS_DISABLED {
        proc_mode = resource.PROCESS_INHERIT
    }
    d := $&ed.draft
    d.set_nodes_properties_batch(
        &targets,
        false, true,
        true, proc_mode,
        false, false, false, fm.vec3(0.0, 0.0, 0.0),
        false, false, false, fm.vec3(0.0, 0.0, 0.0),
        false, false, false, fm.vec3(1.0, 1.0, 1.0)
    ) >>> (err) {
        ed.set_status(STATUS_ERR, err.msg(), view)
        <<
    }
    ed.refresh_after_document_change(false, view)
    ed.set_status(STATUS_OK, tr(ed.lang, "Updated process mode on " + str(targets.len) + " nodes", "已更新 " + str(targets.len) + " 个节点的运行模式"), view)
}

fn (ed $&Editor) apply_inspector_multi(view $&widgets.View) int {
    doc := ed.draft.document() >>> (err) {
        ed.set_status(STATUS_ERR, err.msg(), view)
        >> err
    }
    targets := ed.effective_selected_nodes(&doc)
    vis := ed.visible_chk.value()
    chg_vis := vis != ed.vis_seed
    $proc_mode := ed.process_select.selected()
    if proc_mode < resource.PROCESS_INHERIT || proc_mode > resource.PROCESS_DISABLED {
        proc_mode = resource.PROCESS_INHERIT
    }
    chg_proc := proc_mode != ed.proc_seed

    px_raw := ed.pos_x.value()
    py_raw := ed.pos_y.value()
    pz_raw := ed.pos_z.value()
    rx_raw := ed.rot_x.value()
    ry_raw := ed.rot_y.value()
    rz_raw := ed.rot_z.value()
    sx_raw := ed.scale_x.value()
    sy_raw := ed.scale_y.value()
    sz_raw := ed.scale_z.value()

    chg_px := (px_raw != ed.pos_seed_x) && (strings.trim_space(&px_raw).len > 0)
    chg_py := (py_raw != ed.pos_seed_y) && (strings.trim_space(&py_raw).len > 0)
    chg_pz := (pz_raw != ed.pos_seed_z) && (strings.trim_space(&pz_raw).len > 0)
    chg_rx := (rx_raw != ed.rot_seed_x) && (strings.trim_space(&rx_raw).len > 0)
    chg_ry := (ry_raw != ed.rot_seed_y) && (strings.trim_space(&ry_raw).len > 0)
    chg_rz := (rz_raw != ed.rot_seed_z) && (strings.trim_space(&rz_raw).len > 0)
    chg_sx := (sx_raw != ed.scale_seed_x) && (strings.trim_space(&sx_raw).len > 0)
    chg_sy := (sy_raw != ed.scale_seed_y) && (strings.trim_space(&sy_raw).len > 0)
    chg_sz := (sz_raw != ed.scale_seed_z) && (strings.trim_space(&sz_raw).len > 0)

    $px := 0.0
    $py := 0.0
    $pz := 0.0
    $rx := 0.0
    $ry := 0.0
    $rz := 0.0
    $sx := 1.0
    $sy := 1.0
    $sz := 1.0
    if chg_px {
        px = parse_f64_or(&px_raw, "Position X") >>> (err) {
            ed.set_status(STATUS_ERR, err.msg(), view)
            >> err
        }
    }
    if chg_py {
        py = parse_f64_or(&py_raw, "Position Y") >>> (err) {
            ed.set_status(STATUS_ERR, err.msg(), view)
            >> err
        }
    }
    if chg_pz {
        pz = parse_f64_or(&pz_raw, "Position Z") >>> (err) {
            ed.set_status(STATUS_ERR, err.msg(), view)
            >> err
        }
    }
    if chg_rx {
        rx = parse_f64_or(&rx_raw, "Rotation X") >>> (err) {
            ed.set_status(STATUS_ERR, err.msg(), view)
            >> err
        }
    }
    if chg_ry {
        ry = parse_f64_or(&ry_raw, "Rotation Y") >>> (err) {
            ed.set_status(STATUS_ERR, err.msg(), view)
            >> err
        }
    }
    if chg_rz {
        rz = parse_f64_or(&rz_raw, "Rotation Z") >>> (err) {
            ed.set_status(STATUS_ERR, err.msg(), view)
            >> err
        }
    }
    if chg_sx {
        sx = parse_f64_or(&sx_raw, "Scale X") >>> (err) {
            ed.set_status(STATUS_ERR, err.msg(), view)
            >> err
        }
    }
    if chg_sy {
        sy = parse_f64_or(&sy_raw, "Scale Y") >>> (err) {
            ed.set_status(STATUS_ERR, err.msg(), view)
            >> err
        }
    }
    if chg_sz {
        sz = parse_f64_or(&sz_raw, "Scale Z") >>> (err) {
            ed.set_status(STATUS_ERR, err.msg(), view)
            >> err
        }
    }

    base_len := ed.draft.undo.len
    base_raw := ed.draft.current + ""
    targets3d := ed.selected_3d_targets(&doc)
    d := $&ed.draft
    d.set_nodes_properties_batch(
        &targets,
        chg_vis, vis,
        chg_proc, proc_mode,
        chg_px, chg_py, chg_pz, fm.vec3(px, py, pz),
        chg_rx, chg_ry, chg_rz, fm.vec3(rx, ry, rz),
        chg_sx, chg_sy, chg_sz, fm.vec3(sx, sy, sz)
    ) >>> (err) {
        ed.set_status(STATUS_ERR, err.msg(), view)
        >> err
    }

    mat_commit := ed.modeling.mat_dirty && ed.insp_can_trs && targets3d.len > 0
    if mat_commit {
        ed.try_commit_pbr_fields_quiet_multi(&targets3d)
        ed.modeling.mat_dirty = false
        d2 := $&ed.draft
        d2.collapse_undo_to(base_len, base_raw)
    }
    ed.name_error = ""
    ed.insp_dirty = false
    ed.modeling.mat_dirty = false
    ed.refresh_after_document_change(false, view)
    ed.set_status(STATUS_OK, tr(ed.lang, "Applied changes to " + str(targets.len) + " nodes", "已应用更改到 " + str(targets.len) + " 个节点"), view)
    << 0
}

pub fn (ed $&Editor) apply_inspector(view $&widgets.View) int {
    if ed.selected_nodes.len > 1 {
        << ed.apply_inspector_multi(view) >>>
    }
    raw_name := ed.name_field.value()
    trimmed := strings.trim_space(&raw_name)
    if !valid_node_name(&trimmed) {
        ed.name_error = "1..255 bytes; no /, ., .. or control chars"
        ed.refresh_name_decoration(&raw_name)
        _ := ed.sync_layout(view, ed.viewport_w, ed.viewport_h) >>> (err) {
            _ := err
            << 0
        }
        ed.set_status(STATUS_ERR, "Invalid node name", view)
        repaint(view, ed.id_right_pane)
        >> errors.new("nexus editor: invalid node name")
    }
    px := parse_f64_or(&ed.pos_x.value(), "Position X") >>> (err) {
        ed.set_status(STATUS_ERR, err.msg(), view)
        >> err
    }
    py := parse_f64_or(&ed.pos_y.value(), "Position Y") >>> (err) {
        ed.set_status(STATUS_ERR, err.msg(), view)
        >> err
    }
    pz := parse_f64_or(&ed.pos_z.value(), "Position Z") >>> (err) {
        ed.set_status(STATUS_ERR, err.msg(), view)
        >> err
    }
    rx := parse_f64_or(&ed.rot_x.value(), "Rotation X") >>> (err) {
        ed.set_status(STATUS_ERR, err.msg(), view)
        >> err
    }
    ry := parse_f64_or(&ed.rot_y.value(), "Rotation Y") >>> (err) {
        ed.set_status(STATUS_ERR, err.msg(), view)
        >> err
    }
    rz := parse_f64_or(&ed.rot_z.value(), "Rotation Z") >>> (err) {
        ed.set_status(STATUS_ERR, err.msg(), view)
        >> err
    }
    sx := parse_f64_or(&ed.scale_x.value(), "Scale X") >>> (err) {
        ed.set_status(STATUS_ERR, err.msg(), view)
        >> err
    }
    sy := parse_f64_or(&ed.scale_y.value(), "Scale Y") >>> (err) {
        ed.set_status(STATUS_ERR, err.msg(), view)
        >> err
    }
    sz := parse_f64_or(&ed.scale_z.value(), "Scale Z") >>> (err) {
        ed.set_status(STATUS_ERR, err.msg(), view)
        >> err
    }

    rs_changed := ed.rot_x.value() != ed.rot_seed_x ||
        ed.rot_y.value() != ed.rot_seed_y ||
        ed.rot_z.value() != ed.rot_seed_z ||
        ed.scale_x.value() != ed.scale_seed_x ||
        ed.scale_y.value() != ed.scale_seed_y ||
        ed.scale_z.value() != ed.scale_seed_z

    sel_node := ed.selected_node
    vis := ed.visible_chk.value()
    $proc_mode := ed.process_select.selected()
    if proc_mode < resource.PROCESS_INHERIT || proc_mode > resource.PROCESS_DISABLED {
        proc_mode = resource.PROCESS_INHERIT
    }
    name_copy := trimmed + ""
    d := $&ed.draft
    d.set_node_full_properties(
        sel_node,
        name_copy,
        vis,
        proc_mode,
        fm.vec3(px, py, pz),
        rs_changed,
        fm.vec3(rx, ry, rz),
        fm.vec3(sx, sy, sz)
    ) >>> (err) {
        ed.name_error = err.msg()
        ed.refresh_name_decoration(&raw_name)
        _ := ed.sync_layout(view, ed.viewport_w, ed.viewport_h) >>> (err2) {
            _ := err2
            << 0
        }
        ed.set_status(STATUS_ERR, err.msg(), view)
        repaint(view, ed.id_right_pane)
        >> err
    }

    mat_commit := ed.modeling.mat_dirty && ed.insp_can_trs && sel_node > 0
    if mat_commit {
        ed.try_commit_pbr_fields_quiet(sel_node)
        ed.modeling.mat_dirty = false
    }
    ed.name_error = ""
    ed.insp_dirty = false
    ed.modeling.mat_dirty = false
    ed.refresh_after_document_change(false, view)
    ed.set_status(STATUS_OK, tr(ed.lang, "Applied changes to " + trimmed, "已应用更改：" + trimmed), view)
    << 0
}

fn parse_f64_or(raw &string, label string) f64 {
    t := strings.trim_space(raw)
    if t.len == 0 {
        >> errors.new(label + " is required")
    }
    v := strconv.parse_float(&t) >>> (err) {
        >> errors.new(label + " must be a finite number")
    }
    if math.is_nan(v) || math.is_inf(v) {
        >> errors.new(label + " must be a finite number")
    }
    << v
}

fn (ed $&Editor) blur_all_fields() {
    focus_field($&ed.name_field, false)
    focus_field($&ed.prim_field, false)
    focus_field($&ed.pos_x, false)
    focus_field($&ed.pos_y, false)
    focus_field($&ed.pos_z, false)
    focus_field($&ed.rot_x, false)
    focus_field($&ed.rot_y, false)
    focus_field($&ed.rot_z, false)
    focus_field($&ed.scale_x, false)
    focus_field($&ed.scale_y, false)
    focus_field($&ed.scale_z, false)
    focus_field($&ed.surf_prim_field, false)
    focus_field($&ed.lod_hyst_field, false)
    focus_field($&ed.lod_dist_field, false)
    focus_field($&ed.lod_prim_field, false)
    comp_blur_all($&ed.comp)
    panels_blur_all($&ed.panels)
    modeling_blur_all($&ed.modeling)
}

fn (ed $&Editor) open_snap_modal(view $&widgets.View) {
    ed.blur_all_fields()
    sn := ed.snap
    vw := ed.viewport_w
    vh := ed.viewport_h
    st := ed.styles.clone()
    mods := $&ed.modals
    mods.open_snap(&sn)
    mods.layout(vw, vh, &st)
    repaint(view, ed.id_root)
}

