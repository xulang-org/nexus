fn zero_rect() layout.Rect {
    << layout.Rect{x: 0.0, y: 0.0, width: 80.0, height: 28.0}
}

fn leaf_box(w f64, h f64) layout.BoxStyle {
    $b := layout.box_style(layout.BOX_LEAF)
    b.width = w
    b.height = h
    << b
}

fn row_box(w f64, h f64, gap f64) layout.BoxStyle {
    $b := layout.box_style(layout.BOX_ROW)
    b.width = w
    b.height = h
    b.gap = gap
    b.cross_alignment = layout.CROSS_CENTER
    << b
}

fn row_box_end(w f64, h f64, gap f64) layout.BoxStyle {
    $b := layout.box_style(layout.BOX_ROW)
    b.width = w
    b.height = h
    b.gap = gap
    b.cross_alignment = layout.CROSS_END
    << b
}

fn col_box(w f64, h f64, gap f64) layout.BoxStyle {
    $b := layout.box_style(layout.BOX_COLUMN)
    b.width = w
    b.height = h
    b.gap = gap
    b.cross_alignment = layout.CROSS_STRETCH
    << b
}

fn make_plain_field(context &draw.Context, identity &ui.CanvasEvent, id int, label string, val string) widgets.Field {
    $dec := widgets.field_decoration(&label)
    dec.reserve_helper = false
    << widgets.field(context, identity, id, &zero_rect(), &val, &dec) or >>
}

fn make_name_field(context &draw.Context, identity &ui.CanvasEvent, id int, val string) widgets.Field {
    $dec := widgets.field_decoration(&"Name *")
    dec.clearable = true
    dec.helper = byte_counter_text(&val, 255)
    $f := widgets.field(context, identity, id, &zero_rect(), &val, &dec) or >>
    $opts := widgets.field_text_options()
    opts.counter = false
    opts.character_limit = 255
    _ := f.set_text_options(&opts)
    << f
}

fn add_interactive(view $&widgets.View, parent int, box &layout.BoxStyle, cursor int, focusable bool) int {
    id := view.add(parent, box, &layout.Size{width: 0.0, height: 0.0}) or >>
    view.set_input(id, true, focusable) or >>
    view.set_cursor(id, cursor) or >>
    << id
}

fn add_box(view $&widgets.View, parent int, box &layout.BoxStyle) int {
    << view.add(parent, box, &layout.Size{width: 0.0, height: 0.0}) or >>
}

pub fn create_editor_view(context &draw.Context, identity &ui.CanvasEvent, width f64, height f64) widgets.View {
    pal := default_palette()
    $root_b := col_box(width, height, 0.0)
    root_b.clip = true
    $host := widgets.Host{
        context: context.clone(),
        identity: ui.CanvasEvent{window_id: identity.window_id, canvas_id: identity.canvas_id, generation: identity.generation}
    }
    << host.view(&root_b, pal.canvas) or >>
}

pub fn create_editor(
    view $&widgets.View,
    context &draw.Context,
    identity &ui.CanvasEvent,
    project Project,
    output_dir string,
    validator_bin string,
    preview_bin string,
    viewport_bin string,
    width f64,
    height f64
) Editor {
    pal := default_palette()
    styles := make_paper_styles(&pal)
    snap := load_snap_settings(&output_dir)
    lang := load_editor_lang(&output_dir)

    scene_path := project.scene_source(0) or >>
    draft := open_draft(scene_path) or >>

    id_root := view.root()
    view.set_auto_cursor(false)
    view.set_styles(&styles) or >>
    $panels := new_panels_shell()

    // 1. Toolbar (784px <= 940px)
    $tb := row_box(width, f64(TOOLBAR_H), 5.0)
    tb.padding = layout.Insets{left: 8.0, top: 6.0, right: 8.0, bottom: 6.0}
    id_toolbar := add_box(view, id_root, &tb)
    view.set_boundary(id_toolbar, true) or >>

    id_brand := add_box(view, id_toolbar, &leaf_box(56.0, 26.0))
    _ := panels_add_open_btn($&panels, view, id_toolbar, context, identity) or >>
    id_tb_div1 := add_box(view, id_toolbar, &leaf_box(8.0, 22.0))
    id_scene_select := add_interactive(view, id_toolbar, &leaf_box(200.0, 30.0), ui.CURSOR_HAND, true)
    id_new_scene_btn := add_interactive(view, id_toolbar, &leaf_box(30.0, 30.0), ui.CURSOR_HAND, true)
    _ := panels_add_scene_mgr_btn($&panels, view, id_toolbar, context, identity) or >>
    id_globals_btn := add_interactive(view, id_toolbar, &leaf_box(30.0, 30.0), ui.CURSOR_HAND, true)
    id_tb_div2 := add_box(view, id_toolbar, &leaf_box(8.0, 22.0))
    id_undo_btn := add_interactive(view, id_toolbar, &leaf_box(30.0, 30.0), ui.CURSOR_HAND, true)
    id_redo_btn := add_interactive(view, id_toolbar, &leaf_box(30.0, 30.0), ui.CURSOR_HAND, true)
    id_save_btn := add_interactive(view, id_toolbar, &leaf_box(30.0, 30.0), ui.CURSOR_HAND, true)
    id_tb_div3 := add_box(view, id_toolbar, &leaf_box(8.0, 22.0))
    id_preview_btn := add_interactive(view, id_toolbar, &leaf_box(30.0, 30.0), ui.CURSOR_HAND, true)
    _ := panels_add_export_btn($&panels, view, id_toolbar, context, identity) or >>
    id_tb_spacer := add_box(view, id_toolbar, &leaf_box(math.max(4.0, width - 784.0), 24.0))
    _ := panels_add_lang_btn($&panels, view, id_toolbar, context, identity, lang) or >>
    id_dirty_badge := add_box(view, id_toolbar, &leaf_box(82.0, 24.0))

    // 2. Workspace
    body_h := math.max(200.0, height - f64(TOOLBAR_H) - f64(FOOTER_H))
    left_w := 256.0
    right_w := 304.0
    center_w := math.max(f64(MIN_CENTER_W), width - left_w - right_w - f64(SPLITTER_W) * 2.0)
    $ws := row_box(width, body_h, 0.0)
    ws.cross_alignment = layout.CROSS_STRETCH
    id_workspace := add_box(view, id_root, &ws)

    // Left pane
    $lp := col_box(left_w, body_h, 4.0)
    lp.padding = layout.Insets{left: 8.0, top: 8.0, right: 8.0, bottom: 8.0}
    id_left_pane := add_box(view, id_workspace, &lp)
    view.set_boundary(id_left_pane, true) or >>
    inner_lw := left_w - 16.0
    avail_flex := math.max(106.0, (body_h - 16.0) - 256.0)
    tree_h := math.max(84.0, math.min(avail_flex - 22.0, avail_flex * panels.left_tree_ratio))
    prims_h := math.max(22.0, avail_flex - tree_h)
    panels.avail_flex = avail_flex
    panels.last_tree_h = tree_h

    id_tree_hdr := panels_create_tree_tools($&panels, view, id_left_pane, inner_lw, context, identity) or >>
    id_tree_btns := add_box(view, id_left_pane, &row_box(inner_lw, 28.0, 3.0))
    bw7 := math.max(24.0, (inner_lw - 18.0) / 7.0)
    id_add_3d_btn := add_interactive(view, id_tree_btns, &leaf_box(bw7, 26.0), ui.CURSOR_HAND, true)
    id_add_2d_btn := add_interactive(view, id_tree_btns, &leaf_box(bw7, 26.0), ui.CURSOR_HAND, true)
    id_add_grp_btn := add_interactive(view, id_tree_btns, &leaf_box(bw7, 26.0), ui.CURSOR_HAND, true)
    id_add_cam_btn := add_interactive(view, id_tree_btns, &leaf_box(bw7, 26.0), ui.CURSOR_HAND, true)
    id_add_lgt_btn := add_interactive(view, id_tree_btns, &leaf_box(bw7, 26.0), ui.CURSOR_HAND, true)
    id_dup_btn := add_interactive(view, id_tree_btns, &leaf_box(bw7, 26.0), ui.CURSOR_HAND, true)
    id_del_btn := add_interactive(view, id_tree_btns, &leaf_box(bw7, 26.0), ui.CURSOR_HAND, true)

    id_tree := add_interactive(view, id_left_pane, &leaf_box(inner_lw, tree_h), ui.CURSOR_DEFAULT, true)
    view.set_capture_outside(id_tree, true) or >>
    panels.id_left_hsplit = add_interactive(view, id_left_pane, &leaf_box(inner_lw, 8.0), ui.CURSOR_RESIZE_VERTICAL, false)
    id_assets_hdr_row := add_box(view, id_left_pane, &row_box(inner_lw, 26.0, 3.0))
    id_assets_hdr := add_box(view, id_assets_hdr_row, &leaf_box(math.max(50.0, inner_lw - 84.0), 24.0))
    id_import_btn := add_interactive(view, id_assets_hdr_row, &leaf_box(25.0, 24.0), ui.CURSOR_HAND, true)
    _ := panels_add_asset_hdr_btns($&panels, view, id_assets_hdr_row, context, identity) or >>
    id_asset_select := add_interactive(view, id_left_pane, &leaf_box(inner_lw, 30.0), ui.CURSOR_HAND, true)
    id_asset_meta := add_interactive(view, id_left_pane, &leaf_box(inner_lw, 18.0), ui.CURSOR_TEXT, true)
    view.set_capture_outside(id_asset_meta, true) or >>
    _ := panels_create_asset_extras($&panels, view, id_left_pane, inner_lw, prims_h, context, identity) or >>
    id_asset_row := add_box(view, id_left_pane, &row_box_end(inner_lw, 44.0, 6.0))
    id_prim_field := add_interactive(view, id_asset_row, &leaf_box(62.0, 44.0), ui.CURSOR_TEXT, true)
    view.set_capture_outside(id_prim_field, true) or >>
    id_place_btn := add_interactive(view, id_asset_row, &leaf_box(math.max(80.0, inner_lw - 68.0), 34.0), ui.CURSOR_HAND, true)

    id_left_split := add_interactive(view, id_workspace, &leaf_box(f64(SPLITTER_W), body_h), ui.CURSOR_RESIZE_HORIZONTAL, false)

    // Center pane
    $cp := col_box(center_w, body_h, 6.0)
    cp.padding = layout.Insets{left: 8.0, top: 8.0, right: 8.0, bottom: 8.0}
    id_center_pane := add_box(view, id_workspace, &cp)
    view.set_boundary(id_center_pane, true) or >>
    inner_cw := center_w - 16.0
    id_stage_bar := add_box(view, id_center_pane, &row_box(inner_cw, 30.0, 4.0))
    id_stage_title := add_box(view, id_stage_bar, &leaf_box(math.max(60.0, inner_cw - 176.0), 26.0))
    id_stage_axis_btn := add_interactive(view, id_stage_bar, &leaf_box(36.0, 28.0), ui.CURSOR_HAND, true)
    id_stage_snap_btn := add_interactive(view, id_stage_bar, &leaf_box(30.0, 28.0), ui.CURSOR_HAND, true)
    id_fit_btn := add_interactive(view, id_stage_bar, &leaf_box(30.0, 28.0), ui.CURSOR_HAND, true)
    id_view3d_btn := add_interactive(view, id_stage_bar, &leaf_box(30.0, 28.0), ui.CURSOR_HAND, true)
    id_snap_btn := add_interactive(view, id_stage_bar, &leaf_box(30.0, 28.0), ui.CURSOR_HAND, true)
    id_top_view := add_interactive(view, id_center_pane, &leaf_box(inner_cw, math.max(120.0, body_h - 52.0)), ui.CURSOR_DEFAULT, true)
    view.set_boundary(id_top_view, true) or >>
    view.set_capture_outside(id_top_view, true) or >>

    id_right_split := add_interactive(view, id_workspace, &leaf_box(f64(SPLITTER_W), body_h), ui.CURSOR_RESIZE_HORIZONTAL, false)

    // Right pane (Inspector)
    $rp := col_box(right_w, body_h, 4.0)
    rp.padding = layout.Insets{left: 8.0, top: 8.0, right: 8.0, bottom: 8.0}
    id_right_pane := add_box(view, id_workspace, &rp)
    view.set_boundary(id_right_pane, true) or >>
    inner_rw := right_w - 16.0
    scroll_h := math.max(120.0, body_h - 78.0)
    scroll_cw := math.max(120.0, inner_rw - 12.0)
    tri_w := (scroll_cw - 8.0) / 3.0

    id_insp_hdr := add_interactive(view, id_right_pane, &leaf_box(inner_rw, 22.0), ui.CURSOR_TEXT, true)
    view.set_capture_outside(id_insp_hdr, true) or >>

    $sb := col_box(inner_rw, scroll_h, 4.0)
    sb.clip = true
    sb.padding = layout.Insets{left: 0.0, top: 0.0, right: 12.0, bottom: 8.0}
    id_insp_scroll := add_interactive(view, id_right_pane, &sb, ui.CURSOR_DEFAULT, false)
    view.set_capture_outside(id_insp_scroll, true) or >>

    id_name_field := add_interactive(view, id_insp_scroll, &leaf_box(scroll_cw, 62.0), ui.CURSOR_TEXT, true)
    view.set_capture_outside(id_name_field, true) or >>
    id_vis_proc_row := add_box(view, id_insp_scroll, &row_box(scroll_cw, 32.0, 6.0))
    vis_w := math.max(76.0, scroll_cw * 0.40)
    id_visible_chk := add_interactive(view, id_vis_proc_row, &leaf_box(vis_w, 26.0), ui.CURSOR_HAND, true)
    id_process_select := add_interactive(view, id_vis_proc_row, &leaf_box(math.max(90.0, scroll_cw - vis_w - 6.0), 30.0), ui.CURSOR_HAND, true)
    id_parent_row := add_box(view, id_insp_scroll, &row_box(scroll_cw, 32.0, 6.0))
    id_parent_select := add_interactive(view, id_parent_row, &leaf_box(math.max(90.0, scroll_cw - 84.0), 30.0), ui.CURSOR_HAND, true)
    id_reparent_btn := add_interactive(view, id_parent_row, &leaf_box(78.0, 30.0), ui.CURSOR_HAND, true)

    id_pos_lbl := add_box(view, id_insp_scroll, &leaf_box(scroll_cw, 16.0))
    id_pos_row := add_box(view, id_insp_scroll, &row_box(scroll_cw, 44.0, 4.0))
    id_pos_x := add_interactive(view, id_pos_row, &leaf_box(tri_w, 44.0), ui.CURSOR_TEXT, true)
    id_pos_y := add_interactive(view, id_pos_row, &leaf_box(tri_w, 44.0), ui.CURSOR_TEXT, true)
    id_pos_z := add_interactive(view, id_pos_row, &leaf_box(tri_w, 44.0), ui.CURSOR_TEXT, true)
    view.set_capture_outside(id_pos_x, true) or >>
    view.set_capture_outside(id_pos_y, true) or >>
    view.set_capture_outside(id_pos_z, true) or >>

    id_rot_lbl := add_box(view, id_insp_scroll, &leaf_box(scroll_cw, 16.0))
    id_rot_row := add_box(view, id_insp_scroll, &row_box(scroll_cw, 44.0, 4.0))
    id_rot_x := add_interactive(view, id_rot_row, &leaf_box(tri_w, 44.0), ui.CURSOR_TEXT, true)
    id_rot_y := add_interactive(view, id_rot_row, &leaf_box(tri_w, 44.0), ui.CURSOR_TEXT, true)
    id_rot_z := add_interactive(view, id_rot_row, &leaf_box(tri_w, 44.0), ui.CURSOR_TEXT, true)
    view.set_capture_outside(id_rot_x, true) or >>
    view.set_capture_outside(id_rot_y, true) or >>
    view.set_capture_outside(id_rot_z, true) or >>

    id_scale_lbl := add_box(view, id_insp_scroll, &leaf_box(scroll_cw, 16.0))
    id_scale_row := add_box(view, id_insp_scroll, &row_box(scroll_cw, 44.0, 4.0))
    id_scale_x := add_interactive(view, id_scale_row, &leaf_box(tri_w, 44.0), ui.CURSOR_TEXT, true)
    id_scale_y := add_interactive(view, id_scale_row, &leaf_box(tri_w, 44.0), ui.CURSOR_TEXT, true)
    id_scale_z := add_interactive(view, id_scale_row, &leaf_box(tri_w, 44.0), ui.CURSOR_TEXT, true)
    view.set_capture_outside(id_scale_x, true) or >>
    view.set_capture_outside(id_scale_y, true) or >>
    view.set_capture_outside(id_scale_z, true) or >>

    id_surf_info := add_interactive(view, id_insp_scroll, &leaf_box(scroll_cw, 18.0), ui.CURSOR_TEXT, true)
    view.set_capture_outside(id_surf_info, true) or >>

    id_surf_div := add_box(view, id_insp_scroll, &leaf_box(scroll_cw, 4.0))
    id_surf_card_hdr := add_box(view, id_insp_scroll, &leaf_box(scroll_cw, 18.0))
    id_surf_bind_row := add_box(view, id_insp_scroll, &row_box(scroll_cw, 32.0, 4.0))
    id_surf_asset_select := add_interactive(view, id_surf_bind_row, &leaf_box(scroll_cw, 30.0), ui.CURSOR_HAND, true)
    id_surf_btn_row := add_box(view, id_insp_scroll, &row_box_end(scroll_cw, 44.0, 4.0))
    id_surf_prim_field := add_interactive(view, id_surf_btn_row, &leaf_box(58.0, 44.0), ui.CURSOR_TEXT, true)
    view.set_capture_outside(id_surf_prim_field, true) or >>
    sbtn_w := math.max(48.0, (scroll_cw - 66.0) * 0.5)
    id_surf_bind_btn := add_interactive(view, id_surf_btn_row, &leaf_box(sbtn_w, 34.0), ui.CURSOR_HAND, true)
    id_surf_clear_btn := add_interactive(view, id_surf_btn_row, &leaf_box(sbtn_w, 34.0), ui.CURSOR_HAND, true)

    id_lod_info := add_interactive(view, id_insp_scroll, &leaf_box(scroll_cw, 18.0), ui.CURSOR_TEXT, true)
    view.set_capture_outside(id_lod_info, true) or >>
    id_lod_input_row := add_box(view, id_insp_scroll, &row_box(scroll_cw, 44.0, 4.0))
    id_lod_hyst_field := add_interactive(view, id_lod_input_row, &leaf_box(tri_w, 44.0), ui.CURSOR_TEXT, true)
    id_lod_dist_field := add_interactive(view, id_lod_input_row, &leaf_box(tri_w, 44.0), ui.CURSOR_TEXT, true)
    id_lod_prim_field := add_interactive(view, id_lod_input_row, &leaf_box(tri_w, 44.0), ui.CURSOR_TEXT, true)
    view.set_capture_outside(id_lod_hyst_field, true) or >>
    view.set_capture_outside(id_lod_dist_field, true) or >>
    view.set_capture_outside(id_lod_prim_field, true) or >>
    id_lod_btn_row := add_box(view, id_insp_scroll, &row_box(scroll_cw, 32.0, 4.0))
    id_lod_asset_select := add_interactive(view, id_lod_btn_row, &leaf_box(math.max(84.0, scroll_cw - 112.0), 30.0), ui.CURSOR_HAND, true)
    id_lod_add_btn := add_interactive(view, id_lod_btn_row, &leaf_box(52.0, 30.0), ui.CURSOR_HAND, true)
    id_lod_pop_btn := add_interactive(view, id_lod_btn_row, &leaf_box(52.0, 30.0), ui.CURSOR_HAND, true)

    id_apply_btn := add_interactive(view, id_right_pane, &leaf_box(inner_rw, 32.0), ui.CURSOR_HAND, true)

    // 3. Footer
    $fb := row_box(width, f64(FOOTER_H), 8.0)
    fb.padding = layout.Insets{left: 10.0, top: 4.0, right: 10.0, bottom: 4.0}
    id_footer := add_box(view, id_root, &fb)
    view.set_boundary(id_footer, true) or >>
    id_status_txt := add_interactive(view, id_footer, &leaf_box(math.max(180.0, width - 420.0), 20.0), ui.CURSOR_TEXT, true)
    view.set_capture_outside(id_status_txt, true) or >>
    id_footer_hint := add_box(view, id_footer, &leaf_box(384.0, 20.0))

    // Controls
    sc_count := min_int_val(project.scenes.len, 64)
    $sc_sel := -1
    if sc_count > 0 { sc_sel = 0 }
    scene_select := widgets.select_box(identity, id_scene_select, &zero_rect(), sc_count, sc_sel) or >>
    $scene_labels := []widgets.StyledLabel{}
    for i in 0:sc_count {
        k := project.scenes[i].key + ""
        scene_labels.push(widgets.styled_label(context, &k))
    }

    as_count := min_int_val(project.assets.len, 64)
    $as_sel := -1
    if as_count > 0 { as_sel = 0 }
    asset_select := widgets.select_box(identity, id_asset_select, &zero_rect(), as_count, as_sel) or >>
    $asset_labels := []widgets.StyledLabel{}
    for i in 0:as_count {
        b := asset_display_label(&project.assets[i].path)
        asset_labels.push(widgets.styled_label(context, &b))
    }

    parent_select := widgets.select_box(identity, id_parent_select, &zero_rect(), 1, 0) or >>
    parent_labels := [widgets.styled_label(context, &"(root)")]

    process_select := widgets.select_box(identity, id_process_select, &zero_rect(), 5, 0) or >>
    process_labels := make_process_labels(context, lang)

    glb_indices := collect_glb_indices(&project)
    surf_asset_select := widgets.select_box(identity, id_surf_asset_select, &zero_rect(), min_int_val(glb_indices.len + 1, 64), 0) or >>
    surf_asset_labels := make_surface_asset_labels(context, &project, &glb_indices, "(None)")
    lod_asset_select := widgets.select_box(identity, id_lod_asset_select, &zero_rect(), min_int_val(glb_indices.len + 1, 64), 0) or >>
    lod_asset_labels := make_surface_asset_labels(context, &project, &glb_indices, "(Same GLB)")
    comp := create_comp_inspector(view, id_insp_scroll, scroll_cw, context, identity, &project, &styles)

    $ed := Editor{
        project: project,
        scene_index: 0,
        draft: draft,
        selected_node: 0,
        selected_nodes: [0],
        top_snap_enabled: false,
        top_pressed_hit: -1,
        top_pressed_shift: false,
        top_commit_dx: 0.0,
        top_commit_dv: 0.0,
        top_marquee_x0: 0.0,
        top_marquee_y0: 0.0,
        top_marquee_x1: 0.0,
        top_marquee_y1: 0.0,
        placing_mode: false,
        snap: snap,
        output_dir: output_dir,
        validator_bin: validator_bin,
        preview_bin: preview_bin,
        viewport_bin: viewport_bin,
        tilemap_bin: "build/nexus-tilemap-editor",
        viewport_w: width,
        viewport_h: height,
        left_w: left_w,
        right_w: right_w,
        dragging_split: 0,
        split_start_gx: 0.0,
        split_orig_w: 0.0,
        top_view: default_top_view(),
        stage_pts: []StagePoint{},
        top_view_local: zero_rect(),
        status_text: tr(lang, "Ready", "就绪"),
        status_kind: STATUS_INFO,
        viewport_active: false,
        preview_active: false,
        import_active: false,
        tilemap_active: false,
        export_active: false,
        open_proj_active: false,
        relocate_active: false,
        close_pending: false,
        req_launch_viewport: false,
        req_launch_preview: false,
        req_import_glb: false,
        req_launch_tilemap: false,
        req_open_project: false,
        req_relocate_asset: false,
        req_export_project: false,
        export_target_dir: "",
        relocate_uid: "",
        pal: pal,
        styles: styles,
        context: context.clone(),
        identity: ui.CanvasEvent{window_id: identity.window_id, canvas_id: identity.canvas_id, generation: identity.generation},
        reduced_motion: false,
        focused_id: 0,
        last_px: 0.0,
        last_py: 0.0,
        pointer_inside: false,
        lang: lang,

        id_root: id_root,
        id_toolbar: id_toolbar,
        id_brand: id_brand,
        id_tb_div1: id_tb_div1,
        id_scene_select: id_scene_select,
        id_new_scene_btn: id_new_scene_btn,
        id_globals_btn: id_globals_btn,
        id_tb_div2: id_tb_div2,
        id_undo_btn: id_undo_btn,
        id_redo_btn: id_redo_btn,
        id_save_btn: id_save_btn,
        id_tb_div3: id_tb_div3,
        id_preview_btn: id_preview_btn,
        id_tb_spacer: id_tb_spacer,
        id_dirty_badge: id_dirty_badge,
        id_workspace: id_workspace,
        id_left_pane: id_left_pane,
        id_tree_hdr: id_tree_hdr,
        id_tree_btns: id_tree_btns,
        id_add_3d_btn: id_add_3d_btn,
        id_add_2d_btn: id_add_2d_btn,
        id_add_grp_btn: id_add_grp_btn,
        id_dup_btn: id_dup_btn,
        id_del_btn: id_del_btn,
        id_add_cam_btn: id_add_cam_btn,
        id_add_lgt_btn: id_add_lgt_btn,
        id_tree: id_tree,
        id_assets_hdr_row: id_assets_hdr_row,
        id_assets_hdr: id_assets_hdr,
        id_import_btn: id_import_btn,
        id_asset_select: id_asset_select,
        id_asset_meta: id_asset_meta,
        id_asset_row: id_asset_row,
        id_prim_field: id_prim_field,
        id_place_btn: id_place_btn,
        id_left_split: id_left_split,
        id_center_pane: id_center_pane,
        id_stage_bar: id_stage_bar,
        id_stage_title: id_stage_title,
        id_stage_axis_btn: id_stage_axis_btn,
        id_stage_snap_btn: id_stage_snap_btn,
        id_fit_btn: id_fit_btn,
        id_view3d_btn: id_view3d_btn,
        id_snap_btn: id_snap_btn,
        id_top_view: id_top_view,
        id_right_split: id_right_split,
        id_right_pane: id_right_pane,
        id_insp_hdr: id_insp_hdr,
        id_insp_scroll: id_insp_scroll,
        id_name_field: id_name_field,
        id_vis_proc_row: id_vis_proc_row,
        id_visible_chk: id_visible_chk,
        id_process_select: id_process_select,
        id_parent_row: id_parent_row,
        id_parent_select: id_parent_select,
        id_reparent_btn: id_reparent_btn,
        id_pos_lbl: id_pos_lbl,
        id_pos_row: id_pos_row,
        id_pos_x: id_pos_x,
        id_pos_y: id_pos_y,
        id_pos_z: id_pos_z,
        id_rot_lbl: id_rot_lbl,
        id_rot_row: id_rot_row,
        id_rot_x: id_rot_x,
        id_rot_y: id_rot_y,
        id_rot_z: id_rot_z,
        id_scale_lbl: id_scale_lbl,
        id_scale_row: id_scale_row,
        id_scale_x: id_scale_x,
        id_scale_y: id_scale_y,
        id_scale_z: id_scale_z,
        id_surf_info: id_surf_info,
        id_surf_div: id_surf_div,
        id_surf_card_hdr: id_surf_card_hdr,
        id_surf_bind_row: id_surf_bind_row,
        id_surf_asset_select: id_surf_asset_select,
        id_surf_prim_field: id_surf_prim_field,
        id_surf_btn_row: id_surf_btn_row,
        id_surf_bind_btn: id_surf_bind_btn,
        id_surf_clear_btn: id_surf_clear_btn,
        id_lod_info: id_lod_info,
        id_lod_input_row: id_lod_input_row,
        id_lod_hyst_field: id_lod_hyst_field,
        id_lod_dist_field: id_lod_dist_field,
        id_lod_prim_field: id_lod_prim_field,
        id_lod_btn_row: id_lod_btn_row,
        id_lod_asset_select: id_lod_asset_select,
        id_lod_add_btn: id_lod_add_btn,
        id_lod_pop_btn: id_lod_pop_btn,
        id_apply_btn: id_apply_btn,
        id_footer: id_footer,
        id_status_txt: id_status_txt,
        id_footer_hint: id_footer_hint,

        scene_select: scene_select,
        scene_labels: scene_labels,
        empty_lbl: widgets.styled_label(context, &""),
        no_asset_lbl: widgets.styled_label(context, &"(No assets)"),
        root_parent_lbl: widgets.styled_label(context, &"(root)"),
        scene_origin: zero_rect(),
        new_scene_btn: widgets.button(identity, id_new_scene_btn, &zero_rect()) or >>,
        new_scene_lbl: widgets.styled_label(context, &"+ Scene"),
        globals_btn: widgets.button(identity, id_globals_btn, &zero_rect()) or >>,
        globals_lbl: widgets.styled_label(context, &"Globals"),
        undo_btn: widgets.button(identity, id_undo_btn, &zero_rect()) or >>,
        undo_lbl: widgets.styled_label(context, &"Undo"),
        redo_btn: widgets.button(identity, id_redo_btn, &zero_rect()) or >>,
        redo_lbl: widgets.styled_label(context, &"Redo"),
        save_btn: widgets.button(identity, id_save_btn, &zero_rect()) or >>,
        save_lbl: widgets.styled_label(context, &"Save"),
        preview_btn: widgets.button(identity, id_preview_btn, &zero_rect()) or >>,
        preview_lbl: widgets.styled_label(context, &"Preview"),

        add_3d_btn: widgets.button(identity, id_add_3d_btn, &zero_rect()) or >>,
        add_3d_lbl: widgets.styled_label(context, &"+ 3D"),
        add_2d_btn: widgets.button(identity, id_add_2d_btn, &zero_rect()) or >>,
        add_2d_lbl: widgets.styled_label(context, &"+ 2D"),
        add_grp_btn: widgets.button(identity, id_add_grp_btn, &zero_rect()) or >>,
        add_grp_lbl: widgets.styled_label(context, &"+ Grp"),
        dup_btn: widgets.button(identity, id_dup_btn, &zero_rect()) or >>,
        dup_lbl: widgets.styled_label(context, &"Dup"),
        del_btn: widgets.button(identity, id_del_btn, &zero_rect()) or >>,
        del_lbl: widgets.styled_label(context, &"Del"),
        add_cam_btn: widgets.button(identity, id_add_cam_btn, &zero_rect()) or >>,
        add_cam_lbl: widgets.styled_label(context, &"+ Cam"),
        add_lgt_btn: widgets.button(identity, id_add_lgt_btn, &zero_rect()) or >>,
        add_lgt_lbl: widgets.styled_label(context, &"+ Lgt"),
        tree: widgets.tree_view(context, identity, id_tree, &layout.Rect{x: 0.0, y: 0.0, width: 220.0, height: 240.0}) or >>,
        tree_origin: zero_rect(),
        tree_to_scene: map[int]int{},
        scene_to_tree: map[int]int{},

        import_btn: widgets.button(identity, id_import_btn, &zero_rect()) or >>,
        import_lbl: widgets.styled_label(context, &"Import..."),
        asset_select: asset_select,
        asset_labels: asset_labels,
        asset_origin: zero_rect(),
        glb_indices: glb_indices,
        prim_field: make_plain_field(context, identity, id_prim_field, "Prim", "0"),
        place_btn: widgets.button(identity, id_place_btn, &zero_rect()) or >>,
        place_lbl: widgets.styled_label(context, &"Place GLB"),

        stage_axis_btn: widgets.button(identity, id_stage_axis_btn, &zero_rect()) or >>,
        stage_axis_lbl: widgets.styled_label(context, &"XZ"),
        stage_snap_btn: widgets.button(identity, id_stage_snap_btn, &zero_rect()) or >>,
        stage_snap_lbl: widgets.styled_label(context, &"Snap:Off"),
        fit_btn: widgets.button(identity, id_fit_btn, &zero_rect()) or >>,
        fit_lbl: widgets.styled_label(context, &"Fit"),
        view3d_btn: widgets.button(identity, id_view3d_btn, &zero_rect()) or >>,
        view3d_lbl: widgets.styled_label(context, &"3D View"),
        snap_btn: widgets.button(identity, id_snap_btn, &zero_rect()) or >>,
        snap_lbl: widgets.styled_label(context, &"Snap..."),

        insp_scroll: widgets.scroll(identity, id_insp_scroll, &layout.Rect{x: 0.0, y: 0.0, width: 200.0, height: 200.0}, widgets.AXIS_VERTICAL, 400.0) or >>,
        name_field: make_name_field(context, identity, id_name_field, ""),
        name_error: "",
        visible_chk: widgets.checkbox(identity, id_visible_chk, &zero_rect(), true) or >>,
        visible_lbl: widgets.styled_label(context, &"Visible"),
        process_select: process_select,
        process_labels: process_labels,
        process_origin: zero_rect(),
        parent_select: parent_select,
        parent_labels: parent_labels,
        parent_candidates: [0],
        parent_origin: zero_rect(),
        reparent_btn: widgets.button(identity, id_reparent_btn, &zero_rect()) or >>,
        reparent_lbl: widgets.styled_label(context, &"Reparent"),

        pos_x: make_plain_field(context, identity, id_pos_x, "X", "0"),
        pos_y: make_plain_field(context, identity, id_pos_y, "Y", "0"),
        pos_z: make_plain_field(context, identity, id_pos_z, "Z", "0"),
        rot_x: make_plain_field(context, identity, id_rot_x, "RX", "0"),
        rot_y: make_plain_field(context, identity, id_rot_y, "RY", "0"),
        rot_z: make_plain_field(context, identity, id_rot_z, "RZ", "0"),
        scale_x: make_plain_field(context, identity, id_scale_x, "SX", "1"),
        scale_y: make_plain_field(context, identity, id_scale_y, "SY", "1"),
        scale_z: make_plain_field(context, identity, id_scale_z, "SZ", "1"),
        rot_seed_x: "0",
        rot_seed_y: "0",
        rot_seed_z: "0",
        scale_seed_x: "1",
        scale_seed_y: "1",
        scale_seed_z: "1",
        surf_text: "No surface attached",
        lod_text: "LOD: none",
        insp_kind_text: "Node3D",
        insp_editable: true,
        insp_can_trs: true,
        insp_can_2d: false,

        surf_div: widgets.divider(&zero_rect(), widgets.AXIS_HORIZONTAL) or >>,
        surf_asset_select: surf_asset_select,
        surf_asset_labels: surf_asset_labels,
        surf_asset_origin: zero_rect(),
        surf_prim_field: make_plain_field(context, identity, id_surf_prim_field, "Prim", "0"),
        surf_bind_btn: widgets.button(identity, id_surf_bind_btn, &zero_rect()) or >>,
        surf_bind_lbl: widgets.styled_label(context, &"Bind GLB"),
        surf_clear_btn: widgets.button(identity, id_surf_clear_btn, &zero_rect()) or >>,
        surf_clear_lbl: widgets.styled_label(context, &"Clear GLB"),
        lod_hyst_field: make_plain_field(context, identity, id_lod_hyst_field, "Hyst", "0"),
        lod_dist_field: make_plain_field(context, identity, id_lod_dist_field, "Dist", "12"),
        lod_prim_field: make_plain_field(context, identity, id_lod_prim_field, "L.Prim", "0"),
        lod_asset_select: lod_asset_select,
        lod_asset_labels: lod_asset_labels,
        lod_asset_origin: zero_rect(),
        lod_add_btn: widgets.button(identity, id_lod_add_btn, &zero_rect()) or >>,
        lod_add_lbl: widgets.styled_label(context, &"+ LOD"),
        lod_pop_btn: widgets.button(identity, id_lod_pop_btn, &zero_rect()) or >>,
        lod_pop_lbl: widgets.styled_label(context, &"- LOD"),

        apply_btn: widgets.button(identity, id_apply_btn, &zero_rect()) or >>,
        apply_lbl: widgets.styled_label(context, &"Apply Changes"),

        asset_meta_txt: widgets.selectable_text(context, identity, id_asset_meta, &zero_rect(), &"Import a .glb to place in scene") or >>,
        insp_hdr_txt: widgets.selectable_text(context, identity, id_insp_hdr, &zero_rect(), &"Inspector · Node3D") or >>,
        surf_info_txt: widgets.selectable_text(context, identity, id_surf_info, &zero_rect(), &"No surface attached") or >>,
        lod_info_txt: widgets.selectable_text(context, identity, id_lod_info, &zero_rect(), &"LOD: none") or >>,
        status_txt: widgets.selectable_text(context, identity, id_status_txt, &zero_rect(), &"Ready") or >>,

        comp: comp,
        panels: panels,
        modals: create_modals(context, identity, &snap),
        tooltip: new_tooltip_state(context)
    }

    set_text_ellipsis($&ed.asset_meta_txt, true)
    set_text_ellipsis($&ed.insp_hdr_txt, true)
    set_text_ellipsis($&ed.surf_info_txt, true)
    set_text_ellipsis($&ed.lod_info_txt, true)
    set_text_ellipsis($&ed.status_txt, true)
    tree_set_multi($&ed.tree, true)
    ed.apply_custom_styles()
    ed.apply_language_internal()
    ed.refresh_after_document_change(true, view)
    ed.sync_asset_meta_text()
    ed.sync_status_text()
    << ed
}

fn min_int_val(a int, b int) int {
    if a < b { << a }
    << b
}

pub fn (ed $&Editor) dispose(view $&widgets.View) {
    view.dispose()
    mods := $&ed.modals
    mods.dispose()
    tip := $&ed.tooltip
    tip.dispose()
    comp_dispose($&ed.comp)
    panels_dispose($&ed.panels)
    dispose_field($&ed.name_field)
    dispose_field($&ed.prim_field)
    dispose_field($&ed.pos_x)
    dispose_field($&ed.pos_y)
    dispose_field($&ed.pos_z)
    dispose_field($&ed.rot_x)
    dispose_field($&ed.rot_y)
    dispose_field($&ed.rot_z)
    dispose_field($&ed.scale_x)
    dispose_field($&ed.scale_y)
    dispose_field($&ed.scale_z)
    dispose_field($&ed.surf_prim_field)
    dispose_field($&ed.lod_hyst_field)
    dispose_field($&ed.lod_dist_field)
    dispose_field($&ed.lod_prim_field)
    dispose_tree($&ed.tree)
    dispose_sel_text($&ed.asset_meta_txt)
    dispose_sel_text($&ed.insp_hdr_txt)
    dispose_sel_text($&ed.surf_info_txt)
    dispose_sel_text($&ed.lod_info_txt)
    dispose_sel_text($&ed.status_txt)
    dispose_label($&ed.new_scene_lbl)
    dispose_label($&ed.globals_lbl)
    dispose_label($&ed.undo_lbl)
    dispose_label($&ed.redo_lbl)
    dispose_label($&ed.save_lbl)
    dispose_label($&ed.preview_lbl)
    dispose_label($&ed.add_3d_lbl)
    dispose_label($&ed.add_2d_lbl)
    dispose_label($&ed.add_grp_lbl)
    dispose_label($&ed.dup_lbl)
    dispose_label($&ed.del_lbl)
    dispose_label($&ed.add_cam_lbl)
    dispose_label($&ed.add_lgt_lbl)
    dispose_label($&ed.import_lbl)
    dispose_label($&ed.place_lbl)
    dispose_label($&ed.stage_axis_lbl)
    dispose_label($&ed.stage_snap_lbl)
    dispose_label($&ed.fit_lbl)
    dispose_label($&ed.view3d_lbl)
    dispose_label($&ed.snap_lbl)
    dispose_label($&ed.visible_lbl)
    dispose_label($&ed.reparent_lbl)
    dispose_label($&ed.surf_bind_lbl)
    dispose_label($&ed.surf_clear_lbl)
    dispose_label($&ed.lod_add_lbl)
    dispose_label($&ed.lod_pop_lbl)
    dispose_label($&ed.apply_lbl)
    dispose_label($&ed.empty_lbl)
    dispose_label($&ed.no_asset_lbl)
    dispose_label($&ed.root_parent_lbl)
    for i in 0:ed.scene_labels.len { dispose_label($&ed.scene_labels[i]) }
    for i in 0:ed.asset_labels.len { dispose_label($&ed.asset_labels[i]) }
    for i in 0:ed.parent_labels.len { dispose_label($&ed.parent_labels[i]) }
    for i in 0:ed.process_labels.len { dispose_label($&ed.process_labels[i]) }
    for i in 0:ed.surf_asset_labels.len { dispose_label($&ed.surf_asset_labels[i]) }
    for i in 0:ed.lod_asset_labels.len { dispose_label($&ed.lod_asset_labels[i]) }
}

fn (ed $&Editor) apply_custom_styles() {
    compact := compact_button_style(&ed.styles, widgets.BUTTON_SECONDARY)
    subtle := compact_button_style(&ed.styles, widgets.BUTTON_SUBTLE)
    ico_sec := icon_button_style(&ed.styles, widgets.BUTTON_SECONDARY)
    ico_sub := icon_button_style(&ed.styles, widgets.BUTTON_SUBTLE)
    ico_dng := icon_button_style(&ed.styles, widgets.BUTTON_DANGER)
    pill_sub := pill_button_style(&ed.styles, widgets.BUTTON_SUBTLE)
    primary := ed.styles.button_variant(widgets.BUTTON_PRIMARY) or (err) {
        _ := err
        <<
    }
    set_btn_style($&ed.new_scene_btn, &ico_sec)
    set_btn_style($&ed.globals_btn, &ico_sec)
    set_btn_style($&ed.undo_btn, &ico_sub)
    set_btn_style($&ed.redo_btn, &ico_sub)
    set_btn_style($&ed.preview_btn, &ico_sec)
    set_btn_style($&ed.add_3d_btn, &ico_sub)
    set_btn_style($&ed.add_2d_btn, &ico_sub)
    set_btn_style($&ed.add_grp_btn, &ico_sub)
    set_btn_style($&ed.dup_btn, &ico_sub)
    set_btn_style($&ed.del_btn, &ico_dng)
    set_btn_style($&ed.add_cam_btn, &ico_sub)
    set_btn_style($&ed.add_lgt_btn, &ico_sub)
    set_btn_style($&ed.import_btn, &ico_sub)
    set_btn_style($&ed.place_btn, &compact)
    set_btn_style($&ed.stage_axis_btn, &pill_sub)
    set_btn_style($&ed.stage_snap_btn, &ico_sub)
    set_btn_style($&ed.fit_btn, &ico_sub)
    set_btn_style($&ed.view3d_btn, &ico_sec)
    set_btn_style($&ed.snap_btn, &ico_sub)
    set_btn_style($&ed.reparent_btn, &compact)
    set_btn_style($&ed.surf_bind_btn, &compact)
    set_btn_style($&ed.surf_clear_btn, &subtle)
    set_btn_style($&ed.lod_add_btn, &compact)
    set_btn_style($&ed.lod_pop_btn, &subtle)
    set_btn_style($&ed.apply_btn, &primary)

    cs := compact_select_style(&ed.styles)
    set_sel_style($&ed.scene_select, &cs)
    set_sel_style($&ed.asset_select, &cs)
    set_sel_style($&ed.parent_select, &cs)
    set_sel_style($&ed.process_select, &cs)
    set_sel_style($&ed.surf_asset_select, &cs)
    set_sel_style($&ed.lod_asset_select, &cs)

    ts := compact_tree_style(&ed.styles, &ed.pal)
    set_tree_style($&ed.tree, &ts)
    ta := widgets.TreeAppearance{
        indent: 16.0,
        row_height: 26.0,
        guides: true,
        icons: true,
        selection_mark: true,
        guide_opacity: 0.35,
        action_width: 24.0
    }
    set_tree_appearance($&ed.tree, &ta)

    cf := compact_field_style(&ed.styles)
    set_field_style($&ed.prim_field, &cf)
    set_field_style($&ed.pos_x, &cf)
    set_field_style($&ed.pos_y, &cf)
    set_field_style($&ed.pos_z, &cf)
    set_field_style($&ed.rot_x, &cf)
    set_field_style($&ed.rot_y, &cf)
    set_field_style($&ed.rot_z, &cf)
    set_field_style($&ed.scale_x, &cf)
    set_field_style($&ed.scale_y, &cf)
    set_field_style($&ed.scale_z, &cf)
    set_field_style($&ed.surf_prim_field, &cf)
    set_field_style($&ed.lod_hyst_field, &cf)
    set_field_style($&ed.lod_dist_field, &cf)
    set_field_style($&ed.lod_prim_field, &cf)

    st_meta := selectable_text_style(&ed.styles, &ed.pal, 11.0, ed.pal.muted)
    st_hdr := selectable_text_style(&ed.styles, &ed.pal, 13.0, ed.pal.text)
    set_text_style($&ed.asset_meta_txt, &st_meta)
    set_text_style($&ed.surf_info_txt, &st_meta)
    set_text_style($&ed.lod_info_txt, &st_meta)
    set_text_style($&ed.insp_hdr_txt, &st_hdr)
    st_p := ed.styles.clone()
    pal_p := ed.pal
    panels_apply_styles($&ed.panels, &st_p, &pal_p)
    ed.sync_status_text()
}

pub fn (ed $&Editor) sync_status_text() {
    $col := ed.pal.muted
    if ed.status_kind == STATUS_OK { col = ed.pal.success }
    else if ed.status_kind == STATUS_ERR { col = ed.pal.danger }
    st := selectable_text_style(&ed.styles, &ed.pal, 12.0, col)
    set_text_style($&ed.status_txt, &st)
    msg := ed.status_text + ""
    set_text_val($&ed.status_txt, &msg)
}

pub fn (ed $&Editor) sync_asset_meta_text() {
    $meta := tr(ed.lang, "Import a .glb/.png/.wav/.xubc asset", "请导入 .glb/.png/.wav/.xubc 资源")
    sel := ed.asset_select.selected()
    if sel >= 0 && sel < ed.project.assets.len {
        meta = ed.project.assets[sel].path + " (" + ed.project.assets[sel].key[0:8] + ")"
    }
    set_text_val($&ed.asset_meta_txt, &meta)
    vbin := ed.validator_bin + ""
    proj := clone_project(&ed.project)
    lang_v := ed.lang
    p := $&ed.panels
    prims_s := format_asset_prims_summary(&vbin, &proj, sel, $&p.glb_prim_cache, lang_v)
    set_text_val($&p.texts[PT_ASSET_PRIMS], &prims_s)
}

pub fn (ed &Editor) repaint_all(view $&widgets.View) {
    repaint(view, ed.id_toolbar)
    repaint(view, ed.id_left_pane)
    repaint(view, ed.id_top_view)
    repaint(view, ed.id_center_pane)
    repaint(view, ed.id_right_pane)
    repaint(view, ed.id_footer)
    repaint(view, ed.id_root)
}

pub fn (ed $&Editor) set_status(kind int, msg string, view $&widgets.View) {
    ed.status_kind = kind
    ed.status_text = msg
    ed.sync_status_text()
    repaint(view, ed.id_footer)
}

fn (ed $&Editor) clamp_widths(w f64) {
    avail := w - f64(SPLITTER_W) * 2.0
    max_left := math.max(f64(MIN_LEFT_W), avail - f64(MIN_CENTER_W) - f64(MIN_RIGHT_W))
    if ed.left_w < f64(MIN_LEFT_W) { ed.left_w = f64(MIN_LEFT_W) }
    if ed.left_w > max_left { ed.left_w = max_left }
    max_right := math.max(f64(MIN_RIGHT_W), avail - ed.left_w - f64(MIN_CENTER_W))
    if ed.right_w < f64(MIN_RIGHT_W) { ed.right_w = f64(MIN_RIGHT_W) }
    if ed.right_w > max_right { ed.right_w = max_right }
}

pub fn (ed $&Editor) sync_layout(view $&widgets.View, width f64, height f64) int {
    ed.viewport_w = math.max(f64(MIN_WINDOW_W), width)
    ed.viewport_h = math.max(f64(MIN_WINDOW_H), height)
    ed.clamp_widths(ed.viewport_w)

    body_h := ed.viewport_h - f64(TOOLBAR_H) - f64(FOOTER_H)
    center_w := math.max(f64(MIN_CENTER_W), ed.viewport_w - ed.left_w - ed.right_w - f64(SPLITTER_W) * 2.0)

    $rb := col_box(ed.viewport_w, ed.viewport_h, 0.0)
    rb.clip = true
    view.set_style(ed.id_root, &rb) or >>
    $tb := row_box(ed.viewport_w, f64(TOOLBAR_H), 5.0)
    tb.padding = layout.Insets{left: 8.0, top: 6.0, right: 8.0, bottom: 6.0}
    view.set_style(ed.id_toolbar, &tb) or >>
    view.set_style(ed.id_tb_spacer, &leaf_box(math.max(4.0, ed.viewport_w - 784.0), 24.0)) or >>
    view.set_style(ed.id_workspace, &row_box(ed.viewport_w, body_h, 0.0)) or >>

    $lp := col_box(ed.left_w, body_h, 4.0)
    lp.padding = layout.Insets{left: 8.0, top: 8.0, right: 8.0, bottom: 8.0}
    view.set_style(ed.id_left_pane, &lp) or >>
    ilw := ed.left_w - 16.0
    avail_flex := math.max(106.0, (body_h - 16.0) - 256.0)
    tree_h := math.max(84.0, math.min(avail_flex - 22.0, avail_flex * ed.panels.left_tree_ratio))
    prims_h := math.max(22.0, avail_flex - tree_h)
    ed.panels.avail_flex = avail_flex
    ed.panels.last_tree_h = tree_h

    view.set_style(ed.panels.id_tree_hdr_row, &row_box(ilw, 24.0, 3.0)) or >>
    view.set_style(ed.id_tree_hdr, &leaf_box(math.max(60.0, ilw - 84.0), 24.0)) or >>
    view.set_style(ed.panels.id_tree_filter, &leaf_box(ilw, 42.0)) or >>
    view.set_style(ed.id_tree_btns, &row_box(ilw, 28.0, 3.0)) or >>
    bw7 := math.max(24.0, (ilw - 18.0) / 7.0)
    view.set_style(ed.id_add_3d_btn, &leaf_box(bw7, 26.0)) or >>
    view.set_style(ed.id_add_2d_btn, &leaf_box(bw7, 26.0)) or >>
    view.set_style(ed.id_add_grp_btn, &leaf_box(bw7, 26.0)) or >>
    view.set_style(ed.id_add_cam_btn, &leaf_box(bw7, 26.0)) or >>
    view.set_style(ed.id_add_lgt_btn, &leaf_box(bw7, 26.0)) or >>
    view.set_style(ed.id_dup_btn, &leaf_box(bw7, 26.0)) or >>
    view.set_style(ed.id_del_btn, &leaf_box(bw7, 26.0)) or >>
    view.set_style(ed.id_tree, &leaf_box(ilw, tree_h)) or >>
    view.set_style(ed.panels.id_left_hsplit, &leaf_box(ilw, 8.0)) or >>
    view.set_style(ed.id_assets_hdr_row, &row_box(ilw, 26.0, 3.0)) or >>
    view.set_style(ed.id_assets_hdr, &leaf_box(math.max(50.0, ilw - 84.0), 24.0)) or >>
    view.set_style(ed.id_import_btn, &leaf_box(25.0, 24.0)) or >>
    view.set_style(ed.panels.id_relocate_btn, &leaf_box(25.0, 24.0)) or >>
    view.set_style(ed.panels.id_remove_asset_btn, &leaf_box(25.0, 24.0)) or >>
    view.set_style(ed.id_asset_select, &leaf_box(ilw, 30.0)) or >>
    view.set_style(ed.id_asset_meta, &leaf_box(ilw, 18.0)) or >>
    view.set_style(ed.panels.id_asset_prims, &leaf_box(ilw, prims_h)) or >>
    view.set_style(ed.id_asset_row, &row_box_end(ilw, 44.0, 6.0)) or >>
    view.set_style(ed.id_prim_field, &leaf_box(62.0, 44.0)) or >>
    view.set_style(ed.id_place_btn, &leaf_box(math.max(80.0, ilw - 68.0), 34.0)) or >>

    view.set_style(ed.id_left_split, &leaf_box(f64(SPLITTER_W), body_h)) or >>

    $cp := col_box(center_w, body_h, 6.0)
    cp.padding = layout.Insets{left: 8.0, top: 8.0, right: 8.0, bottom: 8.0}
    view.set_style(ed.id_center_pane, &cp) or >>
    icw := center_w - 16.0
    view.set_style(ed.id_stage_bar, &row_box(icw, 30.0, 4.0)) or >>
    view.set_style(ed.id_stage_title, &leaf_box(math.max(60.0, icw - 176.0), 26.0)) or >>
    view.set_style(ed.id_top_view, &leaf_box(icw, math.max(120.0, body_h - 52.0))) or >>

    view.set_style(ed.id_right_split, &leaf_box(f64(SPLITTER_W), body_h)) or >>

    $rp := col_box(ed.right_w, body_h, 4.0)
    rp.padding = layout.Insets{left: 8.0, top: 8.0, right: 8.0, bottom: 8.0}
    view.set_style(ed.id_right_pane, &rp) or >>
    irw := ed.right_w - 16.0
    scroll_h := math.max(120.0, body_h - 78.0)
    scroll_cw := math.max(120.0, irw - 12.0)
    tri_w := (scroll_cw - 8.0) / 3.0
    view.set_style(ed.id_insp_hdr, &leaf_box(irw, 22.0)) or >>
    $sb := col_box(irw, scroll_h, 4.0)
    sb.clip = true
    sb.padding = layout.Insets{left: 0.0, top: 0.0, right: 12.0, bottom: 8.0}
    view.set_style(ed.id_insp_scroll, &sb) or >>
    view.set_style(ed.id_name_field, &leaf_box(scroll_cw, 62.0)) or >>
    view.set_style(ed.id_vis_proc_row, &row_box(scroll_cw, 32.0, 6.0)) or >>
    vis_w := math.max(76.0, scroll_cw * 0.40)
    view.set_style(ed.id_visible_chk, &leaf_box(vis_w, 26.0)) or >>
    view.set_style(ed.id_process_select, &leaf_box(math.max(90.0, scroll_cw - vis_w - 6.0), 30.0)) or >>
    view.set_style(ed.id_parent_row, &row_box(scroll_cw, 32.0, 6.0)) or >>
    view.set_style(ed.id_parent_select, &leaf_box(math.max(90.0, scroll_cw - 84.0), 30.0)) or >>
    view.set_style(ed.id_reparent_btn, &leaf_box(78.0, 30.0)) or >>
    view.set_style(ed.id_pos_lbl, &leaf_box(scroll_cw, 16.0)) or >>
    view.set_style(ed.id_pos_row, &row_box(scroll_cw, 44.0, 4.0)) or >>
    view.set_style(ed.id_pos_x, &leaf_box(tri_w, 44.0)) or >>
    view.set_style(ed.id_pos_y, &leaf_box(tri_w, 44.0)) or >>
    view.set_style(ed.id_pos_z, &leaf_box(tri_w, 44.0)) or >>
    view.set_style(ed.id_rot_lbl, &leaf_box(scroll_cw, 16.0)) or >>
    view.set_style(ed.id_rot_row, &row_box(scroll_cw, 44.0, 4.0)) or >>
    view.set_style(ed.id_rot_x, &leaf_box(tri_w, 44.0)) or >>
    view.set_style(ed.id_rot_y, &leaf_box(tri_w, 44.0)) or >>
    view.set_style(ed.id_rot_z, &leaf_box(tri_w, 44.0)) or >>
    view.set_style(ed.id_scale_lbl, &leaf_box(scroll_cw, 16.0)) or >>
    view.set_style(ed.id_scale_row, &row_box(scroll_cw, 44.0, 4.0)) or >>
    view.set_style(ed.id_scale_x, &leaf_box(tri_w, 44.0)) or >>
    view.set_style(ed.id_scale_y, &leaf_box(tri_w, 44.0)) or >>
    view.set_style(ed.id_scale_z, &leaf_box(tri_w, 44.0)) or >>
    view.set_style(ed.id_surf_info, &leaf_box(scroll_cw, 18.0)) or >>
    view.set_style(ed.id_surf_div, &leaf_box(scroll_cw, 4.0)) or >>
    view.set_style(ed.id_surf_card_hdr, &leaf_box(scroll_cw, 18.0)) or >>
    view.set_style(ed.id_surf_bind_row, &row_box(scroll_cw, 32.0, 4.0)) or >>
    view.set_style(ed.id_surf_asset_select, &leaf_box(scroll_cw, 30.0)) or >>
    view.set_style(ed.id_surf_btn_row, &row_box_end(scroll_cw, 44.0, 4.0)) or >>
    view.set_style(ed.id_surf_prim_field, &leaf_box(58.0, 44.0)) or >>
    sbtn_w := math.max(48.0, (scroll_cw - 66.0) * 0.5)
    view.set_style(ed.id_surf_bind_btn, &leaf_box(sbtn_w, 34.0)) or >>
    view.set_style(ed.id_surf_clear_btn, &leaf_box(sbtn_w, 34.0)) or >>
    view.set_style(ed.id_lod_info, &leaf_box(scroll_cw, 18.0)) or >>
    view.set_style(ed.id_lod_input_row, &row_box(scroll_cw, 44.0, 4.0)) or >>
    view.set_style(ed.id_lod_hyst_field, &leaf_box(tri_w, 44.0)) or >>
    view.set_style(ed.id_lod_dist_field, &leaf_box(tri_w, 44.0)) or >>
    view.set_style(ed.id_lod_prim_field, &leaf_box(tri_w, 44.0)) or >>
    view.set_style(ed.id_lod_btn_row, &row_box(scroll_cw, 32.0, 4.0)) or >>
    view.set_style(ed.id_lod_asset_select, &leaf_box(math.max(84.0, scroll_cw - 112.0), 30.0)) or >>
    view.set_style(ed.id_lod_add_btn, &leaf_box(52.0, 30.0)) or >>
    view.set_style(ed.id_lod_pop_btn, &leaf_box(52.0, 30.0)) or >>
    sync_comp_layout(&ed.comp, view, scroll_cw) or >>
    view.set_style(ed.id_apply_btn, &leaf_box(irw, 32.0)) or >>

    $fb := row_box(ed.viewport_w, f64(FOOTER_H), 8.0)
    fb.padding = layout.Insets{left: 10.0, top: 4.0, right: 10.0, bottom: 4.0}
    view.set_style(ed.id_footer, &fb) or >>
    $st_w := math.max(120.0, ed.viewport_w - 20.0)
    $hint_w := 0.0
    if ed.viewport_w >= 900.0 {
        st_w = math.max(180.0, ed.viewport_w - 416.0)
        hint_w = 384.0
    }
    view.set_style(ed.id_status_txt, &leaf_box(st_w, 20.0)) or >>
    view.set_style(ed.id_footer_hint, &leaf_box(hint_w, 20.0)) or >>

    constraints := layout.tight(ed.viewport_w, ed.viewport_h)
    _ := widgets.layout_styled(view, &constraints, ed) or >>

    ed.place_all_controls(view) or >>
    vw := ed.viewport_w
    vh := ed.viewport_h
    st := ed.styles.clone()
    mods := $&ed.modals
    mods.layout(vw, vh, &st)
    << 0
}

fn sync_local_box_button(view &widgets.View, id int, btn $&widgets.Button) int {
    nb := view.node_bounds(id) or >>
    << btn.set_bounds(&layout.Rect{x: 0.0, y: 0.0, width: nb.width, height: nb.height}) or >>
}

fn sync_local_box_select(view &widgets.View, id int, styles &widgets.Styles, canvas_h f64, sel $&widgets.Select) layout.Rect {
    nb := view.node_bounds(id) or >>
    _ := sel.set_bounds(&layout.Rect{x: 0.0, y: 0.0, width: nb.width, height: nb.height}) or >>
    _ := sel.apply_styles(styles) or >>
    pop := sel.popup_bounds(styles)
    sel.set_popup_above(nb.y + nb.height + pop.height + 6.0 > canvas_h)
    << nb
}

fn place_view_field(view &widgets.View, id int, styles &widgets.Styles, vp &layout.Rect, f $&widgets.Field) int {
    nb := view.node_bounds(id) or >>
    _ := f.place(&nb) or >>
    set_field_viewport(f, vp)
    << f.apply_styles(styles) or >>
}

fn place_view_text(view &widgets.View, id int, vp &layout.Rect, s $&widgets.SelectableText) int {
    nb := view.node_bounds(id) or >>
    set_text_bounds(s, &nb)
    set_text_viewport(s, vp)
    << 0
}

fn (ed $&Editor) place_all_controls(view $&widgets.View) int {
    st := ed.styles.clone()
    vh := ed.viewport_h
    vp := layout.Rect{x: 0.0, y: 0.0, width: ed.viewport_w, height: ed.viewport_h}
    sc_id := ed.id_scene_select
    ed.scene_origin = sync_local_box_select(view, sc_id, &st, vh, $&ed.scene_select) or >>
    as_id := ed.id_asset_select
    ed.asset_origin = sync_local_box_select(view, as_id, &st, vh, $&ed.asset_select) or >>
    pa_id := ed.id_parent_select
    pr_id := ed.id_process_select
    sa_id := ed.id_surf_asset_select
    la_id := ed.id_lod_asset_select

    sync_local_box_button(view, ed.id_new_scene_btn, $&ed.new_scene_btn) or >>
    sync_local_box_button(view, ed.id_globals_btn, $&ed.globals_btn) or >>
    sync_local_box_button(view, ed.id_undo_btn, $&ed.undo_btn) or >>
    sync_local_box_button(view, ed.id_redo_btn, $&ed.redo_btn) or >>
    sync_local_box_button(view, ed.id_save_btn, $&ed.save_btn) or >>
    sync_local_box_button(view, ed.id_preview_btn, $&ed.preview_btn) or >>

    sync_local_box_button(view, ed.id_add_3d_btn, $&ed.add_3d_btn) or >>
    sync_local_box_button(view, ed.id_add_2d_btn, $&ed.add_2d_btn) or >>
    sync_local_box_button(view, ed.id_add_grp_btn, $&ed.add_grp_btn) or >>
    sync_local_box_button(view, ed.id_dup_btn, $&ed.dup_btn) or >>
    sync_local_box_button(view, ed.id_del_btn, $&ed.del_btn) or >>
    sync_local_box_button(view, ed.id_add_cam_btn, $&ed.add_cam_btn) or >>
    sync_local_box_button(view, ed.id_add_lgt_btn, $&ed.add_lgt_btn) or >>

    tb := view.node_bounds(ed.id_tree) or >>
    ed.tree_origin = copy_rect(&tb)
    tr := $&ed.tree
    _ := tr.set_bounds(&layout.Rect{x: 0.0, y: 0.0, width: tb.width, height: tb.height}) or >>
    _ := tr.apply_styles(&st) or >>
    tr.set_viewport(&layout.Rect{x: -tb.x, y: -tb.y, width: vp.width, height: vp.height})

    sync_local_box_button(view, ed.id_import_btn, $&ed.import_btn) or >>
    place_view_text(view, ed.id_asset_meta, &vp, $&ed.asset_meta_txt) or >>
    place_view_field(view, ed.id_prim_field, &st, &vp, $&ed.prim_field) or >>
    sync_local_box_button(view, ed.id_place_btn, $&ed.place_btn) or >>

    sync_local_box_button(view, ed.id_stage_axis_btn, $&ed.stage_axis_btn) or >>
    sync_local_box_button(view, ed.id_stage_snap_btn, $&ed.stage_snap_btn) or >>
    sync_local_box_button(view, ed.id_fit_btn, $&ed.fit_btn) or >>
    sync_local_box_button(view, ed.id_view3d_btn, $&ed.view3d_btn) or >>
    sync_local_box_button(view, ed.id_snap_btn, $&ed.snap_btn) or >>
    tvb := view.node_bounds(ed.id_top_view) or >>
    ed.top_view_local = layout.Rect{x: 0.0, y: 0.0, width: tvb.width, height: tvb.height}

    place_view_text(view, ed.id_insp_hdr, &vp, $&ed.insp_hdr_txt) or >>
    update_insp_scroll_extent(ed, view)
    scb := view.node_bounds(ed.id_insp_scroll) or >>
    insp_vp := scb
    ed.parent_origin = sync_local_box_select(view, pa_id, &st, vh, $&ed.parent_select) or >>
    ed.process_origin = sync_local_box_select(view, pr_id, &st, vh, $&ed.process_select) or >>
    ed.surf_asset_origin = sync_local_box_select(view, sa_id, &st, vh, $&ed.surf_asset_select) or >>
    ed.lod_asset_origin = sync_local_box_select(view, la_id, &st, vh, $&ed.lod_asset_select) or >>
    place_view_field(view, ed.id_name_field, &st, &insp_vp, $&ed.name_field) or >>
    vb := view.node_bounds(ed.id_visible_chk) or >>
    vc := $&ed.visible_chk
    _ := vc.set_bounds(&layout.Rect{x: 0.0, y: 0.0, width: vb.width, height: vb.height}) or >>
    sync_local_box_button(view, ed.id_reparent_btn, $&ed.reparent_btn) or >>

    place_view_field(view, ed.id_pos_x, &st, &insp_vp, $&ed.pos_x) or >>
    place_view_field(view, ed.id_pos_y, &st, &insp_vp, $&ed.pos_y) or >>
    place_view_field(view, ed.id_pos_z, &st, &insp_vp, $&ed.pos_z) or >>
    place_view_field(view, ed.id_rot_x, &st, &insp_vp, $&ed.rot_x) or >>
    place_view_field(view, ed.id_rot_y, &st, &insp_vp, $&ed.rot_y) or >>
    place_view_field(view, ed.id_rot_z, &st, &insp_vp, $&ed.rot_z) or >>
    place_view_field(view, ed.id_scale_x, &st, &insp_vp, $&ed.scale_x) or >>
    place_view_field(view, ed.id_scale_y, &st, &insp_vp, $&ed.scale_y) or >>
    place_view_field(view, ed.id_scale_z, &st, &insp_vp, $&ed.scale_z) or >>
    place_view_text(view, ed.id_surf_info, &insp_vp, $&ed.surf_info_txt) or >>
    sdb := view.node_bounds(ed.id_surf_div) or >>
    sd := $&ed.surf_div
    _ := sd.set_bounds(&layout.Rect{x: 0.0, y: 0.0, width: sdb.width, height: sdb.height}) or >>
    place_view_field(view, ed.id_surf_prim_field, &st, &insp_vp, $&ed.surf_prim_field) or >>
    sync_local_box_button(view, ed.id_surf_bind_btn, $&ed.surf_bind_btn) or >>
    sync_local_box_button(view, ed.id_surf_clear_btn, $&ed.surf_clear_btn) or >>
    place_view_text(view, ed.id_lod_info, &insp_vp, $&ed.lod_info_txt) or >>
    place_view_field(view, ed.id_lod_hyst_field, &st, &insp_vp, $&ed.lod_hyst_field) or >>
    place_view_field(view, ed.id_lod_dist_field, &st, &insp_vp, $&ed.lod_dist_field) or >>
    place_view_field(view, ed.id_lod_prim_field, &st, &insp_vp, $&ed.lod_prim_field) or >>
    sync_local_box_button(view, ed.id_lod_add_btn, $&ed.lod_add_btn) or >>
    sync_local_box_button(view, ed.id_lod_pop_btn, $&ed.lod_pop_btn) or >>
    place_comp_inspector($&ed.comp, view, &st, vh, &insp_vp) or >>
    sync_local_box_button(view, ed.id_apply_btn, $&ed.apply_btn) or >>
    place_view_text(view, ed.id_status_txt, &vp, $&ed.status_txt) or >>
    panels_place($&ed.panels, view, &st, &vp) or >>
    << 0
}

fn selected_asset_is_glb(ed &Editor) bool {
    sel := ed.asset_select.selected()
    if sel < 0 || sel >= ed.project.assets.len { << false }
    ext := strings.to_lower(&filepath.ext(&ed.project.assets[sel].path))
    << ext == ".glb"
}

pub fn (ed $&Editor) sync_toolbar_states() {
    c_undo := ed.draft.can_undo()
    c_redo := ed.draft.can_redo()
    c_vp := !ed.viewport_active
    c_pv := !ed.preview_active
    c_im := !ed.import_active
    has_sel := ed.selected_node > 0
    can_rep := has_sel && ed.parent_candidates.len > 0
    has_assets := ed.project.assets.len > 0
    is_glb := selected_asset_is_glb(ed)
    placing := ed.placing_mode
    is_dirty := ed.draft.dirty()
    st_danger := compact_button_style(&ed.styles, widgets.BUTTON_DANGER)
    st_sec := compact_button_style(&ed.styles, widgets.BUTTON_SECONDARY)
    ico_pri := icon_button_style(&ed.styles, widgets.BUTTON_PRIMARY)
    ico_out := icon_button_style(&ed.styles, widgets.BUTTON_OUTLINE)
    ico_sub := icon_button_style(&ed.styles, widgets.BUTTON_SUBTLE)

    set_btn_enabled($&ed.undo_btn, c_undo)
    set_btn_enabled($&ed.redo_btn, c_redo)
    set_btn_enabled($&ed.view3d_btn, c_vp)
    set_btn_enabled($&ed.preview_btn, c_pv)
    set_btn_enabled($&ed.import_btn, c_im)
    set_btn_enabled($&ed.dup_btn, has_sel)
    set_btn_enabled($&ed.del_btn, has_sel)
    if ed.tilemap_active {
        c := $&ed.comp
        set_btn_enabled($&c.buttons[CB_TILEMAP_EDIT], false)
    }
    set_btn_enabled($&ed.reparent_btn, can_rep)
    set_sel_enabled($&ed.parent_select, can_rep)
    set_btn_enabled($&ed.place_btn, placing || is_glb)
    can_reloc := has_assets && !ed.relocate_active
    can_open := !ed.open_proj_active
    can_exp := !ed.export_active
    has_vis_sel := ed.selected_node >= 0
    p := $&ed.panels
    set_btn_enabled($&p.buttons[PB_OPEN_PROJ], can_open)
    set_btn_enabled($&p.buttons[PB_EXPORT], can_exp)
    set_btn_enabled($&p.buttons[PB_NODE_UP], has_sel)
    set_btn_enabled($&p.buttons[PB_NODE_DN], has_sel)
    set_btn_enabled($&p.buttons[PB_NODE_VIS], has_vis_sel)
    set_btn_enabled($&p.buttons[PB_RELOCATE], can_reloc)
    set_btn_enabled($&p.buttons[PB_REMOVE_ASSET], has_assets)
    if placing {
        set_lbl_text($&ed.place_lbl, &tr(ed.lang, "Cancel Place", "取消放置"))
        set_btn_style($&ed.place_btn, &st_danger)
    } else {
        set_lbl_text($&ed.place_lbl, &tr(ed.lang, "Place GLB", "放置 GLB"))
        set_btn_style($&ed.place_btn, &st_sec)
    }
    if is_dirty {
        set_btn_style($&ed.save_btn, &ico_pri)
    } else {
        set_btn_style($&ed.save_btn, &ico_out)
    }
    if ed.top_view.axis_mode == STAGE_XY {
        set_lbl_text($&ed.stage_axis_lbl, &"XY")
    } else {
        set_lbl_text($&ed.stage_axis_lbl, &"XZ")
    }
    if ed.top_snap_enabled {
        set_lbl_text($&ed.stage_snap_lbl, &"Snap:On")
        set_btn_style($&ed.stage_snap_btn, &ico_pri)
    } else {
        set_lbl_text($&ed.stage_snap_lbl, &"Snap:Off")
        set_btn_style($&ed.stage_snap_btn, &ico_sub)
    }
}

pub fn (ed $&Editor) refresh_project_selectors() {
    for i in 0:ed.scene_labels.len { dispose_label($&ed.scene_labels[i]) }
    ed.scene_labels = []widgets.StyledLabel{}
    sc_n := min_int_val(ed.project.scenes.len, 64)
    for i in 0:sc_n {
        k := ed.project.scenes[i].key + ""
        ed.scene_labels.push(widgets.styled_label(&ed.context, &k))
    }
    set_sel_count($&ed.scene_select, sc_n)
    if sc_n > 0 && ed.scene_index >= 0 && ed.scene_index < sc_n {
        sidx := ed.scene_index
        set_sel_selected($&ed.scene_select, sidx)
    }

    for i in 0:ed.asset_labels.len { dispose_label($&ed.asset_labels[i]) }
    ed.asset_labels = []widgets.StyledLabel{}
    as_n := min_int_val(ed.project.assets.len, 64)
    prev_sel := ed.asset_select.selected()
    for i in 0:as_n {
        b := asset_display_label(&ed.project.assets[i].path)
        ed.asset_labels.push(widgets.styled_label(&ed.context, &b))
    }
    set_sel_count($&ed.asset_select, as_n)
    if as_n > 0 {
        $next_sel := prev_sel
        if next_sel < 0 || next_sel >= as_n { next_sel = 0 }
        set_sel_selected($&ed.asset_select, next_sel)
    }

    ed.glb_indices = collect_glb_indices(&ed.project)
    surf_prev := ed.surf_asset_select.selected()
    for i in 0:ed.surf_asset_labels.len { dispose_label($&ed.surf_asset_labels[i]) }
    ed.surf_asset_labels = make_surface_asset_labels(&ed.context, &ed.project, &ed.glb_indices, tr(ed.lang, "(None)", "(无)"))
    surf_n := min_int_val(ed.surf_asset_labels.len, 64)
    set_sel_count($&ed.surf_asset_select, surf_n)
    $surf_next := surf_prev
    if surf_next < 0 || surf_next >= surf_n { surf_next = 0 }
    set_sel_selected($&ed.surf_asset_select, surf_next)

    lod_prev := ed.lod_asset_select.selected()
    for i in 0:ed.lod_asset_labels.len { dispose_label($&ed.lod_asset_labels[i]) }
    ed.lod_asset_labels = make_surface_asset_labels(&ed.context, &ed.project, &ed.glb_indices, tr(ed.lang, "(Same GLB)", "(同主 GLB)"))
    lod_n := min_int_val(ed.lod_asset_labels.len, 64)
    set_sel_count($&ed.lod_asset_select, lod_n)
    $lod_next := lod_prev
    if lod_next < 0 || lod_next >= lod_n { lod_next = 0 }
    set_sel_selected($&ed.lod_asset_select, lod_next)

    ctx_c := ed.context.clone()
    proj_c := clone_project(&ed.project)
    lang_ci := ed.lang
    refresh_comp_asset_selectors($&ed.comp, &ctx_c, &proj_c, lang_ci)
    ed.sync_asset_meta_text()
}

fn set_plain_field_label(f $&widgets.Field, lbl string) {
    $dec := widgets.field_decoration(&lbl)
    dec.reserve_helper = false
    set_field_dec(f, &dec)
}

fn (ed $&Editor) apply_language_internal() {
    lang := ed.lang
    p := $&ed.panels
    panels_apply_lang(p, lang)
    mods := $&ed.modals
    mods.apply_lang(lang)

    set_lbl_text($&ed.no_asset_lbl, &tr(lang, "(No assets)", "(无资源)"))
    set_lbl_text($&ed.root_parent_lbl, &tr(lang, "(root)", "(根节点)"))
    set_lbl_text($&ed.visible_lbl, &tr(lang, "Visible", "可见"))
    set_lbl_text($&ed.reparent_lbl, &tr(lang, "Reparent", "更改父级"))
    set_lbl_text($&ed.surf_bind_lbl, &tr(lang, "Bind GLB", "绑定 GLB"))
    set_lbl_text($&ed.surf_clear_lbl, &tr(lang, "Clear GLB", "清除 GLB"))
    set_lbl_text($&ed.lod_add_lbl, &tr(lang, "+ LOD", "+ LOD"))
    set_lbl_text($&ed.lod_pop_lbl, &tr(lang, "- LOD", "- LOD"))
    set_lbl_text($&ed.apply_lbl, &tr(lang, "Apply Changes", "应用更改"))

    proc_prev := ed.process_select.selected()
    for i in 0:ed.process_labels.len { dispose_label($&ed.process_labels[i]) }
    ed.process_labels = make_process_labels(&ed.context, lang)
    proc_n := ed.process_labels.len
    set_sel_count($&ed.process_select, proc_n)
    $proc_next := proc_prev
    if proc_next < 0 || proc_next >= proc_n { proc_next = 0 }
    set_sel_selected($&ed.process_select, proc_next)

    set_plain_field_label($&ed.prim_field, tr(lang, "Prim", "图元"))
    set_plain_field_label($&ed.surf_prim_field, tr(lang, "Prim", "图元"))
    set_plain_field_label($&ed.lod_hyst_field, tr(lang, "Hyst", "滞后"))
    set_plain_field_label($&ed.lod_dist_field, tr(lang, "Dist", "距离"))
    set_plain_field_label($&ed.lod_prim_field, tr(lang, "L.Prim", "LOD图元"))

    ctx_c := ed.context.clone()
    proj_c := clone_project(&ed.project)
    comp_apply_lang($&ed.comp, &ctx_c, &proj_c, lang)
}

pub fn (ed $&Editor) apply_language(view $&widgets.View) {
    ed.apply_language_internal()
    ed.refresh_project_selectors()
    doc := ed.draft.document() or (err) {
        _ := err
        ed.sync_toolbar_states()
        ed.repaint_all(view)
        <<
    }
    ed.sync_inspector(&doc)
    ed.sync_toolbar_states()
    ed.repaint_all(view)
}

fn try_save_editor_lang(out &string, lang int) int {
    << save_editor_lang(out, lang) or (err) {
        _ := err
        << 0
    }
}

pub fn (ed $&Editor) set_lang(next_lang int, view $&widgets.View) {
    $clamped := LANG_EN
    if next_lang == LANG_ZH { clamped = LANG_ZH }
    ed.lang = clamped
    out_dir := ed.output_dir + ""
    _ := try_save_editor_lang(&out_dir, clamped)
    tip := $&ed.tooltip
    _ := tip.dismiss()
    ed.apply_language(view)
    ed.set_status(STATUS_OK, tr(clamped, "Switched language to English", "已切换为中文界面"), view)
}

pub fn (ed $&Editor) rebuild_tree(doc &resource.Document) {
    tree_begin_update($&ed.tree)
    tree_clear($&ed.tree)
    ed.tree_to_scene = map[int]int{}
    ed.scene_to_tree = map[int]int{}

    $has_surf := map[int]bool{}
    for i in 0:doc.surface_count() {
        s := doc.surface(i) or (err) { <- }
        has_surf[s.node] = true
    }
    $has_light := map[int]bool{}
    for i in 0:doc.light_count() {
        lt := doc.light(i) or (err) { <- }
        has_light[lt.node] = true
    }
    $has_script := map[int]bool{}
    for i in 0:doc.script_count() {
        sc := doc.script(i) or (err) { <- }
        has_script[sc.node] = true
    }
    $has_audio := map[int]bool{}
    for i in 0:doc.audio_count() {
        ae := doc.audio_emitter(i) or (err) { <- }
        has_audio[ae.node] = true
    }
    $has_sprite := map[int]bool{}
    for i in 0:doc.sprite_3d_count() {
        sp := doc.sprite_3d(i) or (err) { <- }
        has_sprite[sp.node] = true
    }
    $has_tilemap := map[int]bool{}
    for i in 0:doc.tilemap_2d_count() {
        tm := doc.tilemap_2d(i) or (err) { <- }
        has_tilemap[tm.node] = true
    }

    flt := strings.to_lower(&strings.trim_space(&ed.panels.fields[PF_TREE_FILTER].value()))
    $tags := []string{}
    $parents := []int{}
    $include := []bool{}
    for i in 0:doc.node_count() {
        nd := doc.describe_node(i) or (err) { <- }
        $tag := "G"
        if nd.kind == resource.NODE_3D { tag = "3D" }
        else if nd.kind == resource.NODE_2D { tag = "2D" }
        if !nd.visible { tag = tag + " H" }
        if has_surf.has(i) { tag = tag + " M" }
        if nd.camera.is_set() || nd.orthographic.is_set() || nd.camera_2d.is_set() { tag = tag + " C" }
        if has_light.has(i) { tag = tag + " L" }
        if has_script.has(i) { tag = tag + " S" }
        if has_audio.has(i) { tag = tag + " A" }
        if has_sprite.has(i) { tag = tag + " Sp" }
        if has_tilemap.has(i) { tag = tag + " Tm" }
        tags.push(tag + "")
        parents.push(nd.parent)
        $hit := flt.len == 0
        if !hit {
            if strings.contains(&strings.to_lower(&nd.name), flt + "") || strings.contains(&strings.to_lower(&tag), flt + "") {
                hit = true
            }
        }
        include.push(hit)
    }
    if flt.len > 0 {
        for i in 0:include.len {
            if include[i] {
                $p := parents[i]
                while p >= 0 && p < include.len {
                    include[p] = true
                    p = parents[p]
                }
            }
        }
    }

    for i in 0:doc.node_count() {
        if !include[i] { -> }
        nd := doc.describe_node(i) or (err) { <- }
        $tparent := -1
        if nd.parent >= 0 && ed.scene_to_tree.has(nd.parent) {
            tparent = ed.scene_to_tree[nd.parent]
        }
        tid := tree_add_node($&ed.tree, tparent, &nd.name) or (err) { <- }
        ed.scene_to_tree[i] = tid
        ed.tree_to_scene[tid] = i
        tag := tags[i] + ""
        tree_set_meta($&ed.tree, tid, &tag)
        tree_set_exp($&ed.tree, tid, true)
    }
    if ed.selected_node < 0 || ed.selected_node >= doc.node_count() {
        ed.selected_node = 0
    }
    $valid_sel := []int{}
    $seen_sel := map[int]bool{}
    for i in 0:ed.selected_nodes.len {
        id := ed.selected_nodes[i]
        if id >= 0 && id < doc.node_count() && !seen_sel.has(id) {
            seen_sel[id] = true
            valid_sel.push(id)
        }
    }
    if valid_sel.len == 0 { valid_sel.push(ed.selected_node) }
    ed.selected_nodes = valid_sel
    ed.sync_tree_selection(false)
    tree_end_update($&ed.tree)
    if ed.selected_node == 0 {
        tree_set_scroll($&ed.tree, 0.0)
    }
}

fn subtree_mask(doc &resource.Document, root_idx int) map[int]bool {
    $mask := map[int]bool{}
    if root_idx < 0 || root_idx >= doc.node_count() { << mask }
    mask[root_idx] = true
    for i in (root_idx + 1):doc.node_count() {
        nd := doc.describe_node(i) or (err) { << mask }
        if mask.has(nd.parent) {
            mask[i] = true
        }
    }
    << mask
}

fn (ed $&Editor) rebuild_parent_choices(doc &resource.Document, cur_parent int) {
    for i in 0:ed.parent_labels.len { dispose_label($&ed.parent_labels[i]) }
    ed.parent_labels = []widgets.StyledLabel{}
    ed.parent_candidates = []int{}

    if ed.selected_node <= 0 || ed.selected_node >= doc.node_count() {
        ed.parent_labels.push(widgets.styled_label(&ed.context, &tr(ed.lang, "(root)", "(根节点)")))
        set_sel_count($&ed.parent_select, 1)
        set_sel_selected($&ed.parent_select, 0)
        <<
    }

    blocked := subtree_mask(doc, ed.selected_node)
    $sel_pos := 0
    // Always include current parent & root first so select never exceeds 64 limit without them.
    $added := map[int]bool{}
    $order := []int{}
    if cur_parent >= 0 && cur_parent < doc.node_count() && !blocked.has(cur_parent) {
        order.push(cur_parent)
        added[cur_parent] = true
    }
    if !added.has(0) && !blocked.has(0) {
        order.push(0)
        added[0] = true
    }
    for i in 0:doc.node_count() {
        if order.len >= 64 { <- }
        if !added.has(i) && !blocked.has(i) {
            order.push(i)
            added[i] = true
        }
    }
    for k in 0:order.len {
        cid := order[k]
        nd := doc.describe_node(cid) or (err) { -> }
        if cid == cur_parent { sel_pos = ed.parent_candidates.len }
        ed.parent_candidates.push(cid)
        lbl := "[" + str(cid) + "] " + nd.name
        ed.parent_labels.push(widgets.styled_label(&ed.context, &lbl))
    }
    if ed.parent_candidates.len == 0 {
        ed.parent_labels.push(widgets.styled_label(&ed.context, &tr(ed.lang, "(none)", "(无)")))
        set_sel_count($&ed.parent_select, 1)
        set_sel_selected($&ed.parent_select, 0)
        <<
    }
    cand_len := ed.parent_candidates.len
    set_sel_count($&ed.parent_select, cand_len)
    set_sel_selected($&ed.parent_select, sel_pos)
}

pub fn (ed $&Editor) sync_inspector(doc &resource.Document) {
    if ed.selected_node < 0 || ed.selected_node >= doc.node_count() {
        ed.selected_node = 0
    }
    nd := doc.describe_node(ed.selected_node) or (err) { << }
    $klabel := tr(ed.lang, "Node (Group)", "节点组")
    if nd.kind == resource.NODE_3D { klabel = tr(ed.lang, "Node3D", "3D 节点") }
    else if nd.kind == resource.NODE_2D { klabel = tr(ed.lang, "Node2D", "2D 节点") }
    if ed.selected_node == 0 { klabel = klabel + tr(ed.lang, " · Root", " · 根节点") }
    ed.insp_kind_text = tr(ed.lang, "Inspector · ", "检查器 · ") + klabel
    if ed.selected_nodes.len > 1 {
        ed.insp_kind_text = ed.insp_kind_text + tr(ed.lang, " (" + str(ed.selected_nodes.len) + " selected)", "（已选 " + str(ed.selected_nodes.len) + " 项）")
    }
    hdr_copy := ed.insp_kind_text + ""
    set_text_val($&ed.insp_hdr_txt, &hdr_copy)

    ed.insp_editable = true
    ed.insp_can_trs = nd.kind == resource.NODE_3D
    ed.insp_can_2d = nd.kind == resource.NODE_2D

    set_field_val($&ed.name_field, &nd.name)
    ed.name_error = ""
    ed.refresh_name_decoration(&nd.name)
    set_chk_val($&ed.visible_chk, nd.visible)
    $pm := nd.process_mode
    if pm < 0 || pm > resource.PROCESS_DISABLED { pm = resource.PROCESS_INHERIT }
    set_sel_selected($&ed.process_select, pm)
    ed.rebuild_parent_choices(doc, nd.parent)

    if nd.kind == resource.NODE_3D {
        trs := decompose_trs(&nd.local_3d)
        set_field_val($&ed.pos_x, &fmt_coord(trs.position.x))
        set_field_val($&ed.pos_y, &fmt_coord(trs.position.y))
        set_field_val($&ed.pos_z, &fmt_coord(trs.position.z))
        ed.rot_seed_x = fmt_coord(trs.rotation_deg.x)
        ed.rot_seed_y = fmt_coord(trs.rotation_deg.y)
        ed.rot_seed_z = fmt_coord(trs.rotation_deg.z)
        rx := ed.rot_seed_x + ""
        ry := ed.rot_seed_y + ""
        rz := ed.rot_seed_z + ""
        set_field_val($&ed.rot_x, &rx)
        set_field_val($&ed.rot_y, &ry)
        set_field_val($&ed.rot_z, &rz)
        ed.scale_seed_x = fmt_coord(trs.scale.x)
        ed.scale_seed_y = fmt_coord(trs.scale.y)
        ed.scale_seed_z = fmt_coord(trs.scale.z)
        sx := ed.scale_seed_x + ""
        sy := ed.scale_seed_y + ""
        sz := ed.scale_seed_z + ""
        set_field_val($&ed.scale_x, &sx)
        set_field_val($&ed.scale_y, &sy)
        set_field_val($&ed.scale_z, &sz)
    } else if nd.kind == resource.NODE_2D {
        t2 := decompose_2d(&nd.local)
        set_field_val($&ed.pos_x, &fmt_coord(t2.x))
        set_field_val($&ed.pos_y, &fmt_coord(t2.y))
        set_field_val($&ed.pos_z, &"0")
        ed.rot_seed_x = "0"
        ed.rot_seed_y = "0"
        ed.rot_seed_z = fmt_coord(t2.rot_deg)
        rz2 := ed.rot_seed_z + ""
        set_field_val($&ed.rot_x, &"0")
        set_field_val($&ed.rot_y, &"0")
        set_field_val($&ed.rot_z, &rz2)
        ed.scale_seed_x = fmt_coord(t2.sx)
        ed.scale_seed_y = fmt_coord(t2.sy)
        ed.scale_seed_z = "1"
        sx2 := ed.scale_seed_x + ""
        sy2 := ed.scale_seed_y + ""
        set_field_val($&ed.scale_x, &sx2)
        set_field_val($&ed.scale_y, &sy2)
        set_field_val($&ed.scale_z, &"1")
    } else {
        set_field_val($&ed.pos_x, &"0")
        set_field_val($&ed.pos_y, &"0")
        set_field_val($&ed.pos_z, &"0")
        ed.rot_seed_x = "0"
        ed.rot_seed_y = "0"
        ed.rot_seed_z = "0"
        set_field_val($&ed.rot_x, &"0")
        set_field_val($&ed.rot_y, &"0")
        set_field_val($&ed.rot_z, &"0")
        ed.scale_seed_x = "1"
        ed.scale_seed_y = "1"
        ed.scale_seed_z = "1"
        set_field_val($&ed.scale_x, &"1")
        set_field_val($&ed.scale_y, &"1")
        set_field_val($&ed.scale_z, &"1")
    }

    can_xy := ed.insp_can_trs || ed.insp_can_2d
    can_3d := ed.insp_can_trs
    enable_field($&ed.pos_x, can_xy)
    enable_field($&ed.pos_y, can_xy)
    enable_field($&ed.pos_z, can_3d)
    enable_field($&ed.rot_x, can_3d)
    enable_field($&ed.rot_y, can_3d)
    enable_field($&ed.rot_z, can_xy)
    enable_field($&ed.scale_x, can_xy)
    enable_field($&ed.scale_y, can_xy)
    enable_field($&ed.scale_z, can_3d)

    ed.surf_text = tr(ed.lang, "No GLB surface attached", "未绑定 GLB 表面")
    for i in 0:doc.surface_count() {
        s := doc.surface(i) or (err) { <- }
        if s.node == ed.selected_node {
            $aname := s.resource_uid
            for j in 0:ed.project.assets.len {
                if ed.project.assets[j].key == s.resource_uid {
                    aname = filepath.base(&ed.project.assets[j].path)
                }
            }
            ed.surf_text = tr(ed.lang, "Surface: ", "表面: ") + aname + tr(ed.lang, " · prim ", " · 图元 ") + str(s.primitive)
            <-
        }
    }
    surf_copy := ed.surf_text + ""
    set_text_val($&ed.surf_info_txt, &surf_copy)
    sync_surface_inspector(ed, doc, can_3d)
    ctx_ci := ed.context.clone()
    proj_ci := clone_project(&ed.project)
    sel_ci := ed.selected_node
    lang_ci := ed.lang
    sync_comp_inspector($&ed.comp, &ctx_ci, &proj_ci, doc, sel_ci, lang_ci)
}

fn (ed $&Editor) refresh_name_decoration(val &string) {
    nm_lbl := tr(ed.lang, "Name *", "名称 *")
    $dec := widgets.field_decoration(&nm_lbl)
    dec.clearable = true
    dec.helper = byte_counter_text_lang(val, 255, ed.lang)
    dec.error = ed.name_error + ""
    name_bad := ed.name_error.len > 0
    set_field_dec($&ed.name_field, &dec)
    set_field_inv($&ed.name_field, name_bad)
}

pub fn (ed $&Editor) refresh_after_document_change(fit_stage bool, view $&widgets.View) {
    doc := ed.draft.document() or (err) {
        ed.set_status(STATUS_ERR, err.msg(), view)
        <<
    }
    ed.stage_pts = extract_stage_points(&doc)
    if fit_stage {
        $fit_b := ed.top_view_local
        if fit_b.width < 40.0 || fit_b.height < 40.0 {
            fit_b = layout.Rect{x: 0.0, y: 0.0, width: 580.0, height: 520.0}
        }
        pts := clone_stage_points(&ed.stage_pts)
        tv := $&ed.top_view
        tv.fit_points(&pts, &fit_b)
    }
    ed.rebuild_tree(&doc)
    ed.sync_inspector(&doc)
    ed.sync_toolbar_states()
    ed.repaint_all(view)
}

fn (ed $&Editor) set_single_selection(idx int) {
    ed.selected_node = idx
    if idx >= 0 {
        ed.selected_nodes = [idx]
    } else {
        ed.selected_nodes = []int{}
    }
}

fn (ed $&Editor) toggle_selection_node(idx int) {
    if idx < 0 { << }
    $next := []int{}
    $found := false
    for i in 0:ed.selected_nodes.len {
        n := ed.selected_nodes[i]
        if n == idx {
            found = true
        } else {
            next.push(n)
        }
    }
    if !found {
        next.push(idx)
    }
    if next.len == 0 {
        next.push(0)
    }
    ed.selected_node = next[next.len - 1]
    ed.selected_nodes = next
}

fn (ed $&Editor) apply_tree_selection_from_widget(view $&widgets.View) {
    tids := ed.tree.selected_nodes()
    pt := ed.tree.selected()
    $sels := []int{}
    $seen_s := map[int]bool{}
    for i in 0:tids.len {
        tid := tids[i]
        if ed.tree_to_scene.has(tid) {
            sid := ed.tree_to_scene[tid]
            if !seen_s.has(sid) {
                seen_s[sid] = true
                sels.push(sid)
            }
        }
    }
    $primary_s := -1
    if ed.tree_to_scene.has(pt) {
        primary_s = ed.tree_to_scene[pt]
    } else if sels.len > 0 {
        primary_s = sels[sels.len - 1]
    }
    if sels.len == 0 {
        ed.select_scene_node(0, view)
        <<
    }
    ed.selected_nodes = sels
    ed.selected_node = primary_s
    doc := ed.draft.document() or (err) {
        _ := err
        <<
    }
    ed.sync_inspector(&doc)
    ed.sync_toolbar_states()
    repaint(view, ed.id_left_pane)
    repaint(view, ed.id_top_view)
    repaint(view, ed.id_right_pane)
}

fn (ed $&Editor) sync_tree_selection(reveal bool) {
    $tids := []int{}
    for i in 0:ed.selected_nodes.len {
        sid := ed.selected_nodes[i]
        if ed.scene_to_tree.has(sid) {
            tids.push(ed.scene_to_tree[sid])
        }
    }
    $primary_tid := -1
    if ed.scene_to_tree.has(ed.selected_node) {
        primary_tid = ed.scene_to_tree[ed.selected_node]
    }
    tree_set_sel_nodes($&ed.tree, &tids, primary_tid)
    if reveal && primary_tid >= 0 {
        tree_reveal_sel($&ed.tree)
    }
}

pub fn (ed $&Editor) set_selection_list(nodes &[]int, view $&widgets.View) {
    doc := ed.draft.document() or (err) { << }
    $valid := []int{}
    $seen := map[int]bool{}
    for i in 0:nodes.len {
        idx := nodes[i]
        if idx >= 0 && idx < doc.node_count() && !seen.has(idx) {
            seen[idx] = true
            valid.push(idx)
        }
    }
    if valid.len == 0 {
        valid.push(0)
    }
    ed.selected_nodes = valid
    ed.selected_node = ed.selected_nodes[ed.selected_nodes.len - 1]
    ed.sync_tree_selection(true)
    ed.sync_inspector(&doc)
    ed.sync_toolbar_states()
    repaint(view, ed.id_left_pane)
    repaint(view, ed.id_top_view)
    repaint(view, ed.id_right_pane)
}

pub fn (ed $&Editor) select_scene_node(index int, view $&widgets.View) {
    doc := ed.draft.document() or (err) { << }
    if index < 0 || index >= doc.node_count() { << }
    ed.set_single_selection(index)
    ed.sync_tree_selection(true)
    ed.sync_inspector(&doc)
    ed.sync_toolbar_states()
    repaint(view, ed.id_left_pane)
    repaint(view, ed.id_top_view)
    repaint(view, ed.id_right_pane)
}

pub fn (ed $&Editor) apply_inspector(view $&widgets.View) int {
    raw_name := ed.name_field.value()
    trimmed := strings.trim_space(&raw_name)
    if !valid_node_name(&trimmed) {
        ed.name_error = "1..255 bytes; no /, ., .. or control chars"
        ed.refresh_name_decoration(&raw_name)
        ed.set_status(STATUS_ERR, "Invalid node name", view)
        repaint(view, ed.id_right_pane)
        >> errors.new("nexus editor: invalid node name")
    }
    px := parse_f64_or(&ed.pos_x.value(), "Position X") or (err) {
        ed.set_status(STATUS_ERR, err.msg(), view)
        >> err
    }
    py := parse_f64_or(&ed.pos_y.value(), "Position Y") or (err) {
        ed.set_status(STATUS_ERR, err.msg(), view)
        >> err
    }
    pz := parse_f64_or(&ed.pos_z.value(), "Position Z") or (err) {
        ed.set_status(STATUS_ERR, err.msg(), view)
        >> err
    }
    rx := parse_f64_or(&ed.rot_x.value(), "Rotation X") or (err) {
        ed.set_status(STATUS_ERR, err.msg(), view)
        >> err
    }
    ry := parse_f64_or(&ed.rot_y.value(), "Rotation Y") or (err) {
        ed.set_status(STATUS_ERR, err.msg(), view)
        >> err
    }
    rz := parse_f64_or(&ed.rot_z.value(), "Rotation Z") or (err) {
        ed.set_status(STATUS_ERR, err.msg(), view)
        >> err
    }
    sx := parse_f64_or(&ed.scale_x.value(), "Scale X") or (err) {
        ed.set_status(STATUS_ERR, err.msg(), view)
        >> err
    }
    sy := parse_f64_or(&ed.scale_y.value(), "Scale Y") or (err) {
        ed.set_status(STATUS_ERR, err.msg(), view)
        >> err
    }
    sz := parse_f64_or(&ed.scale_z.value(), "Scale Z") or (err) {
        ed.set_status(STATUS_ERR, err.msg(), view)
        >> err
    }

    rs_changed := ed.rot_x.value() != ed.rot_seed_x ||
        ed.rot_y.value() != ed.rot_seed_y ||
        ed.rot_z.value() != ed.rot_seed_z ||
        ed.scale_x.value() != ed.scale_seed_x ||
        ed.scale_y.value() != ed.scale_seed_y ||
        ed.scale_z.value() != ed.scale_seed_z

    sel_node := ed.selected_node
    vis := ed.visible_chk.value()
    $proc_mode := ed.process_select.selected()
    if proc_mode < resource.PROCESS_INHERIT || proc_mode > resource.PROCESS_DISABLED {
        proc_mode = resource.PROCESS_INHERIT
    }
    name_copy := trimmed + ""
    d := $&ed.draft
    d.set_node_full_properties(
        sel_node,
        name_copy,
        vis,
        proc_mode,
        fm.vec3(px, py, pz),
        rs_changed,
        fm.vec3(rx, ry, rz),
        fm.vec3(sx, sy, sz)
    ) or (err) {
        ed.name_error = err.msg()
        ed.refresh_name_decoration(&raw_name)
        ed.set_status(STATUS_ERR, err.msg(), view)
        repaint(view, ed.id_right_pane)
        >> err
    }

    ed.name_error = ""
    ed.refresh_after_document_change(false, view)
    ed.set_status(STATUS_OK, "Applied changes to " + trimmed, view)
    << 0
}

fn parse_f64_or(raw &string, label string) f64 {
    t := strings.trim_space(raw)
    if t.len == 0 {
        >> errors.new(label + " is required")
    }
    v := strconv.parse_float(&t) or (err) {
        >> errors.new(label + " must be a finite number")
    }
    if math.is_nan(v) || math.is_inf(v) {
        >> errors.new(label + " must be a finite number")
    }
    << v
}

fn (ed $&Editor) blur_all_fields() {
    focus_field($&ed.name_field, false)
    focus_field($&ed.prim_field, false)
    focus_field($&ed.pos_x, false)
    focus_field($&ed.pos_y, false)
    focus_field($&ed.pos_z, false)
    focus_field($&ed.rot_x, false)
    focus_field($&ed.rot_y, false)
    focus_field($&ed.rot_z, false)
    focus_field($&ed.scale_x, false)
    focus_field($&ed.scale_y, false)
    focus_field($&ed.scale_z, false)
    focus_field($&ed.surf_prim_field, false)
    focus_field($&ed.lod_hyst_field, false)
    focus_field($&ed.lod_dist_field, false)
    focus_field($&ed.lod_prim_field, false)
    comp_blur_all($&ed.comp)
    panels_blur_all($&ed.panels)
}

fn (ed $&Editor) open_snap_modal(view $&widgets.View) {
    ed.blur_all_fields()
    sn := ed.snap
    vw := ed.viewport_w
    vh := ed.viewport_h
    st := ed.styles.clone()
    mods := $&ed.modals
    mods.open_snap(&sn)
    mods.layout(vw, vh, &st)
    repaint(view, ed.id_root)
}

fn (ed $&Editor) open_new_scene_modal(view $&widgets.View) {
    ed.blur_all_fields()
    vw := ed.viewport_w
    vh := ed.viewport_h
    st := ed.styles.clone()
    mods := $&ed.modals
    mods.open_new_scene()
    mods.layout(vw, vh, &st)
    repaint(view, ed.id_root)
}

fn (ed $&Editor) open_unsaved_modal(target_idx int, close_after bool, view $&widgets.View) {
    ed.blur_all_fields()
    vw := ed.viewport_w
    vh := ed.viewport_h
    st := ed.styles.clone()
    mods := $&ed.modals
    mods.open_unsaved(target_idx, close_after)
    mods.layout(vw, vh, &st)
    repaint(view, ed.id_root)
}

fn (ed $&Editor) open_unsaved_open_project_modal(view $&widgets.View) {
    ed.blur_all_fields()
    vw := ed.viewport_w
    vh := ed.viewport_h
    st := ed.styles.clone()
    mods := $&ed.modals
    mods.open_unsaved_open_project()
    mods.layout(vw, vh, &st)
    repaint(view, ed.id_root)
}

fn (ed $&Editor) open_scene_manage_modal(view $&widgets.View) {
    if ed.scene_index < 0 || ed.scene_index >= ed.project.scenes.len { << }
    ed.blur_all_fields()
    cur_key := ed.project.scenes[ed.scene_index].key + ""
    sc_cnt := ed.project.scenes.len
    vw := ed.viewport_w
    vh := ed.viewport_h
    st := ed.styles.clone()
    mods := $&ed.modals
    mods.open_scene_manage(&cur_key, sc_cnt)
    mods.layout(vw, vh, &st)
    repaint(view, ed.id_root)
}

fn (ed $&Editor) open_export_modal(view $&widgets.View) {
    ed.blur_all_fields()
    $def_dir := ed.export_target_dir + ""
    if def_dir.len == 0 { def_dir = ed.output_dir + "" }
    vw := ed.viewport_w
    vh := ed.viewport_h
    st := ed.styles.clone()
    mods := $&ed.modals
    mods.open_export(&def_dir)
    mods.layout(vw, vh, &st)
    repaint(view, ed.id_root)
}

fn (ed $&Editor) open_globals_modal(view $&widgets.View) {
    ed.blur_all_fields()
    doc := ed.draft.document() or (err) {
        ed.set_status(STATUS_ERR, err.msg(), view)
        <<
    }
    vw := ed.viewport_w
    vh := ed.viewport_h
    st := ed.styles.clone()
    mods := $&ed.modals
    mods.open_globals(&doc)
    mods.layout(vw, vh, &st)
    repaint(view, ed.id_root)
}

pub fn (ed $&Editor) switch_scene(target_idx int, check_dirty bool, view $&widgets.View) {
    if target_idx < 0 || target_idx >= ed.project.scenes.len || target_idx == ed.scene_index {
        sidx := ed.scene_index
        set_sel_selected($&ed.scene_select, sidx)
        <<
    }
    if check_dirty && ed.draft.dirty() {
        sidx := ed.scene_index
        set_sel_selected($&ed.scene_select, sidx)
        ed.open_unsaved_modal(target_idx, false, view)
        <<
    }
    path := ed.project.scene_source(target_idx) or (err) {
        ed.set_status(STATUS_ERR, err.msg(), view)
        <<
    }
    next_draft := open_draft(path) or (err) {
        ed.set_status(STATUS_ERR, err.msg(), view)
        <<
    }
    ed.scene_index = target_idx
    ed.draft = next_draft
    ed.set_single_selection(0)
    ed.placing_mode = false
    set_sel_selected($&ed.scene_select, target_idx)
    ed.refresh_after_document_change(true, view)
    ed.set_status(STATUS_INFO, "Opened " + ed.project.scenes[target_idx].key, view)
}

pub fn (ed $&Editor) do_save(view $&widgets.View) bool {
    proj := clone_project(&ed.project)
    vbin := ed.validator_bin + ""
    d := $&ed.draft
    d.save(&proj, &vbin) or (err) {
        ed.set_status(STATUS_ERR, err.msg(), view)
        << false
    }
    ed.sync_toolbar_states()
    repaint(view, ed.id_toolbar)
    ed.set_status(STATUS_OK, tr(ed.lang, "Saved ", "已保存 ") + ed.project.scenes[ed.scene_index].key, view)
    << true
}

pub fn (ed $&Editor) do_undo(view $&widgets.View) {
    if !ed.draft.can_undo() { << }
    d := $&ed.draft
    _ := d.undo_edit()
    ed.refresh_after_document_change(false, view)
    ed.set_status(STATUS_INFO, tr(ed.lang, "Undid edit", "已撤销"), view)
}

pub fn (ed $&Editor) do_redo(view $&widgets.View) {
    if !ed.draft.can_redo() { << }
    d := $&ed.draft
    _ := d.redo_edit()
    ed.refresh_after_document_change(false, view)
    ed.set_status(STATUS_INFO, tr(ed.lang, "Redid edit", "已重做"), view)
}

pub fn (ed $&Editor) do_add_node(kind int, base string, view $&widgets.View) {
    $parent := ed.selected_node
    if parent < 0 { parent = 0 }
    d := $&ed.draft
    new_idx := d.add_node_under(parent, kind, base + "") or (err) {
        ed.set_status(STATUS_ERR, err.msg(), view)
        <<
    }
    ed.set_single_selection(new_idx)
    ed.refresh_after_document_change(false, view)
    ed.set_status(STATUS_OK, "Added " + base, view)
}

fn draft_add_preset_cam(ed $&Editor, parent int) int {
    d := $&ed.draft
    << d.add_preset_camera_node(parent) or >>
}

fn draft_add_preset_lgt(ed $&Editor, parent int) int {
    d := $&ed.draft
    << d.add_preset_light_node(parent) or >>
}

pub fn (ed $&Editor) do_add_preset_cam(view $&widgets.View) {
    $parent := ed.selected_node
    if parent < 0 { parent = 0 }
    new_idx := draft_add_preset_cam(ed, parent) or (err) {
        ed.set_status(STATUS_ERR, err.msg(), view)
        <<
    }
    ed.set_single_selection(new_idx)
    ed.refresh_after_document_change(false, view)
    ed.set_status(STATUS_OK, "Added Camera node", view)
}

pub fn (ed $&Editor) do_add_preset_lgt(view $&widgets.View) {
    $parent := ed.selected_node
    if parent < 0 { parent = 0 }
    new_idx := draft_add_preset_lgt(ed, parent) or (err) {
        ed.set_status(STATUS_ERR, err.msg(), view)
        <<
    }
    ed.set_single_selection(new_idx)
    ed.refresh_after_document_change(false, view)
    ed.set_status(STATUS_OK, "Added PointLight node", view)
}

pub fn (ed $&Editor) do_duplicate_node(view $&widgets.View) {
    sel_node := ed.selected_node
    d := $&ed.draft
    new_idx := d.duplicate_node(sel_node) or (err) {
        ed.set_status(STATUS_ERR, err.msg(), view)
        <<
    }
    ed.set_single_selection(new_idx)
    ed.refresh_after_document_change(false, view)
    ed.set_status(STATUS_OK, "Duplicated subtree", view)
}

pub fn (ed $&Editor) do_delete_node(view $&widgets.View) {
    $to_del := []int{}
    for i in 0:ed.selected_nodes.len { to_del.push(ed.selected_nodes[i]) }
    sel_node := ed.selected_node
    d := $&ed.draft
    $next_sel := 0
    if to_del.len > 1 {
        next_sel = d.delete_nodes(&to_del) or (err) {
            ed.set_status(STATUS_ERR, err.msg(), view)
            <<
        }
    } else {
        next_sel = d.delete_node(sel_node) or (err) {
            ed.set_status(STATUS_ERR, err.msg(), view)
            <<
        }
    }
    ed.set_single_selection(next_sel)
    ed.refresh_after_document_change(false, view)
    ed.set_status(STATUS_OK, "Deleted selection", view)
}

pub fn (ed $&Editor) do_move_sibling(delta int, view $&widgets.View) {
    if ed.selected_node <= 0 { << }
    sel := ed.selected_node
    d := $&ed.draft
    next_idx := d.move_node_sibling(sel, delta) or (err) {
        ed.set_status(STATUS_ERR, err.msg(), view)
        <<
    }
    ed.set_single_selection(next_idx)
    ed.refresh_after_document_change(false, view)
    if delta < 0 {
        ed.set_status(STATUS_OK, "Moved node up", view)
    } else {
        ed.set_status(STATUS_OK, "Moved node down", view)
    }
}

pub fn (ed $&Editor) do_toggle_selected_visible(view $&widgets.View) {
    doc := ed.draft.document() or (err) {
        ed.set_status(STATUS_ERR, err.msg(), view)
        <<
    }
    if ed.selected_node < 0 || ed.selected_node >= doc.node_count() { << }
    nd := doc.describe_node(ed.selected_node) or (err) { << }
    sel := ed.selected_node
    next_vis := !nd.visible
    d := $&ed.draft
    d.set_node_visible_only(sel, next_vis) or (err) {
        ed.set_status(STATUS_ERR, err.msg(), view)
        <<
    }
    ed.refresh_after_document_change(false, view)
    if next_vis {
        ed.set_status(STATUS_OK, "Shown " + nd.name, view)
    } else {
        ed.set_status(STATUS_OK, "Hidden " + nd.name, view)
    }
}

pub fn (ed $&Editor) do_remove_selected_asset(view $&widgets.View) {
    sel := ed.asset_select.selected()
    if sel < 0 || sel >= ed.project.assets.len {
        ed.set_status(STATUS_ERR, "No asset selected", view)
        <<
    }
    uid := ed.project.assets[sel].key + ""
    rel := ed.project.assets[sel].path + ""
    proj_path := ed.project.path + ""
    _ := remove_asset(&proj_path, &uid) or (err) {
        ed.set_status(STATUS_ERR, err.msg(), view)
        <<
    }
    reloaded := load_project(proj_path) or (err) {
        ed.set_status(STATUS_ERR, err.msg(), view)
        <<
    }
    ed.project = reloaded
    ed.panels.glb_prim_cache = map[string]string{}
    ed.placing_mode = false
    ed.refresh_project_selectors()
    ed.sync_toolbar_states()
    repaint(view, ed.id_left_pane)
    ed.set_status(STATUS_OK, "Removed asset " + rel, view)
}

pub fn (ed $&Editor) open_project_file(project_path &string, view $&widgets.View) int {
    next_proj := load_project(*project_path + "") or >>
    scene_path := next_proj.scene_source(0) or >>
    next_draft := open_draft(scene_path) or >>
    ed.project = next_proj
    ed.scene_index = 0
    ed.draft = next_draft
    ed.set_single_selection(0)
    ed.placing_mode = false
    ed.panels.glb_prim_cache = map[string]string{}
    set_field_val($&ed.panels.fields[PF_TREE_FILTER], &"")
    ed.refresh_project_selectors()
    ed.refresh_after_document_change(true, view)
    ed.set_status(STATUS_OK, "Opened project " + filepath.base(&ed.project.directory), view)
    << 0
}

pub fn (ed $&Editor) do_reparent_selected(view $&widgets.View) {
    sel_opt := ed.parent_select.selected()
    if sel_opt < 0 || sel_opt >= ed.parent_candidates.len { << }
    target_parent := ed.parent_candidates[sel_opt]
    sel_node := ed.selected_node
    d := $&ed.draft
    next_idx := d.reparent_node(sel_node, target_parent, true) or (err) {
        ed.set_status(STATUS_ERR, err.msg(), view)
        <<
    }
    ed.set_single_selection(next_idx)
    ed.refresh_after_document_change(false, view)
    ed.set_status(STATUS_OK, "Reparented node", view)
}

pub fn (ed $&Editor) do_place_at(wx f64, wz f64, view $&widgets.View) {
    idx := ed.asset_select.selected()
    if idx < 0 || idx >= ed.project.assets.len {
        ed.placing_mode = false
        ed.set_status(STATUS_ERR, "No GLB asset selected", view)
        <<
    }
    prim_txt := strings.trim_space(&ed.prim_field.value())
    $prim := 0
    if prim_txt.len > 0 {
        prim = strconv.atoi(&prim_txt) or (err) {
            ed.set_status(STATUS_ERR, "Primitive index must be a non-negative integer", view)
            <<
        }
    }
    uid := ed.project.assets[idx].key + ""
    proj := clone_project(&ed.project)
    d := $&ed.draft
    new_node := d.place_asset(&proj, uid, prim, wx, wz) or (err) {
        ed.set_status(STATUS_ERR, err.msg(), view)
        <<
    }
    ed.placing_mode = false
    ed.set_single_selection(new_node)
    ed.refresh_after_document_change(false, view)
    ed.set_status(STATUS_OK, "Placed GLB at (" + fmt_coord(wx) + ", 0, " + fmt_coord(wz) + ")", view)
}

pub fn (ed $&Editor) submit_snap_modal(view $&widgets.View) {
    mv := ed.modals.fields[MF_SNAP_MOVE].value()
    rt := ed.modals.fields[MF_SNAP_ROTATE].value()
    sc := ed.modals.fields[MF_SNAP_SCALE].value()
    res := validate_snap_inputs(&mv, &rt, &sc)
    mods := $&ed.modals
    mods.snap_move_err = res.move_err + ""
    mods.snap_rotate_err = res.rotate_err + ""
    mods.snap_scale_err = res.scale_err + ""
    mods.sync_snap_decorations()
    if !res.valid {
        ed.set_status(STATUS_ERR, "Fix invalid snap settings", view)
        repaint(view, ed.id_root)
        <<
    }
    save_snap_settings(&ed.output_dir, &res.settings) or (err) {
        mods2 := $&ed.modals
        mods2.snap_move_err = err.msg()
        mods2.sync_snap_decorations()
        ed.set_status(STATUS_ERR, err.msg(), view)
        repaint(view, ed.id_root)
        <<
    }
    ed.snap = res.settings
    modal_close($&ed.modals)
    repaint(view, ed.id_root)
    ed.set_status(STATUS_OK, "Saved snap settings", view)
}

pub fn (ed $&Editor) submit_new_scene_modal(view $&widgets.View) {
    raw_name := ed.modals.fields[MF_SCENE_NAME].value()
    raw_root := ed.modals.fields[MF_SCENE_ROOT].value()
    new_key := create_scene(&ed.project.path, &raw_name, &raw_root) or (err) {
        mods := $&ed.modals
        mods.scene_err = err.msg()
        mods.sync_scene_decoration()
        ed.set_status(STATUS_ERR, err.msg(), view)
        repaint(view, ed.id_root)
        <<
    }
    reloaded := load_project(ed.project.path + "") or (err) {
        ed.set_status(STATUS_ERR, err.msg(), view)
        <<
    }
    ed.project = reloaded
    ed.refresh_project_selectors()
    $next_idx := 0
    for i in 0:ed.project.scenes.len {
        if ed.project.scenes[i].key == new_key {
            next_idx = i
        }
    }
    modal_close($&ed.modals)
    ed.scene_index = -1
    ed.switch_scene(next_idx, false, view)
    ed.set_status(STATUS_OK, "Created scene " + new_key, view)
}

// StyledPainter contract methods
pub fn (ed $&Editor) measure_styled(id int, styles &widgets.Styles) layout.Size {
    _ := id
    _ := styles
    << layout.Size{width: 0.0, height: 0.0}
}

pub fn (ed $&Editor) paint_styled(id int, bounds &layout.Rect, styles &widgets.Styles, frame $&draw.Frame) bool {
    ed.draw_node(id, frame, bounds, styles) or (err) {
        _ := err
        << false
    }
    << true
}

fn (ed $&Editor) draw_node(id int, frame $&draw.Frame, bounds &layout.Rect, styles &widgets.Styles) int {
    _ := styles
    if id == ed.id_toolbar {
        frame.fill_rect(0.0, 0.0, bounds.width, bounds.height, ed.pal.surface) or >>
        frame.line(0.0, bounds.height - 0.5, bounds.width, bounds.height - 0.5, ed.pal.border, 1.0) or >>
    } else if id == ed.id_brand {
        frame.fill_round_rect(0.0, 1.0, bounds.width, 24.0, 6.0, ed.pal.brand) or >>
        frame.text(8.0, 6.0, 12.0, draw.rgb(255, 255, 255), &"Nexus") or >>
    } else if id == ed.id_tb_div1 || id == ed.id_tb_div2 || id == ed.id_tb_div3 {
        frame.line(bounds.width * 0.5, 2.0, bounds.width * 0.5, bounds.height - 2.0, ed.pal.border, 1.0) or >>
    } else if id == ed.id_dirty_badge {
        $lbl := tr(ed.lang, "Saved", "已保存")
        $bg := ed.pal.elevated
        $fg := ed.pal.muted
        $dot := ed.pal.success
        if ed.draft.dirty() {
            lbl = tr(ed.lang, "Unsaved", "未保存")
            bg = draw.rgb(253, 236, 239)
            fg = ed.pal.brand
            dot = ed.pal.brand
        }
        frame.fill_round_rect(0.0, 1.0, bounds.width, 22.0, 11.0, bg) or >>
        frame.fill_circle(11.0, 12.0, 3.0, dot) or >>
        frame.text(18.0, 5.5, 11.5, fg, &lbl) or >>
    } else if id == ed.id_scene_select {
        sc := ed.scene_select.clone()
        sel := sc.selected()
        if sel >= 0 && sel < ed.scene_labels.len {
            sc.paint_styled(frame, $&ed.scene_labels[sel], styles) or >>
        } else {
            sc.paint_styled(frame, $&ed.empty_lbl, styles) or >>
        }
    } else if id == ed.id_new_scene_btn {
        b := ed.new_scene_btn.clone()
        paint_icon_button(&b, $&ed.empty_lbl, ICON_SCENE_ADD, frame, styles) or >>
    } else if id == ed.id_globals_btn {
        b := ed.globals_btn.clone()
        paint_icon_button(&b, $&ed.empty_lbl, ICON_GLOBALS, frame, styles) or >>
    } else if id == ed.id_undo_btn {
        b := ed.undo_btn.clone()
        paint_icon_button(&b, $&ed.empty_lbl, ICON_UNDO, frame, styles) or >>
    } else if id == ed.id_redo_btn {
        b := ed.redo_btn.clone()
        paint_icon_button(&b, $&ed.empty_lbl, ICON_REDO, frame, styles) or >>
    } else if id == ed.id_save_btn {
        b := ed.save_btn.clone()
        paint_icon_button(&b, $&ed.empty_lbl, ICON_SAVE, frame, styles) or >>
    } else if id == ed.id_preview_btn {
        b := ed.preview_btn.clone()
        paint_icon_button(&b, $&ed.empty_lbl, ICON_PREVIEW, frame, styles) or >>
    } else if id == ed.id_left_pane {
        frame.fill_rect(0.0, 0.0, bounds.width, bounds.height, ed.pal.surface) or >>
    } else if id == ed.id_tree_hdr {
        $hdr := tr(ed.lang, "Scene Tree (", "场景树 (") + str(ed.stage_pts.len) + ")"
        if ed.selected_nodes.len > 1 {
            hdr = tr(ed.lang, "Scene Tree (", "场景树 (") + str(ed.stage_pts.len) + tr(ed.lang, " · ", " · 已选 ") + str(ed.selected_nodes.len) + tr(ed.lang, " sel)", ")")
        }
        frame.text(0.0, 4.0, 12.5, ed.pal.text, &hdr) or >>
    } else if id == ed.id_add_3d_btn {
        b := ed.add_3d_btn.clone()
        paint_icon_button(&b, $&ed.empty_lbl, ICON_ADD_3D, frame, styles) or >>
    } else if id == ed.id_add_2d_btn {
        b := ed.add_2d_btn.clone()
        paint_icon_button(&b, $&ed.empty_lbl, ICON_ADD_2D, frame, styles) or >>
    } else if id == ed.id_add_grp_btn {
        b := ed.add_grp_btn.clone()
        paint_icon_button(&b, $&ed.empty_lbl, ICON_ADD_GRP, frame, styles) or >>
    } else if id == ed.id_dup_btn {
        b := ed.dup_btn.clone()
        paint_icon_button(&b, $&ed.empty_lbl, ICON_DUP, frame, styles) or >>
    } else if id == ed.id_del_btn {
        b := ed.del_btn.clone()
        paint_icon_button(&b, $&ed.empty_lbl, ICON_DEL, frame, styles) or >>
    } else if id == ed.id_add_cam_btn {
        b := ed.add_cam_btn.clone()
        paint_icon_button(&b, $&ed.empty_lbl, ICON_ADD_CAM, frame, styles) or >>
    } else if id == ed.id_add_lgt_btn {
        b := ed.add_lgt_btn.clone()
        paint_icon_button(&b, $&ed.empty_lbl, ICON_ADD_LGT, frame, styles) or >>
    } else if id == ed.id_tree {
        paint_tree($&ed.tree, frame, styles) or >>
    } else if id == ed.id_assets_hdr {
        ahdr := tr(ed.lang, "Assets", "资源")
        frame.text(0.0, 4.0, 12.5, ed.pal.text, &ahdr) or >>
    } else if id == ed.id_import_btn {
        b := ed.import_btn.clone()
        paint_icon_button(&b, $&ed.empty_lbl, ICON_IMPORT, frame, styles) or >>
    } else if id == ed.id_asset_select {
        asel := ed.asset_select.clone()
        sel := asel.selected()
        if sel >= 0 && sel < ed.asset_labels.len {
            asel.paint_styled(frame, $&ed.asset_labels[sel], styles) or >>
        } else {
            asel.paint_styled(frame, $&ed.no_asset_lbl, styles) or >>
        }
    } else if id == ed.id_asset_meta {
        paint_text_sel($&ed.asset_meta_txt, frame, styles) or >>
    } else if id == ed.id_prim_field {
        paint_field($&ed.prim_field, frame, styles) or >>
    } else if id == ed.id_place_btn {
        b := ed.place_btn.clone()
        b.paint_styled(frame, $&ed.place_lbl, styles) or >>
    } else if id == ed.id_left_split || id == ed.id_right_split {
        frame.fill_rect(0.0, 0.0, bounds.width, bounds.height, ed.pal.canvas) or >>
        $col := ed.pal.border
        if (id == ed.id_left_split && ed.dragging_split == 1) || (id == ed.id_right_split && ed.dragging_split == 2) {
            col = ed.pal.focus
        }
        frame.fill_round_rect(1.5, bounds.height * 0.5 - 16.0, 3.0, 32.0, 1.5, col) or >>
    } else if id == ed.id_stage_title {
        $ttl := tr(ed.lang, "Top · XZ", "俯视 · XZ")
        if bounds.width >= 130.0 {
            ttl = tr(ed.lang, "Top View · XZ", "俯视图 · XZ")
            if ed.top_view.axis_mode == STAGE_XY { ttl = tr(ed.lang, "Front View · XY", "正视图 · XY") }
        } else {
            if ed.top_view.axis_mode == STAGE_XY { ttl = tr(ed.lang, "Top · XY", "正视 · XY") }
        }
        frame.text(2.0, 5.0, 13.0, ed.pal.text, &ttl) or >>
    } else if id == ed.id_stage_axis_btn {
        b := ed.stage_axis_btn.clone()
        b.paint_styled(frame, $&ed.stage_axis_lbl, styles) or >>
    } else if id == ed.id_stage_snap_btn {
        b := ed.stage_snap_btn.clone()
        paint_icon_button(&b, $&ed.empty_lbl, ICON_GRID_SNAP, frame, styles) or >>
    } else if id == ed.id_fit_btn {
        b := ed.fit_btn.clone()
        paint_icon_button(&b, $&ed.empty_lbl, ICON_FIT, frame, styles) or >>
    } else if id == ed.id_view3d_btn {
        b := ed.view3d_btn.clone()
        paint_icon_button(&b, $&ed.empty_lbl, ICON_VIEW3D, frame, styles) or >>
    } else if id == ed.id_snap_btn {
        b := ed.snap_btn.clone()
        paint_icon_button(&b, $&ed.empty_lbl, ICON_SLIDERS, frame, styles) or >>
    } else if id == ed.id_top_view {
        ctx := ed.context.clone()
        pts := clone_stage_points(&ed.stage_pts)
        sel_n := ed.selected_node
        $sel_list := []int{}
        for k in 0:ed.selected_nodes.len { sel_list.push(ed.selected_nodes[k]) }
        placing := ed.placing_mode
        pal := ed.pal
        lang_v := ed.lang
        paint_top_view($&ed.top_view, &ctx, frame, bounds, &pts, sel_n, &sel_list, placing, &pal, lang_v) or >>
    } else if id == ed.id_right_pane {
        frame.fill_rect(0.0, 0.0, bounds.width, bounds.height, ed.pal.surface) or >>
    } else if id == ed.id_insp_hdr {
        paint_text_sel($&ed.insp_hdr_txt, frame, styles) or >>
    } else if id == ed.id_insp_scroll {
        frame.fill_rect(0.0, 0.0, bounds.width, bounds.height, ed.pal.surface) or >>
    } else if id == ed.id_name_field {
        paint_field($&ed.name_field, frame, styles) or >>
    } else if id == ed.id_visible_chk {
        chk := ed.visible_chk.clone()
        chk.paint_styled(frame, $&ed.visible_lbl, styles) or >>
    } else if id == ed.id_process_select {
        prs := ed.process_select.clone()
        prsel := prs.selected()
        if prsel >= 0 && prsel < ed.process_labels.len {
            prs.paint_styled(frame, $&ed.process_labels[prsel], styles) or >>
        } else {
            prs.paint_styled(frame, $&ed.empty_lbl, styles) or >>
        }
    } else if id == ed.id_parent_select {
        ps := ed.parent_select.clone()
        psel := ps.selected()
        if psel >= 0 && psel < ed.parent_labels.len {
            ps.paint_styled(frame, $&ed.parent_labels[psel], styles) or >>
        } else {
            ps.paint_styled(frame, $&ed.root_parent_lbl, styles) or >>
        }
    } else if id == ed.id_reparent_btn {
        b := ed.reparent_btn.clone()
        b.paint_styled(frame, $&ed.reparent_lbl, styles) or >>
    } else if id == ed.id_pos_lbl {
        t := tr(ed.lang, "Position (X / Y / Z)", "位置 (X / Y / Z)")
        frame.text(0.0, 1.0, 11.5, ed.pal.muted, &t) or >>
    } else if id == ed.id_pos_x { paint_field($&ed.pos_x, frame, styles) or >>
    } else if id == ed.id_pos_y { paint_field($&ed.pos_y, frame, styles) or >>
    } else if id == ed.id_pos_z { paint_field($&ed.pos_z, frame, styles) or >>
    } else if id == ed.id_rot_lbl {
        t := tr(ed.lang, "Rotation deg (X / Y / Z)", "旋转角度 (X / Y / Z)")
        frame.text(0.0, 1.0, 11.5, ed.pal.muted, &t) or >>
    } else if id == ed.id_rot_x { paint_field($&ed.rot_x, frame, styles) or >>
    } else if id == ed.id_rot_y { paint_field($&ed.rot_y, frame, styles) or >>
    } else if id == ed.id_rot_z { paint_field($&ed.rot_z, frame, styles) or >>
    } else if id == ed.id_scale_lbl {
        t := tr(ed.lang, "Scale (X / Y / Z)", "缩放 (X / Y / Z)")
        frame.text(0.0, 1.0, 11.5, ed.pal.muted, &t) or >>
    } else if id == ed.id_scale_x { paint_field($&ed.scale_x, frame, styles) or >>
    } else if id == ed.id_scale_y { paint_field($&ed.scale_y, frame, styles) or >>
    } else if id == ed.id_scale_z { paint_field($&ed.scale_z, frame, styles) or >>
    } else if id == ed.id_surf_info {
        paint_text_sel($&ed.surf_info_txt, frame, styles) or >>
    } else if id == ed.id_surf_div {
        ed.surf_div.paint_styled(frame, styles) or >>
    } else if id == ed.id_surf_card_hdr {
        t := tr(ed.lang, "GLB Surface & LOD", "GLB 网格表面与 LOD")
        frame.text(0.0, 2.0, 12.0, ed.pal.text, &t) or >>
    } else if id == ed.id_surf_asset_select {
        ss := ed.surf_asset_select.clone()
        ssel := ss.selected()
        if ssel >= 0 && ssel < ed.surf_asset_labels.len {
            ss.paint_styled(frame, $&ed.surf_asset_labels[ssel], styles) or >>
        } else {
            ss.paint_styled(frame, $&ed.no_asset_lbl, styles) or >>
        }
    } else if id == ed.id_surf_prim_field {
        paint_field($&ed.surf_prim_field, frame, styles) or >>
    } else if id == ed.id_surf_bind_btn {
        b := ed.surf_bind_btn.clone()
        b.paint_styled(frame, $&ed.surf_bind_lbl, styles) or >>
    } else if id == ed.id_surf_clear_btn {
        b := ed.surf_clear_btn.clone()
        b.paint_styled(frame, $&ed.surf_clear_lbl, styles) or >>
    } else if id == ed.id_lod_info {
        paint_text_sel($&ed.lod_info_txt, frame, styles) or >>
    } else if id == ed.id_lod_hyst_field {
        paint_field($&ed.lod_hyst_field, frame, styles) or >>
    } else if id == ed.id_lod_dist_field {
        paint_field($&ed.lod_dist_field, frame, styles) or >>
    } else if id == ed.id_lod_prim_field {
        paint_field($&ed.lod_prim_field, frame, styles) or >>
    } else if id == ed.id_lod_asset_select {
        ls := ed.lod_asset_select.clone()
        lsel := ls.selected()
        if lsel >= 0 && lsel < ed.lod_asset_labels.len {
            ls.paint_styled(frame, $&ed.lod_asset_labels[lsel], styles) or >>
        } else {
            ls.paint_styled(frame, $&ed.empty_lbl, styles) or >>
        }
    } else if id == ed.id_lod_add_btn {
        b := ed.lod_add_btn.clone()
        b.paint_styled(frame, $&ed.lod_add_lbl, styles) or >>
    } else if id == ed.id_lod_pop_btn {
        b := ed.lod_pop_btn.clone()
        b.paint_styled(frame, $&ed.lod_pop_lbl, styles) or >>
    } else if id == ed.id_apply_btn {
        b := ed.apply_btn.clone()
        b.paint_styled(frame, $&ed.apply_lbl, styles) or >>
    } else if id == ed.id_footer {
        frame.fill_rect(0.0, 0.0, bounds.width, bounds.height, ed.pal.elevated) or >>
        frame.line(0.0, 0.5, bounds.width, 0.5, ed.pal.border, 1.0) or >>
        hint := tr(ed.lang, "Cmd+S Save · Cmd+Z Undo · Cmd+Shift+Z Redo · F Fit · Esc Cancel", "Cmd+S 保存 · Cmd+Z 撤销 · Cmd+Shift+Z 重做 · F 适配 · Esc 取消")
        if bounds.width >= 900.0 {
            frame.text(bounds.width - 392.0, 6.0, 11.0, ed.pal.muted, &hint) or >>
        }
    } else if id == ed.id_status_txt {
        paint_text_sel($&ed.status_txt, frame, styles) or >>
    } else {
        pal := ed.pal
        drag_sp := ed.dragging_split
        sel_vis := ed.visible_chk.value()
        lang_v := ed.lang
        handled := panels_draw($&ed.panels, id, frame, bounds, styles, &pal, drag_sp, sel_vis) or >>
        if handled == 0 {
            _ := draw_comp_node($&ed.comp, id, frame, styles, &pal, lang_v) or >>
        }
    }
    << 0
}

fn paint_select_popup(sel &widgets.Select, labels $&[]widgets.StyledLabel, origin &layout.Rect, frame $&draw.Frame, styles &widgets.Styles) int {
    if !sel.is_open() { << 0 }
    frame.push() or >>
    frame.translate(origin.x, origin.y) or >>
    sel.paint_popup_box_styled(frame, styles) or (err) {
        _ := frame.pop()
        >> err
    }
    for i in 0:labels.len {
        lbl := $&labels[i]
        sel.paint_option_styled(frame, i, lbl, styles) or (err) {
            _ := frame.pop()
            >> err
        }
    }
    frame.pop() or >>
    << 0
}

pub fn (ed $&Editor) overlay_styled(id int, bounds &layout.Rect, styles &widgets.Styles, frame $&draw.Frame) bool {
    ed.draw_overlay(id, frame, bounds, styles) or (err) {
        _ := err
        << false
    }
    << true
}

fn (ed $&Editor) draw_overlay(id int, frame $&draw.Frame, bounds &layout.Rect, styles &widgets.Styles) int {
    if id == ed.id_insp_scroll {
        sc := $&ed.insp_scroll
        sc.paint_scrollbar(frame, styles) or >>
        << 0
    }
    if id != ed.id_root { << 0 }
    sc_sel := ed.scene_select.clone()
    sc_orig := copy_rect(&ed.scene_origin)
    paint_select_popup(&sc_sel, $&ed.scene_labels, &sc_orig, frame, styles) or >>
    as_sel := ed.asset_select.clone()
    as_orig := copy_rect(&ed.asset_origin)
    paint_select_popup(&as_sel, $&ed.asset_labels, &as_orig, frame, styles) or >>
    pa_sel := ed.parent_select.clone()
    pa_orig := copy_rect(&ed.parent_origin)
    paint_select_popup(&pa_sel, $&ed.parent_labels, &pa_orig, frame, styles) or >>
    pr_sel := ed.process_select.clone()
    pr_orig := copy_rect(&ed.process_origin)
    paint_select_popup(&pr_sel, $&ed.process_labels, &pr_orig, frame, styles) or >>
    sa_sel := ed.surf_asset_select.clone()
    sa_orig := copy_rect(&ed.surf_asset_origin)
    paint_select_popup(&sa_sel, $&ed.surf_asset_labels, &sa_orig, frame, styles) or >>
    la_sel := ed.lod_asset_select.clone()
    la_orig := copy_rect(&ed.lod_asset_origin)
    paint_select_popup(&la_sel, $&ed.lod_asset_labels, &la_orig, frame, styles) or >>
    if ed.tree.has_popup_open() {
        frame.push() or >>
        frame.translate(ed.tree_origin.x, ed.tree_origin.y) or >>
        tr := $&ed.tree
        tr.paint_popup_styled(frame, styles) or (err) {
            _ := frame.pop()
            >> err
        }
        frame.pop() or >>
    }
    field_popup_paint($&ed.prim_field, frame, styles) or >>
    field_popup_paint($&ed.name_field, frame, styles) or >>
    field_popup_paint($&ed.pos_x, frame, styles) or >>
    field_popup_paint($&ed.pos_y, frame, styles) or >>
    field_popup_paint($&ed.pos_z, frame, styles) or >>
    field_popup_paint($&ed.rot_x, frame, styles) or >>
    field_popup_paint($&ed.rot_y, frame, styles) or >>
    field_popup_paint($&ed.rot_z, frame, styles) or >>
    field_popup_paint($&ed.scale_x, frame, styles) or >>
    field_popup_paint($&ed.scale_y, frame, styles) or >>
    field_popup_paint($&ed.scale_z, frame, styles) or >>
    field_popup_paint($&ed.surf_prim_field, frame, styles) or >>
    field_popup_paint($&ed.lod_hyst_field, frame, styles) or >>
    field_popup_paint($&ed.lod_dist_field, frame, styles) or >>
    field_popup_paint($&ed.lod_prim_field, frame, styles) or >>
    paint_text_popup($&ed.asset_meta_txt, frame, styles) or >>
    paint_text_popup($&ed.insp_hdr_txt, frame, styles) or >>
    paint_text_popup($&ed.surf_info_txt, frame, styles) or >>
    paint_text_popup($&ed.lod_info_txt, frame, styles) or >>
    paint_text_popup($&ed.status_txt, frame, styles) or >>
    draw_comp_overlay($&ed.comp, frame, styles) or >>
    panels_overlay($&ed.panels, frame, styles) or >>
    if ed.modals.kind == MODAL_NONE && !ed.any_popup_or_select_open() {
        tip := $&ed.tooltip
        tip.paint(frame, bounds, styles) or >>
    }
    pal := ed.pal
    mods := $&ed.modals
    mods.paint(frame, bounds, styles, &pal) or >>
    << 0
}

// InputHandler contract method (routes node-local inputs from View)
pub fn (ed $&Editor) input(id int, kind int, input &ui.InputEvent) widgets.Action {
    if kind == widgets.ROUTE_FOCUS {
        ed.focused_id = id
    } else if (kind == widgets.ROUTE_BLUR || kind == widgets.ROUTE_CANCEL) && ed.focused_id == id {
        ed.focused_id = 0
    }
    if id == ed.id_scene_select { << route_sel($&ed.scene_select, kind, input) }
    if id == ed.id_new_scene_btn { << route_btn($&ed.new_scene_btn, kind, input) }
    if id == ed.id_globals_btn { << route_btn($&ed.globals_btn, kind, input) }
    if id == ed.id_undo_btn { << route_btn($&ed.undo_btn, kind, input) }
    if id == ed.id_redo_btn { << route_btn($&ed.redo_btn, kind, input) }
    if id == ed.id_save_btn { << route_btn($&ed.save_btn, kind, input) }
    if id == ed.id_preview_btn { << route_btn($&ed.preview_btn, kind, input) }
    if id == ed.id_add_3d_btn { << route_btn($&ed.add_3d_btn, kind, input) }
    if id == ed.id_add_2d_btn { << route_btn($&ed.add_2d_btn, kind, input) }
    if id == ed.id_add_grp_btn { << route_btn($&ed.add_grp_btn, kind, input) }
    if id == ed.id_dup_btn { << route_btn($&ed.dup_btn, kind, input) }
    if id == ed.id_del_btn { << route_btn($&ed.del_btn, kind, input) }
    if id == ed.id_add_cam_btn { << route_btn($&ed.add_cam_btn, kind, input) }
    if id == ed.id_add_lgt_btn { << route_btn($&ed.add_lgt_btn, kind, input) }
    if id == ed.id_tree { << route_tree($&ed.tree, kind, input) }
    if id == ed.id_import_btn { << route_btn($&ed.import_btn, kind, input) }
    if id == ed.id_asset_select { << route_sel($&ed.asset_select, kind, input) }
    if id == ed.id_prim_field { << route_field($&ed.prim_field, kind, input) }
    if id == ed.id_place_btn { << route_btn($&ed.place_btn, kind, input) }
    if id == ed.id_stage_axis_btn { << route_btn($&ed.stage_axis_btn, kind, input) }
    if id == ed.id_stage_snap_btn { << route_btn($&ed.stage_snap_btn, kind, input) }
    if id == ed.id_fit_btn { << route_btn($&ed.fit_btn, kind, input) }
    if id == ed.id_view3d_btn { << route_btn($&ed.view3d_btn, kind, input) }
    if id == ed.id_snap_btn { << route_btn($&ed.snap_btn, kind, input) }
    if id == ed.id_insp_scroll {
        sc := $&ed.insp_scroll
        << sc.route(kind, input)
    }
    if id == ed.id_visible_chk { << route_chk($&ed.visible_chk, kind, input) }
    if id == ed.id_process_select { << route_sel($&ed.process_select, kind, input) }
    if id == ed.id_parent_select { << route_sel($&ed.parent_select, kind, input) }
    if id == ed.id_reparent_btn { << route_btn($&ed.reparent_btn, kind, input) }
    if id == ed.id_surf_asset_select { << route_sel($&ed.surf_asset_select, kind, input) }
    if id == ed.id_surf_prim_field { << route_field($&ed.surf_prim_field, kind, input) }
    if id == ed.id_surf_bind_btn { << route_btn($&ed.surf_bind_btn, kind, input) }
    if id == ed.id_surf_clear_btn { << route_btn($&ed.surf_clear_btn, kind, input) }
    if id == ed.id_lod_info { << route_text($&ed.lod_info_txt, kind, input) }
    if id == ed.id_lod_hyst_field { << route_field($&ed.lod_hyst_field, kind, input) }
    if id == ed.id_lod_dist_field { << route_field($&ed.lod_dist_field, kind, input) }
    if id == ed.id_lod_prim_field { << route_field($&ed.lod_prim_field, kind, input) }
    if id == ed.id_lod_asset_select { << route_sel($&ed.lod_asset_select, kind, input) }
    if id == ed.id_lod_add_btn { << route_btn($&ed.lod_add_btn, kind, input) }
    if id == ed.id_lod_pop_btn { << route_btn($&ed.lod_pop_btn, kind, input) }
    if id == ed.id_apply_btn { << route_btn($&ed.apply_btn, kind, input) }
    if id == ed.id_name_field { << route_field($&ed.name_field, kind, input) }
    if id == ed.id_pos_x { << route_field($&ed.pos_x, kind, input) }
    if id == ed.id_pos_y { << route_field($&ed.pos_y, kind, input) }
    if id == ed.id_pos_z { << route_field($&ed.pos_z, kind, input) }
    if id == ed.id_rot_x { << route_field($&ed.rot_x, kind, input) }
    if id == ed.id_rot_y { << route_field($&ed.rot_y, kind, input) }
    if id == ed.id_rot_z { << route_field($&ed.rot_z, kind, input) }
    if id == ed.id_scale_x { << route_field($&ed.scale_x, kind, input) }
    if id == ed.id_scale_y { << route_field($&ed.scale_y, kind, input) }
    if id == ed.id_scale_z { << route_field($&ed.scale_z, kind, input) }
    if id == ed.id_asset_meta { << route_text($&ed.asset_meta_txt, kind, input) }
    if id == ed.id_insp_hdr { << route_text($&ed.insp_hdr_txt, kind, input) }
    if id == ed.id_surf_info { << route_text($&ed.surf_info_txt, kind, input) }
    if id == ed.id_status_txt { << route_text($&ed.status_txt, kind, input) }

    if id == ed.id_left_split || id == ed.id_right_split || id == ed.panels.id_left_hsplit {
        << ed.route_splitter(id, kind, input)
    }
    if id == ed.id_top_view {
        << ed.route_top_view(kind, input)
    }
    if id == ed.panels.id_open_proj_btn || id == ed.panels.id_scene_mgr_btn || id == ed.panels.id_export_btn || id == ed.panels.id_lang_btn ||
       id == ed.panels.id_node_up_btn || id == ed.panels.id_node_dn_btn || id == ed.panels.id_node_vis_btn ||
       id == ed.panels.id_tree_filter || id == ed.panels.id_asset_prims ||
       id == ed.panels.id_relocate_btn || id == ed.panels.id_remove_asset_btn {
        << panels_route_input($&ed.panels, id, kind, input)
    }
    << route_comp_input($&ed.comp, id, kind, input)
}

fn (ed $&Editor) route_splitter(id int, kind int, input &ui.InputEvent) widgets.Action {
    if kind == widgets.ROUTE_BLUR || kind == widgets.ROUTE_CANCEL {
        was_drag := ed.dragging_split != 0
        ed.dragging_split = 0
        << widgets.Action{kind: widgets.ACTION_NONE, id: id, needs_paint: was_drag, request_focus: false, consumed: false, value: 0.0}
    }
    if kind != widgets.ROUTE_INPUT {
        << widgets.Action{kind: widgets.ACTION_NONE, id: id, needs_paint: false, request_focus: false, consumed: false, value: 0.0}
    }
    $dirty := false
    $consumed := false
    if input.kind == ui.EV_POINTER_DOWN && input.button == ui.BUTTON_LEFT {
        if id == ed.id_left_split {
            ed.dragging_split = 1
            ed.split_orig_w = ed.left_w
            ed.split_start_gx = ed.left_w + input.x
        } else if id == ed.id_right_split {
            ed.dragging_split = 2
            ed.split_orig_w = ed.right_w
            ed.split_start_gx = (ed.viewport_w - ed.right_w - f64(SPLITTER_W)) + input.x
        } else {
            ed.dragging_split = 3
            ed.panels.split_orig_tree_h = ed.panels.last_tree_h
            ed.panels.split_start_gy = ed.panels.hsplit_y + input.y
        }
        consumed = true
        dirty = true
    } else if input.kind == ui.EV_POINTER_MOVE && ed.dragging_split != 0 {
        if ed.dragging_split == 1 && id == ed.id_left_split {
            cur_gx := ed.left_w + input.x
            ed.left_w = ed.split_orig_w + (cur_gx - ed.split_start_gx)
            ed.clamp_widths(ed.viewport_w)
            consumed = true
            dirty = true
        } else if ed.dragging_split == 2 && id == ed.id_right_split {
            cur_gx := (ed.viewport_w - ed.right_w - f64(SPLITTER_W)) + input.x
            ed.right_w = ed.split_orig_w - (cur_gx - ed.split_start_gx)
            ed.clamp_widths(ed.viewport_w)
            consumed = true
            dirty = true
        } else if ed.dragging_split == 3 && id == ed.panels.id_left_hsplit {
            cur_gy := ed.panels.hsplit_y + input.y
            avail := math.max(106.0, ed.panels.avail_flex)
            max_t := math.max(84.0, avail - 22.0)
            $next_t := ed.panels.split_orig_tree_h + (cur_gy - ed.panels.split_start_gy)
            if next_t < 84.0 { next_t = 84.0 }
            if next_t > max_t { next_t = max_t }
            ed.panels.left_tree_ratio = next_t / avail
            consumed = true
            dirty = true
        }
    } else if (input.kind == ui.EV_POINTER_UP && input.button == ui.BUTTON_LEFT) || input.kind == ui.EV_POINTER_CANCEL {
        if ed.dragging_split != 0 {
            ed.dragging_split = 0
            consumed = true
            dirty = true
        }
    }
    $kind := widgets.ACTION_NONE
    if dirty && ed.dragging_split != 0 { kind = widgets.ACTION_CHANGE }
    << widgets.Action{kind: kind, id: id, needs_paint: dirty, request_focus: false, consumed: consumed, value: 0.0}
}

fn (ed $&Editor) route_top_view(kind int, input &ui.InputEvent) widgets.Action {
    if kind == widgets.ROUTE_BLUR || kind == widgets.ROUTE_CANCEL {
        was_active := ed.top_view.panning || ed.top_view.dragging_nodes || ed.top_view.drag_pending || ed.top_view.marquee_active
        tv := $&ed.top_view
        tv.end_pan()
        tv.cancel_node_interactions()
        ed.top_pressed_hit = -1
        ed.top_pressed_shift = false
        << widgets.Action{kind: widgets.ACTION_NONE, id: ed.id_top_view, needs_paint: was_active, request_focus: false, consumed: false, value: 0.0}
    }
    if kind != widgets.ROUTE_INPUT {
        << widgets.Action{kind: widgets.ACTION_NONE, id: ed.id_top_view, needs_paint: false, request_focus: false, consumed: false, value: 0.0}
    }
    $dirty := false
    $consumed := false
    $act_kind := widgets.ACTION_NONE
    $picked := -1.0
    if input.kind == ui.EV_POINTER_SCROLL {
        tv_rect := copy_rect(&ed.top_view_local)
        tv := $&ed.top_view
        tv.zoom_around(&tv_rect, input.x, input.y, input.dy)
        dirty = true
        consumed = true
    } else if input.kind == ui.EV_POINTER_DOWN && (input.button == ui.BUTTON_RIGHT || input.button == ui.BUTTON_MIDDLE) {
        tv := $&ed.top_view
        tv.cancel_node_interactions()
        tv.begin_pan(input.x, input.y)
        dirty = true
        consumed = true
    } else if input.kind == ui.EV_POINTER_MOVE {
        if ed.top_view.panning {
            tv := $&ed.top_view
            tv.update_pan(input.x, input.y)
            dirty = true
            consumed = true
        } else if ed.top_view.drag_pending || ed.top_view.dragging_nodes {
            dx_px := input.x - ed.top_view.drag_start_sx
            dy_px := input.y - ed.top_view.drag_start_sy
            if !ed.top_view.dragging_nodes && dx_px * dx_px + dy_px * dy_px >= 16.0 {
                ed.top_view.dragging_nodes = true
            }
            if ed.top_view.dragging_nodes {
                raw_dx := screen_to_world_x(&ed.top_view, &ed.top_view_local, input.x) -
                    screen_to_world_x(&ed.top_view, &ed.top_view_local, ed.top_view.drag_start_sx)
                raw_dv := screen_to_world_z(&ed.top_view, &ed.top_view_local, input.y) -
                    screen_to_world_z(&ed.top_view, &ed.top_view_local, ed.top_view.drag_start_sy)
                if ed.top_snap_enabled && ed.snap.move_step > 0.0 {
                    ed.top_view.drag_dx = snap_coord(raw_dx, ed.snap.move_step)
                    ed.top_view.drag_dv = snap_coord(raw_dv, ed.snap.move_step)
                } else {
                    ed.top_view.drag_dx = raw_dx
                    ed.top_view.drag_dv = raw_dv
                }
            }
            dirty = true
            consumed = true
        } else if ed.top_view.marquee_active {
            ed.top_view.marquee_cur_sx = input.x
            ed.top_view.marquee_cur_sy = input.y
            dirty = true
            consumed = true
        } else if ed.placing_mode {
            ed.top_view.hover_x = screen_to_world_x(&ed.top_view, &ed.top_view_local, input.x)
            ed.top_view.hover_z = screen_to_world_z(&ed.top_view, &ed.top_view_local, input.y)
            ed.top_view.has_hover = true
            if ed.top_view.hover_node >= 0 { ed.top_view.hover_node = -1 }
            dirty = true
        } else {
            hovered := pick_stage_node(&ed.top_view, &ed.top_view_local, &ed.stage_pts, input.x, input.y)
            if hovered != ed.top_view.hover_node {
                ed.top_view.hover_node = hovered
                dirty = true
            }
        }
    } else if input.kind == ui.EV_POINTER_UP && (input.button == ui.BUTTON_RIGHT || input.button == ui.BUTTON_MIDDLE) {
        if ed.top_view.panning {
            tv := $&ed.top_view
            tv.end_pan()
            dirty = true
            consumed = true
        }
    } else if input.kind == ui.EV_POINTER_UP && input.button == ui.BUTTON_LEFT {
        if ed.top_view.dragging_nodes {
            ed.top_commit_dx = ed.top_view.drag_dx
            ed.top_commit_dv = ed.top_view.drag_dv
            tv := $&ed.top_view
            tv.cancel_node_interactions()
            ed.top_pressed_hit = -1
            act_kind = widgets.ACTION_CHANGE
            picked = 1.0
            dirty = true
            consumed = true
        } else if ed.top_view.drag_pending {
            hit_id := ed.top_pressed_hit
            had_multi := ed.selected_nodes.len > 1 && !ed.top_pressed_shift
            tv := $&ed.top_view
            tv.cancel_node_interactions()
            ed.top_pressed_hit = -1
            if had_multi && hit_id >= 0 {
                ed.top_pressed_shift = false
                picked = f64(hit_id)
                act_kind = widgets.ACTION_ACTIVATE
                dirty = true
            }
            consumed = true
        } else if ed.top_view.marquee_active {
            ed.top_marquee_x0 = ed.top_view.marquee_start_sx
            ed.top_marquee_y0 = ed.top_view.marquee_start_sy
            ed.top_marquee_x1 = ed.top_view.marquee_cur_sx
            ed.top_marquee_y1 = ed.top_view.marquee_cur_sy
            tv := $&ed.top_view
            tv.cancel_node_interactions()
            act_kind = widgets.ACTION_CHANGE
            picked = 2.0
            dirty = true
            consumed = true
        }
    } else if input.kind == ui.EV_POINTER_LEAVE || input.kind == ui.EV_POINTER_CANCEL {
        if ed.top_view.hover_node >= 0 || ed.top_view.has_hover {
            ed.top_view.hover_node = -1
            ed.top_view.has_hover = false
            dirty = true
        }
        if input.kind == ui.EV_POINTER_CANCEL {
            tv := $&ed.top_view
            tv.end_pan()
            tv.cancel_node_interactions()
            ed.top_pressed_hit = -1
            dirty = true
        }
    } else if input.kind == ui.EV_POINTER_DOWN && input.button == ui.BUTTON_LEFT {
        if ed.placing_mode {
            wx := screen_to_world_x(&ed.top_view, &ed.top_view_local, input.x)
            wz := screen_to_world_z(&ed.top_view, &ed.top_view_local, input.y)
            ed.top_view.hover_x = wx
            ed.top_view.hover_z = wz
            ed.top_view.has_hover = true
            act_kind = widgets.ACTION_COMMIT
            consumed = true
            dirty = true
        } else {
            hit := pick_stage_node(&ed.top_view, &ed.top_view_local, &ed.stage_pts, input.x, input.y)
            shift := (input.modifiers & (ui.MOD_SHIFT | ui.MOD_META | ui.MOD_CONTROL)) != 0
            ed.top_pressed_shift = shift
            if hit >= 0 {
                ed.top_pressed_hit = hit
                already_multi := !shift && ed.selected_nodes.len > 1 && is_selected_node(&ed.selected_nodes, hit)
                if !already_multi {
                    picked = f64(hit)
                    act_kind = widgets.ACTION_ACTIVATE
                }
                if hit > 0 {
                    ed.top_view.drag_pending = true
                    ed.top_view.dragging_nodes = false
                    ed.top_view.drag_start_sx = input.x
                    ed.top_view.drag_start_sy = input.y
                    ed.top_view.drag_dx = 0.0
                    ed.top_view.drag_dv = 0.0
                }
                dirty = true
            } else {
                ed.top_pressed_hit = -1
                ed.top_view.marquee_active = true
                ed.top_view.marquee_start_sx = input.x
                ed.top_view.marquee_start_sy = input.y
                ed.top_view.marquee_cur_sx = input.x
                ed.top_view.marquee_cur_sy = input.y
                dirty = true
            }
            consumed = true
        }
    }
    << widgets.Action{kind: act_kind, id: ed.id_top_view, needs_paint: dirty, request_focus: true, consumed: consumed, value: picked}
}

fn (ed &Editor) any_text_field_focused() bool {
    << ed.name_field.is_focused() || ed.prim_field.is_focused() ||
        ed.pos_x.is_focused() || ed.pos_y.is_focused() || ed.pos_z.is_focused() ||
        ed.rot_x.is_focused() || ed.rot_y.is_focused() || ed.rot_z.is_focused() ||
        ed.scale_x.is_focused() || ed.scale_y.is_focused() || ed.scale_z.is_focused() ||
        ed.surf_prim_field.is_focused() || ed.lod_hyst_field.is_focused() ||
        ed.lod_dist_field.is_focused() || ed.lod_prim_field.is_focused() ||
        comp_any_focused(&ed.comp) || panels_any_focused(&ed.panels)
}

pub fn (ed $&Editor) close_all_selects() {
    set_sel_open($&ed.scene_select, false)
    set_sel_open($&ed.asset_select, false)
    set_sel_open($&ed.parent_select, false)
    set_sel_open($&ed.process_select, false)
    set_sel_open($&ed.surf_asset_select, false)
    set_sel_open($&ed.lod_asset_select, false)
    comp_close_selects($&ed.comp)
}

fn (ed $&Editor) handle_modal_input(input &ui.InputEvent, view $&widgets.View) bool {
    if ed.modals.kind == MODAL_NONE { << false }
    if input.kind == ui.EV_KEY_DOWN && input.repeat == 0 {
        if input.key == ui.KEY_ESCAPE && !ed.modals.has_popup_open() {
            modal_close($&ed.modals)
            ed.apply_pointer_cursor(view)
            repaint(view, ed.id_root)
            << true
        }
        if ed.modals.kind == MODAL_SNAP {
            if input.key == ui.KEY_TAB {
                order := [ID_MODAL_MOVE, ID_MODAL_ROTATE, ID_MODAL_SCALE, ID_MODAL_SNAP_CANCEL, ID_MODAL_SNAP_SAVE]
                $next := order[0]
                for i in 0:order.len {
                    if order[i] == ed.modals.focused_id {
                        $pos := i + 1
                        if pos >= order.len { pos = 0 }
                        next = order[pos]
                    }
                }
                modal_set_focus($&ed.modals, next)
                repaint(view, ed.id_root)
                << true
            }
            if input.key == ui.KEY_ENTER && !ed.modals.has_popup_open() && ed.modals.focused_id != ID_MODAL_SNAP_CANCEL {
                ed.submit_snap_modal(view)
                ed.apply_pointer_cursor(view)
                << true
            }
        } else if ed.modals.kind == MODAL_NEW_SCENE {
            if input.key == ui.KEY_TAB {
                order := [ID_MODAL_SCENE_NAME, ID_MODAL_SCENE_ROOT, ID_MODAL_SCENE_CANCEL, ID_MODAL_SCENE_CREATE]
                $next := order[0]
                for i in 0:order.len {
                    if order[i] == ed.modals.focused_id {
                        $pos := i + 1
                        if pos >= order.len { pos = 0 }
                        next = order[pos]
                    }
                }
                modal_set_focus($&ed.modals, next)
                repaint(view, ed.id_root)
                << true
            }
            if input.key == ui.KEY_ENTER && !ed.modals.has_popup_open() && ed.modals.focused_id != ID_MODAL_SCENE_CANCEL {
                ed.submit_new_scene_modal(view)
                ed.apply_pointer_cursor(view)
                << true
            }
        } else if ed.modals.kind == MODAL_GLOBALS {
            if input.key == ui.KEY_TAB {
                order := [ID_MODAL_BUS_NAME, ID_MODAL_BUS_VOL, ID_MODAL_BUS_ADD, ID_MODAL_BUS_MUTE, ID_MODAL_BUS_DEL, ID_MODAL_CONN_SRC, ID_MODAL_CONN_SIG, ID_MODAL_CONN_DST, ID_MODAL_CONN_HND, ID_MODAL_CONN_ADD, ID_MODAL_CONN_DEL, ID_MODAL_GLOBALS_CLOSE]
                $next := order[0]
                for i in 0:order.len {
                    if order[i] == ed.modals.focused_id {
                        $pos := i + 1
                        if pos >= order.len { pos = 0 }
                        next = order[pos]
                    }
                }
                modal_set_focus($&ed.modals, next)
                repaint(view, ed.id_root)
                << true
            }
            if input.key == ui.KEY_ENTER && !ed.modals.has_popup_open() {
                fid := ed.modals.focused_id
                if fid == ID_MODAL_GLOBALS_CLOSE { ed.handle_globals_modal_action(1, view) }
                else if fid == ID_MODAL_BUS_NAME || fid == ID_MODAL_BUS_VOL || fid == ID_MODAL_BUS_ADD { ed.handle_globals_modal_action(2, view) }
                else if fid == ID_MODAL_BUS_MUTE { ed.handle_globals_modal_action(3, view) }
                else if fid == ID_MODAL_BUS_DEL { ed.handle_globals_modal_action(4, view) }
                else if fid == ID_MODAL_CONN_DEL { ed.handle_globals_modal_action(6, view) }
                else { ed.handle_globals_modal_action(5, view) }
                ed.apply_pointer_cursor(view)
                repaint(view, ed.id_root)
                << true
            }
        } else if ed.modals.kind == MODAL_SCENE_MANAGE {
            if input.key == ui.KEY_TAB {
                order := [ID_MODAL_MGR_NAME, ID_MODAL_MGR_RENAME, ID_MODAL_MGR_DUP, ID_MODAL_MGR_DEL, ID_MODAL_MGR_CLOSE]
                $next := order[0]
                for i in 0:order.len {
                    if order[i] == ed.modals.focused_id {
                        $pos := i + 1
                        if pos >= order.len { pos = 0 }
                        next = order[pos]
                    }
                }
                modal_set_focus($&ed.modals, next)
                repaint(view, ed.id_root)
                << true
            }
            if input.key == ui.KEY_ENTER && !ed.modals.has_popup_open() {
                fid := ed.modals.focused_id
                if fid == ID_MODAL_MGR_CLOSE { ed.handle_scene_manage_action(4, view) }
                else if fid == ID_MODAL_MGR_DEL { ed.handle_scene_manage_action(3, view) }
                else if fid == ID_MODAL_MGR_DUP { ed.handle_scene_manage_action(2, view) }
                else { ed.handle_scene_manage_action(1, view) }
                ed.apply_pointer_cursor(view)
                repaint(view, ed.id_root)
                << true
            }
        } else if ed.modals.kind == MODAL_EXPORT {
            if input.key == ui.KEY_TAB {
                order := [ID_MODAL_EXPORT_DIR, ID_MODAL_EXPORT_CANCEL, ID_MODAL_EXPORT_RUN]
                $next := order[0]
                for i in 0:order.len {
                    if order[i] == ed.modals.focused_id {
                        $pos := i + 1
                        if pos >= order.len { pos = 0 }
                        next = order[pos]
                    }
                }
                modal_set_focus($&ed.modals, next)
                repaint(view, ed.id_root)
                << true
            }
            if input.key == ui.KEY_ENTER && !ed.modals.has_popup_open() && ed.modals.focused_id != ID_MODAL_EXPORT_CANCEL {
                ed.submit_export_modal(view)
                ed.apply_pointer_cursor(view)
                << true
            }
        }
    }

    if ed.modals.kind == MODAL_SNAP {
        act := route_snap_modal_widgets($&ed.modals, input)
        if act == 1 { modal_close($&ed.modals) }
        if act == 2 { ed.submit_snap_modal(view) }
        ed.apply_pointer_cursor(view)
        repaint(view, ed.id_root)
        << true
    } else if ed.modals.kind == MODAL_NEW_SCENE {
        act := route_scene_modal_widgets($&ed.modals, input)
        if act == 1 { modal_close($&ed.modals) }
        if act == 2 { ed.submit_new_scene_modal(view) }
        ed.apply_pointer_cursor(view)
        repaint(view, ed.id_root)
        << true
    } else if ed.modals.kind == MODAL_GLOBALS {
        act := route_globals_modal_widgets($&ed.modals, input)
        if act != 0 {
            ed.handle_globals_modal_action(act, view)
        }
        ed.apply_pointer_cursor(view)
        repaint(view, ed.id_root)
        << true
    } else if ed.modals.kind == MODAL_SCENE_MANAGE {
        act := route_scene_manage_widgets($&ed.modals, input)
        if act != 0 {
            ed.handle_scene_manage_action(act, view)
        }
        ed.apply_pointer_cursor(view)
        repaint(view, ed.id_root)
        << true
    } else if ed.modals.kind == MODAL_EXPORT {
        act := route_export_widgets($&ed.modals, input)
        if act == 1 { modal_close($&ed.modals) }
        if act == 2 { ed.submit_export_modal(view) }
        ed.apply_pointer_cursor(view)
        repaint(view, ed.id_root)
        << true
    } else if ed.modals.kind == MODAL_UNSAVED {
        act := route_unsaved_modal_widgets($&ed.modals, input)
        target := ed.modals.unsaved_target_scene
        close_after := ed.modals.unsaved_close_after
        open_proj_after := ed.modals.unsaved_open_project_after
        if act == 1 {
            modal_close($&ed.modals)
        } else if act == 2 {
            modal_close($&ed.modals)
            if close_after { ed.close_pending = true }
            else if open_proj_after { ed.req_open_project = true }
            else { ed.switch_scene(target, false, view) }
        } else if act == 3 {
            if ed.do_save(view) {
                modal_close($&ed.modals)
                if close_after { ed.close_pending = true }
                else if open_proj_after { ed.req_open_project = true }
                else { ed.switch_scene(target, false, view) }
            }
        }
        ed.apply_pointer_cursor(view)
        repaint(view, ed.id_root)
        << true
    }
    << true
}

fn route_snap_modal_widgets(m $&ModalState, input &ui.InputEvent) int {
    if m.fields[MF_SNAP_MOVE].has_popup_open() { _ := route_modal_field($&m.fields[MF_SNAP_MOVE], input)
        << 0 }
    if m.fields[MF_SNAP_ROTATE].has_popup_open() { _ := route_modal_field($&m.fields[MF_SNAP_ROTATE], input)
        << 0 }
    if m.fields[MF_SNAP_SCALE].has_popup_open() { _ := route_modal_field($&m.fields[MF_SNAP_SCALE], input)
        << 0 }
    a1 := route_modal_field($&m.fields[MF_SNAP_MOVE], input)
    a2 := route_modal_field($&m.fields[MF_SNAP_ROTATE], input)
    a3 := route_modal_field($&m.fields[MF_SNAP_SCALE], input)
    a4 := input_btn($&m.buttons[MB_SNAP_CANCEL], input)
    a5 := input_btn($&m.buttons[MB_SNAP_SAVE], input)
    if a1.kind == widgets.ACTION_CHANGE && m.snap_move_err.len > 0 { m.snap_move_err = ""
        m.sync_snap_decorations() }
    if a2.kind == widgets.ACTION_CHANGE && m.snap_rotate_err.len > 0 { m.snap_rotate_err = ""
        m.sync_snap_decorations() }
    if a3.kind == widgets.ACTION_CHANGE && m.snap_scale_err.len > 0 { m.snap_scale_err = ""
        m.sync_snap_decorations() }
    if a1.request_focus { m.set_focus(ID_MODAL_MOVE) }
    else if a2.request_focus { m.set_focus(ID_MODAL_ROTATE) }
    else if a3.request_focus { m.set_focus(ID_MODAL_SCALE) }
    else if a4.request_focus { m.set_focus(ID_MODAL_SNAP_CANCEL) }
    else if a5.request_focus { m.set_focus(ID_MODAL_SNAP_SAVE) }
    if a4.kind == widgets.ACTION_ACTIVATE { << 1 }
    if a5.kind == widgets.ACTION_ACTIVATE { << 2 }
    << 0
}

fn route_scene_modal_widgets(m $&ModalState, input &ui.InputEvent) int {
    if m.fields[MF_SCENE_NAME].has_popup_open() { _ := route_modal_field($&m.fields[MF_SCENE_NAME], input)
        << 0 }
    if m.fields[MF_SCENE_ROOT].has_popup_open() { _ := route_modal_field($&m.fields[MF_SCENE_ROOT], input)
        << 0 }
    a1 := route_modal_field($&m.fields[MF_SCENE_NAME], input)
    a2 := route_modal_field($&m.fields[MF_SCENE_ROOT], input)
    a3 := input_btn($&m.buttons[MB_SCENE_CANCEL], input)
    a4 := input_btn($&m.buttons[MB_SCENE_CREATE], input)
    if a1.kind == widgets.ACTION_CHANGE && m.scene_err.len > 0 { m.scene_err = ""
        m.sync_scene_decoration() }
    if a1.request_focus { m.set_focus(ID_MODAL_SCENE_NAME) }
    else if a2.request_focus { m.set_focus(ID_MODAL_SCENE_ROOT) }
    else if a3.request_focus { m.set_focus(ID_MODAL_SCENE_CANCEL) }
    else if a4.request_focus { m.set_focus(ID_MODAL_SCENE_CREATE) }
    if a3.kind == widgets.ACTION_ACTIVATE { << 1 }
    if a4.kind == widgets.ACTION_ACTIVATE { << 2 }
    << 0
}

fn route_unsaved_modal_widgets(m $&ModalState, input &ui.InputEvent) int {
    a1 := input_btn($&m.buttons[MB_UNSAVED_CANCEL], input)
    a2 := input_btn($&m.buttons[MB_UNSAVED_DISCARD], input)
    a3 := input_btn($&m.buttons[MB_UNSAVED_SAVE], input)
    if a1.kind == widgets.ACTION_ACTIVATE { << 1 }
    if a2.kind == widgets.ACTION_ACTIVATE { << 2 }
    if a3.kind == widgets.ACTION_ACTIVATE { << 3 }
    << 0
}

fn route_globals_modal_widgets(m $&ModalState, input &ui.InputEvent) int {
    for i in MF_BUS_NAME:(MF_CONN_HND + 1) {
        if m.fields[i].has_popup_open() {
            _ := route_modal_field($&m.fields[i], input)
            << 0
        }
    }

    a1 := route_modal_field($&m.fields[MF_BUS_NAME], input)
    a2 := route_modal_field($&m.fields[MF_BUS_VOL], input)
    a3 := route_modal_field($&m.fields[MF_CONN_SRC], input)
    a4 := route_modal_field($&m.fields[MF_CONN_SIG], input)
    a5 := route_modal_field($&m.fields[MF_CONN_DST], input)
    a6 := route_modal_field($&m.fields[MF_CONN_HND], input)
    b1 := input_btn($&m.buttons[MB_BUS_ADD], input)
    b2 := input_btn($&m.buttons[MB_BUS_MUTE], input)
    b3 := input_btn($&m.buttons[MB_BUS_DEL], input)
    b4 := input_btn($&m.buttons[MB_CONN_ADD], input)
    b5 := input_btn($&m.buttons[MB_CONN_DEL], input)
    b6 := input_btn($&m.buttons[MB_GLOBALS_CLOSE], input)

    if (a1.kind == widgets.ACTION_CHANGE || a2.kind == widgets.ACTION_CHANGE ||
        a3.kind == widgets.ACTION_CHANGE || a4.kind == widgets.ACTION_CHANGE ||
        a5.kind == widgets.ACTION_CHANGE || a6.kind == widgets.ACTION_CHANGE) && m.globals_err.len > 0 {
        m.globals_err = ""
    }
    if a1.request_focus { m.set_focus(ID_MODAL_BUS_NAME) }
    else if a2.request_focus { m.set_focus(ID_MODAL_BUS_VOL) }
    else if a3.request_focus { m.set_focus(ID_MODAL_CONN_SRC) }
    else if a4.request_focus { m.set_focus(ID_MODAL_CONN_SIG) }
    else if a5.request_focus { m.set_focus(ID_MODAL_CONN_DST) }
    else if a6.request_focus { m.set_focus(ID_MODAL_CONN_HND) }
    else if b1.request_focus { m.set_focus(ID_MODAL_BUS_ADD) }
    else if b2.request_focus { m.set_focus(ID_MODAL_BUS_MUTE) }
    else if b3.request_focus { m.set_focus(ID_MODAL_BUS_DEL) }
    else if b4.request_focus { m.set_focus(ID_MODAL_CONN_ADD) }
    else if b5.request_focus { m.set_focus(ID_MODAL_CONN_DEL) }
    else if b6.request_focus { m.set_focus(ID_MODAL_GLOBALS_CLOSE) }

    if b6.kind == widgets.ACTION_ACTIVATE { << 1 }
    if b1.kind == widgets.ACTION_ACTIVATE { << 2 }
    if b2.kind == widgets.ACTION_ACTIVATE { << 3 }
    if b3.kind == widgets.ACTION_ACTIVATE { << 4 }
    if b4.kind == widgets.ACTION_ACTIVATE { << 5 }
    if b5.kind == widgets.ACTION_ACTIVATE { << 6 }
    << 0
}

fn draft_add_bus(ed $&Editor, parent int, name string, vol f64) int {
    d := $&ed.draft
    << d.add_audio_bus(parent, name, vol, false, false) or >>
}
fn draft_mute_bus(ed $&Editor, idx int) int {
    d := $&ed.draft
    << d.toggle_audio_bus_mute(idx) or >>
}
fn draft_del_bus(ed $&Editor, idx int) int {
    d := $&ed.draft
    << d.remove_audio_bus(idx) or >>
}
fn draft_add_conn(ed $&Editor, src int, sig int, dst int, hnd int) int {
    d := $&ed.draft
    << d.add_script_connection(src, sig, dst, hnd) or >>
}
fn draft_del_conn(ed $&Editor, idx int) int {
    d := $&ed.draft
    << d.remove_script_connection(idx) or >>
}

fn (ed $&Editor) set_globals_err(msg string, view $&widgets.View) {
    mods := $&ed.modals
    mods.globals_err = msg + ""
    ed.set_status(STATUS_ERR, msg, view)
}

fn (ed $&Editor) handle_globals_modal_action(act int, view $&widgets.View) {
    if act == 0 { << }
    if act == 1 {
        modal_close($&ed.modals)
        <<
    }
    if act == 2 {
        name := ed.modals.fields[MF_BUS_NAME].value()
        vol := parse_f64_or(&ed.modals.fields[MF_BUS_VOL].value(), "Bus Volume") or (err) {
            ed.set_globals_err(err.msg(), view)
            <<
        }
        _ := draft_add_bus(ed, 0, name, vol) or (err) {
            ed.set_globals_err(err.msg(), view)
            <<
        }
    } else if act == 3 {
        doc := ed.draft.document() or (err) {
            ed.set_globals_err(err.msg(), view)
            <<
        }
        cnt := doc.audio_bus_count()
        if cnt <= 0 {
            ed.set_globals_err("No audio buses in scene", view)
            <<
        }
        _ := draft_mute_bus(ed, cnt - 1) or (err) {
            ed.set_globals_err(err.msg(), view)
            <<
        }
    } else if act == 4 {
        doc := ed.draft.document() or (err) {
            ed.set_globals_err(err.msg(), view)
            <<
        }
        cnt := doc.audio_bus_count()
        if cnt <= 1 {
            ed.set_globals_err("No sub-bus to remove (Master bus kept)", view)
            <<
        }
        _ := draft_del_bus(ed, cnt - 1) or (err) {
            ed.set_globals_err(err.msg(), view)
            <<
        }
    } else if act == 5 {
        src_s := strings.trim_space(&ed.modals.fields[MF_CONN_SRC].value())
        sig_s := strings.trim_space(&ed.modals.fields[MF_CONN_SIG].value())
        dst_s := strings.trim_space(&ed.modals.fields[MF_CONN_DST].value())
        hnd_s := strings.trim_space(&ed.modals.fields[MF_CONN_HND].value())
        src := strconv.atoi(&src_s) or (err) {
            _ := err
            ed.set_globals_err("SrcIdx must be integer", view)
            <<
        }
        sig := strconv.atoi(&sig_s) or (err) {
            _ := err
            ed.set_globals_err("Signal must be integer", view)
            <<
        }
        dst := strconv.atoi(&dst_s) or (err) {
            _ := err
            ed.set_globals_err("DstIdx must be integer", view)
            <<
        }
        hnd := strconv.atoi(&hnd_s) or (err) {
            _ := err
            ed.set_globals_err("Handler must be integer", view)
            <<
        }
        _ := draft_add_conn(ed, src, sig, dst, hnd) or (err) {
            ed.set_globals_err(err.msg(), view)
            <<
        }
    } else if act == 6 {
        doc := ed.draft.document() or (err) {
            ed.set_globals_err(err.msg(), view)
            <<
        }
        cnt := doc.script_connection_count()
        if cnt <= 0 {
            ed.set_globals_err("No script route to remove", view)
            <<
        }
        _ := draft_del_conn(ed, cnt - 1) or (err) {
            ed.set_globals_err(err.msg(), view)
            <<
        }
    }
    ed.refresh_after_document_change(false, view)
    doc_after := ed.draft.document() or (err) { << }
    mods := $&ed.modals
    mods.globals_err = ""
    mods.sync_globals(&doc_after)
    ed.set_status(STATUS_OK, "Updated scene globals", view)
}

fn route_scene_manage_widgets(m $&ModalState, input &ui.InputEvent) int {
    if m.fields[MF_MGR_NAME].has_popup_open() {
        _ := route_modal_field($&m.fields[MF_MGR_NAME], input)
        << 0
    }
    a1 := route_modal_field($&m.fields[MF_MGR_NAME], input)
    b1 := input_btn($&m.buttons[MB_MGR_RENAME], input)
    b2 := input_btn($&m.buttons[MB_MGR_DUP], input)
    b3 := input_btn($&m.buttons[MB_MGR_DEL], input)
    b4 := input_btn($&m.buttons[MB_MGR_CLOSE], input)
    if a1.kind == widgets.ACTION_CHANGE && m.mgr_err.len > 0 {
        m.mgr_err = ""
        m.sync_mgr_decoration()
    }
    if a1.request_focus { m.set_focus(ID_MODAL_MGR_NAME) }
    else if b1.request_focus { m.set_focus(ID_MODAL_MGR_RENAME) }
    else if b2.request_focus { m.set_focus(ID_MODAL_MGR_DUP) }
    else if b3.request_focus { m.set_focus(ID_MODAL_MGR_DEL) }
    else if b4.request_focus { m.set_focus(ID_MODAL_MGR_CLOSE) }
    if b1.kind == widgets.ACTION_ACTIVATE { << 1 }
    if b2.kind == widgets.ACTION_ACTIVATE { << 2 }
    if b3.kind == widgets.ACTION_ACTIVATE { << 3 }
    if b4.kind == widgets.ACTION_ACTIVATE { << 4 }
    << 0
}

fn route_export_widgets(m $&ModalState, input &ui.InputEvent) int {
    if m.fields[MF_EXPORT_DIR].has_popup_open() {
        _ := route_modal_field($&m.fields[MF_EXPORT_DIR], input)
        << 0
    }
    a1 := route_modal_field($&m.fields[MF_EXPORT_DIR], input)
    b1 := input_btn($&m.buttons[MB_EXPORT_CANCEL], input)
    b2 := input_btn($&m.buttons[MB_EXPORT_RUN], input)
    if a1.kind == widgets.ACTION_CHANGE && m.export_err.len > 0 {
        m.export_err = ""
        m.sync_export_decoration()
    }
    if a1.request_focus { m.set_focus(ID_MODAL_EXPORT_DIR) }
    else if b1.request_focus { m.set_focus(ID_MODAL_EXPORT_CANCEL) }
    else if b2.request_focus { m.set_focus(ID_MODAL_EXPORT_RUN) }
    if b1.kind == widgets.ACTION_ACTIVATE { << 1 }
    if b2.kind == widgets.ACTION_ACTIVATE { << 2 }
    << 0
}

fn (ed $&Editor) set_mgr_err(msg string, view $&widgets.View) {
    mods := $&ed.modals
    mods.mgr_err = msg + ""
    mods.sync_mgr_decoration()
    ed.set_status(STATUS_ERR, msg, view)
}

fn (ed $&Editor) handle_scene_manage_action(act int, view $&widgets.View) {
    if act == 0 { << }
    if act == 4 {
        modal_close($&ed.modals)
        <<
    }
    if ed.scene_index < 0 || ed.scene_index >= ed.project.scenes.len { << }
    cur_key := ed.project.scenes[ed.scene_index].key + ""
    proj_path := ed.project.path + ""
    raw_name := ed.modals.fields[MF_MGR_NAME].value()
    if act == 1 {
        if ed.draft.dirty() {
            ed.set_mgr_err("Save scene changes before renaming", view)
            <<
        }
        new_key := rename_scene(&proj_path, &cur_key, &raw_name) or (err) {
            ed.set_mgr_err(err.msg(), view)
            <<
        }
        reloaded := load_project(proj_path) or (err) {
            ed.set_mgr_err(err.msg(), view)
            <<
        }
        ed.project = reloaded
        $next_idx := 0
        for i in 0:ed.project.scenes.len {
            if ed.project.scenes[i].key == new_key { next_idx = i }
        }
        new_path := ed.project.scene_source(next_idx) or (err) {
            ed.set_mgr_err(err.msg(), view)
            <<
        }
        next_draft := open_draft(new_path) or (err) {
            ed.set_mgr_err(err.msg(), view)
            <<
        }
        ed.scene_index = next_idx
        ed.draft = next_draft
        modal_close($&ed.modals)
        ed.refresh_project_selectors()
        ed.refresh_after_document_change(false, view)
        ed.set_status(STATUS_OK, "Renamed scene to " + new_key, view)
        <<
    }
    if act == 2 {
        dup_key := duplicate_scene(&proj_path, &cur_key, &raw_name) or (err) {
            ed.set_mgr_err(err.msg(), view)
            <<
        }
        reloaded := load_project(proj_path) or (err) {
            ed.set_mgr_err(err.msg(), view)
            <<
        }
        ed.project = reloaded
        modal_close($&ed.modals)
        ed.refresh_project_selectors()
        repaint(view, ed.id_toolbar)
        ed.set_status(STATUS_OK, "Duplicated scene as " + dup_key, view)
        <<
    }
    if act == 3 {
        if ed.project.scenes.len <= 1 {
            ed.set_mgr_err("Cannot delete the last scene", view)
            <<
        }
        _ := delete_scene(&proj_path, &cur_key) or (err) {
            ed.set_mgr_err(err.msg(), view)
            <<
        }
        reloaded := load_project(proj_path) or (err) {
            ed.set_mgr_err(err.msg(), view)
            <<
        }
        ed.project = reloaded
        modal_close($&ed.modals)
        ed.refresh_project_selectors()
        ed.scene_index = -1
        ed.switch_scene(0, false, view)
        ed.set_status(STATUS_OK, "Deleted scene " + cur_key, view)
        <<
    }
}

pub fn (ed $&Editor) submit_export_modal(view $&widgets.View) {
    out_dir := strings.trim_space(&ed.modals.fields[MF_EXPORT_DIR].value())
    if out_dir.len == 0 {
        mods := $&ed.modals
        mods.export_err = "Output directory is required"
        mods.sync_export_decoration()
        ed.set_status(STATUS_ERR, "Output directory is required", view)
        repaint(view, ed.id_root)
        <<
    }
    modal_close($&ed.modals)
    ed.export_target_dir = out_dir + ""
    ed.req_export_project = true
    repaint(view, ed.id_root)
}

fn copy_input(input &ui.InputEvent) ui.InputEvent {
    << ui.InputEvent{
        kind: input.kind, window_id: input.window_id, canvas_id: input.canvas_id, generation: input.generation,
        x: input.x, y: input.y, dx: input.dx, dy: input.dy,
        button: input.button, buttons: input.buttons, modifiers: input.modifiers,
        key: input.key, scan: input.scan, repeat: input.repeat, click_count: input.click_count, time_ns: input.time_ns
    }
}

fn route_modal_field(f $&widgets.Field, input &ui.InputEvent) widgets.Action {
    << f.input(input)
}

fn route_open_select(sel $&widgets.Select, origin &layout.Rect, input &ui.InputEvent) widgets.Action {
    $local := copy_input(input)
    if (input.kind >= ui.EV_POINTER_DOWN && input.kind <= ui.EV_POINTER_CANCEL) || input.kind == ui.EV_POINTER_SCROLL {
        local.x = input.x - origin.x
        local.y = input.y - origin.y
    }
    << sel.input(&local)
}

fn is_pointer_event_kind(kind int) bool {
    << kind >= ui.EV_POINTER_DOWN && kind <= ui.EV_POINTER_CANCEL
}

fn node_contains(view &widgets.View, id int, x f64, y f64) bool {
    nb := view.node_bounds(id) or (err) {
        _ := err
        << false
    }
    << nb.contains(x, y)
}

fn node_contains_clipped(view &widgets.View, id int, clip_id int, x f64, y f64) bool {
    << node_contains(view, clip_id, x, y) && node_contains(view, id, x, y)
}

fn field_popup_cursor(f &widgets.Field, x f64, y f64) int {
    if !f.has_popup_open() { << -1 }
    << f.cursor_at(x, y)
}

fn text_popup_cursor(s &widgets.SelectableText, x f64, y f64) int {
    if !s.has_popup_open() { << -1 }
    << s.cursor_at(x, y)
}

fn field_hit_cursor(view &widgets.View, id int, f &widgets.Field, x f64, y f64) int {
    if !node_contains(view, id, x, y) { << -1 }
    << f.cursor_at(x, y)
}

fn field_hit_cursor_clipped(view &widgets.View, id int, clip_id int, f &widgets.Field, x f64, y f64) int {
    if !node_contains_clipped(view, id, clip_id, x, y) { << -1 }
    << f.cursor_at(x, y)
}

fn btn_hit_cursor(view &widgets.View, id int, b &widgets.Button, x f64, y f64) int {
    if !node_contains(view, id, x, y) { << -1 }
    << b.cursor()
}

fn btn_hit_cursor_clipped(view &widgets.View, id int, clip_id int, b &widgets.Button, x f64, y f64) int {
    if !node_contains_clipped(view, id, clip_id, x, y) { << -1 }
    << b.cursor()
}

fn sel_hit_cursor(view &widgets.View, id int, s &widgets.Select, x f64, y f64) int {
    if !node_contains(view, id, x, y) { << -1 }
    << s.cursor()
}

fn sel_hit_cursor_clipped(view &widgets.View, id int, clip_id int, s &widgets.Select, x f64, y f64) int {
    if !node_contains_clipped(view, id, clip_id, x, y) { << -1 }
    << s.cursor()
}

pub fn (ed &Editor) resolve_cursor(view &widgets.View, x f64, y f64) int {
    if ed.modals.kind != MODAL_NONE { << ed.modals.cursor_at(x, y) }
    if ed.scene_select.is_open() {
        << ed.scene_select.cursor_at(x - ed.scene_origin.x, y - ed.scene_origin.y)
    }
    if ed.asset_select.is_open() {
        << ed.asset_select.cursor_at(x - ed.asset_origin.x, y - ed.asset_origin.y)
    }
    if ed.parent_select.is_open() {
        << ed.parent_select.cursor_at(x - ed.parent_origin.x, y - ed.parent_origin.y)
    }
    if ed.process_select.is_open() {
        << ed.process_select.cursor_at(x - ed.process_origin.x, y - ed.process_origin.y)
    }
    if ed.surf_asset_select.is_open() {
        << ed.surf_asset_select.cursor_at(x - ed.surf_asset_origin.x, y - ed.surf_asset_origin.y)
    }
    if ed.lod_asset_select.is_open() {
        << ed.lod_asset_select.cursor_at(x - ed.lod_asset_origin.x, y - ed.lod_asset_origin.y)
    }
    if ed.tree.has_popup_open() {
        << ed.tree.cursor_at(x - ed.tree_origin.x, y - ed.tree_origin.y)
    }
    pcs := [field_popup_cursor(&ed.name_field, x, y), field_popup_cursor(&ed.prim_field, x, y), field_popup_cursor(&ed.pos_x, x, y), field_popup_cursor(&ed.pos_y, x, y), field_popup_cursor(&ed.pos_z, x, y), field_popup_cursor(&ed.rot_x, x, y), field_popup_cursor(&ed.rot_y, x, y), field_popup_cursor(&ed.rot_z, x, y), field_popup_cursor(&ed.scale_x, x, y), field_popup_cursor(&ed.scale_y, x, y), field_popup_cursor(&ed.scale_z, x, y), field_popup_cursor(&ed.surf_prim_field, x, y), field_popup_cursor(&ed.lod_hyst_field, x, y), field_popup_cursor(&ed.lod_dist_field, x, y), field_popup_cursor(&ed.lod_prim_field, x, y), text_popup_cursor(&ed.asset_meta_txt, x, y), text_popup_cursor(&ed.insp_hdr_txt, x, y), text_popup_cursor(&ed.surf_info_txt, x, y), text_popup_cursor(&ed.lod_info_txt, x, y), text_popup_cursor(&ed.status_txt, x, y)]
    for pc in pcs {
        if pc >= 0 { << pc }
    }
    if comp_has_any_popup_open(&ed.comp) {
        ccur := comp_cursor(&ed.comp, view, &ed.styles, x, y)
        if ccur >= 0 { << ccur }
    }
    if panels_has_any_popup(&ed.panels) {
        pcur := panels_cursor(&ed.panels, view, x, y)
        if pcur >= 0 { << pcur }
    }
    if ed.dragging_split == 3 || node_contains(view, ed.panels.id_left_hsplit, x, y) {
        << ui.CURSOR_RESIZE_VERTICAL
    }
    if ed.dragging_split != 0 || node_contains(view, ed.id_left_split, x, y) || node_contains(view, ed.id_right_split, x, y) {
        << ui.CURSOR_RESIZE_HORIZONTAL
    }
    if ed.tree.is_scroll_dragging() || view.captured() == ed.id_tree {
        tcur := ed.tree.cursor_at(x - ed.tree_origin.x, y - ed.tree_origin.y)
        if tcur != ui.CURSOR_DEFAULT { << tcur }
    }
    if ed.insp_scroll.is_dragging() {
        << ui.CURSOR_HAND
    }
    if ed.top_view.marquee_active { << ui.CURSOR_CROSSHAIR }
    if ed.top_view.panning || ed.top_view.dragging_nodes { << ui.CURSOR_HAND }
    p_cur := panels_cursor(&ed.panels, view, x, y)
    if p_cur >= 0 { << p_cur }
    if node_contains(view, ed.id_insp_scroll, x, y) {
        scb := view.node_bounds(ed.id_insp_scroll) or (err) { << ui.CURSOR_DEFAULT }
        sc_cur := ed.insp_scroll.cursor_at(x - scb.x, y - scb.y)
        if sc_cur != ui.CURSOR_DEFAULT { << sc_cur }
    }
    fcs := [field_hit_cursor(view, ed.id_prim_field, &ed.prim_field, x, y), field_hit_cursor_clipped(view, ed.id_name_field, ed.id_insp_scroll, &ed.name_field, x, y), field_hit_cursor_clipped(view, ed.id_pos_x, ed.id_insp_scroll, &ed.pos_x, x, y), field_hit_cursor_clipped(view, ed.id_pos_y, ed.id_insp_scroll, &ed.pos_y, x, y), field_hit_cursor_clipped(view, ed.id_pos_z, ed.id_insp_scroll, &ed.pos_z, x, y), field_hit_cursor_clipped(view, ed.id_rot_x, ed.id_insp_scroll, &ed.rot_x, x, y), field_hit_cursor_clipped(view, ed.id_rot_y, ed.id_insp_scroll, &ed.rot_y, x, y), field_hit_cursor_clipped(view, ed.id_rot_z, ed.id_insp_scroll, &ed.rot_z, x, y), field_hit_cursor_clipped(view, ed.id_scale_x, ed.id_insp_scroll, &ed.scale_x, x, y), field_hit_cursor_clipped(view, ed.id_scale_y, ed.id_insp_scroll, &ed.scale_y, x, y), field_hit_cursor_clipped(view, ed.id_scale_z, ed.id_insp_scroll, &ed.scale_z, x, y), field_hit_cursor_clipped(view, ed.id_surf_prim_field, ed.id_insp_scroll, &ed.surf_prim_field, x, y), field_hit_cursor_clipped(view, ed.id_lod_hyst_field, ed.id_insp_scroll, &ed.lod_hyst_field, x, y), field_hit_cursor_clipped(view, ed.id_lod_dist_field, ed.id_insp_scroll, &ed.lod_dist_field, x, y), field_hit_cursor_clipped(view, ed.id_lod_prim_field, ed.id_insp_scroll, &ed.lod_prim_field, x, y)]
    for fc in fcs {
        if fc >= 0 { << fc }
    }
    if node_contains(view, ed.id_asset_meta, x, y) { << ed.asset_meta_txt.cursor_at(x, y) }
    if node_contains(view, ed.id_insp_hdr, x, y) { << ed.insp_hdr_txt.cursor_at(x, y) }
    if node_contains_clipped(view, ed.id_surf_info, ed.id_insp_scroll, x, y) { << ed.surf_info_txt.cursor_at(x, y) }
    if node_contains_clipped(view, ed.id_lod_info, ed.id_insp_scroll, x, y) { << ed.lod_info_txt.cursor_at(x, y) }
    if node_contains(view, ed.id_status_txt, x, y) { << ed.status_txt.cursor_at(x, y) }
    if node_contains(view, ed.id_tree, x, y) { << ed.tree.cursor_at(x - ed.tree_origin.x, y - ed.tree_origin.y) }
    if node_contains(view, ed.id_top_view, x, y) {
        if ed.placing_mode || ed.top_view.marquee_active { << ui.CURSOR_CROSSHAIR }
        if ed.top_view.panning || ed.top_view.dragging_nodes || ed.top_view.hover_node >= 0 { << ui.CURSOR_HAND }
        << ui.CURSOR_DEFAULT
    }
    ccs := [sel_hit_cursor(view, ed.id_scene_select, &ed.scene_select, x, y), sel_hit_cursor(view, ed.id_asset_select, &ed.asset_select, x, y), sel_hit_cursor_clipped(view, ed.id_parent_select, ed.id_insp_scroll, &ed.parent_select, x, y), sel_hit_cursor_clipped(view, ed.id_process_select, ed.id_insp_scroll, &ed.process_select, x, y), sel_hit_cursor_clipped(view, ed.id_surf_asset_select, ed.id_insp_scroll, &ed.surf_asset_select, x, y), sel_hit_cursor_clipped(view, ed.id_lod_asset_select, ed.id_insp_scroll, &ed.lod_asset_select, x, y), btn_hit_cursor(view, ed.id_new_scene_btn, &ed.new_scene_btn, x, y), btn_hit_cursor(view, ed.id_globals_btn, &ed.globals_btn, x, y), btn_hit_cursor(view, ed.id_undo_btn, &ed.undo_btn, x, y), btn_hit_cursor(view, ed.id_redo_btn, &ed.redo_btn, x, y), btn_hit_cursor(view, ed.id_save_btn, &ed.save_btn, x, y), btn_hit_cursor(view, ed.id_preview_btn, &ed.preview_btn, x, y), btn_hit_cursor(view, ed.id_add_3d_btn, &ed.add_3d_btn, x, y), btn_hit_cursor(view, ed.id_add_2d_btn, &ed.add_2d_btn, x, y), btn_hit_cursor(view, ed.id_add_grp_btn, &ed.add_grp_btn, x, y), btn_hit_cursor(view, ed.id_dup_btn, &ed.dup_btn, x, y), btn_hit_cursor(view, ed.id_del_btn, &ed.del_btn, x, y), btn_hit_cursor(view, ed.id_add_cam_btn, &ed.add_cam_btn, x, y), btn_hit_cursor(view, ed.id_add_lgt_btn, &ed.add_lgt_btn, x, y), btn_hit_cursor(view, ed.id_import_btn, &ed.import_btn, x, y), btn_hit_cursor(view, ed.id_place_btn, &ed.place_btn, x, y), btn_hit_cursor(view, ed.id_stage_axis_btn, &ed.stage_axis_btn, x, y), btn_hit_cursor(view, ed.id_stage_snap_btn, &ed.stage_snap_btn, x, y), btn_hit_cursor(view, ed.id_fit_btn, &ed.fit_btn, x, y), btn_hit_cursor(view, ed.id_view3d_btn, &ed.view3d_btn, x, y), btn_hit_cursor(view, ed.id_snap_btn, &ed.snap_btn, x, y), btn_hit_cursor_clipped(view, ed.id_reparent_btn, ed.id_insp_scroll, &ed.reparent_btn, x, y), btn_hit_cursor_clipped(view, ed.id_surf_bind_btn, ed.id_insp_scroll, &ed.surf_bind_btn, x, y), btn_hit_cursor_clipped(view, ed.id_surf_clear_btn, ed.id_insp_scroll, &ed.surf_clear_btn, x, y), btn_hit_cursor_clipped(view, ed.id_lod_add_btn, ed.id_insp_scroll, &ed.lod_add_btn, x, y), btn_hit_cursor_clipped(view, ed.id_lod_pop_btn, ed.id_insp_scroll, &ed.lod_pop_btn, x, y), btn_hit_cursor(view, ed.id_apply_btn, &ed.apply_btn, x, y)]
    for cc in ccs {
        if cc >= 0 { << cc }
    }
    if node_contains_clipped(view, ed.id_visible_chk, ed.id_insp_scroll, x, y) {
        << ed.visible_chk.cursor()
    }
    if node_contains(view, ed.id_insp_scroll, x, y) {
        ccur := comp_cursor(&ed.comp, view, &ed.styles, x, y)
        if ccur >= 0 { << ccur }
    }
    << ui.CURSOR_DEFAULT
}

fn (ed $&Editor) apply_pointer_cursor(view $&widgets.View) {
    $cur := ui.CURSOR_DEFAULT
    if ed.pointer_inside { cur = ed.resolve_cursor(view, ed.last_px, ed.last_py) }
    _ := view.set_pointer_cursor(cur) or (err) {
        _ := err
        <<
    }
}

fn route_popup_field(view $&widgets.View, root_id int, input &ui.InputEvent, f $&widgets.Field) bool {
    if !f.has_popup_open() { << false }
    id := f.id()
    act := field_input(f, input)
    if act.needs_paint { repaint(view, id) }
    repaint(view, root_id)
    << act.consumed || (input.kind == ui.EV_KEY_DOWN && input.key == ui.KEY_ESCAPE)
}

fn route_popup_text(view $&widgets.View, root_id int, input &ui.InputEvent, s $&widgets.SelectableText) bool {
    if !s.has_popup_open() { << false }
    id := s.id()
    act := text_input(s, input)
    if act.needs_paint { repaint(view, id) }
    repaint(view, root_id)
    << act.consumed || (input.kind == ui.EV_KEY_DOWN && input.key == ui.KEY_ESCAPE)
}

fn (ed $&Editor) route_open_context_menus(input &ui.InputEvent, view $&widgets.View) bool {
    rid := ed.id_root
    if ed.tree.has_popup_open() {
        $local := copy_input(input)
        if is_pointer_event_kind(input.kind) || input.kind == ui.EV_POINTER_SCROLL {
            local.x = input.x - ed.tree_origin.x
            local.y = input.y - ed.tree_origin.y
        }
        tr := $&ed.tree
        act := tr.input(&local)
        if act.needs_paint { repaint(view, ed.id_tree) }
        repaint(view, rid)
        if act.consumed || (input.kind == ui.EV_KEY_DOWN && input.key == ui.KEY_ESCAPE) { << true }
    }
    if ed.name_field.has_popup_open() {
        act := field_input($&ed.name_field, input)
        if act.kind == widgets.ACTION_CHANGE || act.kind == widgets.ACTION_COMMIT {
            val := ed.name_field.value()
            ed.name_error = ""
            ed.refresh_name_decoration(&val)
            repaint(view, ed.id_right_pane)
        }
        repaint(view, rid)
        if act.consumed || (input.kind == ui.EV_KEY_DOWN && input.key == ui.KEY_ESCAPE) { << true }
    }
    if route_popup_field(view, rid, input, $&ed.prim_field) { << true }
    if route_popup_field(view, rid, input, $&ed.pos_x) { << true }
    if route_popup_field(view, rid, input, $&ed.pos_y) { << true }
    if route_popup_field(view, rid, input, $&ed.pos_z) { << true }
    if route_popup_field(view, rid, input, $&ed.rot_x) { << true }
    if route_popup_field(view, rid, input, $&ed.rot_y) { << true }
    if route_popup_field(view, rid, input, $&ed.rot_z) { << true }
    if route_popup_field(view, rid, input, $&ed.scale_x) { << true }
    if route_popup_field(view, rid, input, $&ed.scale_y) { << true }
    if route_popup_field(view, rid, input, $&ed.scale_z) { << true }
    if route_popup_field(view, rid, input, $&ed.surf_prim_field) { << true }
    if route_popup_field(view, rid, input, $&ed.lod_hyst_field) { << true }
    if route_popup_field(view, rid, input, $&ed.lod_dist_field) { << true }
    if route_popup_field(view, rid, input, $&ed.lod_prim_field) { << true }
    if route_popup_text(view, rid, input, $&ed.asset_meta_txt) { << true }
    if route_popup_text(view, rid, input, $&ed.insp_hdr_txt) { << true }
    if route_popup_text(view, rid, input, $&ed.surf_info_txt) { << true }
    if route_popup_text(view, rid, input, $&ed.lod_info_txt) { << true }
    if route_popup_text(view, rid, input, $&ed.status_txt) { << true }
    if panels_route_context_popups($&ed.panels, view, rid, input) { << true }
    if comp_route_context_popups($&ed.comp, view, rid, input) { << true }
    << false
}

fn dispatch_field_text_event(view $&widgets.View, root_id int, event &ui.Event, f $&widgets.Field) bool {
    id := f.id()
    act := field_event(f, event)
    if act.needs_paint || act.kind == widgets.ACTION_CHANGE {
        repaint(view, id)
        if f.has_popup_open() { repaint(view, root_id) }
        << true
    }
    << false
}

fn dispatch_sel_text_event(view $&widgets.View, event &ui.Event, s $&widgets.SelectableText) bool {
    id := s.id()
    act := text_event(s, event)
    if act.needs_paint {
        repaint(view, id)
        << true
    }
    << false
}

fn (ed $&Editor) dispatch_text_or_request(event &ui.Event, view $&widgets.View) bool {
    is_text_or_req := (event.kind >= ui.EV_TEXT_COMMIT && event.kind <= ui.EV_TEXT_SURROUNDING_DELETE) || event.kind == ui.EV_REQUEST
    if !is_text_or_req { << false }
    rid := ed.id_root
    if ed.modals.kind != MODAL_NONE {
        mods := $&ed.modals
        if mods.handle_text_or_request(event) {
            repaint(view, rid)
        }
        << true
    }
    a_nm := field_event($&ed.name_field, event)
    if a_nm.kind == widgets.ACTION_CHANGE || a_nm.kind == widgets.ACTION_COMMIT {
        val := ed.name_field.value()
        ed.name_error = ""
        ed.refresh_name_decoration(&val)
        repaint(view, ed.id_right_pane)
    } else if a_nm.needs_paint {
        repaint(view, ed.id_name_field)
    }
    _ := dispatch_field_text_event(view, rid, event, $&ed.prim_field)
    _ := dispatch_field_text_event(view, rid, event, $&ed.pos_x)
    _ := dispatch_field_text_event(view, rid, event, $&ed.pos_y)
    _ := dispatch_field_text_event(view, rid, event, $&ed.pos_z)
    _ := dispatch_field_text_event(view, rid, event, $&ed.rot_x)
    _ := dispatch_field_text_event(view, rid, event, $&ed.rot_y)
    _ := dispatch_field_text_event(view, rid, event, $&ed.rot_z)
    _ := dispatch_field_text_event(view, rid, event, $&ed.scale_x)
    _ := dispatch_field_text_event(view, rid, event, $&ed.scale_y)
    _ := dispatch_field_text_event(view, rid, event, $&ed.scale_z)
    _ := dispatch_field_text_event(view, rid, event, $&ed.surf_prim_field)
    _ := dispatch_field_text_event(view, rid, event, $&ed.lod_hyst_field)
    _ := dispatch_field_text_event(view, rid, event, $&ed.lod_dist_field)
    _ := dispatch_field_text_event(view, rid, event, $&ed.lod_prim_field)
    _ := dispatch_sel_text_event(view, event, $&ed.asset_meta_txt)
    _ := dispatch_sel_text_event(view, event, $&ed.insp_hdr_txt)
    _ := dispatch_sel_text_event(view, event, $&ed.surf_info_txt)
    _ := dispatch_sel_text_event(view, event, $&ed.lod_info_txt)
    _ := dispatch_sel_text_event(view, event, $&ed.status_txt)
    filter_changed := panels_dispatch_text_or_request($&ed.panels, view, rid, event)
    if filter_changed {
        doc := ed.draft.document() or (err) { << true }
        ed.rebuild_tree(&doc)
        repaint(view, ed.id_left_pane)
    }
    comp_dispatch_text_or_request($&ed.comp, view, rid, event)
    << true
}

fn is_inspector_submit_id(ed &Editor, id int) bool {
    << id == ed.id_name_field ||
        id == ed.id_pos_x || id == ed.id_pos_y || id == ed.id_pos_z ||
        id == ed.id_rot_x || id == ed.id_rot_y || id == ed.id_rot_z ||
        id == ed.id_scale_x || id == ed.id_scale_y || id == ed.id_scale_z
}

fn (ed &Editor) any_popup_or_select_open() bool {
    << ed.scene_select.is_open() || ed.asset_select.is_open() || ed.parent_select.is_open() ||
        ed.process_select.is_open() || ed.surf_asset_select.is_open() || ed.lod_asset_select.is_open() ||
        ed.tree.has_popup_open() || ed.name_field.has_popup_open() || ed.prim_field.has_popup_open() ||
        ed.asset_meta_txt.has_popup_open() || ed.insp_hdr_txt.has_popup_open() ||
        ed.surf_info_txt.has_popup_open() || ed.lod_info_txt.has_popup_open() || ed.status_txt.has_popup_open() ||
        ed.pos_x.has_popup_open() || ed.pos_y.has_popup_open() || ed.pos_z.has_popup_open() ||
        ed.rot_x.has_popup_open() || ed.rot_y.has_popup_open() || ed.rot_z.has_popup_open() ||
        ed.scale_x.has_popup_open() || ed.scale_y.has_popup_open() || ed.scale_z.has_popup_open() ||
        ed.surf_prim_field.has_popup_open() || ed.lod_hyst_field.has_popup_open() ||
        ed.lod_dist_field.has_popup_open() || ed.lod_prim_field.has_popup_open() ||
        comp_has_any_popup_open(&ed.comp) || panels_has_any_popup(&ed.panels)
}

fn check_tip(view &widgets.View, id int, x f64, y f64, label string) TooltipHit {
    if id <= 0 { << empty_tooltip_hit() }
    nb := view.node_bounds(id) or (err) {
        _ := err
        << empty_tooltip_hit()
    }
    if !nb.contains(x, y) { << empty_tooltip_hit() }
    << TooltipHit{id: id, text: label + "", anchor: copy_rect(&nb)}
}

pub fn resolve_tooltip_hit(ed &Editor, view &widgets.View, x f64, y f64) TooltipHit {
    lang := ed.lang
    $h := check_tip(view, ed.panels.id_open_proj_btn, x, y, tr(lang, "Open Project (project.json)", "打开工程 (project.json)"))
    if h.id > 0 { << h }
    h = check_tip(view, ed.id_scene_select, x, y, tr(lang, "Switch Active Scene", "切换当前场景"))
    if h.id > 0 { << h }
    h = check_tip(view, ed.id_new_scene_btn, x, y, tr(lang, "New Scene", "新建场景"))
    if h.id > 0 { << h }
    h = check_tip(view, ed.panels.id_scene_mgr_btn, x, y, tr(lang, "Manage Scene (Rename / Duplicate / Delete)", "管理场景（重命名 / 复制 / 删除）"))
    if h.id > 0 { << h }
    h = check_tip(view, ed.id_globals_btn, x, y, tr(lang, "Scene Globals (Audio Buses & Script Routes)", "场景全局设置（音频总线与脚本路由）"))
    if h.id > 0 { << h }
    h = check_tip(view, ed.id_undo_btn, x, y, tr(lang, "Undo (Cmd+Z)", "撤销 (Cmd+Z)"))
    if h.id > 0 { << h }
    h = check_tip(view, ed.id_redo_btn, x, y, tr(lang, "Redo (Cmd+Shift+Z)", "重做 (Cmd+Shift+Z)"))
    if h.id > 0 { << h }
    $save_lbl := tr(lang, "Save Scene (Cmd+S)", "保存场景 (Cmd+S)")
    if ed.draft.dirty() { save_lbl = tr(lang, "Save Scene (Cmd+S) — Unsaved changes", "保存场景 (Cmd+S) — 有未保存更改") }
    h = check_tip(view, ed.id_save_btn, x, y, save_lbl)
    if h.id > 0 { << h }
    h = check_tip(view, ed.id_preview_btn, x, y, tr(lang, "Run Live Preview", "运行实时预览"))
    if h.id > 0 { << h }
    h = check_tip(view, ed.panels.id_export_btn, x, y, tr(lang, "Export / Publish Build", "导出 / 发布构建"))
    if h.id > 0 { << h }
    h = check_tip(view, ed.panels.id_lang_btn, x, y, tr(lang, "Switch to Chinese (中文)", "切换到英文 (English)"))
    if h.id > 0 { << h }
    $dirty_lbl := tr(lang, "All changes saved", "所有更改已保存")
    if ed.draft.dirty() { dirty_lbl = tr(lang, "Unsaved edits in current scene (Cmd+S to save)", "当前场景存在未保存更改（Cmd+S 保存）") }
    h = check_tip(view, ed.id_dirty_badge, x, y, dirty_lbl)
    if h.id > 0 { << h }

    h = check_tip(view, ed.panels.id_node_up_btn, x, y, tr(lang, "Move Node Up", "上移节点"))
    if h.id > 0 { << h }
    h = check_tip(view, ed.panels.id_node_dn_btn, x, y, tr(lang, "Move Node Down", "下移节点"))
    if h.id > 0 { << h }
    $vis_lbl := tr(lang, "Show Selected Node", "显示选中节点")
    if ed.visible_chk.value() { vis_lbl = tr(lang, "Hide Selected Node", "隐藏选中节点") }
    h = check_tip(view, ed.panels.id_node_vis_btn, x, y, vis_lbl)
    if h.id > 0 { << h }
    h = check_tip(view, ed.id_add_3d_btn, x, y, tr(lang, "Add Node3D", "添加 3D 节点 (Node3D)"))
    if h.id > 0 { << h }
    h = check_tip(view, ed.id_add_2d_btn, x, y, tr(lang, "Add Node2D", "添加 2D 节点 (Node2D)"))
    if h.id > 0 { << h }
    h = check_tip(view, ed.id_add_grp_btn, x, y, tr(lang, "Add Group Node", "添加节点组 (Group)"))
    if h.id > 0 { << h }
    h = check_tip(view, ed.id_add_cam_btn, x, y, tr(lang, "Add Camera Preset", "添加相机预设节点"))
    if h.id > 0 { << h }
    h = check_tip(view, ed.id_add_lgt_btn, x, y, tr(lang, "Add PointLight Preset", "添加点光源预设节点"))
    if h.id > 0 { << h }
    h = check_tip(view, ed.id_dup_btn, x, y, tr(lang, "Duplicate Selected Node (Cmd+D)", "复制选中节点 (Cmd+D)"))
    if h.id > 0 { << h }
    h = check_tip(view, ed.id_del_btn, x, y, tr(lang, "Delete Selected Node (Del)", "删除选中节点 (Del)"))
    if h.id > 0 { << h }

    h = check_tip(view, ed.id_import_btn, x, y, tr(lang, "Import Asset (.glb / .png / .wav / .xubc)", "导入资源 (.glb / .png / .wav / .xubc)"))
    if h.id > 0 { << h }
    h = check_tip(view, ed.panels.id_relocate_btn, x, y, tr(lang, "Relocate Selected Asset", "重定位选中资源"))
    if h.id > 0 { << h }
    h = check_tip(view, ed.panels.id_remove_asset_btn, x, y, tr(lang, "Remove Asset from Project", "从工程中移除资源"))
    if h.id > 0 { << h }
    $place_lbl := tr(lang, "Place Selected GLB in Stage", "在舞台放置所选 GLB")
    if ed.placing_mode { place_lbl = tr(lang, "Cancel GLB Placement (Esc)", "取消放置 GLB (Esc)") }
    h = check_tip(view, ed.id_place_btn, x, y, place_lbl)
    if h.id > 0 { << h }

    $axis_lbl := tr(lang, "Switch to Front View (XY)", "切换到正视图 (XY)")
    if ed.top_view.axis_mode == STAGE_XY { axis_lbl = tr(lang, "Switch to Top View (XZ)", "切换到俯视图 (XZ)") }
    h = check_tip(view, ed.id_stage_axis_btn, x, y, axis_lbl)
    if h.id > 0 { << h }
    $snap_lbl := tr(lang, "Enable Stage Grid Snap", "启用舞台网格吸附")
    if ed.top_snap_enabled { snap_lbl = tr(lang, "Disable Stage Grid Snap (step ", "关闭舞台网格吸附（步长 ") + fmt_coord(ed.snap.move_step) + tr(lang, " u)", " 单位）") }
    h = check_tip(view, ed.id_stage_snap_btn, x, y, snap_lbl)
    if h.id > 0 { << h }
    h = check_tip(view, ed.id_fit_btn, x, y, tr(lang, "Fit All Nodes in Stage (F)", "缩放以显示全部节点 (F)"))
    if h.id > 0 { << h }
    h = check_tip(view, ed.id_view3d_btn, x, y, tr(lang, "Open Interactive 3D Viewport", "打开交互式 3D 视口"))
    if h.id > 0 { << h }
    h = check_tip(view, ed.id_snap_btn, x, y, tr(lang, "Configure Snap Settings...", "配置吸附设置..."))
    if h.id > 0 { << h }

    h = check_tip(view, ed.id_reparent_btn, x, y, tr(lang, "Move Selected Node Under Chosen Parent", "将当前节点移动到所选父节点下"))
    if h.id > 0 { << h }
    h = check_tip(view, ed.id_surf_bind_btn, x, y, tr(lang, "Bind Selected GLB Primitive to Node", "将所选 GLB 图元绑定到当前节点"))
    if h.id > 0 { << h }
    h = check_tip(view, ed.id_surf_clear_btn, x, y, tr(lang, "Remove GLB Surface Binding", "移除当前节点的 GLB 表面绑定"))
    if h.id > 0 { << h }
    h = check_tip(view, ed.id_lod_add_btn, x, y, tr(lang, "Append LOD Level to Surface", "向表面追加一级 LOD"))
    if h.id > 0 { << h }
    h = check_tip(view, ed.id_lod_pop_btn, x, y, tr(lang, "Remove Last LOD Level", "移除最后一级 LOD"))
    if h.id > 0 { << h }
    h = check_tip(view, ed.id_apply_btn, x, y, tr(lang, "Apply Transform, Name & Visibility Changes", "应用变换、名称与可见性更改"))
    if h.id > 0 { << h }
    << empty_tooltip_hit()
}

pub fn (ed $&Editor) handle_ui_event(event &ui.Event, view $&widgets.View) int {
    if event.kind == ui.EV_CANVAS_METRICS {
        tip := $&ed.tooltip
        if tip.dismiss() { repaint(view, ed.id_root) }
        ed.sync_layout(view, f64(event.width), f64(event.height)) or >>
        << 0
    }
    if ed.dispatch_text_or_request(event, view) {
        << 0
    }
    if ui.is_input_event(event.kind) {
        input := ui.input_of(event) or >>
        if input.generation != ed.identity.generation { << 0 }
        if is_pointer_event_kind(input.kind) {
            if input.kind == ui.EV_POINTER_LEAVE {
                ed.pointer_inside = false
                tip := $&ed.tooltip
                if tip.dismiss() { repaint(view, ed.id_root) }
            } else {
                ed.last_px = input.x
                ed.last_py = input.y
                ed.pointer_inside = true
            }
        }
        if input.kind == ui.EV_POINTER_DOWN || input.kind == ui.EV_POINTER_SCROLL ||
           input.kind == ui.EV_POINTER_CANCEL || input.kind == ui.EV_KEY_DOWN {
            tip := $&ed.tooltip
            if tip.dismiss() { repaint(view, ed.id_root) }
        }

        if ed.handle_modal_input(&input, view) {
            << 0
        }

        // Open select popups capture pointer & Escape before underlying nodes.
        if ed.scene_select.is_open() {
            orig := copy_rect(&ed.scene_origin)
            act := route_open_select($&ed.scene_select, &orig, &input)
            if act.kind == widgets.ACTION_CHANGE {
                ed.switch_scene(int(act.value), true, view)
            }
            if act.consumed || (input.kind == ui.EV_KEY_DOWN && input.key == ui.KEY_ESCAPE) {
                set_sel_open($&ed.scene_select, false)
                ed.apply_pointer_cursor(view)
                repaint(view, ed.id_root)
                << 0
            }
            if is_pointer_event_kind(input.kind) { ed.apply_pointer_cursor(view) }
        }
        if ed.asset_select.is_open() {
            orig := copy_rect(&ed.asset_origin)
            act := route_open_select($&ed.asset_select, &orig, &input)
            if act.consumed || (input.kind == ui.EV_KEY_DOWN && input.key == ui.KEY_ESCAPE) {
                if act.kind == widgets.ACTION_CHANGE {
                    ed.sync_asset_meta_text()
                    repaint(view, ed.id_left_pane)
                }
                set_sel_open($&ed.asset_select, false)
                ed.apply_pointer_cursor(view)
                repaint(view, ed.id_root)
                << 0
            }
            if is_pointer_event_kind(input.kind) { ed.apply_pointer_cursor(view) }
        }
        if ed.parent_select.is_open() {
            orig := copy_rect(&ed.parent_origin)
            act := route_open_select($&ed.parent_select, &orig, &input)
            if act.consumed || (input.kind == ui.EV_KEY_DOWN && input.key == ui.KEY_ESCAPE) {
                set_sel_open($&ed.parent_select, false)
                ed.apply_pointer_cursor(view)
                repaint(view, ed.id_root)
                << 0
            }
            if is_pointer_event_kind(input.kind) { ed.apply_pointer_cursor(view) }
        }
        if ed.process_select.is_open() {
            orig := copy_rect(&ed.process_origin)
            act := route_open_select($&ed.process_select, &orig, &input)
            if act.consumed || (input.kind == ui.EV_KEY_DOWN && input.key == ui.KEY_ESCAPE) {
                set_sel_open($&ed.process_select, false)
                ed.apply_pointer_cursor(view)
                repaint(view, ed.id_root)
                << 0
            }
            if is_pointer_event_kind(input.kind) { ed.apply_pointer_cursor(view) }
        }
        if ed.surf_asset_select.is_open() {
            orig := copy_rect(&ed.surf_asset_origin)
            act := route_open_select($&ed.surf_asset_select, &orig, &input)
            if act.consumed || (input.kind == ui.EV_KEY_DOWN && input.key == ui.KEY_ESCAPE) {
                set_sel_open($&ed.surf_asset_select, false)
                ed.apply_pointer_cursor(view)
                repaint(view, ed.id_root)
                << 0
            }
            if is_pointer_event_kind(input.kind) { ed.apply_pointer_cursor(view) }
        }
        if ed.lod_asset_select.is_open() {
            orig := copy_rect(&ed.lod_asset_origin)
            act := route_open_select($&ed.lod_asset_select, &orig, &input)
            if act.consumed || (input.kind == ui.EV_KEY_DOWN && input.key == ui.KEY_ESCAPE) {
                set_sel_open($&ed.lod_asset_select, false)
                ed.apply_pointer_cursor(view)
                repaint(view, ed.id_root)
                << 0
            }
            if is_pointer_event_kind(input.kind) { ed.apply_pointer_cursor(view) }
        }
        if comp_route_open_selects(ed, &input, view) {
            ed.apply_pointer_cursor(view)
            << 0
        }

        if ed.route_open_context_menus(&input, view) {
            ed.apply_pointer_cursor(view)
            << 0
        }

        // Global shortcuts
        if input.kind == ui.EV_KEY_DOWN && input.repeat == 0 {
            if input.key == ui.KEY_ESCAPE && ed.placing_mode {
                ed.placing_mode = false
                ed.sync_toolbar_states()
                ed.apply_pointer_cursor(view)
                repaint(view, ed.id_left_pane)
                repaint(view, ed.id_top_view)
                ed.set_status(STATUS_INFO, "Cancelled placement", view)
                << 0
            }
            if input.key == ui.KEY_ESCAPE && (ed.top_view.dragging_nodes || ed.top_view.drag_pending || ed.top_view.marquee_active) {
                tv := $&ed.top_view
                tv.cancel_node_interactions()
                ed.top_pressed_hit = -1
                repaint(view, ed.id_top_view)
                ed.set_status(STATUS_INFO, "Cancelled Top View drag", view)
                << 0
            }
            has_mod := (input.modifiers & (ui.MOD_META | ui.MOD_CONTROL)) != 0
            has_shift := (input.modifiers & ui.MOD_SHIFT) != 0
            if has_mod && (input.key == 115 || input.key == 83) { // Cmd/Ctrl+S
                _ := ed.do_save(view)
                << 0
            }
            if has_mod && (input.key == 122 || input.key == 90) { // Cmd/Ctrl+Z
                if has_shift { ed.do_redo(view) } else { ed.do_undo(view) }
                << 0
            }
            if has_mod && (input.key == 100 || input.key == 68) { // Cmd/Ctrl+D
                ed.do_duplicate_node(view)
                << 0
            }
            if !ed.any_text_field_focused() {
                if input.key == 102 || input.key == 70 { // F
                    pts := clone_stage_points(&ed.stage_pts)
                    tv_rect := copy_rect(&ed.top_view_local)
                    tv := $&ed.top_view
                    tv.fit_points(&pts, &tv_rect)
                    repaint(view, ed.id_top_view)
                    << 0
                }
                if (input.key == ui.KEY_BACKSPACE || input.key == ui.KEY_DELETE) && ed.selected_node > 0 {
                    ed.do_delete_node(view)
                    << 0
                }
            }
        }
    }

    actions := widgets.dispatch_event(view, event, ed) or >>
    $need_relayout := false
    for i in 0:actions.len {
        a := &actions[i]
        if a.needs_paint && a.id > 0 {
            repaint(view, a.id)
        }
        if a.id == ed.id_left_split || a.id == ed.id_right_split || a.id == ed.panels.id_left_hsplit {
            if a.kind == widgets.ACTION_CHANGE { need_relayout = true }
        } else if a.id == ed.panels.id_open_proj_btn && a.kind == widgets.ACTION_ACTIVATE {
            if ed.draft.dirty() {
                ed.open_unsaved_open_project_modal(view)
            } else {
                ed.req_open_project = true
            }
        } else if a.id == ed.panels.id_scene_mgr_btn && a.kind == widgets.ACTION_ACTIVATE {
            ed.open_scene_manage_modal(view)
        } else if a.id == ed.panels.id_export_btn && a.kind == widgets.ACTION_ACTIVATE {
            ed.open_export_modal(view)
        } else if a.id == ed.panels.id_lang_btn && a.kind == widgets.ACTION_ACTIVATE {
            $next_l := LANG_ZH
            if ed.lang == LANG_ZH { next_l = LANG_EN }
            ed.set_lang(next_l, view)
        } else if a.id == ed.panels.id_node_up_btn && a.kind == widgets.ACTION_ACTIVATE {
            ed.do_move_sibling(-1, view)
        } else if a.id == ed.panels.id_node_dn_btn && a.kind == widgets.ACTION_ACTIVATE {
            ed.do_move_sibling(1, view)
        } else if a.id == ed.panels.id_node_vis_btn && a.kind == widgets.ACTION_ACTIVATE {
            ed.do_toggle_selected_visible(view)
        } else if a.id == ed.panels.id_tree_filter && a.kind == widgets.ACTION_CHANGE {
            doc := ed.draft.document() or (err) { << 0 }
            ed.rebuild_tree(&doc)
            repaint(view, ed.id_left_pane)
        } else if a.id == ed.panels.id_relocate_btn && a.kind == widgets.ACTION_ACTIVATE {
            sel := ed.asset_select.selected()
            if sel >= 0 && sel < ed.project.assets.len {
                ed.relocate_uid = ed.project.assets[sel].key + ""
                ed.req_relocate_asset = true
            }
        } else if a.id == ed.panels.id_remove_asset_btn && a.kind == widgets.ACTION_ACTIVATE {
            ed.do_remove_selected_asset(view)
        } else if a.id == ed.id_scene_select && a.kind == widgets.ACTION_CHANGE {
            ed.switch_scene(int(a.value), true, view)
        } else if a.id == ed.id_new_scene_btn && a.kind == widgets.ACTION_ACTIVATE {
            ed.open_new_scene_modal(view)
        } else if a.id == ed.id_globals_btn && a.kind == widgets.ACTION_ACTIVATE {
            ed.open_globals_modal(view)
        } else if a.id == ed.id_undo_btn && a.kind == widgets.ACTION_ACTIVATE {
            ed.do_undo(view)
        } else if a.id == ed.id_redo_btn && a.kind == widgets.ACTION_ACTIVATE {
            ed.do_redo(view)
        } else if a.id == ed.id_save_btn && a.kind == widgets.ACTION_ACTIVATE {
            _ := ed.do_save(view)
        } else if a.id == ed.id_preview_btn && a.kind == widgets.ACTION_ACTIVATE {
            ed.req_launch_preview = true
        } else if a.id == ed.id_add_3d_btn && a.kind == widgets.ACTION_ACTIVATE {
            ed.do_add_node(resource.NODE_3D, "Node3D", view)
        } else if a.id == ed.id_add_2d_btn && a.kind == widgets.ACTION_ACTIVATE {
            ed.do_add_node(resource.NODE_2D, "Node2D", view)
        } else if a.id == ed.id_add_grp_btn && a.kind == widgets.ACTION_ACTIVATE {
            ed.do_add_node(resource.NODE_GROUP, "Group", view)
        } else if a.id == ed.id_dup_btn && a.kind == widgets.ACTION_ACTIVATE {
            ed.do_duplicate_node(view)
        } else if a.id == ed.id_del_btn && a.kind == widgets.ACTION_ACTIVATE {
            ed.do_delete_node(view)
        } else if a.id == ed.id_add_cam_btn && a.kind == widgets.ACTION_ACTIVATE {
            ed.do_add_preset_cam(view)
        } else if a.id == ed.id_add_lgt_btn && a.kind == widgets.ACTION_ACTIVATE {
            ed.do_add_preset_lgt(view)
        } else if a.id == ed.id_tree && a.kind == widgets.ACTION_CHANGE {
            ed.apply_tree_selection_from_widget(view)
        } else if a.id == ed.id_import_btn && a.kind == widgets.ACTION_ACTIVATE {
            ed.req_import_glb = true
        } else if a.id == ed.id_asset_select && (a.kind == widgets.ACTION_CHANGE || a.kind == widgets.ACTION_ACTIVATE) {
            if a.kind == widgets.ACTION_CHANGE {
                ed.sync_asset_meta_text()
                ed.sync_toolbar_states()
                repaint(view, ed.id_left_pane)
            }
            repaint(view, ed.id_root)
        } else if a.id == ed.id_place_btn && a.kind == widgets.ACTION_ACTIVATE {
            ed.placing_mode = !ed.placing_mode
            ed.sync_toolbar_states()
            repaint(view, ed.id_left_pane)
            repaint(view, ed.id_top_view)
            if ed.placing_mode {
                ed.set_status(STATUS_INFO, "Click in Top View · XZ to place GLB (Esc cancels)", view)
            } else {
                ed.set_status(STATUS_INFO, "Cancelled placement", view)
            }
        } else if a.id == ed.id_stage_axis_btn && a.kind == widgets.ACTION_ACTIVATE {
            if ed.top_view.axis_mode == STAGE_XZ {
                ed.top_view.axis_mode = STAGE_XY
                ed.set_status(STATUS_INFO, "Stage axis: Front View · XY", view)
            } else {
                ed.top_view.axis_mode = STAGE_XZ
                ed.set_status(STATUS_INFO, "Stage axis: Top View · XZ", view)
            }
            ed.sync_toolbar_states()
            pts := clone_stage_points(&ed.stage_pts)
            tv_rect := copy_rect(&ed.top_view_local)
            tv := $&ed.top_view
            tv.fit_points(&pts, &tv_rect)
            repaint(view, ed.id_center_pane)
            repaint(view, ed.id_top_view)
        } else if a.id == ed.id_stage_snap_btn && a.kind == widgets.ACTION_ACTIVATE {
            ed.top_snap_enabled = !ed.top_snap_enabled
            ed.sync_toolbar_states()
            if ed.top_snap_enabled {
                ed.set_status(STATUS_INFO, "Stage grid snap enabled (" + fmt_coord(ed.snap.move_step) + " u)", view)
            } else {
                ed.set_status(STATUS_INFO, "Stage grid snap disabled", view)
            }
            repaint(view, ed.id_center_pane)
        } else if a.id == ed.id_fit_btn && a.kind == widgets.ACTION_ACTIVATE {
            pts := clone_stage_points(&ed.stage_pts)
            tv_rect := copy_rect(&ed.top_view_local)
            tv := $&ed.top_view
            tv.fit_points(&pts, &tv_rect)
            repaint(view, ed.id_top_view)
        } else if a.id == ed.id_view3d_btn && a.kind == widgets.ACTION_ACTIVATE {
            ed.req_launch_viewport = true
        } else if a.id == ed.id_snap_btn && a.kind == widgets.ACTION_ACTIVATE {
            ed.open_snap_modal(view)
        } else if a.id == ed.id_top_view && a.kind == widgets.ACTION_ACTIVATE {
            hit_id := int(a.value)
            if ed.top_pressed_shift {
                ed.top_pressed_shift = false
                ed.toggle_selection_node(hit_id)
                doc := ed.draft.document() or >>
                ed.sync_tree_selection(true)
                ed.sync_inspector(&doc)
                ed.sync_toolbar_states()
                repaint(view, ed.id_left_pane)
                repaint(view, ed.id_top_view)
                repaint(view, ed.id_right_pane)
            } else {
                ed.select_scene_node(hit_id, view)
            }
        } else if a.id == ed.id_top_view && a.kind == widgets.ACTION_CHANGE {
            mode_val := int(a.value)
            if mode_val == 1 {
                dx := ed.top_commit_dx
                dv := ed.top_commit_dv
                $dy := 0.0
                $dz := 0.0
                if ed.top_view.axis_mode == STAGE_XY { dy = dv } else { dz = dv }
                $targets := []int{}
                for k in 0:ed.selected_nodes.len { targets.push(ed.selected_nodes[k]) }
                d := $&ed.draft
                _ := d.move_nodes_delta(&targets, dx, dy, dz) or (err) {
                    ed.set_status(STATUS_ERR, err.msg(), view)
                    << 0
                }
                ed.refresh_after_document_change(false, view)
                ed.set_status(STATUS_OK, "Moved " + str(targets.len) + " node(s)", view)
            } else if mode_val == 2 {
                pts := clone_stage_points(&ed.stage_pts)
                tv_rect := copy_rect(&ed.top_view_local)
                picked_list := pick_stage_marquee(&ed.top_view, &tv_rect, &pts, ed.top_marquee_x0, ed.top_marquee_y0, ed.top_marquee_x1, ed.top_marquee_y1)
                if ed.top_pressed_shift {
                    ed.top_pressed_shift = false
                    $merged := []int{}
                    for k in 0:ed.selected_nodes.len { merged.push(ed.selected_nodes[k]) }
                    for k in 0:picked_list.len {
                        nid := picked_list[k]
                        if !is_selected_node(&merged, nid) { merged.push(nid) }
                    }
                    ed.set_selection_list(&merged, view)
                } else {
                    ed.set_selection_list(&picked_list, view)
                }
            }
        } else if a.id == ed.id_top_view && a.kind == widgets.ACTION_COMMIT {
            $wz := ed.top_view.hover_z
            if ed.top_view.axis_mode == STAGE_XY { wz = 0.0 }
            ed.do_place_at(ed.top_view.hover_x, wz, view)
        } else if a.id == ed.id_insp_scroll && a.kind == widgets.ACTION_SCROLL {
            ed.close_all_selects()
            view.set_scroll(ed.id_insp_scroll, 0.0, ed.insp_scroll.offset()) or >>
            ed.place_all_controls(view) or >>
            ed.repaint_all(view)
        } else if a.id == ed.id_reparent_btn && a.kind == widgets.ACTION_ACTIVATE {
            ed.do_reparent_selected(view)
        } else if a.id == ed.id_surf_bind_btn && a.kind == widgets.ACTION_ACTIVATE {
            ed.do_bind_surface(view)
        } else if a.id == ed.id_surf_clear_btn && a.kind == widgets.ACTION_ACTIVATE {
            ed.do_clear_surface(view)
        } else if a.id == ed.id_lod_add_btn && a.kind == widgets.ACTION_ACTIVATE {
            ed.do_add_lod_level(view)
        } else if a.id == ed.id_lod_pop_btn && a.kind == widgets.ACTION_ACTIVATE {
            ed.do_pop_lod_level(view)
        } else if a.id == ed.id_surf_prim_field && (a.kind == widgets.ACTION_COMMIT || a.kind == widgets.ACTION_SUBMIT) {
            ed.do_bind_surface(view)
        } else if (a.id == ed.id_lod_hyst_field || a.id == ed.id_lod_dist_field || a.id == ed.id_lod_prim_field) &&
                  (a.kind == widgets.ACTION_COMMIT || a.kind == widgets.ACTION_SUBMIT) {
            ed.do_add_lod_level(view)
        } else if a.id == ed.id_apply_btn && a.kind == widgets.ACTION_ACTIVATE {
            _ := ed.apply_inspector(view)
        } else if a.id == ed.id_name_field && a.kind == widgets.ACTION_CHANGE {
            val := ed.name_field.value()
            ed.name_error = ""
            ed.refresh_name_decoration(&val)
            repaint(view, ed.id_right_pane)
        } else if (a.id == ed.id_name_field || a.id == ed.id_pos_x || a.id == ed.id_pos_y || a.id == ed.id_pos_z ||
                   a.id == ed.id_rot_x || a.id == ed.id_rot_y || a.id == ed.id_rot_z ||
                   a.id == ed.id_scale_x || a.id == ed.id_scale_y || a.id == ed.id_scale_z) && a.kind == widgets.ACTION_COMMIT {
            _ := ed.apply_inspector(view)
        } else if a.kind == widgets.ACTION_SUBMIT && is_inspector_submit_id(ed, a.id) {
            _ := ed.apply_inspector(view)
        } else if handle_comp_action(ed, a, view) {
        }
        if ed.scene_select.is_open() || ed.asset_select.is_open() || ed.parent_select.is_open() ||
            ed.process_select.is_open() || ed.surf_asset_select.is_open() || ed.lod_asset_select.is_open() ||
            ed.tree.has_popup_open() || ed.name_field.has_popup_open() || ed.prim_field.has_popup_open() ||
            ed.asset_meta_txt.has_popup_open() || ed.insp_hdr_txt.has_popup_open() ||
            ed.surf_info_txt.has_popup_open() || ed.lod_info_txt.has_popup_open() || ed.status_txt.has_popup_open() ||
            ed.pos_x.has_popup_open() || ed.pos_y.has_popup_open() || ed.pos_z.has_popup_open() ||
            ed.rot_x.has_popup_open() || ed.rot_y.has_popup_open() || ed.rot_z.has_popup_open() ||
            ed.scale_x.has_popup_open() || ed.scale_y.has_popup_open() || ed.scale_z.has_popup_open() ||
            ed.surf_prim_field.has_popup_open() || ed.lod_hyst_field.has_popup_open() ||
            ed.lod_dist_field.has_popup_open() || ed.lod_prim_field.has_popup_open() ||
            comp_has_any_popup_open(&ed.comp) || panels_has_any_popup(&ed.panels) {
            repaint(view, ed.id_root)
        }
    }
    if need_relayout {
        ed.sync_layout(view, ed.viewport_w, ed.viewport_h) or >>
        ed.repaint_all(view)
    }
    if ui.is_input_event(event.kind) {
        inp2 := ui.input_of(event) or >>
        if inp2.kind == ui.EV_POINTER_MOVE && inp2.generation == ed.identity.generation {
            if ed.modals.kind != MODAL_NONE || ed.any_popup_or_select_open() || ed.dragging_split != 0 ||
               ed.top_view.panning || ed.top_view.dragging_nodes || ed.top_view.marquee_active {
                tip := $&ed.tooltip
                if tip.dismiss() { repaint(view, ed.id_root) }
            } else {
                hit := resolve_tooltip_hit(ed, view, inp2.x, inp2.y)
                now_t := time.instant()
                tip := $&ed.tooltip
                if tip.update_hover(&hit, now_t) {
                    repaint(view, ed.id_root)
                }
            }
        }
    }
    ed.apply_pointer_cursor(view)
    << 0
}

pub fn (ed $&Editor) tick_animations(view $&widgets.View, now time.Instant) {
    rm := ed.reduced_motion
    mods := $&ed.modals
    if mods.tick(now, rm) {
        repaint(view, ed.id_root)
    }
    tip := $&ed.tooltip
    if tip.tick(now) {
        repaint(view, ed.id_root)
    }
    if tick_field($&ed.name_field, now, rm) { repaint(view, ed.id_name_field) }
    if tick_field($&ed.prim_field, now, rm) { repaint(view, ed.id_prim_field) }
    if tick_field($&ed.pos_x, now, rm) { repaint(view, ed.id_pos_x) }
    if tick_field($&ed.pos_y, now, rm) { repaint(view, ed.id_pos_y) }
    if tick_field($&ed.pos_z, now, rm) { repaint(view, ed.id_pos_z) }
    if tick_field($&ed.rot_x, now, rm) { repaint(view, ed.id_rot_x) }
    if tick_field($&ed.rot_y, now, rm) { repaint(view, ed.id_rot_y) }
    if tick_field($&ed.rot_z, now, rm) { repaint(view, ed.id_rot_z) }
    if tick_field($&ed.scale_x, now, rm) { repaint(view, ed.id_scale_x) }
    if tick_field($&ed.scale_y, now, rm) { repaint(view, ed.id_scale_y) }
    if tick_field($&ed.scale_z, now, rm) { repaint(view, ed.id_scale_z) }
    if tick_field($&ed.surf_prim_field, now, rm) { repaint(view, ed.id_surf_prim_field) }
    if tick_field($&ed.lod_hyst_field, now, rm) { repaint(view, ed.id_lod_hyst_field) }
    if tick_field($&ed.lod_dist_field, now, rm) { repaint(view, ed.id_lod_dist_field) }
    if tick_field($&ed.lod_prim_field, now, rm) { repaint(view, ed.id_lod_prim_field) }
    comp_tick($&ed.comp, view, now, rm)
    panels_tick($&ed.panels, view, now, rm)
}

pub fn (ed &Editor) next_tick_deadline(now time.Instant) time.Instant {
    $deadline := ed.modals.next_tick(now, ed.reduced_motion)
    fields := [field_next_tick(&ed.name_field, now, ed.reduced_motion), field_next_tick(&ed.prim_field, now, ed.reduced_motion), field_next_tick(&ed.pos_x, now, ed.reduced_motion), field_next_tick(&ed.pos_y, now, ed.reduced_motion), field_next_tick(&ed.pos_z, now, ed.reduced_motion), field_next_tick(&ed.rot_x, now, ed.reduced_motion), field_next_tick(&ed.rot_y, now, ed.reduced_motion), field_next_tick(&ed.rot_z, now, ed.reduced_motion), field_next_tick(&ed.scale_x, now, ed.reduced_motion), field_next_tick(&ed.scale_y, now, ed.reduced_motion), field_next_tick(&ed.scale_z, now, ed.reduced_motion), field_next_tick(&ed.surf_prim_field, now, ed.reduced_motion), field_next_tick(&ed.lod_hyst_field, now, ed.reduced_motion), field_next_tick(&ed.lod_dist_field, now, ed.reduced_motion), field_next_tick(&ed.lod_prim_field, now, ed.reduced_motion)]
    for next in fields {
        if !next.is_zero() && (deadline.is_zero() || next.before(deadline)) {
            deadline = next
        }
    }
    $d2 := comp_next_tick(&ed.comp, now, ed.reduced_motion, deadline)
    $d3 := panels_next_tick(&ed.panels, now, ed.reduced_motion, d2)
    << ed.tooltip.next_tick(d3)
}
