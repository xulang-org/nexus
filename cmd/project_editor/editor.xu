    pub modals ModalState
}

fn zero_rect() layout.Rect {
    << layout.Rect{x: 0.0, y: 0.0, width: 80.0, height: 28.0}
}

fn leaf_box(w f64, h f64) layout.BoxStyle {
    $b := layout.box_style(layout.BOX_LEAF)
    b.width = w
    b.height = h
    << b
}

fn row_box(w f64, h f64, gap f64) layout.BoxStyle {
    $b := layout.box_style(layout.BOX_ROW)
    b.width = w
    b.height = h
    b.gap = gap
    b.cross_alignment = layout.CROSS_CENTER
    << b
}

fn col_box(w f64, h f64, gap f64) layout.BoxStyle {
    $b := layout.box_style(layout.BOX_COLUMN)
    b.width = w
    b.height = h
    b.gap = gap
    b.cross_alignment = layout.CROSS_STRETCH
    << b
}

fn make_plain_field(context &draw.Context, identity &ui.CanvasEvent, id int, label string, val string) widgets.Field {
    $dec := widgets.field_decoration(&label)
    dec.reserve_helper = false
    << widgets.field(context, identity, id, &zero_rect(), &val, &dec) >>>
}

fn make_name_field(context &draw.Context, identity &ui.CanvasEvent, id int, val string) widgets.Field {
    $dec := widgets.field_decoration(&"Name *")
    dec.clearable = true
    dec.helper = byte_counter_text(&val, 255)
    $f := widgets.field(context, identity, id, &zero_rect(), &val, &dec) >>>
    $opts := widgets.field_text_options()
    opts.counter = false
    opts.character_limit = 255
    _ := f.set_text_options(&opts)
    << f
}

fn add_interactive(view $&widgets.View, parent int, box &layout.BoxStyle, cursor int, focusable bool) int {
    id := view.add(parent, box, &layout.Size{width: 0.0, height: 0.0}) >>>
    view.set_input(id, true, focusable) >>>
    view.set_cursor(id, cursor) >>>
    << id
}

fn add_box(view $&widgets.View, parent int, box &layout.BoxStyle) int {
    << view.add(parent, box, &layout.Size{width: 0.0, height: 0.0}) >>>
}

pub fn create_editor_view(context &draw.Context, identity &ui.CanvasEvent, width f64, height f64) widgets.View {
    pal := default_palette()
    $root_b := col_box(width, height, 0.0)
    root_b.clip = true
    $host := widgets.Host{
        context: context.clone(),
        identity: ui.CanvasEvent{window_id: identity.window_id, canvas_id: identity.canvas_id, generation: identity.generation}
    }
    << host.view(&root_b, pal.canvas) >>>
}

pub fn create_editor(
    view $&widgets.View,
    context &draw.Context,
    identity &ui.CanvasEvent,
    project Project,
    output_dir string,
    validator_bin string,
    preview_bin string,
    viewport_bin string,
    width f64,
    height f64
) Editor {
    pal := default_palette()
    styles := make_paper_styles(&pal)
    snap := load_snap_settings(&output_dir)

    scene_path := project.scene_source(0) >>>
    draft := open_draft(scene_path) >>>

    id_root := view.root()
    view.set_styles(&styles) >>>

    // 1. Toolbar
    $tb := row_box(width, f64(TOOLBAR_H), 6.0)
    tb.padding = layout.Insets{left: 10.0, top: 6.0, right: 10.0, bottom: 6.0}
    id_toolbar := add_box(view, id_root, &tb)
    view.set_boundary(id_toolbar, true) >>>

    id_brand := add_box(view, id_toolbar, &leaf_box(64.0, 28.0))
    id_scene_select := add_interactive(view, id_toolbar, &leaf_box(176.0, 30.0), ui.CURSOR_HAND, true)
    id_new_scene_btn := add_interactive(view, id_toolbar, &leaf_box(78.0, 30.0), ui.CURSOR_HAND, true)
    id_undo_btn := add_interactive(view, id_toolbar, &leaf_box(58.0, 30.0), ui.CURSOR_HAND, true)
    id_redo_btn := add_interactive(view, id_toolbar, &leaf_box(58.0, 30.0), ui.CURSOR_HAND, true)
    id_save_btn := add_interactive(view, id_toolbar, &leaf_box(68.0, 30.0), ui.CURSOR_HAND, true)
    id_preview_btn := add_interactive(view, id_toolbar, &leaf_box(76.0, 30.0), ui.CURSOR_HAND, true)
    id_dirty_badge := add_box(view, id_toolbar, &leaf_box(120.0, 26.0))

    // 2. Workspace
    body_h := math.max(200.0, height - f64(TOOLBAR_H) - f64(FOOTER_H))
    left_w := 252.0
    right_w := 304.0
    center_w := math.max(f64(MIN_CENTER_W), width - left_w - right_w - f64(SPLITTER_W) * 2.0)
    $ws := row_box(width, body_h, 0.0)
    ws.cross_alignment = layout.CROSS_STRETCH
    id_workspace := add_box(view, id_root, &ws)

    // Left pane
    $lp := col_box(left_w, body_h, 6.0)
    lp.padding = layout.Insets{left: 8.0, top: 8.0, right: 8.0, bottom: 8.0}
    id_left_pane := add_box(view, id_workspace, &lp)
    view.set_boundary(id_left_pane, true) >>>
    inner_lw := left_w - 16.0
    id_tree_hdr := add_box(view, id_left_pane, &leaf_box(inner_lw, 22.0))
    id_tree_btns := add_box(view, id_left_pane, &row_box(inner_lw, 28.0, 4.0))
    id_add_3d_btn := add_interactive(view, id_tree_btns, &leaf_box(54.0, 26.0), ui.CURSOR_HAND, true)
    id_add_grp_btn := add_interactive(view, id_tree_btns, &leaf_box(56.0, 26.0), ui.CURSOR_HAND, true)
    id_dup_btn := add_interactive(view, id_tree_btns, &leaf_box(50.0, 26.0), ui.CURSOR_HAND, true)
    id_del_btn := add_interactive(view, id_tree_btns, &leaf_box(50.0, 26.0), ui.CURSOR_HAND, true)

    tree_h := math.max(120.0, body_h - 246.0)
    id_tree := add_interactive(view, id_left_pane, &leaf_box(inner_lw, tree_h), ui.CURSOR_DEFAULT, true)
    view.set_capture_outside(id_tree, true) >>>
    id_assets_div := add_box(view, id_left_pane, &leaf_box(inner_lw, 4.0))
    id_assets_hdr_row := add_box(view, id_left_pane, &row_box(inner_lw, 28.0, 6.0))
    id_assets_hdr := add_box(view, id_assets_hdr_row, &leaf_box(74.0, 24.0))
    id_import_btn := add_interactive(view, id_assets_hdr_row, &leaf_box(114.0, 26.0), ui.CURSOR_HAND, true)
    id_asset_select := add_interactive(view, id_left_pane, &leaf_box(inner_lw, 30.0), ui.CURSOR_HAND, true)
    id_asset_meta := add_interactive(view, id_left_pane, &leaf_box(inner_lw, 18.0), ui.CURSOR_TEXT, true)
    view.set_capture_outside(id_asset_meta, true) >>>
    id_asset_row := add_box(view, id_left_pane, &row_box(inner_lw, 48.0, 6.0))
    id_prim_field := add_interactive(view, id_asset_row, &leaf_box(66.0, 46.0), ui.CURSOR_TEXT, true)
    view.set_capture_outside(id_prim_field, true) >>>
    id_place_btn := add_interactive(view, id_asset_row, &leaf_box(118.0, 30.0), ui.CURSOR_HAND, true)

    id_left_split := add_interactive(view, id_workspace, &leaf_box(f64(SPLITTER_W), body_h), ui.CURSOR_RESIZE_HORIZONTAL, false)

    // Center pane
    $cp := col_box(center_w, body_h, 6.0)
    cp.padding = layout.Insets{left: 8.0, top: 8.0, right: 8.0, bottom: 8.0}
    id_center_pane := add_box(view, id_workspace, &cp)
    view.set_boundary(id_center_pane, true) >>>
    inner_cw := center_w - 16.0
    id_stage_bar := add_box(view, id_center_pane, &row_box(inner_cw, 30.0, 6.0))
    id_stage_title := add_box(view, id_stage_bar, &leaf_box(math.max(96.0, inner_cw - 266.0), 26.0))
    id_fit_btn := add_interactive(view, id_stage_bar, &leaf_box(54.0, 28.0), ui.CURSOR_HAND, true)
    id_view3d_btn := add_interactive(view, id_stage_bar, &leaf_box(76.0, 28.0), ui.CURSOR_HAND, true)
    id_snap_btn := add_interactive(view, id_stage_bar, &leaf_box(118.0, 28.0), ui.CURSOR_HAND, true)
    id_top_view := add_interactive(view, id_center_pane, &leaf_box(inner_cw, math.max(120.0, body_h - 52.0)), ui.CURSOR_DEFAULT, true)
    view.set_boundary(id_top_view, true) >>>
    view.set_capture_outside(id_top_view, true) >>>

    id_right_split := add_interactive(view, id_workspace, &leaf_box(f64(SPLITTER_W), body_h), ui.CURSOR_RESIZE_HORIZONTAL, false)

    // Right pane (Inspector)
    $rp := col_box(right_w, body_h, 4.0)
    rp.padding = layout.Insets{left: 8.0, top: 8.0, right: 8.0, bottom: 8.0}
    id_right_pane := add_box(view, id_workspace, &rp)
    view.set_boundary(id_right_pane, true) >>>
    inner_rw := right_w - 16.0
    tri_w := (inner_rw - 8.0) / 3.0
    id_insp_hdr := add_interactive(view, id_right_pane, &leaf_box(inner_rw, 22.0), ui.CURSOR_TEXT, true)
    view.set_capture_outside(id_insp_hdr, true) >>>
    id_name_field := add_interactive(view, id_right_pane, &leaf_box(inner_rw, 62.0), ui.CURSOR_TEXT, true)
    view.set_capture_outside(id_name_field, true) >>>
    id_visible_chk := add_interactive(view, id_right_pane, &leaf_box(inner_rw, 26.0), ui.CURSOR_HAND, true)
    id_parent_row := add_box(view, id_right_pane, &row_box(inner_rw, 30.0, 6.0))
    id_parent_select := add_interactive(view, id_parent_row, &leaf_box(inner_rw - 84.0, 28.0), ui.CURSOR_HAND, true)
    id_reparent_btn := add_interactive(view, id_parent_row, &leaf_box(78.0, 28.0), ui.CURSOR_HAND, true)

    id_pos_lbl := add_box(view, id_right_pane, &leaf_box(inner_rw, 16.0))
    id_pos_row := add_box(view, id_right_pane, &row_box(inner_rw, 44.0, 4.0))
    id_pos_x := add_interactive(view, id_pos_row, &leaf_box(tri_w, 44.0), ui.CURSOR_TEXT, true)
    id_pos_y := add_interactive(view, id_pos_row, &leaf_box(tri_w, 44.0), ui.CURSOR_TEXT, true)
    id_pos_z := add_interactive(view, id_pos_row, &leaf_box(tri_w, 44.0), ui.CURSOR_TEXT, true)
    view.set_capture_outside(id_pos_x, true) >>>
    view.set_capture_outside(id_pos_y, true) >>>
    view.set_capture_outside(id_pos_z, true) >>>

    id_rot_lbl := add_box(view, id_right_pane, &leaf_box(inner_rw, 16.0))
    id_rot_row := add_box(view, id_right_pane, &row_box(inner_rw, 44.0, 4.0))
    id_rot_x := add_interactive(view, id_rot_row, &leaf_box(tri_w, 44.0), ui.CURSOR_TEXT, true)
    id_rot_y := add_interactive(view, id_rot_row, &leaf_box(tri_w, 44.0), ui.CURSOR_TEXT, true)
    id_rot_z := add_interactive(view, id_rot_row, &leaf_box(tri_w, 44.0), ui.CURSOR_TEXT, true)
    view.set_capture_outside(id_rot_x, true) >>>
    view.set_capture_outside(id_rot_y, true) >>>
    view.set_capture_outside(id_rot_z, true) >>>

    id_scale_lbl := add_box(view, id_right_pane, &leaf_box(inner_rw, 16.0))
    id_scale_row := add_box(view, id_right_pane, &row_box(inner_rw, 44.0, 4.0))
    id_scale_x := add_interactive(view, id_scale_row, &leaf_box(tri_w, 44.0), ui.CURSOR_TEXT, true)
    id_scale_y := add_interactive(view, id_scale_row, &leaf_box(tri_w, 44.0), ui.CURSOR_TEXT, true)
    id_scale_z := add_interactive(view, id_scale_row, &leaf_box(tri_w, 44.0), ui.CURSOR_TEXT, true)
    view.set_capture_outside(id_scale_x, true) >>>
    view.set_capture_outside(id_scale_y, true) >>>
    view.set_capture_outside(id_scale_z, true) >>>

    id_surf_info := add_interactive(view, id_right_pane, &leaf_box(inner_rw, 18.0), ui.CURSOR_TEXT, true)
    view.set_capture_outside(id_surf_info, true) >>>
    id_apply_btn := add_interactive(view, id_right_pane, &leaf_box(inner_rw, 32.0), ui.CURSOR_HAND, true)

    // 3. Footer
    $fb := row_box(width, f64(FOOTER_H), 8.0)
    fb.padding = layout.Insets{left: 10.0, top: 4.0, right: 10.0, bottom: 4.0}
    id_footer := add_box(view, id_root, &fb)
    view.set_boundary(id_footer, true) >>>
    id_status_txt := add_interactive(view, id_footer, &leaf_box(math.max(180.0, width - 420.0), 20.0), ui.CURSOR_TEXT, true)
    view.set_capture_outside(id_status_txt, true) >>>
    id_footer_hint := add_box(view, id_footer, &leaf_box(384.0, 20.0))

    // Controls
    sc_count := min_int_val(project.scenes.len, 64)
    $sc_sel := -1
    if sc_count > 0 { sc_sel = 0 }
    scene_select := widgets.select_box(identity, id_scene_select, &zero_rect(), sc_count, sc_sel) >>>
    $scene_labels := []widgets.StyledLabel{}
    for i in 0:sc_count {
        k := project.scenes[i].key + ""
        scene_labels.push(widgets.styled_label(context, &k))
    }

    as_count := min_int_val(project.assets.len, 64)
    $as_sel := -1
    if as_count > 0 { as_sel = 0 }
    asset_select := widgets.select_box(identity, id_asset_select, &zero_rect(), as_count, as_sel) >>>
    $asset_labels := []widgets.StyledLabel{}
    for i in 0:as_count {
        b := filepath.base(&project.assets[i].path)
        asset_labels.push(widgets.styled_label(context, &b))
    }

    parent_select := widgets.select_box(identity, id_parent_select, &zero_rect(), 1, 0) >>>
    parent_labels := [widgets.styled_label(context, &"(root)")]

    $ed := Editor{
        project: project,
        scene_index: 0,
        draft: draft,
        selected_node: 0,
        placing_mode: false,
        snap: snap,
        output_dir: output_dir,
        validator_bin: validator_bin,
        preview_bin: preview_bin,
        viewport_bin: viewport_bin,
        viewport_w: width,
        viewport_h: height,
        left_w: left_w,
        right_w: right_w,
        dragging_split: 0,
        split_start_gx: 0.0,
        split_orig_w: 0.0,
        top_view: default_top_view(),
        stage_pts: []StagePoint{},
        top_view_local: zero_rect(),
        status_text: "Ready",
        status_kind: STATUS_INFO,
        viewport_active: false,
        preview_active: false,
        import_active: false,
        close_pending: false,
        req_launch_viewport: false,
        req_launch_preview: false,
        req_import_glb: false,
        pal: pal,
        styles: styles,
        context: context.clone(),
        identity: ui.CanvasEvent{window_id: identity.window_id, canvas_id: identity.canvas_id, generation: identity.generation},
        reduced_motion: false,
        focused_id: 0,
        last_px: 0.0,
        last_py: 0.0,
        pointer_inside: false,

        id_root: id_root,
        id_toolbar: id_toolbar,
        id_brand: id_brand,
        id_scene_select: id_scene_select,
        id_new_scene_btn: id_new_scene_btn,
        id_undo_btn: id_undo_btn,
        id_redo_btn: id_redo_btn,
        id_save_btn: id_save_btn,
        id_preview_btn: id_preview_btn,
        id_dirty_badge: id_dirty_badge,
        id_workspace: id_workspace,
        id_left_pane: id_left_pane,
        id_tree_hdr: id_tree_hdr,
        id_tree_btns: id_tree_btns,
        id_add_3d_btn: id_add_3d_btn,
        id_add_grp_btn: id_add_grp_btn,
        id_dup_btn: id_dup_btn,
        id_del_btn: id_del_btn,
        id_tree: id_tree,
        id_assets_div: id_assets_div,
        id_assets_hdr_row: id_assets_hdr_row,
        id_assets_hdr: id_assets_hdr,
        id_import_btn: id_import_btn,
        id_asset_select: id_asset_select,
        id_asset_meta: id_asset_meta,
        id_asset_row: id_asset_row,
        id_prim_field: id_prim_field,
        id_place_btn: id_place_btn,
        id_left_split: id_left_split,
        id_center_pane: id_center_pane,
        id_stage_bar: id_stage_bar,
        id_stage_title: id_stage_title,
        id_fit_btn: id_fit_btn,
        id_view3d_btn: id_view3d_btn,
        id_snap_btn: id_snap_btn,
        id_top_view: id_top_view,
        id_right_split: id_right_split,
        id_right_pane: id_right_pane,
        id_insp_hdr: id_insp_hdr,
        id_name_field: id_name_field,
        id_visible_chk: id_visible_chk,
        id_parent_row: id_parent_row,
        id_parent_select: id_parent_select,
        id_reparent_btn: id_reparent_btn,
        id_pos_lbl: id_pos_lbl,
        id_pos_row: id_pos_row,
        id_pos_x: id_pos_x,
        id_pos_y: id_pos_y,
        id_pos_z: id_pos_z,
        id_rot_lbl: id_rot_lbl,
        id_rot_row: id_rot_row,
        id_rot_x: id_rot_x,
        id_rot_y: id_rot_y,
        id_rot_z: id_rot_z,
        id_scale_lbl: id_scale_lbl,
        id_scale_row: id_scale_row,
        id_scale_x: id_scale_x,
        id_scale_y: id_scale_y,
        id_scale_z: id_scale_z,
        id_surf_info: id_surf_info,
        id_apply_btn: id_apply_btn,
        id_footer: id_footer,
        id_status_txt: id_status_txt,
        id_footer_hint: id_footer_hint,

        scene_select: scene_select,
        scene_labels: scene_labels,
        empty_lbl: widgets.styled_label(context, &""),
        no_asset_lbl: widgets.styled_label(context, &"(No assets)"),
        root_parent_lbl: widgets.styled_label(context, &"(root)"),
        scene_origin: zero_rect(),
        new_scene_btn: widgets.button(identity, id_new_scene_btn, &zero_rect()) >>>,
        new_scene_lbl: widgets.styled_label(context, &"+ Scene"),
        undo_btn: widgets.button(identity, id_undo_btn, &zero_rect()) >>>,
        undo_lbl: widgets.styled_label(context, &"Undo"),
        redo_btn: widgets.button(identity, id_redo_btn, &zero_rect()) >>>,
        redo_lbl: widgets.styled_label(context, &"Redo"),
        save_btn: widgets.button(identity, id_save_btn, &zero_rect()) >>>,
        save_lbl: widgets.styled_label(context, &"Save"),
        preview_btn: widgets.button(identity, id_preview_btn, &zero_rect()) >>>,
        preview_lbl: widgets.styled_label(context, &"Preview"),

        add_3d_btn: widgets.button(identity, id_add_3d_btn, &zero_rect()) >>>,
        add_3d_lbl: widgets.styled_label(context, &"+ 3D"),
        add_grp_btn: widgets.button(identity, id_add_grp_btn, &zero_rect()) >>>,
        add_grp_lbl: widgets.styled_label(context, &"+ Grp"),
        dup_btn: widgets.button(identity, id_dup_btn, &zero_rect()) >>>,
        dup_lbl: widgets.styled_label(context, &"Dup"),
        del_btn: widgets.button(identity, id_del_btn, &zero_rect()) >>>,
        del_lbl: widgets.styled_label(context, &"Del"),
        tree: widgets.tree_view(context, identity, id_tree, &zero_rect()) >>>,
        tree_origin: zero_rect(),
        tree_to_scene: map[int]int{},
        scene_to_tree: map[int]int{},

        assets_div: widgets.divider(&zero_rect(), widgets.AXIS_HORIZONTAL) >>>,
        import_btn: widgets.button(identity, id_import_btn, &zero_rect()) >>>,
        import_lbl: widgets.styled_label(context, &"Import GLB..."),
        asset_select: asset_select,
        asset_labels: asset_labels,
        asset_origin: zero_rect(),
        prim_field: make_plain_field(context, identity, id_prim_field, "Prim", "0"),
        place_btn: widgets.button(identity, id_place_btn, &zero_rect()) >>>,
        place_lbl: widgets.styled_label(context, &"Place GLB"),

        fit_btn: widgets.button(identity, id_fit_btn, &zero_rect()) >>>,
        fit_lbl: widgets.styled_label(context, &"Fit"),
        view3d_btn: widgets.button(identity, id_view3d_btn, &zero_rect()) >>>,
        view3d_lbl: widgets.styled_label(context, &"3D View"),
        snap_btn: widgets.button(identity, id_snap_btn, &zero_rect()) >>>,
        snap_lbl: widgets.styled_label(context, &"Snap Settings"),

        name_field: make_name_field(context, identity, id_name_field, ""),
        name_error: "",
        visible_chk: widgets.checkbox(identity, id_visible_chk, &zero_rect(), true) >>>,
        visible_lbl: widgets.styled_label(context, &"Visible in scene"),
        parent_select: parent_select,
        parent_labels: parent_labels,
        parent_candidates: [0],
        parent_origin: zero_rect(),
        reparent_btn: widgets.button(identity, id_reparent_btn, &zero_rect()) >>>,
        reparent_lbl: widgets.styled_label(context, &"Reparent"),

        pos_x: make_plain_field(context, identity, id_pos_x, "X", "0"),
        pos_y: make_plain_field(context, identity, id_pos_y, "Y", "0"),
        pos_z: make_plain_field(context, identity, id_pos_z, "Z", "0"),
        rot_x: make_plain_field(context, identity, id_rot_x, "RX", "0"),
        rot_y: make_plain_field(context, identity, id_rot_y, "RY", "0"),
        rot_z: make_plain_field(context, identity, id_rot_z, "RZ", "0"),
        scale_x: make_plain_field(context, identity, id_scale_x, "SX", "1"),
        scale_y: make_plain_field(context, identity, id_scale_y, "SY", "1"),
        scale_z: make_plain_field(context, identity, id_scale_z, "SZ", "1"),
        rot_seed_x: "0",
        rot_seed_y: "0",
        rot_seed_z: "0",
        scale_seed_x: "1",
        scale_seed_y: "1",
        scale_seed_z: "1",
        surf_text: "No surface attached",
        insp_kind_text: "Node3D",
        insp_editable: true,
        insp_can_trs: true,
        insp_can_2d: false,
        apply_btn: widgets.button(identity, id_apply_btn, &zero_rect()) >>>,
        apply_lbl: widgets.styled_label(context, &"Apply Changes"),

        asset_meta_txt: widgets.selectable_text(context, identity, id_asset_meta, &zero_rect(), &"Import a .glb to place in scene") >>>,
        insp_hdr_txt: widgets.selectable_text(context, identity, id_insp_hdr, &zero_rect(), &"Inspector · Node3D") >>>,
        surf_info_txt: widgets.selectable_text(context, identity, id_surf_info, &zero_rect(), &"No surface attached") >>>,
        status_txt: widgets.selectable_text(context, identity, id_status_txt, &zero_rect(), &"Ready") >>>,

        modals: create_modals(context, identity, &snap)
    }

    set_text_ellipsis($&ed.asset_meta_txt, true)
    set_text_ellipsis($&ed.insp_hdr_txt, true)
    set_text_ellipsis($&ed.surf_info_txt, true)
    set_text_ellipsis($&ed.status_txt, true)
    ed.apply_custom_styles()
    ed.refresh_after_document_change(true, view)
    ed.sync_asset_meta_text()
    ed.sync_status_text()
    << ed
}

fn min_int_val(a int, b int) int {
    if a < b { << a }
    << b
}

pub fn (ed $&Editor) dispose(view $&widgets.View) {
    view.dispose()
    mods := $&ed.modals
    mods.dispose()
    dispose_field($&ed.name_field)
    dispose_field($&ed.prim_field)
    dispose_field($&ed.pos_x)
    dispose_field($&ed.pos_y)
    dispose_field($&ed.pos_z)
    dispose_field($&ed.rot_x)
    dispose_field($&ed.rot_y)
    dispose_field($&ed.rot_z)
    dispose_field($&ed.scale_x)
    dispose_field($&ed.scale_y)
    dispose_field($&ed.scale_z)
    dispose_tree($&ed.tree)
    dispose_sel_text($&ed.asset_meta_txt)
    dispose_sel_text($&ed.insp_hdr_txt)
    dispose_sel_text($&ed.surf_info_txt)
    dispose_sel_text($&ed.status_txt)
    dispose_label($&ed.new_scene_lbl)
    dispose_label($&ed.undo_lbl)
    dispose_label($&ed.redo_lbl)
    dispose_label($&ed.save_lbl)
    dispose_label($&ed.preview_lbl)
    dispose_label($&ed.add_3d_lbl)
    dispose_label($&ed.add_grp_lbl)
    dispose_label($&ed.dup_lbl)
    dispose_label($&ed.del_lbl)
    dispose_label($&ed.import_lbl)
    dispose_label($&ed.place_lbl)
    dispose_label($&ed.fit_lbl)
    dispose_label($&ed.view3d_lbl)
    dispose_label($&ed.snap_lbl)
    dispose_label($&ed.visible_lbl)
    dispose_label($&ed.reparent_lbl)
    dispose_label($&ed.apply_lbl)
    dispose_label($&ed.empty_lbl)
    dispose_label($&ed.no_asset_lbl)
    dispose_label($&ed.root_parent_lbl)
    for i in 0:ed.scene_labels.len { dispose_label($&ed.scene_labels[i]) }
    for i in 0:ed.asset_labels.len { dispose_label($&ed.asset_labels[i]) }
    for i in 0:ed.parent_labels.len { dispose_label($&ed.parent_labels[i]) }
}

fn (ed $&Editor) apply_custom_styles() {
    compact := compact_button_style(&ed.styles, widgets.BUTTON_SECONDARY)
    subtle := compact_button_style(&ed.styles, widgets.BUTTON_SUBTLE)
    danger := compact_button_style(&ed.styles, widgets.BUTTON_DANGER)
    primary := ed.styles.button_variant(widgets.BUTTON_PRIMARY) >>> (err) {
        _ := err
        <<
    }
    set_btn_style($&ed.new_scene_btn, &compact)
    set_btn_style($&ed.undo_btn, &subtle)
    set_btn_style($&ed.redo_btn, &subtle)
    set_btn_style($&ed.preview_btn, &compact)
    set_btn_style($&ed.add_3d_btn, &subtle)
    set_btn_style($&ed.add_grp_btn, &subtle)
    set_btn_style($&ed.dup_btn, &subtle)
    set_btn_style($&ed.del_btn, &danger)
    set_btn_style($&ed.import_btn, &compact)
    set_btn_style($&ed.place_btn, &compact)
    set_btn_style($&ed.fit_btn, &subtle)
    set_btn_style($&ed.view3d_btn, &compact)
    set_btn_style($&ed.snap_btn, &compact)
    set_btn_style($&ed.reparent_btn, &compact)
    set_btn_style($&ed.apply_btn, &primary)

    cf := compact_field_style(&ed.styles)
    set_field_style($&ed.prim_field, &cf)
    set_field_style($&ed.pos_x, &cf)
    set_field_style($&ed.pos_y, &cf)
    set_field_style($&ed.pos_z, &cf)
    set_field_style($&ed.rot_x, &cf)
    set_field_style($&ed.rot_y, &cf)
    set_field_style($&ed.rot_z, &cf)
    set_field_style($&ed.scale_x, &cf)
    set_field_style($&ed.scale_y, &cf)
    set_field_style($&ed.scale_z, &cf)

    st_meta := selectable_text_style(&ed.styles, &ed.pal, 11.0, ed.pal.muted)
    st_hdr := selectable_text_style(&ed.styles, &ed.pal, 13.0, ed.pal.text)
    set_text_style($&ed.asset_meta_txt, &st_meta)
    set_text_style($&ed.surf_info_txt, &st_meta)
    set_text_style($&ed.insp_hdr_txt, &st_hdr)
    ed.sync_status_text()
}

pub fn (ed $&Editor) sync_status_text() {
    $col := ed.pal.muted
    if ed.status_kind == STATUS_OK { col = ed.pal.success }
    else if ed.status_kind == STATUS_ERR { col = ed.pal.danger }
    st := selectable_text_style(&ed.styles, &ed.pal, 12.0, col)
    set_text_style($&ed.status_txt, &st)
    msg := ed.status_text + ""
    set_text_val($&ed.status_txt, &msg)
}

pub fn (ed $&Editor) sync_asset_meta_text() {
    $meta := "Import a .glb to place in scene"
    sel := ed.asset_select.selected()
    if sel >= 0 && sel < ed.project.assets.len {
        meta = ed.project.assets[sel].path + " (" + ed.project.assets[sel].key[0:8] + ")"
    }
    set_text_val($&ed.asset_meta_txt, &meta)
}

pub fn (ed &Editor) repaint_all(view $&widgets.View) {
    repaint(view, ed.id_toolbar)
    repaint(view, ed.id_left_pane)
    repaint(view, ed.id_top_view)
    repaint(view, ed.id_center_pane)
    repaint(view, ed.id_right_pane)
    repaint(view, ed.id_footer)
    repaint(view, ed.id_root)
}

pub fn (ed $&Editor) set_status(kind int, msg string, view $&widgets.View) {
    ed.status_kind = kind
    ed.status_text = msg
    ed.sync_status_text()
    repaint(view, ed.id_footer)
}

fn (ed $&Editor) clamp_widths(w f64) {
    avail := w - f64(SPLITTER_W) * 2.0
    max_left := math.max(f64(MIN_LEFT_W), avail - f64(MIN_CENTER_W) - f64(MIN_RIGHT_W))
    if ed.left_w < f64(MIN_LEFT_W) { ed.left_w = f64(MIN_LEFT_W) }
    if ed.left_w > max_left { ed.left_w = max_left }
    max_right := math.max(f64(MIN_RIGHT_W), avail - ed.left_w - f64(MIN_CENTER_W))
    if ed.right_w < f64(MIN_RIGHT_W) { ed.right_w = f64(MIN_RIGHT_W) }
    if ed.right_w > max_right { ed.right_w = max_right }
}

pub fn (ed $&Editor) sync_layout(view $&widgets.View, width f64, height f64) int {
    ed.viewport_w = math.max(f64(MIN_WINDOW_W), width)
    ed.viewport_h = math.max(f64(MIN_WINDOW_H), height)
    ed.clamp_widths(ed.viewport_w)

    body_h := ed.viewport_h - f64(TOOLBAR_H) - f64(FOOTER_H)
    center_w := math.max(f64(MIN_CENTER_W), ed.viewport_w - ed.left_w - ed.right_w - f64(SPLITTER_W) * 2.0)

    $rb := col_box(ed.viewport_w, ed.viewport_h, 0.0)
    rb.clip = true
    view.set_style(ed.id_root, &rb) >>>
    $tb := row_box(ed.viewport_w, f64(TOOLBAR_H), 6.0)
    tb.padding = layout.Insets{left: 10.0, top: 6.0, right: 10.0, bottom: 6.0}
    view.set_style(ed.id_toolbar, &tb) >>>
    view.set_style(ed.id_workspace, &row_box(ed.viewport_w, body_h, 0.0)) >>>

    $lp := col_box(ed.left_w, body_h, 6.0)
    lp.padding = layout.Insets{left: 8.0, top: 8.0, right: 8.0, bottom: 8.0}
    view.set_style(ed.id_left_pane, &lp) >>>
    ilw := ed.left_w - 16.0
    tree_h := math.max(120.0, body_h - 246.0)
    view.set_style(ed.id_tree_hdr, &leaf_box(ilw, 22.0)) >>>
    view.set_style(ed.id_tree_btns, &row_box(ilw, 28.0, 4.0)) >>>
    bw := math.max(40.0, (ilw - 12.0) / 4.0)
    view.set_style(ed.id_add_3d_btn, &leaf_box(bw, 26.0)) >>>
    view.set_style(ed.id_add_grp_btn, &leaf_box(bw, 26.0)) >>>
    view.set_style(ed.id_dup_btn, &leaf_box(bw, 26.0)) >>>
    view.set_style(ed.id_del_btn, &leaf_box(bw, 26.0)) >>>
    view.set_style(ed.id_tree, &leaf_box(ilw, tree_h)) >>>
    view.set_style(ed.id_assets_div, &leaf_box(ilw, 4.0)) >>>
    view.set_style(ed.id_assets_hdr_row, &row_box(ilw, 28.0, 6.0)) >>>
    view.set_style(ed.id_assets_hdr, &leaf_box(math.max(50.0, ilw - 120.0), 24.0)) >>>
    view.set_style(ed.id_import_btn, &leaf_box(114.0, 26.0)) >>>
    view.set_style(ed.id_asset_select, &leaf_box(ilw, 30.0)) >>>
    view.set_style(ed.id_asset_meta, &leaf_box(ilw, 18.0)) >>>
    view.set_style(ed.id_asset_row, &row_box(ilw, 48.0, 6.0)) >>>
    view.set_style(ed.id_prim_field, &leaf_box(66.0, 46.0)) >>>
    view.set_style(ed.id_place_btn, &leaf_box(math.max(80.0, ilw - 72.0), 30.0)) >>>

    view.set_style(ed.id_left_split, &leaf_box(f64(SPLITTER_W), body_h)) >>>

    $cp := col_box(center_w, body_h, 6.0)
    cp.padding = layout.Insets{left: 8.0, top: 8.0, right: 8.0, bottom: 8.0}
    view.set_style(ed.id_center_pane, &cp) >>>
    icw := center_w - 16.0
    view.set_style(ed.id_stage_bar, &row_box(icw, 30.0, 6.0)) >>>
    view.set_style(ed.id_stage_title, &leaf_box(math.max(96.0, icw - 266.0), 26.0)) >>>
    view.set_style(ed.id_top_view, &leaf_box(icw, math.max(120.0, body_h - 52.0))) >>>

    view.set_style(ed.id_right_split, &leaf_box(f64(SPLITTER_W), body_h)) >>>

    $rp := col_box(ed.right_w, body_h, 4.0)
    rp.padding = layout.Insets{left: 8.0, top: 8.0, right: 8.0, bottom: 8.0}
    view.set_style(ed.id_right_pane, &rp) >>>
    irw := ed.right_w - 16.0
    tri_w := (irw - 8.0) / 3.0
    view.set_style(ed.id_insp_hdr, &leaf_box(irw, 22.0)) >>>
    view.set_style(ed.id_name_field, &leaf_box(irw, 62.0)) >>>
    view.set_style(ed.id_visible_chk, &leaf_box(irw, 26.0)) >>>
    view.set_style(ed.id_parent_row, &row_box(irw, 30.0, 6.0)) >>>
    view.set_style(ed.id_parent_select, &leaf_box(math.max(96.0, irw - 84.0), 28.0)) >>>
    view.set_style(ed.id_reparent_btn, &leaf_box(78.0, 28.0)) >>>
    view.set_style(ed.id_pos_lbl, &leaf_box(irw, 16.0)) >>>
    view.set_style(ed.id_pos_row, &row_box(irw, 44.0, 4.0)) >>>
    view.set_style(ed.id_pos_x, &leaf_box(tri_w, 44.0)) >>>
    view.set_style(ed.id_pos_y, &leaf_box(tri_w, 44.0)) >>>
    view.set_style(ed.id_pos_z, &leaf_box(tri_w, 44.0)) >>>
    view.set_style(ed.id_rot_lbl, &leaf_box(irw, 16.0)) >>>
    view.set_style(ed.id_rot_row, &row_box(irw, 44.0, 4.0)) >>>
    view.set_style(ed.id_rot_x, &leaf_box(tri_w, 44.0)) >>>
    view.set_style(ed.id_rot_y, &leaf_box(tri_w, 44.0)) >>>
    view.set_style(ed.id_rot_z, &leaf_box(tri_w, 44.0)) >>>
    view.set_style(ed.id_scale_lbl, &leaf_box(irw, 16.0)) >>>
    view.set_style(ed.id_scale_row, &row_box(irw, 44.0, 4.0)) >>>
    view.set_style(ed.id_scale_x, &leaf_box(tri_w, 44.0)) >>>
    view.set_style(ed.id_scale_y, &leaf_box(tri_w, 44.0)) >>>
    view.set_style(ed.id_scale_z, &leaf_box(tri_w, 44.0)) >>>
    view.set_style(ed.id_surf_info, &leaf_box(irw, 18.0)) >>>
    view.set_style(ed.id_apply_btn, &leaf_box(irw, 32.0)) >>>

    $fb := row_box(ed.viewport_w, f64(FOOTER_H), 8.0)
    fb.padding = layout.Insets{left: 10.0, top: 4.0, right: 10.0, bottom: 4.0}
    view.set_style(ed.id_footer, &fb) >>>
    $st_w := math.max(120.0, ed.viewport_w - 20.0)
    $hint_w := 0.0
    if ed.viewport_w >= 900.0 {
        st_w = math.max(180.0, ed.viewport_w - 416.0)
        hint_w = 384.0
    }
    view.set_style(ed.id_status_txt, &leaf_box(st_w, 20.0)) >>>
    view.set_style(ed.id_footer_hint, &leaf_box(hint_w, 20.0)) >>>

    constraints := layout.tight(ed.viewport_w, ed.viewport_h)
    _ := widgets.layout_styled(view, &constraints, ed) >>>

    ed.place_all_controls(view) >>>
    vw := ed.viewport_w
    vh := ed.viewport_h
    st := ed.styles.clone()
    mods := $&ed.modals
    mods.layout(vw, vh, &st)
    << 0
}

fn sync_local_box_button(view &widgets.View, id int, btn $&widgets.Button) int {
    nb := view.node_bounds(id) >>>
    << btn.set_bounds(&layout.Rect{x: 0.0, y: 0.0, width: nb.width, height: nb.height}) >>>
}

fn sync_local_box_select(view &widgets.View, id int, styles &widgets.Styles, canvas_h f64, sel $&widgets.Select) layout.Rect {
    nb := view.node_bounds(id) >>>
    _ := sel.set_bounds(&layout.Rect{x: 0.0, y: 0.0, width: nb.width, height: nb.height}) >>>
    _ := sel.apply_styles(styles) >>>
    pop := sel.popup_bounds(styles)
    sel.set_popup_above(nb.y + nb.height + pop.height + 6.0 > canvas_h)
    << nb
}

fn place_view_field(view &widgets.View, id int, styles &widgets.Styles, vp &layout.Rect, f $&widgets.Field) int {
    nb := view.node_bounds(id) >>>
    _ := f.place(&nb) >>>
    set_field_viewport(f, vp)
    << f.apply_styles(styles) >>>
}

fn place_view_text(view &widgets.View, id int, vp &layout.Rect, s $&widgets.SelectableText) int {
    nb := view.node_bounds(id) >>>
    set_text_bounds(s, &nb)
    set_text_viewport(s, vp)
    << 0
}

fn (ed $&Editor) place_all_controls(view &widgets.View) int {
    st := ed.styles.clone()
    vh := ed.viewport_h
    vp := layout.Rect{x: 0.0, y: 0.0, width: ed.viewport_w, height: ed.viewport_h}
    sc_id := ed.id_scene_select
    ed.scene_origin = sync_local_box_select(view, sc_id, &st, vh, $&ed.scene_select) >>>
    as_id := ed.id_asset_select
    ed.asset_origin = sync_local_box_select(view, as_id, &st, vh, $&ed.asset_select) >>>
    pa_id := ed.id_parent_select
    ed.parent_origin = sync_local_box_select(view, pa_id, &st, vh, $&ed.parent_select) >>>

    sync_local_box_button(view, ed.id_new_scene_btn, $&ed.new_scene_btn) >>>
    sync_local_box_button(view, ed.id_undo_btn, $&ed.undo_btn) >>>
    sync_local_box_button(view, ed.id_redo_btn, $&ed.redo_btn) >>>
    sync_local_box_button(view, ed.id_save_btn, $&ed.save_btn) >>>
    sync_local_box_button(view, ed.id_preview_btn, $&ed.preview_btn) >>>

    sync_local_box_button(view, ed.id_add_3d_btn, $&ed.add_3d_btn) >>>
    sync_local_box_button(view, ed.id_add_grp_btn, $&ed.add_grp_btn) >>>
    sync_local_box_button(view, ed.id_dup_btn, $&ed.dup_btn) >>>
    sync_local_box_button(view, ed.id_del_btn, $&ed.del_btn) >>>

    tb := view.node_bounds(ed.id_tree) >>>
    ed.tree_origin = copy_rect(&tb)
    tr := $&ed.tree
    _ := tr.set_bounds(&layout.Rect{x: 0.0, y: 0.0, width: tb.width, height: tb.height}) >>>
    _ := tr.apply_styles(&st) >>>
    tr.set_viewport(&layout.Rect{x: -tb.x, y: -tb.y, width: vp.width, height: vp.height})

    db := view.node_bounds(ed.id_assets_div) >>>
    ad := $&ed.assets_div
    _ := ad.set_bounds(&layout.Rect{x: 0.0, y: 0.0, width: db.width, height: db.height}) >>>
    sync_local_box_button(view, ed.id_import_btn, $&ed.import_btn) >>>
    place_view_text(view, ed.id_asset_meta, &vp, $&ed.asset_meta_txt) >>>
    place_view_field(view, ed.id_prim_field, &st, &vp, $&ed.prim_field) >>>
    sync_local_box_button(view, ed.id_place_btn, $&ed.place_btn) >>>

    sync_local_box_button(view, ed.id_fit_btn, $&ed.fit_btn) >>>
    sync_local_box_button(view, ed.id_view3d_btn, $&ed.view3d_btn) >>>
    sync_local_box_button(view, ed.id_snap_btn, $&ed.snap_btn) >>>
    tvb := view.node_bounds(ed.id_top_view) >>>
    ed.top_view_local = layout.Rect{x: 0.0, y: 0.0, width: tvb.width, height: tvb.height}

    place_view_text(view, ed.id_insp_hdr, &vp, $&ed.insp_hdr_txt) >>>
    place_view_field(view, ed.id_name_field, &st, &vp, $&ed.name_field) >>>
    vb := view.node_bounds(ed.id_visible_chk) >>>
    vc := $&ed.visible_chk
    _ := vc.set_bounds(&layout.Rect{x: 0.0, y: 0.0, width: vb.width, height: vb.height}) >>>
    sync_local_box_button(view, ed.id_reparent_btn, $&ed.reparent_btn) >>>

    place_view_field(view, ed.id_pos_x, &st, &vp, $&ed.pos_x) >>>
    place_view_field(view, ed.id_pos_y, &st, &vp, $&ed.pos_y) >>>
    place_view_field(view, ed.id_pos_z, &st, &vp, $&ed.pos_z) >>>
    place_view_field(view, ed.id_rot_x, &st, &vp, $&ed.rot_x) >>>
    place_view_field(view, ed.id_rot_y, &st, &vp, $&ed.rot_y) >>>
    place_view_field(view, ed.id_rot_z, &st, &vp, $&ed.rot_z) >>>
    place_view_field(view, ed.id_scale_x, &st, &vp, $&ed.scale_x) >>>
    place_view_field(view, ed.id_scale_y, &st, &vp, $&ed.scale_y) >>>
    place_view_field(view, ed.id_scale_z, &st, &vp, $&ed.scale_z) >>>
    place_view_text(view, ed.id_surf_info, &vp, $&ed.surf_info_txt) >>>
    sync_local_box_button(view, ed.id_apply_btn, $&ed.apply_btn) >>>
    place_view_text(view, ed.id_status_txt, &vp, $&ed.status_txt) >>>
    << 0
}

pub fn (ed $&Editor) sync_toolbar_states() {
    c_undo := ed.draft.can_undo()
    c_redo := ed.draft.can_redo()
    c_vp := !ed.viewport_active
    c_pv := !ed.preview_active
    c_im := !ed.import_active
    has_sel := ed.selected_node > 0
    can_rep := has_sel && ed.parent_candidates.len > 0
    has_assets := ed.project.assets.len > 0
    placing := ed.placing_mode
    is_dirty := ed.draft.dirty()
    st_danger := compact_button_style(&ed.styles, widgets.BUTTON_DANGER)
    st_sec := compact_button_style(&ed.styles, widgets.BUTTON_SECONDARY)
    st_pri := compact_button_style(&ed.styles, widgets.BUTTON_PRIMARY)
    st_out := compact_button_style(&ed.styles, widgets.BUTTON_OUTLINE)

    set_btn_enabled($&ed.undo_btn, c_undo)
    set_btn_enabled($&ed.redo_btn, c_redo)
    set_btn_enabled($&ed.view3d_btn, c_vp)
    set_btn_enabled($&ed.preview_btn, c_pv)
    set_btn_enabled($&ed.import_btn, c_im)
    set_btn_enabled($&ed.dup_btn, has_sel)
    set_btn_enabled($&ed.del_btn, has_sel)
    set_btn_enabled($&ed.reparent_btn, can_rep)
    set_sel_enabled($&ed.parent_select, can_rep)
    set_btn_enabled($&ed.place_btn, has_assets)
    if placing {
        set_lbl_text($&ed.place_lbl, &"Cancel Place")
        set_btn_style($&ed.place_btn, &st_danger)
    } else {
        set_lbl_text($&ed.place_lbl, &"Place GLB")
        set_btn_style($&ed.place_btn, &st_sec)
    }
    if is_dirty {
        set_btn_style($&ed.save_btn, &st_pri)
    } else {
        set_btn_style($&ed.save_btn, &st_out)
    }
}

pub fn (ed $&Editor) refresh_project_selectors() {
    for i in 0:ed.scene_labels.len { dispose_label($&ed.scene_labels[i]) }
    ed.scene_labels = []widgets.StyledLabel{}
    sc_n := min_int_val(ed.project.scenes.len, 64)
    for i in 0:sc_n {
        k := ed.project.scenes[i].key + ""
        ed.scene_labels.push(widgets.styled_label(&ed.context, &k))
    }
    set_sel_count($&ed.scene_select, sc_n)
    if sc_n > 0 && ed.scene_index >= 0 && ed.scene_index < sc_n {
        sidx := ed.scene_index
        set_sel_selected($&ed.scene_select, sidx)
    }

    for i in 0:ed.asset_labels.len { dispose_label($&ed.asset_labels[i]) }
    ed.asset_labels = []widgets.StyledLabel{}
    as_n := min_int_val(ed.project.assets.len, 64)
    prev_sel := ed.asset_select.selected()
    for i in 0:as_n {
        b := filepath.base(&ed.project.assets[i].path)
        ed.asset_labels.push(widgets.styled_label(&ed.context, &b))
    }
    set_sel_count($&ed.asset_select, as_n)
    if as_n > 0 {
        $next_sel := prev_sel
        if next_sel < 0 || next_sel >= as_n { next_sel = 0 }
        set_sel_selected($&ed.asset_select, next_sel)
    }
    ed.sync_asset_meta_text()
}

pub fn (ed $&Editor) rebuild_tree(doc &resource.Document) {
    tree_begin_update($&ed.tree)
    tree_clear($&ed.tree)
    ed.tree_to_scene = map[int]int{}
    ed.scene_to_tree = map[int]int{}

    $has_surf := map[int]bool{}
    for i in 0:doc.surface_count() {
        s := doc.surface(i) >>> (err) { <- }
        has_surf[s.node] = true
    }

    for i in 0:doc.node_count() {
        nd := doc.describe_node(i) >>> (err) { <- }
        $tparent := -1
        if nd.parent >= 0 && ed.scene_to_tree.has(nd.parent) {
            tparent = ed.scene_to_tree[nd.parent]
        }
        tid := tree_add_node($&ed.tree, tparent, &nd.name) >>> (err) { <- }
        ed.scene_to_tree[i] = tid
        ed.tree_to_scene[tid] = i
        $tag := "Grp"
        if nd.kind == resource.NODE_3D { tag = "3D" }
        else if nd.kind == resource.NODE_2D { tag = "2D" }
        if has_surf.has(i) { tag = "GLB" }
        if !nd.visible { tag = tag + " (hidden)" }
        tree_set_meta($&ed.tree, tid, &tag)
        tree_set_exp($&ed.tree, tid, true)
    }
    if ed.selected_node < 0 || ed.selected_node >= doc.node_count() {
        ed.selected_node = 0
    }
    if ed.scene_to_tree.has(ed.selected_node) {
        sel_tid := ed.scene_to_tree[ed.selected_node]
        tree_set_sel($&ed.tree, sel_tid)
    }
    tree_end_update($&ed.tree)
}

fn subtree_mask(doc &resource.Document, root_idx int) map[int]bool {
    $mask := map[int]bool{}
    if root_idx < 0 || root_idx >= doc.node_count() { << mask }
    mask[root_idx] = true
    for i in (root_idx + 1):doc.node_count() {
        nd := doc.describe_node(i) >>> (err) { << mask }
        if mask.has(nd.parent) {
            mask[i] = true
        }
    }
    << mask
}

fn (ed $&Editor) rebuild_parent_choices(doc &resource.Document, cur_parent int) {
    for i in 0:ed.parent_labels.len { dispose_label($&ed.parent_labels[i]) }
    ed.parent_labels = []widgets.StyledLabel{}
    ed.parent_candidates = []int{}

    if ed.selected_node <= 0 || ed.selected_node >= doc.node_count() {
        ed.parent_labels.push(widgets.styled_label(&ed.context, &"(root)"))
        set_sel_count($&ed.parent_select, 1)
        set_sel_selected($&ed.parent_select, 0)
        <<
    }

    blocked := subtree_mask(doc, ed.selected_node)
    $sel_pos := 0
    // Always include current parent & root first so select never exceeds 64 limit without them.
    $added := map[int]bool{}
    $order := []int{}
    if cur_parent >= 0 && cur_parent < doc.node_count() && !blocked.has(cur_parent) {
        order.push(cur_parent)
        added[cur_parent] = true
    }
    if !added.has(0) && !blocked.has(0) {
        order.push(0)
        added[0] = true
    }
    for i in 0:doc.node_count() {
        if order.len >= 64 { <- }
        if !added.has(i) && !blocked.has(i) {
            order.push(i)
            added[i] = true
        }
    }
    for k in 0:order.len {
        cid := order[k]
        nd := doc.describe_node(cid) >>> (err) { -> }
        if cid == cur_parent { sel_pos = ed.parent_candidates.len }
        ed.parent_candidates.push(cid)
        lbl := "[" + str(cid) + "] " + nd.name
        ed.parent_labels.push(widgets.styled_label(&ed.context, &lbl))
    }
    if ed.parent_candidates.len == 0 {
        ed.parent_labels.push(widgets.styled_label(&ed.context, &"(none)"))
        set_sel_count($&ed.parent_select, 1)
        set_sel_selected($&ed.parent_select, 0)
        <<
    }
    cand_len := ed.parent_candidates.len
    set_sel_count($&ed.parent_select, cand_len)
    set_sel_selected($&ed.parent_select, sel_pos)
}

pub fn (ed $&Editor) sync_inspector(doc &resource.Document) {
    if ed.selected_node < 0 || ed.selected_node >= doc.node_count() {
        ed.selected_node = 0
    }
    nd := doc.describe_node(ed.selected_node) >>> (err) { << }
    $klabel := "Node (Group)"
    if nd.kind == resource.NODE_3D { klabel = "Node3D" }
    else if nd.kind == resource.NODE_2D { klabel = "Node2D" }
    if ed.selected_node == 0 { klabel = klabel + " · Root" }
    ed.insp_kind_text = "Inspector · " + klabel
    hdr_copy := ed.insp_kind_text + ""
    set_text_val($&ed.insp_hdr_txt, &hdr_copy)

    ed.insp_editable = true
    ed.insp_can_trs = nd.kind == resource.NODE_3D
    ed.insp_can_2d = nd.kind == resource.NODE_2D

    set_field_val($&ed.name_field, &nd.name)
    ed.name_error = ""
    ed.refresh_name_decoration(&nd.name)
    set_chk_val($&ed.visible_chk, nd.visible)
    ed.rebuild_parent_choices(doc, nd.parent)

    if nd.kind == resource.NODE_3D {
        trs := decompose_trs(&nd.local_3d)
        set_field_val($&ed.pos_x, &fmt_coord(trs.position.x))
        set_field_val($&ed.pos_y, &fmt_coord(trs.position.y))
        set_field_val($&ed.pos_z, &fmt_coord(trs.position.z))
        ed.rot_seed_x = fmt_coord(trs.rotation_deg.x)
        ed.rot_seed_y = fmt_coord(trs.rotation_deg.y)
        ed.rot_seed_z = fmt_coord(trs.rotation_deg.z)
        rx := ed.rot_seed_x + ""
        ry := ed.rot_seed_y + ""
        rz := ed.rot_seed_z + ""
        set_field_val($&ed.rot_x, &rx)
        set_field_val($&ed.rot_y, &ry)
        set_field_val($&ed.rot_z, &rz)
        ed.scale_seed_x = fmt_coord(trs.scale.x)
        ed.scale_seed_y = fmt_coord(trs.scale.y)
        ed.scale_seed_z = fmt_coord(trs.scale.z)
        sx := ed.scale_seed_x + ""
        sy := ed.scale_seed_y + ""
        sz := ed.scale_seed_z + ""
        set_field_val($&ed.scale_x, &sx)
        set_field_val($&ed.scale_y, &sy)
        set_field_val($&ed.scale_z, &sz)
    } else if nd.kind == resource.NODE_2D {
        set_field_val($&ed.pos_x, &fmt_coord(nd.local.tx))
        set_field_val($&ed.pos_y, &fmt_coord(nd.local.ty))
        set_field_val($&ed.pos_z, &"0")
        set_field_val($&ed.rot_x, &"0")
        set_field_val($&ed.rot_y, &"0")
        set_field_val($&ed.rot_z, &"0")
        set_field_val($&ed.scale_x, &"1")
        set_field_val($&ed.scale_y, &"1")
        set_field_val($&ed.scale_z, &"1")
    } else {
        set_field_val($&ed.pos_x, &"0")
        set_field_val($&ed.pos_y, &"0")
        set_field_val($&ed.pos_z, &"0")
        set_field_val($&ed.rot_x, &"0")
        set_field_val($&ed.rot_y, &"0")
        set_field_val($&ed.rot_z, &"0")
        set_field_val($&ed.scale_x, &"1")
        set_field_val($&ed.scale_y, &"1")
        set_field_val($&ed.scale_z, &"1")
    }

    can_xy := ed.insp_can_trs || ed.insp_can_2d
    can_3d := ed.insp_can_trs
    enable_field($&ed.pos_x, can_xy)
    enable_field($&ed.pos_y, can_xy)
    enable_field($&ed.pos_z, can_3d)
    enable_field($&ed.rot_x, can_3d)
    enable_field($&ed.rot_y, can_3d)
    enable_field($&ed.rot_z, can_3d)
    enable_field($&ed.scale_x, can_3d)
    enable_field($&ed.scale_y, can_3d)
    enable_field($&ed.scale_z, can_3d)

    ed.surf_text = "No GLB surface attached"
    for i in 0:doc.surface_count() {
        s := doc.surface(i) >>> (err) { <- }
        if s.node == ed.selected_node {
            $aname := s.resource_uid
            for j in 0:ed.project.assets.len {
                if ed.project.assets[j].key == s.resource_uid {
                    aname = filepath.base(&ed.project.assets[j].path)
                }
            }
            ed.surf_text = "Surface: " + aname + " · prim " + str(s.primitive)
            <-
        }
    }
    surf_copy := ed.surf_text + ""
    set_text_val($&ed.surf_info_txt, &surf_copy)
}

fn (ed $&Editor) refresh_name_decoration(val &string) {
    $dec := widgets.field_decoration(&"Name *")
    dec.clearable = true
    dec.helper = byte_counter_text(val, 255)
    dec.error = ed.name_error + ""
    name_bad := ed.name_error.len > 0
    set_field_dec($&ed.name_field, &dec)
    set_field_inv($&ed.name_field, name_bad)
}

pub fn (ed $&Editor) refresh_after_document_change(fit_stage bool, view $&widgets.View) {
    doc := ed.draft.document() >>> (err) {
        ed.set_status(STATUS_ERR, err.msg(), view)
        <<
    }
    ed.stage_pts = extract_stage_points(&doc)
    if fit_stage {
        $fit_b := ed.top_view_local
        if fit_b.width < 40.0 || fit_b.height < 40.0 {
            fit_b = layout.Rect{x: 0.0, y: 0.0, width: 580.0, height: 520.0}
        }
        pts := clone_stage_points(&ed.stage_pts)
        tv := $&ed.top_view
        tv.fit_points(&pts, &fit_b)
    }
    ed.rebuild_tree(&doc)
    ed.sync_inspector(&doc)
    ed.sync_toolbar_states()
    ed.repaint_all(view)
}

pub fn (ed $&Editor) select_scene_node(index int, view $&widgets.View) {
    doc := ed.draft.document() >>> (err) { << }
    if index < 0 || index >= doc.node_count() { << }
    ed.selected_node = index
    if ed.scene_to_tree.has(index) {
        sel_tid := ed.scene_to_tree[index]
        tree_set_sel($&ed.tree, sel_tid)
        tree_reveal_sel($&ed.tree)
    }
    ed.sync_inspector(&doc)
    ed.sync_toolbar_states()
    repaint(view, ed.id_left_pane)
    repaint(view, ed.id_top_view)
    repaint(view, ed.id_right_pane)
}

pub fn (ed $&Editor) apply_inspector(view $&widgets.View) int {
    raw_name := ed.name_field.value()
    trimmed := strings.trim_space(&raw_name)
    if !valid_node_name(&trimmed) {
        ed.name_error = "1..255 bytes; no /, ., .. or control chars"
        ed.refresh_name_decoration(&raw_name)
        ed.set_status(STATUS_ERR, "Invalid node name", view)
        repaint(view, ed.id_right_pane)
        >>> errors.new("nexus editor: invalid node name")
    }
    px := parse_f64_or(&ed.pos_x.value(), "Position X") >>> (err) {
        ed.set_status(STATUS_ERR, err.msg(), view)
        >>> err
    }
    py := parse_f64_or(&ed.pos_y.value(), "Position Y") >>> (err) {
        ed.set_status(STATUS_ERR, err.msg(), view)
        >>> err
    }
    pz := parse_f64_or(&ed.pos_z.value(), "Position Z") >>> (err) {
        ed.set_status(STATUS_ERR, err.msg(), view)
        >>> err
    }
    rx := parse_f64_or(&ed.rot_x.value(), "Rotation X") >>> (err) {
        ed.set_status(STATUS_ERR, err.msg(), view)
        >>> err
    }
    ry := parse_f64_or(&ed.rot_y.value(), "Rotation Y") >>> (err) {
        ed.set_status(STATUS_ERR, err.msg(), view)
        >>> err
    }
    rz := parse_f64_or(&ed.rot_z.value(), "Rotation Z") >>> (err) {
        ed.set_status(STATUS_ERR, err.msg(), view)
        >>> err
    }
    sx := parse_f64_or(&ed.scale_x.value(), "Scale X") >>> (err) {
        ed.set_status(STATUS_ERR, err.msg(), view)
        >>> err
    }
    sy := parse_f64_or(&ed.scale_y.value(), "Scale Y") >>> (err) {
        ed.set_status(STATUS_ERR, err.msg(), view)
        >>> err
    }
    sz := parse_f64_or(&ed.scale_z.value(), "Scale Z") >>> (err) {
        ed.set_status(STATUS_ERR, err.msg(), view)
        >>> err
    }

    rs_changed := ed.rot_x.value() != ed.rot_seed_x ||
        ed.rot_y.value() != ed.rot_seed_y ||
        ed.rot_z.value() != ed.rot_seed_z ||
        ed.scale_x.value() != ed.scale_seed_x ||
        ed.scale_y.value() != ed.scale_seed_y ||
        ed.scale_z.value() != ed.scale_seed_z

    sel_node := ed.selected_node
    vis := ed.visible_chk.value()
    name_copy := trimmed + ""
    d := $&ed.draft
    d.set_node_properties(
        sel_node,
        name_copy,
        vis,
        fm.vec3(px, py, pz),
        rs_changed,
        fm.vec3(rx, ry, rz),
        fm.vec3(sx, sy, sz)
    ) >>> (err) {
        ed.name_error = err.msg()
        ed.refresh_name_decoration(&raw_name)
        ed.set_status(STATUS_ERR, err.msg(), view)
        repaint(view, ed.id_right_pane)
        >>> err
    }

    ed.name_error = ""
    ed.refresh_after_document_change(false, view)
    ed.set_status(STATUS_OK, "Applied changes to " + trimmed, view)
    << 0
}

fn parse_f64_or(raw &string, label string) f64 {
    t := strings.trim_space(raw)
    if t.len == 0 {
        >>> errors.new(label + " is required")
    }
    v := strconv.parse_float(&t) >>> (err) {
        >>> errors.new(label + " must be a finite number")
    }
    if math.is_nan(v) || math.is_inf(v) {
        >>> errors.new(label + " must be a finite number")
    }
    << v
}

fn (ed $&Editor) blur_all_fields() {
    focus_field($&ed.name_field, false)
    focus_field($&ed.prim_field, false)
    focus_field($&ed.pos_x, false)
    focus_field($&ed.pos_y, false)
    focus_field($&ed.pos_z, false)
    focus_field($&ed.rot_x, false)
    focus_field($&ed.rot_y, false)
    focus_field($&ed.rot_z, false)
    focus_field($&ed.scale_x, false)
    focus_field($&ed.scale_y, false)
    focus_field($&ed.scale_z, false)
}

fn (ed $&Editor) open_snap_modal(view $&widgets.View) {
    ed.blur_all_fields()
    sn := ed.snap
    vw := ed.viewport_w
    vh := ed.viewport_h
    st := ed.styles.clone()
    mods := $&ed.modals
    mods.open_snap(&sn)
    mods.layout(vw, vh, &st)
    repaint(view, ed.id_root)
}

fn (ed $&Editor) open_new_scene_modal(view $&widgets.View) {
    ed.blur_all_fields()
    vw := ed.viewport_w
    vh := ed.viewport_h
    st := ed.styles.clone()
    mods := $&ed.modals
    mods.open_new_scene()
    mods.layout(vw, vh, &st)
    repaint(view, ed.id_root)
}

fn (ed $&Editor) open_unsaved_modal(target_idx int, close_after bool, view $&widgets.View) {
    ed.blur_all_fields()
    vw := ed.viewport_w
    vh := ed.viewport_h
    st := ed.styles.clone()
    mods := $&ed.modals
    mods.open_unsaved(target_idx, close_after)
    mods.layout(vw, vh, &st)
    repaint(view, ed.id_root)
}

pub fn (ed $&Editor) switch_scene(target_idx int, check_dirty bool, view $&widgets.View) {
    if target_idx < 0 || target_idx >= ed.project.scenes.len || target_idx == ed.scene_index {
        sidx := ed.scene_index
        set_sel_selected($&ed.scene_select, sidx)
        <<
    }
    if check_dirty && ed.draft.dirty() {
        sidx := ed.scene_index
        set_sel_selected($&ed.scene_select, sidx)
        ed.open_unsaved_modal(target_idx, false, view)
        <<
    }
    path := ed.project.scene_source(target_idx) >>> (err) {
        ed.set_status(STATUS_ERR, err.msg(), view)
        <<
    }
    next_draft := open_draft(path) >>> (err) {
        ed.set_status(STATUS_ERR, err.msg(), view)
        <<
    }
    ed.scene_index = target_idx
    ed.draft = next_draft
    ed.selected_node = 0
    ed.placing_mode = false
    set_sel_selected($&ed.scene_select, target_idx)
    ed.refresh_after_document_change(true, view)
    ed.set_status(STATUS_INFO, "Opened " + ed.project.scenes[target_idx].key, view)
}

pub fn (ed $&Editor) do_save(view $&widgets.View) bool {
    proj := clone_project(&ed.project)
    vbin := ed.validator_bin + ""
    d := $&ed.draft
    d.save(&proj, &vbin) >>> (err) {
        ed.set_status(STATUS_ERR, err.msg(), view)
        << false
    }
    ed.sync_toolbar_states()
    repaint(view, ed.id_toolbar)
    ed.set_status(STATUS_OK, "Saved " + ed.project.scenes[ed.scene_index].key, view)
    << true
}

pub fn (ed $&Editor) do_undo(view $&widgets.View) {
    if !ed.draft.can_undo() { << }
    d := $&ed.draft
    _ := d.undo_edit()
    ed.refresh_after_document_change(false, view)
    ed.set_status(STATUS_INFO, "Undid edit", view)
}

pub fn (ed $&Editor) do_redo(view $&widgets.View) {
    if !ed.draft.can_redo() { << }
    d := $&ed.draft
    _ := d.redo_edit()
    ed.refresh_after_document_change(false, view)
    ed.set_status(STATUS_INFO, "Redid edit", view)
}

pub fn (ed $&Editor) do_add_node(kind int, base string, view $&widgets.View) {
    $parent := ed.selected_node
    if parent < 0 { parent = 0 }
    d := $&ed.draft
    new_idx := d.add_node_under(parent, kind, base + "") >>> (err) {
        ed.set_status(STATUS_ERR, err.msg(), view)
        <<
    }
    ed.selected_node = new_idx
    ed.refresh_after_document_change(false, view)
    ed.set_status(STATUS_OK, "Added " + base, view)
}

pub fn (ed $&Editor) do_duplicate_node(view $&widgets.View) {
    sel_node := ed.selected_node
    d := $&ed.draft
    new_idx := d.duplicate_node(sel_node) >>> (err) {
        ed.set_status(STATUS_ERR, err.msg(), view)
        <<
    }
    ed.selected_node = new_idx
    ed.refresh_after_document_change(false, view)
    ed.set_status(STATUS_OK, "Duplicated subtree", view)
}

pub fn (ed $&Editor) do_delete_node(view $&widgets.View) {
    sel_node := ed.selected_node
    d := $&ed.draft
    next_sel := d.delete_node(sel_node) >>> (err) {
        ed.set_status(STATUS_ERR, err.msg(), view)
        <<
    }
    ed.selected_node = next_sel
    ed.refresh_after_document_change(false, view)
    ed.set_status(STATUS_OK, "Deleted node subtree", view)
}

pub fn (ed $&Editor) do_reparent_selected(view $&widgets.View) {
    sel_opt := ed.parent_select.selected()
    if sel_opt < 0 || sel_opt >= ed.parent_candidates.len { << }
    target_parent := ed.parent_candidates[sel_opt]
    sel_node := ed.selected_node
    d := $&ed.draft
    next_idx := d.reparent_node(sel_node, target_parent, true) >>> (err) {
        ed.set_status(STATUS_ERR, err.msg(), view)
        <<
    }
    ed.selected_node = next_idx
    ed.refresh_after_document_change(false, view)
    ed.set_status(STATUS_OK, "Reparented node", view)
}

pub fn (ed $&Editor) do_place_at(wx f64, wz f64, view $&widgets.View) {
    idx := ed.asset_select.selected()
    if idx < 0 || idx >= ed.project.assets.len {
        ed.placing_mode = false
        ed.set_status(STATUS_ERR, "No GLB asset selected", view)
        <<
    }
    prim_txt := strings.trim_space(&ed.prim_field.value())
    $prim := 0
    if prim_txt.len > 0 {
        prim = strconv.atoi(&prim_txt) >>> (err) {
            ed.set_status(STATUS_ERR, "Primitive index must be a non-negative integer", view)
            <<
        }
    }
    uid := ed.project.assets[idx].key + ""
    proj := clone_project(&ed.project)
    d := $&ed.draft
    new_node := d.place_asset(&proj, uid, prim, wx, wz) >>> (err) {
        ed.set_status(STATUS_ERR, err.msg(), view)
        <<
    }
    ed.placing_mode = false
    ed.selected_node = new_node
    ed.refresh_after_document_change(false, view)
    ed.set_status(STATUS_OK, "Placed GLB at (" + fmt_coord(wx) + ", 0, " + fmt_coord(wz) + ")", view)
}

pub fn (ed $&Editor) submit_snap_modal(view $&widgets.View) {
    mv := ed.modals.snap_move.value()
    rt := ed.modals.snap_rotate.value()
    sc := ed.modals.snap_scale.value()
    res := validate_snap_inputs(&mv, &rt, &sc)
    mods := $&ed.modals
    mods.snap_move_err = res.move_err + ""
    mods.snap_rotate_err = res.rotate_err + ""
    mods.snap_scale_err = res.scale_err + ""
    mods.sync_snap_decorations()
    if !res.valid {
        ed.set_status(STATUS_ERR, "Fix invalid snap settings", view)
        repaint(view, ed.id_root)
        <<
    }
    save_snap_settings(&ed.output_dir, &res.settings) >>> (err) {
        mods2 := $&ed.modals
        mods2.snap_move_err = err.msg()
        mods2.sync_snap_decorations()
        ed.set_status(STATUS_ERR, err.msg(), view)
        repaint(view, ed.id_root)
        <<
    }
    ed.snap = res.settings
    modal_close($&ed.modals)
    repaint(view, ed.id_root)
    ed.set_status(STATUS_OK, "Saved snap settings", view)
}

pub fn (ed $&Editor) submit_new_scene_modal(view $&widgets.View) {
    raw_name := ed.modals.scene_name_field.value()
    raw_root := ed.modals.scene_root_field.value()
    new_key := create_scene(&ed.project.path, &raw_name, &raw_root) >>> (err) {
        mods := $&ed.modals
        mods.scene_err = err.msg()
        mods.sync_scene_decoration()
        ed.set_status(STATUS_ERR, err.msg(), view)
        repaint(view, ed.id_root)
        <<
    }
    reloaded := load_project(ed.project.path + "") >>> (err) {
        ed.set_status(STATUS_ERR, err.msg(), view)
        <<
    }
    ed.project = reloaded
    ed.refresh_project_selectors()
    $next_idx := 0
    for i in 0:ed.project.scenes.len {
        if ed.project.scenes[i].key == new_key {
            next_idx = i
        }
    }
    modal_close($&ed.modals)
    ed.scene_index = -1
    ed.switch_scene(next_idx, false, view)
    ed.set_status(STATUS_OK, "Created scene " + new_key, view)
}

// StyledPainter contract methods
pub fn (ed $&Editor) measure_styled(id int, styles &widgets.Styles) layout.Size {
    _ := id
    _ := styles
    << layout.Size{width: 0.0, height: 0.0}
}

pub fn (ed $&Editor) paint_styled(id int, bounds &layout.Rect, styles &widgets.Styles, frame $&draw.Frame) bool {
    ed.draw_node(id, frame, bounds, styles) >>> (err) {
        _ := err
        << false
    }
    << true
}

fn (ed $&Editor) draw_node(id int, frame $&draw.Frame, bounds &layout.Rect, styles &widgets.Styles) int {
    _ := styles
    if id == ed.id_toolbar {
        frame.fill_rect(0.0, 0.0, bounds.width, bounds.height, ed.pal.surface) >>>
        frame.line(0.0, bounds.height - 0.5, bounds.width, bounds.height - 0.5, ed.pal.border, 1.0) >>>
    } else if id == ed.id_brand {
        frame.fill_round_rect(0.0, 3.0, 58.0, 22.0, 6.0, ed.pal.brand) >>>
        frame.text(9.0, 6.0, 12.5, draw.rgb(255, 255, 255), &"Nexus") >>>
    } else if id == ed.id_dirty_badge {
        $lbl := "Saved"
        $bg := ed.pal.elevated
        $fg := ed.pal.muted
        if ed.draft.dirty() {
            lbl = "Unsaved"
            bg = draw.rgb(253, 236, 239)
            fg = ed.pal.brand
        }
        frame.fill_round_rect(0.0, 2.0, bounds.width, 22.0, 11.0, bg) >>>
        frame.text(12.0, 6.0, 11.5, fg, &lbl) >>>
    } else if id == ed.id_scene_select {
        sc := ed.scene_select.clone()
        sel := sc.selected()
        if sel >= 0 && sel < ed.scene_labels.len {
            sc.paint_styled(frame, $&ed.scene_labels[sel], styles) >>>
        } else {
            sc.paint_styled(frame, $&ed.empty_lbl, styles) >>>
        }
    } else if id == ed.id_new_scene_btn {
        b := ed.new_scene_btn.clone()
        b.paint_styled(frame, $&ed.new_scene_lbl, styles) >>>
    } else if id == ed.id_undo_btn {
        b := ed.undo_btn.clone()
        b.paint_styled(frame, $&ed.undo_lbl, styles) >>>
    } else if id == ed.id_redo_btn {
        b := ed.redo_btn.clone()
        b.paint_styled(frame, $&ed.redo_lbl, styles) >>>
    } else if id == ed.id_save_btn {
        b := ed.save_btn.clone()
        b.paint_styled(frame, $&ed.save_lbl, styles) >>>
    } else if id == ed.id_preview_btn {
        b := ed.preview_btn.clone()
        b.paint_styled(frame, $&ed.preview_lbl, styles) >>>
    } else if id == ed.id_left_pane {
        frame.fill_rect(0.0, 0.0, bounds.width, bounds.height, ed.pal.surface) >>>
    } else if id == ed.id_tree_hdr {
        hdr := "Scene Tree (" + str(ed.stage_pts.len) + ")"
        frame.text(0.0, 2.0, 13.0, ed.pal.text, &hdr) >>>
    } else if id == ed.id_add_3d_btn {
        b := ed.add_3d_btn.clone()
        b.paint_styled(frame, $&ed.add_3d_lbl, styles) >>>
    } else if id == ed.id_add_grp_btn {
        b := ed.add_grp_btn.clone()
        b.paint_styled(frame, $&ed.add_grp_lbl, styles) >>>
    } else if id == ed.id_dup_btn {
        b := ed.dup_btn.clone()
        b.paint_styled(frame, $&ed.dup_lbl, styles) >>>
    } else if id == ed.id_del_btn {
        b := ed.del_btn.clone()
        b.paint_styled(frame, $&ed.del_lbl, styles) >>>
    } else if id == ed.id_tree {
        paint_tree($&ed.tree, frame, styles) >>>
    } else if id == ed.id_assets_div {
        ed.assets_div.paint_styled(frame, styles) >>>
    } else if id == ed.id_assets_hdr {
        frame.text(0.0, 3.0, 13.0, ed.pal.text, &"Assets") >>>
    } else if id == ed.id_import_btn {
        b := ed.import_btn.clone()
        b.paint_styled(frame, $&ed.import_lbl, styles) >>>
    } else if id == ed.id_asset_select {
        asel := ed.asset_select.clone()
        sel := asel.selected()
        if sel >= 0 && sel < ed.asset_labels.len {
            asel.paint_styled(frame, $&ed.asset_labels[sel], styles) >>>
        } else {
            asel.paint_styled(frame, $&ed.no_asset_lbl, styles) >>>
        }
    } else if id == ed.id_asset_meta {
        paint_text_sel($&ed.asset_meta_txt, frame, styles) >>>
    } else if id == ed.id_prim_field {
        paint_field($&ed.prim_field, frame, styles) >>>
    } else if id == ed.id_place_btn {
        b := ed.place_btn.clone()
        b.paint_styled(frame, $&ed.place_lbl, styles) >>>
    } else if id == ed.id_left_split || id == ed.id_right_split {
        frame.fill_rect(0.0, 0.0, bounds.width, bounds.height, ed.pal.canvas) >>>
        $col := ed.pal.border
        if (id == ed.id_left_split && ed.dragging_split == 1) || (id == ed.id_right_split && ed.dragging_split == 2) {
            col = ed.pal.focus
        }
        frame.fill_round_rect(1.5, bounds.height * 0.5 - 16.0, 3.0, 32.0, 1.5, col) >>>
    } else if id == ed.id_stage_title {
        frame.text(2.0, 5.0, 13.5, ed.pal.text, &"Top View · XZ") >>>
    } else if id == ed.id_fit_btn {
        b := ed.fit_btn.clone()
        b.paint_styled(frame, $&ed.fit_lbl, styles) >>>
    } else if id == ed.id_view3d_btn {
        b := ed.view3d_btn.clone()
        b.paint_styled(frame, $&ed.view3d_lbl, styles) >>>
    } else if id == ed.id_snap_btn {
        b := ed.snap_btn.clone()
        b.paint_styled(frame, $&ed.snap_lbl, styles) >>>
    } else if id == ed.id_top_view {
        ctx := ed.context.clone()
        pts := clone_stage_points(&ed.stage_pts)
        sel_n := ed.selected_node
        placing := ed.placing_mode
        pal := ed.pal
        paint_top_view($&ed.top_view, &ctx, frame, bounds, &pts, sel_n, placing, &pal) >>>
    } else if id == ed.id_right_pane {
        frame.fill_rect(0.0, 0.0, bounds.width, bounds.height, ed.pal.surface) >>>
    } else if id == ed.id_insp_hdr {
        paint_text_sel($&ed.insp_hdr_txt, frame, styles) >>>
    } else if id == ed.id_name_field {
        paint_field($&ed.name_field, frame, styles) >>>
    } else if id == ed.id_visible_chk {
        chk := ed.visible_chk.clone()
        chk.paint_styled(frame, $&ed.visible_lbl, styles) >>>
    } else if id == ed.id_parent_select {
        ps := ed.parent_select.clone()
        psel := ps.selected()
        if psel >= 0 && psel < ed.parent_labels.len {
            ps.paint_styled(frame, $&ed.parent_labels[psel], styles) >>>
        } else {
            ps.paint_styled(frame, $&ed.root_parent_lbl, styles) >>>
        }
    } else if id == ed.id_reparent_btn {
        b := ed.reparent_btn.clone()
        b.paint_styled(frame, $&ed.reparent_lbl, styles) >>>
    } else if id == ed.id_pos_lbl {
        frame.text(0.0, 1.0, 11.5, ed.pal.muted, &"Position (X / Y / Z)") >>>
    } else if id == ed.id_pos_x { paint_field($&ed.pos_x, frame, styles) >>>
    } else if id == ed.id_pos_y { paint_field($&ed.pos_y, frame, styles) >>>
    } else if id == ed.id_pos_z { paint_field($&ed.pos_z, frame, styles) >>>
    } else if id == ed.id_rot_lbl {
        frame.text(0.0, 1.0, 11.5, ed.pal.muted, &"Rotation deg (X / Y / Z)") >>>
    } else if id == ed.id_rot_x { paint_field($&ed.rot_x, frame, styles) >>>
    } else if id == ed.id_rot_y { paint_field($&ed.rot_y, frame, styles) >>>
    } else if id == ed.id_rot_z { paint_field($&ed.rot_z, frame, styles) >>>
    } else if id == ed.id_scale_lbl {
        frame.text(0.0, 1.0, 11.5, ed.pal.muted, &"Scale (X / Y / Z)") >>>
    } else if id == ed.id_scale_x { paint_field($&ed.scale_x, frame, styles) >>>
    } else if id == ed.id_scale_y { paint_field($&ed.scale_y, frame, styles) >>>
    } else if id == ed.id_scale_z { paint_field($&ed.scale_z, frame, styles) >>>
    } else if id == ed.id_surf_info {
        paint_text_sel($&ed.surf_info_txt, frame, styles) >>>
    } else if id == ed.id_apply_btn {
        b := ed.apply_btn.clone()
        b.paint_styled(frame, $&ed.apply_lbl, styles) >>>
    } else if id == ed.id_footer {
        frame.fill_rect(0.0, 0.0, bounds.width, bounds.height, ed.pal.elevated) >>>
        frame.line(0.0, 0.5, bounds.width, 0.5, ed.pal.border, 1.0) >>>
        hint := "Cmd+S Save · Cmd+Z Undo · Cmd+Shift+Z Redo · F Fit · Esc Cancel"
        if bounds.width >= 900.0 {
            frame.text(bounds.width - 392.0, 6.0, 11.0, ed.pal.muted, &hint) >>>
        }
    } else if id == ed.id_status_txt {
        paint_text_sel($&ed.status_txt, frame, styles) >>>
    }
    << 0
}

fn paint_select_popup(sel &widgets.Select, labels $&[]widgets.StyledLabel, origin &layout.Rect, frame $&draw.Frame, styles &widgets.Styles) int {
    if !sel.is_open() { << 0 }
    frame.push() >>>
    frame.translate(origin.x, origin.y) >>>
    sel.paint_popup_box_styled(frame, styles) >>> (err) {
        _ := frame.pop()
        >>> err
    }
    for i in 0:labels.len {
        lbl := $&labels[i]
        sel.paint_option_styled(frame, i, lbl, styles) >>> (err) {
            _ := frame.pop()
            >>> err
        }
    }
    frame.pop() >>>
    << 0
}

pub fn (ed $&Editor) overlay_styled(id int, bounds &layout.Rect, styles &widgets.Styles, frame $&draw.Frame) bool {
    ed.draw_overlay(id, frame, bounds, styles) >>> (err) {
        _ := err
        << false
    }
    << true
}

fn (ed $&Editor) draw_overlay(id int, frame $&draw.Frame, bounds &layout.Rect, styles &widgets.Styles) int {
    if id != ed.id_root { << 0 }
    sc_sel := ed.scene_select.clone()
    sc_orig := copy_rect(&ed.scene_origin)
    paint_select_popup(&sc_sel, $&ed.scene_labels, &sc_orig, frame, styles) >>>
    as_sel := ed.asset_select.clone()
    as_orig := copy_rect(&ed.asset_origin)
    paint_select_popup(&as_sel, $&ed.asset_labels, &as_orig, frame, styles) >>>
    pa_sel := ed.parent_select.clone()
    pa_orig := copy_rect(&ed.parent_origin)
    paint_select_popup(&pa_sel, $&ed.parent_labels, &pa_orig, frame, styles) >>>
    if ed.tree.has_popup_open() {
        frame.push() >>>
        frame.translate(ed.tree_origin.x, ed.tree_origin.y) >>>
        tr := $&ed.tree
        tr.paint_popup_styled(frame, styles) >>> (err) {
            _ := frame.pop()
            >>> err
        }
        frame.pop() >>>
    }
    field_popup_paint($&ed.prim_field, frame, styles) >>>
    field_popup_paint($&ed.name_field, frame, styles) >>>
    field_popup_paint($&ed.pos_x, frame, styles) >>>
    field_popup_paint($&ed.pos_y, frame, styles) >>>
    field_popup_paint($&ed.pos_z, frame, styles) >>>
    field_popup_paint($&ed.rot_x, frame, styles) >>>
    field_popup_paint($&ed.rot_y, frame, styles) >>>
    field_popup_paint($&ed.rot_z, frame, styles) >>>
    field_popup_paint($&ed.scale_x, frame, styles) >>>
    field_popup_paint($&ed.scale_y, frame, styles) >>>
    field_popup_paint($&ed.scale_z, frame, styles) >>>
    paint_text_popup($&ed.asset_meta_txt, frame, styles) >>>
    paint_text_popup($&ed.insp_hdr_txt, frame, styles) >>>
    paint_text_popup($&ed.surf_info_txt, frame, styles) >>>
    paint_text_popup($&ed.status_txt, frame, styles) >>>
    pal := ed.pal
    mods := $&ed.modals
    mods.paint(frame, bounds, styles, &pal) >>>
    << 0
}

// InputHandler contract method (routes node-local inputs from View)
pub fn (ed $&Editor) input(id int, kind int, input &ui.InputEvent) widgets.Action {
    if kind == widgets.ROUTE_FOCUS {
        ed.focused_id = id
    } else if (kind == widgets.ROUTE_BLUR || kind == widgets.ROUTE_CANCEL) && ed.focused_id == id {
        ed.focused_id = 0
    }
    if id == ed.id_scene_select { << route_sel($&ed.scene_select, kind, input) }
    if id == ed.id_new_scene_btn { << route_btn($&ed.new_scene_btn, kind, input) }
    if id == ed.id_undo_btn { << route_btn($&ed.undo_btn, kind, input) }
    if id == ed.id_redo_btn { << route_btn($&ed.redo_btn, kind, input) }
    if id == ed.id_save_btn { << route_btn($&ed.save_btn, kind, input) }
    if id == ed.id_preview_btn { << route_btn($&ed.preview_btn, kind, input) }
    if id == ed.id_add_3d_btn { << route_btn($&ed.add_3d_btn, kind, input) }
    if id == ed.id_add_grp_btn { << route_btn($&ed.add_grp_btn, kind, input) }
    if id == ed.id_dup_btn { << route_btn($&ed.dup_btn, kind, input) }
    if id == ed.id_del_btn { << route_btn($&ed.del_btn, kind, input) }
    if id == ed.id_tree { << route_tree($&ed.tree, kind, input) }
    if id == ed.id_import_btn { << route_btn($&ed.import_btn, kind, input) }
    if id == ed.id_asset_select { << route_sel($&ed.asset_select, kind, input) }
    if id == ed.id_prim_field { << route_field($&ed.prim_field, kind, input) }
    if id == ed.id_place_btn { << route_btn($&ed.place_btn, kind, input) }
    if id == ed.id_fit_btn { << route_btn($&ed.fit_btn, kind, input) }
    if id == ed.id_view3d_btn { << route_btn($&ed.view3d_btn, kind, input) }
    if id == ed.id_snap_btn { << route_btn($&ed.snap_btn, kind, input) }
    if id == ed.id_visible_chk { << route_chk($&ed.visible_chk, kind, input) }
    if id == ed.id_parent_select { << route_sel($&ed.parent_select, kind, input) }
    if id == ed.id_reparent_btn { << route_btn($&ed.reparent_btn, kind, input) }
    if id == ed.id_apply_btn { << route_btn($&ed.apply_btn, kind, input) }
    if id == ed.id_name_field { << route_field($&ed.name_field, kind, input) }
    if id == ed.id_pos_x { << route_field($&ed.pos_x, kind, input) }
    if id == ed.id_pos_y { << route_field($&ed.pos_y, kind, input) }
    if id == ed.id_pos_z { << route_field($&ed.pos_z, kind, input) }
    if id == ed.id_rot_x { << route_field($&ed.rot_x, kind, input) }
    if id == ed.id_rot_y { << route_field($&ed.rot_y, kind, input) }
    if id == ed.id_rot_z { << route_field($&ed.rot_z, kind, input) }
    if id == ed.id_scale_x { << route_field($&ed.scale_x, kind, input) }
    if id == ed.id_scale_y { << route_field($&ed.scale_y, kind, input) }
    if id == ed.id_scale_z { << route_field($&ed.scale_z, kind, input) }
    if id == ed.id_asset_meta { << route_text($&ed.asset_meta_txt, kind, input) }
    if id == ed.id_insp_hdr { << route_text($&ed.insp_hdr_txt, kind, input) }
    if id == ed.id_surf_info { << route_text($&ed.surf_info_txt, kind, input) }
    if id == ed.id_status_txt { << route_text($&ed.status_txt, kind, input) }

    if id == ed.id_left_split || id == ed.id_right_split {
        << ed.route_splitter(id, input)
    }
    if id == ed.id_top_view {
        << ed.route_top_view(input)
    }
    << widgets.no_action(id, false)
}

fn (ed $&Editor) route_splitter(id int, input &ui.InputEvent) widgets.Action {
    $dirty := false
    $consumed := false
    if input.kind == ui.EV_POINTER_DOWN && input.button == ui.BUTTON_LEFT {
        if id == ed.id_left_split {
            ed.dragging_split = 1
            ed.split_orig_w = ed.left_w
            ed.split_start_gx = ed.left_w + input.x
        } else {
            ed.dragging_split = 2
            ed.split_orig_w = ed.right_w
            ed.split_start_gx = (ed.viewport_w - ed.right_w - f64(SPLITTER_W)) + input.x
        }
        consumed = true
        dirty = true
    } else if input.kind == ui.EV_POINTER_MOVE && ed.dragging_split != 0 {
        if ed.dragging_split == 1 && id == ed.id_left_split {
            cur_gx := ed.left_w + input.x
            ed.left_w = ed.split_orig_w + (cur_gx - ed.split_start_gx)
            ed.clamp_widths(ed.viewport_w)
            consumed = true
            dirty = true
        } else if ed.dragging_split == 2 && id == ed.id_right_split {
            cur_gx := (ed.viewport_w - ed.right_w - f64(SPLITTER_W)) + input.x
            ed.right_w = ed.split_orig_w - (cur_gx - ed.split_start_gx)
            ed.clamp_widths(ed.viewport_w)
            consumed = true
            dirty = true
        }
    } else if (input.kind == ui.EV_POINTER_UP && input.button == ui.BUTTON_LEFT) || input.kind == ui.EV_POINTER_CANCEL {
        if ed.dragging_split != 0 {
            ed.dragging_split = 0
            consumed = true
            dirty = true
        }
    }
    $kind := widgets.ACTION_NONE
    if dirty && ed.dragging_split != 0 { kind = widgets.ACTION_CHANGE }
    << widgets.Action{kind: kind, id: id, needs_paint: dirty, request_focus: false, consumed: consumed, value: 0.0}
}

fn (ed $&Editor) route_top_view(input &ui.InputEvent) widgets.Action {
    $dirty := false
    $consumed := false
    $act_kind := widgets.ACTION_NONE
    $picked := -1.0
    if input.kind == ui.EV_POINTER_SCROLL {
        tv_rect := copy_rect(&ed.top_view_local)
        tv := $&ed.top_view
        tv.zoom_around(&tv_rect, input.x, input.y, input.dy)
        dirty = true
        consumed = true
    } else if input.kind == ui.EV_POINTER_DOWN && (input.button == ui.BUTTON_RIGHT || input.button == ui.BUTTON_MIDDLE) {
        tv := $&ed.top_view
        tv.begin_pan(input.x, input.y)
        dirty = true
        consumed = true
    } else if input.kind == ui.EV_POINTER_MOVE {
        if ed.top_view.panning {
            tv := $&ed.top_view
            tv.update_pan(input.x, input.y)
            dirty = true
            consumed = true
        }
        if ed.placing_mode {
            ed.top_view.hover_x = screen_to_world_x(&ed.top_view, &ed.top_view_local, input.x)
            ed.top_view.hover_z = screen_to_world_z(&ed.top_view, &ed.top_view_local, input.y)
            ed.top_view.has_hover = true
            if ed.top_view.hover_node >= 0 { ed.top_view.hover_node = -1 }
            dirty = true
        } else if !ed.top_view.panning {
            hovered := pick_stage_node(&ed.top_view, &ed.top_view_local, &ed.stage_pts, input.x, input.y)
            if hovered != ed.top_view.hover_node {
                ed.top_view.hover_node = hovered
                dirty = true
            }
        }
    } else if input.kind == ui.EV_POINTER_UP && (input.button == ui.BUTTON_RIGHT || input.button == ui.BUTTON_MIDDLE) {
        if ed.top_view.panning {
            tv := $&ed.top_view
            tv.end_pan()
            dirty = true
            consumed = true
        }
    } else if input.kind == ui.EV_POINTER_LEAVE || input.kind == ui.EV_POINTER_CANCEL {
        if ed.top_view.hover_node >= 0 || ed.top_view.has_hover {
            ed.top_view.hover_node = -1
            ed.top_view.has_hover = false
            dirty = true
        }
        if input.kind == ui.EV_POINTER_CANCEL {
            tv := $&ed.top_view
            tv.end_pan()
        }
    } else if input.kind == ui.EV_POINTER_DOWN && input.button == ui.BUTTON_LEFT {
        if ed.placing_mode {
            wx := screen_to_world_x(&ed.top_view, &ed.top_view_local, input.x)
            wz := screen_to_world_z(&ed.top_view, &ed.top_view_local, input.y)
            ed.top_view.hover_x = wx
            ed.top_view.hover_z = wz
            ed.top_view.has_hover = true
            act_kind = widgets.ACTION_COMMIT
            consumed = true
            dirty = true
        } else {
            hit := pick_stage_node(&ed.top_view, &ed.top_view_local, &ed.stage_pts, input.x, input.y)
            if hit >= 0 {
                picked = f64(hit)
                act_kind = widgets.ACTION_ACTIVATE
                dirty = true
            }
            consumed = true
        }
    }
    << widgets.Action{kind: act_kind, id: ed.id_top_view, needs_paint: dirty, request_focus: true, consumed: consumed, value: picked}
}

fn (ed &Editor) any_text_field_focused() bool {
    << ed.name_field.is_focused() || ed.prim_field.is_focused() ||
        ed.pos_x.is_focused() || ed.pos_y.is_focused() || ed.pos_z.is_focused() ||
        ed.rot_x.is_focused() || ed.rot_y.is_focused() || ed.rot_z.is_focused() ||
        ed.scale_x.is_focused() || ed.scale_y.is_focused() || ed.scale_z.is_focused()
}

fn (ed $&Editor) handle_modal_input(input &ui.InputEvent, view $&widgets.View) bool {
    if ed.modals.kind == MODAL_NONE { << false }
    if input.kind == ui.EV_KEY_DOWN && input.repeat == 0 {
        if input.key == ui.KEY_ESCAPE && !ed.modals.has_popup_open() {
            modal_close($&ed.modals)
            ed.apply_pointer_cursor(view)
            repaint(view, ed.id_root)
            << true
        }
        if ed.modals.kind == MODAL_SNAP {
            if input.key == ui.KEY_TAB {
                order := [ID_MODAL_MOVE, ID_MODAL_ROTATE, ID_MODAL_SCALE, ID_MODAL_SNAP_CANCEL, ID_MODAL_SNAP_SAVE]
                $next := order[0]
                for i in 0:order.len {
                    if order[i] == ed.modals.focused_id {
                        $pos := i + 1
                        if pos >= order.len { pos = 0 }
                        next = order[pos]
                    }
                }
                modal_set_focus($&ed.modals, next)
                repaint(view, ed.id_root)
                << true
            }
            if input.key == ui.KEY_ENTER && !ed.modals.has_popup_open() && ed.modals.focused_id != ID_MODAL_SNAP_CANCEL {
                ed.submit_snap_modal(view)
                ed.apply_pointer_cursor(view)
                << true
            }
        } else if ed.modals.kind == MODAL_NEW_SCENE {
            if input.key == ui.KEY_TAB {
                order := [ID_MODAL_SCENE_NAME, ID_MODAL_SCENE_ROOT, ID_MODAL_SCENE_CANCEL, ID_MODAL_SCENE_CREATE]
                $next := order[0]
                for i in 0:order.len {
                    if order[i] == ed.modals.focused_id {
                        $pos := i + 1
                        if pos >= order.len { pos = 0 }
                        next = order[pos]
                    }
                }
                modal_set_focus($&ed.modals, next)
                repaint(view, ed.id_root)
                << true
            }
            if input.key == ui.KEY_ENTER && !ed.modals.has_popup_open() && ed.modals.focused_id != ID_MODAL_SCENE_CANCEL {
                ed.submit_new_scene_modal(view)
                ed.apply_pointer_cursor(view)
                << true
            }
        }
    }

    if ed.modals.kind == MODAL_SNAP {
        act := route_snap_modal_widgets($&ed.modals, input)
        if act == 1 { modal_close($&ed.modals) }
        if act == 2 { ed.submit_snap_modal(view) }
        ed.apply_pointer_cursor(view)
        repaint(view, ed.id_root)
        << true
    } else if ed.modals.kind == MODAL_NEW_SCENE {
        act := route_scene_modal_widgets($&ed.modals, input)
        if act == 1 { modal_close($&ed.modals) }
        if act == 2 { ed.submit_new_scene_modal(view) }
        ed.apply_pointer_cursor(view)
        repaint(view, ed.id_root)
        << true
    } else if ed.modals.kind == MODAL_UNSAVED {
        act := route_unsaved_modal_widgets($&ed.modals, input)
        target := ed.modals.unsaved_target_scene
        close_after := ed.modals.unsaved_close_after
        if act == 1 {
            modal_close($&ed.modals)
        } else if act == 2 {
            modal_close($&ed.modals)
            if close_after { ed.close_pending = true }
            else { ed.switch_scene(target, false, view) }
        } else if act == 3 {
            if ed.do_save(view) {
                modal_close($&ed.modals)
                if close_after { ed.close_pending = true }
                else { ed.switch_scene(target, false, view) }
            }
        }
        ed.apply_pointer_cursor(view)
        repaint(view, ed.id_root)
        << true
    }
    << true
}

fn route_snap_modal_widgets(m $&ModalState, input &ui.InputEvent) int {
    if m.snap_move.has_popup_open() { _ := route_modal_field($&m.snap_move, input)
        << 0 }
    if m.snap_rotate.has_popup_open() { _ := route_modal_field($&m.snap_rotate, input)
        << 0 }
    if m.snap_scale.has_popup_open() { _ := route_modal_field($&m.snap_scale, input)
        << 0 }
    a1 := route_modal_field($&m.snap_move, input)
    a2 := route_modal_field($&m.snap_rotate, input)
    a3 := route_modal_field($&m.snap_scale, input)
    a4 := input_btn($&m.snap_cancel, input)
    a5 := input_btn($&m.snap_save, input)
    if a1.kind == widgets.ACTION_CHANGE && m.snap_move_err.len > 0 { m.snap_move_err = ""
        m.sync_snap_decorations() }
    if a2.kind == widgets.ACTION_CHANGE && m.snap_rotate_err.len > 0 { m.snap_rotate_err = ""
        m.sync_snap_decorations() }
    if a3.kind == widgets.ACTION_CHANGE && m.snap_scale_err.len > 0 { m.snap_scale_err = ""
        m.sync_snap_decorations() }
    if a1.request_focus { m.set_focus(ID_MODAL_MOVE) }
    else if a2.request_focus { m.set_focus(ID_MODAL_ROTATE) }
    else if a3.request_focus { m.set_focus(ID_MODAL_SCALE) }
    else if a4.request_focus { m.set_focus(ID_MODAL_SNAP_CANCEL) }
    else if a5.request_focus { m.set_focus(ID_MODAL_SNAP_SAVE) }
    if a4.kind == widgets.ACTION_ACTIVATE { << 1 }
    if a5.kind == widgets.ACTION_ACTIVATE { << 2 }
    << 0
}

fn route_scene_modal_widgets(m $&ModalState, input &ui.InputEvent) int {
    if m.scene_name_field.has_popup_open() { _ := route_modal_field($&m.scene_name_field, input)
        << 0 }
    if m.scene_root_field.has_popup_open() { _ := route_modal_field($&m.scene_root_field, input)
        << 0 }
    a1 := route_modal_field($&m.scene_name_field, input)
    a2 := route_modal_field($&m.scene_root_field, input)
    a3 := input_btn($&m.scene_cancel, input)
    a4 := input_btn($&m.scene_create, input)
    if a1.kind == widgets.ACTION_CHANGE && m.scene_err.len > 0 { m.scene_err = ""
        m.sync_scene_decoration() }
    if a1.request_focus { m.set_focus(ID_MODAL_SCENE_NAME) }
    else if a2.request_focus { m.set_focus(ID_MODAL_SCENE_ROOT) }
    else if a3.request_focus { m.set_focus(ID_MODAL_SCENE_CANCEL) }
    else if a4.request_focus { m.set_focus(ID_MODAL_SCENE_CREATE) }
    if a3.kind == widgets.ACTION_ACTIVATE { << 1 }
    if a4.kind == widgets.ACTION_ACTIVATE { << 2 }
    << 0
}

fn route_unsaved_modal_widgets(m $&ModalState, input &ui.InputEvent) int {
    a1 := input_btn($&m.unsaved_cancel, input)
    a2 := input_btn($&m.unsaved_discard, input)
    a3 := input_btn($&m.unsaved_save, input)
    if a1.kind == widgets.ACTION_ACTIVATE { << 1 }
    if a2.kind == widgets.ACTION_ACTIVATE { << 2 }
    if a3.kind == widgets.ACTION_ACTIVATE { << 3 }
    << 0
}

fn copy_input(input &ui.InputEvent) ui.InputEvent {
    << ui.InputEvent{
        kind: input.kind, window_id: input.window_id, canvas_id: input.canvas_id, generation: input.generation,
        x: input.x, y: input.y, dx: input.dx, dy: input.dy,
        button: input.button, buttons: input.buttons, modifiers: input.modifiers,
        key: input.key, scan: input.scan, repeat: input.repeat, click_count: input.click_count, time_ns: input.time_ns
    }
}

fn route_modal_field(f $&widgets.Field, input &ui.InputEvent) widgets.Action {
    $local := copy_input(input)
    if (input.kind >= ui.EV_POINTER_DOWN && input.kind <= ui.EV_POINTER_CANCEL) || input.kind == ui.EV_POINTER_SCROLL {
        b := f.bounds()
        local.x = input.x - b.x
        local.y = input.y - b.y
    }
    << f.input(&local)
}

fn route_open_select(sel $&widgets.Select, origin &layout.Rect, input &ui.InputEvent) widgets.Action {
    $local := copy_input(input)
    if (input.kind >= ui.EV_POINTER_DOWN && input.kind <= ui.EV_POINTER_CANCEL) || input.kind == ui.EV_POINTER_SCROLL {
        local.x = input.x - origin.x
        local.y = input.y - origin.y
    }
    << sel.input(&local)
}

fn is_pointer_event_kind(kind int) bool {
    << kind >= ui.EV_POINTER_DOWN && kind <= ui.EV_POINTER_CANCEL
}

fn node_contains(view &widgets.View, id int, x f64, y f64) bool {
    nb := view.node_bounds(id) >>> (err) {
        _ := err
        << false
    }
    << nb.contains(x, y)
}

fn field_popup_cursor(f &widgets.Field, x f64, y f64) int {
    if !f.has_popup_open() { << -1 }
    if f.popup_bounds().contains(x, y) { << ui.CURSOR_HAND }
    << ui.CURSOR_DEFAULT
}

fn text_popup_cursor(s &widgets.SelectableText, x f64, y f64) int {
    if !s.has_popup_open() { << -1 }
    if s.popup_bounds().contains(x, y) { << ui.CURSOR_HAND }
    << ui.CURSOR_DEFAULT
}

fn field_hit_cursor(view &widgets.View, id int, f &widgets.Field, x f64, y f64) int {
    if !node_contains(view, id, x, y) { << -1 }
    << f.cursor_at(x, y)
}

fn btn_hit_cursor(view &widgets.View, id int, b &widgets.Button, x f64, y f64) int {
    if !node_contains(view, id, x, y) { << -1 }
    if b.is_enabled() { << ui.CURSOR_HAND }
    << ui.CURSOR_DEFAULT
}

fn sel_hit_cursor(view &widgets.View, id int, s &widgets.Select, x f64, y f64) int {
    if !node_contains(view, id, x, y) { << -1 }
    if s.is_enabled() { << ui.CURSOR_HAND }
    << ui.CURSOR_DEFAULT
}

pub fn (ed &Editor) resolve_cursor(view &widgets.View, x f64, y f64) int {
    if ed.modals.kind != MODAL_NONE { << ed.modals.cursor_at(x, y) }
    if ed.scene_select.is_open() {
        if ed.scene_select.popup_bounds(&ed.styles).contains(x - ed.scene_origin.x, y - ed.scene_origin.y) { << ui.CURSOR_HAND }
        << ui.CURSOR_DEFAULT
    }
    if ed.asset_select.is_open() {
        if ed.asset_select.popup_bounds(&ed.styles).contains(x - ed.asset_origin.x, y - ed.asset_origin.y) { << ui.CURSOR_HAND }
        << ui.CURSOR_DEFAULT
    }
    if ed.parent_select.is_open() {
        if ed.parent_select.popup_bounds(&ed.styles).contains(x - ed.parent_origin.x, y - ed.parent_origin.y) { << ui.CURSOR_HAND }
        << ui.CURSOR_DEFAULT
    }
    if ed.tree.has_popup_open() {
        pb := ed.tree.popup_bounds()
        if x >= ed.tree_origin.x + pb.x && x <= ed.tree_origin.x + pb.x + pb.width &&
            y >= ed.tree_origin.y + pb.y && y <= ed.tree_origin.y + pb.y + pb.height {
            << ui.CURSOR_HAND
        }
        << ui.CURSOR_DEFAULT
    }
    pcs := [field_popup_cursor(&ed.name_field, x, y), field_popup_cursor(&ed.prim_field, x, y), field_popup_cursor(&ed.pos_x, x, y), field_popup_cursor(&ed.pos_y, x, y), field_popup_cursor(&ed.pos_z, x, y), field_popup_cursor(&ed.rot_x, x, y), field_popup_cursor(&ed.rot_y, x, y), field_popup_cursor(&ed.rot_z, x, y), field_popup_cursor(&ed.scale_x, x, y), field_popup_cursor(&ed.scale_y, x, y), field_popup_cursor(&ed.scale_z, x, y), text_popup_cursor(&ed.asset_meta_txt, x, y), text_popup_cursor(&ed.insp_hdr_txt, x, y), text_popup_cursor(&ed.surf_info_txt, x, y), text_popup_cursor(&ed.status_txt, x, y)]
    for pc in pcs {
        if pc >= 0 { << pc }
    }
    if ed.dragging_split != 0 || node_contains(view, ed.id_left_split, x, y) || node_contains(view, ed.id_right_split, x, y) {
        << ui.CURSOR_RESIZE_HORIZONTAL
    }
    fcs := [field_hit_cursor(view, ed.id_name_field, &ed.name_field, x, y), field_hit_cursor(view, ed.id_prim_field, &ed.prim_field, x, y), field_hit_cursor(view, ed.id_pos_x, &ed.pos_x, x, y), field_hit_cursor(view, ed.id_pos_y, &ed.pos_y, x, y), field_hit_cursor(view, ed.id_pos_z, &ed.pos_z, x, y), field_hit_cursor(view, ed.id_rot_x, &ed.rot_x, x, y), field_hit_cursor(view, ed.id_rot_y, &ed.rot_y, x, y), field_hit_cursor(view, ed.id_rot_z, &ed.rot_z, x, y), field_hit_cursor(view, ed.id_scale_x, &ed.scale_x, x, y), field_hit_cursor(view, ed.id_scale_y, &ed.scale_y, x, y), field_hit_cursor(view, ed.id_scale_z, &ed.scale_z, x, y)]
    for fc in fcs {
        if fc >= 0 { << fc }
    }
    if node_contains(view, ed.id_asset_meta, x, y) { << ed.asset_meta_txt.cursor() }
    if node_contains(view, ed.id_insp_hdr, x, y) { << ed.insp_hdr_txt.cursor() }
    if node_contains(view, ed.id_surf_info, x, y) { << ed.surf_info_txt.cursor() }
    if node_contains(view, ed.id_status_txt, x, y) { << ed.status_txt.cursor() }
    if node_contains(view, ed.id_tree, x, y) { << ed.tree.cursor() }
    if node_contains(view, ed.id_top_view, x, y) {
        if ed.placing_mode { << ui.CURSOR_CROSSHAIR }
        if ed.top_view.panning || ed.top_view.hover_node >= 0 { << ui.CURSOR_HAND }
        << ui.CURSOR_DEFAULT
    }
    ccs := [sel_hit_cursor(view, ed.id_scene_select, &ed.scene_select, x, y), sel_hit_cursor(view, ed.id_asset_select, &ed.asset_select, x, y), sel_hit_cursor(view, ed.id_parent_select, &ed.parent_select, x, y), btn_hit_cursor(view, ed.id_new_scene_btn, &ed.new_scene_btn, x, y), btn_hit_cursor(view, ed.id_undo_btn, &ed.undo_btn, x, y), btn_hit_cursor(view, ed.id_redo_btn, &ed.redo_btn, x, y), btn_hit_cursor(view, ed.id_save_btn, &ed.save_btn, x, y), btn_hit_cursor(view, ed.id_preview_btn, &ed.preview_btn, x, y), btn_hit_cursor(view, ed.id_add_3d_btn, &ed.add_3d_btn, x, y), btn_hit_cursor(view, ed.id_add_grp_btn, &ed.add_grp_btn, x, y), btn_hit_cursor(view, ed.id_dup_btn, &ed.dup_btn, x, y), btn_hit_cursor(view, ed.id_del_btn, &ed.del_btn, x, y), btn_hit_cursor(view, ed.id_import_btn, &ed.import_btn, x, y), btn_hit_cursor(view, ed.id_place_btn, &ed.place_btn, x, y), btn_hit_cursor(view, ed.id_fit_btn, &ed.fit_btn, x, y), btn_hit_cursor(view, ed.id_view3d_btn, &ed.view3d_btn, x, y), btn_hit_cursor(view, ed.id_snap_btn, &ed.snap_btn, x, y), btn_hit_cursor(view, ed.id_reparent_btn, &ed.reparent_btn, x, y), btn_hit_cursor(view, ed.id_apply_btn, &ed.apply_btn, x, y)]
    for cc in ccs {
        if cc >= 0 { << cc }
    }
    if node_contains(view, ed.id_visible_chk, x, y) {
        if ed.visible_chk.is_enabled() { << ui.CURSOR_HAND }
        << ui.CURSOR_DEFAULT
    }
    << ui.CURSOR_DEFAULT
}

fn (ed $&Editor) apply_pointer_cursor(view $&widgets.View) {
    $cur := ui.CURSOR_DEFAULT
    if ed.pointer_inside { cur = ed.resolve_cursor(view, ed.last_px, ed.last_py) }
    _ := view.set_pointer_cursor(cur) >>> (err) {
        _ := err
        <<
    }
}

fn route_popup_field(view $&widgets.View, root_id int, input &ui.InputEvent, f $&widgets.Field) bool {
    if !f.has_popup_open() { << false }
    id := f.id()
    act := field_input(f, input)
    if act.needs_paint { repaint(view, id) }
    repaint(view, root_id)
    << act.consumed || (input.kind == ui.EV_KEY_DOWN && input.key == ui.KEY_ESCAPE)
}

fn route_popup_text(view $&widgets.View, root_id int, input &ui.InputEvent, s $&widgets.SelectableText) bool {
    if !s.has_popup_open() { << false }
    id := s.id()
    act := text_input(s, input)
    if act.needs_paint { repaint(view, id) }
    repaint(view, root_id)
    << act.consumed || (input.kind == ui.EV_KEY_DOWN && input.key == ui.KEY_ESCAPE)
}

fn (ed $&Editor) route_open_context_menus(input &ui.InputEvent, view $&widgets.View) bool {
    rid := ed.id_root
    if ed.tree.has_popup_open() {
        $local := copy_input(input)
        if is_pointer_event_kind(input.kind) || input.kind == ui.EV_POINTER_SCROLL {
            local.x = input.x - ed.tree_origin.x
            local.y = input.y - ed.tree_origin.y
        }
        tr := $&ed.tree
        act := tr.input(&local)
        if act.needs_paint { repaint(view, ed.id_tree) }
        repaint(view, rid)
        if act.consumed || (input.kind == ui.EV_KEY_DOWN && input.key == ui.KEY_ESCAPE) { << true }
    }
    if ed.name_field.has_popup_open() {
        act := field_input($&ed.name_field, input)
        if act.kind == widgets.ACTION_CHANGE || act.kind == widgets.ACTION_COMMIT {
            val := ed.name_field.value()
            ed.name_error = ""
            ed.refresh_name_decoration(&val)
            repaint(view, ed.id_right_pane)
        }
        repaint(view, rid)
        if act.consumed || (input.kind == ui.EV_KEY_DOWN && input.key == ui.KEY_ESCAPE) { << true }
    }
    if route_popup_field(view, rid, input, $&ed.prim_field) { << true }
    if route_popup_field(view, rid, input, $&ed.pos_x) { << true }
    if route_popup_field(view, rid, input, $&ed.pos_y) { << true }
    if route_popup_field(view, rid, input, $&ed.pos_z) { << true }
    if route_popup_field(view, rid, input, $&ed.rot_x) { << true }
    if route_popup_field(view, rid, input, $&ed.rot_y) { << true }
    if route_popup_field(view, rid, input, $&ed.rot_z) { << true }
    if route_popup_field(view, rid, input, $&ed.scale_x) { << true }
    if route_popup_field(view, rid, input, $&ed.scale_y) { << true }
    if route_popup_field(view, rid, input, $&ed.scale_z) { << true }
    if route_popup_text(view, rid, input, $&ed.asset_meta_txt) { << true }
    if route_popup_text(view, rid, input, $&ed.insp_hdr_txt) { << true }
    if route_popup_text(view, rid, input, $&ed.surf_info_txt) { << true }
    if route_popup_text(view, rid, input, $&ed.status_txt) { << true }
    << false
}

fn dispatch_field_text_event(view $&widgets.View, root_id int, event &ui.Event, f $&widgets.Field) bool {
    id := f.id()
    act := field_event(f, event)
    if act.needs_paint || act.kind == widgets.ACTION_CHANGE {
        repaint(view, id)
        if f.has_popup_open() { repaint(view, root_id) }
        << true
    }
    << false
}

fn dispatch_sel_text_event(view $&widgets.View, event &ui.Event, s $&widgets.SelectableText) bool {
    id := s.id()
    act := text_event(s, event)
    if act.needs_paint {
        repaint(view, id)
        << true
    }
    << false
}

fn (ed $&Editor) dispatch_text_or_request(event &ui.Event, view $&widgets.View) bool {
    is_text_or_req := (event.kind >= ui.EV_TEXT_COMMIT && event.kind <= ui.EV_TEXT_SURROUNDING_DELETE) || event.kind == ui.EV_REQUEST
    if !is_text_or_req { << false }
    rid := ed.id_root
    if ed.modals.kind != MODAL_NONE {
        mods := $&ed.modals
        if mods.handle_text_or_request(event) {
            repaint(view, rid)
        }
        << true
    }
    a_nm := field_event($&ed.name_field, event)
    if a_nm.kind == widgets.ACTION_CHANGE || a_nm.kind == widgets.ACTION_COMMIT {
        val := ed.name_field.value()
        ed.name_error = ""
        ed.refresh_name_decoration(&val)
        repaint(view, ed.id_right_pane)
    } else if a_nm.needs_paint {
        repaint(view, ed.id_name_field)
    }
    _ := dispatch_field_text_event(view, rid, event, $&ed.prim_field)
    _ := dispatch_field_text_event(view, rid, event, $&ed.pos_x)
    _ := dispatch_field_text_event(view, rid, event, $&ed.pos_y)
    _ := dispatch_field_text_event(view, rid, event, $&ed.pos_z)
    _ := dispatch_field_text_event(view, rid, event, $&ed.rot_x)
    _ := dispatch_field_text_event(view, rid, event, $&ed.rot_y)
    _ := dispatch_field_text_event(view, rid, event, $&ed.rot_z)
    _ := dispatch_field_text_event(view, rid, event, $&ed.scale_x)
    _ := dispatch_field_text_event(view, rid, event, $&ed.scale_y)
    _ := dispatch_field_text_event(view, rid, event, $&ed.scale_z)
    _ := dispatch_sel_text_event(view, event, $&ed.asset_meta_txt)
    _ := dispatch_sel_text_event(view, event, $&ed.insp_hdr_txt)
    _ := dispatch_sel_text_event(view, event, $&ed.surf_info_txt)
    _ := dispatch_sel_text_event(view, event, $&ed.status_txt)
    << true
}

fn is_inspector_submit_id(ed &Editor, id int) bool {
    << id == ed.id_name_field ||
        id == ed.id_pos_x || id == ed.id_pos_y || id == ed.id_pos_z ||
        id == ed.id_rot_x || id == ed.id_rot_y || id == ed.id_rot_z ||
        id == ed.id_scale_x || id == ed.id_scale_y || id == ed.id_scale_z
}

pub fn (ed $&Editor) handle_ui_event(event &ui.Event, view $&widgets.View) int {
    if event.kind == ui.EV_CANVAS_METRICS {
        ed.sync_layout(view, f64(event.width), f64(event.height)) >>>
        << 0
    }
    if ed.dispatch_text_or_request(event, view) {
        << 0
    }
    if ui.is_input_event(event.kind) {
        input := ui.input_of(event) >>>
        if input.generation != ed.identity.generation { << 0 }
        if is_pointer_event_kind(input.kind) {
            if input.kind == ui.EV_POINTER_LEAVE {
                ed.pointer_inside = false
            } else {
                ed.last_px = input.x
                ed.last_py = input.y
                ed.pointer_inside = true
            }
        }

        if ed.handle_modal_input(&input, view) {
            << 0
        }

        // Open select popups capture pointer & Escape before underlying nodes.
        if ed.scene_select.is_open() {
            orig := copy_rect(&ed.scene_origin)
            act := route_open_select($&ed.scene_select, &orig, &input)
            if act.kind == widgets.ACTION_CHANGE {
                ed.switch_scene(int(act.value), true, view)
            }
            if act.consumed || (input.kind == ui.EV_KEY_DOWN && input.key == ui.KEY_ESCAPE) {
                set_sel_open($&ed.scene_select, false)
                ed.apply_pointer_cursor(view)
                repaint(view, ed.id_root)
                << 0
            }
            if is_pointer_event_kind(input.kind) { ed.apply_pointer_cursor(view) }
        }
        if ed.asset_select.is_open() {
            orig := copy_rect(&ed.asset_origin)
            act := route_open_select($&ed.asset_select, &orig, &input)
            if act.consumed || (input.kind == ui.EV_KEY_DOWN && input.key == ui.KEY_ESCAPE) {
                if act.kind == widgets.ACTION_CHANGE {
                    ed.sync_asset_meta_text()
                    repaint(view, ed.id_left_pane)
                }
                set_sel_open($&ed.asset_select, false)
                ed.apply_pointer_cursor(view)
                repaint(view, ed.id_root)
                << 0
            }
            if is_pointer_event_kind(input.kind) { ed.apply_pointer_cursor(view) }
        }
        if ed.parent_select.is_open() {
            orig := copy_rect(&ed.parent_origin)
            act := route_open_select($&ed.parent_select, &orig, &input)
            if act.consumed || (input.kind == ui.EV_KEY_DOWN && input.key == ui.KEY_ESCAPE) {
                set_sel_open($&ed.parent_select, false)
                ed.apply_pointer_cursor(view)
                repaint(view, ed.id_root)
                << 0
            }
            if is_pointer_event_kind(input.kind) { ed.apply_pointer_cursor(view) }
        }

        if ed.route_open_context_menus(&input, view) {
            ed.apply_pointer_cursor(view)
            << 0
        }

        // Global shortcuts
        if input.kind == ui.EV_KEY_DOWN && input.repeat == 0 {
            if input.key == ui.KEY_ESCAPE && ed.placing_mode {
                ed.placing_mode = false
                ed.sync_toolbar_states()
                ed.apply_pointer_cursor(view)
                repaint(view, ed.id_left_pane)
                repaint(view, ed.id_top_view)
                ed.set_status(STATUS_INFO, "Cancelled placement", view)
                << 0
            }
            has_mod := (input.modifiers & (ui.MOD_META | ui.MOD_CONTROL)) != 0
            has_shift := (input.modifiers & ui.MOD_SHIFT) != 0
            if has_mod && (input.key == 115 || input.key == 83) { // Cmd/Ctrl+S
                _ := ed.do_save(view)
                << 0
            }
            if has_mod && (input.key == 122 || input.key == 90) { // Cmd/Ctrl+Z
                if has_shift { ed.do_redo(view) } else { ed.do_undo(view) }
                << 0
            }
            if has_mod && (input.key == 100 || input.key == 68) { // Cmd/Ctrl+D
                ed.do_duplicate_node(view)
                << 0
            }
            if !ed.any_text_field_focused() {
                if input.key == 102 || input.key == 70 { // F
                    pts := clone_stage_points(&ed.stage_pts)
                    tv_rect := copy_rect(&ed.top_view_local)
                    tv := $&ed.top_view
                    tv.fit_points(&pts, &tv_rect)
                    repaint(view, ed.id_top_view)
                    << 0
                }
                if (input.key == ui.KEY_BACKSPACE || input.key == ui.KEY_DELETE) && ed.selected_node > 0 {
                    ed.do_delete_node(view)
                    << 0
                }
            }
        }
    }

    actions := widgets.dispatch_event(view, event, ed) >>>
    $need_relayout := false
    for i in 0:actions.len {
        a := &actions[i]
        if a.needs_paint && a.id > 0 {
            repaint(view, a.id)
        }
        if a.id == ed.id_left_split || a.id == ed.id_right_split {
            if a.kind == widgets.ACTION_CHANGE { need_relayout = true }
        } else if a.id == ed.id_scene_select && a.kind == widgets.ACTION_CHANGE {
            ed.switch_scene(int(a.value), true, view)
        } else if a.id == ed.id_new_scene_btn && a.kind == widgets.ACTION_ACTIVATE {
            ed.open_new_scene_modal(view)
        } else if a.id == ed.id_undo_btn && a.kind == widgets.ACTION_ACTIVATE {
            ed.do_undo(view)
        } else if a.id == ed.id_redo_btn && a.kind == widgets.ACTION_ACTIVATE {
            ed.do_redo(view)
        } else if a.id == ed.id_save_btn && a.kind == widgets.ACTION_ACTIVATE {
            _ := ed.do_save(view)
        } else if a.id == ed.id_preview_btn && a.kind == widgets.ACTION_ACTIVATE {
            ed.req_launch_preview = true
        } else if a.id == ed.id_add_3d_btn && a.kind == widgets.ACTION_ACTIVATE {
            ed.do_add_node(resource.NODE_3D, "Node3D", view)
        } else if a.id == ed.id_add_grp_btn && a.kind == widgets.ACTION_ACTIVATE {
            ed.do_add_node(resource.NODE_GROUP, "Group", view)
        } else if a.id == ed.id_dup_btn && a.kind == widgets.ACTION_ACTIVATE {
            ed.do_duplicate_node(view)
        } else if a.id == ed.id_del_btn && a.kind == widgets.ACTION_ACTIVATE {
            ed.do_delete_node(view)
        } else if a.id == ed.id_tree && a.kind == widgets.ACTION_CHANGE {
            tid := ed.tree.selected()
            if ed.tree_to_scene.has(tid) {
                ed.select_scene_node(ed.tree_to_scene[tid], view)
            }
        } else if a.id == ed.id_import_btn && a.kind == widgets.ACTION_ACTIVATE {
            ed.req_import_glb = true
        } else if a.id == ed.id_asset_select && (a.kind == widgets.ACTION_CHANGE || a.kind == widgets.ACTION_ACTIVATE) {
            if a.kind == widgets.ACTION_CHANGE {
                ed.sync_asset_meta_text()
                repaint(view, ed.id_left_pane)
            }
            repaint(view, ed.id_root)
        } else if a.id == ed.id_place_btn && a.kind == widgets.ACTION_ACTIVATE {
            ed.placing_mode = !ed.placing_mode
            ed.sync_toolbar_states()
            repaint(view, ed.id_left_pane)
            repaint(view, ed.id_top_view)
            if ed.placing_mode {
                ed.set_status(STATUS_INFO, "Click in Top View · XZ to place GLB (Esc cancels)", view)
            } else {
                ed.set_status(STATUS_INFO, "Cancelled placement", view)
            }
        } else if a.id == ed.id_fit_btn && a.kind == widgets.ACTION_ACTIVATE {
            pts := clone_stage_points(&ed.stage_pts)
            tv_rect := copy_rect(&ed.top_view_local)
            tv := $&ed.top_view
            tv.fit_points(&pts, &tv_rect)
            repaint(view, ed.id_top_view)
        } else if a.id == ed.id_view3d_btn && a.kind == widgets.ACTION_ACTIVATE {
            ed.req_launch_viewport = true
        } else if a.id == ed.id_snap_btn && a.kind == widgets.ACTION_ACTIVATE {
            ed.open_snap_modal(view)
        } else if a.id == ed.id_top_view && a.kind == widgets.ACTION_ACTIVATE {
            ed.select_scene_node(int(a.value), view)
        } else if a.id == ed.id_top_view && a.kind == widgets.ACTION_COMMIT {
            ed.do_place_at(ed.top_view.hover_x, ed.top_view.hover_z, view)
        } else if a.id == ed.id_reparent_btn && a.kind == widgets.ACTION_ACTIVATE {
            ed.do_reparent_selected(view)
        } else if a.id == ed.id_apply_btn && a.kind == widgets.ACTION_ACTIVATE {
            _ := ed.apply_inspector(view)
        } else if a.id == ed.id_name_field && a.kind == widgets.ACTION_CHANGE {
            val := ed.name_field.value()
            ed.name_error = ""
            ed.refresh_name_decoration(&val)
            repaint(view, ed.id_right_pane)
        } else if (a.id == ed.id_name_field || a.id == ed.id_pos_x || a.id == ed.id_pos_y || a.id == ed.id_pos_z ||
                   a.id == ed.id_rot_x || a.id == ed.id_rot_y || a.id == ed.id_rot_z ||
                   a.id == ed.id_scale_x || a.id == ed.id_scale_y || a.id == ed.id_scale_z) && a.kind == widgets.ACTION_COMMIT {
            _ := ed.apply_inspector(view)
        } else if a.kind == widgets.ACTION_SUBMIT && is_inspector_submit_id(ed, a.id) {
            _ := ed.apply_inspector(view)
        }
        if ed.scene_select.is_open() || ed.asset_select.is_open() || ed.parent_select.is_open() ||
            ed.tree.has_popup_open() || ed.name_field.has_popup_open() || ed.prim_field.has_popup_open() ||
            ed.asset_meta_txt.has_popup_open() || ed.insp_hdr_txt.has_popup_open() ||
            ed.surf_info_txt.has_popup_open() || ed.status_txt.has_popup_open() ||
            ed.pos_x.has_popup_open() || ed.pos_y.has_popup_open() || ed.pos_z.has_popup_open() ||
            ed.rot_x.has_popup_open() || ed.rot_y.has_popup_open() || ed.rot_z.has_popup_open() ||
            ed.scale_x.has_popup_open() || ed.scale_y.has_popup_open() || ed.scale_z.has_popup_open() {
            repaint(view, ed.id_root)
        }
    }
    if need_relayout {
        ed.sync_layout(view, ed.viewport_w, ed.viewport_h) >>>
        ed.repaint_all(view)
    }
    ed.apply_pointer_cursor(view)
    << 0
}

pub fn (ed $&Editor) tick_animations(view $&widgets.View, now time.Instant) {
    rm := ed.reduced_motion
    mods := $&ed.modals
    if mods.tick(now, rm) {
        repaint(view, ed.id_root)
    }
    if tick_field($&ed.name_field, now, rm) { repaint(view, ed.id_name_field) }
    if tick_field($&ed.prim_field, now, rm) { repaint(view, ed.id_prim_field) }
    if tick_field($&ed.pos_x, now, rm) { repaint(view, ed.id_pos_x) }
    if tick_field($&ed.pos_y, now, rm) { repaint(view, ed.id_pos_y) }
    if tick_field($&ed.pos_z, now, rm) { repaint(view, ed.id_pos_z) }
    if tick_field($&ed.rot_x, now, rm) { repaint(view, ed.id_rot_x) }
    if tick_field($&ed.rot_y, now, rm) { repaint(view, ed.id_rot_y) }
    if tick_field($&ed.rot_z, now, rm) { repaint(view, ed.id_rot_z) }
    if tick_field($&ed.scale_x, now, rm) { repaint(view, ed.id_scale_x) }
    if tick_field($&ed.scale_y, now, rm) { repaint(view, ed.id_scale_y) }
    if tick_field($&ed.scale_z, now, rm) { repaint(view, ed.id_scale_z) }
}

pub fn (ed &Editor) next_tick_deadline(now time.Instant) time.Instant {
    $deadline := ed.modals.next_tick(now, ed.reduced_motion)
    fields := [field_next_tick(&ed.name_field, now, ed.reduced_motion), field_next_tick(&ed.prim_field, now, ed.reduced_motion), field_next_tick(&ed.pos_x, now, ed.reduced_motion), field_next_tick(&ed.pos_y, now, ed.reduced_motion), field_next_tick(&ed.pos_z, now, ed.reduced_motion), field_next_tick(&ed.rot_x, now, ed.reduced_motion), field_next_tick(&ed.rot_y, now, ed.reduced_motion), field_next_tick(&ed.rot_z, now, ed.reduced_motion), field_next_tick(&ed.scale_x, now, ed.reduced_motion), field_next_tick(&ed.scale_y, now, ed.reduced_motion), field_next_tick(&ed.scale_z, now, ed.reduced_motion)]
    for next in fields {
        if !next.is_zero() && (deadline.is_zero() || next.before(deadline)) {
            deadline = next
        }
    }
    << deadline
}
