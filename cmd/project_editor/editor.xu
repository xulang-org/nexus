    init_sel := initial_selected_node(&ed.draft)
    ed.set_single_selection(init_sel)
    ed.apply_custom_styles()
    ed.apply_language_internal()
    ed.rebuild_asset_list()
    ed.refresh_after_document_change(true, view)
    ed.sync_tree_selection(false)
    ed.sync_asset_meta_text()
    ed.sync_status_text()
    << ed
}

fn first_selectable_node(doc &resource.Document) int {
    cnt := doc.node_count()
    for i in 1:cnt {
        nd := doc.describe_node(i) >>> (err) {
            _ := err
            ->
        }
        if nd.visible && nd.kind == resource.NODE_3D && !nd.camera.is_set() && !nd.orthographic.is_set() {
            << i
        }
    }
    if cnt > 1 { << 1 }
    << 0
}

fn initial_selected_node(draft &Draft) int {
    doc := draft.document() >>> (err) {
        _ := err
        << 0
    }
    << first_selectable_node(&doc)
}

fn min_int_val(a int, b int) int {
    if a < b { << a }
    << b
}

pub fn (ed $&Editor) dispose(view $&widgets.View) {
    view.dispose()
    mods := $&ed.modals
    mods.dispose()
    tip := $&ed.tooltip
    tip.dispose()
    modeling_dispose($&ed.modeling)
    vp3d := $&ed.vp3d
    vp3d.dispose()
    tm_dis := $&ed.tilemap
    tm_dis.dispose()
    comp_dispose($&ed.comp)
    panels_dispose($&ed.panels)
    dispose_field($&ed.name_field)
    dispose_field($&ed.prim_field)
    dispose_field($&ed.pos_x)
    dispose_field($&ed.pos_y)
    dispose_field($&ed.pos_z)
    dispose_field($&ed.rot_x)
    dispose_field($&ed.rot_y)
    dispose_field($&ed.rot_z)
    dispose_field($&ed.scale_x)
    dispose_field($&ed.scale_y)
    dispose_field($&ed.scale_z)
    dispose_field($&ed.surf_prim_field)
    dispose_field($&ed.lod_hyst_field)
    dispose_field($&ed.lod_dist_field)
    dispose_field($&ed.lod_prim_field)
    dispose_tree($&ed.tree)
    dispose_tree($&ed.asset_list)
    dispose_sel_text($&ed.asset_meta_txt)
    dispose_sel_text($&ed.insp_hdr_txt)
    dispose_sel_text($&ed.surf_info_txt)
    dispose_sel_text($&ed.lod_info_txt)
    dispose_sel_text($&ed.status_txt)
    dispose_label($&ed.new_scene_lbl)
    dispose_label($&ed.globals_lbl)
    dispose_label($&ed.undo_lbl)
    dispose_label($&ed.redo_lbl)
    dispose_label($&ed.save_lbl)
    dispose_label($&ed.preview_lbl)
    dispose_label($&ed.dup_lbl)
    dispose_label($&ed.del_lbl)
    dispose_label($&ed.import_lbl)
    dispose_label($&ed.place_lbl)
    dispose_label($&ed.stage_axis_lbl)
    dispose_label($&ed.stage_snap_lbl)
    dispose_label($&ed.fit_lbl)
    dispose_label($&ed.snap_lbl)
    dispose_label($&ed.visible_lbl)
    dispose_label($&ed.reparent_lbl)
    dispose_label($&ed.surf_bind_lbl)
    dispose_label($&ed.surf_clear_lbl)
    dispose_label($&ed.lod_add_lbl)
    dispose_label($&ed.lod_pop_lbl)
    dispose_label($&ed.apply_lbl)
    dispose_label($&ed.empty_lbl)
    dispose_label($&ed.no_asset_lbl)
    dispose_label($&ed.root_parent_lbl)
    for i in 0:ed.stage_tab_labels.len { dispose_label($&ed.stage_tab_labels[i]) }
    for i in 0:ed.left_tab_labels.len { dispose_label($&ed.left_tab_labels[i]) }
    for i in 0:ed.insp_tab_labels.len { dispose_label($&ed.insp_tab_labels[i]) }
    for i in 0:ed.add_node_labels.len { dispose_label($&ed.add_node_labels[i]) }
    for i in 0:ed.add_comp_labels.len { dispose_label($&ed.add_comp_labels[i]) }
    for i in 0:ed.scene_labels.len { dispose_label($&ed.scene_labels[i]) }
    for i in 0:ed.asset_labels.len { dispose_label($&ed.asset_labels[i]) }
    for i in 0:ed.parent_labels.len { dispose_label($&ed.parent_labels[i]) }
    for i in 0:ed.process_labels.len { dispose_label($&ed.process_labels[i]) }
    for i in 0:ed.surf_asset_labels.len { dispose_label($&ed.surf_asset_labels[i]) }
    for i in 0:ed.lod_asset_labels.len { dispose_label($&ed.lod_asset_labels[i]) }
}

fn (ed $&Editor) apply_custom_styles() {
    compact := compact_button_style(&ed.styles, widgets.BUTTON_SECONDARY)
    subtle := compact_button_style(&ed.styles, widgets.BUTTON_SUBTLE)
    ico_sec := icon_button_style(&ed.styles, widgets.BUTTON_SECONDARY)
    ico_sub := icon_button_style(&ed.styles, widgets.BUTTON_SUBTLE)
    ico_dng := icon_danger_subtle_style(&ed.styles, &ed.pal)
    seg_st := segmented_control_style(&ed.styles, &ed.pal)
    primary := ed.styles.button_variant(widgets.BUTTON_PRIMARY) >>> (err) {
        _ := err
        <<
    }
    set_tabs_style($&ed.stage_tabs, &seg_st)
    set_tabs_style($&ed.left_tabs, &seg_st)
    set_tabs_style($&ed.insp_tabs, &seg_st)
    set_btn_style($&ed.new_scene_btn, &ico_sec)
    set_btn_style($&ed.globals_btn, &ico_sec)
    set_btn_style($&ed.undo_btn, &ico_sub)
    set_btn_style($&ed.redo_btn, &ico_sub)
    set_btn_style($&ed.preview_btn, &ico_sec)
    set_btn_style($&ed.dup_btn, &ico_sub)
    set_btn_style($&ed.del_btn, &ico_dng)
    set_btn_style($&ed.import_btn, &ico_sub)
    set_btn_style($&ed.place_btn, &compact)
    set_btn_style($&ed.stage_axis_btn, &ico_sub)
    set_btn_style($&ed.stage_snap_btn, &ico_sub)
    set_btn_style($&ed.fit_btn, &ico_sub)
    set_btn_style($&ed.snap_btn, &ico_sub)
    set_btn_style($&ed.reparent_btn, &compact)
    set_btn_style($&ed.surf_bind_btn, &compact)
    set_btn_style($&ed.surf_clear_btn, &subtle)
    set_btn_style($&ed.lod_add_btn, &compact)
    set_btn_style($&ed.lod_pop_btn, &subtle)
    set_btn_style($&ed.apply_btn, &primary)

    cs := compact_select_style(&ed.styles)
    set_sel_style($&ed.scene_select, &cs)
    set_sel_style($&ed.asset_select, &cs)
    set_sel_style($&ed.add_node_select, &cs)
    set_sel_style($&ed.add_comp_select, &cs)
    set_sel_style($&ed.parent_select, &cs)
    set_sel_style($&ed.process_select, &cs)
    set_sel_style($&ed.surf_asset_select, &cs)
    set_sel_style($&ed.lod_asset_select, &cs)

    ts := compact_tree_style(&ed.styles, &ed.pal)
    set_tree_style($&ed.tree, &ts)
    ta := widgets.TreeAppearance{
        indent: 16.0,
        row_height: 26.0,
        guides: true,
        icons: true,
        selection_mark: true,
        guide_opacity: 0.35,
        action_width: 24.0
    }
    set_tree_appearance($&ed.tree, &ta)
    set_tree_style($&ed.asset_list, &ts)
    aa := widgets.TreeAppearance{
        indent: 8.0,
        row_height: 26.0,
        guides: false,
        icons: false,
        selection_mark: true,
        guide_opacity: 0.0,
        action_width: 0.0
    }
    set_tree_appearance($&ed.asset_list, &aa)

    inf := inline_field_style(&ed.styles)
    set_field_style($&ed.name_field, &inf)
    cf := compact_field_style(&ed.styles)
    set_field_style($&ed.prim_field, &cf)
    set_field_style($&ed.pos_x, &cf)
    set_field_style($&ed.pos_y, &cf)
    set_field_style($&ed.pos_z, &cf)
    set_field_style($&ed.rot_x, &cf)
    set_field_style($&ed.rot_y, &cf)
    set_field_style($&ed.rot_z, &cf)
    set_field_style($&ed.scale_x, &cf)
    set_field_style($&ed.scale_y, &cf)
    set_field_style($&ed.scale_z, &cf)
    set_field_style($&ed.surf_prim_field, &cf)
    set_field_style($&ed.lod_hyst_field, &cf)
    set_field_style($&ed.lod_dist_field, &cf)
    set_field_style($&ed.lod_prim_field, &cf)

    st_meta := selectable_text_style(&ed.styles, &ed.pal, 11.0, ed.pal.muted)
    st_hdr := selectable_text_style(&ed.styles, &ed.pal, 13.0, ed.pal.text)
    set_text_style($&ed.asset_meta_txt, &st_meta)
    set_text_style($&ed.surf_info_txt, &st_meta)
    set_text_style($&ed.lod_info_txt, &st_meta)
    set_text_style($&ed.insp_hdr_txt, &st_hdr)
    st_p := ed.styles.clone()
    pal_p := ed.pal
    panels_apply_styles($&ed.panels, &st_p, &pal_p)
    modeling_apply_styles($&ed.modeling, &st_p, &pal_p)
    ed.sync_status_text()
}

pub fn (ed $&Editor) rebuild_asset_list() {
    tree_begin_update($&ed.asset_list)
    tree_clear($&ed.asset_list)
    ed.asset_row_to_idx = map[int]int{}
    ed.asset_idx_to_row = map[int]int{}
    n := min_int_val(ed.project.assets.len, 64)
    for i in 0:n {
        ext_raw := filepath.ext(&ed.project.assets[i].path)
        ext_trim := strings.trim_prefix(&ext_raw, ".")
        ext := strings.to_upper(&ext_trim)
        lbl := asset_display_label(&ed.project.assets[i].path)
        tid := tree_add_node($&ed.asset_list, -1, &lbl) >>> (err) {
            _ := err
            <-
        }
        ed.asset_row_to_idx[tid] = i
        ed.asset_idx_to_row[i] = tid
        if ext.len > 0 {
            tree_set_meta($&ed.asset_list, tid, &ext)
        }
    }
    if n > 0 {
        if ed.selected_asset < 0 || ed.selected_asset >= n { ed.selected_asset = 0 }
        if ed.asset_idx_to_row.has(ed.selected_asset) {
            row_id := ed.asset_idx_to_row[ed.selected_asset]
            tree_set_sel($&ed.asset_list, row_id)
        }
    } else {
        ed.selected_asset = -1
    }
    tree_end_update($&ed.asset_list)
}

pub fn (ed $&Editor) select_asset_index(idx int) {
    n := min_int_val(ed.project.assets.len, 64)
    if n <= 0 {
        ed.selected_asset = -1
        <<
    }
    $clamped := idx
    if clamped < 0 || clamped >= n { clamped = 0 }
    ed.selected_asset = clamped
    set_sel_selected($&ed.asset_select, clamped)
    if ed.asset_idx_to_row.has(clamped) {
        row_id := ed.asset_idx_to_row[clamped]
        tree_set_sel($&ed.asset_list, row_id)
    }
}

pub fn (ed $&Editor) set_left_tab(tab int, view $&widgets.View) {
    $t := 0
    if tab == 1 { t = 1 }
    ed.left_tab = t
    set_tabs_selected($&ed.left_tabs, t)
    _ := ed.sync_layout(view, ed.viewport_w, ed.viewport_h) >>> (err) {
        _ := err
        <<
    }
    ed.sync_toolbar_states()
    ed.repaint_all(view)
}

pub fn (ed $&Editor) set_insp_tab(tab int, view $&widgets.View) {
    $t := 0
    if tab == 1 { t = 1 }
    else if tab == 2 { t = 2 }
    ed.insp_tab = t
    set_tabs_selected($&ed.insp_tabs, t)
    sc := $&ed.insp_scroll
    _ := sc.set_offset(0.0) >>> (err) {
        _ := err
        <<
    }
    _ := view.set_scroll(ed.id_insp_scroll, 0.0, 0.0) >>> (err) {
        _ := err
        <<
    }
    _ := ed.sync_layout(view, ed.viewport_w, ed.viewport_h) >>> (err) {
        _ := err
        <<
    }
    ed.sync_toolbar_states()
    ed.repaint_all(view)
}

pub fn (ed $&Editor) sync_status_text() {
    $col := ed.pal.muted
    if ed.status_kind == STATUS_OK { col = ed.pal.success }
    else if ed.status_kind == STATUS_ERR { col = ed.pal.danger }
    st := selectable_text_style(&ed.styles, &ed.pal, 12.0, col)
    set_text_style($&ed.status_txt, &st)
    msg := ed.status_text + ""
    set_text_val($&ed.status_txt, &msg)
}

pub fn (ed $&Editor) sync_asset_meta_text() {
    $meta := tr(ed.lang, "Import a .glb/.png/.wav/.xubc asset", "请导入 .glb/.png/.wav/.xubc 资源")
    sel := ed.selected_asset
    if sel >= 0 && sel < ed.project.assets.len {
        meta = ed.project.assets[sel].path + " (" + ed.project.assets[sel].key[0:8] + ")"
    }
    set_text_val($&ed.asset_meta_txt, &meta)
    vbin := ed.validator_bin + ""
    proj := clone_project(&ed.project)
    lang_v := ed.lang
    p := $&ed.panels
    prims_s := format_asset_prims_summary(&vbin, &proj, sel, $&p.glb_prim_cache, lang_v)
    set_text_val($&p.texts[PT_ASSET_PRIMS], &prims_s)
}

pub fn (ed &Editor) repaint_all(view $&widgets.View) {
    repaint(view, ed.id_toolbar)
    repaint(view, ed.id_left_pane)
    repaint(view, ed.id_top_view)
    repaint(view, ed.id_center_pane)
    repaint(view, ed.id_right_pane)
    repaint(view, ed.id_footer)
    repaint(view, ed.id_root)
}

pub fn (ed $&Editor) set_status(kind int, msg string, view $&widgets.View) {
    ed.status_kind = kind
    ed.status_text = msg
    ed.sync_status_text()
    repaint(view, ed.id_footer)
}

fn (ed $&Editor) clamp_widths(w f64) {
    avail := w - f64(SPLITTER_W) * 2.0
    max_left := math.max(f64(MIN_LEFT_W), avail - f64(MIN_CENTER_W) - f64(MIN_RIGHT_W))
    if ed.left_w < f64(MIN_LEFT_W) { ed.left_w = f64(MIN_LEFT_W) }
    if ed.left_w > max_left { ed.left_w = max_left }
    max_right := math.max(f64(MIN_RIGHT_W), avail - ed.left_w - f64(MIN_CENTER_W))
    if ed.right_w < f64(MIN_RIGHT_W) { ed.right_w = f64(MIN_RIGHT_W) }
    if ed.right_w > max_right { ed.right_w = max_right }
}

pub fn (ed $&Editor) sync_layout(view $&widgets.View, width f64, height f64) int {
    ed.viewport_w = math.max(f64(MIN_WINDOW_W), width)
    ed.viewport_h = math.max(f64(MIN_WINDOW_H), height)
    ed.clamp_widths(ed.viewport_w)

    body_h := ed.viewport_h - f64(TOOLBAR_H) - f64(FOOTER_H)
    center_w := math.max(f64(MIN_CENTER_W), ed.viewport_w - ed.left_w - ed.right_w - f64(SPLITTER_W) * 2.0)

    $rb := col_box(ed.viewport_w, ed.viewport_h, 0.0)
    rb.clip = true
    view.set_style(ed.id_root, &rb) >>>

    // 1. Topbar (centered stage tabs)
    $tb := row_box(ed.viewport_w, f64(TOOLBAR_H), 4.0)
    tb.padding = layout.Insets{left: 8.0, top: 6.0, right: 8.0, bottom: 6.0}
    view.set_style(ed.id_toolbar, &tb) >>>
    $scene_w := 184.0
    $tabs_w := 204.0
    if ed.viewport_w < 1080.0 {
        scene_w = 148.0
        tabs_w = 188.0
    }
    view.set_style(ed.id_brand, &leaf_box(54.0, 26.0)) >>>
    view.set_style(ed.panels.id_open_proj_btn, &leaf_box(28.0, 28.0)) >>>
    view.set_style(ed.id_tb_div1, &leaf_box(6.0, 22.0)) >>>
    view.set_style(ed.id_scene_select, &leaf_box(scene_w, 28.0)) >>>
    view.set_style(ed.id_new_scene_btn, &leaf_box(28.0, 28.0)) >>>
    view.set_style(ed.panels.id_scene_mgr_btn, &leaf_box(28.0, 28.0)) >>>
    view.set_style(ed.id_globals_btn, &leaf_box(28.0, 28.0)) >>>
    view.set_style(ed.id_stage_tabs, &leaf_box(tabs_w, 28.0)) >>>
    view.set_style(ed.id_undo_btn, &leaf_box(28.0, 28.0)) >>>
    view.set_style(ed.id_redo_btn, &leaf_box(28.0, 28.0)) >>>
    view.set_style(ed.id_save_btn, &leaf_box(28.0, 28.0)) >>>
    view.set_style(ed.id_tb_div2, &leaf_box(6.0, 22.0)) >>>
    view.set_style(ed.id_preview_btn, &leaf_box(28.0, 28.0)) >>>
    view.set_style(ed.panels.id_export_btn, &leaf_box(28.0, 28.0)) >>>
    view.set_style(ed.id_tb_div3, &leaf_box(6.0, 22.0)) >>>
    view.set_style(ed.panels.id_lang_btn, &leaf_box(40.0, 26.0)) >>>
    view.set_style(ed.id_dirty_badge, &leaf_box(76.0, 24.0)) >>>
    tb_used := 88.0 + 172.0 + scene_w + tabs_w + 268.0
    rem := math.max(8.0, ed.viewport_w - tb_used)
    rem_l := math.floor(rem * 0.5)
    rem_r := math.max(4.0, rem - rem_l)
    view.set_style(ed.id_tb_spacer_l, &leaf_box(math.max(4.0, rem_l), 24.0)) >>>
    view.set_style(ed.id_tb_spacer, &leaf_box(rem_r, 24.0)) >>>

    $ws := row_box(ed.viewport_w, body_h, 0.0)
    ws.cross_alignment = layout.CROSS_STRETCH
    view.set_style(ed.id_workspace, &ws) >>>

    // 2. Left Pane (Dual-Tab: Scene | Assets)
    $lp := col_box(ed.left_w, body_h, 0.0)
    lp.padding = layout.Insets{left: 8.0, top: 8.0, right: 8.0, bottom: 8.0}
    lp.clip = true
    view.set_style(ed.id_left_pane, &lp) >>>
    ilw := ed.left_w - 16.0
    left_body_h := math.max(120.0, body_h - 44.0)
    view.set_style(ed.id_left_tabs, &leaf_box(ilw, 28.0)) >>>

    if ed.left_tab == 0 {
        $scb := col_box(ilw, left_body_h, 4.0)
        scb.padding = layout.Insets{left: 0.0, top: 6.0, right: 0.0, bottom: 0.0}
        scb.clip = true
        view.set_style(ed.id_left_scene_box, &scb) >>>
        view.set_style(ed.panels.id_tree_hdr_row, &row_box(ilw, 24.0, 3.0)) >>>
        view.set_style(ed.id_tree_hdr, &leaf_box(math.max(60.0, ilw - 56.0), 24.0)) >>>
        view.set_style(ed.panels.id_node_up_btn, &leaf_box(24.0, 24.0)) >>>
        view.set_style(ed.panels.id_node_dn_btn, &leaf_box(24.0, 24.0)) >>>
        view.set_style(ed.panels.id_tree_filter, &leaf_box(ilw, 34.0)) >>>
        view.set_style(ed.id_tree_btns, &row_box(ilw, 28.0, 4.0)) >>>
        view.set_style(ed.id_add_node_select, &leaf_box(math.max(70.0, ilw - 56.0), 26.0)) >>>
        view.set_style(ed.id_dup_btn, &leaf_box(24.0, 24.0)) >>>
        view.set_style(ed.id_del_btn, &leaf_box(24.0, 24.0)) >>>
        tree_h := math.max(84.0, left_body_h - 104.0)
        view.set_style(ed.id_tree, &leaf_box(ilw, tree_h)) >>>

        $az := col_box(ilw, 0.0, 0.0)
        az.clip = true
        view.set_style(ed.id_left_assets_box, &az) >>>
        view.set_style(ed.id_assets_hdr_row, &row_box(ilw, 0.0, 0.0)) >>>
        view.set_style(ed.id_assets_hdr, &leaf_box(0.0, 0.0)) >>>
        view.set_style(ed.id_import_btn, &leaf_box(0.0, 0.0)) >>>
        view.set_style(ed.panels.id_relocate_btn, &leaf_box(0.0, 0.0)) >>>
        view.set_style(ed.panels.id_remove_asset_btn, &leaf_box(0.0, 0.0)) >>>
        view.set_style(ed.id_asset_list, &leaf_box(0.0, 0.0)) >>>
        view.set_style(ed.id_asset_select, &leaf_box(0.0, 0.0)) >>>
        view.set_style(ed.id_asset_meta, &leaf_box(0.0, 0.0)) >>>
        view.set_style(ed.panels.id_asset_prims, &leaf_box(0.0, 0.0)) >>>
        view.set_style(ed.id_asset_row, &row_box(ilw, 0.0, 0.0)) >>>
        view.set_style(ed.id_prim_field, &leaf_box(0.0, 0.0)) >>>
        view.set_style(ed.id_place_btn, &leaf_box(0.0, 0.0)) >>>
    } else {
        $sz := col_box(ilw, 0.0, 0.0)
        sz.clip = true
        view.set_style(ed.id_left_scene_box, &sz) >>>
        view.set_style(ed.panels.id_tree_hdr_row, &row_box(ilw, 0.0, 0.0)) >>>
        view.set_style(ed.id_tree_hdr, &leaf_box(0.0, 0.0)) >>>
        view.set_style(ed.panels.id_node_up_btn, &leaf_box(0.0, 0.0)) >>>
        view.set_style(ed.panels.id_node_dn_btn, &leaf_box(0.0, 0.0)) >>>
        view.set_style(ed.panels.id_tree_filter, &leaf_box(0.0, 0.0)) >>>
        view.set_style(ed.id_tree_btns, &row_box(ilw, 0.0, 0.0)) >>>
        view.set_style(ed.id_add_node_select, &leaf_box(0.0, 0.0)) >>>
        view.set_style(ed.id_dup_btn, &leaf_box(0.0, 0.0)) >>>
        view.set_style(ed.id_del_btn, &leaf_box(0.0, 0.0)) >>>
        view.set_style(ed.id_tree, &leaf_box(0.0, 0.0)) >>>

        $asb := col_box(ilw, left_body_h, 4.0)
        asb.padding = layout.Insets{left: 0.0, top: 6.0, right: 0.0, bottom: 0.0}
        asb.clip = true
        view.set_style(ed.id_left_assets_box, &asb) >>>
        view.set_style(ed.id_assets_hdr_row, &row_box(ilw, 26.0, 3.0)) >>>
        view.set_style(ed.id_assets_hdr, &leaf_box(math.max(50.0, ilw - 84.0), 24.0)) >>>
        view.set_style(ed.id_import_btn, &leaf_box(25.0, 24.0)) >>>
        view.set_style(ed.panels.id_relocate_btn, &leaf_box(25.0, 24.0)) >>>
        view.set_style(ed.panels.id_remove_asset_btn, &leaf_box(25.0, 24.0)) >>>
        view.set_style(ed.id_asset_select, &leaf_box(0.0, 0.0)) >>>

        is_glb := selected_asset_is_glb(ed)
        show_place := is_glb && ed.stage_mode != STAGE_MODE_TILEMAP
        $prims_h := 0.0
        if is_glb { prims_h = 18.0 }
        $row_h := 0.0
        if show_place { row_h = 38.0 }
        list_h := math.max(80.0, left_body_h - (26.0 + 26.0 + 18.0 + prims_h + row_h))
        view.set_style(ed.id_asset_list, &leaf_box(ilw, list_h)) >>>
        view.set_style(ed.id_asset_meta, &leaf_box(ilw, 18.0)) >>>
        view.set_style(ed.panels.id_asset_prims, &leaf_box(ilw, prims_h)) >>>
        if show_place {
            view.set_style(ed.id_asset_row, &row_box_end(ilw, 38.0, 6.0)) >>>
            view.set_style(ed.id_prim_field, &leaf_box(58.0, 36.0)) >>>
            view.set_style(ed.id_place_btn, &leaf_box(math.max(80.0, ilw - 64.0), 30.0)) >>>
        } else {
            view.set_style(ed.id_asset_row, &row_box(ilw, 0.0, 0.0)) >>>
            view.set_style(ed.id_prim_field, &leaf_box(0.0, 0.0)) >>>
            view.set_style(ed.id_place_btn, &leaf_box(0.0, 0.0)) >>>
        }
    }

    view.set_style(ed.id_left_split, &leaf_box(f64(SPLITTER_W), body_h)) >>>

    // 3. Precompute Right pane scroll_cw & sync Modeling + Center Stage
    irw := ed.right_w - 16.0
    scroll_cw := math.max(120.0, irw - 12.0)
    tri_w := (scroll_cw - 8.0) / 3.0

    $cp := col_box(center_w, body_h, 0.0)
    cp.padding = layout.Insets{left: 8.0, top: 8.0, right: 8.0, bottom: 8.0}
    cp.clip = true
    view.set_style(ed.id_center_pane, &cp) >>>
    icw := center_w - 16.0

    stage_3d_vis := ed.stage_mode == STAGE_MODE_3D || ed.stage_mode == STAGE_MODE_SPLIT
    mat_tab_vis := ed.insp_tab == 1
    comp_tab_vis := ed.insp_tab == 2
    has_node3d_mat := ed.insp_can_trs
    modeling_sync_layout($&ed.modeling, view, icw, scroll_cw, stage_3d_vis, has_node3d_mat, mat_tab_vis, comp_tab_vis) >>>

    $sb_hdr := row_box(icw, 34.0, 2.0)
    sb_hdr.padding = layout.Insets{left: 0.0, top: 0.0, right: 0.0, bottom: 4.0}
    view.set_style(ed.id_stage_bar, &sb_hdr) >>>
    $siw := 24.0
    $shape_w := 88.0
    $rbw := 26.0
    if icw < 540.0 {
        siw = 22.0
        shape_w = 70.0
    }
    if icw < 490.0 {
        siw = 19.0
        shape_w = 64.0
        rbw = 24.0
    }
    $stage_title_w := math.max(8.0, icw - (4.0 * rbw + 40.0))
    if stage_3d_vis {
        stage_title_w = math.max(8.0, icw - (11.0 * siw + shape_w + 6.0 + 4.0 * rbw + 40.0))
    }
    view.set_style(ed.id_stage_title, &leaf_box(stage_title_w, 26.0)) >>>
    view.set_style(ed.id_stage_axis_btn, &leaf_box(rbw, 26.0)) >>>
    view.set_style(ed.id_stage_snap_btn, &leaf_box(rbw, 26.0)) >>>
    view.set_style(ed.id_fit_btn, &leaf_box(rbw, 26.0)) >>>
    view.set_style(ed.id_stage_div1, &leaf_box(0.0, 0.0)) >>>
    view.set_style(ed.id_stage_div2, &leaf_box(0.0, 0.0)) >>>
    view.set_style(ed.id_snap_btn, &leaf_box(rbw, 26.0)) >>>

    $sub_h := 0.0
    if ed.modeling.bar_visible { sub_h = 34.0 }
    tv_h := math.max(120.0, body_h - 50.0 - sub_h)
    view.set_style(ed.id_top_view, &leaf_box(icw, tv_h)) >>>

    view.set_style(ed.id_right_split, &leaf_box(f64(SPLITTER_W), body_h)) >>>

    // 4. Right Pane (Compact Header + 3-Tab Inspector)
    $rp := col_box(ed.right_w, body_h, 5.0)
    rp.padding = layout.Insets{left: 8.0, top: 8.0, right: 8.0, bottom: 8.0}
    view.set_style(ed.id_right_pane, &rp) >>>

    $name_row_h := 34.0
    if ed.name_error.len > 0 { name_row_h = 50.0 }
    $apply_h := 0.0
    if ed.insp_tab != 2 && (ed.insp_dirty || ed.modeling.mat_dirty) { apply_h = 32.0 }
    scroll_h := math.max(120.0, body_h - 36.0 - 20.0 - name_row_h - 28.0 - apply_h)

    view.set_style(ed.id_insp_hdr, &leaf_box(irw, 20.0)) >>>
    view.set_style(ed.id_name_row, &row_box(irw, name_row_h, 6.0)) >>>
    view.set_style(ed.id_name_field, &leaf_box(math.max(90.0, irw - 82.0), name_row_h)) >>>
    view.set_style(ed.id_visible_chk, &leaf_box(76.0, 26.0)) >>>
    view.set_style(ed.id_insp_tabs, &leaf_box(irw, 28.0)) >>>

    $sb := col_box(irw, scroll_h, 0.0)
    sb.clip = true
    sb.padding = layout.Insets{left: 0.0, top: 2.0, right: 12.0, bottom: 6.0}
    view.set_style(ed.id_insp_scroll, &sb) >>>

    if ed.insp_tab == 0 {
        $txf := col_box(scroll_cw, 268.0, 4.0)
        txf.clip = true
        txf.padding = layout.Insets{left: 0.0, top: 4.0, right: 0.0, bottom: 4.0}
        view.set_style(ed.id_tab_transform_box, &txf) >>>
        view.set_style(ed.id_pos_lbl, &leaf_box(scroll_cw, 15.0)) >>>
        view.set_style(ed.id_pos_row, &row_box(scroll_cw, 38.0, 4.0)) >>>
        view.set_style(ed.id_pos_x, &leaf_box(tri_w, 38.0)) >>>
        view.set_style(ed.id_pos_y, &leaf_box(tri_w, 38.0)) >>>
        view.set_style(ed.id_pos_z, &leaf_box(tri_w, 38.0)) >>>
        view.set_style(ed.id_rot_lbl, &leaf_box(scroll_cw, 15.0)) >>>
        view.set_style(ed.id_rot_row, &row_box(scroll_cw, 38.0, 4.0)) >>>
        view.set_style(ed.id_rot_x, &leaf_box(tri_w, 38.0)) >>>
        view.set_style(ed.id_rot_y, &leaf_box(tri_w, 38.0)) >>>
        view.set_style(ed.id_rot_z, &leaf_box(tri_w, 38.0)) >>>
        view.set_style(ed.id_scale_lbl, &leaf_box(scroll_cw, 15.0)) >>>
        view.set_style(ed.id_scale_row, &row_box(scroll_cw, 38.0, 4.0)) >>>
        view.set_style(ed.id_scale_x, &leaf_box(tri_w, 38.0)) >>>
        view.set_style(ed.id_scale_y, &leaf_box(tri_w, 38.0)) >>>
        view.set_style(ed.id_scale_z, &leaf_box(tri_w, 38.0)) >>>
        view.set_style(ed.id_xf_div, &leaf_box(scroll_cw, 8.0)) >>>
        view.set_style(ed.id_parent_row, &row_box(scroll_cw, 30.0, 6.0)) >>>
        view.set_style(ed.id_parent_select, &leaf_box(math.max(90.0, scroll_cw - 84.0), 28.0)) >>>
        view.set_style(ed.id_reparent_btn, &leaf_box(78.0, 28.0)) >>>
        view.set_style(ed.id_vis_proc_row, &row_box(scroll_cw, 30.0, 0.0)) >>>
        view.set_style(ed.id_process_select, &leaf_box(scroll_cw, 28.0)) >>>

        $zmat := col_box(scroll_cw, 0.0, 0.0)
        zmat.clip = true
        view.set_style(ed.id_tab_material_box, &zmat) >>>

        $zc := col_box(scroll_cw, 0.0, 0.0)
        zc.clip = true
        view.set_style(ed.id_tab_comp_box, &zc) >>>
        view.set_style(ed.id_add_comp_row, &row_box(scroll_cw, 0.0, 0.0)) >>>
        view.set_style(ed.id_add_comp_select, &leaf_box(0.0, 0.0)) >>>
        $zs := col_box(scroll_cw, 0.0, 0.0)
        zs.clip = true
        view.set_style(ed.id_surf_box, &zs) >>>
        view.set_style(ed.id_surf_div, &leaf_box(0.0, 0.0)) >>>
        view.set_style(ed.id_surf_card_hdr, &leaf_box(0.0, 0.0)) >>>
        view.set_style(ed.id_surf_info, &leaf_box(0.0, 0.0)) >>>
        view.set_style(ed.id_surf_bind_row, &row_box(scroll_cw, 0.0, 0.0)) >>>
        view.set_style(ed.id_surf_asset_select, &leaf_box(0.0, 0.0)) >>>
        view.set_style(ed.id_surf_btn_row, &row_box(scroll_cw, 0.0, 0.0)) >>>
        view.set_style(ed.id_surf_prim_field, &leaf_box(0.0, 0.0)) >>>
        view.set_style(ed.id_surf_bind_btn, &leaf_box(0.0, 0.0)) >>>
        view.set_style(ed.id_surf_clear_btn, &leaf_box(0.0, 0.0)) >>>
        view.set_style(ed.id_lod_info, &leaf_box(0.0, 0.0)) >>>
        view.set_style(ed.id_lod_input_row, &row_box(scroll_cw, 0.0, 0.0)) >>>
        view.set_style(ed.id_lod_hyst_field, &leaf_box(0.0, 0.0)) >>>
        view.set_style(ed.id_lod_dist_field, &leaf_box(0.0, 0.0)) >>>
        view.set_style(ed.id_lod_prim_field, &leaf_box(0.0, 0.0)) >>>
        view.set_style(ed.id_lod_btn_row, &row_box(scroll_cw, 0.0, 0.0)) >>>
        view.set_style(ed.id_lod_asset_select, &leaf_box(0.0, 0.0)) >>>
        view.set_style(ed.id_lod_add_btn, &leaf_box(0.0, 0.0)) >>>
        view.set_style(ed.id_lod_pop_btn, &leaf_box(0.0, 0.0)) >>>
        view.set_style(ed.id_comp_empty_lbl, &leaf_box(scroll_cw, 0.0)) >>>
        $man_open := []bool{}
        for mf in ed.comp_manual_open { man_open.push(mf) }
        _ := sync_comp_layout($&ed.comp, view, scroll_cw, false, &man_open) >>>
        ed.insp_tab_content_h = 268.0
    } else if ed.insp_tab == 1 {
        $zxf := col_box(scroll_cw, 0.0, 0.0)
        zxf.clip = true
        view.set_style(ed.id_tab_transform_box, &zxf) >>>
        view.set_style(ed.id_pos_lbl, &leaf_box(0.0, 0.0)) >>>
        view.set_style(ed.id_pos_row, &row_box(scroll_cw, 0.0, 0.0)) >>>
