fn (ed $&Editor) open_scene_manage_modal(view $&widgets.View) {
    if ed.scene_index < 0 || ed.scene_index >= ed.project.scenes.len { << }
    ed.blur_all_fields()
    cur_key := ed.project.scenes[ed.scene_index].key + ""
    sc_cnt := ed.project.scenes.len
    vw := ed.viewport_w
    vh := ed.viewport_h
    st := ed.styles.clone()
    mods := $&ed.modals
    mods.open_scene_manage(&cur_key, sc_cnt)
    mods.layout(vw, vh, &st)
    repaint(view, ed.id_root)
}

fn (ed $&Editor) open_export_modal(view $&widgets.View) {
    ed.blur_all_fields()
    $def_dir := ed.export_target_dir + ""
    if def_dir.len == 0 { def_dir = ed.output_dir + "" }
    vw := ed.viewport_w
    vh := ed.viewport_h
    st := ed.styles.clone()
    mods := $&ed.modals
    mods.open_export(&def_dir)
    mods.layout(vw, vh, &st)
    repaint(view, ed.id_root)
}

fn (ed $&Editor) open_globals_modal(view $&widgets.View) {
    ed.blur_all_fields()
    doc := ed.draft.document() >>> (err) {
        ed.set_status(STATUS_ERR, err.msg(), view)
        <<
    }
    vw := ed.viewport_w
    vh := ed.viewport_h
    st := ed.styles.clone()
    mods := $&ed.modals
    mods.open_globals(&doc)
    mods.layout(vw, vh, &st)
    repaint(view, ed.id_root)
}

pub fn (ed $&Editor) switch_scene(target_idx int, check_dirty bool, view $&widgets.View) {
    if target_idx < 0 || target_idx >= ed.project.scenes.len || target_idx == ed.scene_index {
        sidx := ed.scene_index
        set_sel_selected($&ed.scene_select, sidx)
        <<
    }
    if check_dirty && ed.draft.dirty() {
        sidx := ed.scene_index
        set_sel_selected($&ed.scene_select, sidx)
        ed.open_unsaved_modal(target_idx, false, view)
        <<
    }
    path := ed.project.scene_source(target_idx) >>> (err) {
        ed.set_status(STATUS_ERR, err.msg(), view)
        <<
    }
    next_draft := open_draft(path) >>> (err) {
        ed.set_status(STATUS_ERR, err.msg(), view)
        <<
    }
    ed.scene_index = target_idx
    ed.draft = next_draft
    ed.reset_comp_manual_open()
    ed.vp3d.scene_rev_sent = ""
    next_sel := initial_selected_node(&ed.draft)
    ed.set_single_selection(next_sel)
    ed.placing_mode = false
    set_sel_selected($&ed.scene_select, target_idx)
    ed.refresh_after_document_change(true, view)
    ed.sync_tree_selection(false)
    ed.set_status(STATUS_INFO, "Opened " + ed.project.scenes[target_idx].key, view)
}

fn (ed $&Editor) flush_pending_edits_before_action(view $&widgets.View) {
    if ed.modeling.mat_dirty && ed.insp_can_trs {
        ed.do_apply_pbr_material(view)
    }
    if ed.insp_dirty && (ed.selected_node >= 0 || ed.selected_nodes.len > 0) {
        _ := ed.apply_inspector(view) >>> (err) {
            _ := err
            <<
        }
    }
}

pub fn (ed $&Editor) do_save(view $&widgets.View) bool {
    ed.flush_pending_edits_before_action(view)
    proj := clone_project(&ed.project)
    vbin := ed.validator_bin + ""
    d := $&ed.draft
    d.save(&proj, &vbin) >>> (err) {
        ed.set_status(STATUS_ERR, err.msg(), view)
        << false
    }
    ed.sync_toolbar_states()
    repaint(view, ed.id_toolbar)
    ed.set_status(STATUS_OK, tr(ed.lang, "Saved ", "已保存 ") + ed.project.scenes[ed.scene_index].key, view)
    << true
}

pub fn (ed $&Editor) do_undo(view $&widgets.View) {
    if !ed.draft.can_undo() { << }
    d := $&ed.draft
    _ := d.undo_edit()
    ed.refresh_after_document_change(false, view)
    ed.set_status(STATUS_INFO, tr(ed.lang, "Undid edit", "已撤销"), view)
}

