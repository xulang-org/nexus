pub fn (ed $&Editor) do_duplicate_node(view $&widgets.View) {
    doc := ed.draft.document() >>> (err) {
        ed.set_status(STATUS_ERR, err.msg(), view)
        <<
    }
    targets := ed.selected_non_root_targets(&doc)
    if targets.len == 0 {
        ed.set_status(STATUS_ERR, tr(ed.lang, "Select a non-root node to duplicate", "请先选择非根节点再复制"), view)
        <<
    }
    $step := 0.5
    if ed.top_snap_enabled && ed.snap.move_step > 0.0 {
        step = ed.snap.move_step
    }
    d := $&ed.draft
    new_ids := d.duplicate_nodes(&targets, fm.vec3(step, 0.0, 0.0)) >>> (err) {
        ed.set_status(STATUS_ERR, err.msg(), view)
        <<
    }
    if new_ids.len == 1 {
        ed.set_single_selection(new_ids[0])
        ed.refresh_after_document_change(false, view)
        ed.set_status(STATUS_OK, tr(ed.lang, "Duplicated subtree", "已复制节点"), view)
        <<
    }
    ed.set_selection_list(&new_ids, view)
    ed.refresh_after_document_change(false, view)
    ed.set_status(STATUS_OK, tr(ed.lang, "Duplicated " + str(new_ids.len) + " nodes", "已复制 " + str(new_ids.len) + " 个节点"), view)
}

pub fn (ed $&Editor) do_select_all_nodes(view $&widgets.View) {
    doc := ed.draft.document() >>> (err) { << }
    if doc.node_count() <= 1 {
        ed.set_status(STATUS_INFO, tr(ed.lang, "No child nodes to select", "场景中暂无可选子节点"), view)
        <<
    }
    $all := []int{}
    for i in 1:doc.node_count() { all.push(i) }
    ed.set_selection_list(&all, view)
    ed.set_status(STATUS_INFO, tr(ed.lang, "Selected all " + str(all.len) + " nodes", "已全选 " + str(all.len) + " 个节点"), view)
}

pub fn (ed $&Editor) do_nudge_selection(dx f64, dy f64, dz f64, view $&widgets.View) {
    doc := ed.draft.document() >>> (err) { << }
    targets := ed.selected_non_root_targets(&doc)
    if targets.len == 0 { << }
    d := $&ed.draft
    _ := d.move_nodes_delta(&targets, dx, dy, dz) >>> (err) {
        ed.set_status(STATUS_ERR, err.msg(), view)
        <<
    }
    ed.refresh_after_document_change(false, view)
}

pub fn (ed $&Editor) do_reset_transform(part int, view $&widgets.View) {
    doc := ed.draft.document() >>> (err) {
        ed.set_status(STATUS_ERR, err.msg(), view)
        <<
    }
    targets := ed.effective_selected_nodes(&doc)
    if targets.len == 0 { << }
    d := $&ed.draft
    if part == 1 {
        _ := d.set_nodes_properties_batch(&targets, false, true, false, 0, true, true, true, fm.vec3(0.0, 0.0, 0.0), false, false, false, fm.vec3(0.0, 0.0, 0.0), false, false, false, fm.vec3(1.0, 1.0, 1.0)) >>> (err) {
            ed.set_status(STATUS_ERR, err.msg(), view)
            <<
        }
        ed.refresh_after_document_change(false, view)
        ed.set_status(STATUS_OK, tr(ed.lang, "Reset Position to (0, 0, 0)", "已重置位置为 (0, 0, 0)"), view)
    } else if part == 2 {
        _ := d.set_nodes_properties_batch(&targets, false, true, false, 0, false, false, false, fm.vec3(0.0, 0.0, 0.0), true, true, true, fm.vec3(0.0, 0.0, 0.0), false, false, false, fm.vec3(1.0, 1.0, 1.0)) >>> (err) {
            ed.set_status(STATUS_ERR, err.msg(), view)
            <<
        }
        ed.refresh_after_document_change(false, view)
        ed.set_status(STATUS_OK, tr(ed.lang, "Reset Rotation to (0, 0, 0)", "已重置旋转为 (0, 0, 0)"), view)
    } else if part == 3 {
        _ := d.set_nodes_properties_batch(&targets, false, true, false, 0, false, false, false, fm.vec3(0.0, 0.0, 0.0), false, false, false, fm.vec3(0.0, 0.0, 0.0), true, true, true, fm.vec3(1.0, 1.0, 1.0)) >>> (err) {
            ed.set_status(STATUS_ERR, err.msg(), view)
            <<
        }
        ed.refresh_after_document_change(false, view)
        ed.set_status(STATUS_OK, tr(ed.lang, "Reset Scale to (1, 1, 1)", "已重置缩放为 (1, 1, 1)"), view)
    }
}

pub fn (ed $&Editor) do_delete_node(view $&widgets.View) {
    $to_del := []int{}
    for i in 0:ed.selected_nodes.len { to_del.push(ed.selected_nodes[i]) }
    sel_node := ed.selected_node
    d := $&ed.draft
    $next_sel := 0
    if to_del.len > 1 {
        next_sel = d.delete_nodes(&to_del) >>> (err) {
            ed.set_status(STATUS_ERR, err.msg(), view)
            <<
        }
    } else {
        next_sel = d.delete_node(sel_node) >>> (err) {
            ed.set_status(STATUS_ERR, err.msg(), view)
            <<
        }
    }
    ed.set_single_selection(next_sel)
    ed.refresh_after_document_change(false, view)
    ed.set_status(STATUS_OK, "Deleted selection", view)
}

pub fn (ed $&Editor) do_move_sibling(delta int, view $&widgets.View) {
    if ed.selected_node <= 0 { << }
    sel := ed.selected_node
    d := $&ed.draft
    next_idx := d.move_node_sibling(sel, delta) >>> (err) {
        ed.set_status(STATUS_ERR, err.msg(), view)
        <<
    }
    ed.set_single_selection(next_idx)
    ed.refresh_after_document_change(false, view)
    if delta < 0 {
        ed.set_status(STATUS_OK, "Moved node up", view)
    } else {
        ed.set_status(STATUS_OK, "Moved node down", view)
    }
}

pub fn (ed $&Editor) do_toggle_node_visible(node_idx int, view $&widgets.View) {
    doc := ed.draft.document() >>> (err) {
        ed.set_status(STATUS_ERR, err.msg(), view)
        <<
    }
    if node_idx < 0 || node_idx >= doc.node_count() { << }
    nd := doc.describe_node(node_idx) >>> (err) { << }
    next_vis := !nd.visible
    d := $&ed.draft
    d.set_nodes_visible_only(&[node_idx], next_vis) >>> (err) {
        ed.set_status(STATUS_ERR, err.msg(), view)
        <<
    }
    ed.refresh_after_visibility_change(view)
    if next_vis {
        ed.set_status(STATUS_OK, tr(ed.lang, "Shown " + nd.name, "已显示 " + nd.name), view)
    } else {
        ed.set_status(STATUS_OK, tr(ed.lang, "Hidden " + nd.name, "已隐藏 " + nd.name), view)
    }
}

fn (ed $&Editor) begin_tree_vis_drag(start_sid int, view $&widgets.View) {
    doc := ed.draft.document() >>> (err) {
        ed.tree_vis_drag_active = false
        ed.set_status(STATUS_ERR, err.msg(), view)
        <<
    }
    if start_sid < 0 || start_sid >= doc.node_count() {
        ed.tree_vis_drag_active = false
        <<
    }
    ed.tree_vis_drag_orig = map[int]bool{}
    for i in 0:doc.node_count() {
        n0 := doc.describe_node(i) >>> (err) {
            _ := err
            ->
        }
        ed.tree_vis_drag_orig[i] = n0.visible
    }
    nd := doc.describe_node(start_sid) >>> (err) {
        _ := err
        ed.tree_vis_drag_active = false
        <<
    }
    target_vis := !nd.visible
    ed.tree_vis_drag_target = target_vis
    ed.tree_vis_drag_changed = 1
    d := $&ed.draft
    d.set_nodes_visible_only_coalesced(&[start_sid], target_vis, true) >>> (err) {
        ed.tree_vis_drag_active = false
        ed.set_status(STATUS_ERR, err.msg(), view)
        <<
    }
    ed.refresh_after_visibility_change(view)
    if target_vis {
        ed.set_status(STATUS_OK, tr(ed.lang, "Shown " + nd.name, "已显示 " + nd.name), view)
    } else {
        ed.set_status(STATUS_OK, tr(ed.lang, "Hidden " + nd.name, "已隐藏 " + nd.name), view)
    }
}

fn (ed $&Editor) sync_tree_vis_drag_range(view $&widgets.View) {
    if ed.tree_vis_drag_start_row < 0 || ed.tree_vis_drag_cur_row < 0 { << }
    n_vis := ed.tree.visible_count()
    if n_vis <= 0 { << }
    $lo := ed.tree_vis_drag_start_row
    $hi := ed.tree_vis_drag_cur_row
    if lo > hi {
        tmp := lo
        lo = hi
        hi = tmp
    }
    if lo < 0 { lo = 0 }
    if hi >= n_vis { hi = n_vis - 1 }
    $in_range := map[int]bool{}
    for r in lo:(hi + 1) {
        rtid := ed.tree_visible_tid_at_row(r)
        if rtid >= 0 && ed.tree_to_scene.has(rtid) {
            in_range[ed.tree_to_scene[rtid]] = true
        }
    }
    doc := ed.draft.document() >>> (err) {
        ed.set_status(STATUS_ERR, err.msg(), view)
        <<
    }
    $desired := map[int]bool{}
    $changed_from_orig := 0
    $any_diff := false
    target_vis := ed.tree_vis_drag_target
    for sid in 0:doc.node_count() {
        orig := ed.tree_vis_drag_orig.get_or(sid, true)
        $want := orig
        if in_range.has(sid) {
            want = target_vis
        }
        if want != orig {
            changed_from_orig = changed_from_orig + 1
        }
        cur_nd := doc.describe_node(sid) >>> (err) {
            _ := err
            ->
        }
        if cur_nd.visible != want {
            desired[sid] = want
            any_diff = true
        }
    }
    ed.tree_vis_drag_changed = changed_from_orig
    if !any_diff { << }
    start_sid := ed.tree_vis_drag_start_sid
    d := $&ed.draft
    d.set_nodes_visibility_map_coalesced(&desired, false) >>> (err) {
        ed.set_status(STATUS_ERR, err.msg(), view)
        <<
    }
    ed.refresh_after_visibility_change(view)
    if changed_from_orig > 1 {
        if target_vis {
            ed.set_status(STATUS_OK, tr(ed.lang, "Shown " + str(changed_from_orig) + " nodes", "已显示 " + str(changed_from_orig) + " 个节点"), view)
        } else {
            ed.set_status(STATUS_OK, tr(ed.lang, "Hidden " + str(changed_from_orig) + " nodes", "已隐藏 " + str(changed_from_orig) + " 个节点"), view)
        }
    } else if changed_from_orig == 1 && start_sid >= 0 && start_sid < doc.node_count() {
        snd := doc.describe_node(start_sid) >>> (err) {
            _ := err
            <<
        }
        if target_vis {
            ed.set_status(STATUS_OK, tr(ed.lang, "Shown " + snd.name, "已显示 " + snd.name), view)
        } else {
            ed.set_status(STATUS_OK, tr(ed.lang, "Hidden " + snd.name, "已隐藏 " + snd.name), view)
        }
    }
}

fn (ed $&Editor) finish_tree_vis_drag(view $&widgets.View) {
    ed.sync_tree_vis_drag_range(view)
    ed.tree_vis_drag_start_row = -1
    ed.tree_vis_drag_cur_row = -1
    ed.tree_vis_drag_start_sid = -1
    ed.tree_vis_drag_changed = 0
    ed.tree_vis_drag_orig = map[int]bool{}
}

pub fn (ed $&Editor) do_toggle_selected_visible(view $&widgets.View) {
    doc := ed.draft.document() >>> (err) {
        ed.set_status(STATUS_ERR, err.msg(), view)
        <<
    }
    if ed.selected_node < 0 || ed.selected_node >= doc.node_count() { << }
    nd := doc.describe_node(ed.selected_node) >>> (err) { << }
    targets := ed.effective_selected_nodes(&doc)
    next_vis := !nd.visible
    d := $&ed.draft
    d.set_nodes_visible_only(&targets, next_vis) >>> (err) {
        ed.set_status(STATUS_ERR, err.msg(), view)
        <<
    }
    ed.refresh_after_document_change(false, view)
    if targets.len > 1 {
        if next_vis {
            ed.set_status(STATUS_OK, tr(ed.lang, "Shown " + str(targets.len) + " nodes", "已显示 " + str(targets.len) + " 个节点"), view)
        } else {
            ed.set_status(STATUS_OK, tr(ed.lang, "Hidden " + str(targets.len) + " nodes", "已隐藏 " + str(targets.len) + " 个节点"), view)
        }
    } else if next_vis {
        ed.set_status(STATUS_OK, "Shown " + nd.name, view)
    } else {
        ed.set_status(STATUS_OK, "Hidden " + nd.name, view)
    }
}

pub fn (ed $&Editor) do_remove_selected_asset(view $&widgets.View) {
    sel := ed.selected_asset
    if sel < 0 || sel >= ed.project.assets.len {
        ed.set_status(STATUS_ERR, "No asset selected", view)
        <<
    }
    uid := ed.project.assets[sel].key + ""
    rel := ed.project.assets[sel].path + ""
    proj_path := ed.project.path + ""
    _ := remove_asset(&proj_path, &uid) >>> (err) {
        ed.set_status(STATUS_ERR, err.msg(), view)
        <<
    }
    reloaded := load_project(proj_path) >>> (err) {
        ed.set_status(STATUS_ERR, err.msg(), view)
        <<
    }
    ed.project = reloaded
    ed.panels.glb_prim_cache = map[string]string{}
    ed.placing_mode = false
    ed.refresh_project_selectors()
    ed.ensure_context_layout(view)
    ed.sync_toolbar_states()
    repaint(view, ed.id_left_pane)
    ed.set_status(STATUS_OK, "Removed asset " + rel, view)
}

pub fn (ed $&Editor) open_project_file(project_path &string, view $&widgets.View) int {
    next_proj := load_project(*project_path + "") >>>
    scene_path := next_proj.scene_source(0) >>>
    next_draft := open_draft(scene_path) >>>
    ed.project = next_proj
    ed.scene_index = 0
    ed.draft = next_draft
    ed.reset_comp_manual_open()
    ed.set_single_selection(0)
    ed.placing_mode = false
    ed.panels.glb_prim_cache = map[string]string{}
    set_field_val($&ed.panels.fields[PF_TREE_FILTER], &"")
    ed.refresh_project_selectors()
    ed.refresh_after_document_change(true, view)
    ed.set_status(STATUS_OK, "Opened project " + filepath.base(&ed.project.directory), view)
    << 0
}

pub fn (ed $&Editor) do_reparent_selected(view $&widgets.View) {
    sel_opt := ed.parent_select.selected()
    if sel_opt < 0 || sel_opt >= ed.parent_candidates.len { << }
    target_parent := ed.parent_candidates[sel_opt]
    doc := ed.draft.document() >>> (err) {
        ed.set_status(STATUS_ERR, err.msg(), view)
        <<
    }
    targets := ed.selected_non_root_targets(&doc)
    if targets.len == 0 { << }
    if targets.len == 1 {
        sel_node := targets[0]
        d := $&ed.draft
        next_idx := d.reparent_node(sel_node, target_parent, true) >>> (err) {
            ed.set_status(STATUS_ERR, err.msg(), view)
            <<
        }
        ed.set_single_selection(next_idx)
        ed.refresh_after_document_change(false, view)
        ed.set_status(STATUS_OK, tr(ed.lang, "Reparented node", "已更改节点父级"), view)
        <<
    }
    d := $&ed.draft
    next_sels := d.reparent_nodes(&targets, target_parent, true) >>> (err) {
        ed.set_status(STATUS_ERR, err.msg(), view)
        <<
    }
    ed.set_selection_list(&next_sels, view)
    ed.refresh_after_document_change(false, view)
    ed.set_status(STATUS_OK, tr(ed.lang, "Reparented " + str(targets.len) + " nodes", "已更改 " + str(targets.len) + " 个节点的父级"), view)
}

pub fn (ed $&Editor) do_place_at(wx f64, wz f64, view $&widgets.View) {
    idx := ed.selected_asset
    if idx < 0 || idx >= ed.project.assets.len {
        ed.placing_mode = false
        ed.set_status(STATUS_ERR, "No GLB asset selected", view)
        <<
    }
    prim_txt := strings.trim_space(&ed.prim_field.value())
    $prim := 0
    if prim_txt.len > 0 {
        prim = strconv.atoi(&prim_txt) >>> (err) {
            ed.set_status(STATUS_ERR, "Primitive index must be a non-negative integer", view)
            <<
        }
    }
    uid := ed.project.assets[idx].key + ""
    proj := clone_project(&ed.project)
    d := $&ed.draft
    new_node := d.place_asset(&proj, uid, prim, wx, wz) >>> (err) {
        ed.set_status(STATUS_ERR, err.msg(), view)
        <<
    }
    ed.placing_mode = false
    ed.set_single_selection(new_node)
    ed.refresh_after_document_change(false, view)
    ed.set_status(STATUS_OK, "Placed GLB at (" + fmt_coord(wx) + ", 0, " + fmt_coord(wz) + ")", view)
}

pub fn (ed $&Editor) set_stage_mode(mode int, view $&widgets.View) {
    ed.stage_mode = mode
    if mode == STAGE_MODE_TILEMAP {
        ctx_t := ed.context.clone()
        proj_t := clone_project(&ed.project)
        src_t := ed.draft.source + ""
        sel_t := ed.selected_node
        b_t := copy_rect(&ed.top_view_local)
        doc_t := ed.draft.document() >>> (err) {
            ed.set_status(STATUS_ERR, err.msg(), view)
            <<
        }
        tm := $&ed.tilemap
        tm.sync_from_document(&ctx_t, &proj_t, &src_t, &doc_t, sel_t, &b_t)
        tm.fit(&b_t)
    } else if mode == STAGE_MODE_3D || mode == STAGE_MODE_SPLIT {
        ed.vp3d.dirty_render = true
        ed.req_embed_render = true
    }
    ed.ensure_context_layout(view)
    ed.sync_toolbar_states()
    ed.repaint_all(view)
}

pub fn (ed $&Editor) do_fit_active_stage(view $&widgets.View) {
    if ed.stage_mode == STAGE_MODE_TILEMAP {
        b_t := copy_rect(&ed.top_view_local)
        tm := $&ed.tilemap
        tm.fit(&b_t)
        repaint(view, ed.id_top_view)
        <<
    }
    if ed.stage_mode == STAGE_MODE_3D || ed.stage_mode == STAGE_MODE_SPLIT {
        doc := ed.draft.document() >>> (err) {
            ed.set_status(STATUS_ERR, err.msg(), view)
            <<
        }
        pts := clone_stage_points(&ed.stage_pts)
        vp := $&ed.vp3d
        vp.fit_scene(&pts, &doc)
        ed.vp3d.dirty_render = true
        ed.req_embed_render = true
        repaint(view, ed.id_top_view)
        <<
    }
    pts := clone_stage_points(&ed.stage_pts)
    tv_rect := copy_rect(&ed.top_view_local)
    tv := $&ed.top_view
    tv.fit_points(&pts, &tv_rect)
    repaint(view, ed.id_top_view)
}

pub fn (ed $&Editor) do_focus_selected_or_scene(force_all bool, view $&widgets.View) {
    if force_all {
        ed.do_fit_active_stage(view)
        <<
    }
    doc := ed.draft.document() >>> (err) {
        ed.do_fit_active_stage(view)
        <<
    }
    non_roots := ed.selected_non_root_targets(&doc)
    if non_roots.len == 0 {
        ed.do_fit_active_stage(view)
        <<
    }
    pts := clone_stage_points(&ed.stage_pts)
    if ed.stage_mode == STAGE_MODE_3D || ed.stage_mode == STAGE_MODE_SPLIT {
        $sum := fm.vec3(0.0, 0.0, 0.0)
        $cnt := 0
        for i in 0:non_roots.len {
            nid := non_roots[i]
            if nid > 0 && nid < pts.len && pts[nid].kind == resource.NODE_3D {
                sum = sum.add(fm.vec3(pts[nid].x, pts[nid].y, pts[nid].z))
                cnt = cnt + 1
            }
        }
        if cnt == 0 {
            ed.do_fit_active_stage(view)
            <<
        }
        target_ctr := sum.scaled(1.0 / f64(cnt))
        if ed.vp3d.center.sub(target_ctr).length() < 0.25 && ed.vp3d.distance < 12.0 {
            ed.do_fit_active_stage(view)
            ed.set_status(STATUS_INFO, tr(ed.lang, "Fitted full scene (F)", "已适配完整场景 (F)"), view)
            <<
        }
        vp := $&ed.vp3d
        if vp.fit_selection(&pts, &non_roots, &doc) {
            ed.vp3d.dirty_render = true
            ed.req_embed_render = true
            repaint(view, ed.id_top_view)
            ed.set_status(STATUS_INFO, tr(ed.lang, "Focused selection (press F again for full scene)", "已聚焦选中对象（再按 F 查看全局）"), view)
            <<
        }
        ed.do_fit_active_stage(view)
        <<
    }
    if ed.stage_mode == STAGE_MODE_2D {
        tv_rect := copy_rect(&ed.top_view_local)
        tv := $&ed.top_view
        if tv.fit_selection(&pts, &non_roots, &tv_rect) {
            repaint(view, ed.id_top_view)
            ed.set_status(STATUS_INFO, tr(ed.lang, "Focused selection (Shift+F for full scene)", "已聚焦选中对象（Shift+F 查看全局）"), view)
            <<
        }
    }
    ed.do_fit_active_stage(view)
}

pub fn (ed $&Editor) do_spawn_whitebox(shape string, view $&widgets.View) {
    $parent_idx := 0
    if ed.selected_node > 0 {
        doc0 := ed.draft.document() >>> (err) {
            ed.set_status(STATUS_ERR, err.msg(), view)
            <<
        }
        if ed.selected_node < doc0.node_count() {
            nd0 := doc0.describe_node(ed.selected_node) >>> (err) {
                ed.set_status(STATUS_ERR, err.msg(), view)
                <<
            }
            if nd0.parent >= 0 { parent_idx = nd0.parent }
        }
    }
    $snap_step := 0.0
    if ed.top_snap_enabled && ed.snap.move_step > 0.0 { snap_step = ed.snap.move_step }
    cx := ed.vp3d.center.x
    cz := ed.vp3d.center.z
    d := $&ed.draft
    new_node := d.spawn_whitebox_node_near(parent_idx, shape + "", fm.vec3(1.6, 1.4, 1.6), cx, cz, snap_step) >>> (err) {
        ed.set_status(STATUS_ERR, err.msg(), view)
        <<
    }
    if ed.stage_mode != STAGE_MODE_3D && ed.stage_mode != STAGE_MODE_SPLIT {
        ed.stage_mode = STAGE_MODE_3D
    }
    ed.set_single_selection(new_node)
    ed.refresh_after_document_change(false, view)
    ed.set_status(STATUS_OK, tr(ed.lang, "Created Whitebox " + shape, "已创建白盒体 " + shape), view)
}

pub fn (ed $&Editor) do_spawn_csg_cut(view $&widgets.View) {
    $snap_step := 0.0
    if ed.top_snap_enabled && ed.snap.move_step > 0.0 { snap_step = ed.snap.move_step }
    cx := ed.vp3d.center.x
    cz := ed.vp3d.center.z
    d := $&ed.draft
    new_node := d.spawn_csg_hollow_node_near(0, fm.vec3(2.2, 1.8, 2.2), fm.vec3(1.2, 2.4, 1.2), cx, cz, snap_step) >>> (err) {
        ed.set_status(STATUS_ERR, err.msg(), view)
        <<
    }
    if ed.stage_mode != STAGE_MODE_3D && ed.stage_mode != STAGE_MODE_SPLIT {
        ed.stage_mode = STAGE_MODE_3D
    }
    ed.set_single_selection(new_node)
    ed.refresh_after_document_change(false, view)
    ed.set_status(STATUS_OK, tr(ed.lang, "Created CSG Hollow Cut", "已创建 CSG 布尔挖空体"), view)
}

pub fn (ed $&Editor) do_mesh_op(op string, amount f64, val f64, view $&widgets.View) {
    sel_node := ed.selected_node
    sub_f := ed.vp3d.selected_face
    sub_e0 := ed.vp3d.selected_e0
    sub_e1 := ed.vp3d.selected_e1
    d := $&ed.draft
    _ := d.apply_mesh_op(sel_node, op + "", sub_f, sub_e0, sub_e1, amount, val) >>> (err) {
        ed.set_status(STATUS_ERR, err.msg(), view)
        <<
    }
    ed.refresh_after_document_change(false, view)
    ed.set_status(STATUS_OK, tr(ed.lang, "Applied mesh op: " + op, "已执行网格操作: " + op), view)
}

fn (ed &Editor) modeling_step_val(fallback f64) f64 {
    raw := ed.modeling.fields[MF_OP_STEP].value()
    v := parse_f64_or(&raw, "Step") >>> (err) {
        _ := err
        << fallback
    }
    if !fm.finite(v) || v <= 0.0 { << fallback }
    << math.max(0.01, math.min(5.0, v))
}

fn normalize_pbr_rgb(mr f64, mg f64, mb f64) fm.Vec3 {
    if mr > 1.0 || mg > 1.0 || mb > 1.0 {
        << fm.vec3(
            math.max(0.0, math.min(1.0, mr / 255.0)),
            math.max(0.0, math.min(1.0, mg / 255.0)),
            math.max(0.0, math.min(1.0, mb / 255.0))
        )
    }
    << fm.vec3(
        math.max(0.0, math.min(1.0, mr)),
        math.max(0.0, math.min(1.0, mg)),
        math.max(0.0, math.min(1.0, mb))
    )
}

fn (ed $&Editor) build_pbr_material_from_ui(doc &resource.Document, sel_node int) rm.MaterialAsset {
    mr := parse_f64_or(&ed.modeling.fields[MF_R].value(), "R") >>>
    mg := parse_f64_or(&ed.modeling.fields[MF_G].value(), "G") >>>
    mb := parse_f64_or(&ed.modeling.fields[MF_B].value(), "B") >>>
    met := parse_f64_or(&ed.modeling.fields[MF_METALLIC].value(), "Metallic") >>>
    rgh := parse_f64_or(&ed.modeling.fields[MF_ROUGHNESS].value(), "Roughness") >>>
    emt := parse_f64_or(&ed.modeling.fields[MF_EMIT].value(), "Emit") >>>
    alp := parse_f64_or(&ed.modeling.fields[MF_ALPHA].value(), "Alpha") >>>
    coat := parse_f64_or(&ed.modeling.fields[MF_COAT].value(), "Coat") >>>
    ior_v := parse_f64_or(&ed.modeling.fields[MF_IOR].value(), "IOR") >>>
    $mat := find_node_material_override(doc, sel_node, 0)
    mat.base_color = normalize_pbr_rgb(mr, mg, mb)
    mat.metallic = math.max(0.0, math.min(1.0, met))
    mat.roughness = math.max(0.045, math.min(1.0, rgh))
    ev := math.max(0.0, math.min(16.0, emt))
    mat.emission = fm.vec3(ev * mat.base_color.x, ev * mat.base_color.y, ev * mat.base_color.z)
    av := math.max(0.0, math.min(1.0, alp))
    mat.alpha = av
    if av < 0.995 {
        mat.alpha_mode = rm.ALPHA_BLEND
    } else {
        mat.alpha_mode = rm.ALPHA_OPAQUE
    }
    cv := math.max(0.0, math.min(1.0, coat))
    mat.clearcoat = cv
    if cv > 0.0 && mat.clearcoat_roughness > 0.12 {
        mat.clearcoat_roughness = 0.08
    }
    mat.ior = math.max(1.0, math.min(2.5, ior_v))
    mat.double_sided = ed.modeling.mat_two_sided
    tsel := ed.modeling.mat_tex_select.selected()
    if tsel >= 0 && tsel < ed.modeling.mat_tex_uids.len {
        mat.base_texture_uid = ed.modeling.mat_tex_uids[tsel] + ""
    }
    << mat
}

fn (ed $&Editor) try_commit_pbr_fields_quiet(sel_node int) {
    doc := ed.draft.document() >>> (err) {
        _ := err
        <<
    }
    mat := ed.build_pbr_material_from_ui(&doc, sel_node) >>> (err) {
        _ := err
        <<
    }
    d := $&ed.draft
    _ := d.set_material_override(sel_node, 0, mat) >>> (err) {
        _ := err
        <<
    }
}

fn (ed $&Editor) try_commit_pbr_fields_quiet_multi(targets &[]int) {
    if targets.len == 0 { << }
    r_raw := ed.modeling.fields[MF_R].value()
    g_raw := ed.modeling.fields[MF_G].value()
    b_raw := ed.modeling.fields[MF_B].value()
    met_raw := ed.modeling.fields[MF_METALLIC].value()
    rgh_raw := ed.modeling.fields[MF_ROUGHNESS].value()
    emt_raw := ed.modeling.fields[MF_EMIT].value()
    alp_raw := ed.modeling.fields[MF_ALPHA].value()
    coat_raw := ed.modeling.fields[MF_COAT].value()
    ior_raw := ed.modeling.fields[MF_IOR].value()
    seeds := &ed.modeling.mat_seeds
    set_col := (seeds.len >= 7) && (r_raw != seeds[MF_R] || g_raw != seeds[MF_G] || b_raw != seeds[MF_B])
    set_met := (seeds.len >= 7) && (met_raw != seeds[MF_METALLIC])
    set_rgh := (seeds.len >= 7) && (rgh_raw != seeds[MF_ROUGHNESS])
    set_emt := (seeds.len >= 7) && (emt_raw != seeds[MF_EMIT])
    set_alp := (seeds.len >= 10) && (alp_raw != seeds[MF_ALPHA])
    set_coat := (seeds.len >= 10) && (coat_raw != seeds[MF_COAT])
    set_ior := (seeds.len >= 10) && (ior_raw != seeds[MF_IOR])
    if !set_col && !set_met && !set_rgh && !set_emt && !set_alp && !set_coat && !set_ior { << }

    $col := fm.vec3(0.0, 0.0, 0.0)
    $met := 0.0
    $rgh := 0.72
    $emt := 0.0
    $alp := 1.0
    $coat := 0.0
    $ior_v := 1.5
    if set_col {
        mr := parse_f64_or(&r_raw, "R") >>> (err) {
            _ := err
            <<
        }
        mg := parse_f64_or(&g_raw, "G") >>> (err) {
            _ := err
            <<
        }
        mb := parse_f64_or(&b_raw, "B") >>> (err) {
            _ := err
            <<
        }
        col = normalize_pbr_rgb(mr, mg, mb)
    }
    if set_met {
        met_v := parse_f64_or(&met_raw, "Metallic") >>> (err) {
            _ := err
            <<
        }
        met = math.max(0.0, math.min(1.0, met_v))
    }
    if set_rgh {
        rgh_v := parse_f64_or(&rgh_raw, "Roughness") >>> (err) {
            _ := err
            <<
        }
        rgh = math.max(0.045, math.min(1.0, rgh_v))
    }
    if set_emt {
        emt_v := parse_f64_or(&emt_raw, "Emit") >>> (err) {
            _ := err
            <<
        }
        emt = math.max(0.0, math.min(16.0, emt_v))
    }
    if set_alp {
        alp_v := parse_f64_or(&alp_raw, "Alpha") >>> (err) {
            _ := err
            <<
        }
        alp = math.max(0.0, math.min(1.0, alp_v))
    }
    if set_coat {
        coat_v := parse_f64_or(&coat_raw, "Coat") >>> (err) {
            _ := err
            <<
        }
        coat = math.max(0.0, math.min(1.0, coat_v))
    }
    if set_ior {
        ior_p := parse_f64_or(&ior_raw, "IOR") >>> (err) {
            _ := err
            <<
        }
        ior_v = math.max(1.0, math.min(2.5, ior_p))
    }
    d := $&ed.draft
    _ := try_patch_pbr_multi(
        d, targets,
        set_col, col, set_met, met, set_rgh, rgh, set_emt, emt,
        set_alp, alp, set_coat, coat, set_ior, ior_v
    )
}

fn try_patch_pbr_multi(
    d $&Draft,
    targets &[]int,
    set_col bool, col fm.Vec3,
    set_met bool, met f64,
    set_rgh bool, rgh f64,
    set_emt bool, emt f64,
    set_alp bool, alp f64,
    set_coat bool, coat f64,
    set_ior bool, ior_v f64
) string {
    base_len := d.undo.len
    base_raw := d.current + ""
    if set_col || set_met || set_rgh || set_emt {
        _ := d.patch_nodes_material_override(
            targets, 0,
            set_col, col,
            set_met, met,
            set_rgh, rgh,
            set_emt, emt,
            false, false,
            false, ""
        ) >>> (err) {
            << err.msg()
        }
    }
    if set_alp || set_coat || set_ior {
        _ := d.patch_nodes_material_surface_ext(targets, 0, set_alp, alp, set_coat, coat, set_ior, ior_v) >>> (err) {
            << err.msg()
        }
    }
    d.collapse_undo_to(base_len, base_raw)
    << ""
}

fn try_set_mat_ov_err(d $&Draft, sel_node int, mat rm.MaterialAsset) string {
    _ := d.set_material_override(sel_node, 0, mat) >>> (err) {
        << err.msg()
    }
    << ""
}

fn try_patch_mat_tex_err(d $&Draft, targets &[]int, uid string) string {
    _ := d.patch_nodes_material_override(
        targets, 0,
        false, fm.vec3(0.0, 0.0, 0.0),
        false, 0.0,
        false, 0.72,
        false, 0.0,
        false, false,
        true, uid
    ) >>> (err) {
        << err.msg()
    }
    << ""
}

fn try_ensure_mat_tex_ref(ed $&Editor, tuid &string) {
    if tuid.len == 0 { << }
    proj_ref := clone_project(&ed.project)
    d := $&ed.draft
    _ := d.ensure_image_asset_ref(&proj_ref, tuid) >>> (err) {
        _ := err
        <<
    }
}

pub fn (ed $&Editor) do_apply_pbr_material_field(forced_field int, view $&widgets.View) {
    doc := ed.draft.document() >>> (err) {
        ed.set_status(STATUS_ERR, err.msg(), view)
        <<
    }
    targets := ed.selected_3d_targets(&doc)
    if targets.len == 0 {
        ed.set_status(STATUS_ERR, tr(ed.lang, "Select a 3D node first", "请先选择一个 3D 节点"), view)
        <<
    }
    if targets.len == 1 {
        sel_node := targets[0]
        mat := ed.build_pbr_material_from_ui(&doc, sel_node) >>> (err) {
            ed.set_status(STATUS_ERR, err.msg(), view)
            <<
        }
        snd := doc.describe_node(sel_node) >>> (err) {
            ed.set_status(STATUS_ERR, err.msg(), view)
            <<
        }
        nd_name := snd.name + ""
        tuid := mat.base_texture_uid + ""
        err_msg := try_set_mat_ov_err($&ed.draft, sel_node, mat)
        if err_msg.len > 0 {
            ed.set_status(STATUS_ERR, err_msg, view)
            <<
        }
        try_ensure_mat_tex_ref(ed, &tuid)
        ed.modeling.mat_dirty = false
        ed.insp_dirty = false
        ed.refresh_after_document_change(false, view)
        ed.set_status(STATUS_OK, tr(ed.lang, "Updated material on " + nd_name, "已更新 " + nd_name + " 材质"), view)
        <<
    }

    r_raw := ed.modeling.fields[MF_R].value()
    g_raw := ed.modeling.fields[MF_G].value()
    b_raw := ed.modeling.fields[MF_B].value()
    met_raw := ed.modeling.fields[MF_METALLIC].value()
    rgh_raw := ed.modeling.fields[MF_ROUGHNESS].value()
    emt_raw := ed.modeling.fields[MF_EMIT].value()
    alp_raw := ed.modeling.fields[MF_ALPHA].value()
    coat_raw := ed.modeling.fields[MF_COAT].value()
    ior_raw := ed.modeling.fields[MF_IOR].value()
    seeds := &ed.modeling.mat_seeds
    $set_col := (forced_field == MF_R || forced_field == MF_G || forced_field == MF_B) ||
        ((seeds.len >= 7) && (r_raw != seeds[MF_R] || g_raw != seeds[MF_G] || b_raw != seeds[MF_B]))
    $set_met := (forced_field == MF_METALLIC) || ((seeds.len >= 7) && (met_raw != seeds[MF_METALLIC]))
    $set_rgh := (forced_field == MF_ROUGHNESS) || ((seeds.len >= 7) && (rgh_raw != seeds[MF_ROUGHNESS]))
    $set_emt := (forced_field == MF_EMIT) || ((seeds.len >= 7) && (emt_raw != seeds[MF_EMIT]))
    $set_alp := (forced_field == MF_ALPHA) || ((seeds.len >= 10) && (alp_raw != seeds[MF_ALPHA]))
    $set_coat := (forced_field == MF_COAT) || ((seeds.len >= 10) && (coat_raw != seeds[MF_COAT]))
    $set_ior := (forced_field == MF_IOR) || ((seeds.len >= 10) && (ior_raw != seeds[MF_IOR]))
    if !set_col && !set_met && !set_rgh && !set_emt && !set_alp && !set_coat && !set_ior {
        set_col = true
        set_met = true
        set_rgh = true
        set_emt = true
        set_alp = true
        set_coat = true
        set_ior = true
    }

    $col := fm.vec3(0.0, 0.0, 0.0)
    $met := 0.0
    $rgh := 0.72
    $emt := 0.0
    $alp := 1.0
    $coat := 0.0
    $ior_v := 1.5
    if set_col {
        mr := parse_f64_or(&r_raw, "R") >>> (err) {
            ed.set_status(STATUS_ERR, err.msg(), view)
            <<
        }
        mg := parse_f64_or(&g_raw, "G") >>> (err) {
            ed.set_status(STATUS_ERR, err.msg(), view)
            <<
        }
        mb := parse_f64_or(&b_raw, "B") >>> (err) {
            ed.set_status(STATUS_ERR, err.msg(), view)
            <<
        }
        col = normalize_pbr_rgb(mr, mg, mb)
    }
    if set_met {
        met_v := parse_f64_or(&met_raw, "Metallic") >>> (err) {
            ed.set_status(STATUS_ERR, err.msg(), view)
            <<
        }
        met = math.max(0.0, math.min(1.0, met_v))
    }
    if set_rgh {
        rgh_v := parse_f64_or(&rgh_raw, "Roughness") >>> (err) {
            ed.set_status(STATUS_ERR, err.msg(), view)
            <<
        }
        rgh = math.max(0.045, math.min(1.0, rgh_v))
    }
    if set_emt {
        emt_v := parse_f64_or(&emt_raw, "Emit") >>> (err) {
            ed.set_status(STATUS_ERR, err.msg(), view)
            <<
        }
        emt = math.max(0.0, math.min(16.0, emt_v))
    }
    if set_alp {
        alp_v := parse_f64_or(&alp_raw, "Alpha") >>> (err) {
            ed.set_status(STATUS_ERR, err.msg(), view)
            <<
        }
        alp = math.max(0.0, math.min(1.0, alp_v))
    }
    if set_coat {
        coat_v := parse_f64_or(&coat_raw, "Coat") >>> (err) {
            ed.set_status(STATUS_ERR, err.msg(), view)
            <<
        }
        coat = math.max(0.0, math.min(1.0, coat_v))
    }
    if set_ior {
        ior_p := parse_f64_or(&ior_raw, "IOR") >>> (err) {
            ed.set_status(STATUS_ERR, err.msg(), view)
            <<
        }
        ior_v = math.max(1.0, math.min(2.5, ior_p))
    }
    d := $&ed.draft
    err_msg := try_patch_pbr_multi(
        d, &targets,
        set_col, col, set_met, met, set_rgh, rgh, set_emt, emt,
        set_alp, alp, set_coat, coat, set_ior, ior_v
    )
    if err_msg.len > 0 {
        ed.set_status(STATUS_ERR, err_msg, view)
        <<
    }
    ed.modeling.mat_dirty = false
    ed.insp_dirty = false
    ed.refresh_after_document_change(false, view)
    ed.set_status(STATUS_OK, tr(ed.lang, "Updated material on " + str(targets.len) + " nodes", "已更新 " + str(targets.len) + " 个节点材质"), view)
}

pub fn (ed $&Editor) do_apply_pbr_material(view $&widgets.View) {
    ed.do_apply_pbr_material_field(-1, view)
}

pub fn (ed $&Editor) do_apply_pbr_texture(view $&widgets.View) {
    doc := ed.draft.document() >>> (err) {
        ed.set_status(STATUS_ERR, err.msg(), view)
        <<
    }
    targets := ed.selected_3d_targets(&doc)
    if targets.len == 0 {
        ed.set_status(STATUS_ERR, tr(ed.lang, "Select a 3D node first", "请先选择一个 3D 节点"), view)
        <<
    }
    tsel := ed.modeling.mat_tex_select.selected()
    $uid := ""
    if tsel >= 0 && tsel < ed.modeling.mat_tex_uids.len {
        uid = ed.modeling.mat_tex_uids[tsel] + ""
    }
    tuid := uid + ""
    err_msg := try_patch_mat_tex_err($&ed.draft, &targets, uid)
    if err_msg.len > 0 {
        ed.set_status(STATUS_ERR, err_msg, view)
        <<
    }
    try_ensure_mat_tex_ref(ed, &tuid)
    ed.modeling.mat_dirty = false
    ed.refresh_after_document_change(false, view)
    if targets.len > 1 {
        ed.set_status(STATUS_OK, tr(ed.lang, "Updated texture on " + str(targets.len) + " nodes", "已更新 " + str(targets.len) + " 个节点贴图"), view)
    } else {
        snd := doc.describe_node(targets[0]) >>> (err) {
            _ := err
            <<
        }
        ed.set_status(STATUS_OK, tr(ed.lang, "Updated material on " + snd.name, "已更新 " + snd.name + " 材质"), view)
    }
}

pub fn (ed $&Editor) do_apply_preset(idx int, view $&widgets.View) {
    p := modeling_preset_spec(idx)
    mat := modeling_preset_to_material(idx)
    set_field_val($&ed.modeling.fields[MF_R], &fmt_coord(p.r))
    set_field_val($&ed.modeling.fields[MF_G], &fmt_coord(p.g))
    set_field_val($&ed.modeling.fields[MF_B], &fmt_coord(p.b))
    set_field_val($&ed.modeling.fields[MF_METALLIC], &fmt_coord(p.metallic))
    set_field_val($&ed.modeling.fields[MF_ROUGHNESS], &fmt_coord(p.roughness))
    set_field_val($&ed.modeling.fields[MF_EMIT], &fmt_coord(p.emit))
    set_field_val($&ed.modeling.fields[MF_ALPHA], &fmt_coord(p.alpha))
    set_field_val($&ed.modeling.fields[MF_COAT], &fmt_coord(p.clearcoat))
    set_field_val($&ed.modeling.fields[MF_IOR], &fmt_coord(p.ior))
    doc := ed.draft.document() >>> (err) {
        ed.set_status(STATUS_ERR, err.msg(), view)
        <<
    }
    targets := ed.selected_3d_targets(&doc)
    if targets.len == 0 {
        ed.set_status(STATUS_ERR, tr(ed.lang, "Select a 3D node first", "请先选择一个 3D 节点"), view)
        <<
    }
    d := $&ed.draft
    _ := d.apply_nodes_material_preset(&targets, 0, &mat) >>> (err) {
        ed.set_status(STATUS_ERR, err.msg(), view)
        <<
    }
    ed.modeling.mat_dirty = false
    ed.insp_dirty = false
    ed.refresh_after_document_change(false, view)
    if targets.len > 1 {
        ed.set_status(STATUS_OK, tr(ed.lang, "Applied " + p.name_en + " to " + str(targets.len) + " nodes", "已为 " + str(targets.len) + " 个节点应用：" + p.name_zh), view)
    } else {
        ed.set_status(STATUS_OK, tr(ed.lang, "Applied " + p.name_en, "已应用材质：" + p.name_zh), view)
    }
}

pub fn (ed $&Editor) do_spawn_shape_from_select(view $&widgets.View) {
    choice := ed.modeling.shape_select.selected()
    modp := $&ed.modeling
    sh_sel := $&modp.shape_select
    set_sel_selected(sh_sel, 0)
    key := shape_select_key(choice)
    if key == "csg_cut" {
        ed.do_spawn_csg_cut(view)
    } else if key.len > 0 {
        ed.do_spawn_whitebox(key, view)
    }
}

pub fn (ed $&Editor) do_apply_preset_from_select(view $&widgets.View) {
    choice := ed.modeling.mat_preset_select.selected()
    if choice >= 1 && choice <= MODELING_PRESET_COUNT {
        ed.do_apply_preset(choice - 1, view)
    }
}

pub fn (ed $&Editor) do_toggle_twosided(view $&widgets.View) {
    ed.modeling.mat_two_sided = !ed.modeling.mat_two_sided
    next_ts := ed.modeling.mat_two_sided
    doc := ed.draft.document() >>> (err) {
        ed.set_status(STATUS_ERR, err.msg(), view)
        <<
    }
    targets := ed.selected_3d_targets(&doc)
    if targets.len == 0 {
        ed.set_status(STATUS_ERR, tr(ed.lang, "Select a 3D node first", "请先选择一个 3D 节点"), view)
        <<
    }
    if targets.len == 1 {
        ed.do_apply_pbr_material_field(-1, view)
        <<
    }
    d := $&ed.draft
    _ := d.patch_nodes_material_override(
        &targets, 0,
        false, fm.vec3(0.0, 0.0, 0.0),
        false, 0.0,
        false, 0.72,
        false, 0.0,
        true, next_ts,
        false, ""
    ) >>> (err) {
        ed.set_status(STATUS_ERR, err.msg(), view)
        <<
    }
    ed.modeling.mat_dirty = false
    ed.insp_dirty = false
    ed.refresh_after_document_change(false, view)
    ed.set_status(STATUS_OK, tr(ed.lang, "Updated two-sided material on " + str(targets.len) + " nodes", "已更新 " + str(targets.len) + " 个节点双面渲染"), view)
}

pub fn (ed $&Editor) do_csg_action(action int, view $&widgets.View) {
    sel_node := ed.selected_node
    d := $&ed.draft
    if action == 0 {
        _ := d.csg_add_brush(sel_node, 0, 0) >>> (err) {
            ed.set_status(STATUS_ERR, err.msg(), view)
            <<
        }
        ed.refresh_after_document_change(false, view)
        ed.set_status(STATUS_OK, tr(ed.lang, "Added CSG Union Box brush", "已追加 CSG 并集立方体笔刷"), view)
    } else if action == 1 {
        _ := d.csg_add_brush(sel_node, 0, 1) >>> (err) {
            ed.set_status(STATUS_ERR, err.msg(), view)
            <<
        }
        ed.refresh_after_document_change(false, view)
        ed.set_status(STATUS_OK, tr(ed.lang, "Added CSG Subtract Cut brush", "已追加 CSG 差集切割笔刷"), view)
    } else if action == 2 {
        _ := d.csg_cycle_last_op(sel_node) >>> (err) {
            ed.set_status(STATUS_ERR, err.msg(), view)
            <<
        }
        ed.refresh_after_document_change(false, view)
        ed.set_status(STATUS_OK, tr(ed.lang, "Cycled last CSG brush boolean op", "已切换末尾 CSG 笔刷布尔类型"), view)
    } else {
        _ := d.bake_csg_to_editable(sel_node) >>> (err) {
            ed.set_status(STATUS_ERR, err.msg(), view)
            <<
        }
        ed.refresh_after_document_change(false, view)
        ed.set_status(STATUS_OK, tr(ed.lang, "Baked CSG tree into EditableMesh", "已将 CSG 树烘焙为可编辑网格"), view)
    }
}

pub fn (ed $&Editor) do_clear_pbr_material(view $&widgets.View) {
    doc := ed.draft.document() >>> (err) {
        ed.set_status(STATUS_ERR, err.msg(), view)
        <<
    }
    targets := ed.selected_3d_targets(&doc)
    if targets.len == 0 {
        sel_node := ed.selected_node
        d := $&ed.draft
        _ := d.clear_material_override(sel_node, 0) >>> (err) {
            ed.set_status(STATUS_ERR, err.msg(), view)
            <<
        }
        ed.insp_dirty = false
        ed.refresh_after_document_change(false, view)
        ed.set_status(STATUS_OK, tr(ed.lang, "Cleared PBR material override", "已清除 PBR 材质覆盖"), view)
        <<
    }
    d := $&ed.draft
    _ := d.clear_nodes_material_override(&targets, 0) >>> (err) {
        ed.set_status(STATUS_ERR, err.msg(), view)
        <<
    }
    ed.insp_dirty = false
    ed.refresh_after_document_change(false, view)
    if targets.len > 1 {
        ed.set_status(STATUS_OK, tr(ed.lang, "Cleared PBR material on " + str(targets.len) + " nodes", "已清除 " + str(targets.len) + " 个节点的 PBR 材质覆盖"), view)
    } else {
        ed.set_status(STATUS_OK, tr(ed.lang, "Cleared PBR material override", "已清除 PBR 材质覆盖"), view)
    }
}

fn reload_exported_project(ed $&Editor, view $&widgets.View, pp string) {
    reloaded := load_project(pp) >>> (err) {
        _ := err
        <<
    }
    ed.project = reloaded
    ed.panels.glb_prim_cache = map[string]string{}
    ed.refresh_project_selectors()
    ed.sync_toolbar_states()
    ed.sync_asset_meta_text()
    repaint(view, ed.id_left_pane)
}

pub fn (ed $&Editor) do_export_node_glb(view $&widgets.View) {
    sel_node := ed.selected_node
    doc := ed.draft.document() >>> (err) {
        ed.set_status(STATUS_ERR, err.msg(), view)
        <<
    }
    nd := doc.describe_node(sel_node) >>> (err) {
        ed.set_status(STATUS_ERR, err.msg(), view)
        <<
    }
    rel := "assets/exported_" + nd.name + ".glb"
    pp := ed.project.path + ""
    vb := ed.validator_bin + ""
    res := export_node_glb_to_project(&doc, sel_node, &pp, rel, &vb) >>> (err) {
        ed.set_status(STATUS_ERR, err.msg(), view)
        <<
    }
    reload_exported_project(ed, view, pp + "")
    ed.set_status(STATUS_OK, tr(ed.lang, "Exported GLB: " + res.rel_path, "已导出 GLB: " + res.rel_path), view)
}

pub fn (ed $&Editor) submit_snap_modal(view $&widgets.View) {
    mv := ed.modals.fields[MF_SNAP_MOVE].value()
    rt := ed.modals.fields[MF_SNAP_ROTATE].value()
    sc := ed.modals.fields[MF_SNAP_SCALE].value()
    res := validate_snap_inputs(&mv, &rt, &sc)
    mods := $&ed.modals
    mods.snap_move_err = res.move_err + ""
    mods.snap_rotate_err = res.rotate_err + ""
    mods.snap_scale_err = res.scale_err + ""
    mods.sync_snap_decorations()
    if !res.valid {
        ed.set_status(STATUS_ERR, "Fix invalid snap settings", view)
        repaint(view, ed.id_root)
        <<
    }
    save_snap_settings(&ed.output_dir, &res.settings) >>> (err) {
        mods2 := $&ed.modals
        mods2.snap_move_err = err.msg()
        mods2.sync_snap_decorations()
        ed.set_status(STATUS_ERR, err.msg(), view)
        repaint(view, ed.id_root)
        <<
    }
    ed.snap = res.settings
    modal_close($&ed.modals)
    repaint(view, ed.id_root)
    ed.set_status(STATUS_OK, "Saved snap settings", view)
}

pub fn (ed $&Editor) submit_new_scene_modal(view $&widgets.View) {
    raw_name := ed.modals.fields[MF_SCENE_NAME].value()
    raw_root := ed.modals.fields[MF_SCENE_ROOT].value()
    new_key := create_scene(&ed.project.path, &raw_name, &raw_root) >>> (err) {
        mods := $&ed.modals
        mods.scene_err = err.msg()
        mods.sync_scene_decoration()
        ed.set_status(STATUS_ERR, err.msg(), view)
        repaint(view, ed.id_root)
        <<
    }
    reloaded := load_project(ed.project.path + "") >>> (err) {
        ed.set_status(STATUS_ERR, err.msg(), view)
        <<
    }
    ed.project = reloaded
    ed.refresh_project_selectors()
    $next_idx := 0
    for i in 0:ed.project.scenes.len {
        if ed.project.scenes[i].key == new_key {
            next_idx = i
        }
    }
    modal_close($&ed.modals)
    ed.scene_index = -1
    ed.switch_scene(next_idx, false, view)
    ed.set_status(STATUS_OK, "Created scene " + new_key, view)
}

fn (ed &Editor) tree_hit_row(x f64, y f64) int {
    b := ed.tree.bounds()
    c := ed.tree.style_or(&ed.styles)
    d := ed.styles.density
    vp_l := b.x + c.padding.left * d
    vp_t := b.y + c.padding.top * d
    vp_r := b.x + b.width - c.padding.right * d
    vp_b := b.y + b.height - c.padding.bottom * d
    if x < vp_l || x > vp_r || y < vp_t || y > vp_b { << -1 }
    for r in 0:ed.tree.visible_count() {
        rb := ed.tree.row_bounds(r)
        if rb.contains(x, y) { << r }
    }
    << -1
}

fn (ed &Editor) tree_visible_tid_at_row(row int) int {
    if row < 0 || row >= ed.tree.visible_count() { << -1 }
    << ed.tree.visible_node(row) >>> (err) {
        _ := err
        << -1
    }
}

fn (ed &Editor) tree_hit_vis_tid(x f64, y f64) int {
    r := ed.tree_hit_row(x, y)
    if r < 0 { << -1 }
    ab := ed.tree.action_bounds(r)
    if !ab.contains(x, y) { << -1 }
    << ed.tree_visible_tid_at_row(r)
}

fn (ed &Editor) tree_drag_row_at_y(y f64) int {
    n_vis := ed.tree.visible_count()
    if n_vis <= 0 { << -1 }
    b := ed.tree.bounds()
    c := ed.tree.style_or(&ed.styles)
    d := ed.styles.density
    vp_t := b.y + c.padding.top * d
    vp_b := b.y + b.height - c.padding.bottom * d
    $first_in_vp := -1
    $last_in_vp := -1
    for r in 0:n_vis {
        rb := ed.tree.row_bounds(r)
        if rb.y + rb.height <= vp_t || rb.y >= vp_b { -> }
        if first_in_vp < 0 { first_in_vp = r }
        last_in_vp = r
        if y >= rb.y && y < rb.y + rb.height { << r }
    }
    if first_in_vp < 0 { << -1 }
    first_rb := ed.tree.row_bounds(first_in_vp)
    if y < vp_t || y < first_rb.y { << first_in_vp }
    << last_in_vp
}

fn (ed &Editor) paint_tree_vis_icons(frame $&draw.Frame, styles &widgets.Styles) int {
    b := ed.tree.bounds()
    c := ed.tree.style_or(styles)
    d := styles.density
    vp := layout.Rect{
        x: b.x + c.padding.left * d,
        y: b.y + c.padding.top * d,
        width: math.max(0.0, b.width - (c.padding.left + c.padding.right) * d),
        height: math.max(0.0, b.height - (c.padding.top + c.padding.bottom) * d)
    }
    if vp.width <= 1.0 || vp.height <= 1.0 { << 0 }
    bg_normal := c.palette.normal
    bg_hover := c.resolve(widgets.STATE_HOVERED).background
    bg_sel := c.resolve(widgets.STATE_SELECTED).background
    pill_r := math.max(2.0, (c.radius - 2.0) * d)
    $drag_lo := -1
    $drag_hi := -1
    if ed.tree_vis_drag_active && ed.tree_vis_drag_start_row >= 0 && ed.tree_vis_drag_cur_row >= 0 {
        drag_lo = ed.tree_vis_drag_start_row
        drag_hi = ed.tree_vis_drag_cur_row
        if drag_lo > drag_hi {
            tmp := drag_lo
            drag_lo = drag_hi
            drag_hi = tmp
        }
    }
    frame.push() >>>
    frame.clip_rect(vp.x, vp.y, vp.width, vp.height) >>>
    n_vis := ed.tree.visible_count()
    for row in 0:n_vis {
        ab := ed.tree.action_bounds(row)
        if ab.width <= 1.0 || ab.height <= 1.0 || ab.y + ab.height < vp.y || ab.y > vp.y + vp.height {
            ->
        }
        tid := ed.tree.visible_node(row) >>> (err) {
            _ := err
            ->
        }
        if !ed.tree_to_scene.has(tid) { -> }
        sid := ed.tree_to_scene[tid]
        vis := ed.node_vis_cache.get_or(sid, true)
        eff_vis := ed.node_eff_vis_cache.get_or(sid, vis)
        is_sel := ed.tree.is_node_selected(tid)
        in_drag_span := drag_lo >= 0 && row >= drag_lo && row <= drag_hi
        is_row_hov := row == ed.tree_hover_row
        is_act_hov := tid == ed.tree_hover_vis_tid || in_drag_span
        is_act_arm := tid == ed.tree_armed_vis_tid || (ed.tree_vis_drag_active && row == ed.tree_hover_row)
        $row_bg := bg_normal
        if is_sel { row_bg = bg_sel }
        else if is_row_hov { row_bg = bg_hover }
        widgets.rounded_fill(frame, &ab, pill_r, row_bg) >>>
        if is_act_hov || is_act_arm {
            btn_r := layout.Rect{
                x: ab.x + 2.0 * d,
                y: ab.y + 3.0 * d,
                width: math.max(0.0, ab.width - 4.0 * d),
                height: math.max(0.0, ab.height - 6.0 * d)
            }
            $pbg := ed.pal.subtle
            if is_act_arm {
                pbg = ed.pal.border.with_alpha(150)
            } else if is_sel {
                pbg = ed.pal.brand.with_alpha(32)
            }
            if is_act_arm && is_sel {
                pbg = ed.pal.brand.with_alpha(56)
            }
            widgets.rounded_fill(frame, &btn_r, 4.0 * d, pbg) >>>
        }
        $icon := ICON_EYE
        $col := ed.pal.muted.with_alpha(125)
        if !vis {
            icon = ICON_EYE_OFF
            col = ed.pal.muted.with_alpha(230)
            if is_act_hov || is_act_arm { col = ed.pal.text }
        } else if !eff_vis {
            col = ed.pal.muted.with_alpha(80)
            if is_act_hov || is_act_arm { col = ed.pal.text }
        } else {
            if is_act_hov || is_act_arm {
                col = ed.pal.text
            } else if is_row_hov || is_sel {
                col = ed.pal.text.with_alpha(210)
            }
        }
        paint_vector_icon(frame, icon, ab.x + ab.width * 0.5, ab.y + ab.height * 0.5, 13.0 * d, col) >>>
    }
    frame.pop() >>>
    << 0
}

// StyledPainter contract methods
pub fn (ed $&Editor) measure_styled(id int, styles &widgets.Styles) layout.Size {
    _ := id
    _ := styles
    << layout.Size{width: 0.0, height: 0.0}
}

pub fn (ed $&Editor) paint_styled(id int, bounds &layout.Rect, styles &widgets.Styles, frame $&draw.Frame) bool {
    ed.draw_node(id, frame, bounds, styles) >>> (err) {
        _ := err
        << false
    }
    << true
}

fn (ed $&Editor) draw_node(id int, frame $&draw.Frame, bounds &layout.Rect, styles &widgets.Styles) int {
    _ := styles
    if id == ed.id_toolbar {
        frame.fill_rect(0.0, 0.0, bounds.width, bounds.height, ed.pal.surface) >>>
        frame.line(0.0, bounds.height - 0.5, bounds.width, bounds.height - 0.5, ed.pal.border, 1.0) >>>
    } else if id == ed.id_brand {
        frame.fill_circle(8.0, 13.0, 4.0, ed.pal.brand) >>>
        frame.text(16.0, 6.0, 12.5, ed.pal.text, &"Nexus") >>>
    } else if id == ed.id_stage_tabs {
        st_tabs := ed.stage_tabs.clone()
        paint_segmented(&st_tabs, $&ed.stage_tab_labels, frame, styles) >>>
    } else if id == ed.id_tb_div1 || id == ed.id_tb_div2 || id == ed.id_tb_div3 {
        frame.line(bounds.width * 0.5, 2.0, bounds.width * 0.5, bounds.height - 2.0, ed.pal.border, 1.0) >>>
    } else if id == ed.id_dirty_badge {
        $lbl := tr(ed.lang, "Saved", "已保存")
        $bg := ed.pal.elevated
        $fg := ed.pal.muted
        $dot := ed.pal.success
        if ed.draft.dirty() {
            lbl = tr(ed.lang, "Unsaved", "未保存")
            bg = draw.rgb(253, 236, 239)
            fg = ed.pal.brand
            dot = ed.pal.brand
        }
        frame.fill_round_rect(0.0, 1.0, bounds.width, 22.0, 11.0, bg) >>>
        frame.fill_circle(11.0, 12.0, 3.0, dot) >>>
        frame.text(18.0, 5.5, 11.5, fg, &lbl) >>>
    } else if id == ed.id_scene_select {
        sc := ed.scene_select.clone()
        sel := sc.selected()
        if sel >= 0 && sel < ed.scene_labels.len {
            sc.paint_styled(frame, $&ed.scene_labels[sel], styles) >>>
        } else {
            sc.paint_styled(frame, $&ed.empty_lbl, styles) >>>
        }
    } else if id == ed.id_new_scene_btn {
        b := ed.new_scene_btn.clone()
        paint_icon_button(&b, $&ed.empty_lbl, ICON_SCENE_ADD, frame, styles) >>>
    } else if id == ed.id_globals_btn {
        b := ed.globals_btn.clone()
        paint_icon_button(&b, $&ed.empty_lbl, ICON_GLOBALS, frame, styles) >>>
    } else if id == ed.id_undo_btn {
        b := ed.undo_btn.clone()
        paint_icon_button(&b, $&ed.empty_lbl, ICON_UNDO, frame, styles) >>>
    } else if id == ed.id_redo_btn {
        b := ed.redo_btn.clone()
        paint_icon_button(&b, $&ed.empty_lbl, ICON_REDO, frame, styles) >>>
    } else if id == ed.id_save_btn {
        b := ed.save_btn.clone()
        paint_icon_button(&b, $&ed.empty_lbl, ICON_SAVE, frame, styles) >>>
    } else if id == ed.id_preview_btn {
        b := ed.preview_btn.clone()
        paint_icon_button(&b, $&ed.empty_lbl, ICON_PREVIEW, frame, styles) >>>
    } else if id == ed.id_left_pane {
        frame.fill_rect(0.0, 0.0, bounds.width, bounds.height, ed.pal.surface) >>>
    } else if id == ed.id_left_tabs {
        lt_tabs := ed.left_tabs.clone()
        paint_segmented(&lt_tabs, $&ed.left_tab_labels, frame, styles) >>>
    } else if id == ed.id_tree_hdr {
        if bounds.width <= 0.5 || bounds.height <= 0.5 { << 0 }
        $hdr := tr(ed.lang, "Scene (", "大纲 (") + str(ed.stage_pts.len) + ")"
        if ed.tree_filter_active {
            hdr = tr(ed.lang, "Scene (", "大纲 (") + str(ed.tree_filter_matches) + " / " + str(ed.stage_pts.len) + ")"
        } else if ed.selected_nodes.len > 1 {
            hdr = tr(ed.lang, "Scene (", "大纲 (") + str(ed.stage_pts.len) + " · " + str(ed.selected_nodes.len) + tr(ed.lang, " sel)", " 选)")
        }
        frame.text(0.0, 4.0, 12.0, ed.pal.text, &hdr) >>>
    } else if id == ed.id_add_node_select {
        if bounds.width <= 0.5 || bounds.height <= 0.5 { << 0 }
        ans := ed.add_node_select.clone()
        asel := ans.selected()
        if asel >= 0 && asel < ed.add_node_labels.len {
            ans.paint_styled(frame, $&ed.add_node_labels[asel], styles) >>>
        } else {
            ans.paint_styled(frame, $&ed.empty_lbl, styles) >>>
        }
    } else if id == ed.id_dup_btn {
        if bounds.width <= 0.5 || bounds.height <= 0.5 { << 0 }
        b := ed.dup_btn.clone()
        paint_icon_button(&b, $&ed.empty_lbl, ICON_DUP, frame, styles) >>>
    } else if id == ed.id_del_btn {
        if bounds.width <= 0.5 || bounds.height <= 0.5 { << 0 }
        b := ed.del_btn.clone()
        paint_icon_button(&b, $&ed.empty_lbl, ICON_DEL, frame, styles) >>>
    } else if id == ed.id_tree {
        if bounds.width <= 0.5 || bounds.height <= 0.5 { << 0 }
        paint_tree($&ed.tree, frame, styles) >>>
        ed.paint_tree_vis_icons(frame, styles) >>>
    } else if id == ed.id_assets_hdr {
        if bounds.width <= 0.5 || bounds.height <= 0.5 { << 0 }
        ahdr := tr(ed.lang, "Project Assets", "工程资源")
        frame.text(0.0, 4.0, 12.0, ed.pal.text, &ahdr) >>>
    } else if id == ed.id_import_btn {
        if bounds.width <= 0.5 || bounds.height <= 0.5 { << 0 }
        b := ed.import_btn.clone()
        paint_icon_button(&b, $&ed.empty_lbl, ICON_IMPORT, frame, styles) >>>
    } else if id == ed.id_asset_list {
        if bounds.width <= 0.5 || bounds.height <= 0.5 { << 0 }
        paint_tree($&ed.asset_list, frame, styles) >>>
    } else if id == ed.id_asset_select {
        if bounds.width <= 0.5 || bounds.height <= 0.5 { << 0 }
        asel := ed.asset_select.clone()
        sel := asel.selected()
        if sel >= 0 && sel < ed.asset_labels.len {
            asel.paint_styled(frame, $&ed.asset_labels[sel], styles) >>>
        } else {
            asel.paint_styled(frame, $&ed.no_asset_lbl, styles) >>>
        }
    } else if id == ed.id_asset_meta {
        if bounds.width <= 0.5 || bounds.height <= 0.5 { << 0 }
        paint_text_sel($&ed.asset_meta_txt, frame, styles) >>>
    } else if id == ed.id_prim_field {
        if bounds.width <= 0.5 || bounds.height <= 0.5 { << 0 }
        paint_field($&ed.prim_field, frame, styles) >>>
    } else if id == ed.id_place_btn {
        if bounds.width <= 0.5 || bounds.height <= 0.5 { << 0 }
        b := ed.place_btn.clone()
        b.paint_styled(frame, $&ed.place_lbl, styles) >>>
    } else if id == ed.id_left_split || id == ed.id_right_split {
        frame.fill_rect(0.0, 0.0, bounds.width, bounds.height, ed.pal.canvas) >>>
        $col := ed.pal.border
        if (id == ed.id_left_split && ed.dragging_split == 1) || (id == ed.id_right_split && ed.dragging_split == 2) {
            col = ed.pal.focus
        }
        frame.fill_round_rect(1.5, bounds.height * 0.5 - 16.0, 3.0, 32.0, 1.5, col) >>>
    } else if id == ed.id_stage_bar {
        if ed.stage_g1_rect.width > 4.0 {
            frame.fill_round_rect(ed.stage_g1_rect.x, 0.0, ed.stage_g1_rect.width, 28.0, 6.0, ed.pal.elevated) >>>
        }
        if ed.stage_g2_rect.width > 4.0 {
            frame.fill_round_rect(ed.stage_g2_rect.x, 0.0, ed.stage_g2_rect.width, 28.0, 6.0, ed.pal.elevated) >>>
        }
        if ed.stage_r_rect.width > 4.0 {
            frame.fill_round_rect(ed.stage_r_rect.x, 0.0, ed.stage_r_rect.width, 28.0, 6.0, ed.pal.elevated) >>>
        }
    } else if id == ed.id_stage_title {
        if ed.stage_mode == STAGE_MODE_2D || ed.stage_mode == STAGE_MODE_TILEMAP {
            $ttl := tr(ed.lang, "Top View · XZ", "俯视图 · XZ")
            if ed.stage_mode == STAGE_MODE_TILEMAP {
                ttl = tr(ed.lang, "TileMap 2D Studio", "TileMap 2D 瓦片画布")
            } else if bounds.width >= 130.0 {
                if ed.top_view.axis_mode == STAGE_XY { ttl = tr(ed.lang, "Front View · XY", "正视图 · XY") }
            } else {
                ttl = tr(ed.lang, "Top · XZ", "俯视 · XZ")
                if ed.top_view.axis_mode == STAGE_XY { ttl = tr(ed.lang, "Front · XY", "正视 · XY") }
            }
            frame.text(2.0, 5.0, 12.0, ed.pal.muted, &ttl) >>>
        }
    } else if id == ed.id_stage_div1 || id == ed.id_stage_div2 {
        if bounds.width > 0.5 && bounds.height > 0.5 {
            frame.line(bounds.width * 0.5, 4.0, bounds.width * 0.5, math.max(6.0, bounds.height - 4.0), ed.pal.border, 1.0) >>>
        }
    } else if id == ed.id_stage_axis_btn {
        b := ed.stage_axis_btn.clone()
        ax_ico := stage_axis_icon(ed)
        paint_icon_button(&b, $&ed.empty_lbl, ax_ico, frame, styles) >>>
    } else if id == ed.id_stage_snap_btn {
        b := ed.stage_snap_btn.clone()
        paint_icon_button(&b, $&ed.empty_lbl, ICON_GRID_SNAP, frame, styles) >>>
    } else if id == ed.id_fit_btn {
        b := ed.fit_btn.clone()
        paint_icon_button(&b, $&ed.empty_lbl, ICON_FIT, frame, styles) >>>
    } else if id == ed.id_snap_btn {
        b := ed.snap_btn.clone()
        paint_icon_button(&b, $&ed.empty_lbl, ICON_SLIDERS, frame, styles) >>>
    } else if id == ed.id_top_view {
        ctx := ed.context.clone()
        pts := clone_stage_points(&ed.stage_pts)
        sel_n := ed.selected_node
        $sel_list := []int{}
        for k in 0:ed.selected_nodes.len { sel_list.push(ed.selected_nodes[k]) }
        placing := ed.placing_mode
        pal := ed.pal
        lang_v := ed.lang
        smode := ed.stage_mode
        if smode == STAGE_MODE_3D || smode == STAGE_MODE_SPLIT {
            doc3d := ed.draft.document() >>>
            paint_viewport_3d(&ed.vp3d, frame, bounds, &doc3d, &pts, sel_n, &sel_list, smode, &pal, lang_v) >>>
        } else if smode == STAGE_MODE_TILEMAP {
            paint_embedded_tilemap(&ed.tilemap, frame, bounds, &pal, lang_v) >>>
        } else {
            paint_top_view($&ed.top_view, &ctx, frame, bounds, &pts, sel_n, &sel_list, placing, &pal, lang_v) >>>
        }
    } else if id == ed.id_right_pane {
        frame.fill_rect(0.0, 0.0, bounds.width, bounds.height, ed.pal.surface) >>>
    } else if id == ed.id_insp_hdr {
        paint_text_sel($&ed.insp_hdr_txt, frame, styles) >>>
    } else if id == ed.id_name_field {
        paint_field($&ed.name_field, frame, styles) >>>
    } else if id == ed.id_visible_chk {
        chk := ed.visible_chk.clone()
        chk.paint_styled(frame, $&ed.visible_lbl, styles) >>>
    } else if id == ed.id_insp_tabs {
        it_tabs := ed.insp_tabs.clone()
        paint_segmented(&it_tabs, $&ed.insp_tab_labels, frame, styles) >>>
    } else if id == ed.id_insp_scroll {
        frame.fill_rect(0.0, 0.0, bounds.width, bounds.height, ed.pal.surface) >>>
    } else if id == ed.id_xf_div {
        if bounds.width > 0.5 && bounds.height > 0.5 {
            ed.xf_div.paint_styled(frame, styles) >>>
        }
    } else if id == ed.id_add_comp_select {
        if bounds.width <= 0.5 || bounds.height <= 0.5 { << 0 }
        acs := ed.add_comp_select.clone()
        csel := acs.selected()
        if csel >= 0 && csel < ed.add_comp_labels.len {
            acs.paint_styled(frame, $&ed.add_comp_labels[csel], styles) >>>
        } else {
            acs.paint_styled(frame, $&ed.empty_lbl, styles) >>>
        }
    } else if id == ed.id_comp_empty_lbl {
        if bounds.width > 0.5 && bounds.height > 0.5 {
            frame.fill_round_rect(0.0, 2.0, bounds.width, bounds.height - 4.0, 6.0, ed.pal.elevated) >>>
            msg := tr(ed.lang, "No components attached — use + Add Component above", "暂无附加组件，点击上方「+ 添加组件...」按需启用")
            frame.text(10.0, 15.0, 11.5, ed.pal.muted, &msg) >>>
        }
    } else if id == ed.id_process_select {
        if bounds.width <= 0.5 || bounds.height <= 0.5 { << 0 }
        prs := ed.process_select.clone()
        prsel := prs.selected()
        if prsel >= 0 && prsel < ed.process_labels.len {
            prs.paint_styled(frame, $&ed.process_labels[prsel], styles) >>>
        } else {
            prs.paint_styled(frame, $&ed.empty_lbl, styles) >>>
        }
    } else if id == ed.id_parent_select {
        if bounds.width <= 0.5 || bounds.height <= 0.5 { << 0 }
        ps := ed.parent_select.clone()
        psel := ps.selected()
        if psel >= 0 && psel < ed.parent_labels.len {
            ps.paint_styled(frame, $&ed.parent_labels[psel], styles) >>>
        } else {
            ps.paint_styled(frame, $&ed.root_parent_lbl, styles) >>>
        }
    } else if id == ed.id_reparent_btn {
        if bounds.width <= 0.5 || bounds.height <= 0.5 { << 0 }
        b := ed.reparent_btn.clone()
        b.paint_styled(frame, $&ed.reparent_lbl, styles) >>>
    } else if id == ed.id_pos_lbl {
        if bounds.height > 0.5 {
            t := tr(ed.lang, "Position (X / Y / Z)", "位置 (X / Y / Z)")
            frame.text(0.0, 1.0, 11.5, ed.pal.muted, &t) >>>
            if ed.insp_can_trs && !transform_part_is_default(ed, 1) {
                rlbl := tr(ed.lang, "↺ Reset", "↺ 重置")
                $rc := ed.pal.muted
                $rbg := ed.pal.elevated
                if ed.reset_hover == 1 {
                    rc = ed.pal.brand
                    rbg = ed.pal.brand.with_alpha(28)
                }
                rw := 46.0
                rx := math.max(0.0, bounds.width - rw)
                frame.fill_round_rect(rx, 0.0, rw, 15.0, 4.0, rbg) >>>
                frame.text(rx + 4.0, 1.0, 10.0, rc, &rlbl) >>>
            }
        }
    } else if id == ed.id_pos_x { if bounds.height > 0.5 { paint_field($&ed.pos_x, frame, styles) >>> }
    } else if id == ed.id_pos_y { if bounds.height > 0.5 { paint_field($&ed.pos_y, frame, styles) >>> }
    } else if id == ed.id_pos_z { if bounds.height > 0.5 { paint_field($&ed.pos_z, frame, styles) >>> }
    } else if id == ed.id_rot_lbl {
        if bounds.height > 0.5 {
            t := tr(ed.lang, "Rotation deg (X / Y / Z)", "旋转角度 (X / Y / Z)")
            frame.text(0.0, 1.0, 11.5, ed.pal.muted, &t) >>>
            if ed.insp_can_trs && !transform_part_is_default(ed, 2) {
                rlbl := tr(ed.lang, "↺ Reset", "↺ 重置")
                $rc := ed.pal.muted
                $rbg := ed.pal.elevated
                if ed.reset_hover == 2 {
                    rc = ed.pal.brand
                    rbg = ed.pal.brand.with_alpha(28)
                }
                rw := 46.0
                rx := math.max(0.0, bounds.width - rw)
                frame.fill_round_rect(rx, 0.0, rw, 15.0, 4.0, rbg) >>>
                frame.text(rx + 4.0, 1.0, 10.0, rc, &rlbl) >>>
            }
        }
    } else if id == ed.id_rot_x { if bounds.height > 0.5 { paint_field($&ed.rot_x, frame, styles) >>> }
    } else if id == ed.id_rot_y { if bounds.height > 0.5 { paint_field($&ed.rot_y, frame, styles) >>> }
    } else if id == ed.id_rot_z { if bounds.height > 0.5 { paint_field($&ed.rot_z, frame, styles) >>> }
    } else if id == ed.id_scale_lbl {
        if bounds.height > 0.5 {
            t := tr(ed.lang, "Scale (X / Y / Z)", "缩放 (X / Y / Z)")
            frame.text(0.0, 1.0, 11.5, ed.pal.muted, &t) >>>
            if ed.insp_can_trs && !transform_part_is_default(ed, 3) {
                rlbl := tr(ed.lang, "↺ Reset", "↺ 重置")
                $rc := ed.pal.muted
                $rbg := ed.pal.elevated
                if ed.reset_hover == 3 {
                    rc = ed.pal.brand
                    rbg = ed.pal.brand.with_alpha(28)
                }
                rw := 46.0
                rx := math.max(0.0, bounds.width - rw)
                frame.fill_round_rect(rx, 0.0, rw, 15.0, 4.0, rbg) >>>
                frame.text(rx + 4.0, 1.0, 10.0, rc, &rlbl) >>>
            }
        }
    } else if id == ed.id_scale_x { if bounds.height > 0.5 { paint_field($&ed.scale_x, frame, styles) >>> }
    } else if id == ed.id_scale_y { if bounds.height > 0.5 { paint_field($&ed.scale_y, frame, styles) >>> }
    } else if id == ed.id_scale_z { if bounds.height > 0.5 { paint_field($&ed.scale_z, frame, styles) >>> }
    } else if id == ed.id_surf_info {
        if bounds.height > 0.5 { paint_text_sel($&ed.surf_info_txt, frame, styles) >>> }
    } else if id == ed.id_surf_div {
        if bounds.height > 0.5 { ed.surf_div.paint_styled(frame, styles) >>> }
    } else if id == ed.id_surf_card_hdr {
        if bounds.height > 0.5 {
            t := tr(ed.lang, "GLB Surface & LOD", "GLB 网格表面与 LOD")
            frame.text(0.0, 2.0, 12.0, ed.pal.text, &t) >>>
        }
    } else if id == ed.id_surf_asset_select {
        if bounds.width <= 0.5 || bounds.height <= 0.5 { << 0 }
        ss := ed.surf_asset_select.clone()
        ssel := ss.selected()
        if ssel >= 0 && ssel < ed.surf_asset_labels.len {
            ss.paint_styled(frame, $&ed.surf_asset_labels[ssel], styles) >>>
        } else {
            ss.paint_styled(frame, $&ed.no_asset_lbl, styles) >>>
        }
    } else if id == ed.id_surf_prim_field {
        if bounds.height > 0.5 { paint_field($&ed.surf_prim_field, frame, styles) >>> }
    } else if id == ed.id_surf_bind_btn {
        if bounds.width <= 0.5 || bounds.height <= 0.5 { << 0 }
        b := ed.surf_bind_btn.clone()
        b.paint_styled(frame, $&ed.surf_bind_lbl, styles) >>>
    } else if id == ed.id_surf_clear_btn {
        if bounds.width <= 0.5 || bounds.height <= 0.5 { << 0 }
        b := ed.surf_clear_btn.clone()
        b.paint_styled(frame, $&ed.surf_clear_lbl, styles) >>>
    } else if id == ed.id_lod_info {
        if bounds.height > 0.5 { paint_text_sel($&ed.lod_info_txt, frame, styles) >>> }
    } else if id == ed.id_lod_hyst_field {
        if bounds.height > 0.5 { paint_field($&ed.lod_hyst_field, frame, styles) >>> }
    } else if id == ed.id_lod_dist_field {
        if bounds.height > 0.5 { paint_field($&ed.lod_dist_field, frame, styles) >>> }
    } else if id == ed.id_lod_prim_field {
        if bounds.height > 0.5 { paint_field($&ed.lod_prim_field, frame, styles) >>> }
    } else if id == ed.id_lod_asset_select {
        if bounds.width <= 0.5 || bounds.height <= 0.5 { << 0 }
        ls := ed.lod_asset_select.clone()
        lsel := ls.selected()
        if lsel >= 0 && lsel < ed.lod_asset_labels.len {
            ls.paint_styled(frame, $&ed.lod_asset_labels[lsel], styles) >>>
        } else {
            ls.paint_styled(frame, $&ed.empty_lbl, styles) >>>
        }
    } else if id == ed.id_lod_add_btn {
        if bounds.width <= 0.5 || bounds.height <= 0.5 { << 0 }
        b := ed.lod_add_btn.clone()
        b.paint_styled(frame, $&ed.lod_add_lbl, styles) >>>
    } else if id == ed.id_lod_pop_btn {
        if bounds.width <= 0.5 || bounds.height <= 0.5 { << 0 }
        b := ed.lod_pop_btn.clone()
        b.paint_styled(frame, $&ed.lod_pop_lbl, styles) >>>
    } else if id == ed.id_apply_btn {
        if bounds.width <= 0.5 || bounds.height <= 0.5 { << 0 }
        b := ed.apply_btn.clone()
        b.paint_styled(frame, $&ed.apply_lbl, styles) >>>
    } else if id == ed.id_footer {
        frame.fill_rect(0.0, 0.0, bounds.width, bounds.height, ed.pal.elevated) >>>
        frame.line(0.0, 0.5, bounds.width, 0.5, ed.pal.border, 1.0) >>>
        hint := tr(ed.lang, "Cmd+S Save · Cmd+Z Undo · Cmd+D Dup · F Focus · H Hide · Esc Cancel", "Cmd+S 保存 · Cmd+Z 撤销 · Cmd+D 复制 · F 聚焦 · H 显隐 · Esc 取消")
        if bounds.width >= 900.0 {
            frame.text(bounds.width - 432.0, 6.0, 11.0, ed.pal.muted, &hint) >>>
        }
    } else if id == ed.id_status_txt {
        paint_text_sel($&ed.status_txt, frame, styles) >>>
    } else {
        pal := ed.pal
        drag_sp := ed.dragging_split
        sel_vis := ed.visible_chk.value()
        lang_v := ed.lang
        handled := panels_draw($&ed.panels, id, frame, bounds, styles, &pal, drag_sp, sel_vis) >>>
        if handled == 0 {
            mhandled := modeling_draw($&ed.modeling, id, frame, bounds, styles, &pal, lang_v) >>>
            if mhandled == 0 {
                _ := draw_comp_node($&ed.comp, id, frame, bounds, styles, &pal, lang_v) >>>
            }
        }
    }
    << 0
}

fn paint_select_popup(sel &widgets.Select, labels $&[]widgets.StyledLabel, origin &layout.Rect, frame $&draw.Frame, styles &widgets.Styles) int {
    if !sel.is_open() { << 0 }
    frame.push() >>>
    frame.translate(origin.x, origin.y) >>>
    sel.paint_popup_box_styled(frame, styles) >>> (err) {
        _ := frame.pop()
        >> err
    }
    for i in 0:labels.len {
        lbl := $&labels[i]
        sel.paint_option_styled(frame, i, lbl, styles) >>> (err) {
            _ := frame.pop()
            >> err
        }
    }
    frame.pop() >>>
    << 0
}

pub fn (ed $&Editor) overlay_styled(id int, bounds &layout.Rect, styles &widgets.Styles, frame $&draw.Frame) bool {
    ed.draw_overlay(id, frame, bounds, styles) >>> (err) {
        _ := err
        << false
    }
    << true
}

fn (ed $&Editor) draw_overlay(id int, frame $&draw.Frame, bounds &layout.Rect, styles &widgets.Styles) int {
    if id == ed.id_insp_scroll {
        sc := $&ed.insp_scroll
        sc.paint_scrollbar(frame, styles) >>>
        << 0
    }
    if id != ed.id_root { << 0 }
    sc_sel := ed.scene_select.clone()
    sc_orig := copy_rect(&ed.scene_origin)
    paint_select_popup(&sc_sel, $&ed.scene_labels, &sc_orig, frame, styles) >>>
    as_sel := ed.asset_select.clone()
    as_orig := copy_rect(&ed.asset_origin)
    paint_select_popup(&as_sel, $&ed.asset_labels, &as_orig, frame, styles) >>>
    an_sel := ed.add_node_select.clone()
    an_orig := copy_rect(&ed.add_node_origin)
    paint_select_popup(&an_sel, $&ed.add_node_labels, &an_orig, frame, styles) >>>
    ac_sel := ed.add_comp_select.clone()
    ac_orig := copy_rect(&ed.add_comp_origin)
    paint_select_popup(&ac_sel, $&ed.add_comp_labels, &ac_orig, frame, styles) >>>
    pa_sel := ed.parent_select.clone()
    pa_orig := copy_rect(&ed.parent_origin)
    paint_select_popup(&pa_sel, $&ed.parent_labels, &pa_orig, frame, styles) >>>
    pr_sel := ed.process_select.clone()
    pr_orig := copy_rect(&ed.process_origin)
    paint_select_popup(&pr_sel, $&ed.process_labels, &pr_orig, frame, styles) >>>
    sa_sel := ed.surf_asset_select.clone()
    sa_orig := copy_rect(&ed.surf_asset_origin)
    paint_select_popup(&sa_sel, $&ed.surf_asset_labels, &sa_orig, frame, styles) >>>
    la_sel := ed.lod_asset_select.clone()
    la_orig := copy_rect(&ed.lod_asset_origin)
    paint_select_popup(&la_sel, $&ed.lod_asset_labels, &la_orig, frame, styles) >>>
    if ed.tree.has_popup_open() {
        frame.push() >>>
        frame.translate(ed.tree_origin.x, ed.tree_origin.y) >>>
        tr := $&ed.tree
        tr.paint_popup_styled(frame, styles) >>> (err) {
            _ := frame.pop()
            >> err
        }
        frame.pop() >>>
    }
    if ed.asset_list.has_popup_open() {
        frame.push() >>>
        frame.translate(ed.asset_list_origin.x, ed.asset_list_origin.y) >>>
        al := $&ed.asset_list
        al.paint_popup_styled(frame, styles) >>> (err) {
            _ := frame.pop()
            >> err
        }
        frame.pop() >>>
    }
    field_popup_paint($&ed.prim_field, frame, styles) >>>
    field_popup_paint($&ed.name_field, frame, styles) >>>
    field_popup_paint($&ed.pos_x, frame, styles) >>>
    field_popup_paint($&ed.pos_y, frame, styles) >>>
    field_popup_paint($&ed.pos_z, frame, styles) >>>
    field_popup_paint($&ed.rot_x, frame, styles) >>>
    field_popup_paint($&ed.rot_y, frame, styles) >>>
    field_popup_paint($&ed.rot_z, frame, styles) >>>
    field_popup_paint($&ed.scale_x, frame, styles) >>>
    field_popup_paint($&ed.scale_y, frame, styles) >>>
    field_popup_paint($&ed.scale_z, frame, styles) >>>
    field_popup_paint($&ed.surf_prim_field, frame, styles) >>>
    field_popup_paint($&ed.lod_hyst_field, frame, styles) >>>
    field_popup_paint($&ed.lod_dist_field, frame, styles) >>>
    field_popup_paint($&ed.lod_prim_field, frame, styles) >>>
    paint_text_popup($&ed.asset_meta_txt, frame, styles) >>>
    paint_text_popup($&ed.insp_hdr_txt, frame, styles) >>>
    paint_text_popup($&ed.surf_info_txt, frame, styles) >>>
    paint_text_popup($&ed.lod_info_txt, frame, styles) >>>
    paint_text_popup($&ed.status_txt, frame, styles) >>>
    draw_comp_overlay($&ed.comp, frame, styles) >>>
    modeling_overlay($&ed.modeling, frame, styles) >>>
    panels_overlay($&ed.panels, frame, styles) >>>
    if ed.modals.kind == MODAL_NONE && !ed.any_popup_or_select_open() {
        tip := $&ed.tooltip
        tip.paint(frame, bounds, styles) >>>
    }
    pal := ed.pal
    mods := $&ed.modals
    mods.paint(frame, bounds, styles, &pal) >>>
    << 0
}

fn field_is_near(f &widgets.Field, target f64) bool {
    t := strings.trim_space(&f.value())
    if t.len == 0 { << true }
    v := strconv.parse_float(&t) >>> (err) {
        _ := err
        << false
    }
    << math.abs(v - target) < 1e-4
}

fn transform_part_is_default(ed &Editor, part int) bool {
    if part == 1 {
        << field_is_near(&ed.pos_x, 0.0) && field_is_near(&ed.pos_y, 0.0) && field_is_near(&ed.pos_z, 0.0)
    }
    if part == 2 {
        << field_is_near(&ed.rot_x, 0.0) && field_is_near(&ed.rot_y, 0.0) && field_is_near(&ed.rot_z, 0.0)
    }
    if part == 3 {
        << field_is_near(&ed.scale_x, 1.0) && field_is_near(&ed.scale_y, 1.0) && field_is_near(&ed.scale_z, 1.0)
    }
    << true
}

fn (ed &Editor) field_by_id_enabled(id int) bool {
    if id == ed.id_pos_x { << ed.pos_x.is_enabled() }
    if id == ed.id_pos_y { << ed.pos_y.is_enabled() }
    if id == ed.id_pos_z { << ed.pos_z.is_enabled() }
    if id == ed.id_rot_x { << ed.rot_x.is_enabled() }
    if id == ed.id_rot_y { << ed.rot_y.is_enabled() }
    if id == ed.id_rot_z { << ed.rot_z.is_enabled() }
    if id == ed.id_scale_x { << ed.scale_x.is_enabled() }
    if id == ed.id_scale_y { << ed.scale_y.is_enabled() }
    if id == ed.id_scale_z { << ed.scale_z.is_enabled() }
    if ed.modeling.card_visible {
        for i in [MF_R, MF_G, MF_B, MF_METALLIC, MF_ROUGHNESS, MF_EMIT, MF_ALPHA, MF_COAT, MF_IOR] {
            if id == ed.modeling.field_ids[i] { << ed.modeling.fields[i].is_enabled() }
        }
    }
    << false
}

fn scrub_spec_for_id(ed &Editor, id int) ScrubState {
    if id == ed.id_pos_x || id == ed.id_pos_y || id == ed.id_pos_z {
        << ScrubState{active: true, field_id: id, start_x: 0.0, start_val: 0.0, moved: false, min_v: -100000.0, max_v: 100000.0, step: 0.02, is_mat: false, mat_idx: -1}
    }
    if id == ed.id_rot_x || id == ed.id_rot_y || id == ed.id_rot_z {
        << ScrubState{active: true, field_id: id, start_x: 0.0, start_val: 0.0, moved: false, min_v: -3600.0, max_v: 3600.0, step: 0.5, is_mat: false, mat_idx: -1}
    }
    if id == ed.id_scale_x || id == ed.id_scale_y || id == ed.id_scale_z {
        << ScrubState{active: true, field_id: id, start_x: 0.0, start_val: 1.0, moved: false, min_v: 0.05, max_v: 100.0, step: 0.01, is_mat: false, mat_idx: -1}
    }
    if ed.modeling.card_visible {
        for i in [MF_R, MF_G, MF_B] {
            if id == ed.modeling.field_ids[i] {
                << ScrubState{active: true, field_id: id, start_x: 0.0, start_val: 0.5, moved: false, min_v: 0.0, max_v: 1.0, step: 0.004, is_mat: true, mat_idx: i}
            }
        }
        if id == ed.modeling.field_ids[MF_METALLIC] || id == ed.modeling.field_ids[MF_ROUGHNESS] {
            midx := MF_METALLIC
            $mi := midx
            if id == ed.modeling.field_ids[MF_ROUGHNESS] { mi = MF_ROUGHNESS }
            << ScrubState{active: true, field_id: id, start_x: 0.0, start_val: 0.5, moved: false, min_v: 0.0, max_v: 1.0, step: 0.004, is_mat: true, mat_idx: mi}
        }
        if id == ed.modeling.field_ids[MF_EMIT] {
            << ScrubState{active: true, field_id: id, start_x: 0.0, start_val: 0.0, moved: false, min_v: 0.0, max_v: 16.0, step: 0.02, is_mat: true, mat_idx: MF_EMIT}
        }
        if id == ed.modeling.field_ids[MF_ALPHA] {
            << ScrubState{active: true, field_id: id, start_x: 0.0, start_val: 1.0, moved: false, min_v: 0.0, max_v: 1.0, step: 0.005, is_mat: true, mat_idx: MF_ALPHA}
        }
        if id == ed.modeling.field_ids[MF_COAT] {
            << ScrubState{active: true, field_id: id, start_x: 0.0, start_val: 0.0, moved: false, min_v: 0.0, max_v: 1.0, step: 0.005, is_mat: true, mat_idx: MF_COAT}
        }
        if id == ed.modeling.field_ids[MF_IOR] {
            << ScrubState{active: true, field_id: id, start_x: 0.0, start_val: 1.5, moved: false, min_v: 1.0, max_v: 2.5, step: 0.005, is_mat: true, mat_idx: MF_IOR}
        }
    }
    << ScrubState{active: false, field_id: 0, start_x: 0.0, start_val: 0.0, moved: false, min_v: 0.0, max_v: 1.0, step: 0.01, is_mat: false, mat_idx: -1}
}

fn (ed $&Editor) scrub_read_field_val(id int, fallback f64) f64 {
    $raw := ""
    if id == ed.id_pos_x { raw = ed.pos_x.value() }
    else if id == ed.id_pos_y { raw = ed.pos_y.value() }
    else if id == ed.id_pos_z { raw = ed.pos_z.value() }
    else if id == ed.id_rot_x { raw = ed.rot_x.value() }
    else if id == ed.id_rot_y { raw = ed.rot_y.value() }
    else if id == ed.id_rot_z { raw = ed.rot_z.value() }
    else if id == ed.id_scale_x { raw = ed.scale_x.value() }
    else if id == ed.id_scale_y { raw = ed.scale_y.value() }
    else if id == ed.id_scale_z { raw = ed.scale_z.value() }
    else {
        for i in [MF_R, MF_G, MF_B, MF_METALLIC, MF_ROUGHNESS, MF_EMIT, MF_ALPHA, MF_COAT, MF_IOR] {
            if id == ed.modeling.field_ids[i] { raw = ed.modeling.fields[i].value() }
        }
    }
    t := strings.trim_space(&raw)
    if t.len == 0 { << fallback }
    v := strconv.parse_float(&t) >>> (err) {
        _ := err
        << fallback
    }
    if !fm.finite(v) { << fallback }
    << v
}

fn (ed $&Editor) scrub_write_and_route(id int, val_str &string, kind int, input &ui.InputEvent) widgets.Action {
    if id == ed.id_pos_x {
        set_field_val($&ed.pos_x, val_str)
        << route_field($&ed.pos_x, kind, input)
    }
    if id == ed.id_pos_y {
        set_field_val($&ed.pos_y, val_str)
        << route_field($&ed.pos_y, kind, input)
    }
    if id == ed.id_pos_z {
        set_field_val($&ed.pos_z, val_str)
        << route_field($&ed.pos_z, kind, input)
    }
    if id == ed.id_rot_x {
        set_field_val($&ed.rot_x, val_str)
        << route_field($&ed.rot_x, kind, input)
    }
    if id == ed.id_rot_y {
        set_field_val($&ed.rot_y, val_str)
        << route_field($&ed.rot_y, kind, input)
    }
    if id == ed.id_rot_z {
        set_field_val($&ed.rot_z, val_str)
        << route_field($&ed.rot_z, kind, input)
    }
    if id == ed.id_scale_x {
        set_field_val($&ed.scale_x, val_str)
        << route_field($&ed.scale_x, kind, input)
    }
    if id == ed.id_scale_y {
        set_field_val($&ed.scale_y, val_str)
        << route_field($&ed.scale_y, kind, input)
    }
    if id == ed.id_scale_z {
        set_field_val($&ed.scale_z, val_str)
        << route_field($&ed.scale_z, kind, input)
    }
    for i in [MF_R, MF_G, MF_B, MF_METALLIC, MF_ROUGHNESS, MF_EMIT, MF_ALPHA, MF_COAT, MF_IOR] {
        if id == ed.modeling.field_ids[i] {
            set_field_val($&ed.modeling.fields[i], val_str)
            << route_field($&ed.modeling.fields[i], kind, input)
        }
    }
    << widgets.Action{kind: widgets.ACTION_NONE, id: id, needs_paint: false, request_focus: false, consumed: false, value: 0.0}
}

fn (ed $&Editor) route_numeric_field_scrub(id int, kind int, input &ui.InputEvent) widgets.Action {
    if kind == widgets.ROUTE_BLUR || kind == widgets.ROUTE_CANCEL {
        if ed.scrub.active && ed.scrub.field_id == id {
            ed.scrub.active = false
        }
        << modeling_route_or_xf_field(ed, id, kind, input)
    }
    if kind == widgets.ROUTE_INPUT && ed.field_by_id_enabled(id) {
        spec := scrub_spec_for_id(ed, id)
        if spec.active {
            if input.kind == ui.EV_POINTER_DOWN && input.button == ui.BUTTON_LEFT {
                if (input.modifiers & ui.MOD_ALT) != 0 || input.y <= 14.0 {
                    $sv := ed.scrub_read_field_val(id, spec.start_val)
                    if (spec.mat_idx == MF_R || spec.mat_idx == MF_G || spec.mat_idx == MF_B) && sv > 1.0 {
                        sv = math.min(1.0, sv / 255.0)
                    }
                    ed.scrub = ScrubState{
                        active: true, field_id: id, start_x: input.x, start_val: sv, moved: false,
                        min_v: spec.min_v, max_v: spec.max_v, step: spec.step, is_mat: spec.is_mat, mat_idx: spec.mat_idx
                    }
                    << widgets.Action{kind: widgets.ACTION_NONE, id: id, needs_paint: false, request_focus: false, consumed: true, value: 0.0}
                }
            } else if input.kind == ui.EV_POINTER_MOVE && ed.scrub.active && ed.scrub.field_id == id {
                if (input.buttons & 1) == 0 {
                    ed.scrub.active = false
                    << modeling_route_or_xf_field(ed, id, kind, input)
                }
                dx := input.x - ed.scrub.start_x
                if !ed.scrub.moved && math.abs(dx) >= 3.0 {
                    ed.scrub.moved = true
                }
                if ed.scrub.moved {
                    $mult := 1.0
                    if (input.modifiers & ui.MOD_SHIFT) != 0 { mult = 0.1 }
                    nv := math.max(ed.scrub.min_v, math.min(ed.scrub.max_v, ed.scrub.start_val + dx * ed.scrub.step * mult))
                    vtxt := fmt_coord(nv)
                    _ := ed.scrub_write_and_route(id, &vtxt, widgets.ROUTE_INPUT, &ui.InputEvent{
                        kind: ui.EV_NONE, window_id: input.window_id, canvas_id: input.canvas_id, generation: input.generation,
                        x: input.x, y: input.y, dx: 0.0, dy: 0.0, button: 0, buttons: 0, modifiers: 0, key: 0, scan: 0, repeat: 0, click_count: 0, time_ns: input.time_ns
                    })
                    << widgets.Action{kind: widgets.ACTION_CHANGE, id: id, needs_paint: true, request_focus: false, consumed: true, value: nv}
                }
                << widgets.Action{kind: widgets.ACTION_NONE, id: id, needs_paint: false, request_focus: false, consumed: true, value: 0.0}
            } else if (input.kind == ui.EV_POINTER_UP || input.kind == ui.EV_POINTER_CANCEL) && ed.scrub.active && ed.scrub.field_id == id {
                was_moved := ed.scrub.moved
                ed.scrub.active = false
                if was_moved && input.kind == ui.EV_POINTER_UP {
                    << widgets.Action{kind: widgets.ACTION_COMMIT, id: id, needs_paint: true, request_focus: false, consumed: true, value: 0.0}
                }
                if input.kind == ui.EV_POINTER_UP {
                    syn_dn := ui.InputEvent{
                        kind: ui.EV_POINTER_DOWN, window_id: input.window_id, canvas_id: input.canvas_id, generation: input.generation,
                        x: input.x, y: math.max(16.0, input.y), dx: 0.0, dy: 0.0, button: ui.BUTTON_LEFT, buttons: 1, modifiers: input.modifiers, key: 0, scan: 0, repeat: 0, click_count: 1, time_ns: input.time_ns
                    }
                    _ := modeling_route_or_xf_field(ed, id, widgets.ROUTE_INPUT, &syn_dn)
                }
                << modeling_route_or_xf_field(ed, id, kind, input)
            }
        }
    }
    << modeling_route_or_xf_field(ed, id, kind, input)
}

fn modeling_route_or_xf_field(ed $&Editor, id int, kind int, input &ui.InputEvent) widgets.Action {
    if id == ed.id_pos_x { << route_field($&ed.pos_x, kind, input) }
    if id == ed.id_pos_y { << route_field($&ed.pos_y, kind, input) }
    if id == ed.id_pos_z { << route_field($&ed.pos_z, kind, input) }
    if id == ed.id_rot_x { << route_field($&ed.rot_x, kind, input) }
    if id == ed.id_rot_y { << route_field($&ed.rot_y, kind, input) }
    if id == ed.id_rot_z { << route_field($&ed.rot_z, kind, input) }
    if id == ed.id_scale_x { << route_field($&ed.scale_x, kind, input) }
    if id == ed.id_scale_y { << route_field($&ed.scale_y, kind, input) }
    if id == ed.id_scale_z { << route_field($&ed.scale_z, kind, input) }
    << modeling_route_input($&ed.modeling, id, kind, input)
}

// InputHandler contract method (routes node-local inputs from View)
pub fn (ed $&Editor) input(id int, kind int, input &ui.InputEvent) widgets.Action {
    if kind == widgets.ROUTE_FOCUS {
        ed.focused_id = id
    } else if (kind == widgets.ROUTE_BLUR || kind == widgets.ROUTE_CANCEL) && ed.focused_id == id {
        ed.focused_id = 0
    }
    if id == ed.id_scene_select { << route_sel($&ed.scene_select, kind, input) }
    if id == ed.id_new_scene_btn { << route_btn($&ed.new_scene_btn, kind, input) }
    if id == ed.id_globals_btn { << route_btn($&ed.globals_btn, kind, input) }
    if id == ed.id_stage_tabs { << route_tabs($&ed.stage_tabs, kind, input) }
    if id == ed.id_undo_btn { << route_btn($&ed.undo_btn, kind, input) }
    if id == ed.id_redo_btn { << route_btn($&ed.redo_btn, kind, input) }
    if id == ed.id_save_btn { << route_btn($&ed.save_btn, kind, input) }
    if id == ed.id_preview_btn { << route_btn($&ed.preview_btn, kind, input) }
    if id == ed.id_left_tabs { << route_tabs($&ed.left_tabs, kind, input) }
    if id == ed.id_add_node_select { << route_sel($&ed.add_node_select, kind, input) }
    if id == ed.id_dup_btn { << route_btn($&ed.dup_btn, kind, input) }
    if id == ed.id_del_btn { << route_btn($&ed.del_btn, kind, input) }
    if id == ed.id_tree {
        $vis_dirty := false
        if kind == widgets.ROUTE_BLUR || kind == widgets.ROUTE_CANCEL {
            ed.tree_down_modifiers = 0
            if ed.tree_vis_drag_active || ed.tree_hover_row != -1 || ed.tree_hover_vis_tid != -1 || ed.tree_armed_vis_tid != -1 {
                ed.tree_vis_drag_active = false
                ed.tree_vis_drag_start_row = -1
                ed.tree_vis_drag_cur_row = -1
                ed.tree_vis_drag_start_sid = -1
                ed.tree_vis_drag_orig = map[int]bool{}
                ed.tree_vis_drag_changed = 0
                ed.tree_hover_row = -1
                ed.tree_hover_vis_tid = -1
                ed.tree_armed_vis_tid = -1
                vis_dirty = true
            }
        } else if kind == widgets.ROUTE_INPUT && input.kind == ui.EV_POINTER_LEAVE {
            if ed.tree_vis_drag_active {
                << widgets.Action{kind: widgets.ACTION_NONE, id: ed.id_tree, needs_paint: false, request_focus: false, consumed: true, value: 0.0}
            }
            if ed.tree_hover_row != -1 || ed.tree_hover_vis_tid != -1 || ed.tree_armed_vis_tid != -1 {
                ed.tree_hover_row = -1
                ed.tree_hover_vis_tid = -1
                ed.tree_armed_vis_tid = -1
                vis_dirty = true
            }
        } else if kind == widgets.ROUTE_INPUT && ed.tree_vis_drag_active {
            if input.kind == ui.EV_POINTER_MOVE {
                cur_row := ed.tree_drag_row_at_y(input.y)
                if cur_row >= 0 {
                    cur_tid := ed.tree_visible_tid_at_row(cur_row)
                    if cur_row != ed.tree_hover_row || cur_tid != ed.tree_hover_vis_tid || cur_tid != ed.tree_armed_vis_tid {
                        ed.tree_hover_row = cur_row
                        ed.tree_hover_vis_tid = cur_tid
                        ed.tree_armed_vis_tid = cur_tid
                        vis_dirty = true
                    }
                    if cur_row != ed.tree_vis_drag_cur_row {
                        ed.tree_vis_drag_cur_row = cur_row
                        << widgets.Action{kind: widgets.ACTION_ITEM_ACTION, id: ed.id_tree, needs_paint: true, request_focus: false, consumed: true, value: -2.0}
                    }
                }
                << widgets.Action{kind: widgets.ACTION_NONE, id: ed.id_tree, needs_paint: vis_dirty, request_focus: false, consumed: true, value: 0.0}
            }
            if input.kind == ui.EV_POINTER_UP && input.button == ui.BUTTON_LEFT {
                cur_row := ed.tree_drag_row_at_y(input.y)
                if cur_row >= 0 {
                    ed.tree_vis_drag_cur_row = cur_row
                }
                ed.tree_vis_drag_active = false
                ed.tree_armed_vis_tid = -1
                ed.tree_hover_row = ed.tree_hit_row(input.x, input.y)
                ed.tree_hover_vis_tid = ed.tree_hit_vis_tid(input.x, input.y)
                << widgets.Action{kind: widgets.ACTION_ITEM_ACTION, id: ed.id_tree, needs_paint: true, request_focus: false, consumed: true, value: -3.0}
            }
            << widgets.Action{kind: widgets.ACTION_NONE, id: ed.id_tree, needs_paint: false, request_focus: false, consumed: true, value: 0.0}
        } else if kind == widgets.ROUTE_INPUT && (input.kind == ui.EV_POINTER_MOVE || input.kind == ui.EV_POINTER_ENTER || input.kind == ui.EV_POINTER_DOWN || input.kind == ui.EV_POINTER_UP) {
            nr := ed.tree_hit_row(input.x, input.y)
            ntid := ed.tree_hit_vis_tid(input.x, input.y)
            if input.kind == ui.EV_POINTER_DOWN && input.button == ui.BUTTON_LEFT && nr >= 0 && ntid >= 0 && ed.tree_to_scene.has(ntid) {
                ed.tree_vis_drag_active = true
                ed.tree_vis_drag_start_row = nr
                ed.tree_vis_drag_cur_row = nr
                ed.tree_vis_drag_start_sid = ed.tree_to_scene[ntid]
                ed.tree_down_modifiers = 0
                ed.tree_hover_row = nr
                ed.tree_hover_vis_tid = ntid
                ed.tree_armed_vis_tid = ntid
                << widgets.Action{kind: widgets.ACTION_ITEM_ACTION, id: ed.id_tree, needs_paint: true, request_focus: false, consumed: true, value: -1.0}
            }
            if nr != ed.tree_hover_row || ntid != ed.tree_hover_vis_tid {
                ed.tree_hover_row = nr
                ed.tree_hover_vis_tid = ntid
                vis_dirty = true
            }
            if input.kind == ui.EV_POINTER_DOWN && input.button == ui.BUTTON_LEFT {
                if ed.tree_armed_vis_tid != ntid {
                    ed.tree_armed_vis_tid = ntid
                    vis_dirty = true
                }
            } else if input.kind == ui.EV_POINTER_UP && input.button == ui.BUTTON_LEFT {
                if ed.tree_armed_vis_tid != -1 {
                    ed.tree_armed_vis_tid = -1
                    vis_dirty = true
                }
            }
        }
        if kind == widgets.ROUTE_INPUT && input.kind == ui.EV_POINTER_DOWN && input.button == ui.BUTTON_LEFT {
            ed.tree_down_modifiers = input.modifiers & (ui.MOD_SHIFT | ui.MOD_META | ui.MOD_CONTROL)
        } else if kind == widgets.ROUTE_INPUT && input.kind == ui.EV_POINTER_UP && input.button == ui.BUTTON_LEFT {
            saved := ed.tree_down_modifiers
            ed.tree_down_modifiers = 0
            if saved != 0 && (input.modifiers & (ui.MOD_SHIFT | ui.MOD_META | ui.MOD_CONTROL)) == 0 {
                ev := ui.InputEvent{
                    kind: input.kind, window_id: input.window_id, canvas_id: input.canvas_id, generation: input.generation,
                    x: input.x, y: input.y, dx: input.dx, dy: input.dy, button: input.button, buttons: input.buttons,
                    modifiers: input.modifiers | saved, key: input.key, scan: input.scan, repeat: input.repeat,
                    click_count: input.click_count, time_ns: input.time_ns
                }
                $act := route_tree($&ed.tree, kind, &ev)
                if vis_dirty { act.needs_paint = true }
                << act
            }
        }
        $act := route_tree($&ed.tree, kind, input)
        if vis_dirty { act.needs_paint = true }
        << act
    }
    if id == ed.id_import_btn { << route_btn($&ed.import_btn, kind, input) }
    if id == ed.id_asset_list { << route_tree($&ed.asset_list, kind, input) }
    if id == ed.id_asset_select { << route_sel($&ed.asset_select, kind, input) }
    if id == ed.id_prim_field { << route_field($&ed.prim_field, kind, input) }
    if id == ed.id_place_btn { << route_btn($&ed.place_btn, kind, input) }
    if id == ed.id_stage_axis_btn { << route_btn($&ed.stage_axis_btn, kind, input) }
    if id == ed.id_stage_snap_btn { << route_btn($&ed.stage_snap_btn, kind, input) }
    if id == ed.id_fit_btn { << route_btn($&ed.fit_btn, kind, input) }
    if id == ed.id_snap_btn { << route_btn($&ed.snap_btn, kind, input) }
    if id == ed.id_insp_tabs { << route_tabs($&ed.insp_tabs, kind, input) }
    if id == ed.id_add_comp_select { << route_sel($&ed.add_comp_select, kind, input) }
    if id == ed.id_insp_scroll {
        sc := $&ed.insp_scroll
        << sc.route(kind, input)
    }
    if id == ed.id_visible_chk { << route_chk($&ed.visible_chk, kind, input) }
    if id == ed.id_process_select { << route_sel($&ed.process_select, kind, input) }
    if id == ed.id_parent_select { << route_sel($&ed.parent_select, kind, input) }
    if id == ed.id_reparent_btn { << route_btn($&ed.reparent_btn, kind, input) }
    if id == ed.id_surf_asset_select { << route_sel($&ed.surf_asset_select, kind, input) }
    if id == ed.id_surf_prim_field { << route_field($&ed.surf_prim_field, kind, input) }
    if id == ed.id_surf_bind_btn { << route_btn($&ed.surf_bind_btn, kind, input) }
    if id == ed.id_surf_clear_btn { << route_btn($&ed.surf_clear_btn, kind, input) }
    if id == ed.id_lod_info { << route_text($&ed.lod_info_txt, kind, input) }
    if id == ed.id_lod_hyst_field { << route_field($&ed.lod_hyst_field, kind, input) }
    if id == ed.id_lod_dist_field { << route_field($&ed.lod_dist_field, kind, input) }
    if id == ed.id_lod_prim_field { << route_field($&ed.lod_prim_field, kind, input) }
    if id == ed.id_lod_asset_select { << route_sel($&ed.lod_asset_select, kind, input) }
    if id == ed.id_lod_add_btn { << route_btn($&ed.lod_add_btn, kind, input) }
    if id == ed.id_lod_pop_btn { << route_btn($&ed.lod_pop_btn, kind, input) }
    if id == ed.id_apply_btn { << route_btn($&ed.apply_btn, kind, input) }
    if id == ed.id_name_field { << route_field($&ed.name_field, kind, input) }
    reset_x := math.max(80.0, ed.right_w - 76.0)
    if id == ed.id_pos_lbl && ed.insp_can_trs && !transform_part_is_default(ed, 1) {
        if kind == widgets.ROUTE_INPUT && input.kind == ui.EV_POINTER_UP && input.button == ui.BUTTON_LEFT && input.x >= reset_x {
            << widgets.Action{kind: widgets.ACTION_ACTIVATE, id: id, needs_paint: true, request_focus: false, consumed: true, value: 1.0}
        }
    }
    if id == ed.id_rot_lbl && ed.insp_can_trs && !transform_part_is_default(ed, 2) {
        if kind == widgets.ROUTE_INPUT && input.kind == ui.EV_POINTER_UP && input.button == ui.BUTTON_LEFT && input.x >= reset_x {
            << widgets.Action{kind: widgets.ACTION_ACTIVATE, id: id, needs_paint: true, request_focus: false, consumed: true, value: 2.0}
        }
    }
    if id == ed.id_scale_lbl && ed.insp_can_trs && !transform_part_is_default(ed, 3) {
        if kind == widgets.ROUTE_INPUT && input.kind == ui.EV_POINTER_UP && input.button == ui.BUTTON_LEFT && input.x >= reset_x {
            << widgets.Action{kind: widgets.ACTION_ACTIVATE, id: id, needs_paint: true, request_focus: false, consumed: true, value: 3.0}
        }
    }
    if id == ed.id_pos_x || id == ed.id_pos_y || id == ed.id_pos_z ||
       id == ed.id_rot_x || id == ed.id_rot_y || id == ed.id_rot_z ||
       id == ed.id_scale_x || id == ed.id_scale_y || id == ed.id_scale_z {
        << ed.route_numeric_field_scrub(id, kind, input)
    }
    if id == ed.id_asset_meta { << route_text($&ed.asset_meta_txt, kind, input) }
    if id == ed.id_insp_hdr { << route_text($&ed.insp_hdr_txt, kind, input) }
    if id == ed.id_surf_info { << route_text($&ed.surf_info_txt, kind, input) }
    if id == ed.id_status_txt { << route_text($&ed.status_txt, kind, input) }

    if id == ed.id_left_split || id == ed.id_right_split {
        << ed.route_splitter(id, kind, input)
    }
    if id == ed.id_top_view {
        << ed.route_top_view(kind, input)
    }
    if id == ed.panels.id_open_proj_btn || id == ed.panels.id_scene_mgr_btn || id == ed.panels.id_export_btn || id == ed.panels.id_lang_btn ||
       id == ed.panels.id_node_up_btn || id == ed.panels.id_node_dn_btn ||
       id == ed.panels.id_tree_filter || id == ed.panels.id_asset_prims ||
       id == ed.panels.id_relocate_btn || id == ed.panels.id_remove_asset_btn {
        << panels_route_input($&ed.panels, id, kind, input)
    }
    mact := ed.route_numeric_field_scrub(id, kind, input)
    if mact.consumed || mact.needs_paint || mact.kind != widgets.ACTION_NONE {
        << mact
    }
    << route_comp_input($&ed.comp, id, kind, input)
}

fn (ed $&Editor) route_splitter(id int, kind int, input &ui.InputEvent) widgets.Action {
    if kind == widgets.ROUTE_BLUR || kind == widgets.ROUTE_CANCEL {
        was_drag := ed.dragging_split != 0
        ed.dragging_split = 0
        << widgets.Action{kind: widgets.ACTION_NONE, id: id, needs_paint: was_drag, request_focus: false, consumed: false, value: 0.0}
    }
    if kind != widgets.ROUTE_INPUT {
        << widgets.Action{kind: widgets.ACTION_NONE, id: id, needs_paint: false, request_focus: false, consumed: false, value: 0.0}
    }
    $dirty := false
    $consumed := false
    if input.kind == ui.EV_POINTER_DOWN && input.button == ui.BUTTON_LEFT {
        if id == ed.id_left_split {
            ed.dragging_split = 1
            ed.split_orig_w = ed.left_w
            ed.split_start_gx = ed.left_w + input.x
        } else if id == ed.id_right_split {
            ed.dragging_split = 2
            ed.split_orig_w = ed.right_w
            ed.split_start_gx = (ed.viewport_w - ed.right_w - f64(SPLITTER_W)) + input.x
        }
        consumed = true
        dirty = true
    } else if input.kind == ui.EV_POINTER_MOVE && ed.dragging_split != 0 {
        if ed.dragging_split == 1 && id == ed.id_left_split {
            cur_gx := ed.left_w + input.x
            ed.left_w = ed.split_orig_w + (cur_gx - ed.split_start_gx)
            ed.clamp_widths(ed.viewport_w)
            consumed = true
            dirty = true
        } else if ed.dragging_split == 2 && id == ed.id_right_split {
            cur_gx := (ed.viewport_w - ed.right_w - f64(SPLITTER_W)) + input.x
            ed.right_w = ed.split_orig_w - (cur_gx - ed.split_start_gx)
            ed.clamp_widths(ed.viewport_w)
            consumed = true
            dirty = true
        }
    } else if (input.kind == ui.EV_POINTER_UP && input.button == ui.BUTTON_LEFT) || input.kind == ui.EV_POINTER_CANCEL {
        if ed.dragging_split != 0 {
            ed.dragging_split = 0
            consumed = true
            dirty = true
        }
    }
    $kind := widgets.ACTION_NONE
    if dirty && ed.dragging_split != 0 { kind = widgets.ACTION_CHANGE }
    << widgets.Action{kind: kind, id: id, needs_paint: dirty, request_focus: false, consumed: consumed, value: 0.0}
}

fn (ed $&Editor) route_top_view(kind int, input &ui.InputEvent) widgets.Action {
    if ed.stage_mode == STAGE_MODE_3D || ed.stage_mode == STAGE_MODE_SPLIT {
        tv_rect := copy_rect(&ed.top_view_local)
        is_split := ed.stage_mode == STAGE_MODE_SPLIT
        doc3d := ed.draft.document() >>>
        sel_n := ed.selected_node
        snap_en := ed.top_snap_enabled
        snap_mv := ed.snap.move_step
        snap_rt := ed.snap.rotate_deg
        snap_sc := ed.snap.scale_pct * 0.01
        $sel_list := []int{}
        for k in 0:ed.selected_nodes.len { sel_list.push(ed.selected_nodes[k]) }
        vp := $&ed.vp3d
        vp_act := vp.route_input(&tv_rect, is_split, &doc3d, sel_n, &sel_list, snap_en, snap_mv, snap_rt, snap_sc, kind, input)
        if vp_act == VP3D_ACT_RENDER {
            ed.vp3d.dirty_render = true
            ed.req_embed_render = true
        } else if vp_act == VP3D_ACT_PICK {
            ed.req_embed_pick = true
        } else if vp_act == VP3D_ACT_COMMIT_MOVE {
            << widgets.Action{kind: widgets.ACTION_CHANGE, id: ed.id_top_view, needs_paint: true, request_focus: true, consumed: true, value: 15.0}
        } else if vp_act == VP3D_ACT_COMMIT_SUB_MOVE {
            << widgets.Action{kind: widgets.ACTION_CHANGE, id: ed.id_top_view, needs_paint: true, request_focus: true, consumed: true, value: 16.0}
        }
        painted := vp_act != VP3D_ACT_NONE
        << widgets.Action{kind: widgets.ACTION_NONE, id: ed.id_top_view, needs_paint: painted, request_focus: input.kind == ui.EV_POINTER_DOWN, consumed: painted, value: 0.0}
    }
    if ed.stage_mode == STAGE_MODE_TILEMAP {
        tv_rect := copy_rect(&ed.top_view_local)
        tm := $&ed.tilemap
        tm_act := tm.route_input(&tv_rect, kind, input)
        if tm_act == TM_ACT_COMMIT_STROKE {
            << widgets.Action{kind: widgets.ACTION_CHANGE, id: ed.id_top_view, needs_paint: true, request_focus: true, consumed: true, value: 10.0}
        }
        if tm_act == TM_ACT_COMMIT_EXIT {
            << widgets.Action{kind: widgets.ACTION_CHANGE, id: ed.id_top_view, needs_paint: true, request_focus: true, consumed: true, value: 11.0}
        }
        if tm_act == TM_ACT_SELECT_LAYER {
            << widgets.Action{kind: widgets.ACTION_CHANGE, id: ed.id_top_view, needs_paint: true, request_focus: true, consumed: true, value: 12.0}
        }
        painted := tm_act == TM_ACT_REPAINT
        << widgets.Action{kind: widgets.ACTION_NONE, id: ed.id_top_view, needs_paint: painted, request_focus: input.kind == ui.EV_POINTER_DOWN, consumed: painted, value: 0.0}
    }
    if kind == widgets.ROUTE_BLUR || kind == widgets.ROUTE_CANCEL {
        was_active := ed.top_view.panning || ed.top_view.dragging_nodes || ed.top_view.drag_pending || ed.top_view.marquee_active
        tv := $&ed.top_view
        tv.end_pan()
        tv.cancel_node_interactions()
        ed.top_pressed_hit = -1
        ed.top_pressed_shift = false
        ed.top_defer_single_click = false
        << widgets.Action{kind: widgets.ACTION_NONE, id: ed.id_top_view, needs_paint: was_active, request_focus: false, consumed: false, value: 0.0}
    }
    if kind != widgets.ROUTE_INPUT {
        << widgets.Action{kind: widgets.ACTION_NONE, id: ed.id_top_view, needs_paint: false, request_focus: false, consumed: false, value: 0.0}
    }
    $dirty := false
    $consumed := false
    $act_kind := widgets.ACTION_NONE
    $picked := -1.0
    if input.kind == ui.EV_POINTER_SCROLL {
        tv_rect := copy_rect(&ed.top_view_local)
        tv := $&ed.top_view
        tv.zoom_around(&tv_rect, input.x, input.y, input.dy)
        dirty = true
        consumed = true
    } else if input.kind == ui.EV_POINTER_DOWN && (input.button == ui.BUTTON_RIGHT || input.button == ui.BUTTON_MIDDLE) {
        tv := $&ed.top_view
        tv.cancel_node_interactions()
        tv.begin_pan(input.x, input.y)
        dirty = true
        consumed = true
    } else if input.kind == ui.EV_POINTER_MOVE {
        if ed.top_view.panning {
            tv := $&ed.top_view
            tv.update_pan(input.x, input.y)
            dirty = true
            consumed = true
        } else if ed.top_view.drag_pending || ed.top_view.dragging_nodes {
            dx_px := input.x - ed.top_view.drag_start_sx
            dy_px := input.y - ed.top_view.drag_start_sy
            if !ed.top_view.dragging_nodes && dx_px * dx_px + dy_px * dy_px >= 16.0 {
                ed.top_view.dragging_nodes = true
            }
            if ed.top_view.dragging_nodes {
                raw_dx := screen_to_world_x(&ed.top_view, &ed.top_view_local, input.x) -
                    screen_to_world_x(&ed.top_view, &ed.top_view_local, ed.top_view.drag_start_sx)
                raw_dv := screen_to_world_z(&ed.top_view, &ed.top_view_local, input.y) -
                    screen_to_world_z(&ed.top_view, &ed.top_view_local, ed.top_view.drag_start_sy)
                if ed.top_snap_enabled && ed.snap.move_step > 0.0 {
                    ed.top_view.drag_dx = snap_coord(raw_dx, ed.snap.move_step)
                    ed.top_view.drag_dv = snap_coord(raw_dv, ed.snap.move_step)
                } else {
                    ed.top_view.drag_dx = raw_dx
                    ed.top_view.drag_dv = raw_dv
                }
            }
            dirty = true
            consumed = true
        } else if ed.top_view.marquee_active {
            ed.top_view.marquee_cur_sx = input.x
            ed.top_view.marquee_cur_sy = input.y
            dirty = true
            consumed = true
        } else if ed.placing_mode {
            ed.top_view.hover_x = screen_to_world_x(&ed.top_view, &ed.top_view_local, input.x)
            ed.top_view.hover_z = screen_to_world_z(&ed.top_view, &ed.top_view_local, input.y)
            ed.top_view.has_hover = true
            if ed.top_view.hover_node >= 0 { ed.top_view.hover_node = -1 }
            dirty = true
        } else {
            hovered := pick_stage_node(&ed.top_view, &ed.top_view_local, &ed.stage_pts, input.x, input.y)
            if hovered != ed.top_view.hover_node {
                ed.top_view.hover_node = hovered
                dirty = true
            }
        }
    } else if input.kind == ui.EV_POINTER_UP && (input.button == ui.BUTTON_RIGHT || input.button == ui.BUTTON_MIDDLE) {
        if ed.top_view.panning {
            tv := $&ed.top_view
            tv.end_pan()
            dirty = true
            consumed = true
        }
    } else if input.kind == ui.EV_POINTER_UP && input.button == ui.BUTTON_LEFT {
        if ed.top_view.dragging_nodes {
            ed.top_commit_dx = ed.top_view.drag_dx
            ed.top_commit_dv = ed.top_view.drag_dv
            tv := $&ed.top_view
            tv.cancel_node_interactions()
            ed.top_pressed_hit = -1
            ed.top_defer_single_click = false
            act_kind = widgets.ACTION_CHANGE
            picked = 1.0
            dirty = true
            consumed = true
        } else if ed.top_view.drag_pending {
            hit_id := ed.top_pressed_hit
            collapse_single := ed.top_defer_single_click
            tv := $&ed.top_view
            tv.cancel_node_interactions()
            ed.top_pressed_hit = -1
            ed.top_defer_single_click = false
            if collapse_single && hit_id >= 0 {
                ed.top_pressed_shift = false
                picked = f64(hit_id)
                act_kind = widgets.ACTION_ACTIVATE
                dirty = true
            }
            consumed = true
        } else if ed.top_view.marquee_active {
            ed.top_marquee_x0 = ed.top_view.marquee_start_sx
            ed.top_marquee_y0 = ed.top_view.marquee_start_sy
            ed.top_marquee_x1 = ed.top_view.marquee_cur_sx
            ed.top_marquee_y1 = ed.top_view.marquee_cur_sy
            tv := $&ed.top_view
            tv.cancel_node_interactions()
            ed.top_defer_single_click = false
            act_kind = widgets.ACTION_CHANGE
            picked = 2.0
            dirty = true
            consumed = true
        }
    } else if input.kind == ui.EV_POINTER_LEAVE || input.kind == ui.EV_POINTER_CANCEL {
        if ed.top_view.hover_node >= 0 || ed.top_view.has_hover {
            ed.top_view.hover_node = -1
            ed.top_view.has_hover = false
            dirty = true
        }
        if input.kind == ui.EV_POINTER_CANCEL {
            tv := $&ed.top_view
            tv.end_pan()
            tv.cancel_node_interactions()
            ed.top_pressed_hit = -1
            ed.top_defer_single_click = false
            dirty = true
        }
    } else if input.kind == ui.EV_POINTER_DOWN && input.button == ui.BUTTON_LEFT {
        if ed.placing_mode {
            wx := screen_to_world_x(&ed.top_view, &ed.top_view_local, input.x)
            wz := screen_to_world_z(&ed.top_view, &ed.top_view_local, input.y)
            ed.top_view.hover_x = wx
            ed.top_view.hover_z = wz
            ed.top_view.has_hover = true
            act_kind = widgets.ACTION_COMMIT
            consumed = true
            dirty = true
        } else {
            hit := pick_stage_node(&ed.top_view, &ed.top_view_local, &ed.stage_pts, input.x, input.y)
            shift := (input.modifiers & (ui.MOD_SHIFT | ui.MOD_META | ui.MOD_CONTROL)) != 0
            ed.top_pressed_shift = shift
            if hit >= 0 {
                ed.top_pressed_hit = hit
                already_multi := !shift && ed.selected_nodes.len > 1 && is_selected_node(&ed.selected_nodes, hit)
                ed.top_defer_single_click = already_multi
                if !already_multi {
                    picked = f64(hit)
                    act_kind = widgets.ACTION_ACTIVATE
                }
                if hit > 0 {
                    ed.top_view.drag_pending = true
                    ed.top_view.dragging_nodes = false
                    ed.top_view.drag_start_sx = input.x
                    ed.top_view.drag_start_sy = input.y
                    ed.top_view.drag_dx = 0.0
                    ed.top_view.drag_dv = 0.0
                }
                dirty = true
            } else {
                ed.top_pressed_hit = -1
                ed.top_defer_single_click = false
                ed.top_view.marquee_active = true
                ed.top_view.marquee_start_sx = input.x
                ed.top_view.marquee_start_sy = input.y
                ed.top_view.marquee_cur_sx = input.x
                ed.top_view.marquee_cur_sy = input.y
                dirty = true
            }
            consumed = true
        }
    }
    << widgets.Action{kind: act_kind, id: ed.id_top_view, needs_paint: dirty, request_focus: true, consumed: consumed, value: picked}
}

fn (ed &Editor) any_text_field_focused() bool {
    << ed.name_field.is_focused() || ed.prim_field.is_focused() ||
        ed.pos_x.is_focused() || ed.pos_y.is_focused() || ed.pos_z.is_focused() ||
        ed.rot_x.is_focused() || ed.rot_y.is_focused() || ed.rot_z.is_focused() ||
        ed.scale_x.is_focused() || ed.scale_y.is_focused() || ed.scale_z.is_focused() ||
        ed.surf_prim_field.is_focused() || ed.lod_hyst_field.is_focused() ||
        ed.lod_dist_field.is_focused() || ed.lod_prim_field.is_focused() ||
        comp_any_focused(&ed.comp) || panels_any_focused(&ed.panels) ||
        modeling_any_focused(&ed.modeling)
}

pub fn (ed $&Editor) close_all_selects() {
    set_sel_open($&ed.scene_select, false)
    set_sel_open($&ed.asset_select, false)
    set_sel_open($&ed.add_node_select, false)
    set_sel_open($&ed.add_comp_select, false)
    set_sel_open($&ed.parent_select, false)
    set_sel_open($&ed.process_select, false)
    set_sel_open($&ed.surf_asset_select, false)
    set_sel_open($&ed.lod_asset_select, false)
    comp_close_selects($&ed.comp)
    modeling_close_selects($&ed.modeling)
}

fn (ed $&Editor) handle_modal_input(input &ui.InputEvent, view $&widgets.View) bool {
    if ed.modals.kind == MODAL_NONE { << false }
    if input.kind == ui.EV_KEY_DOWN && input.repeat == 0 {
        if input.key == ui.KEY_ESCAPE && !ed.modals.has_popup_open() {
            modal_close($&ed.modals)
            ed.apply_pointer_cursor(view)
            repaint(view, ed.id_root)
            << true
        }
        if ed.modals.kind == MODAL_SNAP {
            if input.key == ui.KEY_TAB {
                order := [ID_MODAL_MOVE, ID_MODAL_ROTATE, ID_MODAL_SCALE, ID_MODAL_SNAP_CANCEL, ID_MODAL_SNAP_SAVE]
                $next := order[0]
                for i in 0:order.len {
                    if order[i] == ed.modals.focused_id {
                        $pos := i + 1
                        if pos >= order.len { pos = 0 }
                        next = order[pos]
                    }
                }
                modal_set_focus($&ed.modals, next)
                repaint(view, ed.id_root)
                << true
            }
            if input.key == ui.KEY_ENTER && !ed.modals.has_popup_open() && ed.modals.focused_id != ID_MODAL_SNAP_CANCEL {
                ed.submit_snap_modal(view)
                ed.apply_pointer_cursor(view)
                << true
            }
        } else if ed.modals.kind == MODAL_NEW_SCENE {
            if input.key == ui.KEY_TAB {
                order := [ID_MODAL_SCENE_NAME, ID_MODAL_SCENE_ROOT, ID_MODAL_SCENE_CANCEL, ID_MODAL_SCENE_CREATE]
                $next := order[0]
                for i in 0:order.len {
                    if order[i] == ed.modals.focused_id {
                        $pos := i + 1
                        if pos >= order.len { pos = 0 }
                        next = order[pos]
                    }
                }
                modal_set_focus($&ed.modals, next)
                repaint(view, ed.id_root)
                << true
            }
            if input.key == ui.KEY_ENTER && !ed.modals.has_popup_open() && ed.modals.focused_id != ID_MODAL_SCENE_CANCEL {
                ed.submit_new_scene_modal(view)
                ed.apply_pointer_cursor(view)
                << true
            }
        } else if ed.modals.kind == MODAL_GLOBALS {
            if input.key == ui.KEY_TAB {
                order := [ID_MODAL_BUS_NAME, ID_MODAL_BUS_VOL, ID_MODAL_BUS_ADD, ID_MODAL_BUS_MUTE, ID_MODAL_BUS_DEL, ID_MODAL_CONN_SRC, ID_MODAL_CONN_SIG, ID_MODAL_CONN_DST, ID_MODAL_CONN_HND, ID_MODAL_CONN_ADD, ID_MODAL_CONN_DEL, ID_MODAL_GLOBALS_CLOSE]
                $next := order[0]
                for i in 0:order.len {
                    if order[i] == ed.modals.focused_id {
                        $pos := i + 1
                        if pos >= order.len { pos = 0 }
                        next = order[pos]
                    }
                }
                modal_set_focus($&ed.modals, next)
                repaint(view, ed.id_root)
                << true
            }
            if input.key == ui.KEY_ENTER && !ed.modals.has_popup_open() {
                fid := ed.modals.focused_id
                if fid == ID_MODAL_GLOBALS_CLOSE { ed.handle_globals_modal_action(1, view) }
                else if fid == ID_MODAL_BUS_NAME || fid == ID_MODAL_BUS_VOL || fid == ID_MODAL_BUS_ADD { ed.handle_globals_modal_action(2, view) }
                else if fid == ID_MODAL_BUS_MUTE { ed.handle_globals_modal_action(3, view) }
                else if fid == ID_MODAL_BUS_DEL { ed.handle_globals_modal_action(4, view) }
                else if fid == ID_MODAL_CONN_DEL { ed.handle_globals_modal_action(6, view) }
                else { ed.handle_globals_modal_action(5, view) }
                ed.apply_pointer_cursor(view)
                repaint(view, ed.id_root)
                << true
            }
        } else if ed.modals.kind == MODAL_SCENE_MANAGE {
            if input.key == ui.KEY_TAB {
                order := [ID_MODAL_MGR_NAME, ID_MODAL_MGR_RENAME, ID_MODAL_MGR_DUP, ID_MODAL_MGR_DEL, ID_MODAL_MGR_CLOSE]
                $next := order[0]
                for i in 0:order.len {
                    if order[i] == ed.modals.focused_id {
                        $pos := i + 1
                        if pos >= order.len { pos = 0 }
                        next = order[pos]
                    }
                }
                modal_set_focus($&ed.modals, next)
                repaint(view, ed.id_root)
                << true
            }
            if input.key == ui.KEY_ENTER && !ed.modals.has_popup_open() {
                fid := ed.modals.focused_id
                if fid == ID_MODAL_MGR_CLOSE { ed.handle_scene_manage_action(4, view) }
                else if fid == ID_MODAL_MGR_DEL { ed.handle_scene_manage_action(3, view) }
                else if fid == ID_MODAL_MGR_DUP { ed.handle_scene_manage_action(2, view) }
                else { ed.handle_scene_manage_action(1, view) }
                ed.apply_pointer_cursor(view)
                repaint(view, ed.id_root)
                << true
            }
        } else if ed.modals.kind == MODAL_EXPORT {
            if input.key == ui.KEY_TAB {
                order := [ID_MODAL_EXPORT_DIR, ID_MODAL_EXPORT_CANCEL, ID_MODAL_EXPORT_RUN]
                $next := order[0]
                for i in 0:order.len {
                    if order[i] == ed.modals.focused_id {
                        $pos := i + 1
                        if pos >= order.len { pos = 0 }
                        next = order[pos]
                    }
                }
                modal_set_focus($&ed.modals, next)
                repaint(view, ed.id_root)
                << true
            }
            if input.key == ui.KEY_ENTER && !ed.modals.has_popup_open() && ed.modals.focused_id != ID_MODAL_EXPORT_CANCEL {
                ed.submit_export_modal(view)
                ed.apply_pointer_cursor(view)
                << true
            }
        }
    }

    if ed.modals.kind == MODAL_SNAP {
        act := route_snap_modal_widgets($&ed.modals, input)
        if act == 1 { modal_close($&ed.modals) }
        if act == 2 { ed.submit_snap_modal(view) }
        ed.apply_pointer_cursor(view)
        repaint(view, ed.id_root)
        << true
    } else if ed.modals.kind == MODAL_NEW_SCENE {
        act := route_scene_modal_widgets($&ed.modals, input)
        if act == 1 { modal_close($&ed.modals) }
        if act == 2 { ed.submit_new_scene_modal(view) }
        ed.apply_pointer_cursor(view)
        repaint(view, ed.id_root)
        << true
    } else if ed.modals.kind == MODAL_GLOBALS {
        act := route_globals_modal_widgets($&ed.modals, input)
        if act != 0 {
            ed.handle_globals_modal_action(act, view)
        }
        ed.apply_pointer_cursor(view)
        repaint(view, ed.id_root)
        << true
    } else if ed.modals.kind == MODAL_SCENE_MANAGE {
        act := route_scene_manage_widgets($&ed.modals, input)
        if act != 0 {
            ed.handle_scene_manage_action(act, view)
        }
        ed.apply_pointer_cursor(view)
        repaint(view, ed.id_root)
        << true
    } else if ed.modals.kind == MODAL_EXPORT {
        act := route_export_widgets($&ed.modals, input)
        if act == 1 { modal_close($&ed.modals) }
        if act == 2 { ed.submit_export_modal(view) }
        ed.apply_pointer_cursor(view)
        repaint(view, ed.id_root)
        << true
    } else if ed.modals.kind == MODAL_UNSAVED {
        act := route_unsaved_modal_widgets($&ed.modals, input)
        target := ed.modals.unsaved_target_scene
        close_after := ed.modals.unsaved_close_after
        open_proj_after := ed.modals.unsaved_open_project_after
        if act == 1 {
            modal_close($&ed.modals)
        } else if act == 2 {
            modal_close($&ed.modals)
            if close_after { ed.close_pending = true }
            else if open_proj_after { ed.req_open_project = true }
            else { ed.switch_scene(target, false, view) }
        } else if act == 3 {
            if ed.do_save(view) {
                modal_close($&ed.modals)
                if close_after { ed.close_pending = true }
                else if open_proj_after { ed.req_open_project = true }
                else { ed.switch_scene(target, false, view) }
            }
        }
        ed.apply_pointer_cursor(view)
        repaint(view, ed.id_root)
        << true
    }
    << true
}

fn route_snap_modal_widgets(m $&ModalState, input &ui.InputEvent) int {
    if m.fields[MF_SNAP_MOVE].has_popup_open() { _ := route_modal_field($&m.fields[MF_SNAP_MOVE], input)
        << 0 }
    if m.fields[MF_SNAP_ROTATE].has_popup_open() { _ := route_modal_field($&m.fields[MF_SNAP_ROTATE], input)
        << 0 }
    if m.fields[MF_SNAP_SCALE].has_popup_open() { _ := route_modal_field($&m.fields[MF_SNAP_SCALE], input)
        << 0 }
    a1 := route_modal_field($&m.fields[MF_SNAP_MOVE], input)
    a2 := route_modal_field($&m.fields[MF_SNAP_ROTATE], input)
    a3 := route_modal_field($&m.fields[MF_SNAP_SCALE], input)
    a4 := input_btn($&m.buttons[MB_SNAP_CANCEL], input)
    a5 := input_btn($&m.buttons[MB_SNAP_SAVE], input)
    if a1.kind == widgets.ACTION_CHANGE && m.snap_move_err.len > 0 { m.snap_move_err = ""
        m.sync_snap_decorations() }
    if a2.kind == widgets.ACTION_CHANGE && m.snap_rotate_err.len > 0 { m.snap_rotate_err = ""
        m.sync_snap_decorations() }
    if a3.kind == widgets.ACTION_CHANGE && m.snap_scale_err.len > 0 { m.snap_scale_err = ""
        m.sync_snap_decorations() }
    if a1.request_focus { m.set_focus(ID_MODAL_MOVE) }
    else if a2.request_focus { m.set_focus(ID_MODAL_ROTATE) }
    else if a3.request_focus { m.set_focus(ID_MODAL_SCALE) }
    else if a4.request_focus { m.set_focus(ID_MODAL_SNAP_CANCEL) }
    else if a5.request_focus { m.set_focus(ID_MODAL_SNAP_SAVE) }
    if a4.kind == widgets.ACTION_ACTIVATE { << 1 }
    if a5.kind == widgets.ACTION_ACTIVATE { << 2 }
    << 0
}

fn route_scene_modal_widgets(m $&ModalState, input &ui.InputEvent) int {
    if m.fields[MF_SCENE_NAME].has_popup_open() { _ := route_modal_field($&m.fields[MF_SCENE_NAME], input)
        << 0 }
    if m.fields[MF_SCENE_ROOT].has_popup_open() { _ := route_modal_field($&m.fields[MF_SCENE_ROOT], input)
        << 0 }
    a1 := route_modal_field($&m.fields[MF_SCENE_NAME], input)
    a2 := route_modal_field($&m.fields[MF_SCENE_ROOT], input)
    a3 := input_btn($&m.buttons[MB_SCENE_CANCEL], input)
    a4 := input_btn($&m.buttons[MB_SCENE_CREATE], input)
    if a1.kind == widgets.ACTION_CHANGE && m.scene_err.len > 0 { m.scene_err = ""
        m.sync_scene_decoration() }
    if a1.request_focus { m.set_focus(ID_MODAL_SCENE_NAME) }
    else if a2.request_focus { m.set_focus(ID_MODAL_SCENE_ROOT) }
    else if a3.request_focus { m.set_focus(ID_MODAL_SCENE_CANCEL) }
    else if a4.request_focus { m.set_focus(ID_MODAL_SCENE_CREATE) }
    if a3.kind == widgets.ACTION_ACTIVATE { << 1 }
    if a4.kind == widgets.ACTION_ACTIVATE { << 2 }
    << 0
}

fn route_unsaved_modal_widgets(m $&ModalState, input &ui.InputEvent) int {
    a1 := input_btn($&m.buttons[MB_UNSAVED_CANCEL], input)
    a2 := input_btn($&m.buttons[MB_UNSAVED_DISCARD], input)
    a3 := input_btn($&m.buttons[MB_UNSAVED_SAVE], input)
    if a1.kind == widgets.ACTION_ACTIVATE { << 1 }
    if a2.kind == widgets.ACTION_ACTIVATE { << 2 }
    if a3.kind == widgets.ACTION_ACTIVATE { << 3 }
    << 0
}

fn route_globals_modal_widgets(m $&ModalState, input &ui.InputEvent) int {
    for i in MF_BUS_NAME:(MF_CONN_HND + 1) {
        if m.fields[i].has_popup_open() {
            _ := route_modal_field($&m.fields[i], input)
            << 0
        }
    }

    a1 := route_modal_field($&m.fields[MF_BUS_NAME], input)
    a2 := route_modal_field($&m.fields[MF_BUS_VOL], input)
    a3 := route_modal_field($&m.fields[MF_CONN_SRC], input)
    a4 := route_modal_field($&m.fields[MF_CONN_SIG], input)
    a5 := route_modal_field($&m.fields[MF_CONN_DST], input)
    a6 := route_modal_field($&m.fields[MF_CONN_HND], input)
    b1 := input_btn($&m.buttons[MB_BUS_ADD], input)
    b2 := input_btn($&m.buttons[MB_BUS_MUTE], input)
    b3 := input_btn($&m.buttons[MB_BUS_DEL], input)
    b4 := input_btn($&m.buttons[MB_CONN_ADD], input)
    b5 := input_btn($&m.buttons[MB_CONN_DEL], input)
    b6 := input_btn($&m.buttons[MB_GLOBALS_CLOSE], input)

    if (a1.kind == widgets.ACTION_CHANGE || a2.kind == widgets.ACTION_CHANGE ||
        a3.kind == widgets.ACTION_CHANGE || a4.kind == widgets.ACTION_CHANGE ||
        a5.kind == widgets.ACTION_CHANGE || a6.kind == widgets.ACTION_CHANGE) && m.globals_err.len > 0 {
        m.globals_err = ""
    }
    if a1.request_focus { m.set_focus(ID_MODAL_BUS_NAME) }
    else if a2.request_focus { m.set_focus(ID_MODAL_BUS_VOL) }
    else if a3.request_focus { m.set_focus(ID_MODAL_CONN_SRC) }
    else if a4.request_focus { m.set_focus(ID_MODAL_CONN_SIG) }
    else if a5.request_focus { m.set_focus(ID_MODAL_CONN_DST) }
    else if a6.request_focus { m.set_focus(ID_MODAL_CONN_HND) }
    else if b1.request_focus { m.set_focus(ID_MODAL_BUS_ADD) }
    else if b2.request_focus { m.set_focus(ID_MODAL_BUS_MUTE) }
    else if b3.request_focus { m.set_focus(ID_MODAL_BUS_DEL) }
    else if b4.request_focus { m.set_focus(ID_MODAL_CONN_ADD) }
    else if b5.request_focus { m.set_focus(ID_MODAL_CONN_DEL) }
    else if b6.request_focus { m.set_focus(ID_MODAL_GLOBALS_CLOSE) }

    if b6.kind == widgets.ACTION_ACTIVATE { << 1 }
    if b1.kind == widgets.ACTION_ACTIVATE { << 2 }
    if b2.kind == widgets.ACTION_ACTIVATE { << 3 }
    if b3.kind == widgets.ACTION_ACTIVATE { << 4 }
    if b4.kind == widgets.ACTION_ACTIVATE { << 5 }
    if b5.kind == widgets.ACTION_ACTIVATE { << 6 }
    << 0
}

fn draft_add_bus(ed $&Editor, parent int, name string, vol f64) int {
    d := $&ed.draft
    << d.add_audio_bus(parent, name, vol, false, false) >>>
}
fn draft_mute_bus(ed $&Editor, idx int) int {
    d := $&ed.draft
    << d.toggle_audio_bus_mute(idx) >>>
}
fn draft_del_bus(ed $&Editor, idx int) int {
    d := $&ed.draft
    << d.remove_audio_bus(idx) >>>
}
fn draft_add_conn(ed $&Editor, src int, sig int, dst int, hnd int) int {
    d := $&ed.draft
    << d.add_script_connection(src, sig, dst, hnd) >>>
}
fn draft_del_conn(ed $&Editor, idx int) int {
    d := $&ed.draft
    << d.remove_script_connection(idx) >>>
}

fn (ed $&Editor) set_globals_err(msg string, view $&widgets.View) {
    mods := $&ed.modals
    mods.globals_err = msg + ""
    ed.set_status(STATUS_ERR, msg, view)
}

fn (ed $&Editor) handle_globals_modal_action(act int, view $&widgets.View) {
    if act == 0 { << }
    if act == 1 {
        modal_close($&ed.modals)
        <<
    }
    if act == 2 {
        name := ed.modals.fields[MF_BUS_NAME].value()
        vol := parse_f64_or(&ed.modals.fields[MF_BUS_VOL].value(), "Bus Volume") >>> (err) {
            ed.set_globals_err(err.msg(), view)
            <<
        }
        _ := draft_add_bus(ed, 0, name, vol) >>> (err) {
            ed.set_globals_err(err.msg(), view)
            <<
        }
    } else if act == 3 {
        doc := ed.draft.document() >>> (err) {
            ed.set_globals_err(err.msg(), view)
            <<
        }
        cnt := doc.audio_bus_count()
        if cnt <= 0 {
            ed.set_globals_err("No audio buses in scene", view)
            <<
        }
        _ := draft_mute_bus(ed, cnt - 1) >>> (err) {
            ed.set_globals_err(err.msg(), view)
            <<
        }
    } else if act == 4 {
        doc := ed.draft.document() >>> (err) {
            ed.set_globals_err(err.msg(), view)
            <<
        }
        cnt := doc.audio_bus_count()
        if cnt <= 1 {
            ed.set_globals_err("No sub-bus to remove (Master bus kept)", view)
            <<
        }
        _ := draft_del_bus(ed, cnt - 1) >>> (err) {
            ed.set_globals_err(err.msg(), view)
            <<
        }
    } else if act == 5 {
        src_s := strings.trim_space(&ed.modals.fields[MF_CONN_SRC].value())
        sig_s := strings.trim_space(&ed.modals.fields[MF_CONN_SIG].value())
        dst_s := strings.trim_space(&ed.modals.fields[MF_CONN_DST].value())
        hnd_s := strings.trim_space(&ed.modals.fields[MF_CONN_HND].value())
        src := strconv.atoi(&src_s) >>> (err) {
            _ := err
            ed.set_globals_err("SrcIdx must be integer", view)
            <<
        }
        sig := strconv.atoi(&sig_s) >>> (err) {
            _ := err
            ed.set_globals_err("Signal must be integer", view)
            <<
        }
        dst := strconv.atoi(&dst_s) >>> (err) {
            _ := err
            ed.set_globals_err("DstIdx must be integer", view)
            <<
        }
        hnd := strconv.atoi(&hnd_s) >>> (err) {
            _ := err
            ed.set_globals_err("Handler must be integer", view)
            <<
        }
        _ := draft_add_conn(ed, src, sig, dst, hnd) >>> (err) {
            ed.set_globals_err(err.msg(), view)
            <<
        }
    } else if act == 6 {
        doc := ed.draft.document() >>> (err) {
            ed.set_globals_err(err.msg(), view)
            <<
        }
        cnt := doc.script_connection_count()
        if cnt <= 0 {
            ed.set_globals_err("No script route to remove", view)
            <<
        }
        _ := draft_del_conn(ed, cnt - 1) >>> (err) {
            ed.set_globals_err(err.msg(), view)
            <<
        }
    }
    ed.refresh_after_document_change(false, view)
    doc_after := ed.draft.document() >>> (err) { << }
    mods := $&ed.modals
    mods.globals_err = ""
    mods.sync_globals(&doc_after)
    ed.set_status(STATUS_OK, "Updated scene globals", view)
}

fn route_scene_manage_widgets(m $&ModalState, input &ui.InputEvent) int {
    if m.fields[MF_MGR_NAME].has_popup_open() {
        _ := route_modal_field($&m.fields[MF_MGR_NAME], input)
        << 0
    }
    a1 := route_modal_field($&m.fields[MF_MGR_NAME], input)
    b1 := input_btn($&m.buttons[MB_MGR_RENAME], input)
    b2 := input_btn($&m.buttons[MB_MGR_DUP], input)
    b3 := input_btn($&m.buttons[MB_MGR_DEL], input)
    b4 := input_btn($&m.buttons[MB_MGR_CLOSE], input)
    if a1.kind == widgets.ACTION_CHANGE && m.mgr_err.len > 0 {
        m.mgr_err = ""
        m.sync_mgr_decoration()
    }
    if a1.request_focus { m.set_focus(ID_MODAL_MGR_NAME) }
    else if b1.request_focus { m.set_focus(ID_MODAL_MGR_RENAME) }
    else if b2.request_focus { m.set_focus(ID_MODAL_MGR_DUP) }
    else if b3.request_focus { m.set_focus(ID_MODAL_MGR_DEL) }
    else if b4.request_focus { m.set_focus(ID_MODAL_MGR_CLOSE) }
    if b1.kind == widgets.ACTION_ACTIVATE { << 1 }
    if b2.kind == widgets.ACTION_ACTIVATE { << 2 }
    if b3.kind == widgets.ACTION_ACTIVATE { << 3 }
    if b4.kind == widgets.ACTION_ACTIVATE { << 4 }
    << 0
}

fn route_export_widgets(m $&ModalState, input &ui.InputEvent) int {
    if m.fields[MF_EXPORT_DIR].has_popup_open() {
        _ := route_modal_field($&m.fields[MF_EXPORT_DIR], input)
        << 0
    }
    a1 := route_modal_field($&m.fields[MF_EXPORT_DIR], input)
    b1 := input_btn($&m.buttons[MB_EXPORT_CANCEL], input)
    b2 := input_btn($&m.buttons[MB_EXPORT_RUN], input)
    if a1.kind == widgets.ACTION_CHANGE && m.export_err.len > 0 {
        m.export_err = ""
        m.sync_export_decoration()
    }
    if a1.request_focus { m.set_focus(ID_MODAL_EXPORT_DIR) }
    else if b1.request_focus { m.set_focus(ID_MODAL_EXPORT_CANCEL) }
    else if b2.request_focus { m.set_focus(ID_MODAL_EXPORT_RUN) }
    if b1.kind == widgets.ACTION_ACTIVATE { << 1 }
    if b2.kind == widgets.ACTION_ACTIVATE { << 2 }
    << 0
}

fn (ed $&Editor) set_mgr_err(msg string, view $&widgets.View) {
    mods := $&ed.modals
    mods.mgr_err = msg + ""
    mods.sync_mgr_decoration()
    ed.set_status(STATUS_ERR, msg, view)
}

fn (ed $&Editor) handle_scene_manage_action(act int, view $&widgets.View) {
    if act == 0 { << }
    if act == 4 {
        modal_close($&ed.modals)
        <<
    }
    if ed.scene_index < 0 || ed.scene_index >= ed.project.scenes.len { << }
    cur_key := ed.project.scenes[ed.scene_index].key + ""
    proj_path := ed.project.path + ""
    raw_name := ed.modals.fields[MF_MGR_NAME].value()
    if act == 1 {
        if ed.draft.dirty() {
            ed.set_mgr_err("Save scene changes before renaming", view)
            <<
        }
        new_key := rename_scene(&proj_path, &cur_key, &raw_name) >>> (err) {
            ed.set_mgr_err(err.msg(), view)
            <<
        }
        reloaded := load_project(proj_path) >>> (err) {
            ed.set_mgr_err(err.msg(), view)
            <<
        }
        ed.project = reloaded
        $next_idx := 0
        for i in 0:ed.project.scenes.len {
            if ed.project.scenes[i].key == new_key { next_idx = i }
        }
        new_path := ed.project.scene_source(next_idx) >>> (err) {
            ed.set_mgr_err(err.msg(), view)
            <<
        }
        next_draft := open_draft(new_path) >>> (err) {
            ed.set_mgr_err(err.msg(), view)
            <<
        }
        ed.scene_index = next_idx
        ed.draft = next_draft
        modal_close($&ed.modals)
        ed.refresh_project_selectors()
        ed.refresh_after_document_change(false, view)
        ed.set_status(STATUS_OK, "Renamed scene to " + new_key, view)
        <<
    }
    if act == 2 {
        dup_key := duplicate_scene(&proj_path, &cur_key, &raw_name) >>> (err) {
            ed.set_mgr_err(err.msg(), view)
            <<
        }
        reloaded := load_project(proj_path) >>> (err) {
            ed.set_mgr_err(err.msg(), view)
            <<
        }
        ed.project = reloaded
        modal_close($&ed.modals)
        ed.refresh_project_selectors()
        repaint(view, ed.id_toolbar)
        ed.set_status(STATUS_OK, "Duplicated scene as " + dup_key, view)
        <<
    }
    if act == 3 {
        if ed.project.scenes.len <= 1 {
            ed.set_mgr_err("Cannot delete the last scene", view)
            <<
        }
        _ := delete_scene(&proj_path, &cur_key) >>> (err) {
            ed.set_mgr_err(err.msg(), view)
            <<
        }
        reloaded := load_project(proj_path) >>> (err) {
            ed.set_mgr_err(err.msg(), view)
            <<
        }
        ed.project = reloaded
        modal_close($&ed.modals)
        ed.refresh_project_selectors()
        ed.scene_index = -1
        ed.switch_scene(0, false, view)
        ed.set_status(STATUS_OK, "Deleted scene " + cur_key, view)
        <<
    }
}

pub fn (ed $&Editor) submit_export_modal(view $&widgets.View) {
    out_dir := strings.trim_space(&ed.modals.fields[MF_EXPORT_DIR].value())
    if out_dir.len == 0 {
        mods := $&ed.modals
        mods.export_err = "Output directory is required"
        mods.sync_export_decoration()
        ed.set_status(STATUS_ERR, "Output directory is required", view)
        repaint(view, ed.id_root)
        <<
    }
    modal_close($&ed.modals)
    ed.export_target_dir = out_dir + ""
    ed.req_export_project = true
    repaint(view, ed.id_root)
}

fn copy_input(input &ui.InputEvent) ui.InputEvent {
    << ui.InputEvent{
        kind: input.kind, window_id: input.window_id, canvas_id: input.canvas_id, generation: input.generation,
        x: input.x, y: input.y, dx: input.dx, dy: input.dy,
        button: input.button, buttons: input.buttons, modifiers: input.modifiers,
        key: input.key, scan: input.scan, repeat: input.repeat, click_count: input.click_count, time_ns: input.time_ns
    }
}

fn route_modal_field(f $&widgets.Field, input &ui.InputEvent) widgets.Action {
    << f.input(input)
}

pub struct OpenSelectResult {
    pub handled bool
    pub changed bool
    pub value int
}

fn route_open_select(sel $&widgets.Select, origin &layout.Rect, input &ui.InputEvent) widgets.Action {
    $local := copy_input(input)
    if (input.kind >= ui.EV_POINTER_DOWN && input.kind <= ui.EV_POINTER_CANCEL) || input.kind == ui.EV_POINTER_SCROLL {
        local.x = input.x - origin.x
        local.y = input.y - origin.y
    }
    << sel.input(&local)
}

pub fn handle_open_select(sel $&widgets.Select, orig &layout.Rect, input &ui.InputEvent, rid int, view $&widgets.View) OpenSelectResult {
    if !sel.is_open() {
        << OpenSelectResult{handled: false, changed: false, value: -1}
    }
    if input.kind == ui.EV_KEY_DOWN && input.key == ui.KEY_ESCAPE {
        set_sel_open(sel, false)
        repaint(view, rid)
        << OpenSelectResult{handled: true, changed: false, value: sel.selected()}
    }
    o := copy_rect(orig)
    act := route_open_select(sel, &o, input)
    closed_by_outside := !sel.is_open() && !act.consumed
    if act.needs_paint || act.consumed || closed_by_outside {
        repaint(view, rid)
    }
    if act.kind == widgets.ACTION_CHANGE {
        << OpenSelectResult{handled: true, changed: true, value: int(act.value)}
    }
    if act.consumed || closed_by_outside || is_pointer_event_kind(input.kind) || input.kind == ui.EV_POINTER_SCROLL {
        << OpenSelectResult{handled: true, changed: false, value: sel.selected()}
    }
    << OpenSelectResult{handled: false, changed: false, value: sel.selected()}
}

fn is_pointer_event_kind(kind int) bool {
    << kind >= ui.EV_POINTER_DOWN && kind <= ui.EV_POINTER_CANCEL
}

fn node_contains(view &widgets.View, id int, x f64, y f64) bool {
    nb := view.node_bounds(id) >>> (err) {
        _ := err
        << false
    }
    << nb.contains(x, y)
}

fn node_contains_clipped(view &widgets.View, id int, clip_id int, x f64, y f64) bool {
    << node_contains(view, clip_id, x, y) && node_contains(view, id, x, y)
}

fn field_popup_cursor(f &widgets.Field, x f64, y f64) int {
    if !f.has_popup_open() { << -1 }
    << f.cursor_at(x, y)
}

fn text_popup_cursor(s &widgets.SelectableText, x f64, y f64) int {
    if !s.has_popup_open() { << -1 }
    << s.cursor_at(x, y)
}

fn field_hit_cursor(view &widgets.View, id int, f &widgets.Field, x f64, y f64) int {
    if !node_contains(view, id, x, y) { << -1 }
    << f.cursor_at(x, y)
}

fn field_hit_cursor_clipped(view &widgets.View, id int, clip_id int, f &widgets.Field, x f64, y f64) int {
    if !node_contains_clipped(view, id, clip_id, x, y) { << -1 }
    << f.cursor_at(x, y)
}

fn btn_hit_cursor(view &widgets.View, id int, b &widgets.Button, x f64, y f64) int {
    if !node_contains(view, id, x, y) { << -1 }
    << b.cursor()
}

fn btn_hit_cursor_clipped(view &widgets.View, id int, clip_id int, b &widgets.Button, x f64, y f64) int {
    if !node_contains_clipped(view, id, clip_id, x, y) { << -1 }
    << b.cursor()
}

fn sel_hit_cursor(view &widgets.View, id int, s &widgets.Select, x f64, y f64) int {
    if !node_contains(view, id, x, y) { << -1 }
    << s.cursor()
}

fn sel_hit_cursor_clipped(view &widgets.View, id int, clip_id int, s &widgets.Select, x f64, y f64) int {
    if !node_contains_clipped(view, id, clip_id, x, y) { << -1 }
    << s.cursor()
}

pub fn (ed &Editor) resolve_cursor(view &widgets.View, x f64, y f64) int {
    if ed.modals.kind != MODAL_NONE { << ed.modals.cursor_at(x, y) }
    if ed.scene_select.is_open() {
        << ed.scene_select.cursor_at(x - ed.scene_origin.x, y - ed.scene_origin.y)
    }
    if ed.asset_select.is_open() {
        << ed.asset_select.cursor_at(x - ed.asset_origin.x, y - ed.asset_origin.y)
    }
    if ed.add_node_select.is_open() {
        << ed.add_node_select.cursor_at(x - ed.add_node_origin.x, y - ed.add_node_origin.y)
    }
    if ed.add_comp_select.is_open() {
        << ed.add_comp_select.cursor_at(x - ed.add_comp_origin.x, y - ed.add_comp_origin.y)
    }
    if ed.parent_select.is_open() {
        << ed.parent_select.cursor_at(x - ed.parent_origin.x, y - ed.parent_origin.y)
    }
    if ed.process_select.is_open() {
        << ed.process_select.cursor_at(x - ed.process_origin.x, y - ed.process_origin.y)
    }
    if ed.surf_asset_select.is_open() {
        << ed.surf_asset_select.cursor_at(x - ed.surf_asset_origin.x, y - ed.surf_asset_origin.y)
    }
    if ed.lod_asset_select.is_open() {
        << ed.lod_asset_select.cursor_at(x - ed.lod_asset_origin.x, y - ed.lod_asset_origin.y)
    }
    if ed.tree.has_popup_open() {
        << ed.tree.cursor_at(x - ed.tree_origin.x, y - ed.tree_origin.y)
    }
    if ed.asset_list.has_popup_open() {
        << ed.asset_list.cursor_at(x - ed.asset_list_origin.x, y - ed.asset_list_origin.y)
    }
    pcs := [field_popup_cursor(&ed.name_field, x, y), field_popup_cursor(&ed.prim_field, x, y), field_popup_cursor(&ed.pos_x, x, y), field_popup_cursor(&ed.pos_y, x, y), field_popup_cursor(&ed.pos_z, x, y), field_popup_cursor(&ed.rot_x, x, y), field_popup_cursor(&ed.rot_y, x, y), field_popup_cursor(&ed.rot_z, x, y), field_popup_cursor(&ed.scale_x, x, y), field_popup_cursor(&ed.scale_y, x, y), field_popup_cursor(&ed.scale_z, x, y), field_popup_cursor(&ed.surf_prim_field, x, y), field_popup_cursor(&ed.lod_hyst_field, x, y), field_popup_cursor(&ed.lod_dist_field, x, y), field_popup_cursor(&ed.lod_prim_field, x, y), text_popup_cursor(&ed.asset_meta_txt, x, y), text_popup_cursor(&ed.insp_hdr_txt, x, y), text_popup_cursor(&ed.surf_info_txt, x, y), text_popup_cursor(&ed.lod_info_txt, x, y), text_popup_cursor(&ed.status_txt, x, y)]
    for pc in pcs {
        if pc >= 0 { << pc }
    }
    if comp_has_any_popup_open(&ed.comp) {
        ccur := comp_cursor(&ed.comp, view, &ed.styles, x, y)
        if ccur >= 0 { << ccur }
    }
    if panels_has_any_popup(&ed.panels) {
        pcur := panels_cursor(&ed.panels, view, x, y)
        if pcur >= 0 { << pcur }
    }
    if modeling_has_popup(&ed.modeling) {
        mcur := modeling_cursor(&ed.modeling, view, ed.id_insp_scroll, x, y)
        if mcur >= 0 { << mcur }
    }
    if ed.dragging_split != 0 || node_contains(view, ed.id_left_split, x, y) || node_contains(view, ed.id_right_split, x, y) {
        << ui.CURSOR_RESIZE_HORIZONTAL
    }
    if ed.tree_vis_drag_active {
        << ui.CURSOR_HAND
    }
    if ed.tree.is_scroll_dragging() || view.captured() == ed.id_tree {
        tcur := ed.tree.cursor_at(x - ed.tree_origin.x, y - ed.tree_origin.y)
        if tcur != ui.CURSOR_DEFAULT { << tcur }
    }
    if ed.asset_list.is_scroll_dragging() || view.captured() == ed.id_asset_list {
        acur := ed.asset_list.cursor_at(x - ed.asset_list_origin.x, y - ed.asset_list_origin.y)
        if acur != ui.CURSOR_DEFAULT { << acur }
    }
    if ed.insp_scroll.is_dragging() {
        << ui.CURSOR_HAND
    }
    if ed.scrub.active {
        << ui.CURSOR_RESIZE_HORIZONTAL
    }
    if ed.top_view.marquee_active { << ui.CURSOR_CROSSHAIR }
    if ed.top_view.panning || ed.top_view.dragging_nodes { << ui.CURSOR_HAND }
    p_cur := panels_cursor(&ed.panels, view, x, y)
    if p_cur >= 0 { << p_cur }
    if node_contains(view, ed.id_insp_scroll, x, y) {
        scb := view.node_bounds(ed.id_insp_scroll) >>> (err) { << ui.CURSOR_DEFAULT }
        sc_cur := ed.insp_scroll.cursor_at(x - scb.x, y - scb.y)
        if sc_cur != ui.CURSOR_DEFAULT { << sc_cur }
    }
    if ed.insp_tab == 0 && ed.insp_can_trs {
        lbl_ids := [ed.id_pos_lbl, ed.id_rot_lbl, ed.id_scale_lbl]
        for li in 0:3 {
            part := li + 1
            if !transform_part_is_default(ed, part) && node_contains_clipped(view, lbl_ids[li], ed.id_insp_scroll, x, y) {
                lb := view.node_bounds(lbl_ids[li]) >>> (err) { -> }
                if x >= lb.x + lb.width - 48.0 {
                    << ui.CURSOR_HAND
                }
            }
        }
    }
    scrub_ids := [
        ed.id_pos_x, ed.id_pos_y, ed.id_pos_z,
        ed.id_rot_x, ed.id_rot_y, ed.id_rot_z,
        ed.id_scale_x, ed.id_scale_y, ed.id_scale_z,
        ed.modeling.field_ids[MF_R], ed.modeling.field_ids[MF_G], ed.modeling.field_ids[MF_B],
        ed.modeling.field_ids[MF_METALLIC], ed.modeling.field_ids[MF_ROUGHNESS], ed.modeling.field_ids[MF_EMIT],
        ed.modeling.field_ids[MF_ALPHA], ed.modeling.field_ids[MF_COAT], ed.modeling.field_ids[MF_IOR]
    ]
    for si in 0:scrub_ids.len {
        sfid := scrub_ids[si]
        if sfid > 0 && ed.field_by_id_enabled(sfid) && node_contains_clipped(view, sfid, ed.id_insp_scroll, x, y) {
            sfb := view.node_bounds(sfid) >>> (err) { -> }
            if (y - sfb.y) <= 14.0 {
                << ui.CURSOR_RESIZE_HORIZONTAL
            }
        }
    }
    fcs := [field_hit_cursor(view, ed.id_prim_field, &ed.prim_field, x, y), field_hit_cursor(view, ed.id_name_field, &ed.name_field, x, y), field_hit_cursor_clipped(view, ed.id_pos_x, ed.id_insp_scroll, &ed.pos_x, x, y), field_hit_cursor_clipped(view, ed.id_pos_y, ed.id_insp_scroll, &ed.pos_y, x, y), field_hit_cursor_clipped(view, ed.id_pos_z, ed.id_insp_scroll, &ed.pos_z, x, y), field_hit_cursor_clipped(view, ed.id_rot_x, ed.id_insp_scroll, &ed.rot_x, x, y), field_hit_cursor_clipped(view, ed.id_rot_y, ed.id_insp_scroll, &ed.rot_y, x, y), field_hit_cursor_clipped(view, ed.id_rot_z, ed.id_insp_scroll, &ed.rot_z, x, y), field_hit_cursor_clipped(view, ed.id_scale_x, ed.id_insp_scroll, &ed.scale_x, x, y), field_hit_cursor_clipped(view, ed.id_scale_y, ed.id_insp_scroll, &ed.scale_y, x, y), field_hit_cursor_clipped(view, ed.id_scale_z, ed.id_insp_scroll, &ed.scale_z, x, y), field_hit_cursor_clipped(view, ed.id_surf_prim_field, ed.id_insp_scroll, &ed.surf_prim_field, x, y), field_hit_cursor_clipped(view, ed.id_lod_hyst_field, ed.id_insp_scroll, &ed.lod_hyst_field, x, y), field_hit_cursor_clipped(view, ed.id_lod_dist_field, ed.id_insp_scroll, &ed.lod_dist_field, x, y), field_hit_cursor_clipped(view, ed.id_lod_prim_field, ed.id_insp_scroll, &ed.lod_prim_field, x, y)]
    for fc in fcs {
        if fc >= 0 { << fc }
    }
    if node_contains(view, ed.id_asset_meta, x, y) { << ed.asset_meta_txt.cursor_at(x, y) }
    if node_contains(view, ed.id_insp_hdr, x, y) { << ed.insp_hdr_txt.cursor_at(x, y) }
    if node_contains_clipped(view, ed.id_surf_info, ed.id_insp_scroll, x, y) { << ed.surf_info_txt.cursor_at(x, y) }
    if node_contains_clipped(view, ed.id_lod_info, ed.id_insp_scroll, x, y) { << ed.lod_info_txt.cursor_at(x, y) }
    if node_contains(view, ed.id_status_txt, x, y) { << ed.status_txt.cursor_at(x, y) }
    if node_contains(view, ed.id_tree, x, y) { << ed.tree.cursor_at(x - ed.tree_origin.x, y - ed.tree_origin.y) }
    if node_contains(view, ed.id_asset_list, x, y) { << ed.asset_list.cursor_at(x - ed.asset_list_origin.x, y - ed.asset_list_origin.y) }
    if node_contains(view, ed.id_top_view, x, y) {
        if ed.stage_mode == STAGE_MODE_3D || ed.stage_mode == STAGE_MODE_SPLIT {
            if ed.vp3d.dragging_orbit || ed.vp3d.dragging_pan || ed.vp3d.gizmo_drag_axis > 0 ||
               ed.vp3d.gizmo_hover_axis > 0 || ed.vp3d.gizmo_triad_hover > 0 {
                << ui.CURSOR_HAND
            }
            << ui.CURSOR_DEFAULT
        }
        if ed.stage_mode == STAGE_MODE_TILEMAP {
            if ed.tilemap.panning { << ui.CURSOR_HAND }
            if ed.tilemap.placing_exit { << ui.CURSOR_CROSSHAIR }
            << ui.CURSOR_DEFAULT
        }
        if ed.placing_mode || ed.top_view.marquee_active { << ui.CURSOR_CROSSHAIR }
        if ed.top_view.panning || ed.top_view.dragging_nodes || ed.top_view.hover_node >= 0 { << ui.CURSOR_HAND }
        << ui.CURSOR_DEFAULT
    }
    mbar_cur := modeling_cursor(&ed.modeling, view, ed.id_insp_scroll, x, y)
    if mbar_cur >= 0 { << mbar_cur }
    tcs := [tabs_hit_cursor(view, ed.id_stage_tabs, &ed.stage_tabs, x, y), tabs_hit_cursor(view, ed.id_left_tabs, &ed.left_tabs, x, y), tabs_hit_cursor(view, ed.id_insp_tabs, &ed.insp_tabs, x, y)]
    for tc in tcs {
        if tc >= 0 { << tc }
    }
    ccs := [sel_hit_cursor(view, ed.id_scene_select, &ed.scene_select, x, y), sel_hit_cursor(view, ed.id_asset_select, &ed.asset_select, x, y), sel_hit_cursor(view, ed.id_add_node_select, &ed.add_node_select, x, y), sel_hit_cursor_clipped(view, ed.id_add_comp_select, ed.id_insp_scroll, &ed.add_comp_select, x, y), sel_hit_cursor_clipped(view, ed.id_parent_select, ed.id_insp_scroll, &ed.parent_select, x, y), sel_hit_cursor_clipped(view, ed.id_process_select, ed.id_insp_scroll, &ed.process_select, x, y), sel_hit_cursor_clipped(view, ed.id_surf_asset_select, ed.id_insp_scroll, &ed.surf_asset_select, x, y), sel_hit_cursor_clipped(view, ed.id_lod_asset_select, ed.id_insp_scroll, &ed.lod_asset_select, x, y), btn_hit_cursor(view, ed.id_new_scene_btn, &ed.new_scene_btn, x, y), btn_hit_cursor(view, ed.id_globals_btn, &ed.globals_btn, x, y), btn_hit_cursor(view, ed.id_undo_btn, &ed.undo_btn, x, y), btn_hit_cursor(view, ed.id_redo_btn, &ed.redo_btn, x, y), btn_hit_cursor(view, ed.id_save_btn, &ed.save_btn, x, y), btn_hit_cursor(view, ed.id_preview_btn, &ed.preview_btn, x, y), btn_hit_cursor(view, ed.id_dup_btn, &ed.dup_btn, x, y), btn_hit_cursor(view, ed.id_del_btn, &ed.del_btn, x, y), btn_hit_cursor(view, ed.id_import_btn, &ed.import_btn, x, y), btn_hit_cursor(view, ed.id_place_btn, &ed.place_btn, x, y), btn_hit_cursor(view, ed.id_stage_axis_btn, &ed.stage_axis_btn, x, y), btn_hit_cursor(view, ed.id_stage_snap_btn, &ed.stage_snap_btn, x, y), btn_hit_cursor(view, ed.id_fit_btn, &ed.fit_btn, x, y), btn_hit_cursor(view, ed.id_snap_btn, &ed.snap_btn, x, y), btn_hit_cursor_clipped(view, ed.id_reparent_btn, ed.id_insp_scroll, &ed.reparent_btn, x, y), btn_hit_cursor_clipped(view, ed.id_surf_bind_btn, ed.id_insp_scroll, &ed.surf_bind_btn, x, y), btn_hit_cursor_clipped(view, ed.id_surf_clear_btn, ed.id_insp_scroll, &ed.surf_clear_btn, x, y), btn_hit_cursor_clipped(view, ed.id_lod_add_btn, ed.id_insp_scroll, &ed.lod_add_btn, x, y), btn_hit_cursor_clipped(view, ed.id_lod_pop_btn, ed.id_insp_scroll, &ed.lod_pop_btn, x, y), btn_hit_cursor(view, ed.id_apply_btn, &ed.apply_btn, x, y)]
    for cc in ccs {
        if cc >= 0 { << cc }
    }
    if node_contains(view, ed.id_visible_chk, x, y) {
        << ed.visible_chk.cursor()
    }
    if node_contains(view, ed.id_insp_scroll, x, y) {
        ccur := comp_cursor(&ed.comp, view, &ed.styles, x, y)
        if ccur >= 0 { << ccur }
    }
    << ui.CURSOR_DEFAULT
}

fn (ed $&Editor) apply_pointer_cursor(view $&widgets.View) {
    $cur := ui.CURSOR_DEFAULT
    if ed.pointer_inside { cur = ed.resolve_cursor(view, ed.last_px, ed.last_py) }
    _ := view.set_pointer_cursor(cur) >>> (err) {
        _ := err
        <<
    }
}

fn route_popup_field(view $&widgets.View, root_id int, input &ui.InputEvent, f $&widgets.Field) bool {
    if !f.has_popup_open() { << false }
    id := f.id()
    act := field_input(f, input)
    if act.needs_paint { repaint(view, id) }
    repaint(view, root_id)
    << act.consumed || (input.kind == ui.EV_KEY_DOWN && input.key == ui.KEY_ESCAPE)
}

fn route_popup_text(view $&widgets.View, root_id int, input &ui.InputEvent, s $&widgets.SelectableText) bool {
    if !s.has_popup_open() { << false }
    id := s.id()
    act := text_input(s, input)
    if act.needs_paint { repaint(view, id) }
    repaint(view, root_id)
    << act.consumed || (input.kind == ui.EV_KEY_DOWN && input.key == ui.KEY_ESCAPE)
}

fn (ed $&Editor) route_open_context_menus(input &ui.InputEvent, view $&widgets.View) bool {
    rid := ed.id_root
    if ed.tree.has_popup_open() {
        $local := copy_input(input)
        if is_pointer_event_kind(input.kind) || input.kind == ui.EV_POINTER_SCROLL {
            local.x = input.x - ed.tree_origin.x
            local.y = input.y - ed.tree_origin.y
        }
        tr := $&ed.tree
        act := tr.input(&local)
        if act.needs_paint { repaint(view, ed.id_tree) }
        repaint(view, rid)
        if act.consumed || (input.kind == ui.EV_KEY_DOWN && input.key == ui.KEY_ESCAPE) { << true }
    }
    if ed.asset_list.has_popup_open() {
        $local := copy_input(input)
        if is_pointer_event_kind(input.kind) || input.kind == ui.EV_POINTER_SCROLL {
            local.x = input.x - ed.asset_list_origin.x
            local.y = input.y - ed.asset_list_origin.y
        }
        al := $&ed.asset_list
        act := al.input(&local)
        if act.needs_paint { repaint(view, ed.id_asset_list) }
        repaint(view, rid)
        if act.consumed || (input.kind == ui.EV_KEY_DOWN && input.key == ui.KEY_ESCAPE) { << true }
    }
    if ed.name_field.has_popup_open() {
        act := field_input($&ed.name_field, input)
        if act.kind == widgets.ACTION_CHANGE || act.kind == widgets.ACTION_COMMIT {
            val := ed.name_field.value()
            ed.name_error = ""
            ed.refresh_name_decoration(&val)
            repaint(view, ed.id_right_pane)
        }
        repaint(view, rid)
        if act.consumed || (input.kind == ui.EV_KEY_DOWN && input.key == ui.KEY_ESCAPE) { << true }
    }
    if route_popup_field(view, rid, input, $&ed.prim_field) { << true }
    if route_popup_field(view, rid, input, $&ed.pos_x) { << true }
    if route_popup_field(view, rid, input, $&ed.pos_y) { << true }
    if route_popup_field(view, rid, input, $&ed.pos_z) { << true }
    if route_popup_field(view, rid, input, $&ed.rot_x) { << true }
    if route_popup_field(view, rid, input, $&ed.rot_y) { << true }
    if route_popup_field(view, rid, input, $&ed.rot_z) { << true }
    if route_popup_field(view, rid, input, $&ed.scale_x) { << true }
    if route_popup_field(view, rid, input, $&ed.scale_y) { << true }
    if route_popup_field(view, rid, input, $&ed.scale_z) { << true }
    if route_popup_field(view, rid, input, $&ed.surf_prim_field) { << true }
    if route_popup_field(view, rid, input, $&ed.lod_hyst_field) { << true }
    if route_popup_field(view, rid, input, $&ed.lod_dist_field) { << true }
    if route_popup_field(view, rid, input, $&ed.lod_prim_field) { << true }
    if route_popup_text(view, rid, input, $&ed.asset_meta_txt) { << true }
    if route_popup_text(view, rid, input, $&ed.insp_hdr_txt) { << true }
    if route_popup_text(view, rid, input, $&ed.surf_info_txt) { << true }
    if route_popup_text(view, rid, input, $&ed.lod_info_txt) { << true }
    if route_popup_text(view, rid, input, $&ed.status_txt) { << true }
    if panels_route_context_popups($&ed.panels, view, rid, input) { << true }
    if modeling_route_popups($&ed.modeling, view, rid, input) { << true }
    if comp_route_context_popups($&ed.comp, view, rid, input) { << true }
    << false
}

fn dispatch_field_text_event(view $&widgets.View, root_id int, event &ui.Event, f $&widgets.Field) bool {
    id := f.id()
    act := field_event(f, event)
    if act.needs_paint || act.kind == widgets.ACTION_CHANGE {
        repaint(view, id)
        if f.has_popup_open() { repaint(view, root_id) }
        << true
    }
    << false
}

fn dispatch_sel_text_event(view $&widgets.View, event &ui.Event, s $&widgets.SelectableText) bool {
    id := s.id()
    act := text_event(s, event)
    if act.needs_paint {
        repaint(view, id)
        << true
    }
    << false
}

fn (ed $&Editor) dispatch_text_or_request(event &ui.Event, view $&widgets.View) bool {
    is_text_or_req := (event.kind >= ui.EV_TEXT_COMMIT && event.kind <= ui.EV_TEXT_SURROUNDING_DELETE) || event.kind == ui.EV_REQUEST
    if !is_text_or_req { << false }
    rid := ed.id_root
    if ed.modals.kind != MODAL_NONE {
        mods := $&ed.modals
        if mods.handle_text_or_request(event) {
            repaint(view, rid)
        }
        << true
    }
    a_nm := field_event($&ed.name_field, event)
    if a_nm.kind == widgets.ACTION_CHANGE || a_nm.kind == widgets.ACTION_COMMIT {
        val := ed.name_field.value()
        ed.name_error = ""
        ed.refresh_name_decoration(&val)
        repaint(view, ed.id_right_pane)
    } else if a_nm.needs_paint {
        repaint(view, ed.id_name_field)
    }
    _ := dispatch_field_text_event(view, rid, event, $&ed.prim_field)
    _ := dispatch_field_text_event(view, rid, event, $&ed.pos_x)
    _ := dispatch_field_text_event(view, rid, event, $&ed.pos_y)
    _ := dispatch_field_text_event(view, rid, event, $&ed.pos_z)
    _ := dispatch_field_text_event(view, rid, event, $&ed.rot_x)
    _ := dispatch_field_text_event(view, rid, event, $&ed.rot_y)
    _ := dispatch_field_text_event(view, rid, event, $&ed.rot_z)
    _ := dispatch_field_text_event(view, rid, event, $&ed.scale_x)
    _ := dispatch_field_text_event(view, rid, event, $&ed.scale_y)
    _ := dispatch_field_text_event(view, rid, event, $&ed.scale_z)
    _ := dispatch_field_text_event(view, rid, event, $&ed.surf_prim_field)
    _ := dispatch_field_text_event(view, rid, event, $&ed.lod_hyst_field)
    _ := dispatch_field_text_event(view, rid, event, $&ed.lod_dist_field)
    _ := dispatch_field_text_event(view, rid, event, $&ed.lod_prim_field)
    _ := dispatch_sel_text_event(view, event, $&ed.asset_meta_txt)
    _ := dispatch_sel_text_event(view, event, $&ed.insp_hdr_txt)
    _ := dispatch_sel_text_event(view, event, $&ed.surf_info_txt)
    _ := dispatch_sel_text_event(view, event, $&ed.lod_info_txt)
    _ := dispatch_sel_text_event(view, event, $&ed.status_txt)
    filter_changed := panels_dispatch_text_or_request($&ed.panels, view, rid, event)
    if filter_changed {
        doc := ed.draft.document() >>> (err) { << true }
        ed.rebuild_tree(&doc)
        repaint(view, ed.id_left_pane)
    }
    comp_dispatch_text_or_request($&ed.comp, view, rid, event)
    modeling_dispatch_events($&ed.modeling, view, rid, event)
    << true
}

fn is_inspector_submit_id(ed &Editor, id int) bool {
    << id == ed.id_name_field ||
        id == ed.id_pos_x || id == ed.id_pos_y || id == ed.id_pos_z ||
        id == ed.id_rot_x || id == ed.id_rot_y || id == ed.id_rot_z ||
        id == ed.id_scale_x || id == ed.id_scale_y || id == ed.id_scale_z
}

fn (ed &Editor) any_popup_or_select_open() bool {
    << ed.scene_select.is_open() || ed.asset_select.is_open() ||
        ed.add_node_select.is_open() || ed.add_comp_select.is_open() ||
        ed.parent_select.is_open() || ed.process_select.is_open() ||
        ed.surf_asset_select.is_open() || ed.lod_asset_select.is_open() ||
        ed.tree.has_popup_open() || ed.asset_list.has_popup_open() ||
        ed.name_field.has_popup_open() || ed.prim_field.has_popup_open() ||
        ed.asset_meta_txt.has_popup_open() || ed.insp_hdr_txt.has_popup_open() ||
        ed.surf_info_txt.has_popup_open() || ed.lod_info_txt.has_popup_open() || ed.status_txt.has_popup_open() ||
        ed.pos_x.has_popup_open() || ed.pos_y.has_popup_open() || ed.pos_z.has_popup_open() ||
        ed.rot_x.has_popup_open() || ed.rot_y.has_popup_open() || ed.rot_z.has_popup_open() ||
        ed.scale_x.has_popup_open() || ed.scale_y.has_popup_open() || ed.scale_z.has_popup_open() ||
        ed.surf_prim_field.has_popup_open() || ed.lod_hyst_field.has_popup_open() ||
        ed.lod_dist_field.has_popup_open() || ed.lod_prim_field.has_popup_open() ||
        comp_has_any_popup_open(&ed.comp) || panels_has_any_popup(&ed.panels) ||
        modeling_has_popup(&ed.modeling)
}

fn stage_axis_icon(ed &Editor) int {
    if ed.stage_mode == STAGE_MODE_3D || ed.stage_mode == STAGE_MODE_TILEMAP {
        << ICON_GRID_VIEW
    }
    if ed.stage_mode == STAGE_MODE_SPLIT {
        if ed.vp3d.ortho_axis == ORTHO_FRONT { << ICON_VIEW_FRONT }
        if ed.vp3d.ortho_axis == ORTHO_RIGHT { << ICON_VIEW_RIGHT }
        << ICON_VIEW_TOP
    }
    if ed.top_view.axis_mode == STAGE_XY { << ICON_VIEW_FRONT }
    << ICON_VIEW_TOP
}

fn check_tip(view &widgets.View, id int, x f64, y f64, label string) TooltipHit {
    if id <= 0 { << empty_tooltip_hit() }
    nb := view.node_bounds(id) >>> (err) {
        _ := err
        << empty_tooltip_hit()
    }
    if !nb.contains(x, y) { << empty_tooltip_hit() }
    << TooltipHit{id: id, text: label + "", anchor: copy_rect(&nb)}
}

pub fn resolve_tooltip_hit(ed &Editor, view &widgets.View, x f64, y f64) TooltipHit {
    lang := ed.lang
    $h := check_tip(view, ed.panels.id_open_proj_btn, x, y, tr(lang, "Open Project (project.json)", "打开工程 (project.json)"))
    if h.id > 0 { << h }
    h = check_tip(view, ed.id_scene_select, x, y, tr(lang, "Switch Active Scene", "切换当前场景"))
    if h.id > 0 { << h }
    h = check_tip(view, ed.id_new_scene_btn, x, y, tr(lang, "New Scene", "新建场景"))
    if h.id > 0 { << h }
    h = check_tip(view, ed.panels.id_scene_mgr_btn, x, y, tr(lang, "Manage Scene (Rename / Duplicate / Delete)", "管理场景（重命名 / 复制 / 删除）"))
    if h.id > 0 { << h }
    h = check_tip(view, ed.id_globals_btn, x, y, tr(lang, "Scene Globals (Audio Buses & Script Routes)", "场景全局设置（音频总线与脚本路由）"))
    if h.id > 0 { << h }
    h = check_tip(view, ed.id_undo_btn, x, y, tr(lang, "Undo (Cmd+Z)", "撤销 (Cmd+Z)"))
    if h.id > 0 { << h }
    h = check_tip(view, ed.id_redo_btn, x, y, tr(lang, "Redo (Cmd+Shift+Z)", "重做 (Cmd+Shift+Z)"))
    if h.id > 0 { << h }
    $save_lbl := tr(lang, "Save Scene (Cmd+S)", "保存场景 (Cmd+S)")
    if ed.draft.dirty() { save_lbl = tr(lang, "Save Scene (Cmd+S) — Unsaved changes", "保存场景 (Cmd+S) — 有未保存更改") }
    h = check_tip(view, ed.id_save_btn, x, y, save_lbl)
    if h.id > 0 { << h }
    h = check_tip(view, ed.id_preview_btn, x, y, tr(lang, "Run Live Preview", "运行实时预览"))
    if h.id > 0 { << h }
    h = check_tip(view, ed.panels.id_export_btn, x, y, tr(lang, "Export / Publish Build", "导出 / 发布构建"))
    if h.id > 0 { << h }
    h = check_tip(view, ed.panels.id_lang_btn, x, y, tr(lang, "Switch to Chinese (中文)", "切换到英文 (English)"))
    if h.id > 0 { << h }
    $dirty_lbl := tr(lang, "All changes saved", "所有更改已保存")
    if ed.draft.dirty() { dirty_lbl = tr(lang, "Unsaved edits in current scene (Cmd+S to save)", "当前场景存在未保存更改（Cmd+S 保存）") }
    h = check_tip(view, ed.id_dirty_badge, x, y, dirty_lbl)
    if h.id > 0 { << h }

    h = check_tip(view, ed.id_stage_tabs, x, y, tr(lang, "Switch Stage Viewport (3D / Split / 2D / TileMap)", "切换舞台工作视口（3D / 分屏 / 2D / 瓦片）"))
    if h.id > 0 { << h }
    h = check_tip(view, ed.id_left_tabs, x, y, tr(lang, "Switch Scene Hierarchy / Project Assets", "切换场景大纲 / 工程资源列表"))
    if h.id > 0 { << h }
    h = check_tip(view, ed.id_insp_tabs, x, y, tr(lang, "Switch Inspector Tab (Transform / Material / Components)", "切换属性检查器分页（变换 / 材质 / 组件）"))
    if h.id > 0 { << h }
    h = check_tip(view, ed.panels.id_node_up_btn, x, y, tr(lang, "Move Node Up", "上移节点"))
    if h.id > 0 { << h }
    h = check_tip(view, ed.panels.id_node_dn_btn, x, y, tr(lang, "Move Node Down", "下移节点"))
    if h.id > 0 { << h }
    if !ed.tree_vis_drag_active && node_contains(view, ed.id_tree, x, y) {
        tb := view.node_bounds(ed.id_tree) >>> (err) {
            _ := err
            << empty_tooltip_hit()
        }
        lx := x - tb.x
        ly := y - tb.y
        vrow := ed.tree_hit_row(lx, ly)
        tid := ed.tree_hit_vis_tid(lx, ly)
        if vrow >= 0 && tid >= 0 && ed.tree_to_scene.has(tid) {
            sid := ed.tree_to_scene[tid]
            vis := ed.node_vis_cache.get_or(sid, true)
            name := ed.tree.text(tid) >>> (err) {
                _ := err
                << empty_tooltip_hit()
            }
            ab := ed.tree.action_bounds(vrow)
            anchor := layout.Rect{x: tb.x + ab.x, y: tb.y + ab.y, width: ab.width, height: ab.height}
            $tip_lbl := tr(lang, "Show " + name + " (drag to paint)", "显示 " + name + "（按住上下拖动批量设置）")
            if vis { tip_lbl = tr(lang, "Hide " + name + " (drag to paint)", "隐藏 " + name + "（按住上下拖动批量设置）") }
            << TooltipHit{id: ed.id_tree * 1000 + tid + 1, text: tip_lbl, anchor: anchor}
        }
    }
    h = check_tip(view, ed.id_add_node_select, x, y, tr(lang, "Add Node (3D / 2D / Group / Camera / Light)", "新建节点（3D / 2D / 组 / 相机 / 光源）"))
    if h.id > 0 { << h }
    h = check_tip(view, ed.id_dup_btn, x, y, tr(lang, "Duplicate Selected Node (Cmd+D)", "复制选中节点 (Cmd+D)"))
    if h.id > 0 { << h }
    h = check_tip(view, ed.id_del_btn, x, y, tr(lang, "Delete Selected Node (Del)", "删除选中节点 (Del)"))
    if h.id > 0 { << h }
    h = check_tip(view, ed.id_add_comp_select, x, y, tr(lang, "Attach Component or Reveal Section", "添加组件或展开对应设置卡片"))
    if h.id > 0 { << h }

    h = check_tip(view, ed.id_import_btn, x, y, tr(lang, "Import Asset (.glb / .png / .wav / .xubc)", "导入资源 (.glb / .png / .wav / .xubc)"))
    if h.id > 0 { << h }
    h = check_tip(view, ed.panels.id_relocate_btn, x, y, tr(lang, "Relocate Selected Asset", "重定位选中资源"))
    if h.id > 0 { << h }
    h = check_tip(view, ed.panels.id_remove_asset_btn, x, y, tr(lang, "Remove Asset from Project", "从工程中移除资源"))
    if h.id > 0 { << h }
    $place_lbl := tr(lang, "Place Selected GLB in Stage", "在舞台放置所选 GLB")
    if ed.placing_mode { place_lbl = tr(lang, "Cancel GLB Placement (Esc)", "取消放置 GLB (Esc)") }
    h = check_tip(view, ed.id_place_btn, x, y, place_lbl)
    if h.id > 0 { << h }

    $axis_lbl := tr(lang, "Switch to Front View (XY)", "切换到正视图 (XY)")
    if ed.stage_mode == STAGE_MODE_3D {
        if ed.vp3d.show_grid {
            axis_lbl = tr(lang, "Hide 3D Floor Grid (G)", "隐藏 3D 地面网格 (G)")
        } else {
            axis_lbl = tr(lang, "Show 3D Floor Grid (G)", "显示 3D 地面网格 (G)")
        }
    } else if ed.stage_mode == STAGE_MODE_SPLIT {
        if ed.vp3d.ortho_axis == ORTHO_FRONT {
            axis_lbl = tr(lang, "Ortho View: Front (click for Right)", "正交视口：前视图（点击切右视图）")
        } else if ed.vp3d.ortho_axis == ORTHO_RIGHT {
            axis_lbl = tr(lang, "Ortho View: Right (click for Top)", "正交视口：右视图（点击切顶视图）")
        } else {
            axis_lbl = tr(lang, "Ortho View: Top (click for Front)", "正交视口：顶视图（点击切前视图）")
        }
    } else if ed.stage_mode == STAGE_MODE_TILEMAP {
        if ed.tilemap.show_grid {
            axis_lbl = tr(lang, "Hide TileMap Grid", "隐藏瓦片地图网格")
        } else {
            axis_lbl = tr(lang, "Show TileMap Grid", "显示瓦片地图网格")
        }
    } else if ed.top_view.axis_mode == STAGE_XY {
        axis_lbl = tr(lang, "Switch to Top View (XZ)", "切换到俯视图 (XZ)")
    }
    h = check_tip(view, ed.id_stage_axis_btn, x, y, axis_lbl)
    if h.id > 0 { << h }
    $snap_lbl := tr(lang, "Enable Stage Grid Snap", "启用舞台网格吸附")
    if ed.top_snap_enabled { snap_lbl = tr(lang, "Disable Stage Grid Snap (step ", "关闭舞台网格吸附（步长 ") + fmt_coord(ed.snap.move_step) + tr(lang, " u)", " 单位）") }
    h = check_tip(view, ed.id_stage_snap_btn, x, y, snap_lbl)
    if h.id > 0 { << h }
    h = check_tip(view, ed.id_fit_btn, x, y, tr(lang, "Focus Selection / Fit All Nodes (F / Shift+F)", "聚焦选中或适配全部节点 (F / Shift+F)"))
    if h.id > 0 { << h }
    h = check_tip(view, ed.id_snap_btn, x, y, tr(lang, "Configure Snap Settings...", "配置吸附设置..."))
    if h.id > 0 { << h }
    hm := modeling_tooltip(&ed.modeling, view, x, y, lang)
    if hm.id > 0 { << hm }
    if ed.stage_mode == STAGE_MODE_TILEMAP {
        htm := tilemap_tooltip(&ed.tilemap, view, ed.id_top_view, x, y, lang)
        if htm.id > 0 { << htm }
    }

    h = check_tip(view, ed.id_reparent_btn, x, y, tr(lang, "Move Selected Node Under Chosen Parent", "将当前节点移动到所选父节点下"))
    if h.id > 0 { << h }
    h = check_tip(view, ed.id_surf_bind_btn, x, y, tr(lang, "Bind Selected GLB Primitive to Node", "将所选 GLB 图元绑定到当前节点"))
    if h.id > 0 { << h }
    h = check_tip(view, ed.id_surf_clear_btn, x, y, tr(lang, "Remove GLB Surface Binding", "移除当前节点的 GLB 表面绑定"))
    if h.id > 0 { << h }
    h = check_tip(view, ed.id_lod_add_btn, x, y, tr(lang, "Append LOD Level to Surface", "向表面追加一级 LOD"))
    if h.id > 0 { << h }
    h = check_tip(view, ed.id_lod_pop_btn, x, y, tr(lang, "Remove Last LOD Level", "移除最后一级 LOD"))
    if h.id > 0 { << h }
    h = check_tip(view, ed.id_apply_btn, x, y, tr(lang, "Apply Transform, Name & Visibility Changes", "应用变换、名称与可见性更改"))
    if h.id > 0 { << h }
    if ed.insp_tab == 0 && ed.insp_can_trs {
        if !transform_part_is_default(ed, 1) && node_contains_clipped(view, ed.id_pos_lbl, ed.id_insp_scroll, x, y) {
            pb := view.node_bounds(ed.id_pos_lbl) >>> (err) { << empty_tooltip_hit() }
            if x >= pb.x + pb.width - 48.0 {
                << check_tip(view, ed.id_pos_lbl, x, y, tr(lang, "Reset Position to (0, 0, 0)", "重置位置为 (0, 0, 0)"))
            }
        }
        if !transform_part_is_default(ed, 2) && node_contains_clipped(view, ed.id_rot_lbl, ed.id_insp_scroll, x, y) {
            rb := view.node_bounds(ed.id_rot_lbl) >>> (err) { << empty_tooltip_hit() }
            if x >= rb.x + rb.width - 48.0 {
                << check_tip(view, ed.id_rot_lbl, x, y, tr(lang, "Reset Rotation to (0, 0, 0)", "重置旋转为 (0, 0, 0)"))
            }
        }
        if !transform_part_is_default(ed, 3) && node_contains_clipped(view, ed.id_scale_lbl, ed.id_insp_scroll, x, y) {
            sb := view.node_bounds(ed.id_scale_lbl) >>> (err) { << empty_tooltip_hit() }
            if x >= sb.x + sb.width - 48.0 {
                << check_tip(view, ed.id_scale_lbl, x, y, tr(lang, "Reset Scale to (1, 1, 1)", "重置缩放为 (1, 1, 1)"))
            }
        }
    }
    << empty_tooltip_hit()
}

pub fn (ed $&Editor) handle_ui_event(event &ui.Event, view $&widgets.View) int {
    if event.kind == ui.EV_CANVAS_METRICS {
        tip := $&ed.tooltip
        if tip.dismiss() { repaint(view, ed.id_root) }
        ed.sync_layout(view, f64(event.width), f64(event.height)) >>>
        << 0
    }
    if ed.dispatch_text_or_request(event, view) {
        << 0
    }
    if ui.is_input_event(event.kind) {
        input := ui.input_of(event) >>>
        if input.generation != ed.identity.generation { << 0 }
        << ed.handle_input_event(&input, view)
    }
    if event.kind == ui.EV_CLOSED || event.kind == ui.EV_CANVAS_CLOSED {
        _ := widgets.dispatch_event(view, event, ed) >>>
    }
    ed.apply_pointer_cursor(view)
    << 0
}

pub fn (ed $&Editor) handle_input_event(input &ui.InputEvent, view $&widgets.View) int {
    if input.generation != ed.identity.generation { << 0 }
    if is_pointer_event_kind(input.kind) {
            if input.kind == ui.EV_POINTER_LEAVE {
                ed.pointer_inside = false
                tip := $&ed.tooltip
                if tip.dismiss() { repaint(view, ed.id_root) }
            } else {
                ed.last_px = input.x
                ed.last_py = input.y
                ed.pointer_inside = true
            }
        }
        if input.kind == ui.EV_POINTER_DOWN || input.kind == ui.EV_POINTER_SCROLL ||
           input.kind == ui.EV_POINTER_CANCEL || input.kind == ui.EV_KEY_DOWN {
            tip := $&ed.tooltip
            if tip.dismiss() { repaint(view, ed.id_root) }
        }

        if ed.handle_modal_input(input, view) {
            << 0
        }

        // Open select popups capture pointer & Escape before underlying nodes.
        rid_s := ed.id_root
        if ed.scene_select.is_open() {
            orig := copy_rect(&ed.scene_origin)
            res := handle_open_select($&ed.scene_select, &orig, input, rid_s, view)
            if res.handled {
                if res.changed {
                    ed.switch_scene(res.value, true, view)
                }
                ed.apply_pointer_cursor(view)
                << 0
            }
        }
        if ed.asset_select.is_open() {
            orig := copy_rect(&ed.asset_origin)
            res := handle_open_select($&ed.asset_select, &orig, input, rid_s, view)
            if res.handled {
                if res.changed {
                    ed.select_asset_index(res.value)
                    ed.sync_asset_meta_text()
                    ed.ensure_context_layout(view)
                    ed.sync_toolbar_states()
                    repaint(view, ed.id_left_pane)
                }
                ed.apply_pointer_cursor(view)
                << 0
            }
        }
        if ed.add_node_select.is_open() {
            orig := copy_rect(&ed.add_node_origin)
            res := handle_open_select($&ed.add_node_select, &orig, input, rid_s, view)
            if res.handled {
                if res.changed {
                    set_sel_selected($&ed.add_node_select, 0)
                    if res.value == 1 { ed.do_add_node(resource.NODE_3D, "Node3D", view) }
                    else if res.value == 2 { ed.do_add_node(resource.NODE_2D, "Node2D", view) }
                    else if res.value == 3 { ed.do_add_node(resource.NODE_GROUP, "Group", view) }
                    else if res.value == 4 { ed.do_add_preset_cam(view) }
                    else if res.value == 5 { ed.do_add_preset_lgt(view) }
                    else if res.value == 6 { ed.do_add_preset_dir_lgt(view) }
                    else if res.value == 7 { ed.do_add_preset_spot_lgt(view) }
                    else if res.value == 8 { ed.do_add_preset_env(view) }
                    else if res.value == 9 { ed.do_add_preset_vfx(view) }
                }
                ed.apply_pointer_cursor(view)
                << 0
            }
        }
        if ed.add_comp_select.is_open() {
            orig := copy_rect(&ed.add_comp_origin)
            res := handle_open_select($&ed.add_comp_select, &orig, input, rid_s, view)
            if res.handled {
                if res.changed {
                    set_sel_selected($&ed.add_comp_select, 0)
                    if res.value >= 1 && (res.value - 1) < ed.comp_manual_open.len {
                        ed.comp_manual_open[res.value - 1] = true
                        _ := ed.sync_layout(view, ed.viewport_w, ed.viewport_h) >>> (err) {
                            _ := err
                            << 0
                        }
                        ed.sync_toolbar_states()
                        ed.repaint_all(view)
                    }
                }
                ed.apply_pointer_cursor(view)
                << 0
            }
        }
        if ed.parent_select.is_open() {
            orig := copy_rect(&ed.parent_origin)
            res := handle_open_select($&ed.parent_select, &orig, input, rid_s, view)
            if res.handled {
                ed.apply_pointer_cursor(view)
                << 0
            }
        }
        if ed.process_select.is_open() {
            orig := copy_rect(&ed.process_origin)
            res := handle_open_select($&ed.process_select, &orig, input, rid_s, view)
            if res.handled {
                if res.changed {
                    if ed.selected_nodes.len > 1 {
                        ed.do_apply_process_only(view)
                    } else {
                        _ := ed.apply_inspector(view)
                    }
                }
                ed.apply_pointer_cursor(view)
                << 0
            }
        }
        if ed.surf_asset_select.is_open() {
            orig := copy_rect(&ed.surf_asset_origin)
            res := handle_open_select($&ed.surf_asset_select, &orig, input, rid_s, view)
            if res.handled {
                ed.apply_pointer_cursor(view)
                << 0
            }
        }
        if ed.lod_asset_select.is_open() {
            orig := copy_rect(&ed.lod_asset_origin)
            res := handle_open_select($&ed.lod_asset_select, &orig, input, rid_s, view)
            if res.handled {
                ed.apply_pointer_cursor(view)
                << 0
            }
        }
        if comp_route_open_selects(ed, input, view) {
            ed.apply_pointer_cursor(view)
            << 0
        }
        rid_m := ed.id_root
        msel_res := modeling_route_open_select($&ed.modeling, input, rid_m, view)
        if msel_res > 0 {
            if msel_res == 2 { ed.do_apply_pbr_texture(view) }
            else if msel_res == 3 { ed.do_spawn_shape_from_select(view) }
            else if msel_res == 4 { ed.do_apply_preset_from_select(view) }
            ed.apply_pointer_cursor(view)
            << 0
        }

        if ed.route_open_context_menus(input, view) {
            ed.apply_pointer_cursor(view)
            << 0
        }

        // Global shortcuts
        if input.kind == ui.EV_KEY_DOWN && input.repeat == 0 {
            if input.key == ui.KEY_ESCAPE && ed.placing_mode {
                ed.placing_mode = false
                ed.sync_toolbar_states()
                ed.apply_pointer_cursor(view)
                repaint(view, ed.id_left_pane)
                repaint(view, ed.id_top_view)
                ed.set_status(STATUS_INFO, tr(ed.lang, "Cancelled placement", "已取消放置"), view)
                << 0
            }
            if input.key == ui.KEY_ESCAPE && (ed.top_view.dragging_nodes || ed.top_view.drag_pending || ed.top_view.marquee_active) {
                tv := $&ed.top_view
                tv.cancel_node_interactions()
                ed.top_pressed_hit = -1
                repaint(view, ed.id_top_view)
                ed.set_status(STATUS_INFO, tr(ed.lang, "Cancelled Top View drag", "已取消顶视图拖拽"), view)
                << 0
            }
            if input.key == ui.KEY_ESCAPE && ed.vp3d.gizmo_drag_axis > 0 {
                vp := $&ed.vp3d
                vp.gizmo_drag_axis = 0
                vp.drag_moved = false
                vp.live_gizmo_dirty = false
                vp.gizmo_delta = fm.vec3(0.0, 0.0, 0.0)
                vp.gizmo_rot_deg = fm.vec3(0.0, 0.0, 0.0)
                vp.gizmo_scale_mul = fm.vec3(1.0, 1.0, 1.0)
                vp.dirty_render = true
                ed.req_embed_render = true
                repaint(view, ed.id_top_view)
                ed.set_status(STATUS_INFO, tr(ed.lang, "Cancelled 3D transform", "已取消 3D 变换"), view)
                << 0
            }
            if input.key == ui.KEY_ESCAPE && ed.vp3d.sub_mode != SUB_MODE_OBJ {
                ed.vp3d.sub_mode = SUB_MODE_OBJ
                ed.sync_inspector(&(ed.draft.document() >>>))
                ed.repaint_all(view)
                ed.set_status(STATUS_INFO, tr(ed.lang, "Returned to Object mode", "已返回物体模式"), view)
                << 0
            }
            if input.key == ui.KEY_ESCAPE && ed.selected_nodes.len > 1 {
                ed.select_scene_node(ed.selected_node, view)
                ed.set_status(STATUS_INFO, tr(ed.lang, "Collapsed multi-selection", "已收拢为单选"), view)
                << 0
            }
            has_mod := (input.modifiers & (ui.MOD_META | ui.MOD_CONTROL)) != 0
            has_shift := (input.modifiers & ui.MOD_SHIFT) != 0
            if has_mod && (input.key == 115 || input.key == 83) { // Cmd/Ctrl+S
                _ := ed.do_save(view)
                << 0
            }
            if has_mod && (input.key == 122 || input.key == 90) { // Cmd/Ctrl+Z
                if has_shift { ed.do_redo(view) } else { ed.do_undo(view) }
                << 0
            }
            if has_mod && (input.key == 100 || input.key == 68) { // Cmd/Ctrl+D
                ed.do_duplicate_node(view)
                << 0
            }
            if !ed.any_text_field_focused() {
                if has_mod && (input.key == 97 || input.key == 65) { // Cmd/Ctrl+A Select All
                    ed.do_select_all_nodes(view)
                    << 0
                }
                if input.key == 102 || input.key == 70 { // F Focus / Shift+F Fit All
                    ed.do_focus_selected_or_scene(has_shift, view)
                    << 0
                }
                if !has_mod && (input.key == 104 || input.key == 72) { // H Toggle Visibility
                    ed.do_toggle_selected_visible(view)
                    << 0
                }
                if !has_mod && input.key == (ui.KEY_F1 + 1) && ed.name_field.is_enabled() { // F2 Rename
                    nb := view.node_bounds(ed.id_name_field) >>> (err) {
                        _ := err
                        << 0
                    }
                    cx := nb.x + nb.width * 0.5
                    cy := nb.y + nb.height * 0.5
                    f_dn := ui.InputEvent{
                        kind: ui.EV_POINTER_DOWN, window_id: ed.identity.window_id, canvas_id: ed.identity.canvas_id, generation: ed.identity.generation,
                        x: cx, y: cy, dx: 0.0, dy: 0.0, button: ui.BUTTON_LEFT, buttons: 1, modifiers: 0, key: 0, scan: 0, repeat: 0, click_count: 1, time_ns: input.time_ns
                    }
                    f_up := ui.InputEvent{
                        kind: ui.EV_POINTER_UP, window_id: ed.identity.window_id, canvas_id: ed.identity.canvas_id, generation: ed.identity.generation,
                        x: cx, y: cy, dx: 0.0, dy: 0.0, button: ui.BUTTON_LEFT, buttons: 0, modifiers: 0, key: 0, scan: 0, repeat: 0, click_count: 1, time_ns: input.time_ns
                    }
                    _ := widgets.dispatch(view, &f_dn, ed)
                    _ := widgets.dispatch(view, &f_up, ed)
                    repaint(view, ed.id_name_field)
                    ed.set_status(STATUS_INFO, tr(ed.lang, "Editing node name", "正在编辑节点名称"), view)
                    << 0
                }
                if !has_mod && ed.stage_mode != STAGE_MODE_TILEMAP && ed.selected_node > 0 &&
                   (input.key == ui.KEY_LEFT || input.key == ui.KEY_RIGHT || input.key == ui.KEY_UP || input.key == ui.KEY_DOWN) {
                    $step := 0.25
                    if ed.top_snap_enabled && ed.snap.move_step > 0.0 { step = ed.snap.move_step }
                    if has_shift { step = step * 0.2 }
                    $dx := 0.0
                    $dy := 0.0
                    $dz := 0.0
                    if input.key == ui.KEY_LEFT { dx = -step }
                    else if input.key == ui.KEY_RIGHT { dx = step }
                    else if input.key == ui.KEY_UP {
                        if ed.stage_mode == STAGE_MODE_2D && ed.top_view.axis_mode == STAGE_XY { dy = step }
                        else { dz = -step }
                    } else if input.key == ui.KEY_DOWN {
                        if ed.stage_mode == STAGE_MODE_2D && ed.top_view.axis_mode == STAGE_XY { dy = -step }
                        else { dz = step }
                    }
                    ed.do_nudge_selection(dx, dy, dz, view)
                    << 0
                }
                if (input.key == ui.KEY_BACKSPACE || input.key == ui.KEY_DELETE) && ed.selected_node > 0 {
                    ed.do_delete_node(view)
                    << 0
                }
                if !has_mod && input.key == 49 { // 1
                    ed.vp3d.sub_mode = SUB_MODE_OBJ
                    ed.sync_inspector(&(ed.draft.document() >>>))
                    ed.repaint_all(view)
                    << 0
                }
                if !has_mod && input.key == 50 { // 2
                    ed.vp3d.sub_mode = SUB_MODE_VERT
                    ed.sync_inspector(&(ed.draft.document() >>>))
                    ed.repaint_all(view)
                    if !ed.modeling.has_active_mesh {
                        ed.set_status(STATUS_INFO, tr(ed.lang, "GLB surface selected — select or create a Whitebox mesh to edit Vertices", "当前为 GLB 表面节点 — 请选中或新建白盒体以编辑顶点"), view)
                    }
                    << 0
                }
                if !has_mod && input.key == 51 { // 3
                    ed.vp3d.sub_mode = SUB_MODE_EDGE
                    ed.sync_inspector(&(ed.draft.document() >>>))
                    ed.repaint_all(view)
                    if !ed.modeling.has_active_mesh {
                        ed.set_status(STATUS_INFO, tr(ed.lang, "GLB surface selected — select or create a Whitebox mesh to edit Edges", "当前为 GLB 表面节点 — 请选中或新建白盒体以编辑边"), view)
                    }
                    << 0
                }
                if !has_mod && input.key == 52 { // 4
                    ed.vp3d.sub_mode = SUB_MODE_FACE
                    ed.sync_inspector(&(ed.draft.document() >>>))
                    ed.repaint_all(view)
                    if !ed.modeling.has_active_mesh {
                        ed.set_status(STATUS_INFO, tr(ed.lang, "GLB surface selected — select or create a Whitebox mesh to edit Faces", "当前为 GLB 表面节点 — 请选中或新建白盒体以编辑面"), view)
                    }
                    << 0
                }
                if ed.stage_mode == STAGE_MODE_TILEMAP {
                    if !has_mod && (input.key == 98 || input.key == 66) { // B Brush
                        ed.tilemap.tool = TM_TOOL_BRUSH
                        ed.tilemap.erasing = false
                        repaint(view, ed.id_top_view)
                        << 0
                    }
                    if !has_mod && (input.key == 101 || input.key == 69) { // E Erase
                        ed.tilemap.tool = TM_TOOL_ERASE
                        ed.tilemap.erasing = true
                        repaint(view, ed.id_top_view)
                        << 0
                    }
                    if !has_mod && (input.key == 114 || input.key == 82) { // R Rect
                        ed.tilemap.tool = TM_TOOL_RECT
                        ed.tilemap.erasing = false
                        repaint(view, ed.id_top_view)
                        << 0
                    }
                    if !has_mod && (input.key == 118 || input.key == 86) { // V Fill
                        ed.tilemap.tool = TM_TOOL_FILL
                        ed.tilemap.erasing = false
                        repaint(view, ed.id_top_view)
                        << 0
                    }
                    if !has_mod && (input.key == 105 || input.key == 73) { // I Eyedrop
                        ed.tilemap.tool = TM_TOOL_EYEDROP
                        ed.tilemap.erasing = false
                        repaint(view, ed.id_top_view)
                        << 0
                    }
                    if !has_mod && (input.key == 103 || input.key == 71) { // G Grid
                        ed.tilemap.show_grid = !ed.tilemap.show_grid
                        repaint(view, ed.id_top_view)
                        << 0
                    }
                }
                if !has_mod && (input.key == 116 || input.key == 84) { // T Move Gizmo
                    ed.vp3d.gizmo_tool = GIZMO_MOVE
                    ed.sync_inspector(&(ed.draft.document() >>>))
                    ed.repaint_all(view)
                    << 0
                }
                if !has_mod && (input.key == 114 || input.key == 82) { // R Rotate Gizmo
                    ed.vp3d.gizmo_tool = GIZMO_ROTATE
                    ed.sync_inspector(&(ed.draft.document() >>>))
                    ed.repaint_all(view)
                    << 0
                }
                if !has_mod && (input.key == 115 || input.key == 83) { // S Scale Gizmo
                    ed.vp3d.gizmo_tool = GIZMO_SCALE
                    ed.sync_inspector(&(ed.draft.document() >>>))
                    ed.repaint_all(view)
                    << 0
                }
                if !has_mod && (input.key == 101 || input.key == 69) { // E
                    ed.do_mesh_op("extrude", 0.0, ed.modeling_step_val(0.35), view)
                    << 0
                }
                if !has_mod && (input.key == 105 || input.key == 73) { // I
                    ed.do_mesh_op("inset", math.min(0.45, ed.modeling_step_val(0.25)), 0.0, view)
                    << 0
                }
                if !has_mod && (input.key == 98 || input.key == 66) { // B
                    ed.do_mesh_op("bevel", 0.0, math.min(0.40, ed.modeling_step_val(0.14)), view)
                    << 0
                }
                if !has_mod && (input.key == 107 || input.key == 75) { // K Subdivide
                    ed.do_mesh_op("subdivide", 0.0, 0.0, view)
                    << 0
                }
                if !has_mod && (input.key == 110 || input.key == 78) { // N Flip Normals
                    ed.do_mesh_op("flip_normals", 0.0, 0.0, view)
                    << 0
                }
                if !has_mod && (input.key == 120 || input.key == 88) { // X Delete Face
                    ed.do_mesh_op("delete_face", 0.0, 0.0, view)
                    << 0
                }
                if !has_mod && (input.key == 109 || input.key == 77) { // M Weld
                    ed.do_mesh_op("weld", math.min(0.25, ed.modeling_step_val(0.02)), 0.0, view)
                    << 0
                }
                if !has_mod && (input.key == 117 || input.key == 85) { // U
                    ed.do_mesh_op("box_uv", 0.0, 1.0, view)
                    << 0
                }
                if !has_mod && (input.key == 119 || input.key == 87) { // W
                    ed.vp3d.show_wire = !ed.vp3d.show_wire
                    ed.sync_inspector(&(ed.draft.document() >>>))
                    ed.repaint_all(view)
                    << 0
                }
                if !has_mod && (input.key == 103 || input.key == 71) { // G
                    ed.vp3d.show_grid = !ed.vp3d.show_grid
                    ed.vp3d.dirty_render = true
                    ed.req_embed_render = true
                    repaint(view, ed.id_top_view)
                    << 0
                }
                if !has_mod && input.key == ui.KEY_TAB {
                    if ed.stage_mode == STAGE_MODE_SPLIT {
                        ed.set_stage_mode(STAGE_MODE_3D, view)
                    } else {
                        ed.set_stage_mode(STAGE_MODE_SPLIT, view)
                    }
                    << 0
                }
                if !has_mod && (input.key == 111 || input.key == 79) { // O
                    ed.vp3d.ortho_axis = (ed.vp3d.ortho_axis + 1) % 3
                    ed.vp3d.dirty_render = true
                    ed.req_embed_render = true
                    ed.sync_toolbar_states()
                    repaint(view, ed.id_center_pane)
                    << 0
                }
            }
        }

    actions := widgets.dispatch(view, input, ed) >>>
    $need_relayout := false
    for i in 0:actions.len {
        a := &actions[i]
        if a.needs_paint && a.id > 0 {
            repaint(view, a.id)
        }
        if a.id == ed.id_left_split || a.id == ed.id_right_split {
            if a.kind == widgets.ACTION_CHANGE { need_relayout = true }
        } else if a.id == ed.panels.id_open_proj_btn && a.kind == widgets.ACTION_ACTIVATE {
            if ed.draft.dirty() {
                ed.open_unsaved_open_project_modal(view)
            } else {
                ed.req_open_project = true
            }
        } else if a.id == ed.panels.id_scene_mgr_btn && a.kind == widgets.ACTION_ACTIVATE {
            ed.open_scene_manage_modal(view)
        } else if a.id == ed.panels.id_export_btn && a.kind == widgets.ACTION_ACTIVATE {
            ed.open_export_modal(view)
        } else if a.id == ed.panels.id_lang_btn && a.kind == widgets.ACTION_ACTIVATE {
            $next_l := LANG_ZH
            if ed.lang == LANG_ZH { next_l = LANG_EN }
            ed.set_lang(next_l, view)
        } else if a.id == ed.panels.id_node_up_btn && a.kind == widgets.ACTION_ACTIVATE {
            ed.do_move_sibling(-1, view)
        } else if a.id == ed.panels.id_node_dn_btn && a.kind == widgets.ACTION_ACTIVATE {
            ed.do_move_sibling(1, view)
        } else if a.id == ed.panels.id_tree_filter && a.kind == widgets.ACTION_CHANGE {
            doc := ed.draft.document() >>> (err) { << 0 }
            ed.rebuild_tree(&doc)
            repaint(view, ed.id_left_pane)
        } else if a.id == ed.panels.id_relocate_btn && a.kind == widgets.ACTION_ACTIVATE {
            sel := ed.selected_asset
            if sel >= 0 && sel < ed.project.assets.len {
                ed.relocate_uid = ed.project.assets[sel].key + ""
                ed.req_relocate_asset = true
            }
        } else if a.id == ed.panels.id_remove_asset_btn && a.kind == widgets.ACTION_ACTIVATE {
            ed.do_remove_selected_asset(view)
        } else if a.id == ed.id_scene_select && a.kind == widgets.ACTION_CHANGE {
            ed.switch_scene(int(a.value), true, view)
        } else if a.id == ed.id_new_scene_btn && a.kind == widgets.ACTION_ACTIVATE {
            ed.open_new_scene_modal(view)
        } else if a.id == ed.id_globals_btn && a.kind == widgets.ACTION_ACTIVATE {
            ed.open_globals_modal(view)
        } else if a.id == ed.id_stage_tabs && a.kind == widgets.ACTION_CHANGE {
            ed.set_stage_mode(stage_tab_to_mode(int(a.value)), view)
        } else if a.id == ed.id_undo_btn && a.kind == widgets.ACTION_ACTIVATE {
            ed.do_undo(view)
        } else if a.id == ed.id_redo_btn && a.kind == widgets.ACTION_ACTIVATE {
            ed.do_redo(view)
        } else if a.id == ed.id_save_btn && a.kind == widgets.ACTION_ACTIVATE {
            _ := ed.do_save(view)
        } else if a.id == ed.id_preview_btn && a.kind == widgets.ACTION_ACTIVATE {
            ed.flush_pending_edits_before_action(view)
            ed.req_launch_preview = true
        } else if a.id == ed.id_left_tabs && a.kind == widgets.ACTION_CHANGE {
            ed.set_left_tab(int(a.value), view)
        } else if a.id == ed.id_insp_tabs && a.kind == widgets.ACTION_CHANGE {
            ed.set_insp_tab(int(a.value), view)
        } else if a.id == ed.id_add_node_select && a.kind == widgets.ACTION_CHANGE {
            choice := int(a.value)
            set_sel_selected($&ed.add_node_select, 0)
            if choice == 1 { ed.do_add_node(resource.NODE_3D, "Node3D", view) }
            else if choice == 2 { ed.do_add_node(resource.NODE_2D, "Node2D", view) }
            else if choice == 3 { ed.do_add_node(resource.NODE_GROUP, "Group", view) }
            else if choice == 4 { ed.do_add_preset_cam(view) }
            else if choice == 5 { ed.do_add_preset_lgt(view) }
            else if choice == 6 { ed.do_add_preset_dir_lgt(view) }
            else if choice == 7 { ed.do_add_preset_spot_lgt(view) }
            else if choice == 8 { ed.do_add_preset_env(view) }
            else if choice == 9 { ed.do_add_preset_vfx(view) }
        } else if a.id == ed.id_add_comp_select && a.kind == widgets.ACTION_CHANGE {
            choice := int(a.value)
            set_sel_selected($&ed.add_comp_select, 0)
            if choice >= 1 && (choice - 1) < ed.comp_manual_open.len {
                ed.comp_manual_open[choice - 1] = true
                need_relayout = true
            }
        } else if a.id == ed.id_dup_btn && a.kind == widgets.ACTION_ACTIVATE {
            ed.do_duplicate_node(view)
        } else if a.id == ed.id_del_btn && a.kind == widgets.ACTION_ACTIVATE {
            ed.do_delete_node(view)
        } else if a.id == ed.id_tree && a.kind == widgets.ACTION_CHANGE {
            ed.apply_tree_selection_from_widget(view)
        } else if a.id == ed.id_tree && a.kind == widgets.ACTION_ITEM_ACTION {
            tid := int(a.value)
            if tid == -1 {
                ed.begin_tree_vis_drag(ed.tree_vis_drag_start_sid, view)
            } else if tid == -2 {
                ed.sync_tree_vis_drag_range(view)
            } else if tid == -3 {
                ed.finish_tree_vis_drag(view)
            } else if ed.tree_to_scene.has(tid) {
                ed.do_toggle_node_visible(ed.tree_to_scene[tid], view)
            }
        } else if a.id == ed.id_import_btn && a.kind == widgets.ACTION_ACTIVATE {
            ed.req_import_glb = true
        } else if a.id == ed.id_asset_list && a.kind == widgets.ACTION_CHANGE {
            tid := ed.asset_list.selected()
            if ed.asset_row_to_idx.has(tid) {
                idx := ed.asset_row_to_idx[tid]
                ed.select_asset_index(idx)
                ed.sync_asset_meta_text()
                ed.ensure_context_layout(view)
                ed.sync_toolbar_states()
                repaint(view, ed.id_left_pane)
            }
        } else if a.id == ed.id_asset_select && (a.kind == widgets.ACTION_CHANGE || a.kind == widgets.ACTION_ACTIVATE) {
            if a.kind == widgets.ACTION_CHANGE {
                ed.select_asset_index(int(a.value))
                ed.sync_asset_meta_text()
                ed.ensure_context_layout(view)
                ed.sync_toolbar_states()
                repaint(view, ed.id_left_pane)
            }
            repaint(view, ed.id_root)
        } else if a.id == ed.id_place_btn && a.kind == widgets.ACTION_ACTIVATE {
            ed.placing_mode = !ed.placing_mode
            if ed.placing_mode && ed.stage_mode != STAGE_MODE_2D {
                ed.set_stage_mode(STAGE_MODE_2D, view)
            }
            ed.sync_toolbar_states()
            repaint(view, ed.id_left_pane)
            repaint(view, ed.id_top_view)
            if ed.placing_mode {
                ed.set_status(STATUS_INFO, tr(ed.lang, "Click in 2D Stage to place GLB (Esc cancels)", "在 2D 舞台点击放置 GLB（Esc 取消）"), view)
            } else {
                ed.set_status(STATUS_INFO, "Cancelled placement", view)
            }
        } else if a.id == ed.id_stage_axis_btn && a.kind == widgets.ACTION_ACTIVATE {
            if ed.stage_mode == STAGE_MODE_3D {
                ed.vp3d.show_grid = !ed.vp3d.show_grid
                ed.vp3d.dirty_render = true
                ed.req_embed_render = true
                ed.sync_toolbar_states()
                repaint(view, ed.id_center_pane)
            } else if ed.stage_mode == STAGE_MODE_TILEMAP {
                ed.tilemap.show_grid = !ed.tilemap.show_grid
                ed.sync_toolbar_states()
                repaint(view, ed.id_center_pane)
                repaint(view, ed.id_top_view)
                ed.set_status(STATUS_INFO, tr(ed.lang, "Toggled TileMap grid", "已切换瓦片网格显示"), view)
            } else if ed.stage_mode == STAGE_MODE_SPLIT {
                ed.vp3d.ortho_axis = (ed.vp3d.ortho_axis + 1) % 3
                ed.vp3d.dirty_render = true
                ed.req_embed_render = true
                ed.sync_toolbar_states()
                repaint(view, ed.id_center_pane)
                ed.set_status(STATUS_INFO, tr(ed.lang, "Switched ortho pane axis", "已切换正交视图轴向"), view)
            } else {
                if ed.top_view.axis_mode == STAGE_XZ {
                    ed.top_view.axis_mode = STAGE_XY
                    ed.set_status(STATUS_INFO, "Stage axis: Front View · XY", view)
                } else {
                    ed.top_view.axis_mode = STAGE_XZ
                    ed.set_status(STATUS_INFO, "Stage axis: Top View · XZ", view)
                }
                ed.sync_toolbar_states()
                pts := clone_stage_points(&ed.stage_pts)
                tv_rect := copy_rect(&ed.top_view_local)
                tv := $&ed.top_view
                tv.fit_points(&pts, &tv_rect)
                repaint(view, ed.id_center_pane)
                repaint(view, ed.id_top_view)
            }
        } else if a.id == ed.id_stage_snap_btn && a.kind == widgets.ACTION_ACTIVATE {
            ed.top_snap_enabled = !ed.top_snap_enabled
            ed.sync_toolbar_states()
            if ed.top_snap_enabled {
                ed.set_status(STATUS_INFO, "Stage grid snap enabled (" + fmt_coord(ed.snap.move_step) + " u)", view)
            } else {
                ed.set_status(STATUS_INFO, "Stage grid snap disabled", view)
            }
            repaint(view, ed.id_center_pane)
        } else if a.id == ed.id_fit_btn && a.kind == widgets.ACTION_ACTIVATE {
            ed.do_focus_selected_or_scene(false, view)
        } else if a.id == ed.id_snap_btn && a.kind == widgets.ACTION_ACTIVATE {
            ed.open_snap_modal(view)
        } else if a.id == ed.id_top_view && a.kind == widgets.ACTION_ACTIVATE {
            hit_id := int(a.value)
            if ed.top_pressed_shift {
                ed.top_pressed_shift = false
                ed.toggle_selection_node(hit_id)
                doc := ed.draft.document() >>>
                ed.sync_tree_selection(true)
                ed.sync_inspector(&doc)
                ed.sync_toolbar_states()
                repaint(view, ed.id_left_pane)
                repaint(view, ed.id_top_view)
                repaint(view, ed.id_right_pane)
            } else {
                ed.select_scene_node(hit_id, view)
            }
        } else if a.id == ed.id_top_view && a.kind == widgets.ACTION_CHANGE {
            mode_val := int(a.value)
            if mode_val == 1 {
                dx := ed.top_commit_dx
                dv := ed.top_commit_dv
                $dy := 0.0
                $dz := 0.0
                if ed.top_view.axis_mode == STAGE_XY { dy = dv } else { dz = dv }
                $targets := []int{}
                for k in 0:ed.selected_nodes.len { targets.push(ed.selected_nodes[k]) }
                d := $&ed.draft
                _ := d.move_nodes_delta(&targets, dx, dy, dz) >>> (err) {
                    ed.set_status(STATUS_ERR, err.msg(), view)
                    << 0
                }
                ed.refresh_after_document_change(false, view)
                ed.set_status(STATUS_OK, "Moved " + str(targets.len) + " node(s)", view)
            } else if mode_val == 2 {
                pts := clone_stage_points(&ed.stage_pts)
                tv_rect := copy_rect(&ed.top_view_local)
                picked_list := pick_stage_marquee(&ed.top_view, &tv_rect, &pts, ed.top_marquee_x0, ed.top_marquee_y0, ed.top_marquee_x1, ed.top_marquee_y1)
                if ed.top_pressed_shift {
                    ed.top_pressed_shift = false
                    $merged := []int{}
                    for k in 0:ed.selected_nodes.len { merged.push(ed.selected_nodes[k]) }
                    for k in 0:picked_list.len {
                        nid := picked_list[k]
                        if !is_selected_node(&merged, nid) { merged.push(nid) }
                    }
                    ed.set_selection_list(&merged, view)
                } else {
                    ed.set_selection_list(&picked_list, view)
                }
            } else if mode_val == 10 {
                li := ed.tilemap.layer_idx
                lay := clone_tilemap_2d(&ed.tilemap.layer, ed.tilemap.layer.node)
                d := $&ed.draft
                _ := d.set_tilemap_2d_layer(li, &lay) >>> (err) {
                    ed.set_status(STATUS_ERR, err.msg(), view)
                    << 0
                }
                ed.refresh_after_document_change(false, view)
                ed.set_status(STATUS_OK, tr(ed.lang, "Updated TileMap cells", "已更新 TileMap 单元格"), view)
            } else if mode_val == 11 {
                ei := ed.tilemap.exit_index
                ep := ed.tilemap.exit_local
                d := $&ed.draft
                _ := d.move_tilemap_exit(ei, ep) >>> (err) {
                    ed.set_status(STATUS_ERR, err.msg(), view)
                    << 0
                }
                ed.refresh_after_document_change(false, view)
                ed.set_status(STATUS_OK, tr(ed.lang, "Moved TileMap exit marker", "已移动 TileMap 出口标记"), view)
            } else if mode_val == 12 {
                doc := ed.draft.document() >>>
                ed.sync_inspector(&doc)
                repaint(view, ed.id_top_view)
            } else if mode_val == 15 {
                delta := ed.vp3d.gizmo_delta
                rot_d := ed.vp3d.gizmo_rot_deg
                scl_m := ed.vp3d.gizmo_scale_mul
                ed.vp3d.gizmo_delta = fm.vec3(0.0, 0.0, 0.0)
                ed.vp3d.gizmo_rot_deg = fm.vec3(0.0, 0.0, 0.0)
                ed.vp3d.gizmo_scale_mul = fm.vec3(1.0, 1.0, 1.0)
                ed.vp3d.live_gizmo_dirty = false
                sel_n := ed.selected_node
                $targets := []int{}
                for k in 0:ed.selected_nodes.len {
                    nid := ed.selected_nodes[k]
                    if nid > 0 { targets.push(nid) }
                }
                if targets.len == 0 && sel_n > 0 { targets.push(sel_n) }
                has_xf := delta.length() > 1e-6 || rot_d.length() > 1e-4 ||
                    math.abs(scl_m.x - 1.0) > 1e-4 || math.abs(scl_m.y - 1.0) > 1e-4 || math.abs(scl_m.z - 1.0) > 1e-4
                if targets.len > 0 && has_xf {
                    d := $&ed.draft
                    _ := d.transform_nodes_3d(&targets, delta, rot_d, scl_m) >>> (err) {
                        ed.set_status(STATUS_ERR, err.msg(), view)
                        << 0
                    }
                    ed.refresh_after_document_change(false, view)
                    if targets.len > 1 {
                        ed.set_status(STATUS_OK, tr(ed.lang, "Transformed " + str(targets.len) + " nodes in 3D", "已在 3D 视口变换 " + str(targets.len) + " 个节点"), view)
                    } else {
                        ed.set_status(STATUS_OK, tr(ed.lang, "Transformed node in 3D", "已在 3D 视口变换节点"), view)
                    }
                } else {
                    repaint(view, ed.id_top_view)
                }
            } else if mode_val == 16 {
                delta := ed.vp3d.gizmo_delta
                ed.vp3d.gizmo_delta = fm.vec3(0.0, 0.0, 0.0)
                ed.vp3d.live_gizmo_dirty = false
                sel_n := ed.selected_node
                if sel_n > 0 && delta.length() > 1e-6 {
                    sm := ed.vp3d.sub_mode
                    sv := ed.vp3d.selected_vert
                    se0 := ed.vp3d.selected_e0
                    se1 := ed.vp3d.selected_e1
                    sf := ed.vp3d.selected_face
                    d := $&ed.draft
                    _ := d.translate_sub_element(sel_n, sm, sv, se0, se1, sf, delta) >>> (err) {
                        ed.set_status(STATUS_ERR, err.msg(), view)
                        << 0
                    }
                    ed.refresh_after_document_change(false, view)
                    ed.set_status(STATUS_OK, tr(ed.lang, "Moved mesh sub-element", "已移动网格子元素"), view)
                } else {
                    repaint(view, ed.id_top_view)
                }
            }
        } else if a.id == ed.id_top_view && a.kind == widgets.ACTION_COMMIT {
            $wz := ed.top_view.hover_z
            if ed.top_view.axis_mode == STAGE_XY { wz = 0.0 }
            ed.do_place_at(ed.top_view.hover_x, wz, view)
        } else if a.id == ed.id_insp_scroll && a.kind == widgets.ACTION_SCROLL {
            ed.close_all_selects()
            view.set_scroll(ed.id_insp_scroll, 0.0, ed.insp_scroll.offset()) >>>
            ed.place_all_controls(view) >>>
            ed.repaint_all(view)
        } else if a.id == ed.id_reparent_btn && a.kind == widgets.ACTION_ACTIVATE {
            ed.do_reparent_selected(view)
        } else if a.id == ed.id_surf_bind_btn && a.kind == widgets.ACTION_ACTIVATE {
            ed.do_bind_surface(view)
        } else if a.id == ed.id_surf_clear_btn && a.kind == widgets.ACTION_ACTIVATE {
            ed.do_clear_surface(view)
        } else if a.id == ed.id_lod_add_btn && a.kind == widgets.ACTION_ACTIVATE {
            ed.do_add_lod_level(view)
        } else if a.id == ed.id_lod_pop_btn && a.kind == widgets.ACTION_ACTIVATE {
            ed.do_pop_lod_level(view)
        } else if a.id == ed.id_surf_prim_field && (a.kind == widgets.ACTION_COMMIT || a.kind == widgets.ACTION_SUBMIT) {
            ed.do_bind_surface(view)
        } else if (a.id == ed.id_lod_hyst_field || a.id == ed.id_lod_dist_field || a.id == ed.id_lod_prim_field) &&
                  (a.kind == widgets.ACTION_COMMIT || a.kind == widgets.ACTION_SUBMIT) {
            ed.do_add_lod_level(view)
        } else if a.id == ed.id_apply_btn && a.kind == widgets.ACTION_ACTIVATE {
            _ := ed.apply_inspector(view)
        } else if (a.id == ed.id_pos_lbl || a.id == ed.id_rot_lbl || a.id == ed.id_scale_lbl) && a.kind == widgets.ACTION_ACTIVATE {
            ed.do_reset_transform(int(a.value), view)
        } else if a.id == ed.id_visible_chk && a.kind == widgets.ACTION_CHANGE {
            if ed.selected_nodes.len > 1 {
                ed.do_apply_visible_only(view)
            } else {
                _ := ed.apply_inspector(view)
            }
        } else if a.id == ed.id_process_select && a.kind == widgets.ACTION_CHANGE {
            if ed.selected_nodes.len > 1 {
                ed.do_apply_process_only(view)
            } else {
                _ := ed.apply_inspector(view)
            }
        } else if a.id == ed.id_name_field && a.kind == widgets.ACTION_CHANGE {
            had_err := ed.name_error.len > 0
            had_dirty := ed.insp_dirty || ed.modeling.mat_dirty
            val := ed.name_field.value()
            ed.name_error = ""
            ed.insp_dirty = true
            ed.refresh_name_decoration(&val)
            if had_err || !had_dirty { need_relayout = true }
            repaint(view, ed.id_right_pane)
        } else if (a.id == ed.id_pos_x || a.id == ed.id_pos_y || a.id == ed.id_pos_z ||
                   a.id == ed.id_rot_x || a.id == ed.id_rot_y || a.id == ed.id_rot_z ||
                   a.id == ed.id_scale_x || a.id == ed.id_scale_y || a.id == ed.id_scale_z) && a.kind == widgets.ACTION_CHANGE {
            had_dirty := ed.insp_dirty || ed.modeling.mat_dirty
            ed.insp_dirty = true
            if !had_dirty { need_relayout = true }
            repaint(view, ed.id_right_pane)
        } else if (a.id == ed.id_name_field || a.id == ed.id_pos_x || a.id == ed.id_pos_y || a.id == ed.id_pos_z ||
                   a.id == ed.id_rot_x || a.id == ed.id_rot_y || a.id == ed.id_rot_z ||
                   a.id == ed.id_scale_x || a.id == ed.id_scale_y || a.id == ed.id_scale_z) && a.kind == widgets.ACTION_COMMIT {
            _ := ed.apply_inspector(view)
        } else if a.kind == widgets.ACTION_SUBMIT && is_inspector_submit_id(ed, a.id) {
            _ := ed.apply_inspector(view)
        } else if handle_comp_action(ed, a, view) {
        } else if a.kind == widgets.ACTION_ACTIVATE {
            if a.id == ed.modeling.button_ids[MB_BOX] { ed.do_spawn_whitebox("box", view) }
            else if a.id == ed.modeling.button_ids[MB_WEDGE] { ed.do_spawn_whitebox("wedge", view) }
            else if a.id == ed.modeling.button_ids[MB_STAIR] { ed.do_spawn_whitebox("stair", view) }
            else if a.id == ed.modeling.button_ids[MB_CYL] { ed.do_spawn_whitebox("cylinder", view) }
            else if a.id == ed.modeling.button_ids[MB_ARCH] { ed.do_spawn_whitebox("arch", view) }
            else if a.id == ed.modeling.button_ids[MB_CSG] { ed.do_spawn_csg_cut(view) }
            else if a.id == ed.modeling.button_ids[MB_MODE_OBJ] {
                ed.vp3d.sub_mode = SUB_MODE_OBJ
                ed.sync_inspector(&(ed.draft.document() >>>))
                ed.repaint_all(view)
            } else if a.id == ed.modeling.button_ids[MB_MODE_VERT] {
                ed.vp3d.sub_mode = SUB_MODE_VERT
                ed.sync_inspector(&(ed.draft.document() >>>))
                ed.repaint_all(view)
                if !ed.modeling.has_active_mesh {
                    ed.set_status(STATUS_INFO, tr(ed.lang, "GLB surface selected — select or create a Whitebox mesh to edit Vertices", "当前为 GLB 表面节点 — 请选中或新建白盒体以编辑顶点"), view)
                }
            } else if a.id == ed.modeling.button_ids[MB_MODE_EDGE] {
                ed.vp3d.sub_mode = SUB_MODE_EDGE
                ed.sync_inspector(&(ed.draft.document() >>>))
                ed.repaint_all(view)
                if !ed.modeling.has_active_mesh {
                    ed.set_status(STATUS_INFO, tr(ed.lang, "GLB surface selected — select or create a Whitebox mesh to edit Edges", "当前为 GLB 表面节点 — 请选中或新建白盒体以编辑边"), view)
                }
            } else if a.id == ed.modeling.button_ids[MB_MODE_FACE] {
                ed.vp3d.sub_mode = SUB_MODE_FACE
                ed.sync_inspector(&(ed.draft.document() >>>))
                ed.repaint_all(view)
                if !ed.modeling.has_active_mesh {
                    ed.set_status(STATUS_INFO, tr(ed.lang, "GLB surface selected — select or create a Whitebox mesh to edit Faces", "当前为 GLB 表面节点 — 请选中或新建白盒体以编辑面"), view)
                }
            } else if a.id == ed.modeling.button_ids[MB_EXTRUDE] {
                ed.do_mesh_op("extrude", 0.0, ed.modeling_step_val(0.35), view)
            } else if a.id == ed.modeling.button_ids[MB_INSET] {
                ed.do_mesh_op("inset", math.min(0.45, ed.modeling_step_val(0.25)), 0.0, view)
            } else if a.id == ed.modeling.button_ids[MB_BEVEL] {
                ed.do_mesh_op("bevel", 0.0, math.min(0.40, ed.modeling_step_val(0.14)), view)
            } else if a.id == ed.modeling.button_ids[MB_UV] {
                ed.do_mesh_op("box_uv", 0.0, 1.0, view)
            } else if a.id == ed.modeling.button_ids[MB_WIRE] {
                ed.vp3d.show_wire = !ed.vp3d.show_wire
                ed.sync_inspector(&(ed.draft.document() >>>))
                ed.repaint_all(view)
            } else if a.id == ed.modeling.button_ids[MB_MAT_APPLY] {
                ed.do_apply_pbr_material(view)
            } else if a.id == ed.modeling.button_ids[MB_MAT_CLEAR] {
                ed.do_clear_pbr_material(view)
            } else if a.id == ed.modeling.button_ids[MB_EXPORT_GLB] {
                ed.do_export_node_glb(view)
            } else if a.id == ed.modeling.button_ids[MB_GIZMO_MOVE] {
                ed.vp3d.gizmo_tool = GIZMO_MOVE
                ed.sync_inspector(&(ed.draft.document() >>>))
                ed.repaint_all(view)
            } else if a.id == ed.modeling.button_ids[MB_GIZMO_ROT] {
                ed.vp3d.gizmo_tool = GIZMO_ROTATE
                ed.sync_inspector(&(ed.draft.document() >>>))
                ed.repaint_all(view)
            } else if a.id == ed.modeling.button_ids[MB_GIZMO_SCALE] {
                ed.vp3d.gizmo_tool = GIZMO_SCALE
                ed.sync_inspector(&(ed.draft.document() >>>))
                ed.repaint_all(view)
            } else if a.id == ed.modeling.button_ids[MB_SPHERE] {
                ed.do_spawn_whitebox("sphere", view)
            } else if a.id == ed.modeling.button_ids[MB_SUBDIV] {
                ed.do_mesh_op("subdivide", 0.0, 0.0, view)
            } else if a.id == ed.modeling.button_ids[MB_FLIP] {
                ed.do_mesh_op("flip_normals", 0.0, 0.0, view)
            } else if a.id == ed.modeling.button_ids[MB_DEL_FACE] {
                ed.do_mesh_op("delete_face", 0.0, 0.0, view)
            } else if a.id == ed.modeling.button_ids[MB_WELD] {
                ed.do_mesh_op("weld", math.min(0.25, ed.modeling_step_val(0.02)), 0.0, view)
            } else if a.id == ed.modeling.button_ids[MB_CSG_ADD_BOX] {
                ed.do_csg_action(0, view)
            } else if a.id == ed.modeling.button_ids[MB_CSG_ADD_CUT] {
                ed.do_csg_action(1, view)
            } else if a.id == ed.modeling.button_ids[MB_CSG_CYCLE] {
                ed.do_csg_action(2, view)
            } else if a.id == ed.modeling.button_ids[MB_CSG_BAKE] {
                ed.do_csg_action(3, view)
            } else if a.id == ed.modeling.button_ids[MB_PRESET_0] {
                ed.do_apply_preset(0, view)
            } else if a.id == ed.modeling.button_ids[MB_PRESET_1] {
                ed.do_apply_preset(1, view)
            } else if a.id == ed.modeling.button_ids[MB_PRESET_2] {
                ed.do_apply_preset(2, view)
            } else if a.id == ed.modeling.button_ids[MB_PRESET_3] {
                ed.do_apply_preset(3, view)
            } else if a.id == ed.modeling.button_ids[MB_PRESET_4] {
                ed.do_apply_preset(4, view)
            } else if a.id == ed.modeling.button_ids[MB_PRESET_5] {
                ed.do_apply_preset(5, view)
            } else if a.id == ed.modeling.button_ids[MB_PRESET_6] {
                ed.do_apply_preset(6, view)
            } else if a.id == ed.modeling.button_ids[MB_PRESET_7] {
                ed.do_apply_preset(7, view)
            } else if a.id == ed.modeling.button_ids[MB_PRESET_8] {
                ed.do_apply_preset(8, view)
            } else if a.id == ed.modeling.button_ids[MB_PRESET_9] {
                ed.do_apply_preset(9, view)
            } else if a.id == ed.modeling.button_ids[MB_MAT_TWOSIDED] {
                ed.do_toggle_twosided(view)
            }
        } else if a.id == ed.modeling.id_shape_select && a.kind == widgets.ACTION_CHANGE {
            ed.do_spawn_shape_from_select(view)
        } else if a.id == ed.modeling.id_mat_preset_select && a.kind == widgets.ACTION_CHANGE {
            ed.do_apply_preset_from_select(view)
        } else if a.id == ed.modeling.id_mat_tex_select && a.kind == widgets.ACTION_CHANGE {
            ed.do_apply_pbr_texture(view)
        } else if a.kind == widgets.ACTION_CHANGE &&
                  (a.id == ed.modeling.field_ids[MF_R] || a.id == ed.modeling.field_ids[MF_G] ||
                   a.id == ed.modeling.field_ids[MF_B] || a.id == ed.modeling.field_ids[MF_METALLIC] ||
                   a.id == ed.modeling.field_ids[MF_ROUGHNESS] || a.id == ed.modeling.field_ids[MF_EMIT] ||
                   a.id == ed.modeling.field_ids[MF_ALPHA] || a.id == ed.modeling.field_ids[MF_COAT] ||
                   a.id == ed.modeling.field_ids[MF_IOR]) {
            had_dirty := ed.insp_dirty || ed.modeling.mat_dirty
            ed.modeling.mat_dirty = true
            modeling_preview_color_from_fields($&ed.modeling)
            if !had_dirty { need_relayout = true }
            repaint(view, ed.id_right_pane)
        } else if (a.kind == widgets.ACTION_COMMIT || a.kind == widgets.ACTION_SUBMIT) {
            if a.id == ed.modeling.field_ids[MF_R] { ed.do_apply_pbr_material_field(MF_R, view) }
            else if a.id == ed.modeling.field_ids[MF_G] { ed.do_apply_pbr_material_field(MF_G, view) }
            else if a.id == ed.modeling.field_ids[MF_B] { ed.do_apply_pbr_material_field(MF_B, view) }
            else if a.id == ed.modeling.field_ids[MF_METALLIC] { ed.do_apply_pbr_material_field(MF_METALLIC, view) }
            else if a.id == ed.modeling.field_ids[MF_ROUGHNESS] { ed.do_apply_pbr_material_field(MF_ROUGHNESS, view) }
            else if a.id == ed.modeling.field_ids[MF_EMIT] { ed.do_apply_pbr_material_field(MF_EMIT, view) }
            else if a.id == ed.modeling.field_ids[MF_ALPHA] { ed.do_apply_pbr_material_field(MF_ALPHA, view) }
            else if a.id == ed.modeling.field_ids[MF_COAT] { ed.do_apply_pbr_material_field(MF_COAT, view) }
            else if a.id == ed.modeling.field_ids[MF_IOR] { ed.do_apply_pbr_material_field(MF_IOR, view) }
        }
        if ed.any_popup_or_select_open() {
            repaint(view, ed.id_root)
        }
    }
    if need_relayout {
        ed.sync_layout(view, ed.viewport_w, ed.viewport_h) >>>
        ed.repaint_all(view)
    }
    if input.kind == ui.EV_POINTER_MOVE && input.generation == ed.identity.generation {
        $next_rh := 0
        if ed.insp_tab == 0 && ed.insp_can_trs {
            rids := [ed.id_pos_lbl, ed.id_rot_lbl, ed.id_scale_lbl]
            for ri in 0:3 {
                part := ri + 1
                if !transform_part_is_default(ed, part) && node_contains_clipped(view, rids[ri], ed.id_insp_scroll, input.x, input.y) {
                    rlb := view.node_bounds(rids[ri]) >>> (err) { -> }
                    if input.x >= rlb.x + rlb.width - 48.0 {
                        next_rh = part
                        <-
                    }
                }
            }
        }
        if next_rh != ed.reset_hover {
            ed.reset_hover = next_rh
            repaint(view, ed.id_right_pane)
        }
        if ed.modals.kind != MODAL_NONE || ed.any_popup_or_select_open() || ed.dragging_split != 0 ||
           ed.top_view.panning || ed.top_view.dragging_nodes || ed.top_view.marquee_active {
            tip := $&ed.tooltip
            if tip.dismiss() { repaint(view, ed.id_root) }
        } else {
            hit := resolve_tooltip_hit(ed, view, input.x, input.y)
            now_t := time.instant()
            tip := $&ed.tooltip
            if tip.update_hover(&hit, now_t) {
                repaint(view, ed.id_root)
            }
        }
    }
    ed.apply_pointer_cursor(view)
    << 0
}

pub fn (ed $&Editor) tick_animations(view $&widgets.View, now time.Instant) {
    rm := ed.reduced_motion
    mods := $&ed.modals
    if mods.tick(now, rm) {
        repaint(view, ed.id_root)
    }
    tip := $&ed.tooltip
    if tip.tick(now) {
        repaint(view, ed.id_root)
    }
    if tick_tabs($&ed.stage_tabs, now, rm) { repaint(view, ed.id_stage_tabs) }
    if tick_tabs($&ed.left_tabs, now, rm) { repaint(view, ed.id_left_tabs) }
    if tick_tabs($&ed.insp_tabs, now, rm) { repaint(view, ed.id_insp_tabs) }
    if tick_field($&ed.name_field, now, rm) { repaint(view, ed.id_name_field) }
    if tick_field($&ed.prim_field, now, rm) { repaint(view, ed.id_prim_field) }
    if tick_field($&ed.pos_x, now, rm) { repaint(view, ed.id_pos_x) }
    if tick_field($&ed.pos_y, now, rm) { repaint(view, ed.id_pos_y) }
    if tick_field($&ed.pos_z, now, rm) { repaint(view, ed.id_pos_z) }
    if tick_field($&ed.rot_x, now, rm) { repaint(view, ed.id_rot_x) }
    if tick_field($&ed.rot_y, now, rm) { repaint(view, ed.id_rot_y) }
    if tick_field($&ed.rot_z, now, rm) { repaint(view, ed.id_rot_z) }
    if tick_field($&ed.scale_x, now, rm) { repaint(view, ed.id_scale_x) }
    if tick_field($&ed.scale_y, now, rm) { repaint(view, ed.id_scale_y) }
    if tick_field($&ed.scale_z, now, rm) { repaint(view, ed.id_scale_z) }
    if tick_field($&ed.surf_prim_field, now, rm) { repaint(view, ed.id_surf_prim_field) }
    if tick_field($&ed.lod_hyst_field, now, rm) { repaint(view, ed.id_lod_hyst_field) }
    if tick_field($&ed.lod_dist_field, now, rm) { repaint(view, ed.id_lod_dist_field) }
    if tick_field($&ed.lod_prim_field, now, rm) { repaint(view, ed.id_lod_prim_field) }
    comp_tick($&ed.comp, view, now, rm)
    modeling_tick($&ed.modeling, view, now, rm)
    panels_tick($&ed.panels, view, now, rm)
}

pub fn (ed &Editor) next_tick_deadline(now time.Instant) time.Instant {
    $deadline := ed.modals.next_tick(now, ed.reduced_motion)
    fields := [tabs_next_tick(&ed.stage_tabs, now), tabs_next_tick(&ed.left_tabs, now), tabs_next_tick(&ed.insp_tabs, now), field_next_tick(&ed.name_field, now, ed.reduced_motion), field_next_tick(&ed.prim_field, now, ed.reduced_motion), field_next_tick(&ed.pos_x, now, ed.reduced_motion), field_next_tick(&ed.pos_y, now, ed.reduced_motion), field_next_tick(&ed.pos_z, now, ed.reduced_motion), field_next_tick(&ed.rot_x, now, ed.reduced_motion), field_next_tick(&ed.rot_y, now, ed.reduced_motion), field_next_tick(&ed.rot_z, now, ed.reduced_motion), field_next_tick(&ed.scale_x, now, ed.reduced_motion), field_next_tick(&ed.scale_y, now, ed.reduced_motion), field_next_tick(&ed.scale_z, now, ed.reduced_motion), field_next_tick(&ed.surf_prim_field, now, ed.reduced_motion), field_next_tick(&ed.lod_hyst_field, now, ed.reduced_motion), field_next_tick(&ed.lod_dist_field, now, ed.reduced_motion), field_next_tick(&ed.lod_prim_field, now, ed.reduced_motion)]
    for next in fields {
        if !next.is_zero() && (deadline.is_zero() || next.before(deadline)) {
            deadline = next
        }
    }
    $d2 := comp_next_tick(&ed.comp, now, ed.reduced_motion, deadline)
    $d2b := modeling_next_tick(&ed.modeling, now, ed.reduced_motion, d2)
    $d3 := panels_next_tick(&ed.panels, now, ed.reduced_motion, d2b)
    << ed.tooltip.next_tick(d3)
}
