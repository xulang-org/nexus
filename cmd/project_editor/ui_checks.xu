@main

resource #"github.com/xulang-org/nexus/resources/scene"
snapshot #"github.com/xulang-org/nexus/internal/file_snapshot"
#ui
#ui/draw
#ui/layout
widgets #ui/widgets
#image/png
#math
#os
#path/filepath
#strings
#errors

fn assert_ui(cond bool, msg string) int {
    if !cond {
        >> errors.new("ui check: " + msg)
    }
    << 0
}

fn assert_ui_near(actual f64, expected f64, tol f64, msg string) int {
    if math.abs(actual - expected) > tol {
        >> errors.new("ui check: " + msg + " (got " + fmt_coord(actual) + ", want " + fmt_coord(expected) + ")")
    }
    << 0
}

fn rect_contained(inner &layout.Rect, outer &layout.Rect) bool {
    << inner.x >= outer.x - 0.5 &&
        inner.y >= outer.y - 0.5 &&
        inner.x + inner.width <= outer.x + outer.width + 0.5 &&
        inner.y + inner.height <= outer.y + outer.height + 0.5
}

pub fn verify_layout_geometry(ed &Editor, view &widgets.View, w f64, h f64, tag string) int {
    rb := view.node_bounds(ed.id_root) or >>
    tb := view.node_bounds(ed.id_toolbar) or >>
    wb := view.node_bounds(ed.id_workspace) or >>
    fb := view.node_bounds(ed.id_footer) or >>
    lp := view.node_bounds(ed.id_left_pane) or >>
    ls := view.node_bounds(ed.id_left_split) or >>
    cp := view.node_bounds(ed.id_center_pane) or >>
    rs := view.node_bounds(ed.id_right_split) or >>
    rp := view.node_bounds(ed.id_right_pane) or >>
    tv := view.node_bounds(ed.id_top_view) or >>
    tr := view.node_bounds(ed.id_tree) or >>
    ab := view.node_bounds(ed.id_apply_btn) or >>

    assert_ui_near(rb.width, w, 1.0, tag + " root width") or >>
    assert_ui_near(rb.height, h, 1.0, tag + " root height") or >>
    assert_ui(tb.y >= 0.0 && tb.height > 20.0, tag + " toolbar positive") or >>
    assert_ui(wb.y >= tb.y + tb.height - 0.5, tag + " workspace below toolbar") or >>
    assert_ui(fb.y >= wb.y + wb.height - 0.5, tag + " footer below workspace") or >>
    assert_ui(lp.width >= f64(MIN_LEFT_W) - 0.5, tag + " left min width") or >>
    assert_ui(cp.width >= f64(MIN_CENTER_W) - 0.5, tag + " center min width") or >>
    assert_ui(rp.width >= f64(MIN_RIGHT_W) - 0.5, tag + " right min width") or >>

    assert_ui(ls.x >= lp.x + lp.width - 0.5, tag + " left split follows left pane") or >>
    assert_ui(cp.x >= ls.x + ls.width - 0.5, tag + " center follows left split") or >>
    assert_ui(rs.x >= cp.x + cp.width - 0.5, tag + " right split follows center") or >>
    assert_ui(rp.x >= rs.x + rs.width - 0.5, tag + " right pane follows right split") or >>

    assert_ui(rect_contained(&lp, &wb), tag + " left pane inside workspace") or >>
    assert_ui(rect_contained(&cp, &wb), tag + " center pane inside workspace") or >>
    assert_ui(rect_contained(&rp, &wb), tag + " right pane inside workspace") or >>
    assert_ui(rect_contained(&tr, &lp), tag + " tree inside left pane") or >>
    assert_ui(rect_contained(&tv, &cp), tag + " top_view inside center pane") or >>
    assert_ui(rect_contained(&ab, &rp), tag + " apply_btn inside right pane") or >>
    << 0
}

fn clone_with_moved_node(doc &resource.Document, target int, dx f64) resource.Document {
    $nodes := []resource.NodeData{}
    for i in 0:doc.node_count() {
        $nd := doc.describe_node(i) or >>
        if i == target {
            if nd.kind == resource.NODE_3D {
                nd.local_3d.c3.x = nd.local_3d.c3.x + dx
            } else if nd.kind == resource.NODE_2D {
                nd.local.tx = nd.local.tx + dx
            }
        }
        nodes.push(nd)
    }
    $refs := []resource.ResourceReference{}
    for i in 0:doc.resource_count() {
        r := doc.resource(i) or >>
        refs.push(resource.ResourceReference{uid: r.uid + "", kind: r.kind + "", path: r.path + "", content_hash: r.content_hash + ""})
    }
    $surfs := []resource.Surface{}
    for i in 0:doc.surface_count() {
        s := doc.surface(i) or >>
        $lvls := []resource.SurfaceLevel{}
        for k in 0:s.levels.len {
            lv := &s.levels[k]
            lvls.push(resource.SurfaceLevel{distance: lv.distance, resource_uid: lv.resource_uid + "", primitive: lv.primitive})
        }
        surfs.push(resource.Surface{node: s.node, resource_uid: s.resource_uid + "", primitive: s.primitive, levels: lvls, hysteresis: s.hysteresis})
    }
    $buses := []resource.AudioBus{}
    for i in 0:doc.audio_bus_count() { buses.push(doc.audio_bus(i) or >>) }
    $emitters := []resource.AudioEmitter{}
    for i in 0:doc.audio_count() { emitters.push(doc.audio_emitter(i) or >>) }
    $scripts := []resource.ScriptAttachment{}
    for i in 0:doc.script_count() { scripts.push(doc.script(i) or >>) }
    $conns := []resource.ScriptConnection{}
    for i in 0:doc.script_connection_count() { conns.push(doc.script_connection(i) or >>) }
    $lights := []resource.LightAttachment{}
    for i in 0:doc.light_count() { lights.push(doc.light(i) or >>) }
    base := resource.make_document(nodes) or >>
    << resource.with_attachments(&base, refs, surfs, buses, emitters, scripts, conns, lights) or >>
}

fn try_apply_invalid_inspector(ed $&Editor, view $&widgets.View) bool {
    _ := ed.apply_inspector(view) or (err) {
        _ := err
        << false
    }
    << true
}

pub fn run_ui_self_checks(view $&widgets.View, ed $&Editor, context &draw.Context, identity &ui.CanvasEvent, output_dir string) int {
    _ := ed.sync_layout(view, 1240.0, 700.0) or >>
    verify_layout_geometry(ed, view, 1240.0, 700.0, "1240x700") or >>
    c_default := layout.tight(1240.0, 700.0) or >>
    $snap_default := widgets.snapshot_styled(view, &c_default, 1.0, ed) or >>
    assert_ui(snap_default.pixel_width > 0 && snap_default.pixel_height > 0, "1240x700 snapshot pixels") or >>
    if output_dir.len > 0 {
        os.mkdir_all(output_dir + "") or >>
        pixels := snap_default.rgba_bytes() or >>
        encoded := png.encode_rgba_bytes(&pixels, snap_default.pixel_width, snap_default.pixel_height) or >>
        png_path := filepath.join([output_dir + "", "editor-check.png"])
        snapshot.write_atomic(png_path, &encoded) or >>
    }
    _ := snap_default.dispose() or >>

    _ := ed.sync_layout(view, 940.0, 560.0) or >>
    verify_layout_geometry(ed, view, 940.0, 560.0, "940x560") or >>
    c_min := layout.tight(940.0, 560.0) or >>
    $snap_min := widgets.snapshot_styled(view, &c_min, 1.0, ed) or >>
    assert_ui(snap_min.pixel_width > 0 && snap_min.pixel_height > 0, "940x560 snapshot pixels") or >>
    _ := snap_min.dispose() or >>

    // Verify splitter clamping preserves minimum pane widths under extreme drag positions.
    ed.left_w = 5000.0
    _ := ed.sync_layout(view, 940.0, 560.0) or >>
    assert_ui(ed.left_w >= f64(MIN_LEFT_W), "left pane >= MIN_LEFT_W") or >>
    center_w := ed.viewport_w - ed.left_w - ed.right_w - f64(SPLITTER_W) * 2.0
    assert_ui(center_w >= f64(MIN_CENTER_W) - 0.5, "center pane >= MIN_CENTER_W") or >>

    // Verify Name * byte counter and invalid name highlighting without touching disk.
    if ed.stage_pts.len > 1 {
        ed.selected_node = 1
        set_field_val($&ed.name_field, &"   ")
        rejected := !try_apply_invalid_inspector(ed, view)
        assert_ui(rejected, "blank name rejected") or >>
        assert_ui(ed.name_error.len > 0 && ed.name_field.is_invalid(), "invalid name highlights Name field") or >>
        long_256 := strings.repeat(&"a", 256)
        set_field_val($&ed.name_field, &long_256)
        ed.refresh_name_decoration(&long_256)
        $snap_err := widgets.snapshot_styled(view, &c_min, 1.0, ed) or >>
        _ := snap_err.dispose() or >>

        // Verify merging 3D View edits invalidates child pane boundaries & updates inspector/stage cleanly.
        ed.refresh_after_document_change(false, view)
        $snap_before := widgets.snapshot_styled(view, &c_min, 1.0, ed) or >>
        bytes_before := snap_before.rgba_bytes() or >>
        _ := snap_before.dispose() or >>
        old_px := ed.pos_x.value()

        cur_doc := ed.draft.document() or >>
        edited_doc := clone_with_moved_node(&cur_doc, 1, 1.25) or >>
        rev := ed.draft.current + ""
        d := $&ed.draft
        d.merge_viewport(&edited_doc, &rev) or >>
        ed.refresh_after_document_change(false, view)

        assert_ui(ed.draft.dirty(), "merge_viewport marks draft dirty") or >>
        assert_ui(ed.pos_x.value() != old_px, "merge_viewport updates inspector X") or >>
        $snap_after := widgets.snapshot_styled(view, &c_min, 1.0, ed) or >>
        bytes_after := snap_after.rgba_bytes() or >>
        st_after := view.stats()
        _ := snap_after.dispose() or >>
        assert_ui(st_after.recorded_boundaries >= 5, "all panel boundaries re-record after merge") or >>
        assert_ui(bytes_after != bytes_before, "rendered pixels change after viewport merge") or >>

        d_undo := $&ed.draft
        d_undo.undo_edit() or >>
        ed.refresh_after_document_change(false, view)
        assert_ui(!ed.draft.dirty() && ed.pos_x.value() == old_px, "undo reverts merged viewport edit") or >>
    }

    // Verify snap modal retains invalid input text alongside validation error state.
    loaded := default_snap_settings()
    $mods := create_modals(context, identity, &loaded)
    mods.open_snap(&loaded)
    set_field_val($&mods.snap_move, &"bad-move")
    mods.snap_move_err = "Invalid"
    mods.sync_snap_decorations()
    assert_ui(mods.snap_move.value() == "bad-move", "modal preserves invalid text") or >>
    assert_ui(mods.snap_move.is_invalid(), "modal marks invalid snap field") or >>

    // Verify modal dynamic cursors: field text box vs clear button vs modal buttons vs backdrop.
    mods.layout(1240.0, 700.0, &ed.styles)
    mv_b := mods.snap_move.bounds()
    assert_ui(mods.cursor_at(mv_b.x + 24.0, mv_b.y + 24.0) == ui.CURSOR_TEXT, "modal field text cursor") or >>
    assert_ui(mods.cursor_at(mv_b.x + mv_b.width - 18.0, mv_b.y + 24.0) == ui.CURSOR_HAND, "modal field clear x cursor") or >>
    assert_ui(mods.cursor_at(10.0, 10.0) == ui.CURSOR_DEFAULT, "modal backdrop default cursor") or >>
    mods.dispose()

    // Verify all compact inspector & prim fields can focus, plus browser-accurate cursor resolution.
    _ := ed.sync_layout(view, 1240.0, 700.0) or >>
    if ed.stage_pts.len > 1 {
        ed.select_scene_node(1, view)
    }
    focus_field($&ed.pos_x, true)
    assert_ui(ed.pos_x.is_focused(), "compact X field can focus") or >>
    focus_field($&ed.pos_x, false)
    focus_field($&ed.rot_x, true)
    assert_ui(ed.rot_x.is_focused(), "compact RX field can focus") or >>
    focus_field($&ed.rot_x, false)
    focus_field($&ed.scale_x, true)
    assert_ui(ed.scale_x.is_focused(), "compact SX field can focus") or >>
    focus_field($&ed.scale_x, false)
    focus_field($&ed.prim_field, true)
    assert_ui(ed.prim_field.is_focused(), "compact Prim field can focus") or >>
    focus_field($&ed.prim_field, false)

    undo_b := view.node_bounds(ed.id_undo_btn) or >>
    assert_ui(!ed.undo_btn.is_enabled(), "undo starts disabled") or >>
    assert_ui(ed.resolve_cursor(view, undo_b.x + 8.0, undo_b.y + 8.0) == ui.CURSOR_DEFAULT, "disabled undo has default cursor") or >>
    add_b := view.node_bounds(ed.id_add_3d_btn) or >>
    assert_ui(ed.resolve_cursor(view, add_b.x + 8.0, add_b.y + 8.0) == ui.CURSOR_HAND, "enabled +3D button has hand cursor") or >>
    ls_b := view.node_bounds(ed.id_left_split) or >>
    assert_ui(ed.resolve_cursor(view, ls_b.x + 2.0, ls_b.y + 20.0) == ui.CURSOR_RESIZE_HORIZONTAL, "splitter has resize cursor") or >>

    nm_b := view.node_bounds(ed.id_name_field) or >>
    assert_ui(ed.resolve_cursor(view, nm_b.x + 24.0, nm_b.y + 24.0) == ui.CURSOR_TEXT, "Name input box has text cursor") or >>
    assert_ui(ed.resolve_cursor(view, nm_b.x + nm_b.width - 18.0, nm_b.y + 24.0) == ui.CURSOR_HAND, "Name clear button has hand cursor") or >>
    assert_ui(ed.resolve_cursor(view, nm_b.x + 24.0, nm_b.y + nm_b.height - 4.0) == ui.CURSOR_DEFAULT, "Name helper area has default cursor") or >>

    // Read-only metadata & status displays are selectable and copyable.
    meta_b := view.node_bounds(ed.id_asset_meta) or >>
    st_b := view.node_bounds(ed.id_status_txt) or >>
    assert_ui(ed.resolve_cursor(view, meta_b.x + 8.0, meta_b.y + 8.0) == ui.CURSOR_TEXT, "asset meta has text cursor") or >>
    assert_ui(ed.resolve_cursor(view, st_b.x + 8.0, st_b.y + 8.0) == ui.CURSOR_TEXT, "footer status has text cursor") or >>
    st_txt := $&ed.status_txt
    assert_ui(st_txt.select_all(), "status text select_all works") or >>
    assert_ui(ed.status_txt.selected_text().len > 0, "status text exposes selection") or >>

    // Top View cursors: default on empty ground, crosshair in place mode, hand on hovered node marker.
    tv_b := view.node_bounds(ed.id_top_view) or >>
    ed.top_view.hover_node = -1
    ed.placing_mode = false
    assert_ui(ed.resolve_cursor(view, tv_b.x + 12.0, tv_b.y + 12.0) == ui.CURSOR_DEFAULT, "top view idle default cursor") or >>
    ed.top_view.hover_node = 0
    assert_ui(ed.resolve_cursor(view, tv_b.x + 12.0, tv_b.y + 12.0) == ui.CURSOR_HAND, "top view node hover hand cursor") or >>
    ed.placing_mode = true
    assert_ui(ed.resolve_cursor(view, tv_b.x + 12.0, tv_b.y + 12.0) == ui.CURSOR_CROSSHAIR, "top view place mode crosshair cursor") or >>
    ed.placing_mode = false
    ed.top_view.hover_node = -1

    // Selection + Enter submit inside inspector updates node cleanly.
    if ed.stage_pts.len > 1 {
        set_field_val($&ed.name_field, &"RenamedCheck")
        _ := ed.apply_inspector(view) or >>
        doc_after := ed.draft.document() or >>
        nd_after := doc_after.describe_node(1) or >>
        assert_ui(nd_after.name == "RenamedCheck", "inspector apply commits updated name") or >>
    }
    << 0
}
