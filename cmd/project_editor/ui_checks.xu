@main

fm #"github.com/xulang-org/nexus/foundation/math"
resource #"github.com/xulang-org/nexus/resources/scene"
snapshot #"github.com/xulang-org/nexus/internal/file_snapshot"
#ui
#ui/draw
#ui/layout
widgets #ui/widgets
#image/png
#math
#os
#path/filepath
#strings
#time
#errors

fn assert_ui(cond bool, msg string) int {
    if !cond {
        >> errors.new("ui check: " + msg)
    }
    << 0
}

fn assert_ui_near(actual f64, expected f64, tol f64, msg string) int {
    if math.abs(actual - expected) > tol {
        >> errors.new("ui check: " + msg + " (got " + fmt_coord(actual) + ", want " + fmt_coord(expected) + ")")
    }
    << 0
}

fn rect_contained(inner &layout.Rect, outer &layout.Rect) bool {
    << inner.x >= outer.x - 0.5 &&
        inner.y >= outer.y - 0.5 &&
        inner.x + inner.width <= outer.x + outer.width + 0.5 &&
        inner.y + inner.height <= outer.y + outer.height + 0.5
}

pub fn verify_layout_geometry(ed &Editor, view &widgets.View, w f64, h f64, tag string) int {
    rb := view.node_bounds(ed.id_root) or >>
    tb := view.node_bounds(ed.id_toolbar) or >>
    wb := view.node_bounds(ed.id_workspace) or >>
    fb := view.node_bounds(ed.id_footer) or >>
    lp := view.node_bounds(ed.id_left_pane) or >>
    ls := view.node_bounds(ed.id_left_split) or >>
    cp := view.node_bounds(ed.id_center_pane) or >>
    rs := view.node_bounds(ed.id_right_split) or >>
    rp := view.node_bounds(ed.id_right_pane) or >>
    tv := view.node_bounds(ed.id_top_view) or >>
    tr := view.node_bounds(ed.id_tree) or >>
    ab := view.node_bounds(ed.id_apply_btn) or >>

    assert_ui_near(rb.width, w, 1.0, tag + " root width") or >>
    assert_ui_near(rb.height, h, 1.0, tag + " root height") or >>
    assert_ui(tb.y >= 0.0 && tb.height > 20.0, tag + " toolbar positive") or >>
    assert_ui(wb.y >= tb.y + tb.height - 0.5, tag + " workspace below toolbar") or >>
    assert_ui(fb.y >= wb.y + wb.height - 0.5, tag + " footer below workspace") or >>
    assert_ui(lp.width >= f64(MIN_LEFT_W) - 0.5, tag + " left min width") or >>
    assert_ui(cp.width >= f64(MIN_CENTER_W) - 0.5, tag + " center min width") or >>
    assert_ui(rp.width >= f64(MIN_RIGHT_W) - 0.5, tag + " right min width") or >>

    assert_ui(ls.x >= lp.x + lp.width - 0.5, tag + " left split follows left pane") or >>
    assert_ui(cp.x >= ls.x + ls.width - 0.5, tag + " center follows left split") or >>
    assert_ui(rs.x >= cp.x + cp.width - 0.5, tag + " right split follows center") or >>
    assert_ui(rp.x >= rs.x + rs.width - 0.5, tag + " right pane follows right split") or >>

    assert_ui(rect_contained(&lp, &wb), tag + " left pane inside workspace") or >>
    assert_ui(rect_contained(&cp, &wb), tag + " center pane inside workspace") or >>
    assert_ui(rect_contained(&rp, &wb), tag + " right pane inside workspace") or >>
    assert_ui(rect_contained(&tv, &cp), tag + " top_view inside center pane") or >>
    if ed.insp_tab != 2 {
        assert_ui(rect_contained(&ab, &rp), tag + " apply_btn inside right pane") or >>
    }

    op_b := view.node_bounds(ed.panels.id_open_proj_btn) or >>
    ss_b := view.node_bounds(ed.id_scene_select) or >>
    ns_b := view.node_bounds(ed.id_new_scene_btn) or >>
    sm_b := view.node_bounds(ed.panels.id_scene_mgr_btn) or >>
    st_b := view.node_bounds(ed.id_stage_tabs) or >>
    sv_b := view.node_bounds(ed.id_save_btn) or >>
    pv_b := view.node_bounds(ed.id_preview_btn) or >>
    ex_b := view.node_bounds(ed.panels.id_export_btn) or >>
    lg_b := view.node_bounds(ed.panels.id_lang_btn) or >>
    db_b := view.node_bounds(ed.id_dirty_badge) or >>
    assert_ui(rect_contained(&op_b, &tb), tag + " open_proj_btn inside toolbar") or >>
    assert_ui(rect_contained(&ss_b, &tb), tag + " scene_select inside toolbar") or >>
    assert_ui(ss_b.width >= 140.0, tag + " scene_select wide enough") or >>
    assert_ui(rect_contained(&ns_b, &tb), tag + " new_scene_btn inside toolbar") or >>
    assert_ui(rect_contained(&sm_b, &tb), tag + " scene_mgr_btn inside toolbar") or >>
    assert_ui(rect_contained(&st_b, &tb), tag + " stage_tabs inside toolbar") or >>
    assert_ui(rect_contained(&sv_b, &tb), tag + " save_btn inside toolbar") or >>
    assert_ui(rect_contained(&pv_b, &tb), tag + " preview_btn inside toolbar") or >>
    assert_ui(rect_contained(&ex_b, &tb), tag + " export_btn inside toolbar") or >>
    assert_ui(rect_contained(&lg_b, &tb), tag + " lang_btn inside toolbar") or >>
    assert_ui(rect_contained(&db_b, &tb), tag + " dirty_badge inside toolbar") or >>

    assert_ui(ed.tree.scroll_offset() <= 0.5, tag + " tree scroll starts at top") or >>

    lt_b := view.node_bounds(ed.id_left_tabs) or >>
    assert_ui(rect_contained(&lt_b, &lp), tag + " left_tabs inside left pane") or >>
    lsc_b := view.node_bounds(ed.id_left_scene_box) or >>
    las_b := view.node_bounds(ed.id_left_assets_box) or >>
    if ed.left_tab == 0 {
        tb_row := view.node_bounds(ed.id_tree_btns) or >>
        an_b := view.node_bounds(ed.id_add_node_select) or >>
        dp_b := view.node_bounds(ed.id_dup_btn) or >>
        dl_b := view.node_bounds(ed.id_del_btn) or >>
        tf_b := view.node_bounds(ed.panels.id_tree_filter) or >>
        assert_ui(rect_contained(&tr, &lp), tag + " tree inside left pane") or >>
        assert_ui(rect_contained(&an_b, &tb_row), tag + " add_node_select inside tree_btns") or >>
        assert_ui(rect_contained(&dp_b, &tb_row), tag + " dup inside tree_btns") or >>
        assert_ui(rect_contained(&dl_b, &tb_row), tag + " del inside tree_btns") or >>
        assert_ui(rect_contained(&tf_b, &lp), tag + " tree_filter inside left pane") or >>
        assert_ui(las_b.height <= 0.5, tag + " assets box collapsed on Scene tab") or >>
    } else {
        ah_row := view.node_bounds(ed.id_assets_hdr_row) or >>
        im_b := view.node_bounds(ed.id_import_btn) or >>
        rl_b := view.node_bounds(ed.panels.id_relocate_btn) or >>
        rm_b := view.node_bounds(ed.panels.id_remove_asset_btn) or >>
        al_b := view.node_bounds(ed.id_asset_list) or >>
        am_b := view.node_bounds(ed.id_asset_meta) or >>
        assert_ui(rect_contained(&im_b, &ah_row), tag + " import inside assets_hdr_row") or >>
        assert_ui(rect_contained(&rl_b, &ah_row), tag + " relocate inside assets_hdr_row") or >>
        assert_ui(rect_contained(&rm_b, &ah_row), tag + " remove_asset inside assets_hdr_row") or >>
        assert_ui(rect_contained(&al_b, &lp), tag + " asset_list inside left pane") or >>
        assert_ui(rect_contained(&am_b, &lp), tag + " asset_meta inside left pane") or >>
        assert_ui(lsc_b.height <= 0.5, tag + " scene box collapsed on Assets tab") or >>
    }

    sb_row := view.node_bounds(ed.id_stage_bar) or >>
    ax_b := view.node_bounds(ed.id_stage_axis_btn) or >>
    gs_b := view.node_bounds(ed.id_stage_snap_btn) or >>
    ft_b := view.node_bounds(ed.id_fit_btn) or >>
    sn_b := view.node_bounds(ed.id_snap_btn) or >>
    mb_row := view.node_bounds(ed.modeling.id_model_bar) or >>
    assert_ui(rect_contained(&ax_b, &sb_row), tag + " axis_btn inside stage_bar") or >>
    assert_ui(rect_contained(&gs_b, &sb_row), tag + " stage_snap_btn inside stage_bar") or >>
    assert_ui(rect_contained(&ft_b, &sb_row), tag + " fit_btn inside stage_bar") or >>
    assert_ui(rect_contained(&sn_b, &sb_row), tag + " snap_btn inside stage_bar") or >>
    assert_ui(rect_contained(&mb_row, &cp), tag + " model_bar inside center_pane") or >>
    assert_ui(tv.y >= mb_row.y + mb_row.height - 0.5, tag + " top_view below model_bar") or >>
    if ed.modeling.stage_3d_visible {
        for gbi in [MB_GIZMO_MOVE, MB_GIZMO_ROT, MB_GIZMO_SCALE, MB_BOX, MB_WEDGE, MB_STAIR, MB_CYL, MB_ARCH, MB_SPHERE, MB_CSG, MB_WIRE] {
            gb_b := view.node_bounds(ed.modeling.button_ids[gbi]) or >>
            assert_ui(rect_contained(&gb_b, &sb_row), tag + " stage btn " + str(gbi) + " inside stage_bar") or >>
        }
    }
    if ed.modeling.bar_visible {
        if ed.modeling.csg_visible {
            for cbi in [MB_CSG_ADD_BOX, MB_CSG_ADD_CUT, MB_CSG_CYCLE, MB_CSG_BAKE, MB_EXPORT_GLB] {
                cb_b := view.node_bounds(ed.modeling.button_ids[cbi]) or >>
                assert_ui(rect_contained(&cb_b, &mb_row), tag + " csg btn " + str(cbi) + " inside model_bar") or >>
            }
        } else {
            for mbi in [MB_MODE_OBJ, MB_MODE_VERT, MB_MODE_EDGE, MB_MODE_FACE, MB_EXTRUDE, MB_INSET, MB_BEVEL, MB_SUBDIV, MB_FLIP, MB_DEL_FACE, MB_WELD, MB_UV, MB_EXPORT_GLB] {
                mb_b := view.node_bounds(ed.modeling.button_ids[mbi]) or >>
                assert_ui(rect_contained(&mb_b, &mb_row), tag + " modeling btn " + str(mbi) + " inside model_bar") or >>
            }
        }
    } else {
        assert_ui(mb_row.height <= 0.5, tag + " contextual model_bar collapsed when inactive") or >>
    }
    << 0
}

fn clone_with_moved_node(doc &resource.Document, target int, dx f64) resource.Document {
    $nodes := []resource.NodeData{}
    for i in 0:doc.node_count() {
        $nd := doc.describe_node(i) or >>
        if i == target {
            if nd.kind == resource.NODE_3D {
                nd.local_3d.c3.x = nd.local_3d.c3.x + dx
            } else if nd.kind == resource.NODE_2D {
                nd.local.tx = nd.local.tx + dx
            }
        }
        nodes.push(nd)
    }
    $refs := []resource.ResourceReference{}
    for i in 0:doc.resource_count() {
        r := doc.resource(i) or >>
        refs.push(resource.ResourceReference{uid: r.uid + "", kind: r.kind + "", path: r.path + "", content_hash: r.content_hash + ""})
    }
    $surfs := []resource.Surface{}
    for i in 0:doc.surface_count() {
        s := doc.surface(i) or >>
        $lvls := []resource.SurfaceLevel{}
        for k in 0:s.levels.len {
            lv := &s.levels[k]
            lvls.push(resource.SurfaceLevel{distance: lv.distance, resource_uid: lv.resource_uid + "", primitive: lv.primitive})
        }
        surfs.push(resource.Surface{node: s.node, resource_uid: s.resource_uid + "", primitive: s.primitive, levels: lvls, hysteresis: s.hysteresis})
    }
    $buses := []resource.AudioBus{}
    for i in 0:doc.audio_bus_count() { buses.push(doc.audio_bus(i) or >>) }
    $emitters := []resource.AudioEmitter{}
    for i in 0:doc.audio_count() { emitters.push(doc.audio_emitter(i) or >>) }
    $scripts := []resource.ScriptAttachment{}
    for i in 0:doc.script_count() { scripts.push(doc.script(i) or >>) }
    $conns := []resource.ScriptConnection{}
    for i in 0:doc.script_connection_count() { conns.push(doc.script_connection(i) or >>) }
    $lights := []resource.LightAttachment{}
    for i in 0:doc.light_count() { lights.push(doc.light(i) or >>) }
    $sprites := []resource.Sprite3DAttachment{}
    for i in 0:doc.sprite_3d_count() { sprites.push(doc.sprite_3d(i) or >>) }
    $tilemaps := []resource.TileMap2DAttachment{}
    for i in 0:doc.tilemap_2d_count() { tilemaps.push(doc.tilemap_2d(i) or >>) }
    base := resource.make_document(nodes) or >>
    v9 := resource.with_all_attachments(&base, refs, surfs, buses, emitters, scripts, conns, lights, sprites, tilemaps) or >>
    << copy_modeling_attachments(doc, &v9) or >>
}

fn try_apply_invalid_inspector(ed $&Editor, view $&widgets.View) bool {
    _ := ed.apply_inspector(view) or (err) {
        _ := err
        << false
    }
    << true
}

pub fn run_ui_self_checks(view $&widgets.View, ed $&Editor, context &draw.Context, identity &ui.CanvasEvent, output_dir string) int {
    _ := ed.sync_layout(view, 1240.0, 700.0) or >>
    verify_layout_geometry(ed, view, 1240.0, 700.0, "1240x700") or >>
    c_default := layout.tight(1240.0, 700.0) or >>
    $snap_default := widgets.snapshot_styled(view, &c_default, 1.0, ed) or >>
    assert_ui(snap_default.pixel_width > 0 && snap_default.pixel_height > 0, "1240x700 snapshot pixels") or >>
    if output_dir.len > 0 {
        os.mkdir_all(output_dir + "") or >>
        pixels := snap_default.rgba_bytes() or >>
        encoded := png.encode_rgba_bytes(&pixels, snap_default.pixel_width, snap_default.pixel_height) or >>
        png_path := filepath.join([output_dir + "", "editor-check.png"])
        snapshot.write_atomic(png_path, &encoded) or >>
    }
    _ := snap_default.dispose() or >>

    _ := ed.sync_layout(view, 940.0, 560.0) or >>
    verify_layout_geometry(ed, view, 940.0, 560.0, "940x560") or >>
    c_min := layout.tight(940.0, 560.0) or >>
    $snap_min := widgets.snapshot_styled(view, &c_min, 1.0, ed) or >>
    assert_ui(snap_min.pixel_width > 0 && snap_min.pixel_height > 0, "940x560 snapshot pixels") or >>
    _ := snap_min.dispose() or >>

    // Verify splitter clamping preserves minimum pane widths under extreme drag positions.
    ed.left_w = 5000.0
    _ := ed.sync_layout(view, 940.0, 560.0) or >>
    assert_ui(ed.left_w >= f64(MIN_LEFT_W), "left pane >= MIN_LEFT_W") or >>
    center_w := ed.viewport_w - ed.left_w - ed.right_w - f64(SPLITTER_W) * 2.0
    assert_ui(center_w >= f64(MIN_CENTER_W) - 0.5, "center pane >= MIN_CENTER_W") or >>

    // Verify Name * byte counter and invalid name highlighting without touching disk.
    if ed.stage_pts.len > 1 {
        ed.selected_node = 1
        set_field_val($&ed.name_field, &"   ")
        rejected := !try_apply_invalid_inspector(ed, view)
        assert_ui(rejected, "blank name rejected") or >>
        assert_ui(ed.name_error.len > 0 && ed.name_field.is_invalid(), "invalid name highlights Name field") or >>
        long_256 := strings.repeat(&"a", 256)
        set_field_val($&ed.name_field, &long_256)
        ed.refresh_name_decoration(&long_256)
        $snap_err := widgets.snapshot_styled(view, &c_min, 1.0, ed) or >>
        _ := snap_err.dispose() or >>

        // Verify merging 3D View edits invalidates child pane boundaries & updates inspector/stage cleanly.
        ed.refresh_after_document_change(false, view)
        $snap_before := widgets.snapshot_styled(view, &c_min, 1.0, ed) or >>
        bytes_before := snap_before.rgba_bytes() or >>
        _ := snap_before.dispose() or >>
        old_px := ed.pos_x.value()

        cur_doc := ed.draft.document() or >>
        edited_doc := clone_with_moved_node(&cur_doc, 1, 1.25) or >>
        rev := ed.draft.current + ""
        d := $&ed.draft
        d.merge_viewport(&edited_doc, &rev) or >>
        ed.refresh_after_document_change(false, view)

        assert_ui(ed.draft.dirty(), "merge_viewport marks draft dirty") or >>
        assert_ui(ed.pos_x.value() != old_px, "merge_viewport updates inspector X") or >>
        $snap_after := widgets.snapshot_styled(view, &c_min, 1.0, ed) or >>
        bytes_after := snap_after.rgba_bytes() or >>
        st_after := view.stats()
        _ := snap_after.dispose() or >>
        assert_ui(st_after.recorded_boundaries >= 5, "all panel boundaries re-record after merge") or >>
        assert_ui(bytes_after != bytes_before, "rendered pixels change after viewport merge") or >>

        d_undo := $&ed.draft
        d_undo.undo_edit() or >>
        ed.refresh_after_document_change(false, view)
        assert_ui(!ed.draft.dirty() && ed.pos_x.value() == old_px, "undo reverts merged viewport edit") or >>
    }

    // Verify snap modal retains invalid input text alongside validation error state.
    loaded := default_snap_settings()
    $mods := create_modals(context, identity, &loaded)
    mods.open_snap(&loaded)
    set_field_val($&mods.fields[MF_SNAP_MOVE], &"bad-move")
    mods.snap_move_err = "Invalid"
    mods.sync_snap_decorations()
    assert_ui(mods.fields[MF_SNAP_MOVE].value() == "bad-move", "modal preserves invalid text") or >>
    assert_ui(mods.fields[MF_SNAP_MOVE].is_invalid(), "modal marks invalid snap field") or >>

    // Verify modal dynamic cursors: field text box vs clear button vs disabled modal button vs backdrop.
    mods.layout(1240.0, 700.0, &ed.styles)
    mv_b := mods.fields[MF_SNAP_MOVE].bounds()
    assert_ui(mods.cursor_at(mv_b.x + 24.0, mv_b.y + 24.0) == ui.CURSOR_TEXT, "modal field text cursor") or >>
    assert_ui(mods.cursor_at(mv_b.x + mv_b.width - 18.0, mv_b.y + 24.0) == ui.CURSOR_HAND, "modal field clear x cursor") or >>
    assert_ui(mods.cursor_at(10.0, 10.0) == ui.CURSOR_DEFAULT, "modal backdrop default cursor") or >>
    mods.open_scene_manage(&"main", 1)
    mods.layout(1240.0, 700.0, &ed.styles)
    del_m_b := mods.buttons[MB_MGR_DEL].bounds()
    cls_m_b := mods.buttons[MB_MGR_CLOSE].bounds()
    assert_ui(mods.cursor_at(del_m_b.x + 8.0, del_m_b.y + 8.0) == ui.CURSOR_DEFAULT, "disabled modal delete button has default cursor") or >>
    assert_ui(mods.cursor_at(cls_m_b.x + 8.0, cls_m_b.y + 8.0) == ui.CURSOR_HAND, "enabled modal close button has hand cursor") or >>
    mods.open_export(&"dist/export")
    mods.layout(1240.0, 700.0, &ed.styles)
    assert_ui(mods.fields[MF_EXPORT_DIR].value() == "dist/export", "export modal initializes directory field") or >>
    ex_b := mods.fields[MF_EXPORT_DIR].bounds()
    ex_x := ex_b.x + ex_b.width - 18.0
    ex_y := ex_b.y + 24.0
    ex_dn := ui.InputEvent{
        kind: ui.EV_POINTER_DOWN, window_id: identity.window_id, canvas_id: identity.canvas_id, generation: identity.generation,
        x: ex_x, y: ex_y, dx: 0.0, dy: 0.0, button: ui.BUTTON_LEFT, buttons: 1, modifiers: 0, key: 0, scan: 0, repeat: 0, click_count: 1, time_ns: 940000000
    }
    ex_up := ui.InputEvent{
        kind: ui.EV_POINTER_UP, window_id: identity.window_id, canvas_id: identity.canvas_id, generation: identity.generation,
        x: ex_x, y: ex_y, dx: 0.0, dy: 0.0, button: ui.BUTTON_LEFT, buttons: 0, modifiers: 0, key: 0, scan: 0, repeat: 0, click_count: 1, time_ns: 945000000
    }
    _ := route_export_widgets($&mods, &ex_dn)
    _ := route_export_widgets($&mods, &ex_up)
    assert_ui(mods.fields[MF_EXPORT_DIR].value() == "", "clicking export field clear x clears directory text") or >>
    mods.dispose()

    // Verify all compact inspector & prim fields can focus, plus browser-accurate cursor resolution.
    _ := ed.sync_layout(view, 1240.0, 700.0) or >>
    if ed.stage_pts.len > 1 {
        ed.select_scene_node(1, view)
    }
    ed.set_insp_tab(0, view)
    focus_field($&ed.pos_x, true)
    assert_ui(ed.pos_x.is_focused(), "compact X field can focus") or >>
    focus_field($&ed.pos_x, false)
    focus_field($&ed.rot_x, true)
    assert_ui(ed.rot_x.is_focused(), "compact RX field can focus") or >>
    focus_field($&ed.rot_x, false)
    focus_field($&ed.scale_x, true)
    assert_ui(ed.scale_x.is_focused(), "compact SX field can focus") or >>
    focus_field($&ed.scale_x, false)

    // Verify Left Pane Assets tab + right pane Material/Components tabs
    ed.set_left_tab(1, view)
    verify_layout_geometry(ed, view, 1240.0, 700.0, "1240x700-assets") or >>
    if ed.project.assets.len > 0 {
        meta_b := view.node_bounds(ed.id_asset_meta) or >>
        assert_ui(ed.resolve_cursor(view, meta_b.x + 8.0, meta_b.y + 8.0) == ui.CURSOR_TEXT, "asset meta has text cursor") or >>
    }
    if selected_asset_is_glb(ed) {
        focus_field($&ed.prim_field, true)
        assert_ui(ed.prim_field.is_focused(), "compact Prim field can focus") or >>
        focus_field($&ed.prim_field, false)
    }
    ed.set_left_tab(0, view)

    ed.set_insp_tab(1, view)
    mat_box_b := view.node_bounds(ed.id_tab_material_box) or >>
    xf_box_b := view.node_bounds(ed.id_tab_transform_box) or >>
    assert_ui(mat_box_b.height > 80.0 && xf_box_b.height <= 0.5, "Material tab shows material box and collapses Transform tab") or >>
    ed.set_insp_tab(2, view)
    env_sec_b := view.node_bounds(ed.comp.section_boxes[6]) or >>
    assert_ui(!ed.comp.section_attached[6] && env_sec_b.height <= 0.5, "unattached component card hidden by default") or >>
    ed.comp_manual_open[7] = true
    _ := ed.sync_layout(view, 1240.0, 700.0) or >>
    env_open_b := view.node_bounds(ed.comp.section_boxes[6]) or >>
    assert_ui(env_open_b.height > 100.0, "Add Component reveals Environment card on demand") or >>
    ed.reset_comp_manual_open()
    ed.set_insp_tab(0, view)

    undo_b := view.node_bounds(ed.id_undo_btn) or >>
    assert_ui(!ed.undo_btn.is_enabled(), "undo starts disabled") or >>
    assert_ui(ed.resolve_cursor(view, undo_b.x + 8.0, undo_b.y + 8.0) == ui.CURSOR_DEFAULT, "disabled undo has default cursor") or >>
    add_b := view.node_bounds(ed.id_add_node_select) or >>
    assert_ui(ed.resolve_cursor(view, add_b.x + 8.0, add_b.y + 8.0) == ui.CURSOR_HAND, "enabled +Add Node select has hand cursor") or >>
    ls_b := view.node_bounds(ed.id_left_split) or >>
    assert_ui(ed.resolve_cursor(view, ls_b.x + 2.0, ls_b.y + 20.0) == ui.CURSOR_RESIZE_HORIZONTAL, "splitter has resize cursor") or >>
    st_tab_b := view.node_bounds(ed.id_stage_tabs) or >>
    assert_ui(ed.resolve_cursor(view, st_tab_b.x + 12.0, st_tab_b.y + 14.0) == ui.CURSOR_HAND, "stage_tabs has hand cursor") or >>

    nm_b := view.node_bounds(ed.id_name_field) or >>
    assert_ui(nm_b.height <= 38.0, "compact Name field hides byte counter helper when valid") or >>
    assert_ui(ed.resolve_cursor(view, nm_b.x + 24.0, nm_b.y + 12.0) == ui.CURSOR_TEXT, "Name input box has text cursor") or >>
    assert_ui(ed.resolve_cursor(view, nm_b.x + nm_b.width - 14.0, nm_b.y + 12.0) == ui.CURSOR_HAND, "Name clear button has hand cursor") or >>

    // Refined TreeView cursors: chevron/row -> HAND, empty area below rows -> DEFAULT, open context menu item -> HAND, outside -> DEFAULT.
    tree_b := view.node_bounds(ed.id_tree) or >>
    row0 := ed.tree.row_bounds(0)
    assert_ui(ed.resolve_cursor(view, tree_b.x + row0.x + 12.0, tree_b.y + row0.y + row0.height * 0.5) == ui.CURSOR_HAND, "tree chevron has hand cursor") or >>
    assert_ui(ed.resolve_cursor(view, tree_b.x + row0.x + 48.0, tree_b.y + row0.y + row0.height * 0.5) == ui.CURSOR_HAND, "tree row label has hand cursor") or >>
    tr_exp := $&ed.tree
    tr_exp.set_expanded(0, false) or >>
    _ := ed.sync_layout(view, 1240.0, 700.0) or >>
    assert_ui(ed.resolve_cursor(view, tree_b.x + 48.0, tree_b.y + tree_b.height - 10.0) == ui.CURSOR_DEFAULT, "tree empty area below rows has default cursor") or >>
    tr_exp2 := $&ed.tree
    tr_exp2.set_expanded(0, true) or >>
    _ := ed.sync_layout(view, 1240.0, 700.0) or >>
    rc_ev := ui.InputEvent{
        kind: ui.EV_POINTER_DOWN, window_id: identity.window_id, canvas_id: identity.canvas_id, generation: identity.generation,
        x: row0.x + 48.0, y: row0.y + row0.height * 0.5, dx: 0.0, dy: 0.0, button: ui.BUTTON_RIGHT, buttons: 2, modifiers: 0, key: 0, scan: 0, repeat: 0, click_count: 1, time_ns: 900000000
    }
    tr_mut := $&ed.tree
    _ := tr_mut.input(&rc_ev)
    assert_ui(ed.tree.has_popup_open(), "tree right-click opens context menu") or >>
    tpb := ed.tree.popup_bounds()
    assert_ui(ed.resolve_cursor(view, ed.tree_origin.x + tpb.x + 12.0, ed.tree_origin.y + tpb.y + 12.0) == ui.CURSOR_HAND, "tree context menu item has hand cursor") or >>
    assert_ui(ed.resolve_cursor(view, 10.0, 10.0) == ui.CURSOR_DEFAULT, "outside open tree context menu has default cursor") or >>
    esc_ev := ui.InputEvent{
        kind: ui.EV_KEY_DOWN, window_id: identity.window_id, canvas_id: identity.canvas_id, generation: identity.generation,
        x: 0.0, y: 0.0, dx: 0.0, dy: 0.0, button: 0, buttons: 0, modifiers: 0, key: ui.KEY_ESCAPE, scan: 0, repeat: 0, click_count: 0, time_ns: 910000000
    }
    tr_mut2 := $&ed.tree
    _ := tr_mut2.input(&esc_ev)
    assert_ui(!ed.tree.has_popup_open(), "Escape closes tree context menu") or >>

    // Inspector scroll-clipping: scrolled child behind insp_hdr must NOT leak its cursor outside id_insp_scroll.
    hdr_b := view.node_bounds(ed.id_insp_hdr) or >>
    sc_mut := $&ed.insp_scroll
    sc_mut.set_offset(80.0) or >>
    view.set_scroll(ed.id_insp_scroll, 0.0, ed.insp_scroll.offset()) or >>
    hdr_cur := ed.resolve_cursor(view, hdr_b.x + hdr_b.width - 18.0, hdr_b.y + 8.0)
    assert_ui(hdr_cur == ed.insp_hdr_txt.cursor_at(hdr_b.x + hdr_b.width - 18.0, hdr_b.y + 8.0), "inspector header cursor not occluded by scrolled child") or >>
    sc_mut2 := $&ed.insp_scroll
    sc_mut2.set_offset(0.0) or >>
    view.set_scroll(ed.id_insp_scroll, 0.0, 0.0) or >>

    // View.set_auto_cursor(false) prevents widgets.dispatch from clobbering app-managed cursor.
    view.set_pointer_cursor(ui.CURSOR_CROSSHAIR) or >>
    mv_btn_ev := ui.InputEvent{
        kind: ui.EV_POINTER_MOVE, window_id: identity.window_id, canvas_id: identity.canvas_id, generation: identity.generation,
        x: add_b.x + 8.0, y: add_b.y + 8.0, dx: 0.0, dy: 0.0, button: 0, buttons: 0, modifiers: 0, key: 0, scan: 0, repeat: 0, click_count: 0, time_ns: 920000000
    }
    _ := widgets.dispatch(view, &mv_btn_ev, ed) or >>
    assert_ui(view.pointer_cursor() == ui.CURSOR_CROSSHAIR, "auto_cursor=false preserves pointer_cursor during widgets.dispatch") or >>
    ed.pointer_inside = true
    ed.last_px = add_b.x + 8.0
    ed.last_py = add_b.y + 8.0
    ed.apply_pointer_cursor(view)
    ed.pointer_inside = false
    assert_ui(view.pointer_cursor() == ui.CURSOR_HAND, "apply_pointer_cursor restores dynamic cursor") or >>

    // Read-only footer status display is selectable and copyable.
    st_b := view.node_bounds(ed.id_status_txt) or >>
    assert_ui(ed.resolve_cursor(view, st_b.x + 8.0, st_b.y + 8.0) == ui.CURSOR_TEXT, "footer status has text cursor") or >>
    st_txt := $&ed.status_txt
    assert_ui(st_txt.select_all(), "status text select_all works") or >>
    assert_ui(ed.status_txt.selected_text().len > 0, "status text exposes selection") or >>

    // Top View cursors: default on empty ground, crosshair in place mode, hand on hovered node marker.
    tv_b := view.node_bounds(ed.id_top_view) or >>
    ed.top_view.hover_node = -1
    ed.placing_mode = false
    assert_ui(ed.resolve_cursor(view, tv_b.x + 12.0, tv_b.y + 12.0) == ui.CURSOR_DEFAULT, "top view idle default cursor") or >>
    ed.top_view.hover_node = 0
    assert_ui(ed.resolve_cursor(view, tv_b.x + 12.0, tv_b.y + 12.0) == ui.CURSOR_HAND, "top view node hover hand cursor") or >>
    ed.placing_mode = true
    assert_ui(ed.resolve_cursor(view, tv_b.x + 12.0, tv_b.y + 12.0) == ui.CURSOR_CROSSHAIR, "top view place mode crosshair cursor") or >>
    ed.placing_mode = false
    ed.top_view.hover_node = -1

    // Selection + Enter submit inside inspector updates node cleanly.
    if ed.stage_pts.len > 1 {
        set_field_val($&ed.name_field, &"RenamedCheck")
        _ := ed.apply_inspector(view) or >>
        doc_after := ed.draft.document() or >>
        nd_after := doc_after.describe_node(1) or >>
        assert_ui(nd_after.name == "RenamedCheck", "inspector apply commits updated name") or >>
    }

    // Camera RX edit regression check: applying RX = -25 renders cleanly without errors.
    $cam_idx := -1
    for i in 0:ed.stage_pts.len {
        if ed.stage_pts[i].name == "Camera" {
            cam_idx = ed.stage_pts[i].index
        }
    }
    if cam_idx > 0 {
        ed.select_scene_node(cam_idx, view)
        set_field_val($&ed.rot_x, &"-25")
        _ := ed.apply_inspector(view) or >>
        cam_doc := ed.draft.document() or >>
        cam_nd := cam_doc.describe_node(cam_idx) or >>
        cam_trs := decompose_trs(&cam_nd.local_3d)
        assert_ui_near(cam_trs.rotation_deg.x, -25.0, 1e-4, "camera RX applied") or >>
        $snap_cam := widgets.snapshot_styled(view, &c_min, 1.0, ed) or >>
        assert_ui(snap_cam.pixel_width > 0 && snap_cam.pixel_height > 0, "camera RX edit snapshot pixels") or >>
        _ := snap_cam.dispose() or >>
        d_cam := $&ed.draft
        d_cam.undo_edit() or >>
        ed.refresh_after_document_change(false, view)
    }

    // Hover tooltip lifecycle check (delayed show -> render -> dismiss).
    save_b := view.node_bounds(ed.id_save_btn) or >>
    save_hit := resolve_tooltip_hit(ed, view, save_b.x + save_b.width * 0.5, save_b.y + save_b.height * 0.5)
    assert_ui(save_hit.id == ed.id_save_btn && save_hit.text.len > 0, "resolve tooltip hit on save button") or >>
    t0 := time.instant()
    tip := $&ed.tooltip
    _ := tip.update_hover(&save_hit, t0)
    assert_ui(!ed.tooltip.visible, "tooltip waits for hover delay") or >>
    t_show := t0.add(time.duration(400000000)) or >>
    ed.tick_animations(view, t_show)
    assert_ui(ed.tooltip.visible && ed.tooltip.text.len > 0, "tooltip visible after delay") or >>
    c_tip := layout.tight(1240.0, 700.0) or >>
    $snap_tip := widgets.snapshot_styled(view, &c_tip, 1.0, ed) or >>
    assert_ui(snap_tip.pixel_width > 0 && snap_tip.pixel_height > 0, "tooltip snapshot pixels") or >>
    _ := snap_tip.dispose() or >>
    tip2 := $&ed.tooltip
    _ := tip2.dismiss()
    assert_ui(!ed.tooltip.visible, "tooltip dismissed cleanly") or >>

    // Bilingual EN/ZH switching + rendered Chinese snapshot check.
    ed.set_lang(LANG_ZH, view)
    assert_ui(ed.lang == LANG_ZH, "switched editor language to Chinese") or >>
    assert_ui(ed.panels.btn_labels[PB_LANG].text() == "EN", "lang toggle button shows EN in Chinese mode") or >>
    assert_ui(ed.apply_lbl.text() == "应用更改", "apply button localized in Chinese") or >>
    zh_hit := resolve_tooltip_hit(ed, view, save_b.x + save_b.width * 0.5, save_b.y + save_b.height * 0.5)
    assert_ui(strings.has_prefix(&zh_hit.text, "保存场景 (Cmd+S)"), "save button tooltip localized in Chinese (got " + zh_hit.text + ")") or >>
    $snap_zh := widgets.snapshot_styled(view, &c_tip, 1.0, ed) or >>
    assert_ui(snap_zh.pixel_width > 0 && snap_zh.pixel_height > 0, "Chinese UI snapshot pixels") or >>
    if output_dir.len > 0 {
        zh_pixels := snap_zh.rgba_bytes() or >>
        zh_encoded := png.encode_rgba_bytes(&zh_pixels, snap_zh.pixel_width, snap_zh.pixel_height) or >>
        zh_path := filepath.join([output_dir + "", "editor-check-zh.png"])
        snapshot.write_atomic(zh_path, &zh_encoded) or >>
    }
    _ := snap_zh.dispose() or >>
    ed.set_lang(LANG_EN, view)
    assert_ui(ed.lang == LANG_EN, "switched editor language back to English") or >>
    assert_ui(ed.panels.btn_labels[PB_LANG].text() == "中文", "lang toggle button shows 中文 in English mode") or >>
    assert_ui(ed.apply_lbl.text() == "Apply Changes", "apply button restored to English") or >>

    // Multi-selection synchronization between stage/viewport and Scene Tree.
    if ed.stage_pts.len >= 3 {
        ed.set_selection_list(&[1, 2], view)
        assert_ui(ed.selected_nodes.len == 2, "editor holds 2 selected nodes") or >>
        assert_ui(ed.selected_node == 2, "primary selected node is 2") or >>
        assert_ui(ed.tree.is_node_selected(ed.scene_to_tree[1]), "tree highlights first selected node") or >>
        assert_ui(ed.tree.is_node_selected(ed.scene_to_tree[2]), "tree highlights second selected node") or >>
        assert_ui(ed.tree.selected_nodes().len == 2, "tree exposes 2 selected nodes") or >>
        assert_ui(ed.tree.selected() == ed.scene_to_tree[2], "tree primary matches primary selected node") or >>
        $snap_multi := widgets.snapshot_styled(view, &c_tip, 1.0, ed) or >>
        assert_ui(snap_multi.pixel_width > 0 && snap_multi.pixel_height > 0, "multi-selection snapshot pixels") or >>
        _ := snap_multi.dispose() or >>
        ed.select_scene_node(1, view)
        assert_ui(ed.selected_nodes.len == 1 && ed.tree.selected_nodes().len == 1, "restoring single selection clears multi-select in tree") or >>
    }

    // Regression check: clicking buttons above focused Top View must NOT leak ROUTE_BLUR pointer-down into canvas.
    _ := ed.sync_layout(view, 1240.0, 700.0) or >>
    tv_focus_b := view.node_bounds(ed.id_top_view) or >>
    ax_click_b := view.node_bounds(ed.id_stage_axis_btn) or >>
    sv_click_b := view.node_bounds(ed.id_save_btn) or >>
    ev_tv_dn := ui.InputEvent{
        kind: ui.EV_POINTER_DOWN, window_id: identity.window_id, canvas_id: identity.canvas_id, generation: identity.generation,
        x: tv_focus_b.x + 12.0, y: tv_focus_b.y + 12.0, dx: 0.0, dy: 0.0, button: ui.BUTTON_LEFT, buttons: 1, modifiers: 0, key: 0, scan: 0, repeat: 0, click_count: 1, time_ns: 950000000
    }
    ev_tv_up := ui.InputEvent{
        kind: ui.EV_POINTER_UP, window_id: identity.window_id, canvas_id: identity.canvas_id, generation: identity.generation,
        x: tv_focus_b.x + 12.0, y: tv_focus_b.y + 12.0, dx: 0.0, dy: 0.0, button: ui.BUTTON_LEFT, buttons: 0, modifiers: 0, key: 0, scan: 0, repeat: 0, click_count: 1, time_ns: 960000000
    }
    _ := widgets.dispatch(view, &ev_tv_dn, ed) or >>
    _ := widgets.dispatch(view, &ev_tv_up, ed) or >>
    assert_ui(view.focused() == ed.id_top_view, "top view acquires focus on click") or >>

    ev_ax_dn := ui.InputEvent{
        kind: ui.EV_POINTER_DOWN, window_id: identity.window_id, canvas_id: identity.canvas_id, generation: identity.generation,
        x: ax_click_b.x + ax_click_b.width * 0.5, y: ax_click_b.y + ax_click_b.height * 0.5, dx: 0.0, dy: 0.0, button: ui.BUTTON_LEFT, buttons: 1, modifiers: 0, key: 0, scan: 0, repeat: 0, click_count: 1, time_ns: 970000000
    }
    ev_ax_up := ui.InputEvent{
        kind: ui.EV_POINTER_UP, window_id: identity.window_id, canvas_id: identity.canvas_id, generation: identity.generation,
        x: ax_click_b.x + ax_click_b.width * 0.5, y: ax_click_b.y + ax_click_b.height * 0.5, dx: 0.0, dy: 0.0, button: ui.BUTTON_LEFT, buttons: 0, modifiers: 0, key: 0, scan: 0, repeat: 0, click_count: 1, time_ns: 980000000
    }
    _ := widgets.dispatch(view, &ev_ax_dn, ed) or >>
    assert_ui(!ed.top_view.marquee_active && !ed.top_view.drag_pending && !ed.top_view.dragging_nodes && !ed.top_view.panning, "stage axis button down does not trigger top view canvas interaction via ROUTE_BLUR") or >>
    ax_up_acts := widgets.dispatch(view, &ev_ax_up, ed) or >>
    assert_ui(!ed.top_view.marquee_active && !ed.top_view.drag_pending && !ed.top_view.dragging_nodes && !ed.top_view.panning, "stage axis button up leaves top view idle") or >>
    $ax_activated := false
    for i in 0:ax_up_acts.len {
        if ax_up_acts[i].id == ed.id_stage_axis_btn && ax_up_acts[i].kind == widgets.ACTION_ACTIVATE {
            ax_activated = true
        }
    }
    assert_ui(ax_activated, "stage axis button activates on click after canvas focus") or >>

    // Re-focus Top View and verify top toolbar button click also activates cleanly without canvas leak.
    _ := widgets.dispatch(view, &ev_tv_dn, ed) or >>
    _ := widgets.dispatch(view, &ev_tv_up, ed) or >>
    assert_ui(view.focused() == ed.id_top_view, "top view re-acquires focus") or >>
    ev_sv_dn := ui.InputEvent{
        kind: ui.EV_POINTER_DOWN, window_id: identity.window_id, canvas_id: identity.canvas_id, generation: identity.generation,
        x: sv_click_b.x + sv_click_b.width * 0.5, y: sv_click_b.y + sv_click_b.height * 0.5, dx: 0.0, dy: 0.0, button: ui.BUTTON_LEFT, buttons: 1, modifiers: 0, key: 0, scan: 0, repeat: 0, click_count: 1, time_ns: 990000000
    }
    ev_sv_up := ui.InputEvent{
        kind: ui.EV_POINTER_UP, window_id: identity.window_id, canvas_id: identity.canvas_id, generation: identity.generation,
        x: sv_click_b.x + sv_click_b.width * 0.5, y: sv_click_b.y + sv_click_b.height * 0.5, dx: 0.0, dy: 0.0, button: ui.BUTTON_LEFT, buttons: 0, modifiers: 0, key: 0, scan: 0, repeat: 0, click_count: 1, time_ns: 1000000000
    }
    _ := widgets.dispatch(view, &ev_sv_dn, ed) or >>
    assert_ui(!ed.top_view.marquee_active && !ed.top_view.drag_pending && !ed.top_view.dragging_nodes && !ed.top_view.panning, "toolbar save button down does not trigger top view canvas interaction") or >>
    sv_up_acts := widgets.dispatch(view, &ev_sv_up, ed) or >>
    assert_ui(!ed.top_view.marquee_active && !ed.top_view.drag_pending && !ed.top_view.dragging_nodes && !ed.top_view.panning, "toolbar save button up leaves top view idle") or >>
    $sv_activated := false
    for i in 0:sv_up_acts.len {
        if sv_up_acts[i].id == ed.id_save_btn && sv_up_acts[i].kind == widgets.ACTION_ACTIVATE {
            sv_activated = true
        }
    }
    assert_ui(sv_activated, "toolbar save button activates on click after canvas focus") or >>

    // Verify Select dropdown real mouse click (DOWN+UP to open -> MOVE+DOWN keeps open -> UP commits action)
    _ := ed.sync_layout(view, 1240.0, 700.0) or >>
    an_orig := copy_rect(&ed.add_node_origin)
    before_add := ed.stage_pts.len
    an_open_dn := ui.InputEvent{
        kind: ui.EV_POINTER_DOWN, window_id: identity.window_id, canvas_id: identity.canvas_id, generation: identity.generation,
        x: an_orig.x + an_orig.width * 0.5, y: an_orig.y + an_orig.height * 0.5, dx: 0.0, dy: 0.0, button: ui.BUTTON_LEFT, buttons: 1, modifiers: 0, key: 0, scan: 0, repeat: 0, click_count: 1, time_ns: 1010000000
    }
    an_open_up := ui.InputEvent{
        kind: ui.EV_POINTER_UP, window_id: identity.window_id, canvas_id: identity.canvas_id, generation: identity.generation,
        x: an_orig.x + an_orig.width * 0.5, y: an_orig.y + an_orig.height * 0.5, dx: 0.0, dy: 0.0, button: ui.BUTTON_LEFT, buttons: 0, modifiers: 0, key: 0, scan: 0, repeat: 0, click_count: 1, time_ns: 1015000000
    }
    _ := ed.handle_input_event(&an_open_dn, view)
    _ := ed.handle_input_event(&an_open_up, view)
    assert_ui(ed.add_node_select.is_open(), "clicking Select control opens popup") or >>
    opt1_b := ed.add_node_select.option_bounds(1, &ed.styles)
    opt1_x := an_orig.x + opt1_b.x + opt1_b.width * 0.5
    opt1_y := an_orig.y + opt1_b.y + opt1_b.height * 0.5
    opt1_mv := ui.InputEvent{
        kind: ui.EV_POINTER_MOVE, window_id: identity.window_id, canvas_id: identity.canvas_id, generation: identity.generation,
        x: opt1_x, y: opt1_y, dx: 0.0, dy: 0.0, button: 0, buttons: 0, modifiers: 0, key: 0, scan: 0, repeat: 0, click_count: 0, time_ns: 1020000000
    }
    opt1_dn := ui.InputEvent{
        kind: ui.EV_POINTER_DOWN, window_id: identity.window_id, canvas_id: identity.canvas_id, generation: identity.generation,
        x: opt1_x, y: opt1_y, dx: 0.0, dy: 0.0, button: ui.BUTTON_LEFT, buttons: 1, modifiers: 0, key: 0, scan: 0, repeat: 0, click_count: 1, time_ns: 1025000000
    }
    opt1_up := ui.InputEvent{
        kind: ui.EV_POINTER_UP, window_id: identity.window_id, canvas_id: identity.canvas_id, generation: identity.generation,
        x: opt1_x, y: opt1_y, dx: 0.0, dy: 0.0, button: ui.BUTTON_LEFT, buttons: 0, modifiers: 0, key: 0, scan: 0, repeat: 0, click_count: 1, time_ns: 1030000000
    }
    _ := ed.handle_input_event(&opt1_mv, view)
    _ := ed.handle_input_event(&opt1_dn, view)
    assert_ui(ed.add_node_select.is_open(), "pointer down on popup option keeps popup open until pointer up") or >>
    _ := ed.handle_input_event(&opt1_up, view)
    assert_ui(!ed.add_node_select.is_open(), "pointer up on popup option closes popup") or >>
    assert_ui(ed.stage_pts.len == before_add + 1, "pointer click on Select popup option commits action") or >>
    ed.do_undo(view)

    _ := ed.handle_input_event(&an_open_dn, view)
    _ := ed.handle_input_event(&an_open_up, view)
    assert_ui(ed.add_node_select.is_open(), "re-opened Select popup before outside click") or >>
    out_dn := ui.InputEvent{
        kind: ui.EV_POINTER_DOWN, window_id: identity.window_id, canvas_id: identity.canvas_id, generation: identity.generation,
        x: 620.0, y: 350.0, dx: 0.0, dy: 0.0, button: ui.BUTTON_LEFT, buttons: 1, modifiers: 0, key: 0, scan: 0, repeat: 0, click_count: 1, time_ns: 1040000000
    }
    _ := ed.handle_input_event(&out_dn, view)
    assert_ui(!ed.add_node_select.is_open(), "clicking outside Select popup dismisses it") or >>

    // Unified 3D modeling, split viewport, TileMap 2D mode, and PBR inspector check.
    before_nodes := ed.stage_pts.len
    ed.set_stage_mode(STAGE_MODE_3D, view)
    ed.do_spawn_whitebox("box", view)
    assert_ui(ed.stage_pts.len == before_nodes + 1, "spawn_whitebox adds node") or >>
    ed.do_mesh_op("extrude", 0.0, 0.4, view)
    ed.do_mesh_op("inset", 0.25, 0.0, view)
    ed.do_mesh_op("bevel", 0.0, 0.14, view)
    ed.do_mesh_op("box_uv", 0.0, 1.0, view)
    ed.do_mesh_op("subdivide", 0.0, 0.0, view)
    ed.do_apply_preset(3, view)
    box_sel := ed.selected_node
    d_mod := $&ed.draft
    d_mod.transform_nodes_3d(&[box_sel], fm.vec3(0.0, 0.0, 0.0), fm.vec3(0.0, 25.0, 0.0), fm.vec3(1.25, 1.0, 1.0)) or >>
    d_mod.translate_sub_element(box_sel, SUB_MODE_FACE, 0, -1, -1, 0, fm.vec3(0.0, 0.15, 0.0)) or >>
    ed.do_spawn_csg_cut(view)
    ed.do_csg_action(1, view)
    ed.do_csg_action(2, view)
    ed.do_csg_action(3, view)
    ed.set_stage_mode(STAGE_MODE_SPLIT, view)
    $snap_split := widgets.snapshot_styled(view, &c_tip, 1.0, ed) or >>
    assert_ui(snap_split.pixel_width > 0 && snap_split.pixel_height > 0, "unified split snapshot pixels") or >>
    _ := snap_split.dispose() or >>
    ed.set_stage_mode(STAGE_MODE_TILEMAP, view)
    assert_ui(!ed.modeling.bar_visible, "TileMap mode hides 3D modeling bar") or >>
    tm_bar := view.node_bounds(ed.modeling.id_model_bar) or >>
    assert_ui(tm_bar.height <= 0.5, "TileMap mode collapses 3D modeling bar height to 0") or >>
    $snap_tile := widgets.snapshot_styled(view, &c_tip, 1.0, ed) or >>
    assert_ui(snap_tile.pixel_width > 0 && snap_tile.pixel_height > 0, "unified tilemap snapshot pixels") or >>
    _ := snap_tile.dispose() or >>
    ed.do_undo(view)

    // End-to-end multi-selection UI inspector, material, transform, visibility & component editing.
    ed.set_stage_mode(STAGE_MODE_3D, view)
    ed.do_spawn_whitebox("box", view)
    b1 := ed.selected_node
    ed.do_spawn_whitebox("box", view)
    b2 := ed.selected_node
    assert_ui(b1 > 0 && b2 > 0 && b1 != b2, "spawned two distinct whitebox nodes") or >>
    d_m := $&ed.draft
    b1_orig_x := ((d_m.document() or >>).describe_node(b1) or >>).local_3d.c3.x
    b2_orig_x := ((d_m.document() or >>).describe_node(b2) or >>).local_3d.c3.x
    if math.abs(b1_orig_x - b2_orig_x) < 1e-4 {
        d_m.set_nodes_properties_batch(
            &[b2],
            false, true, false, 0,
            true, false, false, fm.vec3(b1_orig_x + 3.0, 0.0, 0.0),
            false, false, false, fm.vec3(0.0, 0.0, 0.0),
            false, false, false, fm.vec3(1.0, 1.0, 1.0)
        ) or >>
    }
    b2_x_want := ((d_m.document() or >>).describe_node(b2) or >>).local_3d.c3.x
    ed.set_selection_list(&[b1, b2], view)
    assert_ui(ed.selected_nodes.len == 2, "multi-selection active on two boxes") or >>
    assert_ui(!ed.name_field.is_enabled(), "multi-selection disables name field") or >>
    assert_ui(strings.contains(&ed.name_field.value(), "2"), "name field summarizes 2 selected nodes") or >>
    assert_ui(ed.apply_lbl.text() == "Apply to 2 Nodes", "apply button reflects 2 selected nodes") or >>
    assert_ui(ed.insp_can_trs, "multi-selection enables 3D transform and material") or >>

    // Material preset & two-sided & clear apply to BOTH nodes in 1 undo step each
    ed.do_apply_preset(2, view)
    doc_p1 := ed.draft.document() or >>
    m1_p := inspect_node_modeling(&doc_p1, b1)
    m2_p := inspect_node_modeling(&doc_p1, b2)
    assert_ui_near(m1_p.mat.base_color.x, 0.84, 1e-4, "preset color applied to b1") or >>
    assert_ui_near(m2_p.mat.base_color.x, 0.84, 1e-4, "preset color applied to b2") or >>

    ed.do_toggle_twosided(view)
    doc_ts := ed.draft.document() or >>
    assert_ui(inspect_node_modeling(&doc_ts, b1).mat.double_sided && inspect_node_modeling(&doc_ts, b2).mat.double_sided, "two-sided applied to both nodes") or >>

    ed.do_clear_pbr_material(view)
    doc_clr := ed.draft.document() or >>
    assert_ui(!node_has_material_override(&doc_clr, b1, 0) && !node_has_material_override(&doc_clr, b2, 0), "clear material clears both nodes") or >>

    // Transform partial-axis edit (only Y=5) updates BOTH while preserving distinct X
    set_field_val($&ed.pos_y, &"5")
    ed.apply_inspector(view) or >>
    doc_py := ed.draft.document() or >>
    d1_py := doc_py.describe_node(b1) or >>
    d2_py := doc_py.describe_node(b2) or >>
    assert_ui_near(d1_py.local_3d.c3.y, 5.0, 1e-4, "apply_inspector updates b1 Y to 5") or >>
    assert_ui_near(d2_py.local_3d.c3.y, 5.0, 1e-4, "apply_inspector updates b2 Y to 5") or >>
    assert_ui_near(d1_py.local_3d.c3.x, b1_orig_x, 1e-4, "apply_inspector preserves b1 X") or >>
    assert_ui_near(d2_py.local_3d.c3.x, b2_x_want, 1e-4, "apply_inspector preserves b2 X") or >>

    // Tree eye toggle hides BOTH and single undo restores BOTH
    ed.do_toggle_selected_visible(view)
    doc_hid := ed.draft.document() or >>
    assert_ui(!(doc_hid.describe_node(b1) or >>).visible && !(doc_hid.describe_node(b2) or >>).visible, "toggle visible hides both nodes") or >>
    ed.do_undo(view)
    doc_vis := ed.draft.document() or >>
    assert_ui((doc_vis.describe_node(b1) or >>).visible && (doc_vis.describe_node(b2) or >>).visible, "single undo restores visibility on both nodes") or >>

    // Component batch attach (RigidBody3D) attaches to BOTH in 1 undo step
    rb_act := widgets.Action{kind: widgets.ACTION_ACTIVATE, id: ed.comp.button_ids[CB_RB_APPLY], needs_paint: false, request_focus: false, consumed: false, value: 0.0}
    assert_ui(handle_comp_action(ed, &rb_act, view), "component RB apply handled for multi-selection") or >>
    assert_ui((ed.draft.document() or >>).rigid_body_3d_count() >= 2, "RigidBody3D attached to both selected nodes") or >>
    ed.do_undo(view)
    assert_ui((ed.draft.document() or >>).rigid_body_3d_count() == 0, "single undo removes RigidBody3D from both nodes") or >>

    // Real pointer Shift+Click tests across Scene Tree, 2D Top View, and 3D Viewport.
    // 1. Left Scene Tree Shift+Click (Shift held AND Shift released early before UP)
    ed.select_scene_node(b1, view)
    _ := ed.sync_layout(view, 1240.0, 700.0) or >>
    t_b := view.node_bounds(ed.id_tree) or >>
    $vrow_b2 := -1
    b2_tid := ed.scene_to_tree[b2]
    for vr in 0:ed.tree.visible_count() {
        if (ed.tree.visible_node(vr) or >>) == b2_tid {
            vrow_b2 = vr
            <-
        }
    }
    assert_ui(vrow_b2 >= 0, "b2 is visible in Scene Tree") or >>
    r_b2 := ed.tree.row_bounds(vrow_b2)
    tx2 := t_b.x + r_b2.x + 60.0
    ty2 := t_b.y + r_b2.y + r_b2.height * 0.5
    tr_dn := ui.InputEvent{
        kind: ui.EV_POINTER_DOWN, window_id: identity.window_id, canvas_id: identity.canvas_id, generation: identity.generation,
        x: tx2, y: ty2, dx: 0.0, dy: 0.0, button: ui.BUTTON_LEFT, buttons: 1, modifiers: ui.MOD_SHIFT, key: 0, scan: 0, repeat: 0, click_count: 1, time_ns: 1100000000
    }
    tr_up := ui.InputEvent{
        kind: ui.EV_POINTER_UP, window_id: identity.window_id, canvas_id: identity.canvas_id, generation: identity.generation,
        x: tx2, y: ty2, dx: 0.0, dy: 0.0, button: ui.BUTTON_LEFT, buttons: 0, modifiers: ui.MOD_SHIFT, key: 0, scan: 0, repeat: 0, click_count: 1, time_ns: 1105000000
    }
    _ := ed.handle_input_event(&tr_dn, view)
    _ := ed.handle_input_event(&tr_up, view)
    assert_ui(ed.selected_nodes.len >= 2 && is_selected_node(&ed.selected_nodes, b1) && is_selected_node(&ed.selected_nodes, b2), "Scene Tree Shift+Click adds range/second node") or >>

    // Early Shift release before pointer up still completes additive selection in Scene Tree
    ed.select_scene_node(b1, view)
    tr_up_rel := ui.InputEvent{
        kind: ui.EV_POINTER_UP, window_id: identity.window_id, canvas_id: identity.canvas_id, generation: identity.generation,
        x: tx2, y: ty2, dx: 0.0, dy: 0.0, button: ui.BUTTON_LEFT, buttons: 0, modifiers: 0, key: 0, scan: 0, repeat: 0, click_count: 1, time_ns: 1110000000
    }
    _ := ed.handle_input_event(&tr_dn, view)
    _ := ed.handle_input_event(&tr_up_rel, view)
    assert_ui(ed.selected_nodes.len >= 2 && is_selected_node(&ed.selected_nodes, b1) && is_selected_node(&ed.selected_nodes, b2), "Scene Tree Shift+Click preserves Shift on early release") or >>

    // Per-row inline eye icon click toggles ONLY that node without changing selection
    ed.select_scene_node(b1, view)
    _ := ed.sync_layout(view, 1240.0, 700.0) or >>
    ab_b2 := ed.tree.action_bounds(vrow_b2)
    eye_x := t_b.x + ab_b2.x + ab_b2.width * 0.5
    eye_y := t_b.y + ab_b2.y + ab_b2.height * 0.5
    eye_dn := ui.InputEvent{
        kind: ui.EV_POINTER_DOWN, window_id: identity.window_id, canvas_id: identity.canvas_id, generation: identity.generation,
        x: eye_x, y: eye_y, dx: 0.0, dy: 0.0, button: ui.BUTTON_LEFT, buttons: 1, modifiers: 0, key: 0, scan: 0, repeat: 0, click_count: 1, time_ns: 1112000000
    }
    eye_up := ui.InputEvent{
        kind: ui.EV_POINTER_UP, window_id: identity.window_id, canvas_id: identity.canvas_id, generation: identity.generation,
        x: eye_x, y: eye_y, dx: 0.0, dy: 0.0, button: ui.BUTTON_LEFT, buttons: 0, modifiers: 0, key: 0, scan: 0, repeat: 0, click_count: 1, time_ns: 1115000000
    }
    _ := ed.handle_input_event(&eye_dn, view)
    _ := ed.handle_input_event(&eye_up, view)
    doc_eye1 := ed.draft.document() or >>
    assert_ui((doc_eye1.describe_node(b1) or >>).visible && !(doc_eye1.describe_node(b2) or >>).visible, "per-row eye icon hides only target row node") or >>
    assert_ui(ed.selected_node == b1 && ed.selected_nodes.len == 1, "per-row eye icon preserves current selection") or >>
    _ := ed.handle_input_event(&eye_dn, view)
    _ := ed.handle_input_event(&eye_up, view)
    doc_eye2 := ed.draft.document() or >>
    assert_ui((doc_eye2.describe_node(b2) or >>).visible, "second click on per-row eye icon restores node visibility") or >>
    ed.do_undo(view)
    doc_eye3 := ed.draft.document() or >>
    assert_ui(!(doc_eye3.describe_node(b2) or >>).visible, "undo reverts per-row eye toggle cleanly") or >>
    ed.do_undo(view)

    // Per-row eye brush-drag DOWN (spanning root -> b2 with fast row skip & horizontal drift) hides all swept rows in 1 undo step
    $vrow_root := -1
    root_tid := ed.scene_to_tree[0]
    for vr in 0:ed.tree.visible_count() {
        if (ed.tree.visible_node(vr) or >>) == root_tid {
            vrow_root = vr
            <-
        }
    }
    assert_ui(vrow_root >= 0 && vrow_root < vrow_b2, "root row appears above b2 in Scene Tree") or >>
    ab_root := ed.tree.action_bounds(vrow_root)
    drag_dn := ui.InputEvent{
        kind: ui.EV_POINTER_DOWN, window_id: identity.window_id, canvas_id: identity.canvas_id, generation: identity.generation,
        x: t_b.x + ab_root.x + ab_root.width * 0.5, y: t_b.y + ab_root.y + ab_root.height * 0.5,
        dx: 0.0, dy: 0.0, button: ui.BUTTON_LEFT, buttons: 1, modifiers: 0, key: 0, scan: 0, repeat: 0, click_count: 1, time_ns: 1116000000
    }
    drag_mv_dn := ui.InputEvent{
        kind: ui.EV_POINTER_MOVE, window_id: identity.window_id, canvas_id: identity.canvas_id, generation: identity.generation,
        x: t_b.x + ab_b2.x - 40.0, y: t_b.y + ab_b2.y + ab_b2.height * 0.5,
        dx: 0.0, dy: 0.0, button: 0, buttons: 1, modifiers: 0, key: 0, scan: 0, repeat: 0, click_count: 0, time_ns: 1117000000
    }
    drag_up_dn := ui.InputEvent{
        kind: ui.EV_POINTER_UP, window_id: identity.window_id, canvas_id: identity.canvas_id, generation: identity.generation,
        x: t_b.x + ab_b2.x - 40.0, y: t_b.y + ab_b2.y + ab_b2.height * 0.5,
        dx: 0.0, dy: 0.0, button: ui.BUTTON_LEFT, buttons: 0, modifiers: 0, key: 0, scan: 0, repeat: 0, click_count: 1, time_ns: 1118000000
    }
    _ := ed.handle_input_event(&drag_dn, view)
    _ := ed.handle_input_event(&drag_mv_dn, view)
    _ := ed.handle_input_event(&drag_up_dn, view)
    doc_drag1 := ed.draft.document() or >>
    assert_ui(!(doc_drag1.describe_node(0) or >>).visible && !(doc_drag1.describe_node(b1) or >>).visible && !(doc_drag1.describe_node(b2) or >>).visible, "eye brush-drag down copies hidden state across swept rows including skipped middle rows") or >>
    assert_ui(ed.selected_node == b1 && ed.selected_nodes.len == 1 && !ed.tree_vis_drag_active, "eye brush-drag preserves selection and clears drag flag on up") or >>
    ed.do_undo(view)
    doc_drag_undo1 := ed.draft.document() or >>
    assert_ui((doc_drag_undo1.describe_node(0) or >>).visible && (doc_drag_undo1.describe_node(b1) or >>).visible && (doc_drag_undo1.describe_node(b2) or >>).visible, "single undo reverts entire eye brush-drag sweep") or >>

    // Eye brush-drag UP from hidden b2 across root copies visible=true even when pointer leaves tree right edge
    d_prep := $&ed.draft
    d_prep.set_nodes_visible_only(&[0, b2], false) or >>
    ed.refresh_after_visibility_change(view)
    up_dn := ui.InputEvent{
        kind: ui.EV_POINTER_DOWN, window_id: identity.window_id, canvas_id: identity.canvas_id, generation: identity.generation,
        x: eye_x, y: eye_y, dx: 0.0, dy: 0.0, button: ui.BUTTON_LEFT, buttons: 1, modifiers: 0, key: 0, scan: 0, repeat: 0, click_count: 1, time_ns: 1119000000
    }
    up_mv := ui.InputEvent{
        kind: ui.EV_POINTER_MOVE, window_id: identity.window_id, canvas_id: identity.canvas_id, generation: identity.generation,
        x: t_b.x + t_b.width + 24.0, y: t_b.y + ab_root.y + ab_root.height * 0.5,
        dx: 0.0, dy: 0.0, button: 0, buttons: 1, modifiers: 0, key: 0, scan: 0, repeat: 0, click_count: 0, time_ns: 1119500000
    }
    up_up := ui.InputEvent{
        kind: ui.EV_POINTER_UP, window_id: identity.window_id, canvas_id: identity.canvas_id, generation: identity.generation,
        x: t_b.x + t_b.width + 24.0, y: t_b.y + ab_root.y + ab_root.height * 0.5,
        dx: 0.0, dy: 0.0, button: ui.BUTTON_LEFT, buttons: 0, modifiers: 0, key: 0, scan: 0, repeat: 0, click_count: 1, time_ns: 1119800000
    }
    _ := ed.handle_input_event(&up_dn, view)
    _ := ed.handle_input_event(&up_mv, view)
    _ := ed.handle_input_event(&up_up, view)
    doc_drag2 := ed.draft.document() or >>
    assert_ui((doc_drag2.describe_node(0) or >>).visible && (doc_drag2.describe_node(b1) or >>).visible && (doc_drag2.describe_node(b2) or >>).visible, "eye brush-drag up from hidden row copies visible=true across outside-tree sweep") or >>
    assert_ui(ed.selected_node == b1 && ed.selected_nodes.len == 1, "eye brush-drag up preserves current selection") or >>
    ed.do_undo(view)
    doc_drag_undo2 := ed.draft.document() or >>
    assert_ui(!(doc_drag_undo2.describe_node(0) or >>).visible && (doc_drag_undo2.describe_node(b1) or >>).visible && !(doc_drag_undo2.describe_node(b2) or >>).visible, "single undo reverts eye brush-drag up back to exact mixed state") or >>
    ed.do_undo(view)

    // Live rollback while still holding button: pull back reverts swept rows, crossing start_row flips direction cleanly
    $vrow_b1 := -1
    b1_tid := ed.scene_to_tree[b1]
    for vr in 0:ed.tree.visible_count() {
        if (ed.tree.visible_node(vr) or >>) == b1_tid {
            vrow_b1 = vr
            <-
        }
    }
    assert_ui(vrow_b1 > vrow_root && vrow_b1 < vrow_b2, "b1 sits between root and b2 in Scene Tree") or >>
    ab_b1 := ed.tree.action_bounds(vrow_b1)
    rb_dn := ui.InputEvent{
        kind: ui.EV_POINTER_DOWN, window_id: identity.window_id, canvas_id: identity.canvas_id, generation: identity.generation,
        x: t_b.x + ab_b1.x + ab_b1.width * 0.5, y: t_b.y + ab_b1.y + ab_b1.height * 0.5,
        dx: 0.0, dy: 0.0, button: ui.BUTTON_LEFT, buttons: 1, modifiers: 0, key: 0, scan: 0, repeat: 0, click_count: 1, time_ns: 1119850000
    }
    rb_mv_b2 := ui.InputEvent{
        kind: ui.EV_POINTER_MOVE, window_id: identity.window_id, canvas_id: identity.canvas_id, generation: identity.generation,
        x: t_b.x + ab_b2.x + ab_b2.width * 0.5, y: t_b.y + ab_b2.y + ab_b2.height * 0.5,
        dx: 0.0, dy: 0.0, button: 0, buttons: 1, modifiers: 0, key: 0, scan: 0, repeat: 0, click_count: 0, time_ns: 1119860000
    }
    rb_mv_b1 := ui.InputEvent{
        kind: ui.EV_POINTER_MOVE, window_id: identity.window_id, canvas_id: identity.canvas_id, generation: identity.generation,
        x: t_b.x + ab_b1.x + ab_b1.width * 0.5, y: t_b.y + ab_b1.y + ab_b1.height * 0.5,
        dx: 0.0, dy: 0.0, button: 0, buttons: 1, modifiers: 0, key: 0, scan: 0, repeat: 0, click_count: 0, time_ns: 1119870000
    }
    rb_mv_root := ui.InputEvent{
        kind: ui.EV_POINTER_MOVE, window_id: identity.window_id, canvas_id: identity.canvas_id, generation: identity.generation,
        x: t_b.x + ab_root.x + ab_root.width * 0.5, y: t_b.y + ab_root.y + ab_root.height * 0.5,
        dx: 0.0, dy: 0.0, button: 0, buttons: 1, modifiers: 0, key: 0, scan: 0, repeat: 0, click_count: 0, time_ns: 1119880000
    }
    rb_up_b1 := ui.InputEvent{
        kind: ui.EV_POINTER_UP, window_id: identity.window_id, canvas_id: identity.canvas_id, generation: identity.generation,
        x: t_b.x + ab_b1.x + ab_b1.width * 0.5, y: t_b.y + ab_b1.y + ab_b1.height * 0.5,
        dx: 0.0, dy: 0.0, button: ui.BUTTON_LEFT, buttons: 0, modifiers: 0, key: 0, scan: 0, repeat: 0, click_count: 1, time_ns: 1119910000
    }
    _ := ed.handle_input_event(&rb_dn, view)
    doc_rb0 := ed.draft.document() or >>
    assert_ui((doc_rb0.describe_node(0) or >>).visible && !(doc_rb0.describe_node(b1) or >>).visible && (doc_rb0.describe_node(b2) or >>).visible, "rollback drag press toggles only b1") or >>
    _ := ed.handle_input_event(&rb_mv_b2, view)
    doc_rb1 := ed.draft.document() or >>
    assert_ui((doc_rb1.describe_node(0) or >>).visible && !(doc_rb1.describe_node(b1) or >>).visible && !(doc_rb1.describe_node(b2) or >>).visible, "rollback drag down hides b2 while held") or >>
    _ := ed.handle_input_event(&rb_mv_b1, view)
    doc_rb2 := ed.draft.document() or >>
    assert_ui((doc_rb2.describe_node(0) or >>).visible && !(doc_rb2.describe_node(b1) or >>).visible && (doc_rb2.describe_node(b2) or >>).visible, "pulling back to b1 before release reverts b2 to visible") or >>
    _ := ed.handle_input_event(&rb_mv_root, view)
    doc_rb3 := ed.draft.document() or >>
    assert_ui(!(doc_rb3.describe_node(0) or >>).visible && !(doc_rb3.describe_node(b1) or >>).visible && (doc_rb3.describe_node(b2) or >>).visible, "crossing start row up to root hides root while b2 stays reverted") or >>
    _ := ed.handle_input_event(&rb_mv_b2, view)
    _ := ed.handle_input_event(&rb_mv_b1, view)
    _ := ed.handle_input_event(&rb_up_b1, view)
    doc_rb4 := ed.draft.document() or >>
    assert_ui((doc_rb4.describe_node(0) or >>).visible && !(doc_rb4.describe_node(b1) or >>).visible && (doc_rb4.describe_node(b2) or >>).visible, "releasing at b1 keeps only b1 hidden after sweeping both ways") or >>
    assert_ui(ed.selected_node == b1 && ed.selected_nodes.len == 1, "rollback drag preserves current selection") or >>
    ed.do_undo(view)
    doc_rb_undo := ed.draft.document() or >>
    assert_ui((doc_rb_undo.describe_node(0) or >>).visible && (doc_rb_undo.describe_node(b1) or >>).visible && (doc_rb_undo.describe_node(b2) or >>).visible, "single undo restores all rows after live rollback sweep") or >>

    // Mixed pre-drag state preservation when pulling back before release
    d_mix := $&ed.draft
    d_mix.set_nodes_visible_only(&[b2], false) or >>
    ed.refresh_after_visibility_change(view)
    mx_mv_root := ui.InputEvent{
        kind: ui.EV_POINTER_MOVE, window_id: identity.window_id, canvas_id: identity.canvas_id, generation: identity.generation,
        x: t_b.x + ab_root.x + ab_root.width * 0.5, y: t_b.y + ab_root.y + ab_root.height * 0.5,
        dx: 0.0, dy: 0.0, button: 0, buttons: 1, modifiers: 0, key: 0, scan: 0, repeat: 0, click_count: 0, time_ns: 1119930000
    }
    mx_up_root := ui.InputEvent{
        kind: ui.EV_POINTER_UP, window_id: identity.window_id, canvas_id: identity.canvas_id, generation: identity.generation,
        x: t_b.x + ab_root.x + ab_root.width * 0.5, y: t_b.y + ab_root.y + ab_root.height * 0.5,
        dx: 0.0, dy: 0.0, button: ui.BUTTON_LEFT, buttons: 0, modifiers: 0, key: 0, scan: 0, repeat: 0, click_count: 1, time_ns: 1119940000
    }
    _ := ed.handle_input_event(&drag_dn, view)
    _ := ed.handle_input_event(&drag_mv_dn, view)
    _ := ed.handle_input_event(&mx_mv_root, view)
    _ := ed.handle_input_event(&mx_up_root, view)
    doc_mx := ed.draft.document() or >>
    assert_ui(!(doc_mx.describe_node(0) or >>).visible && (doc_mx.describe_node(b1) or >>).visible && !(doc_mx.describe_node(b2) or >>).visible, "pulling back restores mixed pre-drag visibility (b1=true, pre-hidden b2=false)") or >>
    ed.do_undo(view)
    ed.do_undo(view)

    // 2. 2D Top View Shift+Click keeps multi-selection on POINTER_UP (no collapse)
    ed.set_stage_mode(STAGE_MODE_2D, view)
    ed.select_scene_node(b1, view)
    ed.do_fit_active_stage(view)
    _ := ed.sync_layout(view, 1240.0, 700.0) or >>
    tv2_b := view.node_bounds(ed.id_top_view) or >>
    tv2_loc := copy_rect(&ed.top_view_local)
    p2_2d := ed.stage_pts[b2]
    sx_b2 := tv2_b.x + world_to_screen_x(&ed.top_view, &tv2_loc, p2_2d.x)
    sy_b2 := tv2_b.y + world_to_screen_y(&ed.top_view, &tv2_loc, stage_point_v(&p2_2d, ed.top_view.axis_mode))
    tv2_dn := ui.InputEvent{
        kind: ui.EV_POINTER_DOWN, window_id: identity.window_id, canvas_id: identity.canvas_id, generation: identity.generation,
        x: sx_b2, y: sy_b2, dx: 0.0, dy: 0.0, button: ui.BUTTON_LEFT, buttons: 1, modifiers: ui.MOD_SHIFT, key: 0, scan: 0, repeat: 0, click_count: 1, time_ns: 1120000000
    }
    tv2_up := ui.InputEvent{
        kind: ui.EV_POINTER_UP, window_id: identity.window_id, canvas_id: identity.canvas_id, generation: identity.generation,
        x: sx_b2, y: sy_b2, dx: 0.0, dy: 0.0, button: ui.BUTTON_LEFT, buttons: 0, modifiers: ui.MOD_SHIFT, key: 0, scan: 0, repeat: 0, click_count: 1, time_ns: 1125000000
    }
    _ := ed.handle_input_event(&tv2_dn, view)
    _ := ed.handle_input_event(&tv2_up, view)
    assert_ui(ed.selected_nodes.len == 2 && is_selected_node(&ed.selected_nodes, b1) && is_selected_node(&ed.selected_nodes, b2), "2D Top View Shift+Click keeps both nodes selected after POINTER_UP") or >>

    // 3. 3D Viewport Shift+Click queues additive pick even with tiny 2px jitter and early Shift release
    ed.set_stage_mode(STAGE_MODE_3D, view)
    ed.select_scene_node(b1, view)
    _ := ed.sync_layout(view, 1240.0, 700.0) or >>
    vp_b := view.node_bounds(ed.id_top_view) or >>
    vp_cx := vp_b.x + vp_b.width * 0.5
    vp_cy := vp_b.y + vp_b.height * 0.5
    cen_before := ed.vp3d.center
    vp3_dn := ui.InputEvent{
        kind: ui.EV_POINTER_DOWN, window_id: identity.window_id, canvas_id: identity.canvas_id, generation: identity.generation,
        x: vp_cx, y: vp_cy, dx: 0.0, dy: 0.0, button: ui.BUTTON_LEFT, buttons: 1, modifiers: ui.MOD_SHIFT, key: 0, scan: 0, repeat: 0, click_count: 1, time_ns: 1130000000
    }
    vp3_mv := ui.InputEvent{
        kind: ui.EV_POINTER_MOVE, window_id: identity.window_id, canvas_id: identity.canvas_id, generation: identity.generation,
        x: vp_cx + 2.0, y: vp_cy + 1.0, dx: 2.0, dy: 1.0, button: 0, buttons: 1, modifiers: ui.MOD_SHIFT, key: 0, scan: 0, repeat: 0, click_count: 0, time_ns: 1132000000
    }
    vp3_up := ui.InputEvent{
        kind: ui.EV_POINTER_UP, window_id: identity.window_id, canvas_id: identity.canvas_id, generation: identity.generation,
        x: vp_cx + 2.0, y: vp_cy + 1.0, dx: 0.0, dy: 0.0, button: ui.BUTTON_LEFT, buttons: 0, modifiers: 0, key: 0, scan: 0, repeat: 0, click_count: 1, time_ns: 1135000000
    }
    _ := ed.handle_input_event(&vp3_dn, view)
    _ := ed.handle_input_event(&vp3_mv, view)
    _ := ed.handle_input_event(&vp3_up, view)
    assert_ui(ed.vp3d.pending_pick && ed.vp3d.pick_additive, "3D Viewport Shift+Click sets pending_pick + pick_additive") or >>
    assert_ui_near(ed.vp3d.center.x, cen_before.x, 1e-9, "3D Viewport 2px jitter during Shift+Click does not pan camera") or >>
    vp_clr := $&ed.vp3d
    vp_clr.pending_pick = false
    vp_clr.pick_additive = false

    // UX enhancements checks:
    // A. Contextual Apply Changes button stays collapsed when clean and opens on edit
    ed.select_scene_node(b1, view)
    _ := ed.sync_layout(view, 1240.0, 700.0) or >>
    assert_ui((view.node_bounds(ed.id_apply_btn) or >>).height <= 0.5, "apply_btn hidden when inspector clean") or >>
    _ := ed.input(ed.id_pos_x, widgets.ROUTE_INPUT, &ui.InputEvent{
        kind: ui.EV_KEY_DOWN, window_id: identity.window_id, canvas_id: identity.canvas_id, generation: identity.generation,
        x: 0.0, y: 0.0, dx: 0.0, dy: 0.0, button: 0, buttons: 0, modifiers: 0, key: ui.KEY_BACKSPACE, scan: 0, repeat: 0, click_count: 0, time_ns: 1140000000
    })
    ed.insp_dirty = true
    _ := ed.sync_layout(view, 1240.0, 700.0) or >>
    assert_ui((view.node_bounds(ed.id_apply_btn) or >>).height > 20.0, "apply_btn shows while inspector has uncommitted edits") or >>
    ed.sync_inspector(&(ed.draft.document() or >>))
    _ := ed.sync_layout(view, 1240.0, 700.0) or >>
    assert_ui((view.node_bounds(ed.id_apply_btn) or >>).height <= 0.5, "apply_btn collapses again after sync/commit") or >>

    // B. Multi-select centroid gizmo, multi-duplicate, smart F focus, transform reset
    ed.set_selection_list(&[b1, b2], view)
    doc_u := ed.draft.document() or >>
    p_b1_u := (doc_u.describe_node(b1) or >>).local_3d.c3
    p_b2_u := (doc_u.describe_node(b2) or >>).local_3d.c3
    mid := vp_multi_gizmo_anchor(&doc_u, ed.selected_node, &ed.selected_nodes, &ed.vp3d)
    assert_ui_near(mid.x, (p_b1_u.x + p_b2_u.x) * 0.5, 1e-4, "3D multi gizmo centers at centroid X") or >>
    cnt_before_dup := doc_u.node_count()
    ed.do_duplicate_node(view)
    assert_ui(ed.selected_nodes.len == 2 && (ed.draft.document() or >>).node_count() == cnt_before_dup + 2, "Cmd+D duplicates all selected nodes") or >>
    ed.do_undo(view)
    assert_ui((ed.draft.document() or >>).node_count() == cnt_before_dup, "single undo removes multi-duplicated nodes") or >>

    ed.set_selection_list(&[b1, b2], view)
    ed.do_focus_selected_or_scene(false, view)
    assert_ui_near(ed.vp3d.center.x, (p_b1_u.x + p_b2_u.x) * 0.5, 0.35, "Smart F focuses selected centroid") or >>
    ed.do_reset_transform(1, view)
    doc_rst := ed.draft.document() or >>
    assert_ui_near((doc_rst.describe_node(b1) or >>).local_3d.c3.xyz().length(), 0.0, 1e-4, "Reset Position zeros b1 xyz") or >>
    assert_ui_near((doc_rst.describe_node(b2) or >>).local_3d.c3.xyz().length(), 0.0, 1e-4, "Reset Position zeros b2 xyz") or >>
    ed.do_undo(view)

    // C. Keyboard shortcuts: Cmd+A select all, H hide, Arrow nudge, Esc collapse
    _ := ed.sync_layout(view, 1240.0, 700.0) or >>
    ev_cmd_a := ui.InputEvent{
        kind: ui.EV_KEY_DOWN, window_id: identity.window_id, canvas_id: identity.canvas_id, generation: identity.generation,
        x: 0.0, y: 0.0, dx: 0.0, dy: 0.0, button: 0, buttons: 0, modifiers: ui.MOD_META, key: 97, scan: 0, repeat: 0, click_count: 0, time_ns: 1150000000
    }
    _ := ed.handle_input_event(&ev_cmd_a, view)
    assert_ui(ed.selected_nodes.len == (ed.draft.document() or >>).node_count() - 1, "Cmd+A selects all non-root nodes") or >>
    ev_esc := ui.InputEvent{
        kind: ui.EV_KEY_DOWN, window_id: identity.window_id, canvas_id: identity.canvas_id, generation: identity.generation,
        x: 0.0, y: 0.0, dx: 0.0, dy: 0.0, button: 0, buttons: 0, modifiers: 0, key: ui.KEY_ESCAPE, scan: 0, repeat: 0, click_count: 0, time_ns: 1152000000
    }
    _ := ed.handle_input_event(&ev_esc, view)
    assert_ui(ed.selected_nodes.len == 1, "Esc collapses multi-selection to single node") or >>

    // D. Numeric label-strip drag scrub on id_pos_x
    ed.select_scene_node(b1, view)
    _ := ed.sync_layout(view, 1240.0, 700.0) or >>
    pxb := view.node_bounds(ed.id_pos_x) or >>
    old_bx := ((ed.draft.document() or >>).describe_node(b1) or >>).local_3d.c3.x
    sc_dn := ui.InputEvent{
        kind: ui.EV_POINTER_DOWN, window_id: identity.window_id, canvas_id: identity.canvas_id, generation: identity.generation,
        x: pxb.x + 12.0, y: pxb.y + 6.0, dx: 0.0, dy: 0.0, button: ui.BUTTON_LEFT, buttons: 1, modifiers: 0, key: 0, scan: 0, repeat: 0, click_count: 1, time_ns: 1160000000
    }
    sc_mv := ui.InputEvent{
        kind: ui.EV_POINTER_MOVE, window_id: identity.window_id, canvas_id: identity.canvas_id, generation: identity.generation,
        x: pxb.x + 62.0, y: pxb.y + 6.0, dx: 50.0, dy: 0.0, button: 0, buttons: 1, modifiers: 0, key: 0, scan: 0, repeat: 0, click_count: 0, time_ns: 1162000000
    }
    sc_up := ui.InputEvent{
        kind: ui.EV_POINTER_UP, window_id: identity.window_id, canvas_id: identity.canvas_id, generation: identity.generation,
        x: pxb.x + 62.0, y: pxb.y + 6.0, dx: 0.0, dy: 0.0, button: ui.BUTTON_LEFT, buttons: 0, modifiers: 0, key: 0, scan: 0, repeat: 0, click_count: 1, time_ns: 1165000000
    }
    _ := ed.handle_input_event(&sc_dn, view)
    _ := ed.handle_input_event(&sc_mv, view)
    _ := ed.handle_input_event(&sc_up, view)
    new_bx := ((ed.draft.document() or >>).describe_node(b1) or >>).local_3d.c3.x
    assert_ui(new_bx > old_bx + 0.5, "numeric label-strip scrub updates node Position X") or >>
    ed.do_undo(view)

    ed.select_scene_node(1, view)
    ed.set_stage_mode(STAGE_MODE_2D, view)
    << 0
}
