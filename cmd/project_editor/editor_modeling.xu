pub struct ModelingPreset {
    pub name_en string
    pub name_zh string
    pub short_en string
    pub short_zh string
    pub r f64
    pub g f64
    pub b f64
    pub metallic f64
    pub roughness f64
    pub emit f64
    pub alpha f64
    pub alpha_mode int
    pub clearcoat f64
    pub clearcoat_roughness f64
    pub sheen_r f64
    pub sheen_g f64
    pub sheen_b f64
    pub sheen_roughness f64
    pub ior f64
    pub double_sided bool
}

fn mp_make(
    ne string, nz string, se string, sz string,
    r f64, g f64, b f64,
    met f64, rgh f64, emt f64,
    alp f64, amode int,
    coat f64, crgh f64,
    sr f64, sg f64, sb f64, srgh f64,
    ior f64, ds bool
) ModelingPreset {
    << ModelingPreset{
        name_en: ne, name_zh: nz, short_en: se, short_zh: sz,
        r: r, g: g, b: b, metallic: met, roughness: rgh, emit: emt,
        alpha: alp, alpha_mode: amode, clearcoat: coat, clearcoat_roughness: crgh,
        sheen_r: sr, sheen_g: sg, sheen_b: sb, sheen_roughness: srgh,
        ior: ior, double_sided: ds
    }
}

pub fn modeling_preset_spec(idx int) ModelingPreset {
    if idx == 1 { << mp_make("Matte Rubber", "哑光橡胶黑", "Rubber", "橡胶", 0.15, 0.16, 0.18, 0.0, 0.86, 0.0, 1.0, rm.ALPHA_OPAQUE, 0.0, 0.08, 0.0, 0.0, 0.0, 0.5, 1.5, false) }
    if idx == 2 { << mp_make("Car Paint Red", "汽车烤漆红", "Paint", "烤漆", 0.84, 0.12, 0.18, 0.32, 0.24, 0.0, 1.0, rm.ALPHA_OPAQUE, 1.0, 0.06, 0.0, 0.0, 0.0, 0.5, 1.55, false) }
    if idx == 3 { << mp_make("Polished Gold", "抛光黄金", "Gold", "黄金", 0.96, 0.76, 0.28, 0.98, 0.16, 0.0, 1.0, rm.ALPHA_OPAQUE, 0.0, 0.08, 0.0, 0.0, 0.0, 0.5, 1.5, false) }
    if idx == 4 { << mp_make("Clear Glass", "透明玻璃", "Glass", "玻璃", 0.86, 0.94, 0.98, 0.0, 0.06, 0.0, 0.32, rm.ALPHA_BLEND, 1.0, 0.05, 0.0, 0.0, 0.0, 0.5, 1.52, true) }
    if idx == 5 { << mp_make("Polished Jade", "翡翠玉石", "Jade", "玉石", 0.16, 0.64, 0.44, 0.0, 0.18, 0.0, 1.0, rm.ALPHA_OPAQUE, 0.85, 0.08, 0.0, 0.0, 0.0, 0.5, 1.66, false) }
    if idx == 6 { << mp_make("Clear Water", "清澈水面", "Water", "水面", 0.18, 0.56, 0.76, 0.0, 0.05, 0.0, 0.48, rm.ALPHA_BLEND, 1.0, 0.05, 0.0, 0.0, 0.0, 0.5, 1.33, true) }
    if idx == 7 { << mp_make("Velvet Fabric", "丝绒织物", "Velvet", "丝绒", 0.46, 0.18, 0.54, 0.0, 0.88, 0.0, 1.0, rm.ALPHA_OPAQUE, 0.0, 0.08, 0.78, 0.56, 0.88, 0.38, 1.5, false) }
    if idx == 8 { << mp_make("Brushed Steel", "拉丝精钢", "Steel", "精钢", 0.76, 0.78, 0.82, 0.94, 0.28, 0.0, 1.0, rm.ALPHA_OPAQUE, 0.0, 0.08, 0.0, 0.0, 0.0, 0.5, 1.5, false) }
    if idx == 9 { << mp_make("Warm Oak Wood", "暖色原木", "Wood", "原木", 0.56, 0.37, 0.22, 0.0, 0.68, 0.0, 1.0, rm.ALPHA_OPAQUE, 0.18, 0.35, 0.0, 0.0, 0.0, 0.5, 1.5, false) }
    if idx == 10 { << mp_make("Mirror Chrome", "抛光银铬", "Chrome", "银铬", 0.93, 0.94, 0.96, 1.0, 0.07, 0.0, 1.0, rm.ALPHA_OPAQUE, 0.0, 0.08, 0.0, 0.0, 0.0, 0.5, 1.5, false) }
    if idx == 11 { << mp_make("Brushed Copper", "古铜红铜", "Copper", "红铜", 0.88, 0.48, 0.34, 0.95, 0.24, 0.0, 1.0, rm.ALPHA_OPAQUE, 0.0, 0.08, 0.0, 0.0, 0.0, 0.5, 1.5, false) }
    if idx == 12 { << mp_make("Cast Iron", "哑光铸铁", "Iron", "铸铁", 0.24, 0.25, 0.28, 0.85, 0.54, 0.0, 1.0, rm.ALPHA_OPAQUE, 0.0, 0.08, 0.0, 0.0, 0.0, 0.5, 1.5, false) }
    if idx == 13 { << mp_make("Frosted Glass", "磨砂玻璃", "Frost", "磨砂", 0.90, 0.93, 0.96, 0.0, 0.36, 0.0, 0.58, rm.ALPHA_BLEND, 0.45, 0.22, 0.0, 0.0, 0.0, 0.5, 1.50, true) }
