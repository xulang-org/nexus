pub fn modeling_preset_to_material(idx int) rm.MaterialAsset {
    p := modeling_preset_spec(idx)
    $m := rm.default_material_asset(p.name_en + "")
    m.base_color = fm.vec3(p.r, p.g, p.b)
    m.alpha = p.alpha
    m.alpha_mode = p.alpha_mode
    m.metallic = p.metallic
    m.roughness = p.roughness
    ev := math.max(0.0, math.min(16.0, p.emit))
    m.emission = fm.vec3(ev * p.r, ev * p.g, ev * p.b)
    m.clearcoat = p.clearcoat
    m.clearcoat_roughness = p.clearcoat_roughness
    m.sheen_color = fm.vec3(p.sheen_r, p.sheen_g, p.sheen_b)
    m.sheen_roughness = p.sheen_roughness
    m.ior = p.ior
    m.double_sided = p.double_sided
    << m
}

pub fn shape_select_key(choice int) string {
    if choice == 1 { << "box" }
    if choice == 2 { << "sphere" }
    if choice == 3 { << "cylinder" }
    if choice == 4 { << "cone" }
    if choice == 5 { << "capsule" }
    if choice == 6 { << "torus" }
    if choice == 7 { << "pyramid" }
    if choice == 8 { << "hex_prism" }
    if choice == 9 { << "tube" }
    if choice == 10 { << "dome" }
    if choice == 11 { << "plane" }
    if choice == 12 { << "wedge" }
    if choice == 13 { << "stair" }
    if choice == 14 { << "arch" }
    if choice == 15 { << "csg_cut" }
    << ""
}

