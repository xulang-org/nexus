fn try_present_frame(view $&widgets.View, ed $&Editor) bool {
    frame_c := layout.tight(ed.viewport_w, ed.viewport_h) >>> (err) {
        _ := err
        << false
    }
    _ := widgets.present_styled(view, &frame_c, ed) >>> (err) {
        _ := err
        << false
    }
    << true
}

fn instant_plus_ms(now time.Instant, ms int) time.Instant {
    dur := time.milliseconds(ms) >>> (err) {
        _ := err
        << time.zero_instant()
    }
    << now.add(dur) >>> (err) {
        _ := err
        << time.zero_instant()
    }
}

fn earlier_deadline(a time.Instant, b time.Instant) time.Instant {
    if a.is_zero() { << b }
    if b.is_zero() { << a }
    if a.before(b) { << a }
    << b
}

fn try_file_paths(res &ui.RequestResult) []string {
    << ui.file_paths(res) >>> (err) {
        _ := err
        << []string{}
    }
}

fn process_ui_event(
    event &ui.Event,
    identity &ui.CanvasEvent,
    import_req &ui.Request,
    open_proj_req &ui.Request,
    relocate_req &ui.Request,
    ed $&Editor,
    view $&widgets.View
) bool {
    if event.kind == ui.EV_EXIT { << false }
    if event.kind == ui.EV_NONE { << true }
    if event.kind == ui.EV_CLOSED || event.kind == ui.EV_CANVAS_CLOSED {
        if event.window_id == identity.window_id { << false }
        << true
    }
    if event.kind == ui.EV_REQUEST {
        result := ui.request_of(event) >>> (err) {
            _ := err
            << true
        }
        if result.matches(import_req) {
            ed.import_active = false
            if result.status == ui.REQUEST_COMPLETED {
                paths := try_file_paths(&result)
                if paths.len > 0 {
                    p := paths[0] + ""
                    try_finish_import(&p, ed, view)
                }
            } else if result.status == ui.REQUEST_CANCELLED {
                ed.set_status(STATUS_INFO, "Import cancelled", view)
            } else {
                ed.set_status(STATUS_ERR, "Import failed", view)
            }
            ed.sync_toolbar_states()
            << true
        }
        if result.matches(open_proj_req) {
            ed.open_proj_active = false
            if result.status == ui.REQUEST_COMPLETED {
                paths := try_file_paths(&result)
                if paths.len > 0 {
                    p := paths[0] + ""
                    try_finish_open_project(&p, ed, view)
                }
            } else if result.status == ui.REQUEST_CANCELLED {
                ed.set_status(STATUS_INFO, "Open project cancelled", view)
            } else {
                ed.set_status(STATUS_ERR, "Open project failed", view)
            }
            ed.sync_toolbar_states()
            << true
        }
        if result.matches(relocate_req) {
            ed.relocate_active = false
            if result.status == ui.REQUEST_COMPLETED {
                paths := try_file_paths(&result)
                if paths.len > 0 {
                    p := paths[0] + ""
                    try_finish_relocate(&p, ed, view)
                }
            } else if result.status == ui.REQUEST_CANCELLED {
                ed.set_status(STATUS_INFO, "Relocate asset cancelled", view)
            } else {
                ed.set_status(STATUS_ERR, "Relocate asset failed", view)
            }
            ed.sync_toolbar_states()
            << true
        }
    }
    if event.window_id != identity.window_id { << true }
    try_handle_ui_event(event, ed, view)
    << true
}

fn any_async_request_pending(ed &Editor) bool {
    << ed.req_import_glb || ed.req_open_project || ed.req_relocate_asset ||
       ed.req_launch_viewport || ed.req_launch_preview || ed.req_launch_tilemap ||
       ed.req_export_project
}

fn try_handle_ui_event(event &ui.Event, ed $&Editor, view $&widgets.View) {
    _ := ed.handle_ui_event(event, view) >>> (err) {
        ed.set_status(STATUS_ERR, err.msg(), view)
        <<
    }
}

fn run_editor_worker(events chan ui.Event, cfg LaunchConfig, project Project, win ui.Window) int {
    ready := wait_ready(events)
    if ready.kind == ui.EV_EXIT || ready.kind == ui.EV_WINDOW_FAILED {
        << 0
    }
    identity := ui.canvas_of(&ready) >>>
    context := draw.context_of(&ready) >>>

    $w := win
    try_native_setup(&w)
    if cfg.script_path.len > 0 {
        _ := ui.native_set_opacity(0) >>> (err) {
            _ := err
            << 0
        }
    }

    $view := create_editor_view(&context, &identity, 1240.0, 700.0) >>>
    $ed := create_editor(
        $&view,
        &context,
        &identity,
        project,
        cfg.output_dir + "",
        cfg.validator_bin + "",
        cfg.preview_bin + "",
        cfg.viewport_bin + "",
        1240.0,
        700.0
    ) >>>
    ed.tilemap_bin = cfg.tilemap_bin + ""
    ed.sync_layout($&view, 1240.0, 700.0) >>>

    // Auto-select 3D Studio (or TileMap 2D for tile-only scenes) on normal launch
    init_doc := ed.draft.document() >>>
    if init_doc.tilemap_2d_count() > 0 && init_doc.surface_count() == 0 && !init_doc.has_modeling_attachments() {
        ed.set_stage_mode(STAGE_MODE_TILEMAP, $&view)
    } else {
        ed.set_stage_mode(STAGE_MODE_3D, $&view)
    }

    $script := load_script_runner(&cfg.script_path) >>>
    $xacp_ctrl := open_editor_xacp_ctrl(cfg.xacp_port)
    $xacp_tree := empty_shadow_tree() >>>
    $xacp_inp := controls.new_input_map()
    $xacp_host := new_editor_xacp_host(cfg.preview_xacp_port)
    init_proj := clone_project(&ed.project)
    init_src := ed.draft.source + ""
    $embed := start_embed_bridge(cfg.viewport_bin + "", &init_proj, &init_src, &init_doc)
    _ := try_present_frame($&view, $&ed)

    workers := chan WorkerDone{cap: 8}
    $import_req := ui.Request{id: 0, window_id: 0, canvas_id: 0, generation: 0, kind: 0}
    $open_proj_req := ui.Request{id: 0, window_id: 0, canvas_id: 0, generation: 0, kind: 0}
    $relocate_req := ui.Request{id: 0, window_id: 0, canvas_id: 0, generation: 0, kind: 0}
    $retry_deadline := time.zero_instant()
    $last_dirty := false

    while true {
        if script.active && !ed.close_pending {
            step_script_runner($&script, $&ed, $&view, time.instant()) >>> (serr) {
                if xacp_ctrl.is_open() { xacp_ctrl.close() }
                stop_embed_bridge($&embed)
                ed.dispose($&view)
                >> serr
            }
        }
        if xacp_ctrl.is_open() && !ed.close_pending {
            xacp_tree = step_editor_xacp($&xacp_host, $&xacp_ctrl, xacp_tree, $&xacp_inp, $&ed, $&view)
        }
        if ed.close_pending {
            try_accept_and_close($&w)
            <-
        }

        cur_dirty := ed.draft.dirty()
        if cur_dirty != last_dirty {
            $guard := 0
            if cur_dirty { guard = 1 }
            try_close_guard(guard)
            last_dirty = cur_dirty
        }

        if ed.req_import_glb {
            ed.req_import_glb = false
            if !ed.import_active {
                import_req = start_import_request(&identity, $&ed, $&view)
            }
        }

        if ed.req_open_project {
            ed.req_open_project = false
            if !ed.open_proj_active {
                open_proj_req = start_open_project_request(&identity, $&ed, $&view)
            }
        }

        if ed.req_relocate_asset {
            ed.req_relocate_asset = false
            if !ed.relocate_active {
                relocate_req = start_relocate_request(&identity, $&ed, $&view)
            }
        }

        if ed.req_launch_viewport {
            ed.req_launch_viewport = false
            if !ed.viewport_active {
                try_launch_viewport(workers, $&ed, $&view)
            }
        }

        if ed.req_launch_preview {
            ed.req_launch_preview = false
            if !ed.preview_active {
                try_launch_preview(workers, $&ed, $&view, cfg.preview_xacp_port)
            }
        }

        if ed.req_launch_tilemap {
            ed.req_launch_tilemap = false
            if !ed.tilemap_active {
                try_launch_tilemap(workers, $&ed, $&view)
            }
        }

        if ed.req_export_project {
            ed.req_export_project = false
            if !ed.export_active {
                try_launch_export(workers, $&ed, $&view)
            }
        }

        now := time.instant()
        ed.tick_animations($&view, now)
        dispatch_embed_requests($&embed, $&ed)
        if try_present_frame($&view, $&ed) {
            retry_deadline = time.zero_instant()
        } else {
            retry_deadline = instant_plus_ms(now, 16)
        }
        if xacp_ctrl.is_open() {
            fulfill_editor_xacp_screenshot($&xacp_ctrl, $&ed, $&view)
        }

        $deadline := earlier_deadline(ed.next_tick_deadline(now), retry_deadline)
        if script.active && !script.waiting_frame {
            deadline = earlier_deadline(deadline, instant_plus_ms(now, 5))
        } else if script.waiting_frame && !script.wait_deadline.is_zero() {
            deadline = earlier_deadline(deadline, script.wait_deadline)
        } else if xacp_ctrl.is_open() {
            deadline = earlier_deadline(deadline, instant_plus_ms(now, 15))
        }
        step := next_event_or_worker(events, workers, embed.msg_ch, embed.active, deadline)
        event := &step.event

        if step.kind == WAIT_EMBED {
            em := &step.embed
            handle_embed_msg(em, $&ed, $&view)
            ->
        }
        if step.kind == WAIT_WORKER {
            wmsg := &step.worker
            if wmsg.kind == WORKER_VIEWPORT {
                ed.viewport_active = false
                if wmsg.ok && path_exists(wmsg.output_scene + "") {
                    try_finish_viewport(wmsg, $&ed, $&view)
                } else if !wmsg.ok {
                    ed.set_status(STATUS_ERR, "3D View error: " + wmsg.message, $&view)
                } else {
                    ed.set_status(STATUS_INFO, "3D View closed without changes", $&view)
                }
                if wmsg.temp_dir.len > 0 {
                    try_remove_all(wmsg.temp_dir + "")
                }
                ed.sync_toolbar_states()
                ed.repaint_all($&view)
                ->
            }
            if wmsg.kind == WORKER_PREVIEW {
                ed.preview_active = false
                ed.sync_toolbar_states()
                if wmsg.ok {
                    ed.set_status(STATUS_INFO, wmsg.message, $&view)
                } else {
                    ed.set_status(STATUS_ERR, "Preview error: " + wmsg.message, $&view)
                }
                ed.repaint_all($&view)
                ->
            }
            if wmsg.kind == WORKER_TILEMAP {
                ed.tilemap_active = false
                if wmsg.ok && wmsg.output_scene.len > 0 && path_exists(wmsg.output_scene + "") {
                    try_finish_tilemap(wmsg, $&ed, $&view)
                } else {
                    if !wmsg.ok {
                        ed.set_status(STATUS_ERR, "TileMap Editor error: " + wmsg.message, $&view)
                    } else {
                        ed.set_status(STATUS_INFO, "TileMap Editor closed without changes", $&view)
                    }
                    ed.refresh_after_document_change(false, $&view)
                }
                if wmsg.temp_dir.len > 0 {
                    try_remove_all(wmsg.temp_dir + "")
                }
                ed.sync_toolbar_states()
                ed.repaint_all($&view)
                ->
            }
            if wmsg.kind == WORKER_EXPORT {
                ed.export_active = false
                ed.sync_toolbar_states()
                if wmsg.ok {
                    ed.set_status(STATUS_OK, wmsg.message, $&view)
                } else {
                    ed.set_status(STATUS_ERR, "Export error: " + wmsg.message, $&view)
                }
                ed.repaint_all($&view)
                ->
            }
        }

        if !process_ui_event(event, &identity, &import_req, &open_proj_req, &relocate_req, $&ed, $&view) {
            <-
        }
        $burst := 0
        $closed := false
        while burst < 64 && !ed.close_pending && !any_async_request_pending(&ed) {
            pending := ui.poll_chan(events)
            if pending.kind == ui.EV_NONE { <- }
            if !process_ui_event(&pending, &identity, &import_req, &open_proj_req, &relocate_req, $&ed, $&view) {
                closed = true
                <-
            }
            burst = burst + 1
        }
        if closed { <- }
    }
    if xacp_ctrl.is_open() { xacp_ctrl.close() }
    stop_embed_bridge($&embed)
    ed.dispose($&view)
    << 0
}

fn worker_entry(events chan ui.Event, cfg LaunchConfig, project Project, win ui.Window) {
    is_script := cfg.script_path.len > 0
    run_editor_worker(events, cfg, project, win) >>> (err) {
        eprintln("nexus-project-editor: " + err.msg())
        if is_script { <<< 1 }
        <<
    }
}

fn path_exists(path string) bool {
    _ := os.stat(path + "") >>> (err) { << false }
    << true
}

fn run_headless_snapshot_worker(events chan ui.Event, cfg LaunchConfig, project Project) int {
    ready := wait_ready(events)
    if ready.kind == ui.EV_EXIT || ready.kind == ui.EV_WINDOW_FAILED {
        >> errors.new("failed to open editor window for headless check")
    }
    identity := ui.canvas_of(&ready) >>>
    context := draw.context_of(&ready) >>>
    _ := ui.native_set_opacity(0) >>> (err) {
        _ := err
        << 0
    }
    $view := create_editor_view(&context, &identity, 1240.0, 700.0) >>>
    $ed := create_editor(
        $&view,
        &context,
        &identity,
        project,
        cfg.output_dir + "",
        cfg.validator_bin + "",
        cfg.preview_bin + "",
        cfg.viewport_bin + "",
        1240.0,
        700.0
    ) >>>
    ed.tilemap_bin = cfg.tilemap_bin + ""
    run_ui_self_checks($&view, $&ed, &context, &identity, cfg.output_dir + "") >>>
    node_cnt := ed.stage_pts.len
    ed.dispose($&view)
    eprintln("HEADLESS_CHECK_OK " + cfg.project_path + " (" + str(node_cnt) + " nodes)")
    << 0
}

fn capture_headless_check(events chan ui.Event, cfg LaunchConfig, project Project) string {
    _ := run_headless_snapshot_worker(events, cfg, project) >>> (err) {
        << err.msg()
    }
    << ""
}

fn worker_headless_check(events chan ui.Event, cfg LaunchConfig, project Project, res chan string) {
    msg := capture_headless_check(events, cfg, project)
    res <- msg + ""
    if msg.len > 0 {
        eprintln("HEADLESS_CHECK_FAIL: " + msg)
        <<< 1
    }
    _ := ui.append_shell_cmd("quit_app") >>> (err) {
        _ := err
        <<
    }
}

fn run_headless_check(cfg LaunchConfig, project Project) int {
    $app := ui.new_app() >>>
    $win := app.open_content_window(ui.WindowOpts{title: "Nexus Scene Editor Check", width: 1240, height: 700}, ui.CONTENT_DRAW) >>>
    draw.attach($&win) >>>
    res := chan string{cap: 1}
    xu worker_headless_check(app.event_ch, cfg, project, res)
    app.run() >>>
    err_msg := <- res
    if err_msg.len > 0 {
        >> errors.new(err_msg)
    }
    << 0
}

fn run() int {
    cfg := parse_args() >>>
    if cfg.show_help {
        print_usage()
        << 0
    }
    project := load_project(cfg.project_path + "") >>>
    if cfg.verify_headless {
        << run_headless_check(cfg, project) >>>
    }
    $app := ui.new_app() >>>
    $win := app.open_content_window(ui.WindowOpts{title: "Nexus Scene Editor — " + filepath.base(&project.directory), width: 1240, height: 700}, ui.CONTENT_DRAW) >>>
    draw.attach($&win) >>>
    xu worker_entry(app.event_ch, cfg, project, win)
    << app.run() >>>
}

fn main() int {
    << run() >>> (err) {
        eprintln(err.msg())
        << 1
    }
}
