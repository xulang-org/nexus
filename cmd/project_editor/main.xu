@main

resource #"github.com/xulang-org/nexus/resources/scene"
files #"github.com/xulang-org/nexus/integration/scene"
#ui
#ui/draw
#ui/layout
widgets #ui/widgets
#os
#os/exec
#path/filepath
#strings
#time
#errors

struct LaunchConfig {
    pub project_path string
    pub output_dir string
    pub validator_bin string
    pub preview_bin string
    pub viewport_bin string
    pub verify_headless bool
    pub show_help bool
}

const WORKER_VIEWPORT = 1
const WORKER_PREVIEW = 2

struct WorkerDone {
    pub kind int
    pub ok bool
    pub message string
    pub temp_dir string
    pub output_scene string
    pub revision string
}

fn print_usage() {
    println("usage: nexus-project-editor <project.json> [options]")
    println("  --output <dir>      output directory for editor snap settings & published previews")
    println("  --validator <bin>   scene/GLB validator binary (default build/nexus-project-validate)")
    println("  --preview <bin>     preview executable (default build/nexus-project-preview)")
    println("  --viewport <bin>    3D viewport executable (default build/nexus-project-viewport)")
    println("  --headless-check    verify project load, layout, and snapshot cleanly without opening a window")
}

fn parse_args() LaunchConfig {
    args := os.args()
    $cfg := LaunchConfig{
        project_path: "",
        output_dir: "build/editor-output",
        validator_bin: "build/nexus-project-validate",
        preview_bin: "build/nexus-project-preview",
        viewport_bin: "build/nexus-project-viewport",
        verify_headless: false,
        show_help: false
    }
    $i := 1
    while i < args.len {
        a := args[i] + ""
        if a == "-h" || a == "--help" {
            cfg.show_help = true
            << cfg
        } else if a == "--output" {
            i = i + 1
            if i >= args.len { >> errors.new("missing value for --output") }
            cfg.output_dir = args[i] + ""
        } else if a == "--validator" {
            i = i + 1
            if i >= args.len { >> errors.new("missing value for --validator") }
            cfg.validator_bin = args[i] + ""
        } else if a == "--preview" {
            i = i + 1
            if i >= args.len { >> errors.new("missing value for --preview") }
            cfg.preview_bin = args[i] + ""
        } else if a == "--viewport" {
            i = i + 1
            if i >= args.len { >> errors.new("missing value for --viewport") }
            cfg.viewport_bin = args[i] + ""
        } else if a == "--headless-check" {
            cfg.verify_headless = true
        } else if strings.has_prefix(&a, "-") {
            >> errors.new("unknown option: " + a)
        } else if cfg.project_path.len == 0 {
            cfg.project_path = a
        } else {
            >> errors.new("unexpected argument: " + a)
        }
        i = i + 1
    }
    if cfg.project_path.len == 0 {
        >> errors.new("missing <project.json> path")
    }
    << cfg
}

fn spawn_viewport_worker(
    ch chan WorkerDone,
    bin string,
    staged_scene string,
    out_scene string,
    tmp_dir string,
    revision string,
    snap SnapSettings
) {
    mv := fmt_coord(snap.move_step)
    rt := fmt_coord(snap.rotate_deg)
    $scale_pct := snap.scale_pct
    if scale_pct < 0.01 { scale_pct = 0.01 }
    if scale_pct > 100.0 { scale_pct = 100.0 }
    sc := fmt_coord(scale_pct)
    out_arg := out_scene + ""
    out := exec.command(
        bin,
        "--scene", staged_scene,
        "--output", out_arg,
        "--snap-move", mv,
        "--snap-rotate", rt,
        "--snap-scale", sc
    ).combined_output() or (err) {
        ch <- WorkerDone{
            kind: WORKER_VIEWPORT,
            ok: false,
            message: err.msg(),
            temp_dir: tmp_dir + "",
            output_scene: out_scene + "",
            revision: revision + ""
        }
        <<
    }
    _ := out
    ch <- WorkerDone{
        kind: WORKER_VIEWPORT,
        ok: true,
        message: "3D viewport session finished",
        temp_dir: tmp_dir,
        output_scene: out_scene,
        revision: revision
    }
}

fn spawn_preview_worker(ch chan WorkerDone, bin string, pub_scene string) {
    out := exec.command(bin, "--scene", pub_scene).combined_output() or (err) {
        ch <- WorkerDone{
            kind: WORKER_PREVIEW,
            ok: false,
            message: err.msg(),
            temp_dir: "",
            output_scene: "",
            revision: ""
        }
        <<
    }
    _ := out
    ch <- WorkerDone{
        kind: WORKER_PREVIEW,
        ok: true,
        message: "Preview closed",
        temp_dir: "",
        output_scene: "",
        revision: ""
    }
}

struct WaitStep {
    is_worker bool
    event ui.Event
    worker WorkerDone
}

fn empty_worker_done() WorkerDone {
    << WorkerDone{kind: 0, ok: false, message: "", temp_dir: "", output_scene: "", revision: ""}
}

fn next_event_or_worker(events chan ui.Event, workers chan WorkerDone, deadline time.Instant) WaitStep {
    none_ev := ui.Event{kind: ui.EV_NONE, window_id: 0, menu_id: "", width: 0, height: 0}
    if deadline.is_zero() {
        select {
            ev := <- events { << WaitStep{is_worker: false, event: ev, worker: empty_worker_done()} }
            w := <- workers {
                << WaitStep{is_worker: true, event: none_ev, worker: w}
            }
        }
    }
    delay := deadline.since(time.instant())
    if delay.nanoseconds() <= 0 {
        << WaitStep{is_worker: false, event: none_ev, worker: empty_worker_done()}
    }
    timer := delay.timer()
    select {
        ev := <- events {
            timer.stop()
            << WaitStep{is_worker: false, event: ev, worker: empty_worker_done()}
        }
        w := <- workers {
            timer.stop()
            << WaitStep{is_worker: true, event: none_ev, worker: w}
        }
        _ := <- timer.c {
            timer.stop()
        }
    }
    << WaitStep{is_worker: false, event: none_ev, worker: empty_worker_done()}
}

fn wait_ready(events chan ui.Event) ui.Event {
    while true {
        ev := <- events
        if ev.kind == ui.EV_EXIT || ev.kind == ui.EV_CANVAS_READY || ev.kind == ui.EV_WINDOW_FAILED {
            << ev
        }
    }
    << ui.Event{kind: ui.EV_EXIT, window_id: 0, menu_id: "", width: 0, height: 0}
}

fn start_import_request(identity &ui.CanvasEvent, ed $&Editor, view $&widgets.View) ui.Request {
    $opts := ui.file_dialog_options()
    opts.title = "Import GLB 3D Asset"
    opts.multiple = false
    opts.filters = [ui.FileFilter{label: "GLB Models", extensions: ["glb"]}]
    req := ui.open_files_async(identity, &opts) or (err) {
        ed.set_status(STATUS_ERR, err.msg(), view)
        << ui.Request{id: 0, window_id: 0, canvas_id: 0, generation: 0, kind: 0}
    }
    if req.id > 0 {
        ed.import_active = true
        ed.sync_toolbar_states()
        ed.set_status(STATUS_INFO, "Choose a .glb file to import...", view)
    }
    << req
}

fn try_remove_all(path string) {
    _ := os.remove_all(path + "") or (err) {
        _ := err
        <<
    }
}

fn try_content_cmd(w &ui.Window, cmd string) {
    _ := w.content_command(cmd + "") or (err) {
        _ := err
        <<
    }
}

fn try_native_setup(w &ui.Window) {
    try_content_cmd(w, "input_enabled\t1")
    try_content_cmd(w, "pan_enabled\t0")
    _ := ui.native_set_appearance("light") or (err) {
        _ := err
        <<
    }
    _ := ui.native_set_min_size(940, 560) or (err) {
        _ := err
        <<
    }
    _ := ui.native_set_close_guard(0) or (err) {
        _ := err
        <<
    }
}

fn try_close_guard(guard int) {
    _ := ui.native_set_close_guard(guard) or (err) {
        _ := err
        <<
    }
}

fn try_accept_and_close(w $&ui.Window) {
    try_close_guard(0)
    _ := ui.native_accept_close() or (err) {
        _ := err
        <<
    }
    _ := w.request_close() or (err) {
        _ := err
        <<
    }
}

fn launch_viewport_session(workers chan WorkerDone, ed $&Editor, view $&widgets.View) int {
    tmp_dir := os.mkdir_temp("", "nexus-editor-vp-") or >>
    doc := ed.draft.document() or (err) {
        try_remove_all(tmp_dir + "")
        >> err
    }
    staged := stage_scene(&ed.project, &doc, &ed.draft.source, &tmp_dir) or (err) {
        try_remove_all(tmp_dir + "")
        >> err
    }
    out_scene := filepath.join([tmp_dir + "", "viewport-output.xuscene"])
    rev := ed.draft.current + ""
    ed.viewport_active = true
    ed.sync_toolbar_states()
    ed.set_status(STATUS_INFO, "3D View open...", view)
    ed.repaint_all(view)
    xu spawn_viewport_worker(workers, ed.viewport_bin + "", staged, out_scene, tmp_dir, rev, ed.snap)
    << 0
}

fn launch_preview_session(workers chan WorkerDone, ed $&Editor, view $&widgets.View) int {
    doc := ed.draft.document() or >>
    scene_key := ed.project.scenes[ed.scene_index].key + ""
    pub_scene := publish_for_preview(&ed.project.path, &ed.output_dir, &ed.validator_bin, &scene_key, &doc) or >>
    ed.preview_active = true
    ed.sync_toolbar_states()
    ed.set_status(STATUS_INFO, "Preview running (" + scene_key + ")...", view)
    ed.repaint_all(view)
    xu spawn_preview_worker(workers, ed.preview_bin + "", pub_scene)
    << 0
}

fn finish_viewport_session(wmsg &WorkerDone, ed $&Editor, view $&widgets.View) int {
    captured := files.load(wmsg.output_scene + "") or >>
    d := $&ed.draft
    d.merge_viewport(&captured, &wmsg.revision) or >>
    ed.refresh_after_document_change(false, view)
    ed.set_status(STATUS_OK, "Applied 3D Viewport edits", view)
    << 0
}

fn finish_glb_import(glb_path &string, ed $&Editor, view $&widgets.View) int {
    imp := import_external_glb(&ed.project.path, glb_path, &ed.validator_bin) or >>
    reloaded := load_project(ed.project.path + "") or >>
    ed.project = reloaded
    ed.refresh_project_selectors()
    for k in 0:ed.project.assets.len {
        if ed.project.assets[k].key == imp.uid {
            set_sel_selected($&ed.asset_select, k)
        }
    }
    ed.set_status(STATUS_OK, "Imported " + imp.rel_path + " (" + str(imp.primitive_count) + " prims)", view)
    repaint(view, ed.id_left_pane)
    << 0
}

fn try_launch_viewport(workers chan WorkerDone, ed $&Editor, view $&widgets.View) {
    _ := launch_viewport_session(workers, ed, view) or (err) {
        ed.set_status(STATUS_ERR, err.msg(), view)
        <<
    }
}

fn try_launch_preview(workers chan WorkerDone, ed $&Editor, view $&widgets.View) {
    _ := launch_preview_session(workers, ed, view) or (err) {
        ed.set_status(STATUS_ERR, err.msg(), view)
        <<
    }
}

fn try_finish_viewport(wmsg &WorkerDone, ed $&Editor, view $&widgets.View) {
    _ := finish_viewport_session(wmsg, ed, view) or (err) {
        ed.set_status(STATUS_ERR, err.msg(), view)
        <<
    }
}

fn try_finish_import(p &string, ed $&Editor, view $&widgets.View) {
    _ := finish_glb_import(p, ed, view) or (err) {
        ed.set_status(STATUS_ERR, err.msg(), view)
        <<
    }
}

fn try_handle_ui_event(event &ui.Event, ed $&Editor, view $&widgets.View) {
    _ := ed.handle_ui_event(event, view) or (err) {
        ed.set_status(STATUS_ERR, err.msg(), view)
        <<
    }
}

fn run_editor_worker(events chan ui.Event, cfg LaunchConfig, project Project, win ui.Window) int {
    ready := wait_ready(events)
    if ready.kind == ui.EV_EXIT || ready.kind == ui.EV_WINDOW_FAILED {
        << 0
    }
    identity := ui.canvas_of(&ready) or >>
    context := draw.context_of(&ready) or >>

    $w := win
    try_native_setup(&w)

    $view := create_editor_view(&context, &identity, 1240.0, 700.0) or >>
    $ed := create_editor(
        $&view,
        &context,
        &identity,
        project,
        cfg.output_dir + "",
        cfg.validator_bin + "",
        cfg.preview_bin + "",
        cfg.viewport_bin + "",
        1240.0,
        700.0
    ) or >>
    ed.sync_layout($&view, 1240.0, 700.0) or >>
    constraints := layout.tight(ed.viewport_w, ed.viewport_h) or >>
    _ := widgets.present_styled($&view, &constraints, $&ed) or >>

    workers := chan WorkerDone{cap: 8}
    $import_req := ui.Request{id: 0, window_id: 0, canvas_id: 0, generation: 0, kind: 0}
    $last_dirty := false

    while true {
        if ed.close_pending {
            try_accept_and_close($&w)
            <-
        }

        cur_dirty := ed.draft.dirty()
        if cur_dirty != last_dirty {
            $guard := 0
            if cur_dirty { guard = 1 }
            try_close_guard(guard)
            last_dirty = cur_dirty
        }

        if ed.req_import_glb {
            ed.req_import_glb = false
            if !ed.import_active {
                import_req = start_import_request(&identity, $&ed, $&view)
            }
        }

        if ed.req_launch_viewport {
            ed.req_launch_viewport = false
            if !ed.viewport_active {
                try_launch_viewport(workers, $&ed, $&view)
            }
        }

        if ed.req_launch_preview {
            ed.req_launch_preview = false
            if !ed.preview_active {
                try_launch_preview(workers, $&ed, $&view)
            }
        }

        now := time.instant()
        ed.tick_animations($&view, now)
        frame_c := layout.tight(ed.viewport_w, ed.viewport_h) or >>
        _ := widgets.present_styled($&view, &frame_c, $&ed) or >>

        deadline := ed.next_tick_deadline(now)
        step := next_event_or_worker(events, workers, deadline)
        event := &step.event

        if step.is_worker {
            wmsg := &step.worker
            if wmsg.kind == WORKER_VIEWPORT {
                ed.viewport_active = false
                if wmsg.ok && path_exists(wmsg.output_scene + "") {
                    try_finish_viewport(wmsg, $&ed, $&view)
                } else if !wmsg.ok {
                    ed.set_status(STATUS_ERR, "3D View error: " + wmsg.message, $&view)
                } else {
                    ed.set_status(STATUS_INFO, "3D View closed without changes", $&view)
                }
                if wmsg.temp_dir.len > 0 {
                    try_remove_all(wmsg.temp_dir + "")
                }
                ed.sync_toolbar_states()
                ed.repaint_all($&view)
                ->
            }
            if wmsg.kind == WORKER_PREVIEW {
                ed.preview_active = false
                ed.sync_toolbar_states()
                if wmsg.ok {
                    ed.set_status(STATUS_INFO, wmsg.message, $&view)
                } else {
                    ed.set_status(STATUS_ERR, "Preview error: " + wmsg.message, $&view)
                }
                ed.repaint_all($&view)
                ->
            }
        }

        if event.kind == ui.EV_EXIT { <- }
        if event.kind == ui.EV_NONE { -> }
        if event.kind == ui.EV_CLOSED || event.kind == ui.EV_CANVAS_CLOSED {
            if event.window_id == identity.window_id { <- }
            ->
        }
        if event.kind == ui.EV_REQUEST {
            result := ui.request_of(event) or >>
            if result.matches(&import_req) {
                ed.import_active = false
                if result.status == ui.REQUEST_COMPLETED {
                    paths := ui.file_paths(&result) or >>
                    if paths.len > 0 {
                        p := paths[0] + ""
                        try_finish_import(&p, $&ed, $&view)
                    }
                } else if result.status == ui.REQUEST_CANCELLED {
                    ed.set_status(STATUS_INFO, "Import GLB cancelled", $&view)
                } else {
                    ed.set_status(STATUS_ERR, "Import GLB failed", $&view)
                }
                ed.sync_toolbar_states()
                ->
            }
        }
        if event.window_id != identity.window_id { -> }
        try_handle_ui_event(event, $&ed, $&view)
    }
    ed.dispose($&view)
    << 0
}

fn worker_entry(events chan ui.Event, cfg LaunchConfig, project Project, win ui.Window) {
    run_editor_worker(events, cfg, project, win) or (err) {
        eprintln("nexus-project-editor: " + err.msg())
        <<
    }
}

fn path_exists(path string) bool {
    _ := os.stat(path + "") or (err) { << false }
    << true
}

fn run_headless_snapshot_worker(events chan ui.Event, cfg LaunchConfig, project Project) int {
    ready := wait_ready(events)
    if ready.kind == ui.EV_EXIT || ready.kind == ui.EV_WINDOW_FAILED {
        >> errors.new("failed to open editor window for headless check")
    }
    identity := ui.canvas_of(&ready) or >>
    context := draw.context_of(&ready) or >>
    _ := ui.native_set_opacity(0) or (err) {
        _ := err
        << 0
    }
    $view := create_editor_view(&context, &identity, 1240.0, 700.0) or >>
    $ed := create_editor(
        $&view,
        &context,
        &identity,
        project,
        cfg.output_dir + "",
        cfg.validator_bin + "",
        cfg.preview_bin + "",
        cfg.viewport_bin + "",
        1240.0,
        700.0
    ) or >>
    run_ui_self_checks($&view, $&ed, &context, &identity, cfg.output_dir + "") or >>
    node_cnt := ed.stage_pts.len
    ed.dispose($&view)
    eprintln("HEADLESS_CHECK_OK " + cfg.project_path + " (" + str(node_cnt) + " nodes)")
    << 0
}

fn capture_headless_check(events chan ui.Event, cfg LaunchConfig, project Project) string {
    _ := run_headless_snapshot_worker(events, cfg, project) or (err) {
        << err.msg()
    }
    << ""
}

fn worker_headless_check(events chan ui.Event, cfg LaunchConfig, project Project, res chan string) {
    msg := capture_headless_check(events, cfg, project)
    res <- msg + ""
    if msg.len > 0 {
        eprintln("HEADLESS_CHECK_FAIL: " + msg)
        <<< 1
    }
    _ := ui.append_shell_cmd("quit_app") or (err) {
        _ := err
        <<
    }
}

fn run_headless_check(cfg LaunchConfig, project Project) int {
    $app := ui.new_app() or >>
    $win := app.open_content_window(ui.WindowOpts{title: "Nexus Scene Editor Check", width: 1240, height: 700}, ui.CONTENT_DRAW) or >>
    draw.attach($&win) or >>
    res := chan string{cap: 1}
    xu worker_headless_check(app.event_ch, cfg, project, res)
    app.run() or >>
    err_msg := <- res
    if err_msg.len > 0 {
        >> errors.new(err_msg)
    }
    << 0
}

fn run() int {
    cfg := parse_args() or >>
    if cfg.show_help {
        print_usage()
        << 0
    }
    project := load_project(cfg.project_path + "") or >>
    if cfg.verify_headless {
        << run_headless_check(cfg, project) or >>
    }
    $app := ui.new_app() or >>
    $win := app.open_content_window(ui.WindowOpts{title: "Nexus Scene Editor — " + filepath.base(&project.directory), width: 1240, height: 700}, ui.CONTENT_DRAW) or >>
    draw.attach($&win) or >>
    xu worker_entry(app.event_ch, cfg, project, win)
    << app.run() or >>
}

fn main() int {
    << run() or (err) {
        eprintln(err.msg())
        << 1
    }
}
