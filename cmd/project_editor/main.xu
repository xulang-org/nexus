@main

controls #"github.com/xulang-org/nexus/input"
resource #"github.com/xulang-org/nexus/resources/scene"
files #"github.com/xulang-org/nexus/integration/scene"
#ui
#ui/draw
#ui/layout
widgets #ui/widgets
#encoding/json
#os
#os/exec
#path/filepath
#strconv
#strings
#time
#errors

struct LaunchConfig {
    pub project_path string
    pub output_dir string
    pub validator_bin string
    pub preview_bin string
    pub viewport_bin string
    pub tilemap_bin string
    pub script_path string
    pub verify_headless bool
    pub show_help bool
    pub xacp_port int
    pub preview_xacp_port int
}

const WORKER_VIEWPORT = 1
const WORKER_PREVIEW = 2
const WORKER_TILEMAP = 3
const WORKER_EXPORT = 4

struct WorkerDone {
    pub kind int
    pub ok bool
    pub message string
    pub temp_dir string
    pub output_scene string
    pub meta_path string
    pub revision string
}

fn print_usage() {
    println("usage: nexus-project-editor <project.json> [options]")
    println("  --output <dir>      output directory for editor snap settings & published previews")
    println("  --validator <bin>   scene/GLB validator binary (default build/nexus-project-validate)")
    println("  --preview <bin>     preview executable (default build/nexus-project-preview)")
    println("  --viewport <bin>    3D viewport executable (default build/nexus-project-viewport)")
    println("  --tilemap-editor <bin>  2D tilemap editor executable (default build/nexus-tilemap-editor)")
    println("  --script <ndjson>   execute deterministic UI automation script and exit")
    println("  --headless-check    verify project load, layout, and snapshot cleanly without opening a window")
    println("  --xacp-tcp          enable XACP TCP control on default port 19876")
    println("  --xacp-port <port>  enable XACP TCP control on loopback port (1..65535)")
    println("  --preview-xacp-port <port>  forward --xacp-port to launched Preview window")
}

fn parse_args() LaunchConfig {
    args := os.args()
    $cfg := LaunchConfig{
        project_path: "",
        output_dir: "build/editor-output",
        validator_bin: "build/nexus-project-validate",
        preview_bin: "build/nexus-project-preview",
        viewport_bin: "build/nexus-project-viewport",
        tilemap_bin: "build/nexus-tilemap-editor",
        script_path: "",
        verify_headless: false,
        show_help: false,
        xacp_port: 0,
        preview_xacp_port: 0
    }
    $i := 1
    while i < args.len {
        a := args[i] + ""
        if a == "-h" || a == "--help" {
            cfg.show_help = true
            << cfg
        } else if a == "--output" {
            i = i + 1
            if i >= args.len { >> errors.new("missing value for --output") }
            cfg.output_dir = args[i] + ""
        } else if a == "--validator" {
            i = i + 1
            if i >= args.len { >> errors.new("missing value for --validator") }
            cfg.validator_bin = args[i] + ""
        } else if a == "--preview" {
            i = i + 1
            if i >= args.len { >> errors.new("missing value for --preview") }
            cfg.preview_bin = args[i] + ""
        } else if a == "--viewport" {
            i = i + 1
            if i >= args.len { >> errors.new("missing value for --viewport") }
            cfg.viewport_bin = args[i] + ""
        } else if a == "--tilemap-editor" {
            i = i + 1
            if i >= args.len { >> errors.new("missing value for --tilemap-editor") }
            cfg.tilemap_bin = args[i] + ""
        } else if a == "--script" {
            i = i + 1
            if i >= args.len { >> errors.new("missing value for --script") }
            cfg.script_path = args[i] + ""
        } else if a == "--xacp-tcp" {
            cfg.xacp_port = 19876
        } else if a == "--xacp-port" {
            i = i + 1
            if i >= args.len { >> errors.new("missing value for --xacp-port") }
            p := strconv.atoi(&args[i]) >>>
            if p < 1 || p > 65535 { >> errors.new("invalid --xacp-port") }
            cfg.xacp_port = p
        } else if a == "--preview-xacp-port" {
            i = i + 1
            if i >= args.len { >> errors.new("missing value for --preview-xacp-port") }
            p := strconv.atoi(&args[i]) >>>
            if p < 1 || p > 65535 { >> errors.new("invalid --preview-xacp-port") }
            cfg.preview_xacp_port = p
        } else if a == "--headless-check" {
            cfg.verify_headless = true
        } else if strings.has_prefix(&a, "-") {
            >> errors.new("unknown option: " + a)
        } else if cfg.project_path.len == 0 {
            cfg.project_path = a
        } else {
            >> errors.new("unexpected argument: " + a)
        }
        i = i + 1
    }
    if cfg.project_path.len == 0 {
        >> errors.new("missing <project.json> path")
    }
    if cfg.xacp_port > 0 && cfg.preview_xacp_port == 0 && cfg.xacp_port < 65535 {
        cfg.preview_xacp_port = cfg.xacp_port + 1
    }
    << cfg
}

fn spawn_viewport_worker(
    ch chan WorkerDone,
    bin string,
    staged_scene string,
    out_scene string,
    meta_out string,
    select_node int,
    tmp_dir string,
    revision string,
    snap SnapSettings
) {
    mv := fmt_coord(snap.move_step)
    rt := fmt_coord(snap.rotate_deg)
    $scale_pct := snap.scale_pct
    if scale_pct < 0.01 { scale_pct = 0.01 }
    if scale_pct > 100.0 { scale_pct = 100.0 }
    sc := fmt_coord(scale_pct)
    out_arg := out_scene + ""
    meta_arg := meta_out + ""
    sel_arg := str(select_node)
    out := exec.command(
        bin,
        "--scene", staged_scene,
        "--output", out_arg,
        "--meta-out", meta_arg,
        "--select-node", sel_arg,
        "--snap-move", mv,
        "--snap-rotate", rt,
        "--snap-scale", sc
    ).combined_output() >>> (err) {
        ch <- WorkerDone{
            kind: WORKER_VIEWPORT,
            ok: false,
            message: err.msg(),
            temp_dir: tmp_dir + "",
            output_scene: out_scene + "",
            meta_path: meta_out + "",
            revision: revision + ""
        }
        <<
    }
    _ := out
    ch <- WorkerDone{
        kind: WORKER_VIEWPORT,
        ok: true,
        message: "3D viewport session finished",
        temp_dir: tmp_dir,
        output_scene: out_scene,
        meta_path: meta_out + "",
        revision: revision
    }
}

fn spawn_preview_worker(ch chan WorkerDone, bin string, pub_scene string, xacp_port int) {
    bin_path := bin + ""
    scene_arg := pub_scene + ""
    $cmd := exec.command(bin_path, "--scene", scene_arg)
    if xacp_port > 0 {
        cmd = exec.command(bin + "", "--scene", pub_scene + "", "--xacp-port", str(xacp_port))
    }
    out := cmd.combined_output() >>> (err) {
        ch <- WorkerDone{
            kind: WORKER_PREVIEW,
            ok: false,
            message: err.msg(),
            temp_dir: "",
            output_scene: "",
            meta_path: "",
            revision: ""
        }
        <<
    }
    _ := out
    ch <- WorkerDone{
        kind: WORKER_PREVIEW,
        ok: true,
        message: "Preview closed",
        temp_dir: "",
        output_scene: "",
        meta_path: "",
        revision: ""
    }
}

fn spawn_tilemap_worker(
    ch chan WorkerDone,
    bin string,
    staged_scene string,
    before_raw string,
    tmp_dir string,
    revision string
) {
    out := exec.command(bin, staged_scene + "").combined_output() >>> (err) {
        ch <- WorkerDone{
            kind: WORKER_TILEMAP,
            ok: false,
            message: err.msg(),
            temp_dir: tmp_dir + "",
            output_scene: "",
            meta_path: "",
            revision: revision + ""
        }
        <<
    }
    _ := out
    after_raw := try_read_text(staged_scene + "")
    $out_scene := ""
    if after_raw.len > 0 && after_raw != before_raw {
        out_scene = staged_scene + ""
    }
    ch <- WorkerDone{
        kind: WORKER_TILEMAP,
        ok: true,
        message: "TileMap Editor closed",
        temp_dir: tmp_dir,
        output_scene: out_scene,
        meta_path: "",
        revision: revision
    }
}

fn spawn_export_worker(
    ch chan WorkerDone,
    proj_path string,
    out_dir string,
    val_bin string,
    scene_key string,
    draft_doc resource.Document,
    has_draft bool
) {
    res := publish_project_with_draft(&proj_path, &out_dir, &val_bin, &scene_key, &draft_doc, has_draft) >>> (err) {
        ch <- WorkerDone{
            kind: WORKER_EXPORT,
            ok: false,
            message: err.msg(),
            temp_dir: "",
            output_scene: "",
            meta_path: "",
            revision: ""
        }
        <<
    }
    $gshort := res.generation + ""
    if gshort.len > 8 { gshort = gshort[0:8] + "" }
    msg := "Exported build " + gshort + " (rebuilt=" + str(res.rebuilt_assets) + ", reused=" + str(res.reused_assets) + ")"
    ch <- WorkerDone{
        kind: WORKER_EXPORT,
        ok: true,
        message: msg,
        temp_dir: res.root + "",
        output_scene: "",
        meta_path: "",
        revision: res.generation + ""
    }
}

struct WaitStep {
    kind int
    event ui.Event
    worker WorkerDone
    embed EmbedMsg
}

const WAIT_UI = 0
const WAIT_WORKER = 1
const WAIT_EMBED = 2

fn empty_worker_done() WorkerDone {
    << WorkerDone{kind: 0, ok: false, message: "", temp_dir: "", output_scene: "", meta_path: "", revision: ""}
}

fn next_event_or_worker(
    events chan ui.Event,
    workers chan WorkerDone,
    embeds chan EmbedMsg,
    use_embed bool,
    deadline time.Instant
) WaitStep {
    none_ev := ui.Event{kind: ui.EV_NONE, window_id: 0, menu_id: "", width: 0, height: 0}
    if !use_embed {
        if deadline.is_zero() {
            select {
                ev := <- events { << WaitStep{kind: WAIT_UI, event: ev, worker: empty_worker_done(), embed: empty_embed_msg()} }
                w := <- workers { << WaitStep{kind: WAIT_WORKER, event: none_ev, worker: w, embed: empty_embed_msg()} }
            }
        }
        delay := deadline.since(time.instant())
        if delay.nanoseconds() <= 0 {
            << WaitStep{kind: WAIT_UI, event: none_ev, worker: empty_worker_done(), embed: empty_embed_msg()}
        }
        timer := delay.timer()
        select {
            ev := <- events {
                timer.stop()
                << WaitStep{kind: WAIT_UI, event: ev, worker: empty_worker_done(), embed: empty_embed_msg()}
            }
            w := <- workers {
                timer.stop()
                << WaitStep{kind: WAIT_WORKER, event: none_ev, worker: w, embed: empty_embed_msg()}
            }
            _ := <- timer.c {
                timer.stop()
            }
        }
        << WaitStep{kind: WAIT_UI, event: none_ev, worker: empty_worker_done(), embed: empty_embed_msg()}
    }
    if deadline.is_zero() {
        select {
            ev := <- events { << WaitStep{kind: WAIT_UI, event: ev, worker: empty_worker_done(), embed: empty_embed_msg()} }
            w := <- workers { << WaitStep{kind: WAIT_WORKER, event: none_ev, worker: w, embed: empty_embed_msg()} }
            em := <- embeds { << WaitStep{kind: WAIT_EMBED, event: none_ev, worker: empty_worker_done(), embed: em} }
        }
    }
    delay := deadline.since(time.instant())
    if delay.nanoseconds() <= 0 {
        << WaitStep{kind: WAIT_UI, event: none_ev, worker: empty_worker_done(), embed: empty_embed_msg()}
    }
    timer := delay.timer()
    select {
        ev := <- events {
            timer.stop()
            << WaitStep{kind: WAIT_UI, event: ev, worker: empty_worker_done(), embed: empty_embed_msg()}
        }
        w := <- workers {
            timer.stop()
            << WaitStep{kind: WAIT_WORKER, event: none_ev, worker: w, embed: empty_embed_msg()}
        }
        em := <- embeds {
            timer.stop()
            << WaitStep{kind: WAIT_EMBED, event: none_ev, worker: empty_worker_done(), embed: em}
        }
        _ := <- timer.c {
            timer.stop()
        }
    }
    << WaitStep{kind: WAIT_UI, event: none_ev, worker: empty_worker_done(), embed: empty_embed_msg()}
}

fn wait_ready(events chan ui.Event) ui.Event {
    while true {
        ev := <- events
        if ev.kind == ui.EV_EXIT || ev.kind == ui.EV_CANVAS_READY || ev.kind == ui.EV_WINDOW_FAILED {
            << ev
        }
    }
    << ui.Event{kind: ui.EV_EXIT, window_id: 0, menu_id: "", width: 0, height: 0}
}

fn start_import_request(identity &ui.CanvasEvent, ed $&Editor, view $&widgets.View) ui.Request {
    $opts := ui.file_dialog_options()
    opts.title = "Import Project Asset"
    opts.multiple = false
    opts.filters = [ui.FileFilter{label: "Nexus Assets (.glb, .png, .wav, .xubc)", extensions: ["glb", "png", "wav", "xubc"]}]
    req := ui.open_files_async(identity, &opts) >>> (err) {
        ed.set_status(STATUS_ERR, err.msg(), view)
        << ui.Request{id: 0, window_id: 0, canvas_id: 0, generation: 0, kind: 0}
    }
    if req.id > 0 {
        ed.import_active = true
        ed.sync_toolbar_states()
        ed.set_status(STATUS_INFO, "Choose a .glb, .png, .wav, or .xubc file to import...", view)
    }
    << req
}

fn start_open_project_request(identity &ui.CanvasEvent, ed $&Editor, view $&widgets.View) ui.Request {
    $opts := ui.file_dialog_options()
    opts.title = "Open Nexus Project"
    opts.multiple = false
    opts.filters = [ui.FileFilter{label: "Nexus Project (project.json)", extensions: ["json"]}]
    req := ui.open_files_async(identity, &opts) >>> (err) {
        ed.set_status(STATUS_ERR, err.msg(), view)
        << ui.Request{id: 0, window_id: 0, canvas_id: 0, generation: 0, kind: 0}
    }
    if req.id > 0 {
        ed.open_proj_active = true
        ed.sync_toolbar_states()
        ed.set_status(STATUS_INFO, "Choose a project.json manifest to open...", view)
    }
    << req
}

fn start_relocate_request(identity &ui.CanvasEvent, ed $&Editor, view $&widgets.View) ui.Request {
    $opts := ui.file_dialog_options()
    opts.title = "Relocate Selected Asset"
    opts.multiple = false
    opts.filters = [ui.FileFilter{label: "Nexus Assets (.glb, .png, .wav, .xubc)", extensions: ["glb", "png", "wav", "xubc"]}]
    req := ui.open_files_async(identity, &opts) >>> (err) {
        ed.set_status(STATUS_ERR, err.msg(), view)
        << ui.Request{id: 0, window_id: 0, canvas_id: 0, generation: 0, kind: 0}
    }
    if req.id > 0 {
        ed.relocate_active = true
        ed.sync_toolbar_states()
        ed.set_status(STATUS_INFO, "Choose replacement asset file inside project...", view)
    }
    << req
}

fn try_remove_all(path string) {
    _ := os.remove_all(path + "") >>> (err) {
        _ := err
        <<
    }
}

fn try_content_cmd(w &ui.Window, cmd string) {
    _ := w.content_command(cmd + "") >>> (err) {
        _ := err
        <<
    }
}

fn try_native_setup(w &ui.Window) {
    try_content_cmd(w, "input_enabled\t1")
    try_content_cmd(w, "pan_enabled\t0")
    _ := ui.native_set_appearance("light") >>> (err) {
        _ := err
        <<
    }
    _ := ui.native_set_min_size(940, 560) >>> (err) {
        _ := err
        <<
    }
    _ := ui.native_set_close_guard(0) >>> (err) {
        _ := err
        <<
    }
}

fn try_close_guard(guard int) {
    _ := ui.native_set_close_guard(guard) >>> (err) {
        _ := err
        <<
    }
}

fn try_accept_and_close(w $&ui.Window) {
    try_close_guard(0)
    _ := ui.native_accept_close() >>> (err) {
        _ := err
        <<
    }
    _ := w.request_close() >>> (err) {
        _ := err
        <<
    }
}

fn launch_viewport_session(workers chan WorkerDone, ed $&Editor, view $&widgets.View) int {
    tmp_dir := os.mkdir_temp("", "nexus-editor-vp-") >>>
    doc := ed.draft.document() >>> (err) {
        try_remove_all(tmp_dir + "")
        >> err
    }
    staged := stage_scene(&ed.project, &doc, &ed.draft.source, &tmp_dir) >>> (err) {
        try_remove_all(tmp_dir + "")
        >> err
    }
    out_scene := filepath.join([tmp_dir + "", "viewport-output.xuscene"])
    meta_out := filepath.join([tmp_dir + "", "viewport-meta.json"])
    rev := ed.draft.current + ""
    sel_node := ed.selected_node
    ed.viewport_active = true
    ed.sync_toolbar_states()
    ed.set_status(STATUS_INFO, "3D View open...", view)
    ed.repaint_all(view)
    xu spawn_viewport_worker(workers, ed.viewport_bin + "", staged, out_scene, meta_out, sel_node, tmp_dir, rev, ed.snap)
    << 0
}

fn launch_preview_session(workers chan WorkerDone, ed $&Editor, view $&widgets.View, preview_xacp_port int) int {
    doc := ed.draft.document() >>>
    scene_key := ed.project.scenes[ed.scene_index].key + ""
    pub_scene := publish_for_preview(&ed.project.path, &ed.output_dir, &ed.validator_bin, &scene_key, &doc) >>>
    ed.preview_active = true
    ed.sync_toolbar_states()
    ed.set_status(STATUS_INFO, "Preview running (" + scene_key + ")...", view)
    ed.repaint_all(view)
    xu spawn_preview_worker(workers, ed.preview_bin + "", pub_scene, preview_xacp_port)
    << 0
}

fn launch_tilemap_session(workers chan WorkerDone, ed $&Editor, view $&widgets.View) int {
    tmp_dir := os.mkdir_temp("", "nexus-editor-tm-") >>>
    doc := ed.draft.document() >>> (err) {
        try_remove_all(tmp_dir + "")
        >> err
    }
    staged := stage_scene(&ed.project, &doc, &ed.draft.source, &tmp_dir) >>> (err) {
        try_remove_all(tmp_dir + "")
        >> err
    }
    before_raw := try_read_text(staged + "")
    rev := ed.draft.current + ""
    ed.tilemap_active = true
    ed.sync_toolbar_states()
    ed.set_status(STATUS_INFO, "TileMap Editor open...", view)
    ed.repaint_all(view)
    xu spawn_tilemap_worker(workers, ed.tilemap_bin + "", staged, before_raw, tmp_dir, rev)
    << 0
}

fn draft_merge_tilemaps(ed $&Editor, edited &resource.Document, revision &string) int {
    d := $&ed.draft
    << d.merge_tilemaps(edited, revision) >>>
}

fn finish_tilemap_session(wmsg &WorkerDone, ed $&Editor, view $&widgets.View) int {
    captured := files.load(wmsg.output_scene + "") >>>
    draft_merge_tilemaps(ed, &captured, &wmsg.revision) >>>
    ed.refresh_after_document_change(false, view)
    ed.set_status(STATUS_OK, "Applied TileMap Editor edits", view)
    << 0
}

fn draft_merge_viewport(ed $&Editor, captured &resource.Document, revision &string) int {
    d := $&ed.draft
    << d.merge_viewport(captured, revision) >>>
}

fn draft_delete_nodes(ed $&Editor, del_nodes &[]int) int {
    d := $&ed.draft
    << d.delete_nodes(del_nodes) >>>
}

fn try_read_text(path string) string {
    << os.read(path + "") >>> (err) {
        _ := err
        << ""
    }
}

fn try_json_int(jdoc &json.Doc, handle int) int {
    << jdoc.as_int(handle) >>> (err) {
        _ := err
        << -1
    }
}

fn finish_viewport_session(wmsg &WorkerDone, ed $&Editor, view $&widgets.View) int {
    captured := files.load(wmsg.output_scene + "") >>>
    draft_merge_viewport(ed, &captured, &wmsg.revision) >>>
    $del_count := 0
    if wmsg.meta_path.len > 0 && path_exists(wmsg.meta_path + "") {
        raw := try_read_text(wmsg.meta_path + "")
        if raw.len > 0 {
            jdoc := json.parse_max(&raw, 1048576)
            if jdoc.ok() {
                root := jdoc.root()
                $del_nodes := []int{}
                if jdoc.has(root, "deleted_nodes") {
                    arr := jdoc.get(root, "deleted_nodes")
                    if arr >= 0 && jdoc.is_list(arr) {
                        for i in 0:jdoc.count(arr) {
                            v := try_json_int(&jdoc, jdoc.at(arr, i))
                            if v > 0 { del_nodes.push(v) }
                        }
                    }
                }
                if del_nodes.len > 0 {
                    del_count = del_nodes.len
                    next_sel := draft_delete_nodes(ed, &del_nodes) >>>
                    ed.set_single_selection(next_sel)
                } else if jdoc.has(root, "selected_node") {
                    sel_idx := try_json_int(&jdoc, jdoc.get(root, "selected_node"))
                    doc_now := ed.draft.document() >>>
                    if sel_idx >= 0 && sel_idx < doc_now.node_count() {
                        ed.set_single_selection(sel_idx)
                    }
                }
            }
        }
    }
    ed.refresh_after_document_change(false, view)
    if del_count > 0 {
        ed.set_status(STATUS_OK, "Applied 3D Viewport edits (" + str(del_count) + " deleted)", view)
    } else {
        ed.set_status(STATUS_OK, "Applied 3D Viewport edits", view)
    }
    << 0
}

fn launch_export_session(workers chan WorkerDone, ed $&Editor, view $&widgets.View) int {
    doc := ed.draft.document() >>>
    $out_dir := ed.export_target_dir + ""
    if out_dir.len == 0 { out_dir = ed.output_dir + "" }
    scene_key := ed.project.scenes[ed.scene_index].key + ""
    proj_path := ed.project.path + ""
    val_bin := ed.validator_bin + ""
    ed.export_active = true
    ed.sync_toolbar_states()
    ed.set_status(STATUS_INFO, "Exporting project to " + out_dir + "...", view)
    ed.repaint_all(view)
    xu spawn_export_worker(workers, proj_path, out_dir, val_bin, scene_key, doc, true)
    << 0
}

fn try_launch_export(workers chan WorkerDone, ed $&Editor, view $&widgets.View) {
    _ := launch_export_session(workers, ed, view) >>> (err) {
        ed.set_status(STATUS_ERR, err.msg(), view)
        <<
    }
}

fn finish_asset_import(asset_path &string, ed $&Editor, view $&widgets.View) int {
    imp := import_external_asset(&ed.project.path, asset_path, &ed.validator_bin) >>>
    reloaded := load_project(ed.project.path + "") >>>
    ed.project = reloaded
    ed.panels.glb_prim_cache = map[string]string{}
    ed.refresh_project_selectors()
    for k in 0:ed.project.assets.len {
        if ed.project.assets[k].key == imp.uid {
            ed.select_asset_index(k)
        }
    }
    ed.set_left_tab(1, view)
    ed.sync_asset_meta_text()
    ed.sync_toolbar_states()
    ed.set_status(STATUS_OK, "Imported " + imp.rel_path, view)
    repaint(view, ed.id_left_pane)
    << 0
}

fn finish_open_project(proj_path &string, ed $&Editor, view $&widgets.View) int {
    ed.open_project_file(proj_path, view) >>>
    ed.repaint_all(view)
    << 0
}

fn finish_relocate_asset(new_path &string, ed $&Editor, view $&widgets.View) int {
    uid := ed.relocate_uid + ""
    if uid.len == 0 { >> errors.new("no asset selected to relocate") }
    relocate_asset(&ed.project.path, &uid, new_path) >>>
    reloaded := load_project(ed.project.path + "") >>>
    ed.project = reloaded
    ed.panels.glb_prim_cache = map[string]string{}
    ed.refresh_project_selectors()
    for k in 0:ed.project.assets.len {
        if ed.project.assets[k].key == uid {
            ed.select_asset_index(k)
        }
    }
    ed.sync_asset_meta_text()
    ed.sync_toolbar_states()
    ed.set_status(STATUS_OK, "Relocated asset " + uid[0:8], view)
    repaint(view, ed.id_left_pane)
    << 0
}

