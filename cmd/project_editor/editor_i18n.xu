@main

snapshot #"github.com/xulang-org/nexus/internal/file_snapshot"
#encoding/json
#path/filepath
#strings
#os

pub const LANG_EN = 0
pub const LANG_ZH = 1

pub fn tr(lang int, en string, zh string) string {
    if lang == LANG_ZH {
        << zh + ""
    }
    << en + ""
}

pub fn lang_toggle_label(lang int) string {
    if lang == LANG_ZH {
        << "EN"
    }
    << "中文"
}

pub fn byte_counter_text_lang(s &string, max_bytes int, lang int) string {
    if lang == LANG_ZH {
        << str(s.len) + " / " + str(max_bytes) + " 字节"
    }
    << str(s.len) + " / " + str(max_bytes) + " bytes"
}

pub fn approx_label_width(s &string, ascii_w f64) f64 {
    $w := 0.0
    for i in 0:s.len {
        b := s[i] & 255
        if b < 128 {
            w = w + ascii_w
        } else if b >= 192 {
            w = w + ascii_w * 1.75
        }
    }
    << w
}

pub fn editor_prefs_path(output_dir &string) string {
    << filepath.join([output_dir + "", "editor-prefs.json"])
}

fn try_read_prefs_file(path string) string {
    << os.read(path + "") or (err) {
        _ := err
        << ""
    }
}

fn read_lang_str(doc &json.Doc, node int) string {
    << doc.as_string(node) or (err) {
        _ := err
        << "en"
    }
}

pub fn load_editor_lang(output_dir &string) int {
    if output_dir.len == 0 {
        << LANG_EN
    }
    path := editor_prefs_path(output_dir)
    raw := try_read_prefs_file(path + "")
    if raw.len == 0 {
        << LANG_EN
    }
    doc := json.parse_max(&raw, 16384)
    if !doc.ok() || !doc.is_dict(doc.root()) {
        << LANG_EN
    }
    root := doc.root()
    if !doc.has(root, "lang") {
        << LANG_EN
    }
    node := doc.get(root, "lang")
    if !doc.is_string(node) {
        << LANG_EN
    }
    val := read_lang_str(&doc, node)
    if strings.to_lower(&val) == "zh" {
        << LANG_ZH
    }
    << LANG_EN
}

pub fn save_editor_lang(output_dir &string, lang int) int {
    if output_dir.len == 0 {
        << 0
    }
    os.mkdir_all(output_dir + "") or >>
    $code := "en"
    if lang == LANG_ZH {
        code = "zh"
    }
    raw := "{\n  \"format\": \"nexus.editor_prefs\",\n  \"version\": 1,\n  \"lang\": \"" + code + "\"\n}\n"
    path := editor_prefs_path(output_dir)
    snapshot.write_atomic(path, &raw) or >>
    << 0
}
