pub fn prefab_uid_for_scene_key(key &string) string {
    digest := sha256.sum256("nexus:scene_prefab:" + *key)
    << digest[0:32] + ""
}

fn scene_ref_for_prefab(project &Project, scene_path &string, scene_key_or_uid &string) resource.ResourceReference {
    $resolved := ""
    $uid := ""
    for i in 0:project.scenes.len {
        s := &project.scenes[i]
        suid := prefab_uid_for_scene_key(&s.key)
        if s.key == *scene_key_or_uid || suid == *scene_key_or_uid {
            resolved = s.resolved + ""
            uid = suid
            <-
        }
    }
    if resolved.len == 0 {
        << asset_ref_for_uid(project, scene_path, scene_key_or_uid, "scene_file") or >>
    }
    raw := snapshot.read(resolved + "", snapshot.MAX_BYTES) or >>
    hash := sha256.sum256(raw + "")
    scene_dir := filepath.dir(scene_path)
    $rel := try_rel_path(&scene_dir, &resolved)
    if rel.len == 0 || rel == "." || rel == ".." || strings.has_prefix(&rel, "../") {
        proj_rel := try_rel_path(&project.directory, &resolved)
        if proj_rel.len == 0 || proj_rel == "." || proj_rel == ".." || strings.has_prefix(&proj_rel, "../") {
            >> errors.new("nexus editor: prefab scene '" + resolved + "' must reside inside project directory")
        }
        rel = proj_rel
    }
    << resource.ResourceReference{
        uid: uid,
        kind: "scene_file",
        path: rel,
        content_hash: hash
    }
}

pub fn (draft $&Draft) set_node_prefab_instance(
    project &Project,
    idx int,
    scene_uid string,
    override_target string,
    override_visible bool
) int {
    doc := draft.document() or >>
    $snap := unpack_doc(&doc) or >>
    require_node_idx(&snap, idx) or >>
    ref := scene_ref_for_prefab(project, &draft.source, &scene_uid) or >>
    ref_uid := ref.uid + ""
    upsert_ref($&snap.refs, ref)
    $ovs := []resource.PrefabOverride{}
    trimmed := strings.trim_space(&override_target)
    if trimmed.len > 0 {
        ovs.push(resource.PrefabOverride{
            target_path: trimmed,
            visible_set: true,
            visible: override_visible,
            position_set: false,
            position: fm.vec3(0.0, 0.0, 0.0)
        })
    }
    pf := resource.prefab_instance_attachment(idx, ref_uid, ovs)
    pf.validate() or >>
    $next_pf := []resource.PrefabInstanceAttachment{}
    for i in 0:snap.prefab_instances.len {
        if snap.prefab_instances[i].node != idx {
            next_pf.push(clone_prefab_instance(&snap.prefab_instances[i], snap.prefab_instances[i].node))
        }
    }
    next_pf.push(pf)
    snap.prefab_instances = next_pf
    commit_snapshot(draft, $&snap) or >>
    << 0
}

pub fn (draft $&Draft) clear_node_prefab_instance(idx int) int {
    doc := draft.document() or >>
    $snap := unpack_doc(&doc) or >>
    require_node_idx(&snap, idx) or >>
    $next_pf := []resource.PrefabInstanceAttachment{}
    for i in 0:snap.prefab_instances.len {
        if snap.prefab_instances[i].node != idx {
            next_pf.push(clone_prefab_instance(&snap.prefab_instances[i], snap.prefab_instances[i].node))
        }
    }
    snap.prefab_instances = next_pf
    commit_snapshot(draft, $&snap) or >>
    << 0
}
