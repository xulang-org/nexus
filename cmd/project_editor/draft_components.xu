@main

resource #"github.com/xulang-org/nexus/resources/scene"
camera_data #"github.com/xulang-org/nexus/resources/camera"
light_data #"github.com/xulang-org/nexus/resources/lighting"
shadow_data #"github.com/xulang-org/nexus/resources/shadow"
sprite3d #"github.com/xulang-org/nexus/resources/sprite3d"
tilemap #"github.com/xulang-org/nexus/resources/tilemap"
fm #"github.com/xulang-org/nexus/foundation/math"
snapshot #"github.com/xulang-org/nexus/internal/file_snapshot"
#crypto/sha256
#path/filepath
#strconv
#strings
#math
#errors

pub fn asset_ref_for_uid(
    project &Project,
    scene_path &string,
    uid &string,
    kind string
) resource.ResourceReference {
    resolved := project.asset_source(uid) >>>
    raw := snapshot.read(resolved + "", snapshot.MAX_BYTES) >>>
    hash := sha256.sum256(raw + "")
    scene_dir := filepath.dir(scene_path)
    $rel := try_rel_path(&scene_dir, &resolved)
    if rel.len == 0 || rel == "." || rel == ".." || strings.has_prefix(&rel, "../") {
        proj_rel := try_rel_path(&project.directory, &resolved)
        if proj_rel.len == 0 || proj_rel == "." || proj_rel == ".." || strings.has_prefix(&proj_rel, "../") {
            >>> errors.new("nexus editor: asset '" + resolved + "' must reside inside project directory '" + project.directory + "'")
        }
        rel = proj_rel
    }
    << resource.ResourceReference{
        uid: *uid + "",
        kind: kind,
        path: rel,
        content_hash: hash
    }
}

fn upsert_ref(refs $&[]resource.ResourceReference, item resource.ResourceReference) {
    for i in 0:refs.len {
        if refs[i].uid == item.uid {
            refs[i] = resource.ResourceReference{
                uid: item.uid + "",
                kind: item.kind + "",
                path: item.path + "",
                content_hash: item.content_hash + ""
            }
            <<
        }
    }
    refs.push(item)
}

struct DocSnapshot {
    nodes []resource.NodeData
    refs []resource.ResourceReference
    surfaces []resource.Surface
    buses []resource.AudioBus
    emitters []resource.AudioEmitter
    scripts []resource.ScriptAttachment
    conns []resource.ScriptConnection
    lights []resource.LightAttachment
    sprites []resource.Sprite3DAttachment
    tilemaps []resource.TileMap2DAttachment
}

fn unpack_doc(doc &resource.Document) DocSnapshot {
    nodes := document_nodes_and_refs(doc) >>>
    refs := document_refs(doc) >>>
    $surfaces := []resource.Surface{}
    for i in 0:doc.surface_count() { surfaces.push(doc.surface(i) >>>) }
    $buses := []resource.AudioBus{}
    for i in 0:doc.audio_bus_count() { buses.push(doc.audio_bus(i) >>>) }
    $emitters := []resource.AudioEmitter{}
    for i in 0:doc.audio_count() { emitters.push(doc.audio_emitter(i) >>>) }
    $scripts := []resource.ScriptAttachment{}
    for i in 0:doc.script_count() { scripts.push(doc.script(i) >>>) }
    $conns := []resource.ScriptConnection{}
    for i in 0:doc.script_connection_count() { conns.push(doc.script_connection(i) >>>) }
    $lights := []resource.LightAttachment{}
    for i in 0:doc.light_count() { lights.push(doc.light(i) >>>) }
    $sprites := []resource.Sprite3DAttachment{}
    for i in 0:doc.sprite_3d_count() { sprites.push(doc.sprite_3d(i) >>>) }
    $tilemaps := []resource.TileMap2DAttachment{}
    for i in 0:doc.tilemap_2d_count() { tilemaps.push(doc.tilemap_2d(i) >>>) }
    << DocSnapshot{
        nodes: nodes,
        refs: refs,
        surfaces: surfaces,
        buses: buses,
        emitters: emitters,
        scripts: scripts,
        conns: conns,
        lights: lights,
        sprites: sprites,
        tilemaps: tilemaps
    }
}

fn commit_snapshot(draft $&Draft, snap $&DocSnapshot) int {
    $nodes := []resource.NodeData{}
    for i in 0:snap.nodes.len {
        n := &snap.nodes[i]
        nodes.push(clone_node(n, n.parent, n.name + ""))
    }
    $refs := []resource.ResourceReference{}
    for i in 0:snap.refs.len {
        r := &snap.refs[i]
        refs.push(resource.ResourceReference{uid: r.uid + "", kind: r.kind + "", path: r.path + "", content_hash: r.content_hash + ""})
    }
    $surfaces := []resource.Surface{}
    for i in 0:snap.surfaces.len {
        s := &snap.surfaces[i]
        surfaces.push(clone_surface(s, s.node))
    }
    $buses := []resource.AudioBus{}
    for i in 0:snap.buses.len {
        b := &snap.buses[i]
        buses.push(resource.AudioBus{parent: b.parent, name: b.name + "", volume: b.volume, muted: b.muted, paused: b.paused})
    }
    $emitters := []resource.AudioEmitter{}
    for i in 0:snap.emitters.len {
        e := &snap.emitters[i]
        emitters.push(clone_emitter(e, e.node, e.listener, e.spatial + ""))
    }
    $scripts := []resource.ScriptAttachment{}
    for i in 0:snap.scripts.len {
        sc := &snap.scripts[i]
        scripts.push(clone_script(sc, sc.node))
    }
    $conns := []resource.ScriptConnection{}
    for i in 0:snap.conns.len { conns.push(snap.conns[i]) }
    $lights := []resource.LightAttachment{}
    for i in 0:snap.lights.len {
        lt := &snap.lights[i]
        lights.push(clone_light(lt, lt.node))
    }
    $sprites := []resource.Sprite3DAttachment{}
    for i in 0:snap.sprites.len {
        sp := &snap.sprites[i]
        sprites.push(clone_sprite_3d(sp, sp.node))
    }
    $tilemaps := []resource.TileMap2DAttachment{}
    for i in 0:snap.tilemaps.len {
        tm := &snap.tilemaps[i]
        tilemaps.push(clone_tilemap_2d(tm, tm.node) >>>)
    }
    next := collect_refs_and_build(nodes, &refs, surfaces, buses, emitters, scripts, conns, lights, sprites, tilemaps) >>>
    draft.replace(&next) >>>
    << 0
}

fn require_node_idx(snap &DocSnapshot, idx int) int {
    if idx < 0 || idx >= snap.nodes.len {
        >>> errors.new("nexus editor: node index out of range")
    }
    << 0
}

pub fn (draft $&Draft) set_node_camera_perspective(idx int, fov_deg f64, near f64, far f64) int {
    doc := draft.document() >>>
    $snap := unpack_doc(&doc) >>>
    require_node_idx(&snap, idx) >>>
    if snap.nodes[idx].kind != resource.NODE_3D {
        >>> errors.new("nexus editor: 3D perspective camera requires a Node3D")
    }
    rad := fov_deg * pi_val() / 180.0
    lens := camera_data.perspective(rad, near, far) >>>
    snap.nodes[idx].camera = lens
    snap.nodes[idx].orthographic = camera_data.Orthographic{}
    commit_snapshot(draft, $&snap) >>>
    << 0
}

pub fn (draft $&Draft) set_node_camera_orthographic(idx int, v_size f64, near f64, far f64) int {
    doc := draft.document() >>>
    $snap := unpack_doc(&doc) >>>
    require_node_idx(&snap, idx) >>>
    if snap.nodes[idx].kind != resource.NODE_3D {
        >>> errors.new("nexus editor: 3D orthographic camera requires a Node3D")
    }
    lens := camera_data.orthographic(v_size, near, far) >>>
    snap.nodes[idx].orthographic = lens
    snap.nodes[idx].camera = camera_data.Perspective{}
    commit_snapshot(draft, $&snap) >>>
    << 0
}

pub fn (draft $&Draft) set_node_camera_2d(idx int, width f64, height f64, zoom f64) int {
    doc := draft.document() >>>
    $snap := unpack_doc(&doc) >>>
    require_node_idx(&snap, idx) >>>
    if snap.nodes[idx].kind != resource.NODE_2D {
        >>> errors.new("nexus editor: 2D camera requires a Node2D")
    }
    view := camera_data.view_2d(width, height, zoom) >>>
    snap.nodes[idx].camera_2d = view
    commit_snapshot(draft, $&snap) >>>
    << 0
}

pub fn (draft $&Draft) clear_node_camera(idx int) int {
    doc := draft.document() >>>
    $snap := unpack_doc(&doc) >>>
    require_node_idx(&snap, idx) >>>
    snap.nodes[idx].camera = camera_data.Perspective{}
    snap.nodes[idx].orthographic = camera_data.Orthographic{}
    snap.nodes[idx].camera_2d = camera_data.View2D{}
    commit_snapshot(draft, $&snap) >>>
    << 0
}

fn clamp_shadow_res(res int) int {
    if res <= 128 { << 128 }
    if res <= 256 { << 256 }
    if res <= 512 { << 512 }
    << 1024
}

pub fn (draft $&Draft) set_node_light(
    idx int,
    kind int,
    r f64,
    g f64,
    b f64,
    radius f64,
    inner_deg f64,
    outer_deg f64,
    dir_x f64,
    dir_y f64,
    dir_z f64,
    shadow_on bool,
    shadow_res int,
    shadow_dist f64,
    shadow_cascades int
) int {
    doc := draft.document() >>>
    $snap := unpack_doc(&doc) >>>
    require_node_idx(&snap, idx) >>>
    if snap.nodes[idx].kind != resource.NODE_3D {
        >>> errors.new("nexus editor: light attachment requires a Node3D")
    }
    rad_v := fm.vec3(r, g, b)
    $src := light_data.point(fm.vec3(0.0, 0.0, 0.0), rad_v, 10.0) >>>
    if kind == light_data.DIRECTIONAL {
        src = light_data.directional(fm.vec3(dir_x, dir_y, dir_z), rad_v) >>>
    } else if kind == light_data.POINT {
        src = light_data.point(fm.vec3(0.0, 0.0, 0.0), rad_v, radius) >>>
    } else if kind == light_data.SPOT {
        deg2rad := pi_val() / 180.0
        src = light_data.spot(
            fm.vec3(0.0, 0.0, 0.0),
            fm.vec3(dir_x, dir_y, dir_z),
            rad_v,
            radius,
            inner_deg * deg2rad,
            outer_deg * deg2rad
        ) >>>
    } else {
        >>> errors.new("nexus editor: unsupported light kind")
    }
    $cas := shadow_data.CascadeProfile3D{}
    $punc := shadow_data.PunctualProfile3D{}
    if shadow_on {
        res := clamp_shadow_res(shadow_res)
        if kind == light_data.DIRECTIONAL {
            $cnt := shadow_cascades
            if cnt < 2 { cnt = 2 }
            if cnt > 4 { cnt = 4 }
            $dist := shadow_dist
            if !fm.finite(dist) || dist <= 0.0 { dist = 100.0 }
            $settings := shadow_data.default_cascades()
            settings.count = cnt
            settings.resolution = res
            settings.distance = dist
            cas = shadow_data.cascade_profile(settings) >>>
        } else {
            punc = shadow_data.punctual_profile(
                src,
                shadow_data.PunctualSettings3D{near: 0.1, resolution: res, constant_bias: 0.0005, slope_bias: 0.002}
            ) >>>
        }
    }
    att := resource.LightAttachment{node: idx, source: src, cascades: cas, punctual: punc}
    $next_lights := []resource.LightAttachment{}
    for i in 0:snap.lights.len {
        if snap.lights[i].node != idx {
            next_lights.push(snap.lights[i])
        }
    }
    next_lights.push(att)
    snap.lights = next_lights
    commit_snapshot(draft, $&snap) >>>
    << 0
}

pub fn (draft $&Draft) clear_node_light(idx int) int {
    doc := draft.document() >>>
    $snap := unpack_doc(&doc) >>>
    require_node_idx(&snap, idx) >>>
    $next_lights := []resource.LightAttachment{}
    for i in 0:snap.lights.len {
        if snap.lights[i].node != idx {
            next_lights.push(snap.lights[i])
        }
    }
    snap.lights = next_lights
    commit_snapshot(draft, $&snap) >>>
    << 0
}

pub fn parse_script_initials(raw &string) []resource.ScriptInitial {
    trimmed := strings.trim_space(raw)
    if trimmed.len == 0 { << []resource.ScriptInitial{} }
    parts := strings.split(&trimmed, ",")
    $out := []resource.ScriptInitial{}
    for raw_part in parts {
        part := strings.trim_space(&raw_part)
        if part.len == 0 { -> }
        eq := strings.index_byte(&part, 61)
        if eq <= 0 || eq + 1 >= part.len {
            >>> errors.new("nexus editor: script initial entry must be id=value: '" + part + "'")
        }
        id_s := strings.trim_space(&part[0:eq])
        val_s := strings.trim_space(&part[eq + 1:part.len])
        id_val := strconv.atoi(&id_s) >>> (err) {
            >>> errors.new("nexus editor: invalid script field id '" + id_s + "'")
        }
        f_val := parse_f64_or(&val_s, "Script initial value") >>>
        out.push(resource.ScriptInitial{id: id_val, value: f_val})
    }
    << out
}

pub fn format_script_initials(inits &[]resource.ScriptInitial) string {
    $parts := []string{}
    for i in 0:inits.len {
        parts.push(str(inits[i].id) + "=" + fmt_coord(inits[i].value))
    }
    << strings.join(parts, ", ")
}

pub fn (draft $&Draft) set_node_script(
    project &Project,
    idx int,
    uid string,
    initials []resource.ScriptInitial
) int {
    doc := draft.document() >>>
    $snap := unpack_doc(&doc) >>>
    require_node_idx(&snap, idx) >>>
    ref := asset_ref_for_uid(project, &draft.source, &uid, "xu_bytecode") >>>
    upsert_ref($&snap.refs, ref)
    $clean_init := []resource.ScriptInitial{}
    for i in 0:initials.len { clean_init.push(initials[i]) }
    $next_scripts := []resource.ScriptAttachment{}
    for i in 0:snap.scripts.len {
        if snap.scripts[i].node != idx {
            next_scripts.push(clone_script(&snap.scripts[i], snap.scripts[i].node))
        }
    }
    next_scripts.push(resource.ScriptAttachment{node: idx, resource_uid: uid + "", initial: clean_init})
    snap.scripts = next_scripts
    commit_snapshot(draft, $&snap) >>>
    << 0
}

pub fn (draft $&Draft) clear_node_script(idx int) int {
    doc := draft.document() >>>
    $snap := unpack_doc(&doc) >>>
    require_node_idx(&snap, idx) >>>
    $next_scripts := []resource.ScriptAttachment{}
    for i in 0:snap.scripts.len {
        if snap.scripts[i].node != idx {
            next_scripts.push(clone_script(&snap.scripts[i], snap.scripts[i].node))
        }
    }
    $next_conns := []resource.ScriptConnection{}
    for i in 0:snap.conns.len {
        c := snap.conns[i]
        if c.source != idx && c.target != idx {
            next_conns.push(c)
        }
    }
    snap.scripts = next_scripts
    snap.conns = next_conns
    commit_snapshot(draft, $&snap) >>>
    << 0
}

pub fn (draft $&Draft) add_script_connection(source int, signal int, target int, handler int) int {
    doc := draft.document() >>>
    $snap := unpack_doc(&doc) >>>
    snap.conns.push(resource.ScriptConnection{source: source, signal: signal, target: target, handler: handler})
    commit_snapshot(draft, $&snap) >>>
    << 0
}

pub fn (draft $&Draft) remove_script_connection(conn_idx int) int {
    doc := draft.document() >>>
    $snap := unpack_doc(&doc) >>>
    if conn_idx < 0 || conn_idx >= snap.conns.len {
        >>> errors.new("nexus editor: script connection index out of range")
    }
    $next_conns := []resource.ScriptConnection{}
    for i in 0:snap.conns.len {
        if i != conn_idx { next_conns.push(snap.conns[i]) }
    }
    snap.conns = next_conns
    commit_snapshot(draft, $&snap) >>>
    << 0
}

pub fn (draft $&Draft) set_node_audio_emitter(
    project &Project,
    idx int,
    uid string,
    bus int,
    volume f64,
    pan f64,
    looping bool,
    autoplay bool,
    spatial string,
    listener int,
    max_distance f64
) int {
    doc := draft.document() >>>
    $snap := unpack_doc(&doc) >>>
    require_node_idx(&snap, idx) >>>
    ref := asset_ref_for_uid(project, &draft.source, &uid, "wav_clip") >>>
    upsert_ref($&snap.refs, ref)

    if snap.buses.len == 0 {
        snap.buses.push(resource.AudioBus{parent: -1, name: "Master", volume: 1.0, muted: false, paused: false})
    }
    $use_bus := bus
    if use_bus < 0 || use_bus >= snap.buses.len { use_bus = 0 }
    $use_pan := pan
    $use_listener := listener
    $use_dist := max_distance
    if spatial == "none" {
        use_listener = -1
        use_dist = 0.0
    } else {
        use_pan = 0.0
    }
    em := resource.AudioEmitter{
        node: idx,
        resource_uid: uid + "",
        bus: use_bus,
        volume: volume,
        pan: use_pan,
        looping: looping,
        autoplay: autoplay,
        spatial: spatial + "",
        listener: use_listener,
        max_distance: use_dist
    }
    $next_emitters := []resource.AudioEmitter{}
    for i in 0:snap.emitters.len {
        e := &snap.emitters[i]
        if e.node != idx {
            next_emitters.push(clone_emitter(e, e.node, e.listener, e.spatial + ""))
        }
    }
    next_emitters.push(em)
    snap.emitters = next_emitters
    commit_snapshot(draft, $&snap) >>>
    << 0
}

pub fn (draft $&Draft) clear_node_audio_emitter(idx int) int {
    doc := draft.document() >>>
    $snap := unpack_doc(&doc) >>>
    require_node_idx(&snap, idx) >>>
    $next_emitters := []resource.AudioEmitter{}
    for i in 0:snap.emitters.len {
        e := &snap.emitters[i]
        if e.node != idx {
            next_emitters.push(clone_emitter(e, e.node, e.listener, e.spatial + ""))
        }
    }
    snap.emitters = next_emitters
    if snap.emitters.len == 0 {
        snap.buses = []resource.AudioBus{}
    }
    commit_snapshot(draft, $&snap) >>>
    << 0
}

pub fn (draft $&Draft) add_audio_bus(parent int, raw_name string, volume f64, muted bool, paused bool) int {
    doc := draft.document() >>>
    if doc.audio_count() == 0 {
        >>> errors.new("nexus editor: add at least one AudioEmitter before adding sub-buses")
    }
    name := strings.trim_space(&raw_name)
    $snap := unpack_doc(&doc) >>>
    snap.buses.push(resource.AudioBus{parent: parent, name: name, volume: volume, muted: muted, paused: paused})
    commit_snapshot(draft, $&snap) >>>
    << 0
}

pub fn (draft $&Draft) toggle_audio_bus_mute(bus_idx int) int {
    doc := draft.document() >>>
    $snap := unpack_doc(&doc) >>>
    if bus_idx < 0 || bus_idx >= snap.buses.len {
        >>> errors.new("nexus editor: audio bus index out of range")
    }
    b := $&snap.buses[bus_idx]
    b.muted = !b.muted
    commit_snapshot(draft, $&snap) >>>
    << 0
}

pub fn (draft $&Draft) remove_audio_bus(bus_idx int) int {
    doc := draft.document() >>>
    $snap := unpack_doc(&doc) >>>
    if bus_idx <= 0 || bus_idx >= snap.buses.len {
        >>> errors.new("nexus editor: cannot remove Master bus or out-of-range bus")
    }
    for i in 0:snap.buses.len {
        if i != bus_idx && snap.buses[i].parent == bus_idx {
            >>> errors.new("nexus editor: audio bus has child buses")
        }
    }
    for i in 0:snap.emitters.len {
        if snap.emitters[i].bus == bus_idx {
            >>> errors.new("nexus editor: audio bus is still used by an emitter")
        }
    }
    $next_buses := []resource.AudioBus{}
    for i in 0:snap.buses.len {
        if i == bus_idx { -> }
        b := &snap.buses[i]
        $np := b.parent
        if np > bus_idx { np = np - 1 }
        next_buses.push(resource.AudioBus{parent: np, name: b.name + "", volume: b.volume, muted: b.muted, paused: b.paused})
    }
    $next_emitters := []resource.AudioEmitter{}
    for i in 0:snap.emitters.len {
        $e := clone_emitter(&snap.emitters[i], snap.emitters[i].node, snap.emitters[i].listener, snap.emitters[i].spatial + "")
        if e.bus > bus_idx { e.bus = e.bus - 1 }
        next_emitters.push(e)
    }
    snap.buses = next_buses
    snap.emitters = next_emitters
    commit_snapshot(draft, $&snap) >>>
    << 0
}

pub fn (draft $&Draft) set_node_sprite_3d(
    project &Project,
    idx int,
    uid string,
    width f64,
    height f64,
    billboard int,
    alpha_mode int,
    alpha_cutoff f64,
    shaded bool,
    flip_x bool,
    flip_y bool
) int {
    doc := draft.document() >>>
    $snap := unpack_doc(&doc) >>>
    require_node_idx(&snap, idx) >>>
    if snap.nodes[idx].kind != resource.NODE_3D {
        >>> errors.new("nexus editor: Sprite3D attachment requires a Node3D")
    }
    ref := asset_ref_for_uid(project, &draft.source, &uid, "image_rgba") >>>
    upsert_ref($&snap.refs, ref)
    $sp := sprite3d.sprite_3d(fm.vec2(width, height)) >>>
    sp.billboard = billboard
    sp.alpha_mode = alpha_mode
    sp.alpha_cutoff = alpha_cutoff
    sp.shaded = shaded
    sp.flip_x = flip_x
    sp.flip_y = flip_y
    sp.validate() >>>

    $next_sprites := []resource.Sprite3DAttachment{}
    for i in 0:snap.sprites.len {
        if snap.sprites[i].node != idx {
            next_sprites.push(clone_sprite_3d(&snap.sprites[i], snap.sprites[i].node))
        }
    }
    next_sprites.push(resource.sprite_3d_attachment(idx, uid + "", sp))
    snap.sprites = next_sprites
    commit_snapshot(draft, $&snap) >>>
    << 0
}

pub fn (draft $&Draft) clear_node_sprite_3d(idx int) int {
    doc := draft.document() >>>
    $snap := unpack_doc(&doc) >>>
    require_node_idx(&snap, idx) >>>
    $next_sprites := []resource.Sprite3DAttachment{}
    for i in 0:snap.sprites.len {
        if snap.sprites[i].node != idx {
            next_sprites.push(clone_sprite_3d(&snap.sprites[i], snap.sprites[i].node))
        }
    }
    snap.sprites = next_sprites
    commit_snapshot(draft, $&snap) >>>
    << 0
}

pub fn (draft $&Draft) ensure_node_tilemap_2d(project &Project, idx int, uid string) int {
    doc := draft.document() >>>
    $snap := unpack_doc(&doc) >>>
    require_node_idx(&snap, idx) >>>
    if snap.nodes[idx].kind != resource.NODE_2D {
        >>> errors.new("nexus editor: TileMap2D attachment requires a Node2D")
    }
    for i in 0:snap.tilemaps.len {
        if snap.tilemaps[i].node == idx {
            if uid.len == 0 || snap.tilemaps[i].resource_uid == uid {
                << 0
            }
            ref := asset_ref_for_uid(project, &draft.source, &uid, "image_rgba") >>>
            upsert_ref($&snap.refs, ref)
            tm_copy := clone_tilemap_2d(&snap.tilemaps[i], idx) >>>
            grid := tm_copy.grid.clone() >>>
            snap.tilemaps[i] = resource.tilemap_2d_attachment(idx, uid + "", tm_copy.z_index, tm_copy.y_sort_cells, tm_copy.y_offset, tm_copy.pixel_art, grid)
            commit_snapshot(draft, $&snap) >>>
            << 0
        }
    }
    if uid.len == 0 {
        >>> errors.new("nexus editor: select a PNG image asset for TileMap2D")
    }
    ref := asset_ref_for_uid(project, &draft.source, &uid, "image_rgba") >>>
    upsert_ref($&snap.refs, ref)
    ts := tilemap.tileset_2d(4, 4, 32.0, 32.0, fm.vec2(0.5, 0.5)) >>>
    grid := tilemap.new_tilemap_2d(tilemap.LAYOUT_ORTHOGONAL, 8, 8, 32.0, 32.0, 0.0, ts) >>>
    snap.tilemaps.push(resource.tilemap_2d_attachment(idx, uid + "", 0, true, 0.0, true, grid))
    commit_snapshot(draft, $&snap) >>>
    << 0
}

pub fn (draft $&Draft) merge_tilemaps(edited_doc &resource.Document, expected_revision &string) int {
    if draft.current != *expected_revision {
        >>> errors.new("nexus editor: scene changed while TileMap Editor was open")
    }
    doc := draft.document() >>>
    if doc.node_count() != edited_doc.node_count() {
        >>> errors.new("nexus editor: TileMap Editor topology mismatch")
    }
    $snap := unpack_doc(&doc) >>>
    for i in 0:edited_doc.resource_count() {
        er := edited_doc.resource(i) >>>
        $already := false
        for k in 0:snap.refs.len {
            if snap.refs[k].uid == er.uid {
                already = true
                <-
            }
        }
        if !already {
            snap.refs.push(resource.ResourceReference{
                uid: er.uid + "",
                kind: er.kind + "",
                path: er.path + "",
                content_hash: er.content_hash + ""
            })
        }
    }
    $next_tilemaps := []resource.TileMap2DAttachment{}
    for i in 0:edited_doc.tilemap_2d_count() {
        tm := edited_doc.tilemap_2d(i) >>>
        next_tilemaps.push(tm)
    }
    snap.tilemaps = next_tilemaps
    commit_snapshot(draft, $&snap) >>>
    << 0
}

pub fn (draft $&Draft) add_preset_camera_node(parent_idx int) int {
    doc := draft.document() >>>
    if doc.node_count() >= resource.MAX_NODES {
        >>> errors.new("nexus editor: scene node limit reached")
    }
    if parent_idx < 0 || parent_idx >= doc.node_count() {
        >>> errors.new("nexus editor: invalid parent node index")
    }
    $nodes := document_nodes_and_refs(&doc) >>>
    $children := children_table(&nodes)
    label := unique_sibling_name(&nodes, &children, parent_idx, "Camera") >>>
    $created := resource.node(parent_idx, label, resource.NODE_3D)
    created.camera = camera_data.perspective(60.0 * pi_val() / 180.0, 0.1, 200.0) >>>
    raw_idx := nodes.len
    nodes.push(created)
    children.push([]int{})
    children[parent_idx].push(raw_idx)
    $remap := []int{}
    next := rebuild_from_children(
        &doc,
        nodes,
        children,
        []resource.ResourceReference{},
        []resource.Surface{},
        []resource.AudioEmitter{},
        []resource.ScriptAttachment{},
        []resource.ScriptConnection{},
        []resource.LightAttachment{},
        []resource.Sprite3DAttachment{},
        []resource.TileMap2DAttachment{},
        $&remap
    ) >>>
    draft.replace(&next) >>>
    << remap[raw_idx]
}

pub fn (draft $&Draft) add_preset_light_node(parent_idx int) int {
    doc := draft.document() >>>
    if doc.node_count() >= resource.MAX_NODES {
        >>> errors.new("nexus editor: scene node limit reached")
    }
    if parent_idx < 0 || parent_idx >= doc.node_count() {
        >>> errors.new("nexus editor: invalid parent node index")
    }
    $nodes := document_nodes_and_refs(&doc) >>>
    $children := children_table(&nodes)
    label := unique_sibling_name(&nodes, &children, parent_idx, "PointLight") >>>
    $created := resource.node(parent_idx, label, resource.NODE_3D)
    raw_idx := nodes.len
    nodes.push(created)
    children.push([]int{})
    children[parent_idx].push(raw_idx)
    src := light_data.point(fm.vec3(0.0, 0.0, 0.0), fm.vec3(2.5, 2.2, 1.9), 12.0) >>>
    extra_light := resource.light_attachment(raw_idx, src)
    $remap := []int{}
    next := rebuild_from_children(
        &doc,
        nodes,
        children,
        []resource.ResourceReference{},
        []resource.Surface{},
        []resource.AudioEmitter{},
        []resource.ScriptAttachment{},
        []resource.ScriptConnection{},
        [extra_light],
        []resource.Sprite3DAttachment{},
        []resource.TileMap2DAttachment{},
        $&remap
    ) >>>
    draft.replace(&next) >>>
    << remap[raw_idx]
}
