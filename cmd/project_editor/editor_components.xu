pub fn handle_comp_action(ed $&Editor, a &widgets.Action, view $&widgets.View) bool {
    if a.kind != widgets.ACTION_ACTIVATE { << false }
    if a.id == ed.comp.button_ids[CB_CAM_APPLY] {
        mode := ed.comp.selects[CS_CAM_PROJ].selected()
        sel_node := ed.selected_node
        if mode == 0 {
            _ := draft_clear_cam(ed, sel_node) or (err) {
                ed.set_status(STATUS_ERR, err.msg(), view)
                << true
            }
            ed.refresh_after_document_change(false, view)
            ed.set_status(STATUS_OK, tr(ed.lang, "Cleared camera", "已清除相机"), view)
            << true
        }
        v1 := parse_f64_or(&ed.comp.fields[CF_CAM_F1].value(), "Camera param 1") or (err) {
            ed.set_status(STATUS_ERR, err.msg(), view)
            << true
        }
        v2 := parse_f64_or(&ed.comp.fields[CF_CAM_F2].value(), "Camera param 2") or (err) {
            ed.set_status(STATUS_ERR, err.msg(), view)
            << true
        }
        v3 := parse_f64_or(&ed.comp.fields[CF_CAM_F3].value(), "Camera param 3") or (err) {
            ed.set_status(STATUS_ERR, err.msg(), view)
            << true
        }
        if mode == 1 {
            _ := draft_set_cam_persp(ed, sel_node, v1, v2, v3) or (err) {
                ed.set_status(STATUS_ERR, err.msg(), view)
                << true
            }
            ed.refresh_after_document_change(false, view)
            ed.set_status(STATUS_OK, tr(ed.lang, "Applied Perspective camera", "已应用透视相机"), view)
        } else if mode == 2 {
            _ := draft_set_cam_ortho(ed, sel_node, v1, v2, v3) or (err) {
                ed.set_status(STATUS_ERR, err.msg(), view)
                << true
            }
            ed.refresh_after_document_change(false, view)
            ed.set_status(STATUS_OK, tr(ed.lang, "Applied Orthographic camera", "已应用正交相机"), view)
        } else {
            _ := draft_set_cam_2d(ed, sel_node, v1, v2, v3) or (err) {
                ed.set_status(STATUS_ERR, err.msg(), view)
                << true
            }
            ed.refresh_after_document_change(false, view)
            ed.set_status(STATUS_OK, tr(ed.lang, "Applied View2D camera", "已应用 2D 视图相机"), view)
        }
        << true
    }
    if a.id == ed.comp.button_ids[CB_CAM_CLEAR] {
        sel_node := ed.selected_node
        _ := draft_clear_cam(ed, sel_node) or (err) {
            ed.set_status(STATUS_ERR, err.msg(), view)
            << true
        }
        ed.refresh_after_document_change(false, view)
        ed.set_status(STATUS_OK, tr(ed.lang, "Cleared camera", "已清除相机"), view)
        << true
    }

    if a.id == ed.comp.button_ids[CB_LIGHT_APPLY] {
        ksel := ed.comp.selects[CS_LIGHT_KIND].selected()
        sel_node := ed.selected_node
        if ksel <= 0 {
            _ := draft_clear_light(ed, sel_node) or (err) {
                ed.set_status(STATUS_ERR, err.msg(), view)
                << true
            }
            ed.refresh_after_document_change(false, view)
            ed.set_status(STATUS_OK, tr(ed.lang, "Cleared light", "已清除光源"), view)
            << true
        }
        kind := ksel - 1
        r := parse_f64_or(&ed.comp.fields[CF_LIGHT_R].value(), "Light R") or (err) {
            ed.set_status(STATUS_ERR, err.msg(), view)
            << true
        }
        g := parse_f64_or(&ed.comp.fields[CF_LIGHT_G].value(), "Light G") or (err) {
            ed.set_status(STATUS_ERR, err.msg(), view)
            << true
        }
        b := parse_f64_or(&ed.comp.fields[CF_LIGHT_B].value(), "Light B") or (err) {
            ed.set_status(STATUS_ERR, err.msg(), view)
            << true
        }
        rad := parse_f64_or(&ed.comp.fields[CF_LIGHT_RADIUS].value(), "Light Radius") or (err) {
            ed.set_status(STATUS_ERR, err.msg(), view)
            << true
        }
        ind := parse_f64_or(&ed.comp.fields[CF_LIGHT_IN].value(), "Inner angle") or (err) {
            ed.set_status(STATUS_ERR, err.msg(), view)
            << true
        }
        outd := parse_f64_or(&ed.comp.fields[CF_LIGHT_OUT].value(), "Outer angle") or (err) {
            ed.set_status(STATUS_ERR, err.msg(), view)
            << true
        }
        dx := parse_f64_or(&ed.comp.fields[CF_LIGHT_DX].value(), "Dir X") or (err) {
            ed.set_status(STATUS_ERR, err.msg(), view)
            << true
        }
        dy := parse_f64_or(&ed.comp.fields[CF_LIGHT_DY].value(), "Dir Y") or (err) {
            ed.set_status(STATUS_ERR, err.msg(), view)
            << true
        }
        dz := parse_f64_or(&ed.comp.fields[CF_LIGHT_DZ].value(), "Dir Z") or (err) {
            ed.set_status(STATUS_ERR, err.msg(), view)
            << true
        }
        sh_on := ed.comp.checks[CK_LIGHT_SHADOW].value()
        sres_s := strings.trim_space(&ed.comp.fields[CF_LIGHT_SRES].value())
        $sres := 512
        if sres_s.len > 0 {
            sres = strconv.atoi(&sres_s) or (err) {
                _ := err
                ed.set_status(STATUS_ERR, "Shadow resolution must be integer", view)
                << true
            }
        }
        $sdist := 80.0
        sdist_s := strings.trim_space(&ed.comp.fields[CF_LIGHT_SDIST].value())
        if sdist_s.len > 0 {
            sdist = parse_f64_or(&sdist_s, "Shadow Dist") or (err) {
                ed.set_status(STATUS_ERR, err.msg(), view)
                << true
            }
        }
        _ := draft_set_light(ed, sel_node, kind, r, g, b, rad, ind, outd, dx, dy, dz, sh_on, sres, sdist) or (err) {
            ed.set_status(STATUS_ERR, err.msg(), view)
            << true
        }
        ed.refresh_after_document_change(false, view)
        ed.set_status(STATUS_OK, "Applied light & shadow", view)
        << true
    }
    if a.id == ed.comp.button_ids[CB_LIGHT_CLEAR] {
        sel_node := ed.selected_node
        _ := draft_clear_light(ed, sel_node) or (err) {
            ed.set_status(STATUS_ERR, err.msg(), view)
            << true
        }
        ed.refresh_after_document_change(false, view)
        ed.set_status(STATUS_OK, "Cleared light", view)
        << true
    }

    if a.id == ed.comp.button_ids[CB_SCRIPT_APPLY] {
        sel_node := ed.selected_node
        sopt := ed.comp.selects[CS_SCRIPT_ASSET].selected()
        if sopt <= 0 || (sopt - 1) >= ed.comp.xubc_indices.len {
            _ := draft_clear_script(ed, sel_node) or (err) {
                ed.set_status(STATUS_ERR, err.msg(), view)
                << true
            }
            ed.refresh_after_document_change(false, view)
            ed.set_status(STATUS_OK, "Cleared script", view)
            << true
        }
        uid := ed.project.assets[ed.comp.xubc_indices[sopt - 1]].key + ""
        inits := parse_script_initials(&ed.comp.fields[CF_SCRIPT_INIT].value()) or (err) {
            ed.set_status(STATUS_ERR, err.msg(), view)
            << true
        }
        proj := clone_project(&ed.project)
        _ := draft_set_script(ed, &proj, sel_node, uid, inits) or (err) {
            ed.set_status(STATUS_ERR, err.msg(), view)
            << true
        }
        ed.refresh_after_document_change(false, view)
        ed.set_status(STATUS_OK, "Bound script", view)
        << true
    }
    if a.id == ed.comp.button_ids[CB_SCRIPT_CLEAR] {
        sel_node := ed.selected_node
        _ := draft_clear_script(ed, sel_node) or (err) {
            ed.set_status(STATUS_ERR, err.msg(), view)
            << true
        }
        ed.refresh_after_document_change(false, view)
        ed.set_status(STATUS_OK, "Cleared script", view)
        << true
    }

    if a.id == ed.comp.button_ids[CB_AUDIO_APPLY] {
        sel_node := ed.selected_node
        aopt := ed.comp.selects[CS_AUDIO_ASSET].selected()
        if aopt <= 0 || (aopt - 1) >= ed.comp.wav_indices.len {
            _ := draft_clear_audio(ed, sel_node) or (err) {
                ed.set_status(STATUS_ERR, err.msg(), view)
                << true
            }
            ed.refresh_after_document_change(false, view)
            ed.set_status(STATUS_OK, "Cleared audio emitter", view)
            << true
        }
        uid := ed.project.assets[ed.comp.wav_indices[aopt - 1]].key + ""
        $bus := ed.comp.selects[CS_AUDIO_BUS].selected()
        if bus < 0 { bus = 0 }
        vol := parse_f64_or(&ed.comp.fields[CF_AUDIO_VOL].value(), "Audio Vol") or (err) {
            ed.set_status(STATUS_ERR, err.msg(), view)
            << true
        }
        pan := parse_f64_or(&ed.comp.fields[CF_AUDIO_PAN].value(), "Audio Pan") or (err) {
            ed.set_status(STATUS_ERR, err.msg(), view)
            << true
        }
        dist := parse_f64_or(&ed.comp.fields[CF_AUDIO_DIST].value(), "Audio MaxD") or (err) {
            ed.set_status(STATUS_ERR, err.msg(), view)
            << true
        }
        looping := ed.comp.checks[CK_AUDIO_LOOP].value()
        autoplay := ed.comp.checks[CK_AUDIO_AUTO].value()
        sp_sel := ed.comp.selects[CS_AUDIO_SPATIAL].selected()
        $spatial := "none"
        if sp_sel == 1 { spatial = "2d" } else if sp_sel == 2 { spatial = "3d" }
        l_sel := ed.comp.selects[CS_AUDIO_LISTENER].selected()
        $listener := -1
        if l_sel >= 0 && l_sel < ed.comp.listener_candidates.len { listener = ed.comp.listener_candidates[l_sel] }
        proj := clone_project(&ed.project)
        _ := draft_set_audio(ed, &proj, sel_node, uid, bus, vol, pan, looping, autoplay, spatial, listener, dist) or (err) {
            ed.set_status(STATUS_ERR, err.msg(), view)
            << true
        }
        ed.refresh_after_document_change(false, view)
        ed.set_status(STATUS_OK, "Bound audio emitter", view)
        << true
    }
    if a.id == ed.comp.button_ids[CB_AUDIO_CLEAR] {
        sel_node := ed.selected_node
        _ := draft_clear_audio(ed, sel_node) or (err) {
            ed.set_status(STATUS_ERR, err.msg(), view)
            << true
        }
        ed.refresh_after_document_change(false, view)
        ed.set_status(STATUS_OK, "Cleared audio emitter", view)
        << true
    }

    if a.id == ed.comp.button_ids[CB_SPRITE_APPLY] {
        sel_node := ed.selected_node
        sopt := ed.comp.selects[CS_SPRITE_ASSET].selected()
        if sopt <= 0 || (sopt - 1) >= ed.comp.png_indices.len {
            _ := draft_clear_sprite(ed, sel_node) or (err) {
                ed.set_status(STATUS_ERR, err.msg(), view)
                << true
            }
            ed.refresh_after_document_change(false, view)
            ed.set_status(STATUS_OK, "Cleared Sprite3D", view)
            << true
        }
        uid := ed.project.assets[ed.comp.png_indices[sopt - 1]].key + ""
        w := parse_f64_or(&ed.comp.fields[CF_SPRITE_W].value(), "Sprite W") or (err) {
            ed.set_status(STATUS_ERR, err.msg(), view)
            << true
        }
        h := parse_f64_or(&ed.comp.fields[CF_SPRITE_H].value(), "Sprite H") or (err) {
            ed.set_status(STATUS_ERR, err.msg(), view)
            << true
        }
        cut := parse_f64_or(&ed.comp.fields[CF_SPRITE_CUT].value(), "Sprite Cut") or (err) {
            ed.set_status(STATUS_ERR, err.msg(), view)
            << true
        }
        $bb := ed.comp.selects[CS_SPRITE_BB].selected()
        if bb < 0 { bb = sprite3d.BILLBOARD_Y_AXIS }
        $am := ed.comp.selects[CS_SPRITE_ALPHA].selected()
        if am < 0 { am = sprite3d.ALPHA_MODE_CUTOUT }
        shaded := ed.comp.checks[CK_SPRITE_SHADED].value()
        proj := clone_project(&ed.project)
        _ := draft_set_sprite(ed, &proj, sel_node, uid, w, h, bb, am, cut, shaded) or (err) {
            ed.set_status(STATUS_ERR, err.msg(), view)
            << true
        }
        ed.refresh_after_document_change(false, view)
        ed.set_status(STATUS_OK, "Bound Sprite3D", view)
        << true
    }
    if a.id == ed.comp.button_ids[CB_SPRITE_CLEAR] {
        sel_node := ed.selected_node
        _ := draft_clear_sprite(ed, sel_node) or (err) {
            ed.set_status(STATUS_ERR, err.msg(), view)
            << true
        }
        ed.refresh_after_document_change(false, view)
        ed.set_status(STATUS_OK, "Cleared Sprite3D", view)
        << true
    }

    if a.id == ed.comp.button_ids[CB_TILEMAP_EDIT] {
        sel_node := ed.selected_node
        topt := ed.comp.selects[CS_TILEMAP_ASSET].selected()
        $uid := ""
        if topt > 0 && (topt - 1) < ed.comp.png_indices.len {
            uid = ed.project.assets[ed.comp.png_indices[topt - 1]].key + ""
        }
        proj := clone_project(&ed.project)
        _ := draft_ensure_tilemap(ed, &proj, sel_node, uid) or (err) {
            ed.set_status(STATUS_ERR, err.msg(), view)
            << true
        }
        ed.refresh_after_document_change(false, view)
        ed.req_launch_tilemap = true
        << true
    }

    if a.id == ed.comp.button_ids[CB_ENV_APPLY] {
        sel_node := ed.selected_node
        $sky := ed.comp.selects[CS_ENV_SKY].selected()
        if sky < 0 { sky = resource.SKY_ATMOSPHERE }
        sun := parse_f64_or(&ed.comp.fields[CF_ENV_SUN].value(), "Env Sun") or (err) {
            ed.set_status(STATUS_ERR, err.msg(), view)
            << true
        }
        exp := parse_f64_or(&ed.comp.fields[CF_ENV_EXP].value(), "Env Exposure") or (err) {
            ed.set_status(STATUS_ERR, err.msg(), view)
            << true
        }
        fog := parse_f64_or(&ed.comp.fields[CF_ENV_FOG].value(), "Env Fog") or (err) {
            ed.set_status(STATUS_ERR, err.msg(), view)
            << true
        }
        bloom := ed.comp.checks[CK_ENV_BLOOM].value()
        gtao := ed.comp.checks[CK_ENV_GTAO].value()
        ddgi := ed.comp.checks[CK_ENV_DDGI].value()
        _ := draft_set_env(ed, sel_node, sky, sun, exp, fog, bloom, gtao, false, true, ddgi) or (err) {
            ed.set_status(STATUS_ERR, err.msg(), view)
            << true
        }
        ed.refresh_after_document_change(false, view)
        ed.set_status(STATUS_OK, "Applied Environment", view)
        << true
    }
    if a.id == ed.comp.button_ids[CB_ENV_CLEAR] {
        sel_node := ed.selected_node
        _ := draft_clear_env(ed, sel_node) or (err) {
            ed.set_status(STATUS_ERR, err.msg(), view)
            << true
        }
        ed.refresh_after_document_change(false, view)
        ed.set_status(STATUS_OK, "Cleared Environment", view)
        << true
    }

    if a.id == ed.comp.button_ids[CB_RB_APPLY] {
        sel_node := ed.selected_node
        $btype := ed.comp.selects[CS_RB_TYPE].selected()
        if btype < 0 { btype = resource.BODY_DYNAMIC }
        $skind := ed.comp.selects[CS_RB_SHAPE].selected()
        if skind < 0 { skind = resource.SHAPE_BOX }
        mass := parse_f64_or(&ed.comp.fields[CF_RB_MASS].value(), "RB Mass") or (err) {
            ed.set_status(STATUS_ERR, err.msg(), view)
            << true
        }
        rest := parse_f64_or(&ed.comp.fields[CF_RB_REST].value(), "RB Restitution") or (err) {
            ed.set_status(STATUS_ERR, err.msg(), view)
            << true
        }
        fric := parse_f64_or(&ed.comp.fields[CF_RB_FRIC].value(), "RB Friction") or (err) {
            ed.set_status(STATUS_ERR, err.msg(), view)
            << true
        }
        trig := ed.comp.checks[CK_RB_TRIGGER].value()
        _ := draft_set_rb(ed, sel_node, btype, skind, fm.vec3(0.5, 0.5, 0.5), 0.5, mass, rest, fric, trig) or (err) {
            ed.set_status(STATUS_ERR, err.msg(), view)
            << true
        }
        ed.refresh_after_document_change(false, view)
        ed.set_status(STATUS_OK, "Applied RigidBody3D", view)
        << true
    }
    if a.id == ed.comp.button_ids[CB_RB_CLEAR] {
        sel_node := ed.selected_node
        _ := draft_clear_rb(ed, sel_node) or (err) {
            ed.set_status(STATUS_ERR, err.msg(), view)
            << true
        }
        ed.refresh_after_document_change(false, view)
        ed.set_status(STATUS_OK, "Cleared RigidBody3D", view)
        << true
    }

    if a.id == ed.comp.button_ids[CB_TERR_APPLY] {
        sel_node := ed.selected_node
        gx_s := strings.trim_space(&ed.comp.fields[CF_TERR_GRID].value())
        gx := strconv.atoi(&gx_s) or (err) {
            _ := err
            ed.set_status(STATUS_ERR, "Terrain grid must be integer", view)
            << true
        }
        cs := parse_f64_or(&ed.comp.fields[CF_TERR_CELL].value(), "Terrain Cell") or (err) {
            ed.set_status(STATUS_ERR, err.msg(), view)
            << true
        }
        hs := parse_f64_or(&ed.comp.fields[CF_TERR_HEIGHT].value(), "Terrain HeightScale") or (err) {
            ed.set_status(STATUS_ERR, err.msg(), view)
            << true
        }
        fol := parse_f64_or(&ed.comp.fields[CF_TERR_FOL].value(), "Terrain Foliage") or (err) {
            ed.set_status(STATUS_ERR, err.msg(), view)
            << true
        }
        _ := draft_set_terrain(ed, sel_node, gx, cs, hs, fol) or (err) {
            ed.set_status(STATUS_ERR, err.msg(), view)
            << true
        }
        ed.refresh_after_document_change(false, view)
        ed.set_status(STATUS_OK, "Applied Terrain", view)
        << true
    }
    if a.id == ed.comp.button_ids[CB_TERR_CLEAR] {
        sel_node := ed.selected_node
        _ := draft_clear_terrain(ed, sel_node) or (err) {
            ed.set_status(STATUS_ERR, err.msg(), view)
            << true
        }
        ed.refresh_after_document_change(false, view)
        ed.set_status(STATUS_OK, "Cleared Terrain", view)
        << true
    }

    if a.id == ed.comp.button_ids[CB_PART_APPLY] {
        sel_node := ed.selected_node
        max_s := strings.trim_space(&ed.comp.fields[CF_PART_MAX].value())
        max_p := strconv.atoi(&max_s) or (err) {
            _ := err
            ed.set_status(STATUS_ERR, "Particle max must be integer", view)
            << true
        }
        rate := parse_f64_or(&ed.comp.fields[CF_PART_RATE].value(), "Particle Rate") or (err) {
            ed.set_status(STATUS_ERR, err.msg(), view)
            << true
        }
        life := parse_f64_or(&ed.comp.fields[CF_PART_LIFE].value(), "Particle Lifetime") or (err) {
            ed.set_status(STATUS_ERR, err.msg(), view)
            << true
        }
        spd := parse_f64_or(&ed.comp.fields[CF_PART_SPD].value(), "Particle Speed") or (err) {
            ed.set_status(STATUS_ERR, err.msg(), view)
            << true
        }
        sz := parse_f64_or(&ed.comp.fields[CF_PART_SIZE].value(), "Particle Size") or (err) {
            ed.set_status(STATUS_ERR, err.msg(), view)
            << true
        }
        add := ed.comp.checks[CK_PART_ADD].value()
        _ := draft_set_particles(ed, sel_node, max_p, rate, life, spd, sz, add) or (err) {
            ed.set_status(STATUS_ERR, err.msg(), view)
            << true
        }
        ed.refresh_after_document_change(false, view)
        ed.set_status(STATUS_OK, "Applied ParticleEmitter3D", view)
        << true
    }
    if a.id == ed.comp.button_ids[CB_PART_CLEAR] {
        sel_node := ed.selected_node
        _ := draft_clear_particles(ed, sel_node) or (err) {
            ed.set_status(STATUS_ERR, err.msg(), view)
            << true
        }
        ed.refresh_after_document_change(false, view)
        ed.set_status(STATUS_OK, "Cleared ParticleEmitter3D", view)
        << true
    }

    if a.id == ed.comp.button_ids[CB_PREFAB_APPLY] {
        sel_node := ed.selected_node
        popt := ed.comp.selects[CS_PREFAB_ASSET].selected()
        if popt <= 0 || (popt - 1) >= ed.project.scenes.len {
            _ := draft_clear_prefab(ed, sel_node) or (err) {
                ed.set_status(STATUS_ERR, err.msg(), view)
                << true
            }
            ed.refresh_after_document_change(false, view)
            ed.set_status(STATUS_OK, "Cleared PrefabInstance", view)
            << true
        }
        uid := ed.project.scenes[popt - 1].key + ""
        ov := ed.comp.fields[CF_PREFAB_OV].value()
        vis := ed.comp.checks[CK_PREFAB_VIS].value()
        proj := clone_project(&ed.project)
        _ := draft_set_prefab(ed, &proj, sel_node, uid, ov, vis) or (err) {
            ed.set_status(STATUS_ERR, err.msg(), view)
            << true
        }
        ed.refresh_after_document_change(false, view)
        ed.set_status(STATUS_OK, "Bound PrefabInstance", view)
        << true
    }
    if a.id == ed.comp.button_ids[CB_PREFAB_CLEAR] {
        sel_node := ed.selected_node
        _ := draft_clear_prefab(ed, sel_node) or (err) {
            ed.set_status(STATUS_ERR, err.msg(), view)
            << true
        }
        ed.refresh_after_document_change(false, view)
        ed.set_status(STATUS_OK, "Cleared PrefabInstance", view)
        << true
    }
    << false
}
