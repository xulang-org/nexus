    c.id_light_row5 = add_box(view, id_scroll, &row_box(scroll_cw, 44.0, 4.0))
    _ := push_comp_chk(c, view, c.id_light_row5, tri_w, 0, ctx, id_ev, "Shadows", false) or >>
    _ := push_comp_field(c, view, c.id_light_row5, tri_w, 0, ctx, id_ev, "Res", "512") or >>
    _ := push_comp_field(c, view, c.id_light_row5, tri_w, 0, ctx, id_ev, "Dist", "80") or >>
    c.id_light_row6 = add_box(view, id_scroll, &row_box(scroll_cw, 30.0, 4.0))
