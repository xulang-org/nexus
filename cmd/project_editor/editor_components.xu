        replace_static_select_labels(c, CS_SPRITE_BB, ctx, &["BB: Off", "BB: Full", "BB: Y-Axis"])
        replace_static_select_labels(c, CS_SPRITE_ALPHA, ctx, &["Opaque", "Cutout"])
