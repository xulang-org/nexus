    _ := push_comp_btn(c, view, c.id_light_row6, half_w, 1, ctx, id_ev, "Clear") or >>
    << 0
}

fn init_comp_script(c $&ComponentInspector, view $&widgets.View, id_scroll int, scroll_cw f64, half_w f64, ctx &draw.Context, id_ev &ui.CanvasEvent, project &Project) int {
    c.id_script_div = push_comp_div(c, view, id_scroll, scroll_cw) or >>
    c.id_script_hdr = add_box(view, id_scroll, &leaf_box(scroll_cw, 18.0))
    c.id_script_row1 = add_box(view, id_scroll, &row_box(scroll_cw, 30.0, 4.0))
    cnt := min_int_val(c.xubc_indices.len + 1, 64)
    lbls := make_surface_asset_labels(ctx, project, &c.xubc_indices, "(No .xubc)")
    _ := push_comp_select(c, view, c.id_script_row1, scroll_cw, 0, id_ev, cnt, 0, lbls) or >>
    _ := push_comp_field(c, view, id_scroll, scroll_cw, 1, ctx, id_ev, "Initials (id=val, ...)", "") or >>
    c.id_script_row3 = add_box(view, id_scroll, &row_box(scroll_cw, 30.0, 4.0))
    _ := push_comp_btn(c, view, c.id_script_row3, half_w, 0, ctx, id_ev, "Bind Script") or >>
    _ := push_comp_btn(c, view, c.id_script_row3, half_w, 1, ctx, id_ev, "Clear") or >>
    << 0
}

fn init_comp_audio(c $&ComponentInspector, view $&widgets.View, id_scroll int, scroll_cw f64, tri_w f64, half_w f64, ctx &draw.Context, id_ev &ui.CanvasEvent, project &Project) int {
    c.id_audio_div = push_comp_div(c, view, id_scroll, scroll_cw) or >>
    c.id_audio_hdr = add_box(view, id_scroll, &leaf_box(scroll_cw, 18.0))
    c.id_audio_row1 = add_box(view, id_scroll, &row_box(scroll_cw, 30.0, 4.0))
    w_cnt := min_int_val(c.wav_indices.len + 1, 64)
    a_lbls := make_surface_asset_labels(ctx, project, &c.wav_indices, "(No .wav)")
    _ := push_comp_select(c, view, c.id_audio_row1, math.max(80.0, scroll_cw * 0.56), 1, id_ev, w_cnt, 0, a_lbls) or >>
    _ := push_comp_select(c, view, c.id_audio_row1, math.max(60.0, scroll_cw * 0.44 - 4.0), 2, id_ev, 1, 0, make_styled_labels(ctx, &["Master"])) or >>
    c.id_audio_row2 = add_box(view, id_scroll, &row_box(scroll_cw, 44.0, 4.0))
    _ := push_comp_field(c, view, c.id_audio_row2, tri_w, 0, ctx, id_ev, "Vol", "1") or >>
    _ := push_comp_field(c, view, c.id_audio_row2, tri_w, 0, ctx, id_ev, "Pan", "0") or >>
    _ := push_comp_field(c, view, c.id_audio_row2, tri_w, 0, ctx, id_ev, "MaxD", "0") or >>
    c.id_audio_row3 = add_box(view, id_scroll, &row_box(scroll_cw, 26.0, 4.0))
    _ := push_comp_chk(c, view, c.id_audio_row3, half_w, 1, ctx, id_ev, "Loop", false) or >>
    _ := push_comp_chk(c, view, c.id_audio_row3, half_w, 1, ctx, id_ev, "Auto", false) or >>
    c.id_audio_row4 = add_box(view, id_scroll, &row_box(scroll_cw, 30.0, 4.0))
    _ := push_comp_select(c, view, c.id_audio_row4, math.max(70.0, scroll_cw * 0.44), 3, id_ev, 3, 0, make_styled_labels(ctx, &["none", "2d", "3d"])) or >>
    _ := push_comp_select(c, view, c.id_audio_row4, math.max(70.0, scroll_cw * 0.56 - 4.0), 4, id_ev, 1, 0, make_styled_labels(ctx, &["Listener: None"])) or >>
    c.id_audio_row5 = add_box(view, id_scroll, &row_box(scroll_cw, 30.0, 4.0))
    _ := push_comp_btn(c, view, c.id_audio_row5, half_w, 0, ctx, id_ev, "Bind Audio") or >>
    _ := push_comp_btn(c, view, c.id_audio_row5, half_w, 1, ctx, id_ev, "Clear") or >>
    << 0
}

