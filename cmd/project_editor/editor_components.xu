    _ := push_comp_field(c, view, c.id_sprite_row2, tri_w, 0, ctx, id_ev, "Cut", "0.5") or >>
    c.id_sprite_row3 = add_box(view, id_scroll, &row_box(scroll_cw, 30.0, 4.0))
    _ := push_comp_select(c, view, c.id_sprite_row3, half_w, 5, id_ev, 3, 2, make_styled_labels(ctx, &["BB: Off", "BB: Full", "BB: Y-Axis"])) or >>
    _ := push_comp_select(c, view, c.id_sprite_row3, half_w, 5, id_ev, 2, 1, make_styled_labels(ctx, &["Opaque", "Cutout"])) or >>
    c.id_sprite_row4 = add_box(view, id_scroll, &row_box(scroll_cw, 30.0, 4.0))
    _ := push_comp_chk(c, view, c.id_sprite_row4, tri_w, 2, ctx, id_ev, "Shaded", true) or >>
    _ := push_comp_btn(c, view, c.id_sprite_row4, tri_w, 2, ctx, id_ev, "Bind") or >>
    _ := push_comp_btn(c, view, c.id_sprite_row4, tri_w, 3, ctx, id_ev, "Clear") or >>
    << 0
}

fn init_comp_tilemap(c $&ComponentInspector, view $&widgets.View, id_scroll int, scroll_cw f64, ctx &draw.Context, id_ev &ui.CanvasEvent, project &Project) int {
    c.id_tilemap_div = push_comp_div(c, view, id_scroll, scroll_cw) or >>
    c.id_tilemap_hdr = add_box(view, id_scroll, &leaf_box(scroll_cw, 18.0))
    id_info := add_interactive(view, id_scroll, &leaf_box(scroll_cw, 18.0), ui.CURSOR_TEXT, true)
    view.set_capture_outside(id_info, true) or >>
    c.id_tilemap_info = id_info
    info_txt := widgets.selectable_text(ctx, id_ev, id_info, &zero_rect(), &"No TileMap2D") or >>
    c.tilemap_info_txts.push(info_txt)
    set_text_ellipsis($&c.tilemap_info_txts[0], true)

    c.id_tilemap_row = add_box(view, id_scroll, &row_box(scroll_cw, 30.0, 4.0))
    p_cnt := min_int_val(c.png_indices.len + 1, 64)
    p_lbls := make_surface_asset_labels(ctx, project, &c.png_indices, "(No .png)")
    _ := push_comp_select(c, view, c.id_tilemap_row, math.max(70.0, scroll_cw - 108.0), 6, id_ev, p_cnt, 0, p_lbls) or >>
    _ := push_comp_btn(c, view, c.id_tilemap_row, 104.0, 4, ctx, id_ev, "TileMap Editor") or >>
    << 0
}

fn init_comp_modern_v9(c $&ComponentInspector, view $&widgets.View, id_scroll int, scroll_cw f64, tri_w f64, half_w f64, ctx &draw.Context, id_ev &ui.CanvasEvent, project &Project) int {
    // Environment
    c.id_env_div = push_comp_div(c, view, id_scroll, scroll_cw) or >>
    c.id_env_hdr = add_box(view, id_scroll, &leaf_box(scroll_cw, 18.0))
    c.id_env_row1 = add_box(view, id_scroll, &row_box(scroll_cw, 30.0, 4.0))
    _ := push_comp_select(c, view, c.id_env_row1, scroll_cw, 0, id_ev, 2, 1, make_styled_labels(ctx, &["Sky: Solid", "Sky: Atmosphere"])) or >>
    c.id_env_row2 = add_box(view, id_scroll, &row_box(scroll_cw, 44.0, 4.0))
    _ := push_comp_field(c, view, c.id_env_row2, tri_w, 0, ctx, id_ev, "Sun", "2.2") or >>
    _ := push_comp_field(c, view, c.id_env_row2, tri_w, 0, ctx, id_ev, "Exp", "1") or >>
    _ := push_comp_field(c, view, c.id_env_row2, tri_w, 0, ctx, id_ev, "Fog", "0.012") or >>
    c.id_env_row3 = add_box(view, id_scroll, &row_box(scroll_cw, 26.0, 4.0))
    _ := push_comp_chk(c, view, c.id_env_row3, tri_w, 0, ctx, id_ev, "Bloom", true) or >>
    _ := push_comp_chk(c, view, c.id_env_row3, tri_w, 0, ctx, id_ev, "GTAO", true) or >>
    _ := push_comp_chk(c, view, c.id_env_row3, tri_w, 0, ctx, id_ev, "DDGI", true) or >>
    c.id_env_row4 = add_box(view, id_scroll, &row_box(scroll_cw, 30.0, 4.0))
    _ := push_comp_btn(c, view, c.id_env_row4, half_w, 0, ctx, id_ev, "Apply Env") or >>
    _ := push_comp_btn(c, view, c.id_env_row4, half_w, 1, ctx, id_ev, "Clear") or >>

    // RigidBody3D
    c.id_rb_div = push_comp_div(c, view, id_scroll, scroll_cw) or >>
    c.id_rb_hdr = add_box(view, id_scroll, &leaf_box(scroll_cw, 18.0))
    c.id_rb_row1 = add_box(view, id_scroll, &row_box(scroll_cw, 30.0, 4.0))
    _ := push_comp_select(c, view, c.id_rb_row1, half_w, 5, id_ev, 3, 2, make_styled_labels(ctx, &["Static", "Kinematic", "Dynamic"])) or >>
    _ := push_comp_select(c, view, c.id_rb_row1, half_w, 5, id_ev, 4, 0, make_styled_labels(ctx, &["Box", "Sphere", "Capsule", "Mesh"])) or >>
    c.id_rb_row2 = add_box(view, id_scroll, &row_box(scroll_cw, 44.0, 4.0))
    _ := push_comp_field(c, view, c.id_rb_row2, tri_w, 0, ctx, id_ev, "Mass", "1") or >>
    _ := push_comp_field(c, view, c.id_rb_row2, tri_w, 0, ctx, id_ev, "Rest", "0.2") or >>
    _ := push_comp_field(c, view, c.id_rb_row2, tri_w, 0, ctx, id_ev, "Fric", "0.6") or >>
    c.id_rb_row3 = add_box(view, id_scroll, &row_box(scroll_cw, 30.0, 4.0))
    _ := push_comp_chk(c, view, c.id_rb_row3, tri_w, 2, ctx, id_ev, "Trigger", false) or >>
    _ := push_comp_btn(c, view, c.id_rb_row3, tri_w, 2, ctx, id_ev, "Apply RB") or >>
    _ := push_comp_btn(c, view, c.id_rb_row3, tri_w, 3, ctx, id_ev, "Clear") or >>

    // Terrain
    c.id_terr_div = push_comp_div(c, view, id_scroll, scroll_cw) or >>
    c.id_terr_hdr = add_box(view, id_scroll, &leaf_box(scroll_cw, 18.0))
    c.id_terr_row1 = add_box(view, id_scroll, &row_box(scroll_cw, 44.0, 4.0))
    _ := push_comp_field(c, view, c.id_terr_row1, half_w, 2, ctx, id_ev, "Grid", "33") or >>
    _ := push_comp_field(c, view, c.id_terr_row1, half_w, 2, ctx, id_ev, "Cell", "1") or >>
    c.id_terr_row2 = add_box(view, id_scroll, &row_box(scroll_cw, 44.0, 4.0))
    _ := push_comp_field(c, view, c.id_terr_row2, half_w, 2, ctx, id_ev, "HScale", "1") or >>
    _ := push_comp_field(c, view, c.id_terr_row2, half_w, 2, ctx, id_ev, "Foliage", "0.75") or >>
    c.id_terr_row3 = add_box(view, id_scroll, &row_box(scroll_cw, 30.0, 4.0))
    _ := push_comp_btn(c, view, c.id_terr_row3, half_w, 0, ctx, id_ev, "Apply Terrain") or >>
    _ := push_comp_btn(c, view, c.id_terr_row3, half_w, 1, ctx, id_ev, "Clear") or >>

    // ParticleEmitter3D
    c.id_part_div = push_comp_div(c, view, id_scroll, scroll_cw) or >>
    c.id_part_hdr = add_box(view, id_scroll, &leaf_box(scroll_cw, 18.0))
    c.id_part_row1 = add_box(view, id_scroll, &row_box(scroll_cw, 44.0, 4.0))
    _ := push_comp_field(c, view, c.id_part_row1, tri_w, 0, ctx, id_ev, "Max", "256") or >>
    _ := push_comp_field(c, view, c.id_part_row1, tri_w, 0, ctx, id_ev, "Rate", "48") or >>
    _ := push_comp_field(c, view, c.id_part_row1, tri_w, 0, ctx, id_ev, "Life", "1.5") or >>
    c.id_part_row2 = add_box(view, id_scroll, &row_box(scroll_cw, 44.0, 4.0))
    _ := push_comp_field(c, view, c.id_part_row2, half_w, 2, ctx, id_ev, "Speed", "2.5") or >>
    _ := push_comp_field(c, view, c.id_part_row2, half_w, 2, ctx, id_ev, "Size", "0.25") or >>
    c.id_part_row3 = add_box(view, id_scroll, &row_box(scroll_cw, 30.0, 4.0))
    _ := push_comp_chk(c, view, c.id_part_row3, tri_w, 2, ctx, id_ev, "Additive", true) or >>
    _ := push_comp_btn(c, view, c.id_part_row3, tri_w, 2, ctx, id_ev, "Apply VFX") or >>
    _ := push_comp_btn(c, view, c.id_part_row3, tri_w, 3, ctx, id_ev, "Clear") or >>

    // PrefabInstance
    c.id_prefab_div = push_comp_div(c, view, id_scroll, scroll_cw) or >>
    c.id_prefab_hdr = add_box(view, id_scroll, &leaf_box(scroll_cw, 18.0))
    c.id_prefab_row1 = add_box(view, id_scroll, &row_box(scroll_cw, 30.0, 4.0))
    pf_cnt := min_int_val(project.scenes.len + 1, 64)
    _ := push_comp_select(c, view, c.id_prefab_row1, scroll_cw, 0, id_ev, pf_cnt, 0, make_scene_prefab_labels(ctx, project, "(No .xuscene)")) or >>
    c.id_prefab_ov = add_box(view, id_scroll, &row_box(scroll_cw, 44.0, 4.0))
    _ := push_comp_field(c, view, c.id_prefab_ov, scroll_cw, 1, ctx, id_ev, "Override path", "") or >>
    c.id_prefab_row2 = add_box(view, id_scroll, &row_box(scroll_cw, 30.0, 4.0))
    _ := push_comp_chk(c, view, c.id_prefab_row2, tri_w, 2, ctx, id_ev, "Visible", true) or >>
    _ := push_comp_btn(c, view, c.id_prefab_row2, tri_w, 2, ctx, id_ev, "Bind Prefab") or >>
    _ := push_comp_btn(c, view, c.id_prefab_row2, tri_w, 3, ctx, id_ev, "Clear") or >>
    << 0
}

pub fn create_comp_inspector(
    view $&widgets.View,
    id_scroll int,
    scroll_cw f64,
    context &draw.Context,
    identity &ui.CanvasEvent,
    project &Project,
    styles &widgets.Styles
) ComponentInspector {
    tri_w := (scroll_cw - 8.0) / 3.0
    half_w := (scroll_cw - 4.0) * 0.5
    $comp := ComponentInspector{
        png_indices: collect_ext_indices(project, ".png"),
        wav_indices: collect_ext_indices(project, ".wav"),
        xubc_indices: collect_ext_indices(project, ".xubc"),
        scene_indices: collect_ext_indices(project, ".xuscene"),
        listener_candidates: [-1],
        pi_val_cache: 3.14159265358979323846,
        id_cam_div: 0, id_cam_hdr: 0, id_cam_row1: 0, id_cam_row2: 0, id_cam_row3: 0,
        id_light_div: 0, id_light_hdr: 0, id_light_row1: 0, id_light_row2: 0, id_light_row3: 0, id_light_row4: 0, id_light_row5: 0, id_light_row6: 0,
        id_script_div: 0, id_script_hdr: 0, id_script_row1: 0, id_script_row3: 0,
        id_audio_div: 0, id_audio_hdr: 0, id_audio_row1: 0, id_audio_row2: 0, id_audio_row3: 0, id_audio_row4: 0, id_audio_row5: 0,
        id_sprite_div: 0, id_sprite_hdr: 0, id_sprite_row1: 0, id_sprite_row2: 0, id_sprite_row3: 0, id_sprite_row4: 0,
        id_tilemap_div: 0, id_tilemap_hdr: 0, id_tilemap_info: 0, id_tilemap_row: 0,
        id_env_div: 0, id_env_hdr: 0, id_env_row1: 0, id_env_row2: 0, id_env_row3: 0, id_env_row4: 0,
        id_rb_div: 0, id_rb_hdr: 0, id_rb_row1: 0, id_rb_row2: 0, id_rb_row3: 0,
        id_terr_div: 0, id_terr_hdr: 0, id_terr_row1: 0, id_terr_row2: 0, id_terr_row3: 0,
        id_part_div: 0, id_part_hdr: 0, id_part_row1: 0, id_part_row2: 0, id_part_row3: 0,
        id_prefab_div: 0, id_prefab_hdr: 0, id_prefab_row1: 0, id_prefab_ov: 0, id_prefab_row2: 0,
        fields: []widgets.Field{},
        field_ids: []int{},
        field_kinds: []int{},
        selects: []widgets.Select{},
        select_ids: []int{},
        select_kinds: []int{},
        select_origins: []layout.Rect{},
        select_labels: [][]widgets.StyledLabel{},
        buttons: []widgets.Button{},
        button_ids: []int{},
        button_kinds: []int{},
        button_labels: []widgets.StyledLabel{},
        checks: []widgets.Checkbox{},
        check_ids: []int{},
        check_kinds: []int{},
        check_labels: []widgets.StyledLabel{},
        divs: []widgets.Divider{},
        div_ids: []int{},
        tilemap_info_txts: []widgets.SelectableText{},
        empty_lbl: widgets.styled_label(context, &"-")
    }
    init_comp_camera($&comp, view, id_scroll, scroll_cw, tri_w, half_w, context, identity) or >>
    init_comp_light($&comp, view, id_scroll, scroll_cw, tri_w, half_w, context, identity) or >>
    init_comp_script($&comp, view, id_scroll, scroll_cw, half_w, context, identity, project) or >>
    init_comp_audio($&comp, view, id_scroll, scroll_cw, tri_w, half_w, context, identity, project) or >>
    init_comp_sprite($&comp, view, id_scroll, scroll_cw, tri_w, half_w, context, identity, project) or >>
    init_comp_tilemap($&comp, view, id_scroll, scroll_cw, context, identity, project) or >>
    init_comp_modern_v9($&comp, view, id_scroll, scroll_cw, tri_w, half_w, context, identity, project) or >>
    apply_comp_styles($&comp, styles)
    << comp
}

pub fn apply_comp_styles(c $&ComponentInspector, styles &widgets.Styles) {
    compact := compact_button_style(styles, widgets.BUTTON_SECONDARY)
    subtle := compact_button_style(styles, widgets.BUTTON_SUBTLE)
    cf := compact_field_style(styles)
    cs := compact_select_style(styles)

    for i in 0:c.buttons.len {
        kind := c.button_kinds[i]
        if kind == 1 || kind == 3 {
            set_btn_style($&c.buttons[i], &subtle)
        } else {
            set_btn_style($&c.buttons[i], &compact)
        }
    }
    for i in 0:c.fields.len {
        set_field_style($&c.fields[i], &cf)
    }
    for i in 0:c.selects.len {
        set_sel_style($&c.selects[i], &cs)
    }
}

fn set_comp_field_label(f $&widgets.Field, lbl string) {
    $dec := widgets.field_decoration(&lbl)
    dec.reserve_helper = false
    set_field_dec(f, &dec)
}

fn replace_static_select_labels(c $&ComponentInspector, sel_idx int, ctx &draw.Context, names &[]string) {
    prev := c.selects[sel_idx].selected()
    for i in 0:c.select_labels[sel_idx].len { dispose_label($&c.select_labels[sel_idx][i]) }
    c.select_labels[sel_idx] = make_styled_labels(ctx, names)
    cnt := min_int_val(c.select_labels[sel_idx].len, 64)
    set_sel_count($&c.selects[sel_idx], cnt)
    $next_sel := prev
    if next_sel < 0 || next_sel >= cnt { next_sel = 0 }
    set_sel_selected($&c.selects[sel_idx], next_sel)
}

