        replace_static_select_labels(c, CS_RB_TYPE, ctx, &["Static", "Kinematic", "Dynamic"])
        replace_static_select_labels(c, CS_RB_SHAPE, ctx, &["Box", "Sphere", "Capsule", "Mesh"])
    }
    refresh_comp_asset_selectors(c, ctx, project, lang)
}

pub fn comp_dispose(c $&ComponentInspector) {
    for i in 0:c.fields.len { dispose_field($&c.fields[i]) }
    for i in 0:c.tilemap_info_txts.len { dispose_sel_text($&c.tilemap_info_txts[i]) }
    for i in 0:c.button_labels.len { dispose_label($&c.button_labels[i]) }
    for i in 0:c.check_labels.len { dispose_label($&c.check_labels[i]) }
    dispose_label($&c.empty_lbl)
    for i in 0:c.select_labels.len {
        for j in 0:c.select_labels[i].len {
            dispose_label($&c.select_labels[i][j])
        }
    }
}

pub fn sync_comp_layout(c &ComponentInspector, view $&widgets.View, scroll_cw f64) int {
    tri_w := (scroll_cw - 8.0) / 3.0
    half_w := (scroll_cw - 4.0) * 0.5

    for i in 0:c.div_ids.len { view.set_style(c.div_ids[i], &leaf_box(scroll_cw, 4.0)) or >> }
    view.set_style(c.id_cam_hdr, &leaf_box(scroll_cw, 18.0)) or >>
    view.set_style(c.id_cam_row1, &row_box(scroll_cw, 30.0, 4.0)) or >>
    view.set_style(c.id_cam_row2, &row_box(scroll_cw, 44.0, 4.0)) or >>
    view.set_style(c.id_cam_row3, &row_box(scroll_cw, 30.0, 4.0)) or >>

    view.set_style(c.id_light_hdr, &leaf_box(scroll_cw, 18.0)) or >>
    view.set_style(c.id_light_row1, &row_box(scroll_cw, 30.0, 4.0)) or >>
    view.set_style(c.id_light_row2, &row_box(scroll_cw, 44.0, 4.0)) or >>
    view.set_style(c.id_light_row3, &row_box(scroll_cw, 44.0, 4.0)) or >>
    view.set_style(c.id_light_row4, &row_box(scroll_cw, 44.0, 4.0)) or >>
    view.set_style(c.id_light_row5, &row_box(scroll_cw, 44.0, 4.0)) or >>
    view.set_style(c.id_light_row6, &row_box(scroll_cw, 30.0, 4.0)) or >>

    view.set_style(c.id_script_hdr, &leaf_box(scroll_cw, 18.0)) or >>
    view.set_style(c.id_script_row1, &row_box(scroll_cw, 30.0, 4.0)) or >>
    view.set_style(c.id_script_row3, &row_box(scroll_cw, 30.0, 4.0)) or >>

    view.set_style(c.id_audio_hdr, &leaf_box(scroll_cw, 18.0)) or >>
    view.set_style(c.id_audio_row1, &row_box(scroll_cw, 30.0, 4.0)) or >>
    view.set_style(c.id_audio_row2, &row_box(scroll_cw, 44.0, 4.0)) or >>
    view.set_style(c.id_audio_row3, &row_box(scroll_cw, 26.0, 4.0)) or >>
    view.set_style(c.id_audio_row4, &row_box(scroll_cw, 30.0, 4.0)) or >>
    view.set_style(c.id_audio_row5, &row_box(scroll_cw, 30.0, 4.0)) or >>

    view.set_style(c.id_sprite_hdr, &leaf_box(scroll_cw, 18.0)) or >>
    view.set_style(c.id_sprite_row1, &row_box(scroll_cw, 30.0, 4.0)) or >>
    view.set_style(c.id_sprite_row2, &row_box(scroll_cw, 44.0, 4.0)) or >>
    view.set_style(c.id_sprite_row3, &row_box(scroll_cw, 30.0, 4.0)) or >>
    view.set_style(c.id_sprite_row4, &row_box(scroll_cw, 30.0, 4.0)) or >>

    view.set_style(c.id_tilemap_hdr, &leaf_box(scroll_cw, 18.0)) or >>
    view.set_style(c.id_tilemap_info, &leaf_box(scroll_cw, 18.0)) or >>
    view.set_style(c.id_tilemap_row, &row_box(scroll_cw, 30.0, 4.0)) or >>

    view.set_style(c.id_env_hdr, &leaf_box(scroll_cw, 18.0)) or >>
    view.set_style(c.id_env_row1, &row_box(scroll_cw, 30.0, 4.0)) or >>
    view.set_style(c.id_env_row2, &row_box(scroll_cw, 44.0, 4.0)) or >>
    view.set_style(c.id_env_row3, &row_box(scroll_cw, 26.0, 4.0)) or >>
    view.set_style(c.id_env_row4, &row_box(scroll_cw, 30.0, 4.0)) or >>

    view.set_style(c.id_rb_hdr, &leaf_box(scroll_cw, 18.0)) or >>
    view.set_style(c.id_rb_row1, &row_box(scroll_cw, 30.0, 4.0)) or >>
    view.set_style(c.id_rb_row2, &row_box(scroll_cw, 44.0, 4.0)) or >>
    view.set_style(c.id_rb_row3, &row_box(scroll_cw, 30.0, 4.0)) or >>

    view.set_style(c.id_terr_hdr, &leaf_box(scroll_cw, 18.0)) or >>
    view.set_style(c.id_terr_row1, &row_box(scroll_cw, 44.0, 4.0)) or >>
    view.set_style(c.id_terr_row2, &row_box(scroll_cw, 44.0, 4.0)) or >>
    view.set_style(c.id_terr_row3, &row_box(scroll_cw, 30.0, 4.0)) or >>

    view.set_style(c.id_part_hdr, &leaf_box(scroll_cw, 18.0)) or >>
    view.set_style(c.id_part_row1, &row_box(scroll_cw, 44.0, 4.0)) or >>
    view.set_style(c.id_part_row2, &row_box(scroll_cw, 44.0, 4.0)) or >>
    view.set_style(c.id_part_row3, &row_box(scroll_cw, 30.0, 4.0)) or >>

    view.set_style(c.id_prefab_hdr, &leaf_box(scroll_cw, 18.0)) or >>
    view.set_style(c.id_prefab_row1, &row_box(scroll_cw, 30.0, 4.0)) or >>
    view.set_style(c.id_prefab_ov, &row_box(scroll_cw, 44.0, 4.0)) or >>
    view.set_style(c.id_prefab_row2, &row_box(scroll_cw, 30.0, 4.0)) or >>

    for i in 0:c.field_ids.len {
        $w := tri_w
        if c.field_kinds[i] == 1 { w = scroll_cw }
        else if c.field_kinds[i] == 2 { w = half_w }
        view.set_style(c.field_ids[i], &leaf_box(w, 44.0)) or >>
    }
    for i in 0:c.select_ids.len {
        sk := c.select_kinds[i]
        $w := scroll_cw
        if sk == 1 { w = math.max(80.0, scroll_cw * 0.56) }
        else if sk == 2 { w = math.max(60.0, scroll_cw * 0.44 - 4.0) }
        else if sk == 3 { w = math.max(70.0, scroll_cw * 0.44) }
        else if sk == 4 { w = math.max(70.0, scroll_cw * 0.56 - 4.0) }
        else if sk == 5 { w = half_w }
        else if sk == 6 { w = math.max(70.0, scroll_cw - 108.0) }
        view.set_style(c.select_ids[i], &leaf_box(w, 30.0)) or >>
    }
    for i in 0:c.button_ids.len {
        bk := c.button_kinds[i]
        $w := half_w
        if bk == 2 || bk == 3 { w = tri_w }
        else if bk == 4 { w = 104.0 }
        view.set_style(c.button_ids[i], &leaf_box(w, 28.0)) or >>
    }
    for i in 0:c.check_ids.len {
        ck := c.check_kinds[i]
        $w := tri_w
        if ck == 1 { w = half_w }
        view.set_style(c.check_ids[i], &leaf_box(w, 26.0)) or >>
    }
    << 0
}

fn sync_div_bounds(view &widgets.View, id int, d $&widgets.Divider) int {
    b := view.node_bounds(id) or >>
    << d.set_bounds(&layout.Rect{x: 0.0, y: 0.0, width: b.width, height: b.height}) or >>
}

fn sync_chk_bounds(view &widgets.View, id int, chk $&widgets.Checkbox) int {
    b := view.node_bounds(id) or >>
    << chk.set_bounds(&layout.Rect{x: 0.0, y: 0.0, width: b.width, height: b.height}) or >>
}

pub fn place_comp_inspector(c $&ComponentInspector, view &widgets.View, st &widgets.Styles, vh f64, insp_vp &layout.Rect) int {
    for i in 0:c.divs.len {
        did := c.div_ids[i]
        sync_div_bounds(view, did, $&c.divs[i]) or >>
    }
    for i in 0:c.selects.len {
        sid := c.select_ids[i]
        c.select_origins[i] = sync_local_box_select(view, sid, st, vh, $&c.selects[i]) or >>
    }
    for i in 0:c.fields.len {
        fid := c.field_ids[i]
        place_view_field(view, fid, st, insp_vp, $&c.fields[i]) or >>
    }
    for i in 0:c.checks.len {
        cid := c.check_ids[i]
        sync_chk_bounds(view, cid, $&c.checks[i]) or >>
    }
    for i in 0:c.buttons.len {
        bid := c.button_ids[i]
        sync_local_box_button(view, bid, $&c.buttons[i]) or >>
    }
    if c.tilemap_info_txts.len > 0 {
        place_view_text(view, c.id_tilemap_info, insp_vp, $&c.tilemap_info_txts[0]) or >>
    }
    << 0
}

fn replace_select_labels(c $&ComponentInspector, sel_idx int, ctx &draw.Context, project &Project, indices &[]int, empty_txt string) {
    prev := c.selects[sel_idx].selected()
    for i in 0:c.select_labels[sel_idx].len { dispose_label($&c.select_labels[sel_idx][i]) }
    c.select_labels[sel_idx] = make_surface_asset_labels(ctx, project, indices, empty_txt)
    cnt := min_int_val(c.select_labels[sel_idx].len, 64)
    set_sel_count($&c.selects[sel_idx], cnt)
    $next_sel := prev
    if next_sel < 0 || next_sel >= cnt { next_sel = 0 }
    set_sel_selected($&c.selects[sel_idx], next_sel)
}

fn make_scene_prefab_labels(ctx &draw.Context, project &Project, empty_txt string) []widgets.StyledLabel {
    $out := [widgets.styled_label(ctx, &empty_txt)]
    for i in 0:project.scenes.len {
        if out.len >= 64 { <- }
        lbl := project.scenes[i].key + ""
        out.push(widgets.styled_label(ctx, &lbl))
    }
    << out
}

fn find_scene_prefab_pos(project &Project, uid &string) int {
    for i in 0:project.scenes.len {
        if i >= 63 { <- }
        if prefab_uid_for_scene_key(&project.scenes[i].key) == *uid {
            << i + 1
        }
    }
    << 0
}

pub fn refresh_comp_asset_selectors(c $&ComponentInspector, ctx &draw.Context, project &Project, lang int) {
    p_idx := collect_ext_indices(project, ".png")
    w_idx := collect_ext_indices(project, ".wav")
    x_idx := collect_ext_indices(project, ".xubc")
    $s_idx := []int{}
    for i in 0:project.scenes.len { s_idx.push(i) }

    replace_select_labels(c, CS_SCRIPT_ASSET, ctx, project, &x_idx, tr(lang, "(No .xubc)", "(无 .xubc)"))
    replace_select_labels(c, CS_AUDIO_ASSET, ctx, project, &w_idx, tr(lang, "(No .wav)", "(无 .wav)"))
    replace_select_labels(c, CS_SPRITE_ASSET, ctx, project, &p_idx, tr(lang, "(No .png)", "(无 .png)"))
    replace_select_labels(c, CS_TILEMAP_ASSET, ctx, project, &p_idx, tr(lang, "(No .png)", "(无 .png)"))
    pf_prev := c.selects[CS_PREFAB_ASSET].selected()
    for i in 0:c.select_labels[CS_PREFAB_ASSET].len { dispose_label($&c.select_labels[CS_PREFAB_ASSET][i]) }
    c.select_labels[CS_PREFAB_ASSET] = make_scene_prefab_labels(ctx, project, tr(lang, "(No .xuscene)", "(无 .xuscene)"))
    pf_cnt := min_int_val(c.select_labels[CS_PREFAB_ASSET].len, 64)
    set_sel_count($&c.selects[CS_PREFAB_ASSET], pf_cnt)
    $pf_next := pf_prev
    if pf_next < 0 || pf_next >= pf_cnt { pf_next = 0 }
    set_sel_selected($&c.selects[CS_PREFAB_ASSET], pf_next)
    c.png_indices = p_idx
    c.wav_indices = w_idx
    c.xubc_indices = x_idx
    c.scene_indices = s_idx
}

fn find_asset_pos(indices &[]int, project &Project, uid &string) int {
    for i in 0:indices.len {
        ai := indices[i]
        if ai >= 0 && ai < project.assets.len && project.assets[ai].key == *uid {
            << i + 1
        }
    }
    << 0
}

fn enable_chk(chk $&widgets.Checkbox, en bool) {
    chk.set_enabled(en)
}

pub fn sync_comp_inspector(
    c $&ComponentInspector,
    ctx &draw.Context,
    project &Project,
    doc &resource.Document,
    sel_idx int,
    lang int
) {
    nd := doc.describe_node(sel_idx) or (err) { << }
    is_3d := nd.kind == resource.NODE_3D
    is_2d := nd.kind == resource.NODE_2D
    can_cam := is_3d || is_2d
    editable := sel_idx >= 0
    has_xubc := c.xubc_indices.len > 0
    has_wav := c.wav_indices.len > 0
    has_png := c.png_indices.len > 0

    // 1. Camera sync
    set_sel_enabled($&c.selects[CS_CAM_PROJ], can_cam)
    enable_field($&c.fields[CF_CAM_F1], can_cam)
    enable_field($&c.fields[CF_CAM_F2], can_cam)
    enable_field($&c.fields[CF_CAM_F3], can_cam)
    set_btn_enabled($&c.buttons[CB_CAM_APPLY], can_cam)
    set_btn_enabled($&c.buttons[CB_CAM_CLEAR], can_cam && (nd.camera.is_set() || nd.orthographic.is_set() || nd.camera_2d.is_set()))
    if nd.camera.is_set() {
        set_sel_selected($&c.selects[CS_CAM_PROJ], 1)
        deg := nd.camera.vertical_fov() * 180.0 / c.pi_val_cache
        set_field_val($&c.fields[CF_CAM_F1], &fmt_coord(deg))
        set_field_val($&c.fields[CF_CAM_F2], &fmt_coord(nd.camera.near()))
        set_field_val($&c.fields[CF_CAM_F3], &fmt_coord(nd.camera.far()))
    } else if nd.orthographic.is_set() {
        set_sel_selected($&c.selects[CS_CAM_PROJ], 2)
        set_field_val($&c.fields[CF_CAM_F1], &fmt_coord(nd.orthographic.vertical_size()))
        set_field_val($&c.fields[CF_CAM_F2], &fmt_coord(nd.orthographic.near()))
        set_field_val($&c.fields[CF_CAM_F3], &fmt_coord(nd.orthographic.far()))
    } else if nd.camera_2d.is_set() {
        set_sel_selected($&c.selects[CS_CAM_PROJ], 3)
        set_field_val($&c.fields[CF_CAM_F1], &fmt_coord(nd.camera_2d.width()))
        set_field_val($&c.fields[CF_CAM_F2], &fmt_coord(nd.camera_2d.height()))
        set_field_val($&c.fields[CF_CAM_F3], &fmt_coord(nd.camera_2d.zoom()))
    } else {
        set_sel_selected($&c.selects[CS_CAM_PROJ], 0)
        if is_2d {
            set_field_val($&c.fields[CF_CAM_F1], &"1280")
            set_field_val($&c.fields[CF_CAM_F2], &"720")
            set_field_val($&c.fields[CF_CAM_F3], &"1")
        } else {
            set_field_val($&c.fields[CF_CAM_F1], &"60")
            set_field_val($&c.fields[CF_CAM_F2], &"0.1")
            set_field_val($&c.fields[CF_CAM_F3], &"200")
        }
    }

    // 2. Light sync
    $has_light := false
    $l_idx := -1
    for i in 0:doc.light_count() {
        lt := doc.light(i) or (err) { <- }
        if lt.node == sel_idx {
            has_light = true
            l_idx = i
            <-
        }
    }
    set_sel_enabled($&c.selects[CS_LIGHT_KIND], is_3d)
    for fi in CF_LIGHT_R:(CF_LIGHT_SDIST + 1) { enable_field($&c.fields[fi], is_3d) }
    enable_chk($&c.checks[CK_LIGHT_SHADOW], is_3d)
    set_btn_enabled($&c.buttons[CB_LIGHT_APPLY], is_3d)
    set_btn_enabled($&c.buttons[CB_LIGHT_CLEAR], is_3d && has_light)
    if has_light && l_idx >= 0 {
        lt := doc.light(l_idx) or (err) { << }
        k := lt.source.kind()
        if k == light_data.DIRECTIONAL { set_sel_selected($&c.selects[CS_LIGHT_KIND], 1) }
        else if k == light_data.POINT { set_sel_selected($&c.selects[CS_LIGHT_KIND], 2) }
        else { set_sel_selected($&c.selects[CS_LIGHT_KIND], 3) }
        rad := lt.source.radiance()
        set_field_val($&c.fields[CF_LIGHT_R], &fmt_coord(rad.x))
        set_field_val($&c.fields[CF_LIGHT_G], &fmt_coord(rad.y))
        set_field_val($&c.fields[CF_LIGHT_B], &fmt_coord(rad.z))
        set_field_val($&c.fields[CF_LIGHT_RADIUS], &fmt_coord(math.max(lt.source.radius(), 1.0)))
        in_d := math.acos(math.min(1.0, math.max(-1.0, lt.source.inner_cosine()))) * 180.0 / c.pi_val_cache
        out_d := math.acos(math.min(1.0, math.max(-1.0, lt.source.outer_cosine()))) * 180.0 / c.pi_val_cache
        if k != light_data.SPOT {
            set_field_val($&c.fields[CF_LIGHT_IN], &"15")
            set_field_val($&c.fields[CF_LIGHT_OUT], &"35")
        } else {
            set_field_val($&c.fields[CF_LIGHT_IN], &fmt_coord(in_d))
            set_field_val($&c.fields[CF_LIGHT_OUT], &fmt_coord(out_d))
        }
        dir := lt.source.direction()
        if dir.length() < 0.0001 {
            set_field_val($&c.fields[CF_LIGHT_DX], &"0.4")
            set_field_val($&c.fields[CF_LIGHT_DY], &"0.72")
            set_field_val($&c.fields[CF_LIGHT_DZ], &"0.4")
        } else {
            set_field_val($&c.fields[CF_LIGHT_DX], &fmt_coord(dir.x))
            set_field_val($&c.fields[CF_LIGHT_DY], &fmt_coord(dir.y))
            set_field_val($&c.fields[CF_LIGHT_DZ], &fmt_coord(dir.z))
        }
        sh_on := lt.cascades.enabled() || lt.punctual.enabled()
        set_chk_val($&c.checks[CK_LIGHT_SHADOW], sh_on)
        if lt.cascades.enabled() {
            cs := lt.cascades.settings() or (err) { << }
            set_field_val($&c.fields[CF_LIGHT_SRES], &str(cs.resolution))
            set_field_val($&c.fields[CF_LIGHT_SDIST], &fmt_coord(cs.distance))
        } else if lt.punctual.enabled() {
            ps := lt.punctual.settings() or (err) { << }
            set_field_val($&c.fields[CF_LIGHT_SRES], &str(ps.resolution))
            set_field_val($&c.fields[CF_LIGHT_SDIST], &"80")
        } else {
            set_field_val($&c.fields[CF_LIGHT_SRES], &"512")
            set_field_val($&c.fields[CF_LIGHT_SDIST], &"80")
        }
    } else {
        set_sel_selected($&c.selects[CS_LIGHT_KIND], 0)
        set_field_val($&c.fields[CF_LIGHT_R], &"2.5")
        set_field_val($&c.fields[CF_LIGHT_G], &"2.4")
        set_field_val($&c.fields[CF_LIGHT_B], &"2.2")
        set_field_val($&c.fields[CF_LIGHT_RADIUS], &"12")
        set_field_val($&c.fields[CF_LIGHT_IN], &"15")
        set_field_val($&c.fields[CF_LIGHT_OUT], &"35")
        set_field_val($&c.fields[CF_LIGHT_DX], &"0.4")
        set_field_val($&c.fields[CF_LIGHT_DY], &"0.72")
        set_field_val($&c.fields[CF_LIGHT_DZ], &"0.4")
        set_chk_val($&c.checks[CK_LIGHT_SHADOW], false)
        set_field_val($&c.fields[CF_LIGHT_SRES], &"512")
        set_field_val($&c.fields[CF_LIGHT_SDIST], &"80")
    }

    // 3. Script sync
    $has_scr := false
    $sc_idx := -1
    for i in 0:doc.script_count() {
        sc := doc.script(i) or (err) { <- }
        if sc.node == sel_idx {
            has_scr = true
            sc_idx = i
            <-
        }
    }
    set_sel_enabled($&c.selects[CS_SCRIPT_ASSET], editable)
    enable_field($&c.fields[CF_SCRIPT_INIT], editable)
    set_btn_enabled($&c.buttons[CB_SCRIPT_APPLY], editable && has_xubc)
    set_btn_enabled($&c.buttons[CB_SCRIPT_CLEAR], editable && has_scr)
    if has_scr && sc_idx >= 0 {
        sc := doc.script(sc_idx) or (err) { << }
        sc_pos := find_asset_pos(&c.xubc_indices, project, &sc.resource_uid)
        set_sel_selected($&c.selects[CS_SCRIPT_ASSET], sc_pos)
        set_field_val($&c.fields[CF_SCRIPT_INIT], &format_script_initials(&sc.initial))
    } else {
        set_sel_selected($&c.selects[CS_SCRIPT_ASSET], 0)
        set_field_val($&c.fields[CF_SCRIPT_INIT], &"")
    }

    // 4. Audio sync (buses & listener candidates dynamic per doc)
    for i in 0:c.select_labels[CS_AUDIO_BUS].len { dispose_label($&c.select_labels[CS_AUDIO_BUS][i]) }
    c.select_labels[CS_AUDIO_BUS] = []widgets.StyledLabel{}
    if doc.audio_bus_count() == 0 {
        c.select_labels[CS_AUDIO_BUS].push(widgets.styled_label(ctx, &"Master"))
        set_sel_count($&c.selects[CS_AUDIO_BUS], 1)
    } else {
        bn := min_int_val(doc.audio_bus_count(), 16)
        for i in 0:bn {
            b := doc.audio_bus(i) or (err) { <- }
            c.select_labels[CS_AUDIO_BUS].push(widgets.styled_label(ctx, &b.name))
        }
        bus_cnt := c.select_labels[CS_AUDIO_BUS].len
        set_sel_count($&c.selects[CS_AUDIO_BUS], bus_cnt)
    }

    for i in 0:c.select_labels[CS_AUDIO_LISTENER].len { dispose_label($&c.select_labels[CS_AUDIO_LISTENER][i]) }
    lst_none := tr(lang, "Listener: None", "监听者: 无")
    c.select_labels[CS_AUDIO_LISTENER] = [widgets.styled_label(ctx, &lst_none)]
    c.listener_candidates = [-1]
    for i in 0:doc.node_count() {
        ln := doc.describe_node(i) or (err) { <- }
        if ln.kind == resource.NODE_3D || ln.kind == resource.NODE_2D {
            lbl_s := str(i) + ": " + ln.name
            c.listener_candidates.push(i)
            c.select_labels[CS_AUDIO_LISTENER].push(widgets.styled_label(ctx, &lbl_s))
            if c.listener_candidates.len >= 64 { <- }
        }
    }
    lst_cnt := c.select_labels[CS_AUDIO_LISTENER].len
    set_sel_count($&c.selects[CS_AUDIO_LISTENER], lst_cnt)

    $has_au := false
    $au_idx := -1
    for i in 0:doc.audio_count() {
        au := doc.audio_emitter(i) or (err) { <- }
        if au.node == sel_idx {
            has_au = true
            au_idx = i
            <-
        }
    }
    set_sel_enabled($&c.selects[CS_AUDIO_ASSET], editable)
    set_sel_enabled($&c.selects[CS_AUDIO_BUS], editable)
    enable_field($&c.fields[CF_AUDIO_VOL], editable)
    enable_field($&c.fields[CF_AUDIO_PAN], editable)
    enable_field($&c.fields[CF_AUDIO_DIST], editable)
    enable_chk($&c.checks[CK_AUDIO_LOOP], editable)
    enable_chk($&c.checks[CK_AUDIO_AUTO], editable)
    set_sel_enabled($&c.selects[CS_AUDIO_SPATIAL], editable)
    set_sel_enabled($&c.selects[CS_AUDIO_LISTENER], editable)
    set_btn_enabled($&c.buttons[CB_AUDIO_APPLY], editable && has_wav)
    set_btn_enabled($&c.buttons[CB_AUDIO_CLEAR], editable && has_au)
    if has_au && au_idx >= 0 {
        au := doc.audio_emitter(au_idx) or (err) { << }
        au_pos := find_asset_pos(&c.wav_indices, project, &au.resource_uid)
        set_sel_selected($&c.selects[CS_AUDIO_ASSET], au_pos)
        bus_sel := min_int_val(au.bus, c.select_labels[CS_AUDIO_BUS].len - 1)
        set_sel_selected($&c.selects[CS_AUDIO_BUS], bus_sel)
        set_field_val($&c.fields[CF_AUDIO_VOL], &fmt_coord(au.volume))
        set_field_val($&c.fields[CF_AUDIO_PAN], &fmt_coord(au.pan))
        set_field_val($&c.fields[CF_AUDIO_DIST], &fmt_coord(au.max_distance))
        set_chk_val($&c.checks[CK_AUDIO_LOOP], au.looping)
        set_chk_val($&c.checks[CK_AUDIO_AUTO], au.autoplay)
        $sp_idx := 0
        if au.spatial == "2d" { sp_idx = 1 }
        else if au.spatial == "3d" { sp_idx = 2 }
        set_sel_selected($&c.selects[CS_AUDIO_SPATIAL], sp_idx)
        $li_pos := 0
        for i in 0:c.listener_candidates.len {
            if c.listener_candidates[i] == au.listener {
                li_pos = i
                <-
            }
        }
        set_sel_selected($&c.selects[CS_AUDIO_LISTENER], li_pos)
    } else {
        set_sel_selected($&c.selects[CS_AUDIO_ASSET], 0)
        set_sel_selected($&c.selects[CS_AUDIO_BUS], 0)
        set_field_val($&c.fields[CF_AUDIO_VOL], &"1")
        set_field_val($&c.fields[CF_AUDIO_PAN], &"0")
        set_field_val($&c.fields[CF_AUDIO_DIST], &"0")
        set_chk_val($&c.checks[CK_AUDIO_LOOP], false)
        set_chk_val($&c.checks[CK_AUDIO_AUTO], false)
        set_sel_selected($&c.selects[CS_AUDIO_SPATIAL], 0)
        set_sel_selected($&c.selects[CS_AUDIO_LISTENER], 0)
    }

    // 5. Sprite3D sync
    $has_sp := false
    $sp_idx := -1
    for i in 0:doc.sprite_3d_count() {
        sp := doc.sprite_3d(i) or (err) { <- }
        if sp.node == sel_idx {
            has_sp = true
            sp_idx = i
            <-
        }
    }
    set_sel_enabled($&c.selects[CS_SPRITE_ASSET], is_3d)
    enable_field($&c.fields[CF_SPRITE_W], is_3d)
    enable_field($&c.fields[CF_SPRITE_H], is_3d)
    enable_field($&c.fields[CF_SPRITE_CUT], is_3d)
    set_sel_enabled($&c.selects[CS_SPRITE_BB], is_3d)
    set_sel_enabled($&c.selects[CS_SPRITE_ALPHA], is_3d)
    enable_chk($&c.checks[CK_SPRITE_SHADED], is_3d)
    set_btn_enabled($&c.buttons[CB_SPRITE_APPLY], is_3d && has_png)
    set_btn_enabled($&c.buttons[CB_SPRITE_CLEAR], is_3d && has_sp)
    if has_sp && sp_idx >= 0 {
        sp := doc.sprite_3d(sp_idx) or (err) { << }
        sp_pos := find_asset_pos(&c.png_indices, project, &sp.resource_uid)
        set_sel_selected($&c.selects[CS_SPRITE_ASSET], sp_pos)
        set_field_val($&c.fields[CF_SPRITE_W], &fmt_coord(sp.sprite.size.x))
        set_field_val($&c.fields[CF_SPRITE_H], &fmt_coord(sp.sprite.size.y))
        set_field_val($&c.fields[CF_SPRITE_CUT], &fmt_coord(sp.sprite.alpha_cutoff))
        set_sel_selected($&c.selects[CS_SPRITE_BB], min_int_val(sp.sprite.billboard, 2))
        set_sel_selected($&c.selects[CS_SPRITE_ALPHA], min_int_val(sp.sprite.alpha_mode, 1))
        set_chk_val($&c.checks[CK_SPRITE_SHADED], sp.sprite.shaded)
    } else {
        set_sel_selected($&c.selects[CS_SPRITE_ASSET], 0)
        set_field_val($&c.fields[CF_SPRITE_W], &"1")
        set_field_val($&c.fields[CF_SPRITE_H], &"1")
        set_field_val($&c.fields[CF_SPRITE_CUT], &"0.5")
        set_sel_selected($&c.selects[CS_SPRITE_BB], 2)
        set_sel_selected($&c.selects[CS_SPRITE_ALPHA], 1)
        set_chk_val($&c.checks[CK_SPRITE_SHADED], true)
    }

    // 6. TileMap2D sync
    $has_tm := false
    $tm_txt := tr(lang, "TileMap2D: select a Node2D", "TileMap2D：请选择 Node2D")
    if is_2d {
        tm_txt = tr(lang, "TileMap2D: none attached (choose PNG + click TileMap Editor)", "TileMap2D：未绑定（选择 PNG 后点击瓦片编辑器）")
    }
    $tm_uid := ""
    for i in 0:doc.tilemap_2d_count() {
        tm := doc.tilemap_2d(i) or (err) { <- }
        if tm.node == sel_idx {
            has_tm = true
            tm_uid = tm.resource_uid + ""
            aname := asset_name_for_uid(project, &tm_uid)
            tm_txt = tr(lang, "TileMap2D: ", "瓦片地图: ") + str(tm.grid.width) + "x" + str(tm.grid.height) + " · " + aname
            <-
        }
    }
    set_text_val($&c.tilemap_info_txts[0], &tm_txt)
    set_sel_enabled($&c.selects[CS_TILEMAP_ASSET], is_2d)
    set_btn_enabled($&c.buttons[CB_TILEMAP_EDIT], is_2d && (has_tm || has_png))
    if has_tm {
        tm_pos := find_asset_pos(&c.png_indices, project, &tm_uid)
        set_sel_selected($&c.selects[CS_TILEMAP_ASSET], tm_pos)
    } else {
        set_sel_selected($&c.selects[CS_TILEMAP_ASSET], 0)
    }

    // 7. Environment sync (v9)
    $has_env := false
    $env_idx := -1
    for i in 0:doc.environment_count() {
        ev := doc.environment(i) or (err) { <- }
        if ev.node == sel_idx {
            has_env = true
            env_idx = i
            <-
        }
    }
    set_sel_enabled($&c.selects[CS_ENV_SKY], is_3d)
    enable_field($&c.fields[CF_ENV_SUN], is_3d)
    enable_field($&c.fields[CF_ENV_EXP], is_3d)
    enable_field($&c.fields[CF_ENV_FOG], is_3d)
    enable_chk($&c.checks[CK_ENV_BLOOM], is_3d)
    enable_chk($&c.checks[CK_ENV_GTAO], is_3d)
    enable_chk($&c.checks[CK_ENV_DDGI], is_3d)
    set_btn_enabled($&c.buttons[CB_ENV_APPLY], is_3d)
    set_btn_enabled($&c.buttons[CB_ENV_CLEAR], is_3d && has_env)
    if has_env && env_idx >= 0 {
        ev := doc.environment(env_idx) or (err) { << }
        set_sel_selected($&c.selects[CS_ENV_SKY], min_int_val(ev.sky_mode, 1))
        set_field_val($&c.fields[CF_ENV_SUN], &fmt_coord(ev.sun_intensity))
        set_field_val($&c.fields[CF_ENV_EXP], &fmt_coord(ev.exposure))
        set_field_val($&c.fields[CF_ENV_FOG], &fmt_coord(ev.fog_density))
        set_chk_val($&c.checks[CK_ENV_BLOOM], ev.bloom_enabled)
        set_chk_val($&c.checks[CK_ENV_GTAO], ev.gtao_enabled)
        set_chk_val($&c.checks[CK_ENV_DDGI], ev.ddgi_enabled)
    } else {
        set_sel_selected($&c.selects[CS_ENV_SKY], 1)
        set_field_val($&c.fields[CF_ENV_SUN], &"2.2")
        set_field_val($&c.fields[CF_ENV_EXP], &"1")
        set_field_val($&c.fields[CF_ENV_FOG], &"0.012")
        set_chk_val($&c.checks[CK_ENV_BLOOM], true)
        set_chk_val($&c.checks[CK_ENV_GTAO], true)
        set_chk_val($&c.checks[CK_ENV_DDGI], true)
    }

    // 8. RigidBody3D sync (v9)
    $has_rb := false
    $rb_idx := -1
    for i in 0:doc.rigid_body_3d_count() {
        rb := doc.rigid_body_3d(i) or (err) { <- }
        if rb.node == sel_idx {
            has_rb = true
            rb_idx = i
            <-
        }
    }
    set_sel_enabled($&c.selects[CS_RB_TYPE], is_3d)
    set_sel_enabled($&c.selects[CS_RB_SHAPE], is_3d)
    enable_field($&c.fields[CF_RB_MASS], is_3d)
    enable_field($&c.fields[CF_RB_REST], is_3d)
    enable_field($&c.fields[CF_RB_FRIC], is_3d)
    enable_chk($&c.checks[CK_RB_TRIGGER], is_3d)
    set_btn_enabled($&c.buttons[CB_RB_APPLY], is_3d)
    set_btn_enabled($&c.buttons[CB_RB_CLEAR], is_3d && has_rb)
    if has_rb && rb_idx >= 0 {
        rb := doc.rigid_body_3d(rb_idx) or (err) { << }
        set_sel_selected($&c.selects[CS_RB_TYPE], min_int_val(rb.body_type, 2))
        set_sel_selected($&c.selects[CS_RB_SHAPE], min_int_val(rb.shape_kind, 3))
        set_field_val($&c.fields[CF_RB_MASS], &fmt_coord(rb.mass))
        set_field_val($&c.fields[CF_RB_REST], &fmt_coord(rb.restitution))
        set_field_val($&c.fields[CF_RB_FRIC], &fmt_coord(rb.friction))
        set_chk_val($&c.checks[CK_RB_TRIGGER], rb.is_trigger)
    } else {
        set_sel_selected($&c.selects[CS_RB_TYPE], 2)
        set_sel_selected($&c.selects[CS_RB_SHAPE], 0)
        set_field_val($&c.fields[CF_RB_MASS], &"1")
        set_field_val($&c.fields[CF_RB_REST], &"0.2")
        set_field_val($&c.fields[CF_RB_FRIC], &"0.6")
        set_chk_val($&c.checks[CK_RB_TRIGGER], false)
    }

    // 9. Terrain sync (v9)
    $has_terr := false
    $terr_idx := -1
    for i in 0:doc.terrain_count() {
        trr := doc.terrain(i) or (err) { <- }
        if trr.node == sel_idx {
            has_terr = true
            terr_idx = i
            <-
        }
    }
    enable_field($&c.fields[CF_TERR_GRID], is_3d)
    enable_field($&c.fields[CF_TERR_CELL], is_3d)
    enable_field($&c.fields[CF_TERR_HEIGHT], is_3d)
    enable_field($&c.fields[CF_TERR_FOL], is_3d)
    set_btn_enabled($&c.buttons[CB_TERR_APPLY], is_3d)
    set_btn_enabled($&c.buttons[CB_TERR_CLEAR], is_3d && has_terr)
    if has_terr && terr_idx >= 0 {
        trr := doc.terrain(terr_idx) or (err) { << }
        set_field_val($&c.fields[CF_TERR_GRID], &str(trr.grid_x))
        set_field_val($&c.fields[CF_TERR_CELL], &fmt_coord(trr.cell_size))
        set_field_val($&c.fields[CF_TERR_HEIGHT], &fmt_coord(trr.height_scale))
        set_field_val($&c.fields[CF_TERR_FOL], &fmt_coord(trr.foliage_density))
    } else {
        set_field_val($&c.fields[CF_TERR_GRID], &"33")
        set_field_val($&c.fields[CF_TERR_CELL], &"1")
        set_field_val($&c.fields[CF_TERR_HEIGHT], &"1")
        set_field_val($&c.fields[CF_TERR_FOL], &"0.75")
    }

    // 10. ParticleEmitter3D sync (v9)
    $has_part := false
    $part_idx := -1
    for i in 0:doc.particle_emitter_3d_count() {
        pt := doc.particle_emitter_3d(i) or (err) { <- }
        if pt.node == sel_idx {
            has_part = true
            part_idx = i
            <-
        }
    }
    enable_field($&c.fields[CF_PART_MAX], is_3d)
    enable_field($&c.fields[CF_PART_RATE], is_3d)
    enable_field($&c.fields[CF_PART_LIFE], is_3d)
    enable_field($&c.fields[CF_PART_SPD], is_3d)
    enable_field($&c.fields[CF_PART_SIZE], is_3d)
    enable_chk($&c.checks[CK_PART_ADD], is_3d)
    set_btn_enabled($&c.buttons[CB_PART_APPLY], is_3d)
    set_btn_enabled($&c.buttons[CB_PART_CLEAR], is_3d && has_part)
    if has_part && part_idx >= 0 {
        pt := doc.particle_emitter_3d(part_idx) or (err) { << }
        set_field_val($&c.fields[CF_PART_MAX], &str(pt.max_particles))
        set_field_val($&c.fields[CF_PART_RATE], &fmt_coord(pt.spawn_rate))
        set_field_val($&c.fields[CF_PART_LIFE], &fmt_coord(pt.lifetime))
        set_field_val($&c.fields[CF_PART_SPD], &fmt_coord(pt.speed))
        set_field_val($&c.fields[CF_PART_SIZE], &fmt_coord(pt.size))
        set_chk_val($&c.checks[CK_PART_ADD], pt.additive)
    } else {
        set_field_val($&c.fields[CF_PART_MAX], &"256")
        set_field_val($&c.fields[CF_PART_RATE], &"48")
        set_field_val($&c.fields[CF_PART_LIFE], &"1.5")
        set_field_val($&c.fields[CF_PART_SPD], &"2.5")
        set_field_val($&c.fields[CF_PART_SIZE], &"0.25")
        set_chk_val($&c.checks[CK_PART_ADD], true)
    }

    // 11. PrefabInstance sync (v9)
    has_scenes := project.scenes.len > 0
    $has_pf := false
    $pf_idx := -1
    for i in 0:doc.prefab_instance_count() {
        pf := doc.prefab_instance(i) or (err) { <- }
        if pf.node == sel_idx {
            has_pf = true
            pf_idx = i
            <-
        }
    }
    set_sel_enabled($&c.selects[CS_PREFAB_ASSET], editable)
    enable_field($&c.fields[CF_PREFAB_OV], editable)
    enable_chk($&c.checks[CK_PREFAB_VIS], editable)
    set_btn_enabled($&c.buttons[CB_PREFAB_APPLY], editable && has_scenes)
    set_btn_enabled($&c.buttons[CB_PREFAB_CLEAR], editable && has_pf)
    if has_pf && pf_idx >= 0 {
        pf := doc.prefab_instance(pf_idx) or (err) { << }
        pf_pos := find_scene_prefab_pos(project, &pf.scene_uid)
        set_sel_selected($&c.selects[CS_PREFAB_ASSET], pf_pos)
        if pf.overrides.len > 0 {
            set_field_val($&c.fields[CF_PREFAB_OV], &pf.overrides[0].target_path)
            set_chk_val($&c.checks[CK_PREFAB_VIS], pf.overrides[0].visible)
        } else {
            set_field_val($&c.fields[CF_PREFAB_OV], &"")
            set_chk_val($&c.checks[CK_PREFAB_VIS], true)
        }
    } else {
        set_sel_selected($&c.selects[CS_PREFAB_ASSET], 0)
        set_field_val($&c.fields[CF_PREFAB_OV], &"")
        set_chk_val($&c.checks[CK_PREFAB_VIS], true)
    }
}

pub fn draw_comp_node(c $&ComponentInspector, id int, frame $&draw.Frame, styles &widgets.Styles, pal &PaperPalette, lang int) bool {
    if id == c.id_cam_hdr {
        t := tr(lang, "Camera", "相机")
        frame.text(0.0, 2.0, 12.0, pal.text, &t) or >>
        << true
    }
    if id == c.id_light_hdr {
        t := tr(lang, "Light & Shadow", "光照与阴影")
        frame.text(0.0, 2.0, 12.0, pal.text, &t) or >>
        << true
    }
    if id == c.id_script_hdr {
        t := tr(lang, "Script (.xubc)", "脚本 (.xubc)")
        frame.text(0.0, 2.0, 12.0, pal.text, &t) or >>
        << true
    }
    if id == c.id_audio_hdr {
        t := tr(lang, "Audio Emitter (.wav)", "音频发射器 (.wav)")
        frame.text(0.0, 2.0, 12.0, pal.text, &t) or >>
        << true
    }
    if id == c.id_sprite_hdr {
        t := tr(lang, "Sprite3D (.png)", "3D 精灵 (.png)")
        frame.text(0.0, 2.0, 12.0, pal.text, &t) or >>
        << true
    }
    if id == c.id_tilemap_hdr {
        t := tr(lang, "TileMap2D (.png)", "2D 瓦片地图 (.png)")
        frame.text(0.0, 2.0, 12.0, pal.text, &t) or >>
        << true
    }
    if id == c.id_env_hdr {
        t := tr(lang, "Environment (v9)", "环境与后处理 (v9)")
        frame.text(0.0, 2.0, 12.0, pal.text, &t) or >>
        << true
    }
    if id == c.id_rb_hdr {
        t := tr(lang, "RigidBody3D (v9)", "3D 刚体碰撞 (v9)")
        frame.text(0.0, 2.0, 12.0, pal.text, &t) or >>
        << true
    }
    if id == c.id_terr_hdr {
        t := tr(lang, "Terrain (v9)", "地形网格 (v9)")
        frame.text(0.0, 2.0, 12.0, pal.text, &t) or >>
        << true
    }
    if id == c.id_part_hdr {
        t := tr(lang, "ParticleEmitter3D (v9)", "3D 粒子发射器 (v9)")
        frame.text(0.0, 2.0, 12.0, pal.text, &t) or >>
        << true
    }
    if id == c.id_prefab_hdr {
        t := tr(lang, "PrefabInstance (.xuscene v9)", "预制体实例 (.xuscene v9)")
        frame.text(0.0, 2.0, 12.0, pal.text, &t) or >>
        << true
    }
    if id == c.id_tilemap_info && c.tilemap_info_txts.len > 0 {
        paint_text_sel($&c.tilemap_info_txts[0], frame, styles) or >>
        << true
    }
    for i in 0:c.div_ids.len {
        if id == c.div_ids[i] {
            c.divs[i].paint_styled(frame, styles) or >>
            << true
        }
    }
    for i in 0:c.field_ids.len {
        if id == c.field_ids[i] {
            paint_field($&c.fields[i], frame, styles) or >>
            << true
        }
    }
    for i in 0:c.select_ids.len {
        if id == c.select_ids[i] {
            s := c.selects[i].clone()
            sel := s.selected()
            if sel >= 0 && sel < c.select_labels[i].len {
                s.paint_styled(frame, $&c.select_labels[i][sel], styles) or >>
            } else {
                s.paint_styled(frame, $&c.empty_lbl, styles) or >>
            }
            << true
        }
    }
    for i in 0:c.button_ids.len {
        if id == c.button_ids[i] {
            b := c.buttons[i].clone()
            b.paint_styled(frame, $&c.button_labels[i], styles) or >>
            << true
        }
    }
    for i in 0:c.check_ids.len {
        if id == c.check_ids[i] {
            chk := c.checks[i].clone()
            chk.paint_styled(frame, $&c.check_labels[i], styles) or >>
            << true
        }
    }
    << false
}

pub fn draw_comp_overlay(c $&ComponentInspector, frame $&draw.Frame, styles &widgets.Styles) int {
    for i in 0:c.selects.len {
        s := c.selects[i].clone()
        orig := copy_rect(&c.select_origins[i])
        paint_select_popup(&s, $&c.select_labels[i], &orig, frame, styles) or >>
    }
    for i in 0:c.fields.len {
        field_popup_paint($&c.fields[i], frame, styles) or >>
    }
    if c.tilemap_info_txts.len > 0 {
        paint_text_popup($&c.tilemap_info_txts[0], frame, styles) or >>
    }
    << 0
}

pub fn comp_close_selects(c $&ComponentInspector) {
    for i in 0:c.selects.len {
        set_sel_open($&c.selects[i], false)
    }
}

pub fn route_comp_input(c $&ComponentInspector, id int, kind int, input &ui.InputEvent) widgets.Action {
    for i in 0:c.select_ids.len { if id == c.select_ids[i] { << route_sel($&c.selects[i], kind, input) } }
    for i in 0:c.field_ids.len { if id == c.field_ids[i] { << route_field($&c.fields[i], kind, input) } }
    for i in 0:c.button_ids.len { if id == c.button_ids[i] { << route_btn($&c.buttons[i], kind, input) } }
    for i in 0:c.check_ids.len { if id == c.check_ids[i] { << route_chk($&c.checks[i], kind, input) } }
    if id == c.id_tilemap_info && c.tilemap_info_txts.len > 0 {
        << route_text($&c.tilemap_info_txts[0], kind, input)
    }
    << widgets.no_action(id, false)
}

fn check_open_sel(sel $&widgets.Select, orig &layout.Rect, input &ui.InputEvent, rid int, view $&widgets.View) bool {
    if !sel.is_open() { << false }
    o := copy_rect(orig)
    act := route_open_select(sel, &o, input)
    if act.consumed || (input.kind == ui.EV_KEY_DOWN && input.key == ui.KEY_ESCAPE) {
        set_sel_open(sel, false)
        repaint(view, rid)
        << true
    }
    << false
}

pub fn comp_route_open_selects(ed $&Editor, input &ui.InputEvent, view $&widgets.View) bool {
    rid := ed.id_root
    c := $&ed.comp
    for i in 0:c.selects.len {
        orig := copy_rect(&c.select_origins[i])
        if check_open_sel($&c.selects[i], &orig, input, rid, view) { << true }
    }
    << false
}

fn check_popup_field(view $&widgets.View, rid int, input &ui.InputEvent, f $&widgets.Field) bool {
    << route_popup_field(view, rid, input, f) or (err) {
        _ := err
        << false
    }
}

fn check_popup_text(view $&widgets.View, rid int, input &ui.InputEvent, s $&widgets.SelectableText) bool {
    << route_popup_text(view, rid, input, s) or (err) {
        _ := err
        << false
    }
}

pub fn comp_route_context_popups(c $&ComponentInspector, view $&widgets.View, rid int, input &ui.InputEvent) bool {
    for i in 0:c.fields.len {
        if check_popup_field(view, rid, input, $&c.fields[i]) { << true }
    }
    if c.tilemap_info_txts.len > 0 {
        if check_popup_text(view, rid, input, $&c.tilemap_info_txts[0]) { << true }
    }
    << false
}

fn dispatch_comp_field(view $&widgets.View, rid int, event &ui.Event, f $&widgets.Field) {
    _ := dispatch_field_text_event(view, rid, event, f) or (err) {
        _ := err
        <<
    }
}

fn dispatch_comp_text(view $&widgets.View, event &ui.Event, s $&widgets.SelectableText) {
    _ := dispatch_sel_text_event(view, event, s) or (err) {
        _ := err
        <<
    }
}

pub fn comp_dispatch_text_or_request(c $&ComponentInspector, view $&widgets.View, rid int, event &ui.Event) {
    for i in 0:c.fields.len {
        dispatch_comp_field(view, rid, event, $&c.fields[i])
    }
    if c.tilemap_info_txts.len > 0 {
        dispatch_comp_text(view, event, $&c.tilemap_info_txts[0])
    }
}

pub fn comp_any_focused(c &ComponentInspector) bool {
    for i in 0:c.fields.len {
        if c.fields[i].is_focused() { << true }
    }
    << false
}

pub fn comp_blur_all(c $&ComponentInspector) {
    for i in 0:c.fields.len {
        focus_field($&c.fields[i], false)
    }
}

pub fn comp_tick(c $&ComponentInspector, view $&widgets.View, now time.Instant, rm bool) {
    for i in 0:c.fields.len {
        fid := c.field_ids[i]
        if tick_field($&c.fields[i], now, rm) { repaint(view, fid) }
    }
}

pub fn comp_next_tick(c &ComponentInspector, now time.Instant, rm bool, cur time.Instant) time.Instant {
    $deadline := cur
    for i in 0:c.fields.len {
        next := field_next_tick(&c.fields[i], now, rm)
        if !next.is_zero() && (deadline.is_zero() || next.before(deadline)) {
            deadline = next
        }
    }
    << deadline
}

pub fn comp_has_any_popup_open(c &ComponentInspector) bool {
    for i in 0:c.selects.len {
        if c.selects[i].is_open() { << true }
    }
    for i in 0:c.fields.len {
        if c.fields[i].has_popup_open() { << true }
    }
    if c.tilemap_info_txts.len > 0 && c.tilemap_info_txts[0].has_popup_open() { << true }
    << false
}

pub fn comp_cursor(c &ComponentInspector, view &widgets.View, styles &widgets.Styles, x f64, y f64) int {
    _ := styles
    for i in 0:c.selects.len {
        if c.selects[i].is_open() {
            orig := &c.select_origins[i]
            << c.selects[i].cursor_at(x - orig.x, y - orig.y)
        }
    }
    for i in 0:c.fields.len {
        pc := field_popup_cursor(&c.fields[i], x, y)
        if pc >= 0 { << pc }
    }
    if c.tilemap_info_txts.len > 0 {
        tc := text_popup_cursor(&c.tilemap_info_txts[0], x, y)
        if tc >= 0 { << tc }
    }
    for i in 0:c.fields.len {
        fc := field_hit_cursor(view, c.field_ids[i], &c.fields[i], x, y)
        if fc >= 0 { << fc }
    }
    if c.tilemap_info_txts.len > 0 && node_contains(view, c.id_tilemap_info, x, y) {
        << c.tilemap_info_txts[0].cursor_at(x, y)
    }
    for i in 0:c.selects.len {
        sc := sel_hit_cursor(view, c.select_ids[i], &c.selects[i], x, y)
        if sc >= 0 { << sc }
    }
    for i in 0:c.buttons.len {
        bc := btn_hit_cursor(view, c.button_ids[i], &c.buttons[i], x, y)
        if bc >= 0 { << bc }
    }
    for i in 0:c.checks.len {
        if node_contains(view, c.check_ids[i], x, y) {
            << c.checks[i].cursor()
        }
    }
    << -1
}

