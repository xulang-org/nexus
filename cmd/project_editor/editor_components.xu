pub struct ComponentInspector {
    pub png_indices []int
    pub wav_indices []int
    pub xubc_indices []int
    pub scene_indices []int
    pub listener_candidates []int
    pub pi_val_cache f64

    // Layout node IDs preserved for external scroll extent / container styling
    pub id_cam_div int
    pub id_cam_hdr int
    pub id_cam_row1 int
    pub id_cam_row2 int
    pub id_cam_row3 int

    pub id_light_div int
    pub id_light_hdr int
    pub id_light_row1 int
    pub id_light_row2 int
    pub id_light_row3 int
    pub id_light_row4 int
    pub id_light_row5 int
    pub id_light_row6 int

    pub id_script_div int
    pub id_script_hdr int
    pub id_script_row1 int
    pub id_script_row3 int

    pub id_audio_div int
    pub id_audio_hdr int
    pub id_audio_row1 int
    pub id_audio_row2 int
    pub id_audio_row3 int
    pub id_audio_row4 int
    pub id_audio_row5 int

    pub id_sprite_div int
    pub id_sprite_hdr int
    pub id_sprite_row1 int
    pub id_sprite_row2 int
    pub id_sprite_row3 int
    pub id_sprite_row4 int

    pub id_tilemap_div int
    pub id_tilemap_hdr int
    pub id_tilemap_info int
    pub id_tilemap_row int

    pub id_env_div int
    pub id_env_hdr int
    pub id_env_row1 int
    pub id_env_row2 int
    pub id_env_row3 int
    pub id_env_row4 int

    pub id_rb_div int
    pub id_rb_hdr int
    pub id_rb_row1 int
    pub id_rb_row2 int
    pub id_rb_row3 int

    pub id_terr_div int
    pub id_terr_hdr int
    pub id_terr_row1 int
    pub id_terr_row2 int
    pub id_terr_row3 int

    pub id_part_div int
    pub id_part_hdr int
    pub id_part_row1 int
    pub id_part_row2 int
    pub id_part_row3 int

    pub id_prefab_div int
    pub id_prefab_hdr int
    pub id_prefab_row1 int
    pub id_prefab_ov int
    pub id_prefab_row2 int

    // Heap-backed widget slices (keeps sizeof(ComponentInspector) and worker stacks small)
    pub fields []widgets.Field
    pub field_ids []int
    pub field_kinds []int

    pub selects []widgets.Select
    pub select_ids []int
    pub select_kinds []int
    pub select_origins []layout.Rect
    pub select_labels [][]widgets.StyledLabel

    pub buttons []widgets.Button
    pub button_ids []int
    pub button_kinds []int
    pub button_labels []widgets.StyledLabel

    pub checks []widgets.Checkbox
    pub check_ids []int
    pub check_kinds []int
    pub check_labels []widgets.StyledLabel

    pub divs []widgets.Divider
    pub div_ids []int

    pub tilemap_info_txts []widgets.SelectableText
    pub empty_lbl widgets.StyledLabel
}

pub fn collect_ext_indices(project &Project, ext_dot string) []int {
    want := strings.to_lower(&ext_dot)
    $out := []int{}
    for i in 0:project.assets.len {
        ext := strings.to_lower(&filepath.ext(&project.assets[i].path))
        if ext == want {
            out.push(i)
        }
    }
    << out
}

fn make_styled_labels(context &draw.Context, names &[]string) []widgets.StyledLabel {
    $out := []widgets.StyledLabel{}
    for i in 0:names.len {
        nm := names[i] + ""
        out.push(widgets.styled_label(context, &nm))
    }
    << out
}

fn push_comp_field(
    c $&ComponentInspector,
    view $&widgets.View,
    parent int,
    w f64,
    kind int,
    ctx &draw.Context,
    id_ev &ui.CanvasEvent,
    label string,
    val string
) int {
    nid := add_interactive(view, parent, &leaf_box(w, 44.0), ui.CURSOR_TEXT, true)
    view.set_capture_outside(nid, true) or >>
    c.field_ids.push(nid)
    c.field_kinds.push(kind)
    c.fields.push(make_plain_field(ctx, id_ev, nid, label, val))
    << nid
}

fn push_comp_select(
    c $&ComponentInspector,
    view $&widgets.View,
    parent int,
    w f64,
    kind int,
    id_ev &ui.CanvasEvent,
    count int,
    sel int,
    labels []widgets.StyledLabel
) int {
    nid := add_interactive(view, parent, &leaf_box(w, 30.0), ui.CURSOR_HAND, true)
    s := widgets.select_box(id_ev, nid, &zero_rect(), count, sel) or >>
    c.select_ids.push(nid)
    c.select_kinds.push(kind)
    c.select_origins.push(zero_rect())
    c.selects.push(s)
    c.select_labels.push(labels)
    << nid
}

fn push_comp_btn(
    c $&ComponentInspector,
    view $&widgets.View,
    parent int,
    w f64,
    kind int,
    ctx &draw.Context,
    id_ev &ui.CanvasEvent,
    title string
) int {
    nid := add_interactive(view, parent, &leaf_box(w, 28.0), ui.CURSOR_HAND, true)
    b := widgets.button(id_ev, nid, &zero_rect()) or >>
    c.button_ids.push(nid)
    c.button_kinds.push(kind)
    c.buttons.push(b)
    c.button_labels.push(widgets.styled_label(ctx, &title))
    << nid
}

fn push_comp_chk(
    c $&ComponentInspector,
    view $&widgets.View,
    parent int,
    w f64,
    kind int,
    ctx &draw.Context,
    id_ev &ui.CanvasEvent,
    title string,
    init bool
) int {
    nid := add_interactive(view, parent, &leaf_box(w, 26.0), ui.CURSOR_HAND, true)
    chk := widgets.checkbox(id_ev, nid, &zero_rect(), init) or >>
    c.check_ids.push(nid)
    c.check_kinds.push(kind)
    c.checks.push(chk)
    c.check_labels.push(widgets.styled_label(ctx, &title))
    << nid
}

fn push_comp_div(c $&ComponentInspector, view $&widgets.View, id_scroll int, scroll_cw f64) int {
    nid := add_box(view, id_scroll, &leaf_box(scroll_cw, 4.0))
    dv := widgets.divider(&zero_rect(), widgets.AXIS_HORIZONTAL) or >>
    c.div_ids.push(nid)
    c.divs.push(dv)
    << nid
}

fn init_comp_camera(c $&ComponentInspector, view $&widgets.View, id_scroll int, scroll_cw f64, tri_w f64, half_w f64, ctx &draw.Context, id_ev &ui.CanvasEvent) int {
    c.id_cam_div = push_comp_div(c, view, id_scroll, scroll_cw) or >>
    c.id_cam_hdr = add_box(view, id_scroll, &leaf_box(scroll_cw, 18.0))
    c.id_cam_row1 = add_box(view, id_scroll, &row_box(scroll_cw, 30.0, 4.0))
    lbls := make_styled_labels(ctx, &["Cam: None", "Cam: Perspective", "Cam: Orthographic", "Cam: View2D"])
    _ := push_comp_select(c, view, c.id_cam_row1, scroll_cw, 0, id_ev, 4, 0, lbls) or >>
    c.id_cam_row2 = add_box(view, id_scroll, &row_box(scroll_cw, 44.0, 4.0))
    _ := push_comp_field(c, view, c.id_cam_row2, tri_w, 0, ctx, id_ev, "FOV/Sz/W", "60") or >>
    _ := push_comp_field(c, view, c.id_cam_row2, tri_w, 0, ctx, id_ev, "Near/H", "0.1") or >>
    _ := push_comp_field(c, view, c.id_cam_row2, tri_w, 0, ctx, id_ev, "Far/Zoom", "200") or >>
    c.id_cam_row3 = add_box(view, id_scroll, &row_box(scroll_cw, 30.0, 4.0))
    _ := push_comp_btn(c, view, c.id_cam_row3, half_w, 0, ctx, id_ev, "Apply Cam") or >>
    _ := push_comp_btn(c, view, c.id_cam_row3, half_w, 1, ctx, id_ev, "Clear") or >>
    << 0
}

fn init_comp_light(c $&ComponentInspector, view $&widgets.View, id_scroll int, scroll_cw f64, tri_w f64, half_w f64, ctx &draw.Context, id_ev &ui.CanvasEvent) int {
    c.id_light_div = push_comp_div(c, view, id_scroll, scroll_cw) or >>
    c.id_light_hdr = add_box(view, id_scroll, &leaf_box(scroll_cw, 18.0))
    c.id_light_row1 = add_box(view, id_scroll, &row_box(scroll_cw, 30.0, 4.0))
    lbls := make_styled_labels(ctx, &["Light: None", "Light: Directional", "Light: Point", "Light: Spot"])
    _ := push_comp_select(c, view, c.id_light_row1, scroll_cw, 0, id_ev, 4, 0, lbls) or >>
