fn snap_tabs_motion(t $&widgets.Tabs) {
    spec := widgets.MotionSpec{
        hover: time.duration(0),
        press: time.duration(0),
        change: time.duration(0),
        enter: time.duration(0),
        exit: time.duration(0),
        curve: widgets.EASE_LINEAR
    }
    _ := t.set_motion(&spec) >>> (err) {
        _ := err
        <<
    }
    _ := t.tick(time.instant(), true) >>> (err) {
        _ := err
        <<
    }
}
pub fn set_tabs_selected(t $&widgets.Tabs, idx int) {
    _ := t.set_selected(idx) >>> (err) {
        _ := err
        <<
    }
    snap_tabs_motion(t)
}
pub fn sync_local_box_tabs(view &widgets.View, id int, styles &widgets.Styles, t $&widgets.Tabs) int {
    nb := view.node_bounds(id) >>>
    _ := t.set_bounds(&layout.Rect{x: 0.0, y: 0.0, width: nb.width, height: nb.height}) >>>
    _ := t.apply_styles(styles) >>>
    snap_tabs_motion(t)
    << 0
}
pub fn tick_tabs(t $&widgets.Tabs, now time.Instant, rm bool) bool {
    << t.tick(now, rm) >>> (err) {
        _ := err
        << false
    }
}
pub fn tabs_next_tick(t &widgets.Tabs, now time.Instant) time.Instant {
    << t.next_tick(now) >>> (err) {
        _ := err
        << time.zero_instant()
    }
}
pub fn paint_segmented(t &widgets.Tabs, labels $&[]widgets.StyledLabel, frame $&draw.Frame, styles &widgets.Styles) int {
    t.paint_box_styled(frame, styles) >>>
    n := labels.len
    for i in 0:n {
        t.paint_tab_styled(frame, i, $&labels[i], styles) >>>
    }
    << 0
}
pub fn tabs_hit_cursor(view &widgets.View, id int, t &widgets.Tabs, x f64, y f64) int {
    nb := view.node_bounds(id) >>> (err) {
        _ := err
        << -1
    }
    if nb.width <= 0.5 || nb.height <= 0.5 || !nb.contains(x, y) { << -1 }
    << t.cursor_at(x - nb.x, y - nb.y)
}
pub fn repaint(view $&widgets.View, id int) {
    _ := view.mark_paint(id) >>> (err) {
        _ := err
        <<
    }
    children := view.children(id) >>> (err) {
        _ := err
        <<
    }
    for i in 0:children.len {
        repaint(view, children[i])
    }
}
