pub fn selectable_text_style(styles &widgets.Styles, pal &PaperPalette, size f64, fg draw.Color) widgets.ControlStyle {
    $c := styles.button.clone()
    c.border_width = 0.0
    c.focus_width = 0.0
    c.radius = 0.0
    c.min_width = 0.0
    c.min_height = 0.0
    c.padding = layout.Insets{left: 0.0, top: 0.0, right: 0.0, bottom: 0.0}
    c.align_x = 0.0
    c.align_y = 0.5
    c.inherit_font = false
    c.font.size = size
    c.font.line_height = size * 1.35
    c.palette.normal = draw.rgba(0, 0, 0, 0)
    c.palette.hovered = draw.rgba(0, 0, 0, 0)
    c.palette.pressed = draw.rgba(0, 0, 0, 0)
    c.palette.foreground = fg
    c.palette.muted = pal.muted
    c.palette.focus = pal.focus
    c.palette.selection = pal.focus.with_alpha(56)
    c.palette.selection_text = pal.text
    c.states = []widgets.StatePaint{}
    << c
}
