pub fn repaint(view $&widgets.View, id int) {
    _ := view.mark_paint(id) >>> (err) {
        _ := err
        <<
    }
    children := view.children(id) >>> (err) {
        _ := err
        <<
    }
    for i in 0:children.len {
        repaint(view, children[i])
    }
}
pub fn copy_rect(r &layout.Rect) layout.Rect {
    << layout.Rect{x: r.x, y: r.y, width: r.width, height: r.height}
}
