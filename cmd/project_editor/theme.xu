    << c
}

pub fn pill_button_style(styles &widgets.Styles, variant int) widgets.ControlStyle {
    $c := styles.button_variant(variant) >>> (err) {
        _ := err
        << styles.button.clone()
    }
    c.inherit_font = false
    c.font = widgets.font_style(11.5)
    c.padding = layout.Insets{left: 4.0, top: 3.0, right: 4.0, bottom: 3.0}
