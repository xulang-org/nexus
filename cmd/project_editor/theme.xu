pub fn toolbar_select_popup_style(styles &widgets.Styles, pal &PaperPalette, font_size f64, compact bool) widgets.ControlStyle {
    $c := styles.select_style()
    c.inherit_font = false
    c.font = widgets.font_style(font_size)
    c.radius = 7.0
    c.border_width = 1.0
    c.indicator_size = 8.0
    c.gap = 4.0
    c.mark_width = 1.25
    if compact {
        c.padding = layout.Insets{left: 8.0, top: 3.0, right: 6.0, bottom: 3.0}
        c.min_width = 60.0
        c.min_height = 24.0
    } else {
        c.padding = layout.Insets{left: 10.0, top: 4.0, right: 8.0, bottom: 4.0}
        c.min_width = 72.0
        c.min_height = 28.0
    }
    c.palette.normal = pal.surface
    c.palette.hovered = pal.elevated
    c.palette.pressed = pal.subtle
    c.palette.foreground = pal.text
    c.palette.muted = pal.muted
    c.palette.border = pal.border
    c.palette.accent = pal.brand
    c.palette.on_accent = draw.rgb(255, 255, 255)
    c.palette.focus = pal.focus
    c.shadow_x = 0.0
    c.shadow_y = 4.0
    c.shadow_blur = 10.0
    c.shadow_spread = 0.0
    c.shadow = draw.rgba(40, 35, 41, 24)
    $sel_sp := widgets.state_paint(widgets.STATE_SELECTED)
    sel_sp.unless = widgets.STATE_DISABLED
    sel_sp.fields = widgets.PAINT_BACKGROUND | widgets.PAINT_FOREGROUND
    sel_sp.background = draw.rgb(252, 228, 235)
    sel_sp.foreground = pal.brand
    $hov_sp := widgets.state_paint(widgets.STATE_HOVERED)
    hov_sp.unless = widgets.STATE_DISABLED | widgets.STATE_SELECTED
    hov_sp.fields = widgets.PAINT_BACKGROUND
    hov_sp.background = pal.elevated
    c.states = [sel_sp, hov_sp]
    << c
}

pub fn paint_toolbar_select(
    sel &widgets.Select,
    label $&widgets.StyledLabel,
    frame $&draw.Frame,
    styles &widgets.Styles,
    pal &PaperPalette,
    inline_pill bool
) int {
    c := sel.style_or(styles)
    b := sel.bounds()
    d := styles.density
    if b.width <= 0.5 || b.height <= 0.5 {
        << 0
    }
    state := sel.visual_state()
    is_open := sel.is_open()
    is_enabled := sel.is_enabled()
    is_pressed := (state & widgets.STATE_PRESSED) != 0
    is_hovered := (state & widgets.STATE_HOVERED) != 0 && !is_open

    $box_r := copy_rect(&b)
    if inline_pill {
        frame.line(b.x + 0.5, b.y + 4.0 * d, b.x + 0.5, b.y + math.max(4.0 * d, b.height - 4.0 * d), pal.border, 1.0) >>>
        box_r = layout.Rect{x: b.x + 3.0 * d, y: b.y, width: math.max(0.0, b.width - 3.0 * d), height: b.height}
    }

    $trig := c.clone()
    trig.shadow = draw.rgba(0, 0, 0, 0)
    trig.shadow_x = 0.0
    trig.shadow_y = 0.0
    trig.shadow_blur = 0.0
    trig.shadow_spread = 0.0
    trig.states = []widgets.StatePaint{}
    trig.inherit_font = false
    trig.palette.focus = pal.focus

    $chev_col := pal.muted
    if inline_pill {
        trig.radius = 5.0
        trig.font = widgets.font_style(11.5)
        if !is_enabled {
            trig.palette.normal = draw.rgba(0, 0, 0, 0)
            trig.border_width = 0.0
            trig.palette.border = draw.rgba(0, 0, 0, 0)
            trig.palette.foreground = pal.muted
            chev_col = pal.muted.with_alpha(140)
        } else if is_open || is_pressed {
            trig.palette.normal = pal.surface
            trig.border_width = 1.0
            trig.palette.border = pal.border
            trig.palette.foreground = pal.text
            chev_col = pal.text
        } else if is_hovered {
            trig.palette.normal = pal.subtle
            trig.border_width = 0.0
            trig.palette.border = draw.rgba(0, 0, 0, 0)
            trig.palette.foreground = pal.text
            chev_col = pal.text
        } else {
            trig.palette.normal = draw.rgba(0, 0, 0, 0)
            trig.border_width = 0.0
            trig.palette.border = draw.rgba(0, 0, 0, 0)
            trig.palette.foreground = pal.text
            chev_col = pal.muted
        }
    } else {
        trig.radius = 7.0
        trig.font = widgets.font_style(12.0)
        trig.border_width = 1.0
        if !is_enabled {
            trig.palette.normal = pal.elevated.with_alpha(150)
            trig.palette.border = pal.border.with_alpha(90)
            trig.palette.foreground = pal.muted
            chev_col = pal.muted.with_alpha(140)
        } else if is_open || is_pressed {
            trig.palette.normal = pal.surface
            trig.palette.border = pal.control_border.with_alpha(165)
            trig.palette.foreground = pal.text
            chev_col = pal.text
        } else if is_hovered {
            trig.palette.normal = pal.subtle
            trig.palette.border = pal.border
            trig.palette.foreground = pal.text
            chev_col = pal.text
        } else {
            trig.palette.normal = pal.elevated
            trig.palette.border = pal.border.with_alpha(140)
            trig.palette.foreground = pal.text
            chev_col = pal.muted
        }
    }

    $box_state := 0
    if (state & widgets.STATE_FOCUSED) != 0 && is_enabled {
        box_state = widgets.STATE_FOCUSED
    }
    widgets.style_box(frame, &box_r, &trig, d, box_state) >>>

    $left_pad := 10.0 * d
    $right_pad := 9.0 * d
    $chev_w := 8.0 * d
    $gap := 5.0 * d
    if inline_pill {
        left_pad = 6.0 * d
        right_pad = 6.0 * d
        chev_w = 7.0 * d
        gap = 3.0 * d
    }
    avail_w := math.max(0.0, box_r.width - left_pad - right_pad - chev_w - gap)
    avail_h := math.max(0.0, box_r.height - 4.0 * d)
    if label.text().len > 0 && avail_w > 0.5 && avail_h > 0.5 {
        text_r := layout.Rect{x: box_r.x + left_pad, y: box_r.y + 2.0 * d, width: avail_w, height: avail_h}
        $text_c := trig.clone()
        text_c.padding = layout.Insets{left: 0.0, top: 0.0, right: 0.0, bottom: 0.0}
        text_c.align_x = 0.0
        text_c.align_y = 0.5
        label.paint_text_styled(frame, &text_r, styles, &text_c, 0) >>>
    }

    cx := box_r.x + box_r.width - right_pad - chev_w * 0.5
    cy := box_r.y + box_r.height * 0.5
    hw := chev_w * 0.42
    hh := hw * 0.52
    sw := 1.25 * d
    if is_open {
        frame.line(cx - hw, cy + hh, cx, cy - hh, chev_col, sw) >>>
        frame.line(cx, cy - hh, cx + hw, cy + hh, chev_col, sw) >>>
    } else {
        frame.line(cx - hw, cy - hh, cx, cy + hh, chev_col, sw) >>>
        frame.line(cx, cy + hh, cx + hw, cy - hh, chev_col, sw) >>>
    }
    << 0
}

pub fn compact_tree_style(styles &widgets.Styles, pal &PaperPalette) widgets.ControlStyle {
    $c := styles.tree_style()
    c.inherit_font = false
    c.font = widgets.font_style(12.5)
    c.border_width = 1.0
    c.palette.border = pal.border
    c.palette.normal = pal.surface
    c.palette.hovered = pal.elevated
    c.palette.pressed = pal.subtle
    c.padding = layout.Insets{left: 4.0, top: 4.0, right: 4.0, bottom: 4.0}
    c.radius = 6.0
    << c
}

pub fn fmt_coord(value f64) string {
    $v := value
    if math.abs(v) < 1e-6 {
        v = 0.0
    }
    rounded := math.round(v * 10000.0) / 10000.0
    if math.abs(rounded) < 1e-9 {
        << "0"
    }
    s := strconv.format_float(rounded, 102, 4) >>> (err) {
        << "0"
    }
    if !strings.contains(&s, ".") {
        << s
    }
    $end := s.len
    while end > 0 && (s[end - 1] & 255) == 48 {
        end = end - 1
    }
    if end > 0 && (s[end - 1] & 255) == 46 {
        end = end - 1
    }
    if end == 0 {
        << "0"
    }
    res := s[0:end]
    if res == "-0" {
        << "0"
    }
    << res
}

pub fn byte_counter_text(s &string, max_bytes int) string {
    << str(s.len) + " / " + str(max_bytes) + " bytes"
}

