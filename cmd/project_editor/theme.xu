pub fn icon_active_style(styles &widgets.Styles, pal &PaperPalette) widgets.ControlStyle {
    $c := icon_button_style(styles, widgets.BUTTON_SECONDARY)
    c.states = []widgets.StatePaint{}
    c.palette.normal = pal.text
    c.palette.hovered = draw.rgb(58, 52, 60)
    c.palette.pressed = draw.rgb(26, 22, 28)
    c.palette.foreground = draw.rgb(255, 253, 251)
    c.palette.border = pal.text
    << c
}

pub fn icon_danger_subtle_style(styles &widgets.Styles, pal &PaperPalette) widgets.ControlStyle {
    $c := icon_button_style(styles, widgets.BUTTON_SUBTLE)
    c.states = []widgets.StatePaint{}
    c.palette.normal = draw.rgba(0, 0, 0, 0)
    c.palette.hovered = draw.rgb(253, 236, 239)
    c.palette.pressed = draw.rgb(249, 214, 222)
    c.palette.foreground = pal.muted
    c.palette.border = draw.rgba(0, 0, 0, 0)
    $hov := widgets.state_paint(widgets.STATE_HOVERED)
    hov.unless = widgets.STATE_DISABLED
    hov.fields = widgets.PAINT_FOREGROUND
    hov.foreground = pal.danger
    $prs := widgets.state_paint(widgets.STATE_PRESSED)
    prs.unless = widgets.STATE_DISABLED
    prs.fields = widgets.PAINT_FOREGROUND
    prs.foreground = pal.danger
    c.states.push(hov)
    c.states.push(prs)
    << c
}

pub fn segmented_control_style(styles &widgets.Styles, pal &PaperPalette) widgets.ControlStyle {
    $c := styles.tabs_style()
    c.inherit_font = false
    c.font = widgets.font_style(12.0)
    c.radius = 7.0
    c.border_width = 1.0
    c.padding = layout.Insets{left: 2.0, top: 2.0, right: 2.0, bottom: 2.0}
    c.gap = 2.0
    c.min_width = 72.0
    c.min_height = 28.0
    c.palette.normal = pal.elevated
    c.palette.hovered = pal.subtle
    c.palette.pressed = pal.border
    c.palette.border = pal.border
    c.palette.foreground = pal.muted
    c.palette.accent = pal.surface
    c.palette.on_accent = pal.text
    c.states = []widgets.StatePaint{}
    << c
}

