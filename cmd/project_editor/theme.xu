pub struct PaperPalette {
    pub canvas draw.Color
    pub surface draw.Color
    pub elevated draw.Color
    pub subtle draw.Color
    pub text draw.Color
    pub muted draw.Color
    pub border draw.Color
    pub control_border draw.Color
    pub brand draw.Color
    pub success draw.Color
    pub warning draw.Color
    pub danger draw.Color
    pub info draw.Color
    pub focus draw.Color
    pub axis_x draw.Color
    pub axis_z draw.Color
    pub grid_minor draw.Color
    pub grid_major draw.Color
}

fn parse_hex_byte(s string) int {
    << strconv.parse(&s, 16) >>> (err) {
        _ := err
        << -1
    }
}

fn parse_hex_color(hex &string, fallback draw.Color) draw.Color {
    s := strings.trim_space(hex)
    if s.len != 7 || (s[0] & 255) != 35 {
        << fallback
    }
    r := parse_hex_byte(s[1:3])
    g := parse_hex_byte(s[3:5])
    b := parse_hex_byte(s[5:7])
    if r < 0 || g < 0 || b < 0 {
        << fallback
    }
    << draw.rgb(r, g, b)
}

fn try_read_file(path string) string {
    << os.read(path + "") >>> (err) { << "" }
}

fn read_token_color(doc &json.Doc, light_obj int, key string, fallback draw.Color) draw.Color {
    if light_obj < 0 || !doc.has(light_obj, key + "") {
        << fallback
    }
    node := doc.get(light_obj, key + "")
    if !doc.is_string(node) {
        << fallback
    }
    val := doc.as_string(node) >>> (err) { << fallback }
    << parse_hex_color(&val, fallback)
}

pub fn default_palette() PaperPalette {
    $pal := PaperPalette{
        canvas: draw.rgb(246, 243, 239),
        surface: draw.rgb(255, 253, 251),
        elevated: draw.rgb(238, 235, 231),
        subtle: draw.rgb(232, 227, 223),
        text: draw.rgb(40, 35, 41),
        muted: draw.rgb(109, 98, 110),
        border: draw.rgb(217, 208, 217),
        control_border: draw.rgb(133, 121, 135),
        brand: draw.rgb(190, 18, 60),
        success: draw.rgb(20, 103, 71),
        warning: draw.rgb(133, 80, 8),
        danger: draw.rgb(184, 33, 56),
        info: draw.rgb(27, 100, 143),
        focus: draw.rgb(0, 95, 158),
        axis_x: draw.rgb(184, 33, 56),
        axis_z: draw.rgb(27, 100, 143),
        grid_minor: draw.rgb(232, 227, 223),
        grid_major: draw.rgb(217, 208, 217)
    }
    raw := try_read_file("assets/design/xu-ui-tokens.json")
    if raw.len > 0 {
        doc := json.parse(&raw)
        if doc.ok() && doc.is_dict(doc.root()) && doc.has(doc.root(), "light") {
            light := doc.get(doc.root(), "light")
            if doc.is_dict(light) {
                pal.canvas = read_token_color(&doc, light, "canvas", pal.canvas)
                pal.surface = read_token_color(&doc, light, "surface", pal.surface)
                pal.elevated = read_token_color(&doc, light, "elevated", pal.elevated)
                pal.subtle = read_token_color(&doc, light, "subtle", pal.subtle)
                pal.text = read_token_color(&doc, light, "text", pal.text)
                pal.muted = read_token_color(&doc, light, "muted", pal.muted)
                pal.border = read_token_color(&doc, light, "border", pal.border)
                pal.control_border = read_token_color(&doc, light, "control-border", pal.control_border)
                pal.brand = read_token_color(&doc, light, "brand", pal.brand)
                pal.success = read_token_color(&doc, light, "success", pal.success)
                pal.warning = read_token_color(&doc, light, "warning", pal.warning)
                pal.danger = read_token_color(&doc, light, "danger", pal.danger)
                pal.info = read_token_color(&doc, light, "info", pal.info)
                pal.focus = read_token_color(&doc, light, "focus", pal.focus)
                pal.axis_x = pal.danger
                pal.axis_z = pal.info
                pal.grid_minor = pal.subtle
                pal.grid_major = pal.border
            }
        }
    }
    << pal
}

pub fn make_paper_styles(pal &PaperPalette) widgets.Styles {
    $styles := widgets.preset_styles(widgets.THEME_LIGHT) >>>
    styles.background = pal.canvas
    styles.text_scale = 1.0
    styles.density = 1.0
    styles.button.palette.normal = pal.surface
    styles.button.palette.hovered = pal.elevated
    styles.button.palette.pressed = pal.subtle
    styles.button.palette.foreground = pal.text
    styles.button.palette.border = pal.border
    styles.button.palette.accent = pal.brand
    styles.button.palette.on_accent = draw.rgb(255, 255, 255)
    styles.button.palette.invalid = pal.danger
    styles.button.palette.focus = pal.focus
    styles.button.palette.muted = pal.muted
    styles.button.palette.selection = pal.focus.with_alpha(56)
    styles.button.palette.selection_text = pal.text
    styles.button.radius = 6.0
    styles.button.padding = layout.Insets{left: 10.0, top: 6.0, right: 10.0, bottom: 6.0}
    styles.button.min_height = 28.0
    styles.button.min_width = 48.0

    styles.input.palette.normal = pal.surface
    styles.input.palette.hovered = pal.surface
    styles.input.palette.pressed = pal.surface
    styles.input.palette.foreground = pal.text
    styles.input.palette.border = pal.control_border
    styles.input.palette.accent = pal.brand
    styles.input.palette.invalid = pal.danger
    styles.input.palette.focus = pal.focus
    styles.input.palette.muted = pal.muted
    styles.input.palette.selection = pal.focus.with_alpha(56)
    styles.input.palette.selection_text = pal.text
    styles.input.radius = 6.0
    styles.input.min_height = 30.0
    styles.input.padding = layout.Insets{left: 8.0, top: 5.0, right: 8.0, bottom: 5.0}

    styles.checkbox.palette.normal = pal.surface
    styles.checkbox.palette.foreground = pal.text
    styles.checkbox.palette.border = pal.control_border
    styles.checkbox.palette.accent = pal.brand
    styles.checkbox.palette.on_accent = draw.rgb(255, 255, 255)
    styles.checkbox.palette.focus = pal.focus

    styles.validate() >>>
    << styles
}

pub fn compact_field_style(styles &widgets.Styles) widgets.ControlStyle {
    $c := styles.input.clone()
    c.min_height = 28.0
    c.min_width = 36.0
    c.padding = layout.Insets{left: 6.0, top: 4.0, right: 6.0, bottom: 4.0}
    << c
}

pub fn compact_button_style(styles &widgets.Styles, variant int) widgets.ControlStyle {
    $c := styles.button_variant(variant) >>> (err) {
        _ := err
        << styles.button.clone()
    }
    c.min_height = 26.0
    c.min_width = 36.0
    c.padding = layout.Insets{left: 8.0, top: 4.0, right: 8.0, bottom: 4.0}
    << c
}

pub fn fmt_coord(value f64) string {
    $v := value
    if math.abs(v) < 1e-6 {
        v = 0.0
    }
    rounded := math.round(v * 10000.0) / 10000.0
    if math.abs(rounded) < 1e-9 {
        << "0"
    }
    s := strconv.format_float(rounded, 102, 4) >>> (err) {
        << "0"
    }
    if !strings.contains(&s, ".") {
        << s
    }
    $end := s.len
    while end > 0 && (s[end - 1] & 255) == 48 {
        end = end - 1
    }
    if end > 0 && (s[end - 1] & 255) == 46 {
        end = end - 1
    }
    if end == 0 {
        << "0"
    }
    res := s[0:end]
    if res == "-0" {
        << "0"
    }
    << res
}

pub fn byte_counter_text(s &string, max_bytes int) string {
    << str(s.len) + " / " + str(max_bytes) + " bytes"
}

