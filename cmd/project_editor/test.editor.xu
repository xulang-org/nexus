fn run_phase2_top_view_modes_snap_and_marquee() int {
    $n0 := resource.node(-1, "Root", resource.NODE_GROUP)
    $n1 := resource.node(0, "CamNode", resource.NODE_3D)
    n1.camera = camera_data.perspective(1.047, 0.1, 120.0) >>>
    n1.local_3d = fm.translation_3d(fm.vec3(2.0, 5.0, -3.0))
    $n2 := resource.node(0, "LightNode", resource.NODE_3D)
    n2.local_3d = fm.translation_3d(fm.vec3(-4.0, 3.0, 6.0))
    $n3 := resource.node(0, "HUD2D", resource.NODE_2D)
    n3.local = fm.transform_2d(fm.vec2(8.0, 12.0), 0.0, fm.vec2(1.0, 1.0))

    base := resource.make_document([n0, n1, n2, n3]) >>>
    l_src := light_data.point(fm.vec3(0.0, 0.0, 0.0), fm.vec3(2.0, 1.8, 1.5), 14.0) >>>
    l_att := resource.light_attachment(2, l_src)
    full := resource.with_lights(&base, [l_att]) >>>

    pts := extract_stage_points(&full)
    t_true(pts.len == 4, "extract_stage_points extracts all 4 nodes")
    t_true(pts[1].has_camera && !pts[1].has_light, "camera flag extracted")
    t_true(pts[2].has_light && !pts[2].has_camera, "light flag extracted")
    t_near(pts[2].light_radius, 14.0, 1e-6, "light radius extracted")
    t_true(pts[3].kind == resource.NODE_2D, "2D node kind extracted")

    $tv := default_top_view()
    bounds := layout.Rect{x: 0.0, y: 0.0, width: 500.0, height: 400.0}
    tv.axis_mode = STAGE_XZ
    t_near(stage_point_v(&pts[1], STAGE_XZ), -3.0, 1e-6, "STAGE_XZ uses Z")
    tv.axis_mode = STAGE_XY
    t_near(stage_point_v(&pts[1], STAGE_XY), 5.0, 1e-6, "STAGE_XY uses Y")
    tv.fit_points(&pts, &bounds)
    sx1 := world_to_screen_x(&tv, &bounds, 2.0)
    sy1 := world_to_screen_y(&tv, &bounds, 5.0)
    t_true(pick_stage_node(&tv, &bounds, &pts, sx1, sy1) == 1, "pick_stage_node picks in STAGE_XY")

    // Marquee selects both n1 and n2 when enclosing them, excluding root
    sx2 := world_to_screen_x(&tv, &bounds, -4.0)
    sy2 := world_to_screen_y(&tv, &bounds, 3.0)
    marq := pick_stage_marquee(&tv, &bounds, &pts, math.min(sx1, sx2) - 2.0, math.min(sy1, sy2) - 2.0, math.max(sx1, sx2) + 2.0, math.max(sy1, sy2) + 2.0)
    t_true(is_selected_node(&marq, 1) && is_selected_node(&marq, 2), "marquee hits enclosed nodes")
    t_true(!is_selected_node(&marq, 0), "marquee skips root")

    t_near(snap_coord(1.37, 0.25), 1.25, 1e-6, "snap_coord rounds down cleanly")
    t_near(snap_coord(-1.38, 0.25), -1.5, 1e-6, "snap_coord rounds negative cleanly")
    << 0
}

fn test_phase2_top_view_modes_snap_and_marquee() {
    _ := run_phase2_top_view_modes_snap_and_marquee() >>> (err) {
        t_fail("phase2: " + err.msg())
        <<
    }
}

fn write_minimal_wav(path string) int {
    bytes := [82, 73, 70, 70, 40, 0, 0, 0, 87, 65, 86, 69, 102, 109, 116, 32, 16, 0, 0, 0, 1, 0, 1, 0, 68, 172, 0, 0, 136, 88, 1, 0, 2, 0, 16, 0, 100, 97, 116, 97, 4, 0, 0, 0, 0, 0, 0, 0]
    $bb := strings.new_byte_builder(64)
    for b in bytes { bb.write_byte(b) }
    raw := bb.to_string()
    os.write(path + "", raw) >>>
    << 0
}

fn write_minimal_png(path string) int {
    px := [255, 0, 0, 255, 0, 255, 0, 255, 0, 0, 255, 255, 255, 255, 255, 255]
    $bb := strings.new_byte_builder(16)
    for b in px { bb.write_byte(b) }
    raw_px := bb.to_string()
    enc := png.encode_rgba_bytes(&raw_px, 2, 2) >>>
    os.write(path + "", enc) >>>
    << 0
}

fn write_minimal_xubc(path string) int {
    src_hash := sha256.sum256("test_script")
    encoded := "XUNEXUS-SCRIPT-1\n{\"format\":1,\"api\":1,\"profile\":\"xu-scalar-v1\",\"module\":\"test_mod\",\"class\":\"TestActor\",\"source_hash\":\"" +
        src_hash +
        "\",\"fields\":[{\"id\":1,\"name\":\"speed\",\"default\":2}],\"signals\":[],\"functions\":[{\"id\":0,\"name\":\"physics_process\",\"kind\":1,\"entry\":0,\"end\":2}],\"registers\":[1,1,1],\"constants\":[1],\"code\":[[1,2,0,0,1,1],[20,0,2,0,1,1]]}"
    os.write(path + "", encoded) >>>
    << 0
}

fn run_phase3_components_and_globals(tmp string) int {
    p_png := filepath.join([tmp + "", "assets", "sprite.png"])
    p_wav := filepath.join([tmp + "", "assets", "beep.wav"])
    p_xubc := filepath.join([tmp + "", "assets", "actor.xubc"])
    write_minimal_png(p_png + "") >>>
    write_minimal_wav(p_wav + "") >>>
    write_minimal_xubc(p_xubc + "") >>>

    proj_json := filepath.join([tmp + "", "project.json"])
    uid_png := proj_pkg.register_asset(proj_json + "", "assets/sprite.png") >>>
    uid_wav := proj_pkg.register_asset(proj_json + "", "assets/beep.wav") >>>
    uid_xubc := proj_pkg.register_asset(proj_json + "", "assets/actor.xubc") >>>

    proj := load_project(proj_json + "") >>>
    world_path := proj.scene_source(0) >>>
    $d := open_draft(world_path + "") >>>

    // 1. Camera Perspective, Orthographic, View2D, Clear + Undo
    n3 := d.add_node_under(0, resource.NODE_3D, "Hero") >>>
    d.set_node_camera_perspective(n3, 60.0, 0.1, 150.0) >>>
    t_true(((d.document() >>>).describe_node(n3) >>>).camera.is_set(), "camera perspective set")
    d.set_node_camera_orthographic(n3, 12.0, 0.5, 90.0) >>>
    nd_ortho := (d.document() >>>).describe_node(n3) >>>
    t_true(nd_ortho.orthographic.is_set() && !nd_ortho.camera.is_set(), "camera orthographic clears perspective")
    d.clear_node_camera(n3) >>>
    t_true(!((d.document() >>>).describe_node(n3) >>>).orthographic.is_set(), "camera cleared")
    d.undo_edit() >>>
    t_true(((d.document() >>>).describe_node(n3) >>>).orthographic.is_set(), "undo restores cleared camera")

    n2 := d.add_node_under(0, resource.NODE_2D, "Layer2D") >>>
    d.set_node_camera_2d(n2, 1280.0, 720.0, 1.5) >>>
    t_true(((d.document() >>>).describe_node(n2) >>>).camera_2d.is_set(), "camera_2d set on Node2D")

    // 2. Light + Shadow (Directional CSM, Point Punctual, Spot Punctual, Clear)
    d.set_node_light(n3, light_data.DIRECTIONAL, 2.0, 2.0, 1.8, 10.0, 15.0, 35.0, 0.3, 0.8, 0.5, true, 512, 60.0, 3) >>>
    t_true(((d.document() >>>).light(0) >>>).cascades.enabled(), "directional CSM enabled")
    d.set_node_light(n3, light_data.POINT, 3.0, 1.5, 1.0, 14.0, 15.0, 35.0, 0.0, 1.0, 0.0, true, 256, 40.0, 3) >>>
    t_true(((d.document() >>>).light(0) >>>).punctual.enabled(), "point punctual shadow enabled")
    d.set_node_light(n3, light_data.SPOT, 2.5, 2.5, 2.5, 16.0, 12.0, 30.0, 0.0, 1.0, 0.2, true, 512, 40.0, 3) >>>
    t_true(((d.document() >>>).light(0) >>>).source.kind() == light_data.SPOT, "spot light updated")
    d.clear_node_light(n3) >>>
    t_true((d.document() >>>).light_count() == 0, "clear_node_light removes light")

    // 3. Script + Initials + Connections + cascading clear
    inits := parse_script_initials(&"1=3.5, 2=7") >>>
    t_true(inits.len == 2 && format_script_initials(&inits) == "1=3.5, 2=7", "script initials roundtrip")
    d.set_node_script(&proj, n3, uid_xubc + "", inits) >>>
    t_true((d.document() >>>).script_count() == 1, "script attached")
    d.add_script_connection(n3, 1, n3, 1) >>>
    t_true((d.document() >>>).script_connection_count() == 1, "script connection added")
    d.remove_script_connection(0) >>>
    t_true((d.document() >>>).script_connection_count() == 0, "script connection removed")
    d.add_script_connection(n3, 1, n3, 1) >>>
    d.clear_node_script(n3) >>>
    doc_sc := d.document() >>>
    t_true(doc_sc.script_count() == 0 && doc_sc.script_connection_count() == 0, "clear_node_script cascades connections")

    // 4. AudioEmitter auto-Master bus + SFX sub-bus + mute + remove + auto-clear
    d.set_node_audio_emitter(&proj, n3, uid_wav + "", 0, 0.9, 0.0, true, false, "3d", n3, 25.0) >>>
    doc_a1 := d.document() >>>
    t_true(doc_a1.audio_count() == 1 && doc_a1.audio_bus_count() == 1 && (doc_a1.audio_bus(0) >>>).name == "Master", "auto-creates Master bus")
    d.add_audio_bus(0, "SFX", 0.8, false, false) >>>
    t_true((d.document() >>>).audio_bus_count() == 2, "sub-bus SFX added")
    d.toggle_audio_bus_mute(1) >>>
    t_true(((d.document() >>>).audio_bus(1) >>>).muted, "SFX bus muted")
    d.remove_audio_bus(1) >>>
    t_true((d.document() >>>).audio_bus_count() == 1, "SFX sub-bus removed")
    d.clear_node_audio_emitter(n3) >>>
    doc_a2 := d.document() >>>
    t_true(doc_a2.audio_count() == 0 && doc_a2.audio_bus_count() == 0, "clearing last emitter auto-clears buses")

    // 5. Sprite3D attach & clear
    d.set_node_sprite_3d(&proj, n3, uid_png + "", 2.0, 1.5, sprite3d.BILLBOARD_Y_AXIS, sprite3d.ALPHA_MODE_CUTOUT, 0.4, true, false, false) >>>
    t_true((d.document() >>>).sprite_3d_count() == 1, "Sprite3D attached")
    d.clear_node_sprite_3d(n3) >>>
    t_true((d.document() >>>).sprite_3d_count() == 0, "Sprite3D cleared")

    // 6. TileMap2D ensure + merge_tilemaps
    d.ensure_node_tilemap_2d(&proj, n2, uid_png + "") >>>
    t_true((d.document() >>>).tilemap_2d_count() == 1, "TileMap2D created")
    tm_doc := d.document() >>>
    tm_rev := d.current + ""
    d.merge_tilemaps(&tm_doc, &tm_rev) >>>
    t_true((d.document() >>>).tilemap_2d_count() == 1, "merge_tilemaps preserves attachment")

    // 7. Single-undo Presets (+ Cam / + Lgt)
    cam_idx := d.add_preset_camera_node(0) >>>
    t_true(((d.document() >>>).describe_node(cam_idx) >>>).camera.is_set(), "preset camera created")
    d.undo_edit() >>>
    t_true((d.document() >>>).node_count() == tm_doc.node_count(), "single undo removes preset camera")

    lgt_idx := d.add_preset_light_node(0) >>>
    t_true((d.document() >>>).light_count() == 1 && ((d.document() >>>).light(0) >>>).node == lgt_idx, "preset light created")
    d.undo_edit() >>>
    t_true((d.document() >>>).light_count() == 0 && (d.document() >>>).node_count() == tm_doc.node_count(), "single undo removes preset light")
    d.redo_edit() >>>
    t_true((d.document() >>>).light_count() == 1, "redo restores preset light")
    << 0
}

