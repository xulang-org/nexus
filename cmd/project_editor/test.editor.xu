@main

resource #"github.com/xulang-org/nexus/resources/scene"
files #"github.com/xulang-org/nexus/integration/scene"
fm #"github.com/xulang-org/nexus/foundation/math"
#ui
#ui/draw
#ui/layout
widgets #ui/widgets
#os
#os/exec
#path/filepath
#math
#strings
#errors

fn t_fail(msg string) {
    eprintln("FAIL: " + msg)
    assert(false)
}

fn t_true(cond bool, msg string) {
    if !cond {
        t_fail(msg)
    }
}

fn t_near(actual f64, expected f64, tol f64, msg string) {
    if math.abs(actual - expected) > tol {
        t_fail(msg + " (got " + fmt_coord(actual) + ", want " + fmt_coord(expected) + ")")
    }
}

fn copy_file_exact(src string, dst string) int {
    data := os.read(src + "") or >>
    parent := filepath.dir(&dst)
    os.mkdir_all(parent + "") or >>
    os.write(dst + "", data) or >>
    << 0
}

fn setup_fixture_project() string {
    tmp := os.mkdir_temp("", "nexus-ed-test-") or (err) {
        t_fail("mkdir_temp: " + err.msg())
        << ""
    }
    _ := copy_file_exact("examples/scene_assets/project.json", filepath.join([tmp + "", "project.json"])) or (err) {
        t_fail("copy project.json: " + err.msg())
        << ""
    }
    _ := copy_file_exact("examples/scene_assets/assets/world.xuscene", filepath.join([tmp + "", "assets", "world.xuscene"])) or (err) {
        t_fail("copy world.xuscene: " + err.msg())
        << ""
    }
    _ := copy_file_exact("examples/scene_assets/assets/panels.glb", filepath.join([tmp + "", "assets", "panels.glb"])) or (err) {
        t_fail("copy panels.glb: " + err.msg())
        << ""
    }
    << tmp
}

fn setup_external_glb_file() string {
    ext_dir := os.mkdir_temp("", "nexus-ed-ext-") or (err) {
        t_fail("mkdir_temp ext: " + err.msg())
        << ""
    }
    _ := copy_file_exact("examples/scene_assets/assets/panels.glb", filepath.join([ext_dir + "", "crate_extra.glb"])) or (err) {
        cleanup_dir(ext_dir + "")
        t_fail("copy external crate_extra.glb: " + err.msg())
        << ""
    }
    << ext_dir
}

fn cleanup_dir(dir string) {
    if dir.len > 0 {
        _ := os.remove_all(dir + "") or (err) {
            _ := err
            <<
        }
    }
}

fn rect_inside(inner &layout.Rect, outer &layout.Rect) bool {
    << inner.x >= outer.x - 0.5 &&
        inner.y >= outer.y - 0.5 &&
        inner.x + inner.width <= outer.x + outer.width + 0.5 &&
        inner.y + inner.height <= outer.y + outer.height + 0.5
}

fn vec4_exact_eq(a &fm.Vec4, b &fm.Vec4) bool {
    << a.x == b.x && a.y == b.y && a.z == b.z && a.w == b.w
}

fn run_theme_paper_tokens() int {
    pal := default_palette()
    t_true(pal.canvas.value() == draw.rgb(246, 243, 239).value(), "canvas token #f6f3ef")
    t_true(pal.surface.value() == draw.rgb(255, 253, 251).value(), "surface token #fffdfb")
    t_true(pal.elevated.value() == draw.rgb(238, 235, 231).value(), "elevated token #eeebe7")
    t_true(pal.text.value() == draw.rgb(40, 35, 41).value(), "text token #282329")
    t_true(pal.muted.value() == draw.rgb(109, 98, 110).value(), "muted token #6d626e")
    t_true(pal.brand.value() == draw.rgb(190, 18, 60).value(), "brand token #be123c")
    t_true(pal.success.value() == draw.rgb(20, 103, 71).value(), "success token #146747")
    t_true(pal.danger.value() == draw.rgb(184, 33, 56).value(), "danger token #b82138")
    t_true(pal.focus.value() == draw.rgb(0, 95, 158).value(), "focus token #005f9e")

    styles := make_paper_styles(&pal) or >>
    cf := compact_field_style(&styles)
    cb := compact_button_style(&styles, widgets.BUTTON_PRIMARY)
    t_true(cf.min_height >= 26.0, "compact field style height")
    t_true(cb.min_height >= 24.0, "compact button style height")
    t_true(byte_counter_text(&"hero", 255) == "4 / 255 bytes", "byte counter format")
    t_true(fmt_coord(-0.0) == "0", "fmt_coord strips negative zero")
    t_true(fmt_coord(1.2500) == "1.25", "fmt_coord trims trailing zeroes")
    << 0
}

fn test_theme_paper_tokens() {
    _ := run_theme_paper_tokens() or (err) {
        t_fail("theme test: " + err.msg())
        <<
    }
}

