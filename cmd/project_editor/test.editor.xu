    _ := os.stat(path + "") >>> (err) {
        _ := err
        << false
    }
    << true
}

fn run_project_scene_import_place_save_and_viewport_merge(tmp string, ext_dir string) int {
    proj_path := filepath.join([tmp + "", "project.json"])
    validator := filepath.abs(&"build/nexus-project-validate") >>>

    // Create new scene and verify manifest registration + duplicate rejection.
    new_key := create_scene(&proj_path, &"level_2.xuscene", &"StageRoot") >>>
    t_true(new_key == "level_2.xuscene", "create_scene normalizes .xuscene suffix")
    dup_scene_err := !try_create_scene_ok(&proj_path, &"level_2", &"StageRoot")
    t_true(dup_scene_err, "duplicate scene key rejected")

    // Import truly external GLB -> copies to assets/ and reuses on second import.
    ext_glb := filepath.join([ext_dir + "", "crate_extra.glb"])
    imp1 := import_external_glb(&proj_path, &ext_glb, &validator) >>>
    t_true(!imp1.reused, "first external GLB import creates new entry")
    t_true(imp1.primitive_count > 0, "external GLB primitive count > 0")
    imp2 := import_external_glb(&proj_path, &ext_glb, &validator) >>>
    t_true(imp2.reused && imp2.uid == imp1.uid, "identical external GLB reuses existing asset")

    // Place imported asset at (4.5, -2.5) with explicit primitive 0, save & verify validator passes.
    proj := load_project(proj_path + "") >>>
    lvl2_path := proj.scene_source(1) >>>
    $draft := open_draft(lvl2_path + "") >>>
    placed_idx := draft.place_asset(&proj, imp1.uid + "", 0, 4.5, -2.5) >>>
    doc_placed := draft.document() >>>
    t_true(doc_placed.resource_count() == 1, "place_asset adds GLB resource")
    t_true(doc_placed.surface_count() == 1, "place_asset binds surface")

    // Test viewport revision merge + stale revision conflict rejection.
    rev_ok := draft.current + ""
    _ := draft.merge_viewport(&doc_placed, &rev_ok) >>>
    stale_err := !try_merge_ok($&draft, &doc_placed, &"stale-json")
    t_true(stale_err, "merge_viewport rejects stale revision conflict")

    // Save succeeds against nexus-project-validate.
    _ := draft.save(&proj, &validator) >>>
    t_true(!draft.dirty(), "draft clean after save")

    // Deleting last referencing node removes surface and prunes GLB resource.
    _ := draft.delete_node(placed_idx) >>>
    doc_pruned := draft.document() >>>
    t_true(doc_pruned.surface_count() == 0, "deleting node removes surface")
    t_true(doc_pruned.resource_count() == 0, "deleting last referencing node prunes GLB resource")

    // External modification conflict detection on disk before save.
    disk_raw := os.read(lvl2_path + "") >>>
    os.write(lvl2_path + "", disk_raw + "\n") >>>
    ext_conflict := !try_save_ok($&draft, &proj, &validator)
    t_true(ext_conflict, "draft.save rejects external disk modification conflict")

    // End-to-end stage_scene -> nexus-project-viewport -> merge_viewport integration.
    vp_bin := "build/nexus-project-viewport"
    if test_path_exists(vp_bin + "") {
        world_path := proj.scene_source(0) >>>
        $wdraft := open_draft(world_path + "") >>>
        wdoc0 := wdraft.document() >>>
        factor_before := (wdoc0.describe_node(1) >>>).local_3d.c3.x
        vp_dir := filepath.join([tmp + "", "vp_stage"])
        staged := stage_scene(&proj, &wdoc0, &world_path, &vp_dir) >>>
        vp_out := filepath.join([vp_dir + "", "viewport-output.xuscene"])
        wrev := wdraft.current + ""
        _ := exec.command(
            vp_bin + "",
            "--scene", staged + "",
            "--output", vp_out + "",
            "--check-node", "Factor",
            "--snap-move", "0.5",
            "--snap-rotate", "15",
            "--snap-scale", "10"
        ).combined_output() >>>
        captured := files.load(vp_out + "") >>>
        wdraft.merge_viewport(&captured, &wrev) >>>
        t_true(wdraft.dirty(), "real viewport apply marks draft dirty")
        wdoc1 := wdraft.document() >>>
        factor_after := (wdoc1.describe_node(1) >>>).local_3d.c3.x
        t_near(factor_after - factor_before, 0.20, 1e-4, "real viewport Factor X shift merged")
    }
    << 0
}

fn test_project_scene_import_place_save_and_viewport_merge() {
    tmp := setup_fixture_project()
    ext_dir := setup_external_glb_file()
    _ := run_project_scene_import_place_save_and_viewport_merge(tmp + "", ext_dir + "") >>> (err) {
        cleanup_dir(ext_dir + "")
        cleanup_dir(tmp + "")
        t_fail("project/scene/import: " + err.msg())
        <<
    }
    cleanup_dir(ext_dir + "")
    cleanup_dir(tmp + "")
}

fn run_snap_modal_validation_and_persistence(tmp string) int {
    // Invalid inputs must populate field errors cleanly.
    bad := validate_snap_inputs(&"0", &"abc", &"15000")
    t_true(!bad.valid, "out-of-range/non-numeric snap validation fails")
    t_true(bad.move_err.len > 0, "move=0 fails range [0.0001, 1000000]")
    t_true(bad.rotate_err.len > 0, "rotate=abc fails numeric check")
    t_true(bad.scale_err.len > 0, "scale=15000 fails range [1, 10000]")

    good := validate_snap_inputs(&"0.5", &"15", &"25")
    t_true(good.valid, "valid snap settings pass validation")
    t_near(snap_scale_factor(&good.settings), 0.25, 1e-6, "snap_scale_factor converts % to ratio")

    _ := save_snap_settings(&tmp, &good.settings) >>>
    loaded := load_snap_settings(&tmp)
    t_near(loaded.move_step, 0.5, 1e-6, "loaded move_step")
    t_near(loaded.rotate_deg, 15.0, 1e-6, "loaded rotate_deg")
    t_near(loaded.scale_pct, 25.0, 1e-6, "loaded scale_pct")
    << 0
}

fn test_snap_modal_validation_and_persistence() {
    tmp := os.mkdir_temp("", "nexus-snap-test-") >>> (err) {
        t_fail("mkdir_temp snap: " + err.msg())
        <<
    }
    _ := run_snap_modal_validation_and_persistence(tmp + "") >>> (err) {
        cleanup_dir(tmp + "")
        t_fail("snap modal: " + err.msg())
        <<
    }
    cleanup_dir(tmp + "")
}

fn run_phase1_fidelity_surface_lod_2d_and_hierarchy(tmp string) int {
    // 1. Test Sprite3D & TileMap2D preservation across node edits, duplicate, reparent, and merge_viewport.
    iso_png_path := filepath.join([tmp + "", "assets", "sprite.png"])
    iso_raw := os.read("examples/isometric_2d/assets/iso_tiles.png") >>>
    iso_hash := sha256.sum256(iso_raw + "")
    os.write(iso_png_path + "", iso_raw + "") >>>

    uid_img := "b2000000000000000000000000000099"
    $n0 := resource.node(-1, "Root", resource.NODE_GROUP)
    $n1 := resource.node(0, "SpriteNode", resource.NODE_3D)
    $n2 := resource.node(0, "TileNode", resource.NODE_2D)
    base := resource.make_document([n0, n1, n2]) >>>

    sp_att := resource.sprite_3d_attachment(1, uid_img + "", sprite3d.sprite_3d(fm.vec2(1.5, 2.0)))
    ts := tilemap.tileset_2d(4, 4, 64.0, 32.0, fm.vec2(0.5, 0.5)) >>>
    $grid := tilemap.new_tilemap_2d(tilemap.LAYOUT_ISOMETRIC, 4, 4, 64.0, 32.0, 16.0, ts) >>>
    grid.set_cell(1, 1, 2) >>>
    tm_att := resource.tilemap_2d_attachment(2, uid_img + "", 1, true, 0.0, true, grid)
    iref := resource.ResourceReference{uid: uid_img + "", kind: "image_rgba", path: "sprite.png", content_hash: iso_hash}
    full := resource.with_all_attachments(
        &base,
        [iref],
        []resource.Surface{},
        []resource.AudioBus{},
        []resource.AudioEmitter{},
        []resource.ScriptAttachment{},
        []resource.ScriptConnection{},
        []resource.LightAttachment{},
        [sp_att],
        [tm_att]
    ) >>>

    custom_scene := filepath.join([tmp + "", "assets", "mixed.xuscene"])
    files.save(custom_scene + "", &full) >>>
    $md := open_draft(custom_scene + "") >>>

    // Edit Node2D rot/scale + process_mode -> must preserve Sprite3D & TileMap2D!
    md.set_node_full_properties(2, "TileNodeEdited", true, resource.PROCESS_ALWAYS, fm.vec3(12.0, -8.0, 0.0), true, fm.vec3(0.0, 0.0, 45.0), fm.vec3(2.0, 0.5, 1.0)) >>>
    mdoc1 := md.document() >>>
    t_true(mdoc1.sprite_3d_count() == 1, "Sprite3D preserved after set_node_full_properties")
    t_true(mdoc1.tilemap_2d_count() == 1, "TileMap2D preserved after set_node_full_properties")
    nd2 := mdoc1.describe_node(2) >>>
    t_true(nd2.process_mode == resource.PROCESS_ALWAYS, "process_mode updated")
    t2 := decompose_2d(&nd2.local)
    t_near(t2.x, 12.0, 1e-6, "Node2D tx")
    t_near(t2.y, -8.0, 1e-6, "Node2D ty")
    t_near(t2.rot_deg, 45.0, 1e-4, "Node2D rotation deg")
    t_near(t2.sx, 2.0, 1e-4, "Node2D scale x")
    t_near(t2.sy, 0.5, 1e-4, "Node2D scale y")

    // Duplicate & merge_viewport preserve Sprite3D & TileMap2D
    dup_sp := md.duplicate_node(1) >>>
    t_true(dup_sp > 0, "duplicate sprite node")
    mdoc2 := md.document() >>>
    t_true(mdoc2.sprite_3d_count() == 2, "duplicate_node clones Sprite3D")
    t_true(mdoc2.tilemap_2d_count() == 1, "duplicate_node preserves TileMap2D")

    rev2 := md.current + ""
    md.merge_viewport(&mdoc2, &rev2) >>>
    mdoc3 := md.document() >>>
    t_true(mdoc3.sprite_3d_count() == 2 && mdoc3.tilemap_2d_count() == 1, "merge_viewport preserves Sprite3D & TileMap2D")

    // 2. Test Surface bind/LOD/clear, sibling reorder, move_nodes_delta, and delete_nodes on project fixture
    proj := load_project(filepath.join([tmp + "", "project.json"])) >>>
    world_path := proj.scene_source(0) >>>
    $d := open_draft(world_path + "") >>>
    empty_idx := d.add_node_under(0, resource.NODE_3D, "EmptyProp") >>>
    uid := proj.assets[0].key + ""
    d.set_node_surface(&proj, empty_idx, uid + "", 0, [resource.SurfaceLevel{distance: 15.0, resource_uid: uid + "", primitive: 0}], 0.25) >>>
    doc_s := d.document() >>>
    $found_s := false
    for i in 0:doc_s.surface_count() {
        sf := doc_s.surface(i) >>>
        if sf.node == empty_idx {
            found_s = sf.levels.len == 1 && sf.hysteresis == 0.25
        }
    }
    t_true(found_s, "set_node_surface binds surface + LOD level + hysteresis")

    d.clear_node_surface(empty_idx) >>>
    doc_c := d.document() >>>
    $still_has := false
    for i in 0:doc_c.surface_count() {
        sf := doc_c.surface(i) >>>
        if sf.node == empty_idx { still_has = true }
    }
    t_true(!still_has, "clear_node_surface removes attachment")

    // move_node_sibling & move_nodes_delta & set_node_visible_only & delete_nodes
    moved_idx := d.move_node_sibling(empty_idx, -1) >>>
    t_true(moved_idx < empty_idx, "move_node_sibling -1 moves node earlier")
    before_x := (d.document() >>>).describe_node(moved_idx) >>>
    d.move_nodes_delta(&[moved_idx], 2.5, 0.0, -1.25) >>>
    after_x := (d.document() >>>).describe_node(moved_idx) >>>
    t_near(after_x.local_3d.c3.x - before_x.local_3d.c3.x, 2.5, 1e-6, "move_nodes_delta shifts X")
    t_near(after_x.local_3d.c3.z - before_x.local_3d.c3.z, -1.25, 1e-6, "move_nodes_delta shifts Z")

    d.set_node_visible_only(moved_idx, false) >>>
    t_true(!((d.document() >>>).describe_node(moved_idx) >>>).visible, "set_node_visible_only hides node")
    _ := d.delete_nodes(&[moved_idx]) >>>
    t_true((d.document() >>>).node_count() == doc_c.node_count() - 1, "delete_nodes removes target")
    << 0
}

