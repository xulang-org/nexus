    << true
}

fn run_phase4_project_crud_multi_asset_and_reorder(tmp string) int {
    val_bin := "build/nexus-project-validate"
    ext_dir := os.mkdir_temp("", "nexus-ed-p4-ext-") >>>
    p_png := filepath.join([ext_dir + "", "icon.png"])
    p_wav := filepath.join([ext_dir + "", "fx.wav"])
    p_xubc := filepath.join([ext_dir + "", "ctrl.xubc"])
    write_minimal_png(p_png + "") >>>
    write_minimal_wav(p_wav + "") >>>
    write_minimal_xubc(p_xubc + "") >>>

    proj_json := filepath.join([tmp + "", "project.json"])
    imp_png := import_external_asset(&proj_json, &p_png, &val_bin) >>>
    imp_wav := import_external_asset(&proj_json, &p_wav, &val_bin) >>>
    imp_xubc := import_external_asset(&proj_json, &p_xubc, &val_bin) >>>
    _ := os.remove_all(ext_dir + "")
    t_true(strings.ends_with(&imp_png.rel_path, ".png"), "imported external png")
    t_true(strings.ends_with(&imp_wav.rel_path, ".wav"), "imported external wav")
    t_true(strings.ends_with(&imp_xubc.rel_path, ".xubc"), "imported external xubc")

    // Reorder + Visibility toggle + Undo/Redo
    proj1 := load_project(proj_json + "") >>>
    t_true(proj1.assets.len == 4, "4 total project assets")
    world_path := proj1.scene_source(0) >>>
    $d := open_draft(world_path + "") >>>
    n_test := d.add_node_under(0, resource.NODE_3D, "ZOrderTest") >>>
    up_idx := d.move_node_sibling(n_test, -1) >>>
    t_true(up_idx < n_test, "sibling move up")
    dn_idx := d.move_node_sibling(up_idx, 1) >>>
    t_true(dn_idx == n_test, "sibling move down")
    d.set_node_visible_only(dn_idx, false) >>>
    t_true(!((d.document() >>>).describe_node(dn_idx) >>>).visible, "visibility toggled off")
    d.undo_edit() >>>
    t_true(((d.document() >>>).describe_node(dn_idx) >>>).visible, "undo restores visibility")

    // Attach imported PNG / WAV / XUBC and save scene
    d.set_node_sprite_3d(&proj1, dn_idx, imp_png.uid + "", 1.0, 1.0, sprite3d.BILLBOARD_DISABLED, sprite3d.ALPHA_MODE_OPAQUE, 0.0, false, false, false) >>>
    d.set_node_audio_emitter(&proj1, dn_idx, imp_wav.uid + "", 0, 1.0, 0.0, false, false, "none", -1, 0.0) >>>
    d.set_node_script(&proj1, dn_idx, imp_xubc.uid + "", []resource.ScriptInitial{}) >>>
    d.save(&proj1, &val_bin) >>>

    // remove_asset refuses while referenced, succeeds once unreferenced
    t_true(!try_remove_asset_ok(&proj_json, &imp_png.uid), "remove_asset refuses referenced png")
    extra_png := filepath.join([tmp + "", "assets", "unused.png"])
    write_minimal_png(extra_png + "") >>>
    imp_unused := import_external_asset(&proj_json, &extra_png, &val_bin) >>>
    reloc_png := filepath.join([tmp + "", "assets", "relocated.png"])
    write_minimal_png(reloc_png + "") >>>
    relocate_asset(&proj_json, &imp_unused.uid, &reloc_png) >>>
    t_true(try_remove_asset_ok(&proj_json, &imp_unused.uid), "remove_asset succeeds on unreferenced asset")

    // Scene CRUD: duplicate, rename, delete, refuse deleting last scene
    main_key := proj1.scenes[0].key + ""
    dup_key := duplicate_scene(&proj_json, &main_key, &"stage2") >>>
    t_true(dup_key == "stage2.xuscene", "duplicate_scene adds stage2")
    ren_key := rename_scene(&proj_json, &"stage2.xuscene", &"stage_renamed") >>>
    t_true(ren_key == "stage_renamed.xuscene", "rename_scene renames scene")
    out_dir := filepath.join([tmp + "", "pub_out"])
    pub_res := publish_project(&proj_json, &out_dir, &val_bin) >>>
    t_true(pub_res.generation.len == 64 && pub_res.rebuilt_assets >= 4, "publish_project cooks multi-asset project")
    t_true(try_delete_scene_ok(&proj_json, &ren_key), "delete_scene removes duplicated scene")
    t_true(!try_delete_scene_ok(&proj_json, &main_key), "delete_scene refuses deleting last scene")
    << 0
}

fn test_phase4_project_crud_multi_asset_and_reorder() {
    tmp := setup_fixture_project()
    _ := run_phase4_project_crud_multi_asset_and_reorder(tmp + "") >>> (err) {
        cleanup_dir(tmp + "")
        t_fail("phase4: " + err.msg())
        <<
    }
    cleanup_dir(tmp + "")
}

fn test_i18n_persistence_and_strings() {
    tmp := setup_fixture_project()
    t_true(load_editor_lang(&tmp) == LANG_EN, "default editor language is English")
    _ := save_editor_lang(&tmp, LANG_ZH) >>> (err) {
        cleanup_dir(tmp + "")
        t_fail("save ZH failed: " + err.msg())
        <<
    }
    t_true(load_editor_lang(&tmp) == LANG_ZH, "loaded editor language preserves Chinese")
    _ := save_editor_lang(&tmp, LANG_EN) >>> (err) {
        cleanup_dir(tmp + "")
        t_fail("save EN failed: " + err.msg())
        <<
    }
    t_true(load_editor_lang(&tmp) == LANG_EN, "loaded editor language preserves English")
    t_true(lang_toggle_label(LANG_EN) == "中文", "English mode shows 中文 switch label")
    t_true(lang_toggle_label(LANG_ZH) == "EN", "Chinese mode shows EN switch label")
    t_true(tr(LANG_ZH, "Save", "保存") == "保存", "tr selects Chinese string")
    w := approx_label_width(&"0.5 单位/格", 7.0)
    t_true(w > 45.0 && w < 85.0, "approx_label_width handles mixed ASCII and UTF-8 Chinese cleanly")
    cleanup_dir(tmp + "")
}

fn run_phase5_modern_v9_components(tmp string) int {
    proj_json := filepath.join([tmp + "", "project.json"])
    val_bin := "build/nexus-project-validate"
    scene_path := filepath.join([tmp + "", "assets", "world.xuscene"])
    proj0 := load_project(proj_json + "") >>>
    main_key := proj0.scenes[0].key + ""
    sub_key := duplicate_scene(&proj_json, &main_key, &"sub_prop") >>>
    proj := load_project(proj_json + "") >>>
    $d := open_draft(scene_path + "") >>>
    env_node := d.add_node_under(0, resource.NODE_3D, "WorldEnv") >>>
    rb_node := d.add_node_under(0, resource.NODE_3D, "PhysCrate") >>>
    terr_node := d.add_node_under(0, resource.NODE_3D, "HeightTerrain") >>>
    part_node := d.add_node_under(0, resource.NODE_3D, "Sparks") >>>
    pf_node := d.add_node_under(0, resource.NODE_3D, "TurretInst") >>>

    d.set_node_environment(env_node, resource.SKY_ATMOSPHERE, 2.5, 1.15, 0.02, true, true, false, true, true) >>>
    d.set_node_rigid_body_3d(rb_node, resource.BODY_DYNAMIC, resource.SHAPE_BOX, fm.vec3(0.5, 0.5, 0.5), 0.5, 8.0, 0.25, 0.7, false) >>>
    d.set_node_terrain(terr_node, 33, 1.0, 2.5, 0.8) >>>
    d.set_node_particle_emitter_3d(part_node, 512, 60.0, 1.8, 3.0, 0.25, true) >>>
    d.set_node_prefab_instance(&proj, pf_node, sub_key + "", "TurretHead", false) >>>

    doc_set := d.document() >>>
    t_true(doc_set.environment_count() == 1 && doc_set.rigid_body_3d_count() == 1, "v9 env and rb set")
    t_true(doc_set.terrain_count() == 1 && doc_set.particle_emitter_3d_count() == 1, "v9 terrain and particles set")
    t_true(doc_set.prefab_instance_count() == 1, "v9 prefab set")

    // Undo and redo preserve v9 attachments
    d.undo_edit() >>>
    t_true((d.document() >>>).prefab_instance_count() == 0, "undo removes prefab instance")
    d.redo_edit() >>>
    t_true((d.document() >>>).prefab_instance_count() == 1, "redo restores prefab instance")

    // Save and reload in fresh draft
    d.save(&proj, &val_bin) >>>
    $d2 := open_draft(scene_path + "") >>>
    doc_reopen := d2.document() >>>
    t_true(doc_reopen.environment_count() == 1 && (doc_reopen.environment(0) >>>).node == env_node, "reopened env matches")
    t_true(doc_reopen.rigid_body_3d_count() == 1 && math.abs((doc_reopen.rigid_body_3d(0) >>>).mass - 8.0) < 1e-9, "reopened rb mass matches")
    t_true(doc_reopen.terrain_count() == 1 && (doc_reopen.terrain(0) >>>).grid_x == 33, "reopened terrain matches")
    t_true(doc_reopen.particle_emitter_3d_count() == 1 && (doc_reopen.particle_emitter_3d(0) >>>).max_particles == 512, "reopened particles matches")
    t_true(doc_reopen.prefab_instance_count() == 1 && (doc_reopen.prefab_instance(0) >>>).overrides[0].target_path == "TurretHead", "reopened prefab matches")

    d2.clear_node_environment(env_node) >>>
    d2.clear_node_rigid_body_3d(rb_node) >>>
    d2.clear_node_terrain(terr_node) >>>
    d2.clear_node_particle_emitter_3d(part_node) >>>
    d2.clear_node_prefab_instance(pf_node) >>>
    t_true(!(d2.document() >>>).has_modern_attachments(), "clear removes all v9 attachments")
    << 0
}

fn test_phase5_modern_v9_components() {
    tmp := setup_fixture_project()
    _ := run_phase5_modern_v9_components(tmp + "") >>> (err) {
        cleanup_dir(tmp + "")
        t_fail("phase5: " + err.msg())
        <<
    }
    cleanup_dir(tmp + "")
}

fn run_phase6_unified_modeling_and_pbr(tmp string) int {
    proj_json := filepath.join([tmp + "", "project.json"])
    val_bin := "build/nexus-project-validate"
    scene_path := filepath.join([tmp + "", "assets", "world.xuscene"])
    proj := load_project(proj_json + "") >>>
    $d := open_draft(scene_path + "") >>>

    box_idx := d.spawn_whitebox_node(0, "box", fm.vec3(1.6, 1.4, 1.6)) >>>
    t_true(box_idx > 0 && node_has_editable_mesh(&(d.document() >>>), box_idx), "spawn_whitebox attaches EditableMesh")
    csg_idx := d.spawn_csg_hollow_node(0, fm.vec3(2.2, 1.8, 2.2), fm.vec3(1.2, 2.4, 1.2)) >>>
    t_true(csg_idx > 0 && node_has_csg_tree(&(d.document() >>>), csg_idx), "spawn_csg attaches CsgTree")

    d.apply_mesh_op(box_idx, "extrude", 0, -1, -1, 0.0, 0.4) >>>
    d.apply_mesh_op(box_idx, "inset", 0, -1, -1, 0.25, 0.0) >>>
    d.apply_mesh_op(box_idx, "bevel", 0, -1, -1, 0.0, 0.12) >>>
    d.apply_mesh_op(box_idx, "box_uv", 0, -1, -1, 0.0, 1.0) >>>
    info := inspect_node_modeling(&(d.document() >>>), box_idx)
    t_true(info.has_editable && info.faces > 6 && info.verts > 8, "extrude/inset/bevel increased geometry")

    $mat := default_studio_material()
    mat.base_color = fm.vec3(0.75, 0.12, 0.28)
    mat.metallic = 0.25
    mat.roughness = 0.42
    d.set_material_override(box_idx, 0, mat) >>>
    info_mat := inspect_node_modeling(&(d.document() >>>), box_idx)
    t_true(info_mat.has_mat && math.abs(info_mat.mat.base_color.x - 0.75) < 1e-6, "PBR override saved on box")

    d.undo_edit() >>>
    d.redo_edit() >>>
    d.save(&proj, &val_bin) >>>

    $d2 := open_draft(scene_path + "") >>>
    reloaded := d2.document() >>>
    t_true(reloaded.has_modeling_attachments(), "reloaded scene preserves v10 modeling attachments")
    re_info := inspect_node_modeling(&reloaded, box_idx)
    t_true(re_info.has_editable && re_info.faces > 6 && re_info.has_mat, "reloaded box preserves extruded faces & PBR material")

    glb_res := export_node_glb_to_project(&reloaded, box_idx, &proj_json, "assets/test_box.glb", &val_bin) >>>
    t_true(glb_res.rel_path == "assets/test_box.glb", "export_node_glb_to_project produces validated GLB")

    d2.clear_material_override(box_idx, 0) >>>
    t_true(!node_has_material_override(&(d2.document() >>>), box_idx, 0), "clear_material_override removes slot 0")
    << 0
}

fn test_phase6_unified_modeling_and_pbr() {
    tmp := setup_fixture_project()
    _ := run_phase6_unified_modeling_and_pbr(tmp + "") >>> (err) {
        cleanup_dir(tmp + "")
        t_fail("phase6: " + err.msg())
        <<
    }
    cleanup_dir(tmp + "")
}

fn run_multi_selection_batch_draft_ops(tmp string) int {
    scene_path := filepath.join([tmp + "", "assets", "world.xuscene"])
    $d := open_draft(scene_path + "") >>>
    grp := d.add_node_under(0, resource.NODE_GROUP, "BatchGroup") >>>
    n1 := d.spawn_whitebox_node(0, "box", fm.vec3(1.0, 1.0, 1.0)) >>>
    n2 := d.spawn_whitebox_node(0, "box", fm.vec3(1.0, 1.0, 1.0)) >>>
    d.set_nodes_properties_batch(
        &[n1],
        false, true, false, 0,
        true, true, true, fm.vec3(0.0, 1.0, 0.0),
        false, false, false, fm.vec3(0.0, 0.0, 0.0),
        false, false, false, fm.vec3(1.0, 1.0, 1.0)
    ) >>>
    d.set_nodes_properties_batch(
        &[n2],
        false, true, false, 0,
        true, true, true, fm.vec3(4.0, 1.0, 0.0),
        false, false, false, fm.vec3(0.0, 0.0, 0.0),
        false, false, false, fm.vec3(1.0, 1.0, 1.0)
    ) >>>

    // Material batch set / patch / clear with single-step undo
    $red := default_studio_material()
    red.base_color = fm.vec3(0.84, 0.16, 0.26)
    red.roughness = 0.52
    d.set_nodes_material_override(&[n1, n2], 0, red) >>>
    im1 := inspect_node_modeling(&(d.document() >>>), n1)
    im2 := inspect_node_modeling(&(d.document() >>>), n2)
    t_true(math.abs(im1.mat.base_color.x - 0.84) < 1e-6 && math.abs(im2.mat.base_color.x - 0.84) < 1e-6, "set_nodes_material_override sets color on both nodes")

    d.patch_nodes_material_override(
        &[n1, n2], 0,
        false, fm.vec3(0.0, 0.0, 0.0),
        false, 0.0,
        true, 0.22,
        false, 0.0,
        false, false,
        false, ""
    ) >>>
    pm1 := inspect_node_modeling(&(d.document() >>>), n1)
    pm2 := inspect_node_modeling(&(d.document() >>>), n2)
    t_near(pm1.mat.roughness, 0.22, 1e-6, "patch roughness updates node 1")
    t_near(pm2.mat.roughness, 0.22, 1e-6, "patch roughness updates node 2")
    t_near(pm1.mat.base_color.x, 0.84, 1e-6, "patch roughness preserves node 1 color")
    t_near(pm2.mat.base_color.x, 0.84, 1e-6, "patch roughness preserves node 2 color")

    d.clear_nodes_material_override(&[n1, n2], 0) >>>
    t_true(!node_has_material_override(&(d.document() >>>), n1, 0) && !node_has_material_override(&(d.document() >>>), n2, 0), "clear_nodes_material_override clears both")
    d.undo_edit() >>>
    t_true(node_has_material_override(&(d.document() >>>), n1, 0) && node_has_material_override(&(d.document() >>>), n2, 0), "single undo restores material on both nodes")

    // Partial-axis property batch: changing ONLY Y=3.0 preserves distinct X values (0.0 and 4.0)
    d.set_nodes_properties_batch(
        &[n1, n2],
        false, true, false, 0,
        false, true, false, fm.vec3(0.0, 3.0, 0.0),
        false, false, false, fm.vec3(0.0, 0.0, 0.0),
        false, false, false, fm.vec3(1.0, 1.0, 1.0)
    ) >>>
    doc_y := d.document() >>>
    dn1 := doc_y.describe_node(n1) >>>
    dn2 := doc_y.describe_node(n2) >>>
    t_near(dn1.local_3d.c3.x, 0.0, 1e-6, "partial Y update preserves node 1 X")
    t_near(dn2.local_3d.c3.x, 4.0, 1e-6, "partial Y update preserves node 2 X")
    t_near(dn1.local_3d.c3.y, 3.0, 1e-6, "partial Y update moves node 1 Y to 3")
    t_near(dn2.local_3d.c3.y, 3.0, 1e-6, "partial Y update moves node 2 Y to 3")

    d.set_nodes_visible_only(&[n1, n2], false) >>>
    doc_vis := d.document() >>>
    t_true(!(doc_vis.describe_node(n1) >>>).visible && !(doc_vis.describe_node(n2) >>>).visible, "set_nodes_visible_only hides both")
    d.undo_edit() >>>
    doc_uvis := d.document() >>>
    t_true((doc_uvis.describe_node(n1) >>>).visible && (doc_uvis.describe_node(n2) >>>).visible, "single undo restores visibility on both")

    // Batch reparent in 1 undo step
    moved := d.reparent_nodes(&[n1, n2], grp, true) >>>
    t_true(moved.len == 2, "reparent_nodes returns both remapped nodes")
    doc_rep := d.document() >>>
    t_true((doc_rep.describe_node(moved[0]) >>>).parent == grp && (doc_rep.describe_node(moved[1]) >>>).parent == grp, "both nodes reparented under group")

    // Batch duplicate creates offset copies in 1 undo step
    before_cnt := doc_rep.node_count()
    dups := d.duplicate_nodes(&moved, fm.vec3(0.5, 0.0, 0.0)) >>>
    t_true(dups.len == 2, "duplicate_nodes returns 2 new root indices")
    doc_dup := d.document() >>>
    t_true(doc_dup.node_count() == before_cnt + 2, "duplicate_nodes adds 2 nodes")
    d.undo_edit() >>>
    t_true((d.document() >>>).node_count() == before_cnt, "single undo removes both duplicated nodes")

    // Camera-anchored spawn places near anchor & avoids overlapping existing node
    s1 := d.spawn_whitebox_node_near(0, "box", fm.vec3(1.6, 1.4, 1.6), 12.0, -6.0, 0.5) >>>
    s2 := d.spawn_whitebox_node_near(0, "box", fm.vec3(1.6, 1.4, 1.6), 12.0, -6.0, 0.5) >>>
    doc_sp := d.document() >>>
    p_s1 := (doc_sp.describe_node(s1) >>>).local_3d.c3
    p_s2 := (doc_sp.describe_node(s2) >>>).local_3d.c3
    t_true(math.abs(p_s1.x - 12.0) < 0.01 && math.abs(p_s1.z + 6.0) < 0.01, "first spawn snaps near camera anchor")
    t_true(math.hypot(p_s2.x - p_s1.x, p_s2.z - p_s1.z) >= 1.3, "second spawn avoids overlap near camera anchor")
    << 0
}

fn test_multi_selection_batch_draft_ops() {
    tmp := setup_fixture_project()
    _ := run_multi_selection_batch_draft_ops(tmp + "") >>> (err) {
        cleanup_dir(tmp + "")
        t_fail("multi_selection_batch: " + err.msg())
        <<
    }
    cleanup_dir(tmp + "")
}

