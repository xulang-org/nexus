@main

proj #"github.com/xulang-org/nexus/integration/project"
resource #"github.com/xulang-org/nexus/resources/scene"
#os/exec
#errors

pub struct Entry {
    pub key string
    pub path string
    pub resolved string
}

pub struct Project {
    pub path string
    pub directory string
    pub scenes []Entry
    pub assets []Entry
}

pub struct AssetImportResult {
    pub uid string
    pub rel_path string
    pub resolved string
    pub reused bool
    pub primitive_count int
}

pub fn clone_project(p &Project) Project {
    $scenes := []Entry{}
    for i in 0:p.scenes.len {
        s := &p.scenes[i]
        scenes.push(Entry{key: s.key + "", path: s.path + "", resolved: s.resolved + ""})
    }
    $assets := []Entry{}
    for i in 0:p.assets.len {
        a := &p.assets[i]
        assets.push(Entry{key: a.key + "", path: a.path + "", resolved: a.resolved + ""})
    }
    << Project{
        path: p.path + "",
        directory: p.directory + "",
        scenes: scenes,
        assets: assets
    }
}

fn wrap_entries(src &[]proj.Entry) []Entry {
    $out := []Entry{}
    for i in 0:src.len {
        e := &src[i]
        out.push(Entry{key: e.key + "", path: e.path + "", resolved: e.resolved + ""})
    }
    << out
}

fn to_proj(p &Project) proj.Project {
    $scenes := []proj.Entry{}
    for i in 0:p.scenes.len {
        s := &p.scenes[i]
        scenes.push(proj.Entry{key: s.key + "", path: s.path + "", resolved: s.resolved + ""})
    }
    $assets := []proj.Entry{}
    for i in 0:p.assets.len {
        a := &p.assets[i]
        assets.push(proj.Entry{key: a.key + "", path: a.path + "", resolved: a.resolved + ""})
    }
    << proj.Project{path: p.path + "", directory: p.directory + "", scenes: scenes, assets: assets}
}

pub fn relative_file(raw &string) string {
    << proj.relative_file(raw) >>>
}

pub fn scene_name(raw &string) string {
    << proj.scene_name(raw) >>>
}

pub fn project_source(directory &string, relative &string) string {
    << proj.project_source(directory, relative) >>>
}

pub fn load_project(path string) Project {
    inner := proj.load_project(path + "") >>>
    << Project{
        path: inner.path + "",
        directory: inner.directory + "",
        scenes: wrap_entries(&inner.scenes),
        assets: wrap_entries(&inner.assets)
    }
}

pub fn (project &Project) scene_source(index int) string {
    p := to_proj(project)
    << p.scene_source(index) >>>
}

pub fn (project &Project) asset_source(uid &string) string {
    p := to_proj(project)
    << p.asset_source(uid) >>>
}

pub fn stage_scene(project &Project, document &resource.Document, scene_path &string, directory &string) string {
    p := to_proj(project)
    << proj.stage_scene(&p, document, scene_path, directory) >>>
}

pub fn create_scene(project_path &string, raw_key &string, root_name &string) string {
    << proj.create_scene(project_path + "", raw_key + "", root_name + "") >>>
}

pub fn import_external_glb(project_path &string, glb_path &string, validator &string) AssetImportResult {
    res := proj.import_external_glb(project_path + "", glb_path + "", validator + "") >>>
    << AssetImportResult{
        uid: res.uid + "",
        rel_path: res.rel_path + "",
        resolved: res.resolved + "",
        reused: res.reused,
        primitive_count: res.primitive_count
    }
}

pub fn validate_glb_primitives(validator &string, glb_path &string) int {
    prims := proj.validate_glb_primitives(validator + "", glb_path + "") >>>
    << prims.len
}

pub fn validate_scene_file(validator &string, scene_path &string) int {
    bin := proj.resolve_validator_path(validator + "") >>>
    out := exec.command(bin + "", "scene", scene_path + "").combined_output() >>> (err) {
        >>> errors.new("nexus editor: validator failed: " + err.msg())
    }
    _ := out
    << 0
}

pub fn publish_for_preview(project_path &string, output_dir &string, validator &string, scene_key &string, draft_doc &resource.Document) string {
    _ := proj.publish_with_drafts(project_path + "", output_dir + "", validator + "", scene_key + "", draft_doc, true) >>>
    << proj.published_scene(output_dir + "", scene_key + "") >>>
}
