@main

proj #"github.com/xulang-org/nexus/integration/project"
resource #"github.com/xulang-org/nexus/resources/scene"
#os/exec
#errors

pub struct Entry {
    pub key string
    pub path string
    pub resolved string
}

pub struct Project {
    pub path string
    pub directory string
    pub scenes []Entry
    pub assets []Entry
}

pub struct AssetImportResult {
    pub uid string
    pub rel_path string
    pub resolved string
    pub reused bool
    pub primitive_count int
}

pub struct EditorPrimitiveInfo {
    pub triangles int
    pub has_uvs bool
    pub has_tangents bool
    pub needs_uvs bool
    pub needs_tangents bool
}

pub struct EditorPublishResult {
    pub generation string
    pub root string
    pub rebuilt_assets int
    pub reused_assets int
}

pub fn clone_project(p &Project) Project {
    $scenes := []Entry{}
    for i in 0:p.scenes.len {
        s := &p.scenes[i]
        scenes.push(Entry{key: s.key + "", path: s.path + "", resolved: s.resolved + ""})
    }
    $assets := []Entry{}
    for i in 0:p.assets.len {
        a := &p.assets[i]
        assets.push(Entry{key: a.key + "", path: a.path + "", resolved: a.resolved + ""})
    }
    << Project{
        path: p.path + "",
        directory: p.directory + "",
        scenes: scenes,
        assets: assets
    }
}

fn wrap_entries(src &[]proj.Entry) []Entry {
    $out := []Entry{}
    for i in 0:src.len {
        e := &src[i]
        out.push(Entry{key: e.key + "", path: e.path + "", resolved: e.resolved + ""})
    }
    << out
}

fn to_proj(p &Project) proj.Project {
    $scenes := []proj.Entry{}
    for i in 0:p.scenes.len {
        s := &p.scenes[i]
        scenes.push(proj.Entry{key: s.key + "", path: s.path + "", resolved: s.resolved + ""})
    }
    $assets := []proj.Entry{}
    for i in 0:p.assets.len {
        a := &p.assets[i]
        assets.push(proj.Entry{key: a.key + "", path: a.path + "", resolved: a.resolved + ""})
    }
    << proj.make_project(p.path + "", p.directory + "", scenes, assets)
}

pub fn relative_file(raw &string) string {
    << proj.relative_file(raw) or >>
}

pub fn scene_name(raw &string) string {
    << proj.scene_name(raw) or >>
}

pub fn project_source(directory &string, relative &string) string {
    << proj.project_source(directory, relative) or >>
}

pub fn load_project(path string) Project {
    inner := proj.load_project(path + "") or >>
    << Project{
        path: inner.path + "",
        directory: inner.directory + "",
        scenes: wrap_entries(&inner.scenes),
        assets: wrap_entries(&inner.assets)
    }
}

pub fn (project &Project) scene_source(index int) string {
    p := to_proj(project)
    << p.scene_source(index) or >>
}

pub fn (project &Project) asset_source(uid &string) string {
    p := to_proj(project)
    << p.asset_source(uid) or >>
}

pub fn stage_scene(project &Project, document &resource.Document, scene_path &string, directory &string) string {
    p := to_proj(project)
    << proj.stage_scene(&p, document, scene_path, directory) or >>
}

pub fn create_scene(project_path &string, raw_key &string, root_name &string) string {
    << proj.create_scene(project_path + "", raw_key + "", root_name + "") or >>
}

pub fn import_external_glb(project_path &string, glb_path &string, validator &string) AssetImportResult {
    res := proj.import_external_glb(project_path + "", glb_path + "", validator + "") or >>
    << AssetImportResult{
        uid: res.uid + "",
        rel_path: res.rel_path + "",
        resolved: res.resolved + "",
        reused: res.reused,
        primitive_count: res.primitive_count
    }
}

pub fn export_glb_bytes_to_project(
    project_path string,
    rel_asset_path string,
    glb_raw &string,
    validator_bin string
) AssetImportResult {
    res := proj.export_glb_bytes_to_project(project_path + "", rel_asset_path + "", glb_raw, validator_bin + "") or >>
    << AssetImportResult{
        uid: res.uid + "",
        rel_path: res.rel_path + "",
        resolved: res.resolved + "",
        reused: res.reused,
        primitive_count: res.primitive_count
    }
}

pub fn validate_glb_primitives(validator &string, glb_path &string) int {
    prims := proj.validate_glb_primitives(validator + "", glb_path + "") or >>
    << prims.len
}

pub fn validate_scene_file(validator &string, scene_path &string) int {
    bin := proj.resolve_validator_path(validator + "") or >>
    out := exec.command(bin + "", "scene", scene_path + "").combined_output() or (err) {
        >> errors.new("nexus editor: validator failed: " + err.msg())
    }
    _ := out
    << 0
}

pub fn publish_for_preview(project_path &string, output_dir &string, validator &string, scene_key &string, draft_doc &resource.Document) string {
    _ := proj.publish_with_drafts(project_path + "", output_dir + "", validator + "", scene_key + "", draft_doc, true) or >>
    << proj.published_scene(output_dir + "", scene_key + "") or >>
}

pub fn import_external_asset(project_path &string, asset_path &string, validator &string) AssetImportResult {
    res := proj.import_external_asset(project_path + "", asset_path + "", validator + "") or >>
    << AssetImportResult{
        uid: res.uid + "",
        rel_path: res.rel_path + "",
        resolved: res.resolved + "",
        reused: res.reused,
        primitive_count: res.primitive_count
    }
}

pub fn relocate_asset(project_path &string, uid &string, source_path &string) int {
    << proj.relocate_asset(project_path + "", uid + "", source_path + "") or >>
}

pub fn remove_asset(project_path &string, uid &string) int {
    << proj.remove_asset(project_path + "", uid + "") or >>
}

pub fn rename_scene(project_path &string, old_key &string, new_key &string) string {
    << proj.rename_scene(project_path + "", old_key + "", new_key + "") or >>
}

pub fn duplicate_scene(project_path &string, src_key &string, new_key &string) string {
    << proj.duplicate_scene(project_path + "", src_key + "", new_key + "") or >>
}

pub fn delete_scene(project_path &string, target_key &string) int {
    << proj.delete_scene(project_path + "", target_key + "") or >>
}

pub fn publish_project_with_draft(
    project_path &string,
    output_dir &string,
    validator &string,
    scene_key &string,
    draft_doc &resource.Document,
    has_draft bool
) EditorPublishResult {
    res := proj.publish_with_drafts(project_path + "", output_dir + "", validator + "", scene_key + "", draft_doc, has_draft) or >>
    << EditorPublishResult{
        generation: res.generation + "",
        root: res.root + "",
        rebuilt_assets: res.rebuilt_assets,
        reused_assets: res.reused_assets
    }
}

pub fn publish_project(project_path &string, output_dir &string, validator &string) EditorPublishResult {
    empty_doc := resource.make_document([resource.node(-1, "Empty", resource.NODE_3D)]) or >>
    << publish_project_with_draft(project_path, output_dir, validator, &"", &empty_doc, false) or >>
}

pub fn inspect_glb_primitives(validator &string, glb_path &string) []EditorPrimitiveInfo {
    prims := proj.validate_glb_primitives(validator + "", glb_path + "") or >>
    $out := []EditorPrimitiveInfo{}
    for i in 0:prims.len {
        p := &prims[i]
        out.push(EditorPrimitiveInfo{
            triangles: p.triangles,
            has_uvs: p.has_uvs,
            has_tangents: p.has_tangents,
            needs_uvs: p.needs_uvs,
            needs_tangents: p.needs_tangents
        })
    }
    << out
}
