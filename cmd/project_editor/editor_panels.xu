@main

#ui
#ui/draw
#ui/layout
widgets #ui/widgets
#math
#path/filepath
#strings
#time

pub const PF_TREE_FILTER = 0

pub const PB_OPEN_PROJ = 0
pub const PB_SCENE_MGR = 1
pub const PB_EXPORT = 2
pub const PB_LANG = 3
pub const PB_NODE_UP = 4
pub const PB_NODE_DN = 5
pub const PB_RELOCATE = 6
pub const PB_REMOVE_ASSET = 7

pub const PT_ASSET_PRIMS = 0

pub struct EditorPanels {
    pub fields []widgets.Field
    pub field_ids []int
    pub buttons []widgets.Button
    pub button_ids []int
    pub btn_labels []widgets.StyledLabel
    pub texts []widgets.SelectableText
    pub text_ids []int

    pub id_open_proj_btn int
    pub id_scene_mgr_btn int
    pub id_export_btn int
    pub id_lang_btn int
    pub id_tree_hdr_row int
    pub id_node_up_btn int
    pub id_node_dn_btn int
    pub id_tree_filter int
    pub id_asset_prims int
    pub id_relocate_btn int
    pub id_remove_asset_btn int

    pub glb_prim_cache map[string]string
}

fn push_panel_btn(
    p $&EditorPanels,
    view $&widgets.View,
    parent int,
    w f64,
    h f64,
    ctx &draw.Context,
    id_ev &ui.CanvasEvent,
    title string
) int {
    nid := add_interactive(view, parent, &leaf_box(w, h), ui.CURSOR_HAND, true)
    b := widgets.button(id_ev, nid, &zero_rect()) or >>
    p.button_ids.push(nid)
    p.buttons.push(b)
    p.btn_labels.push(widgets.styled_label(ctx, &title))
    << nid
}

fn push_panel_field(
    p $&EditorPanels,
    view $&widgets.View,
    parent int,
    w f64,
    h f64,
    ctx &draw.Context,
    id_ev &ui.CanvasEvent,
    label string,
    val string
) int {
    nid := add_interactive(view, parent, &leaf_box(w, h), ui.CURSOR_TEXT, true)
    view.set_capture_outside(nid, true) or >>
    f := make_plain_field(ctx, id_ev, nid, label, val)
    p.field_ids.push(nid)
    p.fields.push(f)
    << nid
}

fn push_panel_text(
    p $&EditorPanels,
    view $&widgets.View,
    parent int,
    w f64,
    h f64,
    ctx &draw.Context,
    id_ev &ui.CanvasEvent,
    val string
) int {
    nid := add_interactive(view, parent, &leaf_box(w, h), ui.CURSOR_TEXT, true)
    view.set_capture_outside(nid, true) or >>
    $st := widgets.selectable_text(ctx, id_ev, nid, &zero_rect(), &val) or >>
    set_text_ellipsis($&st, true)
    p.text_ids.push(nid)
    p.texts.push(st)
    << nid
}

pub fn new_panels_shell() EditorPanels {
    << EditorPanels{
        fields: []widgets.Field{},
        field_ids: []int{},
        buttons: []widgets.Button{},
        button_ids: []int{},
        btn_labels: []widgets.StyledLabel{},
        texts: []widgets.SelectableText{},
        text_ids: []int{},
        id_open_proj_btn: 0,
        id_scene_mgr_btn: 0,
        id_export_btn: 0,
        id_lang_btn: 0,
        id_tree_hdr_row: 0,
        id_node_up_btn: 0,
        id_node_dn_btn: 0,
        id_tree_filter: 0,
        id_asset_prims: 0,
        id_relocate_btn: 0,
        id_remove_asset_btn: 0,
        glb_prim_cache: map[string]string{}
    }
}

pub fn panels_add_open_btn(p $&EditorPanels, view $&widgets.View, id_toolbar int, ctx &draw.Context, id_ev &ui.CanvasEvent) int {
    nid := push_panel_btn(p, view, id_toolbar, 30.0, 30.0, ctx, id_ev, "") or >>
    p.id_open_proj_btn = nid
    << 0
}

pub fn panels_add_scene_mgr_btn(p $&EditorPanels, view $&widgets.View, id_toolbar int, ctx &draw.Context, id_ev &ui.CanvasEvent) int {
    nid := push_panel_btn(p, view, id_toolbar, 30.0, 30.0, ctx, id_ev, "") or >>
    p.id_scene_mgr_btn = nid
    << 0
}

pub fn panels_add_export_btn(p $&EditorPanels, view $&widgets.View, id_toolbar int, ctx &draw.Context, id_ev &ui.CanvasEvent) int {
    nid := push_panel_btn(p, view, id_toolbar, 30.0, 30.0, ctx, id_ev, "") or >>
    p.id_export_btn = nid
    << 0
}

pub fn panels_add_lang_btn(p $&EditorPanels, view $&widgets.View, id_toolbar int, ctx &draw.Context, id_ev &ui.CanvasEvent, lang int) int {
    lbl := lang_toggle_label(lang)
    nid := push_panel_btn(p, view, id_toolbar, 42.0, 26.0, ctx, id_ev, lbl) or >>
    p.id_lang_btn = nid
    << 0
}

pub fn panels_create_tree_tools(
    p $&EditorPanels,
    view $&widgets.View,
    id_left_pane int,
    ilw f64,
    ctx &draw.Context,
    id_ev &ui.CanvasEvent
) int {
    id_row := add_box(view, id_left_pane, &row_box(ilw, 24.0, 3.0)) or >>
    id_tree_hdr := add_box(view, id_row, &leaf_box(math.max(60.0, ilw - 56.0), 24.0)) or >>
    // Button indices 4, 5
    id_up := push_panel_btn(p, view, id_row, 24.0, 24.0, ctx, id_ev, "") or >>
    id_dn := push_panel_btn(p, view, id_row, 24.0, 24.0, ctx, id_ev, "") or >>
    id_flt := push_panel_field(p, view, id_left_pane, ilw, 30.0, ctx, id_ev, "Filter tree...", "") or >>
    p.id_tree_hdr_row = id_row
    p.id_node_up_btn = id_up
    p.id_node_dn_btn = id_dn
    p.id_tree_filter = id_flt
    << id_tree_hdr
}

pub fn panels_add_asset_hdr_btns(
    p $&EditorPanels,
    view $&widgets.View,
    id_assets_hdr_row int,
    ctx &draw.Context,
    id_ev &ui.CanvasEvent
) int {
    // Button indices 7, 8
    id_rel := push_panel_btn(p, view, id_assets_hdr_row, 25.0, 24.0, ctx, id_ev, "") or >>
    id_rem := push_panel_btn(p, view, id_assets_hdr_row, 25.0, 24.0, ctx, id_ev, "") or >>
    p.id_relocate_btn = id_rel
    p.id_remove_asset_btn = id_rem
    << 0
}

pub fn panels_create_asset_extras(
    p $&EditorPanels,
    view $&widgets.View,
    id_left_pane int,
    ilw f64,
    prims_h f64,
    ctx &draw.Context,
    id_ev &ui.CanvasEvent
) int {
    id_prims := push_panel_text(p, view, id_left_pane, ilw, prims_h, ctx, id_ev, "Primitives: -") or >>
    p.id_asset_prims = id_prims
    << 0
}

pub fn panels_dispose(p $&EditorPanels) {
    for i in 0:p.fields.len { dispose_field($&p.fields[i]) }
    for i in 0:p.btn_labels.len { dispose_label($&p.btn_labels[i]) }
    for i in 0:p.texts.len { dispose_sel_text($&p.texts[i]) }
}

pub fn panels_apply_lang(p $&EditorPanels, lang int) {
    lbl := lang_toggle_label(lang)
    set_lbl_text($&p.btn_labels[PB_LANG], &lbl)
    flt_lbl := tr(lang, "Filter nodes...", "筛选节点...")
    $dec := widgets.field_decoration(&flt_lbl)
    dec.floating = widgets.LABEL_NEVER
    dec.clearable = true
    dec.reserve_helper = false
    set_field_dec($&p.fields[PF_TREE_FILTER], &dec)
    p.glb_prim_cache = map[string]string{}
}

pub fn panels_apply_styles(p $&EditorPanels, styles &widgets.Styles, pal &PaperPalette) {
    ico_sec := icon_button_style(styles, widgets.BUTTON_SECONDARY)
    ico_sub := icon_button_style(styles, widgets.BUTTON_SUBTLE)
    ico_dng := icon_danger_subtle_style(styles, pal)
    pill_sec := pill_button_style(styles, widgets.BUTTON_SECONDARY)
    set_btn_style($&p.buttons[PB_OPEN_PROJ], &ico_sec)
    set_btn_style($&p.buttons[PB_SCENE_MGR], &ico_sec)
    set_btn_style($&p.buttons[PB_EXPORT], &ico_sec)
    set_btn_style($&p.buttons[PB_LANG], &pill_sec)
    set_btn_style($&p.buttons[PB_NODE_UP], &ico_sub)
    set_btn_style($&p.buttons[PB_NODE_DN], &ico_sub)
    set_btn_style($&p.buttons[PB_RELOCATE], &ico_sub)
    set_btn_style($&p.buttons[PB_REMOVE_ASSET], &ico_dng)

    cf := inline_field_style(styles)
    set_field_style($&p.fields[PF_TREE_FILTER], &cf)

    st_meta := selectable_text_style(styles, pal, 11.0, pal.muted)
    set_text_style($&p.texts[PT_ASSET_PRIMS], &st_meta)
}

pub fn panels_place(p $&EditorPanels, view &widgets.View, styles &widgets.Styles, vp &layout.Rect) int {
    for i in 0:p.buttons.len {
        sync_local_box_button(view, p.button_ids[i], $&p.buttons[i]) or >>
    }
    for i in 0:p.fields.len {
        place_view_field(view, p.field_ids[i], styles, vp, $&p.fields[i]) or >>
    }
    for i in 0:p.texts.len {
        place_view_text(view, p.text_ids[i], vp, $&p.texts[i]) or >>
    }
    << 0
}

fn icon_for_panel_btn(idx int, sel_visible bool) int {
    _ := sel_visible
    if idx == PB_OPEN_PROJ { << ICON_OPEN }
    if idx == PB_SCENE_MGR { << ICON_SCENE_MGR }
    if idx == PB_EXPORT { << ICON_EXPORT }
    if idx == PB_NODE_UP { << ICON_UP }
    if idx == PB_NODE_DN { << ICON_DOWN }
    if idx == PB_RELOCATE { << ICON_RELOCATE }
    << ICON_DEL
}

pub fn panels_draw(
    p $&EditorPanels,
    id int,
    frame $&draw.Frame,
    bounds &layout.Rect,
    styles &widgets.Styles,
    pal &PaperPalette,
    dragging_split int,
    sel_visible bool
) int {
    _ := dragging_split
    _ := pal
    if bounds.width <= 0.5 || bounds.height <= 0.5 {
        for i in 0:p.button_ids.len { if p.button_ids[i] == id { << 1 } }
        for i in 0:p.field_ids.len { if p.field_ids[i] == id { << 1 } }
        for i in 0:p.text_ids.len { if p.text_ids[i] == id { << 1 } }
        << 0
    }
    for i in 0:p.button_ids.len {
        if p.button_ids[i] == id {
            b := p.buttons[i].clone()
            if i == PB_LANG {
                b.paint_styled(frame, $&p.btn_labels[i], styles) or >>
            } else {
                icon := icon_for_panel_btn(i, sel_visible)
                paint_icon_button(&b, $&p.btn_labels[i], icon, frame, styles) or >>
            }
            << 1
        }
    }
    for i in 0:p.field_ids.len {
        if p.field_ids[i] == id {
            paint_field($&p.fields[i], frame, styles) or >>
            << 1
        }
    }
    for i in 0:p.text_ids.len {
        if p.text_ids[i] == id {
            paint_text_sel($&p.texts[i], frame, styles) or >>
            << 1
        }
    }
    << 0
}

pub fn panels_overlay(p $&EditorPanels, frame $&draw.Frame, styles &widgets.Styles) int {
    for i in 0:p.fields.len {
        field_popup_paint($&p.fields[i], frame, styles) or >>
    }
    for i in 0:p.texts.len {
        paint_text_popup($&p.texts[i], frame, styles) or >>
    }
    << 0
}

pub fn panels_route_input(p $&EditorPanels, id int, kind int, input &ui.InputEvent) widgets.Action {
    for i in 0:p.button_ids.len {
        if p.button_ids[i] == id { << route_btn($&p.buttons[i], kind, input) }
    }
    for i in 0:p.field_ids.len {
        if p.field_ids[i] == id { << route_field($&p.fields[i], kind, input) }
    }
    for i in 0:p.text_ids.len {
        if p.text_ids[i] == id { << route_text($&p.texts[i], kind, input) }
    }
    << widgets.Action{kind: widgets.ACTION_NONE, id: id, needs_paint: false, request_focus: false, consumed: false, value: 0.0}
}

pub fn panels_has_any_popup(p &EditorPanels) bool {
    for i in 0:p.fields.len {
        if p.fields[i].has_popup_open() { << true }
    }
    for i in 0:p.texts.len {
        if p.texts[i].has_popup_open() { << true }
    }
    << false
}

pub fn panels_cursor(p &EditorPanels, view &widgets.View, x f64, y f64) int {
    for i in 0:p.fields.len {
        pc := field_popup_cursor(&p.fields[i], x, y)
        if pc >= 0 { << pc }
    }
    for i in 0:p.texts.len {
        tc := text_popup_cursor(&p.texts[i], x, y)
        if tc >= 0 { << tc }
    }
    for i in 0:p.fields.len {
        fc := field_hit_cursor(view, p.field_ids[i], &p.fields[i], x, y)
        if fc >= 0 { << fc }
    }
    for i in 0:p.texts.len {
        if node_contains(view, p.text_ids[i], x, y) { << p.texts[i].cursor_at(x, y) }
    }
    for i in 0:p.buttons.len {
        bc := btn_hit_cursor(view, p.button_ids[i], &p.buttons[i], x, y)
        if bc >= 0 { << bc }
    }
    << -1
}

pub fn panels_route_context_popups(p $&EditorPanels, view $&widgets.View, rid int, input &ui.InputEvent) bool {
    for i in 0:p.fields.len {
        if p.fields[i].has_popup_open() {
            act := field_input($&p.fields[i], input)
            if act.needs_paint { repaint(view, p.field_ids[i]) }
            repaint(view, rid)
            if act.consumed || (input.kind == ui.EV_KEY_DOWN && input.key == ui.KEY_ESCAPE) { << true }
        }
    }
    for i in 0:p.texts.len {
        if p.texts[i].has_popup_open() {
            act := text_input($&p.texts[i], input)
            if act.needs_paint { repaint(view, p.text_ids[i]) }
            repaint(view, rid)
            if act.consumed || (input.kind == ui.EV_KEY_DOWN && input.key == ui.KEY_ESCAPE) { << true }
        }
    }
    << false
}

pub fn panels_dispatch_text_or_request(p $&EditorPanels, view $&widgets.View, rid int, event &ui.Event) bool {
    $filter_changed := false
    for i in 0:p.fields.len {
        act := field_event($&p.fields[i], event)
        if act.needs_paint || act.kind == widgets.ACTION_CHANGE {
            repaint(view, p.field_ids[i])
            if p.fields[i].has_popup_open() { repaint(view, rid) }
            if i == PF_TREE_FILTER && act.kind == widgets.ACTION_CHANGE {
                filter_changed = true
            }
        }
    }
    for i in 0:p.texts.len {
        _ := dispatch_sel_text_event(view, event, $&p.texts[i])
    }
    << filter_changed
}

pub fn panels_blur_all(p $&EditorPanels) {
    for i in 0:p.fields.len { focus_field($&p.fields[i], false) }
}

pub fn panels_any_focused(p &EditorPanels) bool {
    for i in 0:p.fields.len {
        if p.fields[i].is_focused() { << true }
    }
    << false
}

pub fn panels_tick(p $&EditorPanels, view $&widgets.View, now time.Instant, rm bool) {
    for i in 0:p.fields.len {
        fid := p.field_ids[i]
        if tick_field($&p.fields[i], now, rm) { repaint(view, fid) }
    }
}

pub fn panels_next_tick(p &EditorPanels, now time.Instant, rm bool, cur time.Instant) time.Instant {
    $deadline := cur
    for i in 0:p.fields.len {
        next := field_next_tick(&p.fields[i], now, rm)
        if !next.is_zero() && (deadline.is_zero() || next.before(deadline)) {
            deadline = next
        }
    }
    << deadline
}

pub fn asset_display_label(rel_path &string) string {
    ext := strings.to_lower(&filepath.ext(rel_path))
    base := filepath.base(rel_path)
    if ext == ".glb" { << "[GLB] " + base }
    if ext == ".png" { << "[PNG] " + base }
    if ext == ".wav" { << "[WAV] " + base }
    if ext == ".xubc" { << "[XU] " + base }
    << base
}

fn try_inspect_prims(validator_bin &string, resolved &string) []EditorPrimitiveInfo {
    << inspect_glb_primitives(validator_bin, resolved) or (err) {
        _ := err
        << []EditorPrimitiveInfo{}
    }
}

pub fn format_asset_prims_summary(validator_bin &string, project &Project, asset_idx int, cache $&map[string]string, lang int) string {
    if asset_idx < 0 || asset_idx >= project.assets.len {
        << tr(lang, "Primitives: no asset selected", "图元：未选择资源")
    }
    a := &project.assets[asset_idx]
    ext := strings.to_lower(&filepath.ext(&a.path))
    if ext == ".png" { << tr(lang, "PNG image (Sprite3D / TileMap2D)", "PNG 图像 (Sprite3D / TileMap2D)") }
    if ext == ".wav" { << tr(lang, "WAV clip (AudioEmitter)", "WAV 音频 (AudioEmitter)") }
    if ext == ".xubc" { << tr(lang, "XuScript bytecode (Script)", "XuScript 字节码 (脚本)") }
    if ext != ".glb" { << tr(lang, "Asset: ", "资源: ") + filepath.base(&a.path) }

    cache_key := str(lang) + "|" + a.key + "|" + a.resolved
    if cache.has(cache_key + "") {
        << cache[cache_key + ""] + ""
    }
    if validator_bin.len == 0 {
        << tr(lang, "GLB asset", "GLB 资源")
    }
    prims := try_inspect_prims(validator_bin, &a.resolved)
    if prims.len == 0 {
        << tr(lang, "GLB asset", "GLB 资源")
    }
    $parts := []string{}
    $lim := prims.len
    if lim > 4 { lim = 4 }
    for i in 0:lim {
        pr := &prims[i]
        $tags := ""
        if pr.has_uvs { tags = tags + " UV" }
        if pr.has_tangents { tags = tags + " T" }
        parts.push("p" + str(i) + ":" + str(pr.triangles) + "t" + tags)
    }
    $summary := tr(lang, "GLB: " + str(prims.len) + " prim(s) · ", "GLB: " + str(prims.len) + " 个图元 · ") + strings.join(parts, " ")
    if prims.len > 4 {
        summary = summary + " ..."
    }
    cache[cache_key + ""] = summary + ""
    << summary
}
