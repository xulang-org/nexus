@main

fm #"github.com/xulang-org/nexus/foundation/math"
canvas #"github.com/xulang-org/nexus/resources/canvas"
camera_data #"github.com/xulang-org/nexus/resources/camera"
meshes #"github.com/xulang-org/nexus/resources/mesh"
imod #"github.com/xulang-org/nexus/integration/modeling"
scene #"github.com/xulang-org/nexus/scene"
layout #ui/layout
#math
#errors

const LAYOUT_SINGLE = 0
const LAYOUT_SPLIT = 1

const ORTHO_TOP = 0
const ORTHO_FRONT = 1
const ORTHO_RIGHT = 2

const STUDIO_CANVAS = 0x23262bff
const STUDIO_TEXT = 0xe8ecf2ff
const STUDIO_MUTED = 0x8a92a0ff
const STUDIO_BRAND = 0x2f66d8ff
const STUDIO_AXIS_X = 0xd94b4bff
const STUDIO_AXIS_Y = 0x57ad57ff
const STUDIO_AXIS_Z = 0x4782daff
const STUDIO_GRID_MINOR = 0x2c3038ff
const STUDIO_GRID_MAJOR = 0x3b414dff
const STUDIO_WIRE_IDLE = 0x8f9ab0ff
const STUDIO_WIRE_SEL = 0xf28c28ff
const STUDIO_WIRE_VERT = 0x5ca0ffff
const STUDIO_DIVIDER = 0x131519ff

struct ViewportRect {
    x f64
    y f64
    w f64
    h f64
}

struct StudioLayout {
    win_w f64
    win_h f64
    top_rect layout.Rect
    left_rect layout.Rect
    right_rect layout.Rect
    outliner_rect layout.Rect
    inspector_rect layout.Rect
    bot_rect layout.Rect
    persp ViewportRect
    ortho ViewportRect
    has_ortho bool
}

struct OrbitState {
    center fm.Vec3
    distance f64
    yaw f64
    pitch f64
    ortho_size f64
    ortho_axis int
}

struct StudioCamera {
    is_ortho bool
    position fm.Vec3
    right fm.Vec3
    up fm.Vec3
    forward fm.Vec3
    view fm.Mat4
    proj fm.Mat4
    vp fm.Mat4
    ortho_size f64
    tangent f64
    near f64
    far f64
}

struct ProjectedPt {
    pos fm.Vec2
    visible bool
}

fn default_orbit_state() OrbitState {
    << OrbitState{
        center: fm.vec3(0.0, 0.5, 0.0),
        distance: 6.0,
        yaw: 0.55,
        pitch: 0.42,
        ortho_size: 7.5,
        ortho_axis: ORTHO_TOP
    }
}

fn compute_studio_layout(w f64, h f64, mode int) StudioLayout {
    top_h := 36.0
    bot_h := 24.0
    $left_w := 168.0
    $right_w := 264.0
    if w < 860.0 {
        left_w = math.max(132.0, w * 0.20)
        right_w = math.max(196.0, w * 0.28)
    }
    body_h := math.max(120.0, h - top_h - bot_h)
    center_x := left_w
    center_y := top_h
    center_w := math.max(120.0, w - left_w - right_w)
    top_r := layout.Rect{x: 0.0, y: 0.0, width: w, height: top_h}
    left_r := layout.Rect{x: 0.0, y: top_h, width: left_w, height: body_h}
    right_r := layout.Rect{x: w - right_w, y: top_h, width: right_w, height: body_h}
    outliner_h := math.min(188.0, math.max(108.0, math.floor(body_h * 0.27)))
    outliner_r := layout.Rect{x: w - right_w, y: top_h, width: right_w, height: outliner_h}
    inspector_r := layout.Rect{x: w - right_w, y: top_h + outliner_h + 1.0, width: right_w, height: math.max(80.0, body_h - outliner_h - 1.0)}
    bot_r := layout.Rect{x: 0.0, y: top_h + body_h, width: w, height: bot_h}

    if mode == LAYOUT_SPLIT && center_w >= 180.0 {
        lw := math.floor(center_w * 0.57)
        rw := center_w - lw - 2.0
        persp := ViewportRect{x: center_x, y: center_y, w: lw, h: body_h}
        ortho := ViewportRect{x: center_x + lw + 2.0, y: center_y, w: rw, h: body_h}
        << StudioLayout{
            win_w: w, win_h: h,
            top_rect: top_r, left_rect: left_r, right_rect: right_r,
            outliner_rect: outliner_r, inspector_rect: inspector_r, bot_rect: bot_r,
            persp: persp, ortho: ortho, has_ortho: true
        }
    }
    persp := ViewportRect{x: center_x, y: center_y, w: center_w, h: body_h}
    << StudioLayout{
        win_w: w, win_h: h,
        top_rect: top_r, left_rect: left_r, right_rect: right_r,
        outliner_rect: outliner_r, inspector_rect: inspector_r, bot_rect: bot_r,
        persp: persp, ortho: ViewportRect{x: 0.0, y: 0.0, w: 0.0, h: 0.0}, has_ortho: false
    }
}

fn (r ViewportRect) contains(p fm.Vec2) bool {
    << p.x >= r.x && p.x <= r.x + r.w && p.y >= r.y && p.y <= r.y + r.h
}

fn build_persp_camera(orbit OrbitState, rect ViewportRect) StudioCamera {
    dir := fm.vec3(
        math.sin(orbit.yaw) * math.cos(orbit.pitch),
        math.sin(orbit.pitch),
        math.cos(orbit.yaw) * math.cos(orbit.pitch)
    )
    fov := 1.0471975511965976
    near := math.max(0.01, orbit.distance * 0.002)
    far := math.max(800.0, orbit.distance * 40.0)
    pos := orbit.center.add(dir.scaled(orbit.distance))
    fwd := dir.scaled(-1.0)
    right := fwd.cross(fm.vec3(0.0, 1.0, 0.0)).normalized() >>>
    up := right.cross(fwd)
    aspect := math.max(0.1, rect.w) / math.max(0.1, rect.h)
    view := scene.look_at_3d(pos, orbit.center, fm.vec3(0.0, 1.0, 0.0)) >>>
    proj := scene.perspective_3d(fov, aspect, near, far) >>>
    << StudioCamera{
        is_ortho: false,
        position: pos, right: right, up: up, forward: fwd,
        view: view, proj: proj, vp: proj.multiply(view),
        ortho_size: orbit.ortho_size,
        tangent: math.tan(fov * 0.5),
        near: near, far: far
    }
}

fn build_ortho_camera(orbit OrbitState, rect ViewportRect) StudioCamera {
    $axis_dir := fm.vec3(0.0, 1.0, 0.0)
    $up_vec := fm.vec3(0.0, 0.0, -1.0)
    if orbit.ortho_axis == ORTHO_FRONT {
        axis_dir = fm.vec3(0.0, 0.0, 1.0)
        up_vec = fm.vec3(0.0, 1.0, 0.0)
    } else if orbit.ortho_axis == ORTHO_RIGHT {
        axis_dir = fm.vec3(1.0, 0.0, 0.0)
        up_vec = fm.vec3(0.0, 1.0, 0.0)
    }
    near := 0.05
    far := 400.0
    pos := orbit.center.add(axis_dir.scaled(40.0))
    fwd := axis_dir.scaled(-1.0)
    right := fwd.cross(up_vec).normalized() >>>
    up := right.cross(fwd)
    aspect := math.max(0.1, rect.w) / math.max(0.1, rect.h)
    view := scene.look_at_3d(pos, orbit.center, up_vec) >>>
    lens := camera_data.orthographic(orbit.ortho_size, near, far) >>>
    proj := lens.projection(aspect) >>>
    << StudioCamera{
        is_ortho: true,
        position: pos, right: right, up: up, forward: fwd,
        view: view, proj: proj, vp: proj.multiply(view),
        ortho_size: orbit.ortho_size,
        tangent: 1.0,
        near: near, far: far
    }
}

fn (cam &StudioCamera) project(world fm.Vec3, rect ViewportRect) ProjectedPt {
    clip := cam.vp.transform(fm.vec4(world.x, world.y, world.z, 1.0))
    if !clip.is_finite() { << ProjectedPt{pos: fm.vec2(0.0, 0.0), visible: false} }
    if !cam.is_ortho && clip.w < cam.near {
        << ProjectedPt{pos: fm.vec2(0.0, 0.0), visible: false}
    }
    if math.abs(clip.w) <= 1e-8 { << ProjectedPt{pos: fm.vec2(0.0, 0.0), visible: false} }
    nx := clip.x / clip.w
    ny := clip.y / clip.w
    pt := fm.vec2(rect.x + (nx + 1.0) * 0.5 * rect.w, rect.y + (1.0 - ny) * 0.5 * rect.h)
    vis := fm.finite(pt.x) && fm.finite(pt.y) && rect.contains(pt)
    << ProjectedPt{pos: pt, visible: vis}
}

fn (cam &StudioCamera) ray(point fm.Vec2, rect ViewportRect) fm.Ray3D {
    rw := math.max(1.0, rect.w)
    rh := math.max(1.0, rect.h)
    lx := point.x - rect.x
    ly := point.y - rect.y
    if cam.is_ortho {
        nx := (2.0 * lx / rw) - 1.0
        ny := 1.0 - (2.0 * ly / rh)
        half_h := cam.ortho_size * 0.5
        half_w := half_h * (rw / rh)
        origin := cam.position.add(cam.right.scaled(nx * half_w)).add(cam.up.scaled(ny * half_h))
        << fm.ray3d(origin, cam.forward) >>>
    }
    px := (2.0 * lx - rw) / rh * cam.tangent
    py := (1.0 - 2.0 * ly / rh) * cam.tangent
    dir := cam.forward.add(cam.right.scaled(px)).add(cam.up.scaled(py))
    << fm.ray3d(cam.position, dir) >>>
}

fn (cam &StudioCamera) project_unclipped(world fm.Vec3, rect ViewportRect) ProjectedPt {
    clip := cam.vp.transform(fm.vec4(world.x, world.y, world.z, 1.0))
    if !clip.is_finite() { << ProjectedPt{pos: fm.vec2(0.0, 0.0), visible: false} }
    if !cam.is_ortho && clip.w < cam.near {
        << ProjectedPt{pos: fm.vec2(0.0, 0.0), visible: false}
    }
    if math.abs(clip.w) <= 1e-8 { << ProjectedPt{pos: fm.vec2(0.0, 0.0), visible: false} }
    nx := clip.x / clip.w
    ny := clip.y / clip.w
    pt := fm.vec2(rect.x + (nx + 1.0) * 0.5 * rect.w, rect.y + (1.0 - ny) * 0.5 * rect.h)
    vis := fm.finite(pt.x) && fm.finite(pt.y)
    << ProjectedPt{pos: pt, visible: vis}
}

fn draw_studio_stroke(batch $&canvas.Batch2D, a fm.Vec2, b fm.Vec2, width f64, color int) int {
    delta := b.sub(a)
    len := delta.length()
    if len <= 0.0001 { << 0 }
    perp := fm.vec2(-delta.y / len, delta.x / len).scaled(width * 0.5)
    batch.triangle(a.sub(perp), b.sub(perp), b.add(perp), color) >>>
    batch.triangle(a.sub(perp), b.add(perp), a.add(perp), color) >>>
    << 0
}

fn draw_pane_segment(batch $&canvas.Batch2D, cam &StudioCamera, rect ViewportRect, a fm.Vec3, b fm.Vec3, width f64, color int) int {
    pa := cam.project_unclipped(a, rect)
    pb := cam.project_unclipped(b, rect)
    if !pa.visible || !pb.visible { << 0 }
    // Liang-Barsky 2D segment clip to exact pane bounds
    x0 := pa.pos.x
    y0 := pa.pos.y
    dx := pb.pos.x - x0
    dy := pb.pos.y - y0
    $t0 := 0.0
    $t1 := 1.0
    xmin := rect.x
    xmax := rect.x + rect.w
    ymin := rect.y
    ymax := rect.y + rect.h
    ps := [-dx, dx, -dy, dy]
    qs := [x0 - xmin, xmax - x0, y0 - ymin, ymax - y0]
    for i in 0:4 {
        p := ps[i]
        q := qs[i]
        if math.abs(p) < 1e-9 {
            if q < 0.0 { << 0 }
        } else {
            r := q / p
            if p < 0.0 {
                if r > t1 { << 0 }
                if r > t0 { t0 = r }
            } else {
                if r < t0 { << 0 }
                if r < t1 { t1 = r }
            }
        }
    }
    if t0 > t1 { << 0 }
    c0 := fm.vec2(x0 + t0 * dx, y0 + t0 * dy)
    c1 := fm.vec2(x0 + t1 * dx, y0 + t1 * dy)
    draw_studio_stroke(batch, c0, c1, width, color) >>>
    << 0
}

fn draw_pane_grid(batch $&canvas.Batch2D, cam &StudioCamera, rect ViewportRect, ortho_axis int, show_grid bool) int {
    if !show_grid || rect.w < 16.0 || rect.h < 16.0 { << 0 }
    $k := -10
    while k <= 10 {
        fk := f64(k)
        $col_a := STUDIO_GRID_MINOR
        $w_a := 0.5
        $col_b := STUDIO_GRID_MINOR
        $w_b := 0.5
        if k % 5 == 0 && k != 0 {
            col_a = STUDIO_GRID_MAJOR
            w_a = 0.8
            col_b = STUDIO_GRID_MAJOR
            w_b = 0.8
        }
        if !cam.is_ortho || ortho_axis == ORTHO_TOP {
            if k == 0 {
                col_a = STUDIO_AXIS_Z
                w_a = 1.2
                col_b = STUDIO_AXIS_X
                w_b = 1.2
            }
            draw_pane_segment(batch, cam, rect, fm.vec3(fk, 0.0, -10.0), fm.vec3(fk, 0.0, 10.0), w_a, col_a) >>>
            draw_pane_segment(batch, cam, rect, fm.vec3(-10.0, 0.0, fk), fm.vec3(10.0, 0.0, fk), w_b, col_b) >>>
        } else if ortho_axis == ORTHO_FRONT {
            if k == 0 {
                col_a = STUDIO_AXIS_Y
                w_a = 1.2
                col_b = STUDIO_AXIS_X
                w_b = 1.2
            }
            draw_pane_segment(batch, cam, rect, fm.vec3(fk, -10.0, 0.0), fm.vec3(fk, 10.0, 0.0), w_a, col_a) >>>
            draw_pane_segment(batch, cam, rect, fm.vec3(-10.0, fk, 0.0), fm.vec3(10.0, fk, 0.0), w_b, col_b) >>>
        } else {
            if k == 0 {
                col_a = STUDIO_AXIS_Y
                w_a = 1.2
                col_b = STUDIO_AXIS_Z
                w_b = 1.2
            }
            draw_pane_segment(batch, cam, rect, fm.vec3(0.0, -10.0, fk), fm.vec3(0.0, 10.0, fk), w_a, col_a) >>>
            draw_pane_segment(batch, cam, rect, fm.vec3(0.0, fk, -10.0), fm.vec3(0.0, fk, 10.0), w_b, col_b) >>>
        }
        k += 1
    }
    << 0
}

fn draw_pane_whitebox(
    batch $&canvas.Batch2D,
    sess &imod.EditableModelSession,
    world fm.Mat4,
    cam &StudioCamera,
    rect ViewportRect,
    show_wire bool
) int {
    if !show_wire || rect.w < 16.0 || rect.h < 16.0 { << 0 }
    $dbg := meshes.new_debug_draw_3d(0.01) >>>
    sess.build_debug_wireframe($&dbg, world, STUDIO_WIRE_IDLE, STUDIO_WIRE_SEL, STUDIO_WIRE_VERT) >>>
    count := dbg.segment_count()
    for i in 0:count {
        col := dbg.segment_color(i)
        $w := 1.0
        if col == STUDIO_WIRE_SEL { w = 1.9 }
        draw_pane_segment(batch, cam, rect, dbg.segment_a(i), dbg.segment_b(i), w, col) >>>
    }
    << 0
}
