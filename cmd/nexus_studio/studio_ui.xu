@main

ui_bridge #"github.com/xulang-org/nexus/integration/ui"
rm #"github.com/xulang-org/nexus/resources/modeling"
imod #"github.com/xulang-org/nexus/integration/modeling"
fm #"github.com/xulang-org/nexus/foundation/math"
draw #ui/draw
layout #ui/layout
#math
#strconv

const COL_BG_APP = 2171429
const OUTLINER_SLOTS = 7

fn studio_rgb(r int, g int, b int) draw.Color { << draw.rgb(r, g, b) }
fn studio_rgba(r int, g int, b int, a int) draw.Color { << draw.rgba(r, g, b, a) }

struct StudioUiIds {
    btn_layout int
    btn_ortho_axis int
    btn_toggle_grid int
    btn_toggle_wire int
    btn_save_v10 int
    btn_export_glb int

    btn_box int
    btn_wedge int
    btn_stair int
    btn_cyl int
    btn_arch int
    btn_csg_hollow int

    btn_mode_obj int
    btn_mode_vert int
    btn_mode_edge int
    btn_mode_face int

    btn_extrude int
    btn_inset int
    btn_bevel int
    btn_box_uv int
    btn_undo int
    btn_redo int

    outliner_0 int
    outliner_1 int
    outliner_2 int
    outliner_3 int
    outliner_4 int
    outliner_5 int
    outliner_6 int

    sl_pos_x int
    sl_pos_y int
    sl_pos_z int
    sl_metallic int
    sl_roughness int
    sl_base_r int
    sl_base_g int
    sl_base_b int
    lbl_status int
}

struct StudioUiHost {
    tree ui_bridge.UiControlTree
    ids StudioUiIds
}

fn fmt_short(v f64) string {
    r := math.round(v * 100.0) / 100.0
    << strconv.format_float(r, 102, 2) >>> (err) {
        _ := err
        << "0.00"
    }
}

fn fmt_signed(v f64) string {
    s := fmt_short(v)
    if v >= 0.0 && s != "-0.00" { << "+" + s }
    << s
}

fn outliner_btn_id(ids &StudioUiIds, idx int) int {
    if idx == 0 { << ids.outliner_0 }
    if idx == 1 { << ids.outliner_1 }
    if idx == 2 { << ids.outliner_2 }
    if idx == 3 { << ids.outliner_3 }
    if idx == 4 { << ids.outliner_4 }
    if idx == 5 { << ids.outliner_5 }
    if idx == 6 { << ids.outliner_6 }
    << 0
}

fn resolve_ui_target_id(ids &StudioUiIds, name string) int {
    if name == "layout" { << ids.btn_layout }
    if name == "ortho_axis" { << ids.btn_ortho_axis }
    if name == "toggle_grid" { << ids.btn_toggle_grid }
    if name == "toggle_wire" { << ids.btn_toggle_wire }
    if name == "save_v10" { << ids.btn_save_v10 }
    if name == "export_glb" { << ids.btn_export_glb }
    if name == "box" { << ids.btn_box }
    if name == "wedge" { << ids.btn_wedge }
    if name == "stair" { << ids.btn_stair }
    if name == "cylinder" { << ids.btn_cyl }
    if name == "arch" { << ids.btn_arch }
    if name == "csg_hollow" { << ids.btn_csg_hollow }
    if name == "mode_obj" { << ids.btn_mode_obj }
    if name == "mode_vert" { << ids.btn_mode_vert }
    if name == "mode_edge" { << ids.btn_mode_edge }
    if name == "mode_face" { << ids.btn_mode_face }
    if name == "extrude" { << ids.btn_extrude }
    if name == "inset" { << ids.btn_inset }
    if name == "bevel" { << ids.btn_bevel }
    if name == "box_uv" { << ids.btn_box_uv }
    if name == "undo" { << ids.btn_undo }
    if name == "redo" { << ids.btn_redo }
    if name == "pos_x" { << ids.sl_pos_x }
    if name == "pos_y" { << ids.sl_pos_y }
    if name == "pos_z" { << ids.sl_pos_z }
    if name == "metallic" { << ids.sl_metallic }
    if name == "roughness" { << ids.sl_roughness }
    if name == "base_r" { << ids.sl_base_r }
    if name == "base_g" { << ids.sl_base_g }
    if name == "base_b" { << ids.sl_base_b }
    for i in 0:OUTLINER_SLOTS {
        if name == ("outliner_" + str(i)) { << outliner_btn_id(ids, i) }
    }
    << 0
}

fn style_toolbar_btn(t $&ui_bridge.UiControlTree, id int, radius f64, font_size f64) int {
    t.set_style(id, studio_rgb(40, 44, 53), studio_rgb(56, 62, 74), studio_rgb(220, 226, 236), radius, 1.0) >>>
    t.set_interactive_colors(id, studio_rgb(52, 58, 70), studio_rgb(31, 34, 42),
        studio_rgb(47, 102, 216), studio_rgb(92, 146, 248), studio_rgb(250, 252, 255)) >>>
    t.set_text_style(id, font_size, 0.5, 0.0) >>>
    << 0
}

fn style_primary_btn(t $&ui_bridge.UiControlTree, id int, radius f64, font_size f64) int {
    t.set_style(id, studio_rgb(47, 102, 216), studio_rgb(84, 138, 245), studio_rgb(248, 250, 255), radius, 1.0) >>>
    t.set_interactive_colors(id, studio_rgb(59, 114, 228), studio_rgb(36, 82, 182),
        studio_rgb(47, 102, 216), studio_rgb(92, 146, 248), studio_rgb(250, 252, 255)) >>>
    t.set_text_style(id, font_size, 0.5, 0.0) >>>
    << 0
}

fn style_tool_tile(t $&ui_bridge.UiControlTree, id int) int {
    t.set_style(id, studio_rgb(38, 42, 50), studio_rgb(54, 60, 72), studio_rgb(218, 224, 234), 5.0, 1.0) >>>
    t.set_interactive_colors(id, studio_rgb(49, 55, 66), studio_rgb(30, 34, 41),
        studio_rgb(47, 102, 216), studio_rgb(92, 146, 248), studio_rgb(250, 252, 255)) >>>
    t.set_text_style(id, 11.0, 0.5, 24.0) >>>
    << 0
}

fn style_integrated_slider(t $&ui_bridge.UiControlTree, id int, accent draw.Color) int {
    t.set_style(id, studio_rgb(36, 40, 48), studio_rgb(54, 60, 72), studio_rgb(206, 213, 225), 4.0, 1.0) >>>
    t.set_interactive_colors(id, studio_rgb(45, 50, 60), studio_rgb(32, 36, 44),
        studio_rgb(47, 102, 216), studio_rgb(92, 146, 248), studio_rgb(250, 252, 255)) >>>
    t.set_accent(id, accent) >>>
    t.set_text_style(id, 11.5, 0.0, 0.0) >>>
    t.set_slider_integrated(id, true) >>>
    << 0
}

fn build_studio_ui(lay &StudioLayout, router $&ui_bridge.HudRouter) StudioUiHost {
    $t := ui_bridge.new_control_tree()
    c_panel := studio_rgb(26, 28, 33)
    c_bar := studio_rgb(21, 23, 28)
    c_border := studio_rgb(42, 47, 56)

    // Top Header Bar (36px)
    top_p := t.add_panel(-1, lay.top_rect, ui_bridge.UI_LAYOUT_FIXED, 0.0, 0.0) >>>
    t.set_style(top_p, c_bar, c_border, studio_rgb(232, 236, 242), 0.0, 0.0) >>>

    // Segmented Mode selector pill (left-center)
    btn_mode_obj := t.add_button(top_p, layout.Rect{x: 124.0, y: 6.0, width: 46.0, height: 24.0}, "Obj", 10) >>>
    btn_mode_vert := t.add_button(top_p, layout.Rect{x: 171.0, y: 6.0, width: 46.0, height: 24.0}, "Vert", 11) >>>
    btn_mode_edge := t.add_button(top_p, layout.Rect{x: 218.0, y: 6.0, width: 46.0, height: 24.0}, "Edge", 12) >>>
    btn_mode_face := t.add_button(top_p, layout.Rect{x: 265.0, y: 6.0, width: 46.0, height: 24.0}, "Face", 13) >>>
    style_toolbar_btn($&t, btn_mode_obj, 4.0, 11.5) >>>
    style_toolbar_btn($&t, btn_mode_vert, 4.0, 11.5) >>>
    style_toolbar_btn($&t, btn_mode_edge, 4.0, 11.5) >>>
    style_toolbar_btn($&t, btn_mode_face, 4.0, 11.5) >>>

    // Center Viewport & Shading Controls
    right_action_w := 304.0
    center_min_x := 326.0
    center_max_x := math.max(center_min_x, lay.win_w - right_action_w - 294.0)
    cx := math.max(center_min_x, math.min(center_max_x, lay.win_w * 0.5 - 144.0))
    btn_layout := t.add_button(top_p, layout.Rect{x: cx, y: 6.0, width: 72.0, height: 24.0}, "Split", 1) >>>
    btn_ortho_axis := t.add_button(top_p, layout.Rect{x: cx + 76.0, y: 6.0, width: 92.0, height: 24.0}, "Ortho: Top", 2) >>>
    btn_toggle_grid := t.add_button(top_p, layout.Rect{x: cx + 174.0, y: 6.0, width: 52.0, height: 24.0}, "Grid", 3) >>>
    btn_toggle_wire := t.add_button(top_p, layout.Rect{x: cx + 230.0, y: 6.0, width: 52.0, height: 24.0}, "Wire", 4) >>>
    style_toolbar_btn($&t, btn_layout, 4.0, 11.5) >>>
    style_toolbar_btn($&t, btn_ortho_axis, 4.0, 11.5) >>>
    style_toolbar_btn($&t, btn_toggle_grid, 4.0, 11.5) >>>
    style_toolbar_btn($&t, btn_toggle_wire, 4.0, 11.5) >>>

    // Right File / History Actions (right-anchored)
    rx0 := math.max(cx + 292.0, lay.win_w - 292.0)
    btn_undo := t.add_button(top_p, layout.Rect{x: rx0, y: 6.0, width: 46.0, height: 24.0}, "Undo", 5) >>>
    btn_redo := t.add_button(top_p, layout.Rect{x: rx0 + 50.0, y: 6.0, width: 46.0, height: 24.0}, "Redo", 6) >>>
    btn_save_v10 := t.add_button(top_p, layout.Rect{x: rx0 + 104.0, y: 6.0, width: 78.0, height: 24.0}, "Save v10", 7) >>>
    btn_export_glb := t.add_button(top_p, layout.Rect{x: rx0 + 188.0, y: 6.0, width: 94.0, height: 24.0}, "Export GLB", 8) >>>
    style_toolbar_btn($&t, btn_undo, 4.0, 11.5) >>>
    style_toolbar_btn($&t, btn_redo, 4.0, 11.5) >>>
    style_toolbar_btn($&t, btn_save_v10, 4.0, 11.5) >>>
    style_primary_btn($&t, btn_export_glb, 4.0, 11.5) >>>

    // Left Modeling Tool Shelf (168px)
    left_p := t.add_panel(-1, lay.left_rect, ui_bridge.UI_LAYOUT_FIXED, 0.0, 0.0) >>>
    t.set_style(left_p, c_panel, c_border, studio_rgb(232, 236, 242), 0.0, 0.0) >>>
    tile_w := math.floor((lay.left_rect.width - 20.0) * 0.5)
    c0 := 7.0
    c1 := 7.0 + tile_w + 6.0
    th := 46.0

    btn_box := t.add_button(left_p, layout.Rect{x: c0, y: 30.0, width: tile_w, height: th}, "Box", 20) >>>
    btn_wedge := t.add_button(left_p, layout.Rect{x: c1, y: 30.0, width: tile_w, height: th}, "Wedge", 21) >>>
    btn_stair := t.add_button(left_p, layout.Rect{x: c0, y: 82.0, width: tile_w, height: th}, "Stair", 22) >>>
    btn_cyl := t.add_button(left_p, layout.Rect{x: c1, y: 82.0, width: tile_w, height: th}, "Cylinder", 23) >>>
    btn_arch := t.add_button(left_p, layout.Rect{x: c0, y: 134.0, width: tile_w, height: th}, "Arch", 24) >>>
    btn_csg_hollow := t.add_button(left_p, layout.Rect{x: c1, y: 134.0, width: tile_w, height: th}, "CSG Cut", 25) >>>
    style_tool_tile($&t, btn_box) >>>
    style_tool_tile($&t, btn_wedge) >>>
    style_tool_tile($&t, btn_stair) >>>
    style_tool_tile($&t, btn_cyl) >>>
    style_tool_tile($&t, btn_arch) >>>
    style_tool_tile($&t, btn_csg_hollow) >>>

    btn_extrude := t.add_button(left_p, layout.Rect{x: c0, y: 220.0, width: tile_w, height: th}, "Extrude", 26) >>>
    btn_inset := t.add_button(left_p, layout.Rect{x: c1, y: 220.0, width: tile_w, height: th}, "Inset", 27) >>>
    btn_bevel := t.add_button(left_p, layout.Rect{x: c0, y: 272.0, width: tile_w, height: th}, "Bevel", 28) >>>
    btn_box_uv := t.add_button(left_p, layout.Rect{x: c1, y: 272.0, width: tile_w, height: th}, "Box UV", 29) >>>
    style_tool_tile($&t, btn_extrude) >>>
    style_tool_tile($&t, btn_inset) >>>
    style_tool_tile($&t, btn_bevel) >>>
    style_tool_tile($&t, btn_box_uv) >>>

    // Right Dock: Top Outliner Panel
    out_p := t.add_panel(-1, lay.outliner_rect, ui_bridge.UI_LAYOUT_FIXED, 0.0, 0.0) >>>
    t.set_style(out_p, c_panel, c_border, studio_rgb(232, 236, 242), 0.0, 0.0) >>>
    $outliner_btns := []int{}
    out_w := math.max(100.0, lay.outliner_rect.width - 12.0)
    for i in 0:OUTLINER_SLOTS {
        bid := t.add_button(out_p, layout.Rect{x: 6.0, y: 28.0 + f64(i) * 22.0, width: out_w, height: 20.0}, "Node", 40 + i) >>>
        t.set_style(bid, studio_rgba(0, 0, 0, 0), studio_rgba(0, 0, 0, 0), studio_rgb(206, 213, 226), 3.0, 0.0) >>>
        t.set_interactive_colors(bid, studio_rgb(42, 47, 57), studio_rgb(33, 37, 46),
            studio_rgb(44, 91, 188), studio_rgb(92, 146, 248), studio_rgb(248, 251, 255)) >>>
        t.set_text_style(bid, 11.5, 0.0, 0.0) >>>
        outliner_btns.push(bid)
    }

    // Right Dock: Bottom Inspector Panel
    insp_p := t.add_panel(-1, lay.inspector_rect, ui_bridge.UI_LAYOUT_FIXED, 0.0, 0.0) >>>
    t.set_style(insp_p, c_panel, c_border, studio_rgb(232, 236, 242), 0.0, 0.0) >>>
    sl_w := math.max(120.0, lay.inspector_rect.width - 16.0)

    // Transform Section sliders
    sl_pos_x := t.add_slider(insp_p, layout.Rect{x: 8.0, y: 30.0, width: sl_w, height: 24.0}, "Position X", -8.0, 8.0, 0.0, 50) >>>
    sl_pos_y := t.add_slider(insp_p, layout.Rect{x: 8.0, y: 58.0, width: sl_w, height: 24.0}, "Position Y", -8.0, 8.0, 0.0, 51) >>>
    sl_pos_z := t.add_slider(insp_p, layout.Rect{x: 8.0, y: 86.0, width: sl_w, height: 24.0}, "Position Z", -8.0, 8.0, 0.0, 52) >>>
    style_integrated_slider($&t, sl_pos_x, studio_rgb(217, 75, 75)) >>>
    style_integrated_slider($&t, sl_pos_y, studio_rgb(87, 173, 87)) >>>
    style_integrated_slider($&t, sl_pos_z, studio_rgb(71, 130, 218)) >>>

    // Material PBR Section sliders
    sl_base_r := t.add_slider(insp_p, layout.Rect{x: 8.0, y: 150.0, width: sl_w, height: 24.0}, "Albedo R", 0.0, 1.0, 0.82, 53) >>>
    sl_base_g := t.add_slider(insp_p, layout.Rect{x: 8.0, y: 178.0, width: sl_w, height: 24.0}, "Albedo G", 0.0, 1.0, 0.82, 54) >>>
    sl_base_b := t.add_slider(insp_p, layout.Rect{x: 8.0, y: 206.0, width: sl_w, height: 24.0}, "Albedo B", 0.0, 1.0, 0.85, 55) >>>
    sl_metallic := t.add_slider(insp_p, layout.Rect{x: 8.0, y: 234.0, width: sl_w, height: 24.0}, "Metallic", 0.0, 1.0, 0.0, 56) >>>
    sl_roughness := t.add_slider(insp_p, layout.Rect{x: 8.0, y: 262.0, width: sl_w, height: 24.0}, "Roughness", 0.04, 1.0, 0.72, 57) >>>
    style_integrated_slider($&t, sl_base_r, studio_rgb(217, 75, 75)) >>>
    style_integrated_slider($&t, sl_base_g, studio_rgb(87, 173, 87)) >>>
    style_integrated_slider($&t, sl_base_b, studio_rgb(71, 130, 218)) >>>
    style_integrated_slider($&t, sl_metallic, studio_rgb(107, 155, 242)) >>>
    style_integrated_slider($&t, sl_roughness, studio_rgb(216, 162, 74)) >>>

    // Bottom Status Bar (24px)
    bot_p := t.add_panel(-1, lay.bot_rect, ui_bridge.UI_LAYOUT_FIXED, 0.0, 0.0) >>>
    t.set_style(bot_p, studio_rgb(20, 22, 26), c_border, studio_rgb(210, 216, 228), 0.0, 0.0) >>>
    lbl_status := t.add_label(bot_p, layout.Rect{x: 24.0, y: 2.0, width: math.max(180.0, lay.win_w * 0.48), height: 20.0}, "Ready") >>>
    t.set_style(lbl_status, studio_rgba(0, 0, 0, 0), studio_rgba(0, 0, 0, 0), studio_rgb(206, 213, 226), 0.0, 0.0) >>>
    t.set_text_style(lbl_status, 11.0, 0.0, 0.0) >>>

    _ := t.compute_layout(lay.win_w, lay.win_h)
    for i in 0:outliner_btns.len {
        t.set_visible(outliner_btns[i], false) >>>
    }
    t.sync_hud_router(router) >>>

    << StudioUiHost{
        tree: t,
        ids: StudioUiIds{
            btn_layout: btn_layout, btn_ortho_axis: btn_ortho_axis,
            btn_toggle_grid: btn_toggle_grid, btn_toggle_wire: btn_toggle_wire,
            btn_save_v10: btn_save_v10, btn_export_glb: btn_export_glb,
            btn_box: btn_box, btn_wedge: btn_wedge, btn_stair: btn_stair,
            btn_cyl: btn_cyl, btn_arch: btn_arch, btn_csg_hollow: btn_csg_hollow,
            btn_mode_obj: btn_mode_obj, btn_mode_vert: btn_mode_vert,
            btn_mode_edge: btn_mode_edge, btn_mode_face: btn_mode_face,
            btn_extrude: btn_extrude, btn_inset: btn_inset, btn_bevel: btn_bevel,
            btn_box_uv: btn_box_uv, btn_undo: btn_undo, btn_redo: btn_redo,
            outliner_0: outliner_btns[0], outliner_1: outliner_btns[1], outliner_2: outliner_btns[2],
            outliner_3: outliner_btns[3], outliner_4: outliner_btns[4], outliner_5: outliner_btns[5],
            outliner_6: outliner_btns[6],
            sl_pos_x: sl_pos_x, sl_pos_y: sl_pos_y, sl_pos_z: sl_pos_z,
            sl_metallic: sl_metallic, sl_roughness: sl_roughness,
            sl_base_r: sl_base_r, sl_base_g: sl_base_g, sl_base_b: sl_base_b,
            lbl_status: lbl_status
        }
    }
}

fn (ui $&StudioUiHost) sync_from_state(st &StudioState, rows &[]OutlinerRow) int {
    ids := ui.ids
    t := $&ui.tree

    // Viewport & Shading toggles
    t.set_active(ids.btn_layout, st.layout_mode == LAYOUT_SPLIT) >>>
    if st.layout_mode == LAYOUT_SPLIT { t.set_label(ids.btn_layout, "Split") >>> }
    else { t.set_label(ids.btn_layout, "Single") >>> }

    if st.orbit.ortho_axis == ORTHO_FRONT { t.set_label(ids.btn_ortho_axis, "Ortho: Front") >>> }
    else if st.orbit.ortho_axis == ORTHO_RIGHT { t.set_label(ids.btn_ortho_axis, "Ortho: Right") >>> }
    else { t.set_label(ids.btn_ortho_axis, "Ortho: Top") >>> }

    t.set_active(ids.btn_toggle_grid, st.show_grid) >>>
    t.set_active(ids.btn_toggle_wire, st.show_wire) >>>

    // Edit Mode pill active states
    t.set_active(ids.btn_mode_obj, st.wb.mode == imod.EDIT_MODE_OBJECT) >>>
    t.set_active(ids.btn_mode_vert, st.wb.mode == imod.EDIT_MODE_VERTEX) >>>
    t.set_active(ids.btn_mode_edge, st.wb.mode == imod.EDIT_MODE_EDGE) >>>
    t.set_active(ids.btn_mode_face, st.wb.mode == imod.EDIT_MODE_FACE) >>>

    // Enable/disable mesh operations when no whitebox is active
    t.set_enabled(ids.btn_extrude, st.wb_active) >>>
    t.set_enabled(ids.btn_inset, st.wb_active) >>>
    t.set_enabled(ids.btn_bevel, st.wb_active) >>>
    t.set_enabled(ids.btn_box_uv, st.wb_active) >>>
    t.set_enabled(ids.btn_undo, st.wb_active) >>>
    t.set_enabled(ids.btn_redo, st.wb_active) >>>
    t.set_enabled(ids.btn_export_glb, st.wb_active) >>>

    // Outliner rows
    for i in 0:OUTLINER_SLOTS {
        bid := outliner_btn_id(&ids, i)
        if i < rows.len {
            r := &rows[i]
            $tag := "   " + r.name
            if r.is_csg { tag = "   [CSG] " + r.name }
            else if r.is_wb { tag = "   [Mesh] " + r.name }
            t.set_visible(bid, true) >>>
            t.set_label(bid, tag) >>>
            t.set_active(bid, r.is_selected) >>>
        } else {
            t.set_visible(bid, false) >>>
            t.set_active(bid, false) >>>
        }
    }

    // Integrated Inspector Sliders
    t.set_value(ids.sl_pos_x, st.wb_pos.x) >>>
    t.set_value(ids.sl_pos_y, st.wb_pos.y) >>>
    t.set_value(ids.sl_pos_z, st.wb_pos.z) >>>
    t.set_value_text(ids.sl_pos_x, fmt_signed(st.wb_pos.x)) >>>
    t.set_value_text(ids.sl_pos_y, fmt_signed(st.wb_pos.y)) >>>
    t.set_value_text(ids.sl_pos_z, fmt_signed(st.wb_pos.z)) >>>

    t.set_value(ids.sl_base_r, st.mat_asset.base_color.x) >>>
    t.set_value(ids.sl_base_g, st.mat_asset.base_color.y) >>>
    t.set_value(ids.sl_base_b, st.mat_asset.base_color.z) >>>
    t.set_value(ids.sl_metallic, st.mat_asset.metallic) >>>
    t.set_value(ids.sl_roughness, st.mat_asset.roughness) >>>
    t.set_value_text(ids.sl_base_r, fmt_short(st.mat_asset.base_color.x)) >>>
    t.set_value_text(ids.sl_base_g, fmt_short(st.mat_asset.base_color.y)) >>>
    t.set_value_text(ids.sl_base_b, fmt_short(st.mat_asset.base_color.z)) >>>
    t.set_value_text(ids.sl_metallic, fmt_short(st.mat_asset.metallic)) >>>
    t.set_value_text(ids.sl_roughness, fmt_short(st.mat_asset.roughness)) >>>

    t.set_label(ids.lbl_status, st.status_msg + "") >>>
    << 0
}

fn draw_section_header(hud $&ui_bridge.UiFrame, x f64, y f64, w f64, title string, right_txt string) int {
    hdr := layout.Rect{x: x, y: y, width: w, height: 22.0}
    hud.draw_panel(&hdr, 0.0, studio_rgb(33, 36, 43), studio_rgb(47, 52, 62), 0.0) >>>
    hud.record_sdf_rect(fm.rect2(x, y + 21.0, w, 1.0), 0.0, studio_rgb(45, 50, 60).value(), 0.0, 0) >>>
    hud.draw_label(&layout.Rect{x: x + 10.0, y: y, width: w - 20.0, height: 22.0},
        &title, studio_rgb(154, 163, 180), 10.0, 0.0, 0.5) >>>
    if right_txt.len > 0 {
        hud.draw_label(&layout.Rect{x: x + 10.0, y: y, width: w - 20.0, height: 22.0},
            &right_txt, studio_rgb(122, 131, 148), 10.0, 1.0, 0.5) >>>
    }
    << 0
}

fn draw_tile_icon(hud $&ui_bridge.UiFrame, tree &ui_bridge.UiControlTree, id int, icon int, active bool) int {
    b := tree.node_bounds(id) >>>
    $fg := studio_rgb(208, 215, 228)
    $ac := studio_rgb(98, 152, 248)
    if !tree.nodes[id - 1].enabled {
        fg = studio_rgb(110, 117, 130)
        ac = studio_rgb(90, 97, 110)
    } else if active {
        fg = studio_rgb(248, 250, 255)
        ac = studio_rgb(242, 140, 40)
    }
    draw_studio_icon(hud, icon, b.x + b.width * 0.5, b.y + 16.0, 15.0, fg, ac) >>>
    << 0
}

fn draw_stat_cell(hud $&ui_bridge.UiFrame, x f64, y f64, w f64, h f64, k string, v int) int {
    hud.draw_panel(&layout.Rect{x: x, y: y, width: w, height: h}, 4.0,
        studio_rgb(34, 37, 45), studio_rgb(48, 53, 64), 1.0) >>>
    hud.draw_label(&layout.Rect{x: x + 8.0, y: y, width: w - 16.0, height: h},
        &k, studio_rgb(138, 146, 162), 10.5, 0.0, 0.5) >>>
    vs := str(v)
    hud.draw_label(&layout.Rect{x: x + 8.0, y: y, width: w - 16.0, height: h},
        &vs, studio_rgb(232, 236, 244), 11.5, 1.0, 0.5) >>>
    << 0
}

fn draw_key_hint_row(hud $&ui_bridge.UiFrame, x f64, y f64, w f64, key string, desc string) int {
    kw := math.max(38.0, f64(key.len) * 6.5 + 12.0)
    hud.draw_panel(&layout.Rect{x: x + 8.0, y: y, width: kw, height: 17.0}, 3.0,
        studio_rgb(37, 41, 49), studio_rgb(56, 62, 74), 1.0) >>>
    hud.draw_label(&layout.Rect{x: x + 8.0, y: y, width: kw, height: 17.0},
        &key, studio_rgb(198, 206, 220), 9.5, 0.5, 0.5) >>>
    hud.draw_label(&layout.Rect{x: x + 16.0 + kw, y: y, width: math.max(20.0, w - kw - 24.0), height: 17.0},
        &desc, studio_rgb(142, 150, 166), 10.5, 0.0, 0.5) >>>
    << 0
}

fn draw_studio_chrome_overlays(
    hud $&ui_bridge.UiFrame,
    ui &StudioUiHost,
    lay &StudioLayout,
    st &StudioState,
    rows &[]OutlinerRow,
    persp_cam &StudioCamera
) int {
    line_col := studio_rgb(17, 19, 23).value()
    // Panel hairline boundaries
    hud.record_sdf_rect(fm.rect2(0.0, lay.top_rect.height - 1.0, lay.win_w, 1.0), 0.0, line_col, 0.0, 0) >>>
    hud.record_sdf_rect(fm.rect2(lay.left_rect.width - 1.0, lay.left_rect.y, 1.0, lay.left_rect.height), 0.0, line_col, 0.0, 0) >>>
    hud.record_sdf_rect(fm.rect2(lay.right_rect.x, lay.right_rect.y, 1.0, lay.right_rect.height), 0.0, line_col, 0.0, 0) >>>
    hud.record_sdf_rect(fm.rect2(lay.right_rect.x, lay.outliner_rect.y + lay.outliner_rect.height, lay.right_rect.width, 1.0), 0.0, line_col, 0.0, 0) >>>
    hud.record_sdf_rect(fm.rect2(0.0, lay.bot_rect.y, lay.win_w, 1.0), 0.0, line_col, 0.0, 0) >>>

    // Top-left Brand emblem & title + divider
    hud.record_sdf_rect(fm.rect2(10.0, 10.0, 16.0, 16.0), 4.0, studio_rgb(47, 102, 216).value(), 0.0, 0) >>>
    draw_studio_icon(hud, ICON_BOX, 18.0, 18.0, 10.0, studio_rgb(248, 250, 255), studio_rgb(184, 216, 255)) >>>
    b1 := "NEXUS"
    b2 := "STUDIO"
    hud.draw_label(&layout.Rect{x: 31.0, y: 6.0, width: 46.0, height: 24.0}, &b1, studio_rgb(238, 242, 248), 11.5, 0.0, 0.5) >>>
    hud.draw_label(&layout.Rect{x: 74.0, y: 6.0, width: 44.0, height: 24.0}, &b2, studio_rgb(132, 141, 158), 10.0, 0.0, 0.5) >>>
    hud.record_sdf_rect(fm.rect2(117.0, 8.0, 1.0, 20.0), 0.0, studio_rgb(46, 52, 63).value(), 0.0, 0) >>>

    // Left Shelf section headers & crisp vector icons inside every tool tile
    draw_section_header(hud, lay.left_rect.x, lay.left_rect.y, lay.left_rect.width - 1.0, "CREATE", "Mesh / CSG") >>>
    draw_tile_icon(hud, &ui.tree, ui.ids.btn_box, ICON_BOX, false) >>>
    draw_tile_icon(hud, &ui.tree, ui.ids.btn_wedge, ICON_WEDGE, false) >>>
    draw_tile_icon(hud, &ui.tree, ui.ids.btn_stair, ICON_STAIR, false) >>>
    draw_tile_icon(hud, &ui.tree, ui.ids.btn_cyl, ICON_CYLINDER, false) >>>
    draw_tile_icon(hud, &ui.tree, ui.ids.btn_arch, ICON_ARCH, false) >>>
    draw_tile_icon(hud, &ui.tree, ui.ids.btn_csg_hollow, ICON_CSG, false) >>>

    draw_section_header(hud, lay.left_rect.x, lay.left_rect.y + 190.0, lay.left_rect.width - 1.0, "TOPOLOGY", "Edit") >>>
    draw_tile_icon(hud, &ui.tree, ui.ids.btn_extrude, ICON_EXTRUDE, false) >>>
    draw_tile_icon(hud, &ui.tree, ui.ids.btn_inset, ICON_INSET, false) >>>
    draw_tile_icon(hud, &ui.tree, ui.ids.btn_bevel, ICON_BEVEL, false) >>>
    draw_tile_icon(hud, &ui.tree, ui.ids.btn_box_uv, ICON_BOX_UV, false) >>>

    if lay.left_rect.height >= 490.0 {
        sy0 := lay.left_rect.y + 332.0
        draw_section_header(hud, lay.left_rect.x, sy0, lay.left_rect.width - 1.0, "KEYMAP", "") >>>
        draw_key_hint_row(hud, lay.left_rect.x, sy0 + 30.0, lay.left_rect.width, "1-4", "Edit Mode") >>>
        draw_key_hint_row(hud, lay.left_rect.x, sy0 + 52.0, lay.left_rect.width, "E", "Extrude Face") >>>
        draw_key_hint_row(hud, lay.left_rect.x, sy0 + 74.0, lay.left_rect.width, "I / B", "Inset / Bevel") >>>
        draw_key_hint_row(hud, lay.left_rect.x, sy0 + 96.0, lay.left_rect.width, "U", "Box Project UV") >>>
        draw_key_hint_row(hud, lay.left_rect.x, sy0 + 118.0, lay.left_rect.width, "G / W", "Grid / Wire") >>>
        draw_key_hint_row(hud, lay.left_rect.x, sy0 + 140.0, lay.left_rect.width, "Tab", "Split / Single") >>>
        draw_key_hint_row(hud, lay.left_rect.x, sy0 + 162.0, lay.left_rect.width, "Z / Y", "Undo / Redo") >>>
    }

    // Right Outliner Header & node glyph dots
    draw_section_header(hud, lay.outliner_rect.x + 1.0, lay.outliner_rect.y, lay.outliner_rect.width - 1.0,
        "SCENE OUTLINER", str(st.tree_ids.len) + " nodes") >>>
    for i in 0:rows.len {
        if i >= OUTLINER_SLOTS { <- }
        bid := outliner_btn_id(&ui.ids, i)
        rb := ui.tree.node_bounds(bid) >>>
        if rb.width <= 0.0 || rb.height <= 0.0 { -> }
        r := &rows[i]
        $dot_col := studio_rgb(138, 146, 162)
        if r.is_csg { dot_col = studio_rgb(242, 140, 40) }
        else if r.is_wb { dot_col = studio_rgb(92, 168, 255) }
        else if r.is_selected { dot_col = studio_rgb(248, 250, 255) }
        hud.record_sdf_circle(fm.vec2(rb.x + 10.0, rb.y + rb.height * 0.5), 3.0, dot_col.value(), 0.0, 0) >>>
    }

    // Right Inspector Headers & Live Material RGB Color Swatch
    ix := lay.inspector_rect.x + 1.0
    iy := lay.inspector_rect.y
    iw := lay.inspector_rect.width - 1.0
    sel_txt := active_node_name(st)
    draw_section_header(hud, ix, iy, iw, "TRANSFORM", sel_txt) >>>
    draw_section_header(hud, ix, iy + 120.0, iw, "MATERIAL PBR", "") >>>

    // Live Material Color Swatch next to MATERIAL PBR header
    sw_r := int(math.max(0.0, math.min(255.0, math.round(st.mat_asset.base_color.x * 255.0))))
    sw_g := int(math.max(0.0, math.min(255.0, math.round(st.mat_asset.base_color.y * 255.0))))
    sw_b := int(math.max(0.0, math.min(255.0, math.round(st.mat_asset.base_color.z * 255.0))))
    hud.draw_panel(&layout.Rect{x: ix + iw - 42.0, y: iy + 124.0, width: 32.0, height: 14.0},
        3.0, studio_rgb(sw_r, sw_g, sw_b), studio_rgb(94, 102, 118), 1.0) >>>

    // Geometry Stats section at bottom of Inspector
    if lay.inspector_rect.height >= 360.0 {
        draw_section_header(hud, ix, iy + 298.0, iw, "MESH STATS", "") >>>
        if st.wb_active {
            edges := st.wb.mesh.build_edges()
            $tris := 0
            for i in 0:st.wb.compiled.len { tris += st.wb.compiled[i].mesh.triangle_count() }
            cw := math.floor((iw - 22.0) * 0.5)
            draw_stat_cell(hud, ix + 8.0, iy + 328.0, cw, 24.0, "Verts", st.wb.mesh.vertices.len) >>>
            draw_stat_cell(hud, ix + 14.0 + cw, iy + 328.0, cw, 24.0, "Edges", edges.len) >>>
            draw_stat_cell(hud, ix + 8.0, iy + 357.0, cw, 24.0, "Faces", st.wb.mesh.faces.len) >>>
            draw_stat_cell(hud, ix + 14.0 + cw, iy + 357.0, cw, 24.0, "Tris", tris) >>>
        } else {
            empty_msg := "Select Box or CSG Cut to model"
            hud.draw_panel(&layout.Rect{x: ix + 8.0, y: iy + 328.0, width: iw - 16.0, height: 32.0},
                4.0, studio_rgb(32, 35, 42), studio_rgb(46, 51, 61), 1.0) >>>
            hud.draw_label(&layout.Rect{x: ix + 12.0, y: iy + 328.0, width: iw - 24.0, height: 32.0},
                &empty_msg, studio_rgb(138, 146, 162), 11.0, 0.5, 0.5) >>>
        }
    }

    // Floating Viewport Corner Pills + Rotating 3D Axis Triad
    p_pill := layout.Rect{x: lay.persp.x + 10.0, y: lay.persp.y + 10.0, width: 92.0, height: 22.0}
    hud.draw_panel(&p_pill, 4.0, studio_rgba(20, 22, 27, 195), studio_rgb(56, 62, 74), 1.0) >>>
    p_lbl := "Perspective"
    hud.draw_label(&p_pill, &p_lbl, studio_rgb(220, 226, 236), 11.0, 0.5, 0.5) >>>

    draw_orientation_gizmo(hud, persp_cam, lay.persp) >>>

    if lay.has_ortho {
        $o_lbl := "Ortho  Top"
        if st.orbit.ortho_axis == ORTHO_FRONT { o_lbl = "Ortho  Front" }
        else if st.orbit.ortho_axis == ORTHO_RIGHT { o_lbl = "Ortho  Right" }
        o_pill := layout.Rect{x: lay.ortho.x + 10.0, y: lay.ortho.y + 10.0, width: 102.0, height: 22.0}
        hud.draw_panel(&o_pill, 4.0, studio_rgba(20, 22, 27, 195), studio_rgb(56, 62, 74), 1.0) >>>
        hud.draw_label(&o_pill, &o_lbl, studio_rgb(220, 226, 236), 11.0, 0.5, 0.5) >>>
    }

    // Bottom Status Bar dot & right-side GPU + mode readout
    $dot_status := studio_rgb(87, 173, 87)
    if !st.wb_active { dot_status = studio_rgb(92, 168, 255) }
    hud.record_sdf_circle(fm.vec2(13.0, lay.bot_rect.y + 12.0), 3.5, dot_status.value(), 0.0, 0) >>>

    $mode_str := "Face Mode"
    if st.wb.mode == imod.EDIT_MODE_OBJECT { mode_str = "Object Mode" }
    else if st.wb.mode == imod.EDIT_MODE_VERTEX { mode_str = "Vertex Mode" }
    else if st.wb.mode == imod.EDIT_MODE_EDGE { mode_str = "Edge Mode" }
    right_status := st.backend_name + "   " + mode_str + "   v10"
    hud.draw_label(&layout.Rect{x: lay.win_w - 280.0, y: lay.bot_rect.y + 2.0, width: 268.0, height: 20.0},
        &right_status, studio_rgb(138, 147, 164), 10.5, 1.0, 0.5) >>>
    << 0
}
