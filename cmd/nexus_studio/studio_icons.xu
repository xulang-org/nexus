@main

fm #"github.com/xulang-org/nexus/foundation/math"
ui_bridge #"github.com/xulang-org/nexus/integration/ui"
draw #ui/draw
layout #ui/layout
#math

const ICON_BOX = 1
const ICON_WEDGE = 2
const ICON_STAIR = 3
const ICON_CYLINDER = 4
const ICON_ARCH = 5
const ICON_CSG = 6
const ICON_EXTRUDE = 7
const ICON_INSET = 8
const ICON_BEVEL = 9
const ICON_BOX_UV = 10
const ICON_UNDO = 11
const ICON_REDO = 12
const ICON_SPLIT = 13
const ICON_SINGLE = 14
const ICON_GRID = 15
const ICON_WIRE = 16
const ICON_SAVE = 17
const ICON_EXPORT = 18

fn draw_ui_line(hud $&ui_bridge.UiFrame, ax f64, ay f64, bx f64, by f64, width f64, col int) int {
    dx := bx - ax
    dy := by - ay
    len := math.sqrt(dx * dx + dy * dy)
    if len <= 0.001 { << 0 }
    nx := -dy / len * (width * 0.5)
    ny := dx / len * (width * 0.5)
    p0 := fm.vec2(ax - nx, ay - ny)
    p1 := fm.vec2(bx - nx, by - ny)
    p2 := fm.vec2(bx + nx, by + ny)
    p3 := fm.vec2(ax + nx, ay + ny)
    hud.record_quad(p0, p1, p2, p3, col) >>>
    << 0
}

fn draw_ui_box_outline(hud $&ui_bridge.UiFrame, x f64, y f64, w f64, h f64, lw f64, col int) int {
    draw_ui_line(hud, x, y, x + w, y, lw, col) >>>
    draw_ui_line(hud, x + w, y, x + w, y + h, lw, col) >>>
    draw_ui_line(hud, x + w, y + h, x, y + h, lw, col) >>>
    draw_ui_line(hud, x, y + h, x, y, lw, col) >>>
    << 0
}

fn draw_studio_icon(hud $&ui_bridge.UiFrame, icon int, cx f64, cy f64, sz f64, col draw.Color, accent draw.Color) int {
    c := col.value()
    ac := accent.value()
    h := sz * 0.5
    s := math.max(1.3, sz * 0.095)

    if icon == ICON_BOX {
        // Isometric wireframe cube
        tx := cx
        ty := cy - h * 0.88
        rx := cx + h * 0.80
        ry := cy - h * 0.40
        rbx := rx
        rby := cy + h * 0.44
        bx := cx
        by := cy + h * 0.90
        lbx := cx - h * 0.80
        lby := rby
        lx := lbx
        ly := ry
        draw_ui_line(hud, tx, ty, rx, ry, s, c) >>>
        draw_ui_line(hud, rx, ry, rbx, rby, s, c) >>>
        draw_ui_line(hud, rbx, rby, bx, by, s, c) >>>
        draw_ui_line(hud, bx, by, lbx, lby, s, c) >>>
        draw_ui_line(hud, lbx, lby, lx, ly, s, c) >>>
        draw_ui_line(hud, lx, ly, tx, ty, s, c) >>>
        draw_ui_line(hud, lx, ly, cx, cy + h * 0.04, s, ac) >>>
        draw_ui_line(hud, rx, ry, cx, cy + h * 0.04, s, ac) >>>
        draw_ui_line(hud, cx, cy + h * 0.04, bx, by, s, ac) >>>
        << 0
    }
    if icon == ICON_WEDGE {
        // Sloped wedge ramp profile with 3D offset edge
        blx := cx - h * 0.82
        bly := cy + h * 0.68
        brx := cx + h * 0.54
        bry := bly
        tlx := cx - h * 0.42
        tly := cy - h * 0.62
        trx := cx + h * 0.82
        try_y := cy + h * 0.24
        back_lx := cx - h * 0.82
        back_ly := cy - h * 0.26
        draw_ui_line(hud, blx, bly, brx, bry, s, c) >>>
        draw_ui_line(hud, brx, bry, back_lx, back_ly, s, ac) >>>
        draw_ui_line(hud, back_lx, back_ly, blx, bly, s, c) >>>
        draw_ui_line(hud, back_lx, back_ly, tlx, tly, s, c) >>>
        draw_ui_line(hud, tlx, tly, trx, try_y, s, ac) >>>
        draw_ui_line(hud, trx, try_y, brx, bry, s, c) >>>
        << 0
    }
    if icon == ICON_STAIR {
        x0 := cx - h * 0.82
        y0 := cy + h * 0.68
        dx := sz * 0.27
        dy := sz * 0.24
        draw_ui_line(hud, x0, y0, x0 + dx * 3.0, y0, s, c) >>>
        draw_ui_line(hud, x0 + dx * 3.0, y0, x0 + dx * 3.0, y0 - dy * 3.0, s, c) >>>
        draw_ui_line(hud, x0, y0, x0, y0 - dy, s, ac) >>>
        draw_ui_line(hud, x0, y0 - dy, x0 + dx, y0 - dy, s, ac) >>>
        draw_ui_line(hud, x0 + dx, y0 - dy, x0 + dx, y0 - dy * 2.0, s, ac) >>>
        draw_ui_line(hud, x0 + dx, y0 - dy * 2.0, x0 + dx * 2.0, y0 - dy * 2.0, s, ac) >>>
        draw_ui_line(hud, x0 + dx * 2.0, y0 - dy * 2.0, x0 + dx * 2.0, y0 - dy * 3.0, s, ac) >>>
        draw_ui_line(hud, x0 + dx * 2.0, y0 - dy * 3.0, x0 + dx * 3.0, y0 - dy * 3.0, s, ac) >>>
        << 0
    }
    if icon == ICON_CYLINDER {
        rx := h * 0.68
        ty := cy - h * 0.48
        by := cy + h * 0.56
        draw_ui_line(hud, cx - rx, ty, cx - rx, by, s, c) >>>
        draw_ui_line(hud, cx + rx, ty, cx + rx, by, s, c) >>>
        // Top elliptical cap approximated cleanly
        draw_ui_line(hud, cx - rx, ty, cx, ty - h * 0.28, s, ac) >>>
        draw_ui_line(hud, cx, ty - h * 0.28, cx + rx, ty, s, ac) >>>
        draw_ui_line(hud, cx - rx, ty, cx, ty + h * 0.26, s, c) >>>
        draw_ui_line(hud, cx, ty + h * 0.26, cx + rx, ty, s, c) >>>
        // Bottom arc
        draw_ui_line(hud, cx - rx, by, cx, by + h * 0.26, s, c) >>>
        draw_ui_line(hud, cx, by + h * 0.26, cx + rx, by, s, c) >>>
        << 0
    }
    if icon == ICON_ARCH {
        ox0 := cx - h * 0.78
        ox1 := cx + h * 0.78
        oy0 := cy - h * 0.62
        oy1 := cy + h * 0.74
        ix0 := cx - h * 0.34
        ix1 := cx + h * 0.34
        iy0 := cy - h * 0.14
        draw_ui_line(hud, ox0, oy1, ox0, oy0 + h * 0.34, s, c) >>>
        draw_ui_line(hud, ox0, oy0 + h * 0.34, cx, oy0, s, c) >>>
        draw_ui_line(hud, cx, oy0, ox1, oy0 + h * 0.34, s, c) >>>
        draw_ui_line(hud, ox1, oy0 + h * 0.34, ox1, oy1, s, c) >>>
        draw_ui_line(hud, ox0, oy1, ix0, oy1, s, c) >>>
        draw_ui_line(hud, ix1, oy1, ox1, oy1, s, c) >>>
        draw_ui_line(hud, ix0, oy1, ix0, iy0 + h * 0.22, s, ac) >>>
        draw_ui_line(hud, ix0, iy0 + h * 0.22, cx, iy0, s, ac) >>>
        draw_ui_line(hud, cx, iy0, ix1, iy0 + h * 0.22, s, ac) >>>
        draw_ui_line(hud, ix1, iy0 + h * 0.22, ix1, oy1, s, ac) >>>
        << 0
    }
    if icon == ICON_CSG {
        // Overlapping outer square + inner subtracted accent cutout
        draw_ui_box_outline(hud, cx - h * 0.82, cy - h * 0.66, sz * 0.56, sz * 0.56, s, c) >>>
        draw_ui_box_outline(hud, cx - h * 0.18, cy - h * 0.16, sz * 0.52, sz * 0.52, s, ac) >>>
        draw_ui_line(hud, cx - h * 0.06, cy + h * 0.10, cx + h * 0.22, cy + h * 0.10, s, ac) >>>
        << 0
    }
    if icon == ICON_EXTRUDE {
        // Base block + raised orange/cobalt cap + up arrow
        draw_ui_box_outline(hud, cx - h * 0.72, cy + h * 0.08, sz * 0.72, sz * 0.34, s, c) >>>
        draw_ui_box_outline(hud, cx - h * 0.56, cy - h * 0.42, sz * 0.56, sz * 0.22, s, ac) >>>
        draw_ui_line(hud, cx, cy - h * 0.48, cx, cy - h * 0.90, s, ac) >>>
        draw_ui_line(hud, cx, cy - h * 0.90, cx - h * 0.24, cy - h * 0.64, s, ac) >>>
        draw_ui_line(hud, cx, cy - h * 0.90, cx + h * 0.24, cy - h * 0.64, s, ac) >>>
        << 0
    }
    if icon == ICON_INSET {
        draw_ui_box_outline(hud, cx - h * 0.78, cy - h * 0.78, sz * 0.78, sz * 0.78, s, c) >>>
        draw_ui_box_outline(hud, cx - h * 0.38, cy - h * 0.38, sz * 0.38, sz * 0.38, s, ac) >>>
        draw_ui_line(hud, cx - h * 0.78, cy - h * 0.78, cx - h * 0.38, cy - h * 0.38, 1.0, col.with_alpha(140).value()) >>>
        draw_ui_line(hud, cx + h * 0.78, cy - h * 0.78, cx + h * 0.38, cy - h * 0.38, 1.0, col.with_alpha(140).value()) >>>
        << 0
    }
    if icon == ICON_BEVEL {
        x0 := cx - h * 0.76
        x1 := cx + h * 0.76
        y0 := cy - h * 0.76
        y1 := cy + h * 0.76
        cham := sz * 0.32
        draw_ui_line(hud, x0, y1, x0, y0, s, c) >>>
        draw_ui_line(hud, x0, y0, x1 - cham, y0, s, c) >>>
        draw_ui_line(hud, x1 - cham, y0, x1, y0 + cham, s + 0.3, ac) >>>
        draw_ui_line(hud, x1, y0 + cham, x1, y1, s, c) >>>
        draw_ui_line(hud, x1, y1, x0, y1, s, c) >>>
        << 0
    }
    if icon == ICON_BOX_UV {
        draw_ui_box_outline(hud, cx - h * 0.76, cy - h * 0.76, sz * 0.76, sz * 0.76, s, c) >>>
        draw_ui_line(hud, cx, cy - h * 0.76, cx, cy + h * 0.76, 1.1, ac) >>>
        draw_ui_line(hud, cx - h * 0.76, cy, cx + h * 0.76, cy, 1.1, ac) >>>
        hud.record_sdf_rect(fm.rect2(cx - h * 0.62, cy - h * 0.62, h * 0.48, h * 0.48), 1.0, ac, 0.0, 0) >>>
        hud.record_sdf_rect(fm.rect2(cx + h * 0.14, cy + h * 0.14, h * 0.48, h * 0.48), 1.0, ac, 0.0, 0) >>>
        << 0
    }
    if icon == ICON_UNDO {
        draw_ui_line(hud, cx - h * 0.64, cy - h * 0.10, cx + h * 0.56, cy - h * 0.10, s, c) >>>
        draw_ui_line(hud, cx + h * 0.56, cy - h * 0.10, cx + h * 0.56, cy + h * 0.48, s, c) >>>
        draw_ui_line(hud, cx - h * 0.64, cy - h * 0.10, cx - h * 0.22, cy - h * 0.50, s, c) >>>
        draw_ui_line(hud, cx - h * 0.64, cy - h * 0.10, cx - h * 0.22, cy + h * 0.30, s, c) >>>
        << 0
    }
    if icon == ICON_REDO {
        draw_ui_line(hud, cx - h * 0.56, cy - h * 0.10, cx + h * 0.64, cy - h * 0.10, s, c) >>>
        draw_ui_line(hud, cx - h * 0.56, cy - h * 0.10, cx - h * 0.56, cy + h * 0.48, s, c) >>>
        draw_ui_line(hud, cx + h * 0.64, cy - h * 0.10, cx + h * 0.22, cy - h * 0.50, s, c) >>>
        draw_ui_line(hud, cx + h * 0.64, cy - h * 0.10, cx + h * 0.22, cy + h * 0.30, s, c) >>>
        << 0
    }
    if icon == ICON_SPLIT {
        draw_ui_box_outline(hud, cx - h * 0.80, cy - h * 0.62, sz * 0.80, sz * 0.62, s, c) >>>
        draw_ui_line(hud, cx + h * 0.06, cy - h * 0.62, cx + h * 0.06, cy + h * 0.62, s, ac) >>>
        << 0
    }
    if icon == ICON_SINGLE {
        draw_ui_box_outline(hud, cx - h * 0.80, cy - h * 0.62, sz * 0.80, sz * 0.62, s, c) >>>
        << 0
    }
    << 0
}

fn axis_vec(idx int) fm.Vec3 {
    if idx == 0 { << fm.vec3(1.0, 0.0, 0.0) }
    if idx == 1 { << fm.vec3(0.0, 1.0, 0.0) }
    << fm.vec3(0.0, 0.0, 1.0)
}

fn axis_color(idx int) draw.Color {
    if idx == 0 { << draw.rgb(217, 75, 75) }
    if idx == 1 { << draw.rgb(87, 173, 87) }
    << draw.rgb(71, 130, 218)
}

fn axis_label(idx int) string {
    if idx == 0 { << "X" }
    if idx == 1 { << "Y" }
    << "Z"
}

fn draw_orientation_gizmo(hud $&ui_bridge.UiFrame, cam &StudioCamera, rect ViewportRect) int {
    if rect.w < 120.0 || rect.h < 120.0 { << 0 }
    cx := rect.x + rect.w - 42.0
    cy := rect.y + 42.0
    arm_len := 22.0

    // Translucent circular gizmo backdrop
    hud.record_sdf_circle(fm.vec2(cx, cy), 31.0,
        draw.rgba(22, 24, 30, 185).value(), 1.0, draw.rgba(58, 65, 80, 180).value()) >>>

    // Collect depth along camera forward (larger dot = farther away, draw first)
    $order := [0, 1, 2]
    $depths := [0.0, 0.0, 0.0]
    for i in 0:3 {
        v := axis_vec(i)
        depths[i] = v.dot(cam.forward)
    }
    for i in 0:3 {
        for j in (i + 1):3 {
            if depths[order[j]] > depths[order[i]] {
                tmp := order[i]
                order[i] = order[j]
                order[j] = tmp
            }
        }
    }

    // Subtle negative axis nubs behind
    for k in 0:3 {
        idx := order[k]
        v := axis_vec(idx)
        sx := -v.dot(cam.right)
        sy := v.dot(cam.up)
        nx := cx + sx * (arm_len * 0.72)
        ny := cy + sy * (arm_len * 0.72)
        ncol := axis_color(idx).with_alpha(95)
        draw_ui_line(hud, cx, cy, nx, ny, 1.1, ncol.value()) >>>
        hud.record_sdf_circle(fm.vec2(nx, ny), 3.2, ncol.value(), 0.0, 0) >>>
    }

    // Center pivot dot
    hud.record_sdf_circle(fm.vec2(cx, cy), 2.5, draw.rgb(165, 174, 190).value(), 0.0, 0) >>>

    // Positive X/Y/Z axis arms + colored caps + crisp labels
    for k in 0:3 {
        idx := order[k]
        v := axis_vec(idx)
        sx := v.dot(cam.right)
        sy := -v.dot(cam.up)
        px := cx + sx * arm_len
        py := cy + sy * arm_len
        col := axis_color(idx)
        draw_ui_line(hud, cx, cy, px, py, 2.0, col.value()) >>>
        hud.record_sdf_circle(fm.vec2(px, py), 6.5, col.value(), 0.0, 0) >>>
        lbl := axis_label(idx)
        hud.draw_label(&layout.Rect{x: px - 6.0, y: py - 6.0, width: 12.0, height: 12.0},
            &lbl, draw.rgb(250, 251, 255), 9.0, 0.5, 0.5) >>>
    }
    << 0
}
