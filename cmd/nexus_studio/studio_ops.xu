@main

fm #"github.com/xulang-org/nexus/foundation/math"
gltf #"github.com/xulang-org/nexus/formats/gltf"
data #"github.com/xulang-org/nexus/resources/lighting"
rm #"github.com/xulang-org/nexus/resources/modeling"
rs #"github.com/xulang-org/nexus/resources/scene"
mod #"github.com/xulang-org/nexus/modeling"
imod #"github.com/xulang-org/nexus/integration/modeling"
project #"github.com/xulang-org/nexus/integration/project"
files #"github.com/xulang-org/nexus/integration/scene"
models3d #"github.com/xulang-org/nexus/integration/scene_render"
scene_lights #"github.com/xulang-org/nexus/integration/lighting"
scene_lighting #"github.com/xulang-org/nexus/integration/scene_lighting"
world3d #"github.com/xulang-org/nexus/integration/rendering/three_d"
ren #"github.com/xulang-org/nexus/rendering/three_d"
scene #"github.com/xulang-org/nexus/scene"
snapshot #"github.com/xulang-org/nexus/internal/file_snapshot"
#errors
#math

struct StudioOptions {
    scene_path string
    project_path string
    output_path string
    export_glb_rel string
    validator_bin string
    script_path string
    capture_path string
    capture_ui_path string
}

struct OutlinerRow {
    doc_index int
    name string
    is_wb bool
    is_csg bool
    is_selected bool
}

struct StudioState {
    running bool
    layout_mode int
    show_grid bool
    show_wire bool
    orbit OrbitState
    doc rs.Document
    tree scene.SceneTree
    world world3d.Scene3D
    models models3d.SceneModels3D
    has_models bool
    scene_mods imod.SceneModeling3D
    slights scene_lights.SceneLights3D
    root_tid int
    tree_ids []int
    selected_doc_node int
    wb_doc_node int
    wb_active bool
    wb_is_csg bool
    wb_csg rm.CsgTree
    wb imod.EditableModelSession
    mat_asset rm.MaterialAsset
    mat3d ren.Material3D
    wb_pos fm.Vec3
    status_msg string
    backend_name string
}

fn build_hollow_csg_tree(size fm.Vec3, hole fm.Vec3) rm.CsgTree {
    $t := rm.new_csg_tree()
    $b0 := rm.default_csg_brush(1, rm.CSG_SHAPE_BOX, rm.CSG_OP_UNION)
    b0.size = size
    $b1 := rm.default_csg_brush(2, rm.CSG_SHAPE_BOX, rm.CSG_OP_SUBTRACT)
    b1.size = hole
    t.brushes.push(b0)
    t.brushes.push(b1)
    << t
}

fn build_whitebox_shape(shape string, size fm.Vec3) rm.EditableMesh {
    if shape == "wedge" { << mod.wedge_editable(size, 4294967295, 0) or >> }
    if shape == "stair" { << mod.stair_editable(size, 6, 4294967295, 0) or >> }
    if shape == "cylinder" {
        r := math.min(size.x, size.z) * 0.5
        << mod.cylinder_editable(r, r, size.y, 16, 4294967295, 0) or >>
    }
    if shape == "arch" {
        thick := math.min(size.x * 0.25, 0.4)
        << mod.arch_editable(size, thick, 12, 4294967295, 0) or >>
    }
    << mod.box_editable(size, 4294967295, 0) or >>
}

fn clone_mat_asset(m &rm.MaterialAsset) rm.MaterialAsset {
    << rm.MaterialAsset{
        name: m.name + "",
        base_color: m.base_color, alpha: m.alpha, metallic: m.metallic, roughness: m.roughness,
        emission: m.emission, normal_scale: m.normal_scale, occlusion_strength: m.occlusion_strength,
        alpha_mode: m.alpha_mode, alpha_cutoff: m.alpha_cutoff, double_sided: m.double_sided,
        clearcoat: m.clearcoat, clearcoat_roughness: m.clearcoat_roughness,
        sheen_color: m.sheen_color, sheen_roughness: m.sheen_roughness, ior: m.ior,
        base_texture_uid: m.base_texture_uid + "", orm_texture_uid: m.orm_texture_uid + "",
        normal_texture_uid: m.normal_texture_uid + "", emission_texture_uid: m.emission_texture_uid + "",
        occlusion_texture_uid: m.occlusion_texture_uid + "",
        uv_offset: m.uv_offset, uv_scale: m.uv_scale, flip_u: m.flip_u, flip_v: m.flip_v
    }
}

fn next_unique_wb_name(tree &scene.SceneTree, root_tid int) string {
    if (tree.find_child(root_tid, "StudioWhitebox") or >>) == 0 {
        << "StudioWhitebox"
    }
    for k in 2:256 {
        cand := "StudioWhitebox_" + str(k)
        if (tree.find_child(root_tid, cand + "") or >>) == 0 {
            << cand
        }
    }
    >> errors.new("studio: too many whitebox nodes under root")
}

fn add_wb_child_3d(tree $&scene.SceneTree, root_tid int, name string) int {
    << tree.add_child_3d(root_tid, name) or >>
}

fn set_wb_transform_3d(tree $&scene.SceneTree, tid int, xform fm.Mat4) int {
    << tree.set_transform_3d(tid, xform) or >>
}

fn ensure_wb_node(st $&StudioState) int {
    if st.wb_doc_node >= 0 && st.wb_doc_node < st.tree_ids.len {
        st.selected_doc_node = st.wb_doc_node
        << st.wb_doc_node
    }
    root_tid := st.root_tid
    wb_name := next_unique_wb_name(&st.tree, root_tid) or >>
    nid := add_wb_child_3d($&st.tree, root_tid, wb_name) or >>
    st.tree_ids = st.tree.subtree(root_tid) or >>
    for i in 0:st.tree_ids.len {
        if st.tree_ids[i] == nid {
            st.wb_doc_node = i
            st.selected_doc_node = i
            << i
        }
    }
    >> errors.new("studio: failed to index StudioWhitebox node")
}

fn safe_node_name(tree &scene.SceneTree, tid int) string {
    info := tree.node_info(tid) or (err) {
        _ := err
        << "Node"
    }
    if info.name.len > 0 { << info.name + "" }
    << "Node"
}

fn safe_node_origin(tree &scene.SceneTree, tid int) fm.Vec3 {
    xm := tree.global_transform_3d(tid) or (err) {
        _ := err
        << fm.vec3(0.0, 0.0, 0.0)
    }
    << xm.c3.xyz()
}

fn list_outliner_rows(st &StudioState) []OutlinerRow {
    $rows := []OutlinerRow{}
    $max_rows := 7
    if st.tree_ids.len < max_rows { max_rows = st.tree_ids.len }
    for i in 0:max_rows {
        tid := st.tree_ids[i]
        nm := safe_node_name(&st.tree, tid)
        is_wb := i == st.wb_doc_node && st.wb_active
        is_csg := is_wb && st.wb_is_csg
        is_sel := i == st.selected_doc_node || (st.selected_doc_node < 0 && is_wb)
        rows.push(OutlinerRow{
            doc_index: i,
            name: nm,
            is_wb: is_wb,
            is_csg: is_csg,
            is_selected: is_sel
        })
    }
    << rows
}

fn select_outliner_row(st $&StudioState, row_idx int) int {
    if row_idx < 0 || row_idx >= st.tree_ids.len { << 0 }
    st.selected_doc_node = row_idx
    tid := st.tree_ids[row_idx]
    nm := safe_node_name(&st.tree, tid)
    if row_idx == st.wb_doc_node && st.wb_active {
        st.status_msg = "Selected " + nm
        << 0
    }
    st.orbit.center = safe_node_origin(&st.tree, tid)
    st.status_msg = "Focused " + nm
    << 0
}

fn replace_wb_session(st $&StudioState, mesh rm.EditableMesh, is_csg bool, csg_tree rm.CsgTree) int {
    old := $&st.wb
    _ := old.close()
    st.wb = imod.new_editable_session(mesh) or >>
    st.wb_active = true
    st.wb_is_csg = is_csg
    st.wb_csg = csg_tree
    node_idx := ensure_wb_node(st) or >>
    tid := st.tree_ids[node_idx]
    pos := st.wb_pos
    set_wb_transform_3d($&st.tree, tid, fm.translation_3d(pos)) or >>
    << 0
}

fn spawn_whitebox(st $&StudioState, shape string, size fm.Vec3) int {
    em := build_whitebox_shape(shape + "", size) or >>
    replace_wb_session(st, em, false, rm.new_csg_tree()) or >>
    st.status_msg = "Spawned whitebox: " + shape
    << 0
}

fn spawn_csg_hollow(st $&StudioState, size fm.Vec3, hole fm.Vec3) int {
    tree := build_hollow_csg_tree(size, hole)
    em := mod.evaluate_csg_tree("StudioCsgHollow", &tree) or >>
    replace_wb_session(st, em, true, tree) or >>
    st.status_msg = "Spawned CSG Hollow brush"
    << 0
}

fn set_active_pos(st $&StudioState, pos fm.Vec3) int {
    if !pos.is_finite() { >> errors.new("studio: position must be finite") }
    st.wb_pos = pos
    if st.wb_doc_node >= 0 && st.wb_doc_node < st.tree_ids.len {
        tid := st.tree_ids[st.wb_doc_node]
        set_wb_transform_3d($&st.tree, tid, fm.translation_3d(pos)) or >>
    }
    << 0
}

fn set_active_material(st $&StudioState, base fm.Vec3, metallic f64, roughness f64) int {
    $cand := clone_mat_asset(&st.mat_asset)
    cand.base_color = fm.vec3(math.max(0.0, math.min(1.0, base.x)), math.max(0.0, math.min(1.0, base.y)), math.max(0.0, math.min(1.0, base.z)))
    cand.metallic = math.max(0.0, math.min(1.0, metallic))
    cand.roughness = math.max(0.04, math.min(1.0, roughness))
    mat3 := imod.material_asset_to_3d(&cand) or >>
    st.mat_asset = cand
    st.mat3d = mat3
    st.wb.dirty_gpu = true
    << 0
}

fn active_world_matrix(st &StudioState) fm.Mat4 {
    if st.wb_doc_node >= 0 && st.wb_doc_node < st.tree_ids.len {
        tid := st.tree_ids[st.wb_doc_node]
        << st.tree.global_transform_3d(tid) or (err) {
            _ := err
            << fm.translation_3d(st.wb_pos)
        }
    }
    << fm.translation_3d(st.wb_pos)
}

fn active_node_name(st &StudioState) string {
    if st.wb_doc_node >= 0 && st.wb_doc_node < st.tree_ids.len {
        info := st.tree.node_info(st.tree_ids[st.wb_doc_node]) or (err) {
            _ := err
            << "StudioWhitebox"
        }
        << info.name + ""
    }
    << "None"
}

fn apply_model_op_session(s $&imod.EditableModelSession, op string, amount f64, val f64) string {
    if op == "extrude" {
        if s.selected_faces.len == 0 && s.mesh.faces.len > 0 { s.selected_faces = [0] }
        _ := s.apply_extrude(val) or >>
        << "Op: extrude"
    }
    if op == "inset" {
        if s.selected_faces.len == 0 && s.mesh.faces.len > 0 { s.selected_faces = [0] }
        _ := s.apply_inset(amount, val) or >>
        << "Op: inset"
    }
    if op == "bevel" {
        if s.selected_edges.len < 2 {
            edges := s.mesh.build_edges()
            for e in edges {
                if e.faces.len == 2 {
                    s.selected_edges = [e.v0, e.v1]
                    <-
                }
            }
        }
        _ := s.apply_bevel(val) or >>
        << "Op: bevel"
    }
    if op == "box_uv" {
        _ := s.apply_box_uv(val) or >>
        << "Op: box_uv"
    }
    if op == "undo" {
        _ := s.undo()
        << "Undo"
    }
    if op == "redo" {
        _ := s.redo()
        << "Redo"
    }
    >> errors.new("studio: unknown model op " + op)
}

fn apply_model_op(st $&StudioState, op string, amount f64, val f64) int {
    if !st.wb_active { >> errors.new("studio: spawn whitebox before running op") }
    msg := apply_model_op_session($&st.wb, op, amount, val) or >>
    st.status_msg = msg
    << 0
}

fn build_scene_v10_doc(st &StudioState) rs.Document {
    base_nodes := files.capture_nodes(&st.tree, st.root_tid) or >>
    $refs := []rs.ResourceReference{}
    for i in 0:st.doc.resource_count() {
        r := st.doc.resource(i) or >>
        refs.push(rs.ResourceReference{uid: r.uid + "", kind: r.kind + "", path: r.path + "", content_hash: r.content_hash + ""})
    }
    doc_base := rs.with_references(&st.doc, &base_nodes, refs) or >>
    if !st.wb_active || st.wb_doc_node < 0 {
        << doc_base
    }
    $ems := []rs.EditableMeshAttachment{}
    for i in 0:doc_base.editable_mesh_count() {
        em := doc_base.editable_mesh(i) or >>
        if em.node != st.wb_doc_node { ems.push(~em) }
    }
    $csgs := []rs.CsgTreeAttachment{}
    for i in 0:doc_base.csg_tree_count() {
        cs := doc_base.csg_tree(i) or >>
        if cs.node != st.wb_doc_node { csgs.push(~cs) }
    }
    if st.wb_is_csg {
        csgs.push(rs.csg_tree_attachment(st.wb_doc_node, st.wb_csg.clone()))
    } else {
        ems.push(rs.editable_mesh_attachment(st.wb_doc_node, st.wb.mesh.clone()))
    }
    $mats := []rs.MaterialOverrideAttachment{}
    for i in 0:doc_base.material_override_count() {
        mo := doc_base.material_override(i) or >>
        if mo.node != st.wb_doc_node || mo.slot != 0 { mats.push(~mo) }
    }
    mats.push(rs.material_override_attachment(st.wb_doc_node, 0, clone_mat_asset(&st.mat_asset)))
    << rs.with_modeling_attachments(&doc_base, ems, csgs, mats) or >>
}

fn save_scene_v10(st $&StudioState, out_path string) int {
    if out_path.len == 0 { >> errors.new("studio: --output path required to save Scene v10") }
    doc := build_scene_v10_doc(st) or >>
    files.save(out_path + "", &doc) or >>
    st.status_msg = "Saved Scene v10"
    << 0
}

fn export_glb_to_project(st $&StudioState, proj_path string, rel_path string, validator_bin string) project.ImportAssetResult {
    if !st.wb_active { >> errors.new("studio: no active whitebox to export") }
    if proj_path.len == 0 || rel_path.len == 0 {
        >> errors.new("studio: --project and --export-glb required to export GLB")
    }
    prims := mod.compile_to_primitives(&st.wb.mesh, true) or >>
    $g_prims := []gltf.GlbExportPrimitive{}
    $mats := []gltf.MaterialDescription{}
    for i in 0:prims.len {
        $m := gltf.default_material()
        m.base = st.mat_asset.base_color
        m.metallic = st.mat_asset.metallic
        m.roughness = st.mat_asset.roughness
        mats.push(m)
        p := &prims[i]
        g_prims.push(gltf.GlbExportPrimitive{mesh: ~p.mesh, material: i})
    }
    glb_raw := gltf.encode_primitives_glb("StudioWhitebox", &g_prims, &mats) or >>
    res := project.export_glb_bytes_to_project(proj_path + "", rel_path + "", &glb_raw, validator_bin + "") or >>
    st.status_msg = "Exported GLB (" + res.uid[0:8] + ")"
    << res
}
