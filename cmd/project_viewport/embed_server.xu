fn embed_persp_camera(cam &EmbedCameraSpec, rect EmbedViewportRect) CameraFrame {
    orb := Orbit{center: cam.center, distance: cam.distance, yaw: cam.yaw, pitch: cam.pitch}
    << camera_frame(orb, fm.vec2(f64(rect.w), f64(rect.h))) >>>
}

fn embed_ortho_camera(cam &EmbedCameraSpec, rect EmbedViewportRect) CameraFrame {
    $axis_dir := fm.vec3(0.0, 1.0, 0.0)
    $up_vec := fm.vec3(0.0, 0.0, -1.0)
    if cam.ortho_axis == EMBED_ORTHO_FRONT {
        axis_dir = fm.vec3(0.0, 0.0, 1.0)
        up_vec = fm.vec3(0.0, 1.0, 0.0)
    } else if cam.ortho_axis == EMBED_ORTHO_RIGHT {
        axis_dir = fm.vec3(1.0, 0.0, 0.0)
        up_vec = fm.vec3(0.0, 1.0, 0.0)
    }
    near := 0.05
    far := 400.0
    pos := cam.center.add(axis_dir.scaled(60.0))
    fwd := axis_dir.scaled(-1.0)
    right := fwd.cross(up_vec).normalized() >>>
    up := right.cross(fwd)
    aspect := math.max(0.1, f64(rect.w)) / math.max(0.1, f64(rect.h))
    view := scene.look_at_3d(pos, cam.center, up_vec) >>>
    lens := camera_data.orthographic(cam.ortho_size, near, far) >>>
    proj := lens.projection(aspect) >>>
    << CameraFrame{
        position: pos, right: right, up: up, forward: fwd,
        view: view, proj: proj, projection: proj.multiply(view),
        size: fm.vec2(f64(rect.w), f64(rect.h)),
        tangent: 1.0, near: near, far: far
    }
}

fn embed_ortho_ray(cam &EmbedCameraSpec, frame &CameraFrame, rect EmbedViewportRect, px f64, py f64) ViewRay {
    rw := math.max(1.0, f64(rect.w))
    rh := math.max(1.0, f64(rect.h))
    lx := px - f64(rect.x)
    ly := py - f64(rect.y)
    nx := (2.0 * lx / rw) - 1.0
    ny := 1.0 - (2.0 * ly / rh)
    half_h := cam.ortho_size * 0.5
    half_w := half_h * (rw / rh)
    origin := frame.position.add(frame.right.scaled(nx * half_w)).add(frame.up.scaled(ny * half_h))
    << ViewRay{origin: origin, direction: frame.forward, near: frame.near, far: frame.far}
}

fn compute_embed_bounds(tree &scene.SceneTree, tree_ids &[]int) EmbedBounds {
    $has_pt := false
    $low := fm.vec3(0.0, 0.0, 0.0)
    $high := fm.vec3(0.0, 0.0, 0.0)
    for d in 1:tree_ids.len {
        nid := tree_ids[d]
        vis := tree.is_visible(nid) >>> (err) {
            _ := err
            ->
        }
        if !vis { -> }
        info := tree.node_info(nid) >>> (err) {
            _ := err
            ->
        }
        if info.kind != scene.NODE_3D { -> }
        wp := (tree.global_transform_3d(nid) >>> (err) {
            _ := err
            ->
        }).c3.xyz()
        if !has_pt {
            low = wp
            high = wp
            has_pt = true
        } else {
            low = fm.vec3(math.min(low.x, wp.x), math.min(low.y, wp.y), math.min(low.z, wp.z))
            high = fm.vec3(math.max(high.x, wp.x), math.max(high.y, wp.y), math.max(high.z, wp.z))
        }
    }
    if !has_pt {
        << EmbedBounds{center: fm.vec3(0.0, 0.0, 0.0), radius: 8.0}
    }
    center := low.add(high).scaled(0.5)
    half_ext := high.sub(low).scaled(0.5)
    << EmbedBounds{center: center, radius: math.max(6.0, half_ext.length() + 4.0)}
}

fn embed_default_sun_dir() fm.Vec3 {
    << fm.vec3(0.45, 0.78, 0.42).normalized() >>> (err) {
        _ := err
        << fm.vec3(0.0, 1.0, 0.0)
    }
}

fn embed_unit_dir_or_sun(v fm.Vec3) fm.Vec3 {
    << v.normalized() >>> (err) {
        _ := err
        << embed_default_sun_dir()
    }
}

fn gather_embed_lights_with_shadows(
    doc &resource.Document,
    slights &scene_lights.SceneLights3D,
    tree &scene.SceneTree,
    has_lights bool,
    shadow_sel $&scene_lights.ShadowSelection3D
) []data.Light3D {
    if has_lights && slights.binding_count() > 0 {
        gathered := slights.gather_with_shadows(tree, shadow_sel) >>> (err) {
            _ := err
            << []data.Light3D{}
        }
        if gathered.len > 0 { << gathered }
    }
    $sun_dir := fm.vec3(0.45, 0.78, 0.42)
    $sun_int := 2.35
    if doc.environment_count() > 0 {
        ev := doc.environment(0) >>>
        sun_dir = ev.sun_dir
        sun_int = ev.sun_intensity
    }
    nsun := embed_unit_dir_or_sun(sun_dir)
    key := data.directional(nsun, fm.vec3(sun_int, sun_int * 0.96, sun_int * 0.90)) >>>
    fill := data.directional(fm.vec3(-0.55, 0.38, 0.48), fm.vec3(0.85, 0.92, 1.02)) >>>
    rim := data.directional(fm.vec3(-0.30, 0.45, -0.82), fm.vec3(1.05, 1.08, 1.15)) >>>
    << [key, fill, rim]
}

fn try_open_embed_shadow_map(
    device &ren.Device3D,
    gpu_fx $&EmbedGpuFx,
    shadow_desc shadows.ShadowDescription3D
) bool {
    sm_new := device.shadow_map(shadow_desc, &gpu_fx.sprog) >>> (err) {
        eprintln("embed shadow fallback (unshadowed): " + err.msg())
        << false
    }
    gpu_fx.shadow_maps.push(sm_new)
    gpu_fx.shadow_res = shadow_desc.resolution()
    gpu_fx.shadow_faces = shadow_desc.face_count()
    << true
}

fn prepare_embed_shadow_binding(
    device $&ren.Device3D,
    gpu_fx $&EmbedGpuFx,
    host &EmbedSceneHost,
    w3 &world3d.Scene3D,
    frame &CameraFrame,
    lighting &data.Environment3D,
    shadow_sel &scene_lights.ShadowSelection3D
) ren.ShadowBinding3D {
    if !gpu_fx.has_gpu { << ren.no_shadow_binding() }
    $shadow_source := -1
    $shadow_desc := shadows.default_directional()
    if host.has_lights && host.slights.binding_count() > 0 {
        if shadow_sel.source >= 0 && shadow_sel.source < lighting.source_count() {
            src := lighting.source(shadow_sel.source) >>>
            if shadow_sel.cascades.enabled() {
                shadow_source = shadow_sel.source
                cc := shadows.cascade_camera(frame.view, frame.proj) >>>
                $ss := shadow_sel.cascades.settings() >>>
                if ss.resolution > 512 { ss.resolution = 512 }
                shadow_desc = shadows.cascaded(src, cc, ss) >>>
            } else if shadow_sel.punctual.enabled() {
                shadow_source = shadow_sel.source
                $ps := shadow_sel.punctual.settings() >>>
                if ps.resolution > 512 { ps.resolution = 512 }
                pprof := shadows.punctual_profile(src, ps) >>>
                shadow_desc = pprof.description(src) >>>
            }
        }
    } else if lighting.source_count() > 0 {
        src0 := lighting.source(0) >>>
        if src0.kind() != data.POINT {
            shadow_source = 0
            b := compute_embed_bounds(&host.tree, &host.tree_ids)
            sdir := src0.direction().normalized() >>>
            d0 := shadows.directional(b.center, sdir, b.radius, math.max(30.0, b.radius * 4.0), 512) >>>
            shadow_desc = (d0.with_bias(0.0005, 0.002) >>>).with_pcss_light_radius(2.0) >>>
        }
    }
    if shadow_source < 0 {
        << ren.no_shadow_binding()
    }
    if gpu_fx.shadow_maps.len == 0 || gpu_fx.shadow_res != shadow_desc.resolution() || gpu_fx.shadow_faces != shadow_desc.face_count() {
        close_embed_gpu_shadow_maps(gpu_fx)
        if !try_open_embed_shadow_map(device, gpu_fx, shadow_desc) {
            gpu_fx.shadow_res = 0
            gpu_fx.shadow_faces = 0
            << ren.no_shadow_binding()
        }
    }
    $casters := w3.shadow_casters(&host.tree) >>>
    mc := host.scene_mods.shadow_casters(&host.tree, &host.tree_ids) >>>
    for ci in 0:mc.len { casters.push(mc[ci]) }
    sm := $&gpu_fx.shadow_maps[0]
    _ := sm.render(device, &casters, shadow_desc) >>>
    << sm.binding(lighting, shadow_source) >>>
}

fn resolve_embed_shadow_source(host &EmbedSceneHost, lighting &data.Environment3D, shadow_sel &scene_lights.ShadowSelection3D) int {
    if host.has_lights && host.slights.binding_count() > 0 {
        if shadow_sel.source >= 0 && shadow_sel.source < lighting.source_count() {
            if shadow_sel.cascades.enabled() || shadow_sel.punctual.enabled() {
                << shadow_sel.source
            }
        }
        << -1
    }
    if lighting.source_count() > 0 { << 0 }
    << -1
}

fn render_embed_pane(
    device $&ren.Device3D,
    gpu_fx $&EmbedGpuFx,
    w3 $&world3d.Scene3D,
    host &EmbedSceneHost,
    grid_mesh &ren.Mesh3D,
    rect EmbedViewportRect,
    frame &CameraFrame,
    show_grid bool
) int {
    if rect.w < 4 || rect.h < 4 { << 0 }
    w3.select_lods(&host.tree, frame.position) >>>
    $shadow_sel := scene_lights.no_shadow_selection()
    lights := gather_embed_lights_with_shadows(&host.doc, &host.slights, &host.tree, host.has_lights, $&shadow_sel) >>>
    $ambient := fm.vec3(0.42, 0.41, 0.40)
    $exposure := 1.0
    if host.doc.environment_count() > 0 {
        ev := host.doc.environment(0) >>>
        ambient = ev.ambient
        exposure = ev.exposure
    }
    lighting := data.environment(ambient, frame.position, exposure, lights) >>>
    sbind := prepare_embed_shadow_binding(device, gpu_fx, host, w3, frame, &lighting, &shadow_sel) >>>
    shadow_idx := resolve_embed_shadow_source(host, &lighting, &shadow_sel)
    device.set_viewport(rect.x, rect.y, rect.w, rect.h) >>>
    if show_grid {
        device.draw(grid_mesh, frame.projection) >>>
    }
    if gpu_fx.shadow_maps.len > 0 && shadow_idx >= 0 {
        w3.draw_lit_shadowed(device, &host.tree, frame.projection, &lighting, &gpu_fx.shadow_maps[0], shadow_idx) >>>
        _ := host.scene_mods.draw_lit_shadowed(device, &host.tree, &host.tree_ids, frame.projection, &lighting, &sbind) >>>
    } else {
        _ := w3.draw_lit(device, &host.tree, frame.projection, &lighting) >>>
        _ := host.scene_mods.draw_lit(device, &host.tree, &host.tree_ids, frame.projection, &lighting) >>>
    }
    << 0
}

fn render_embed_modern_single(
    device $&ren.Device3D,
    gpu_fx $&EmbedGpuFx,
    gpu_pipes $&EmbedPipelines,
    w3 $&world3d.Scene3D,
    host $&EmbedSceneHost,
    grid_mesh &ren.Mesh3D,
    rect EmbedViewportRect,
    frame &CameraFrame,
    show_grid bool
) int {
    rw := device.render_width()
    rh := device.render_height()
    if gpu_pipes.items.len == 0 || gpu_pipes.items[0].target_width() != rw || gpu_pipes.items[0].target_height() != rh {
        close_embed_gpu_pipelines(gpu_pipes)
        mp_new := world3d.new_modern_pipeline_3d(device, &gpu_fx.cprog, &gpu_fx.iprog, &gpu_fx.pprog) >>>
        gpu_pipes.items.push(mp_new)
    }

    for pi in 0:host.particles.len {
        nidx := host.particle_nodes[pi]
        if nidx >= 0 && nidx < host.tree_ids.len {
            att := host.doc.particle_emitter_3d(pi) >>>
            origin := (host.tree.global_transform_3d(host.tree_ids[nidx]) >>>).c3.xyz()
            ps := $&host.particles[pi]
            ps.set_emitter(&build_embed_particle_emitter(&att, origin)) >>>
        }
        ps := $&host.particles[pi]
        ps.step(device, 1.0 / 60.0) >>>
    }

    w3.select_lods(&host.tree, frame.position) >>>
    $shadow_sel := scene_lights.no_shadow_selection()
    lights := gather_embed_lights_with_shadows(&host.doc, &host.slights, &host.tree, host.has_lights, $&shadow_sel) >>>

    $ambient := fm.vec3(0.36, 0.36, 0.37)
    $pp_cfg := ren.post_process_defaults_3d()
    pp_cfg.ao_enabled = true
    pp_cfg.ao_strength = 0.45
    pp_cfg.ssr_enabled = false
    pp_cfg.bloom_enabled = true
    pp_cfg.bloom_threshold = 1.0
    pp_cfg.bloom_intensity = 0.30
    pp_cfg.taa_enabled = false
    pp_cfg.exposure = 1.0
    $has_atm := false
    $atm_cfg := ren.default_atmosphere_config_3d()
    $clear_col := EMBED_PAPER_BG
    z_near := math.max(0.05, frame.near)
    z_far := math.max(z_near + 1.0, frame.far)

    if host.doc.environment_count() > 0 {
        ev := host.doc.environment(0) >>>
        ambient = ev.ambient
        pp_cfg.ao_enabled = ev.gtao_enabled
        pp_cfg.ao_strength = 0.80
        pp_cfg.ssr_enabled = ev.ssr_enabled
        pp_cfg.bloom_enabled = ev.bloom_enabled
        pp_cfg.bloom_threshold = ev.bloom_threshold
        pp_cfg.bloom_intensity = ev.bloom_intensity
        pp_cfg.taa_enabled = false
        pp_cfg.exposure = ev.exposure
        has_atm = ev.sky_mode == resource.SKY_ATMOSPHERE || ev.fog_density > 0.0001
        nsun := embed_unit_dir_or_sun(ev.sun_dir)
        atm_cfg.sky_enabled = ev.sky_mode == resource.SKY_ATMOSPHERE
        atm_cfg.sun_direction = nsun
        atm_cfg.sun_radiance = fm.vec3(ev.sun_intensity, ev.sun_intensity * 0.96, ev.sun_intensity * 0.90)
        atm_cfg.mie_scale = math.max(0.2, ev.turbidity * 0.4)
        atm_cfg.fog_enabled = ev.fog_density > 0.0001
        atm_cfg.fog_near = math.max(0.5, z_near)
        atm_cfg.fog_far = math.max(atm_cfg.fog_near + 5.0, math.min(120.0, z_far))
        atm_cfg.fog_density = math.min(10.0, math.max(0.0, ev.fog_density))
        atm_cfg.fog_scattering_strength = math.max(0.0, ev.fog_scattering)
        gpu_fx.fx_time = gpu_fx.fx_time + (1.0 / 60.0)
        atm_cfg.time = gpu_fx.fx_time
        if atm_cfg.sky_enabled {
            clear_col = (18 << 24) | (28 << 16) | (46 << 8) | 255
        }
    }

    $lights_copy := []data.Light3D{}
    for li in 0:lights.len { lights_copy.push(lights[li]) }
    lighting := data.environment(ambient, frame.position, pp_cfg.exposure, lights_copy) >>>
    sbind := prepare_embed_shadow_binding(device, gpu_fx, host, w3, frame, &lighting, &shadow_sel) >>>

    $all_refs := []ren.MeshRef3D{}
    $all_worlds := []fm.Mat4{}
    $all_mats := []ren.Material3D{}
    _ := w3.collect_visible_draws_stats(&host.tree, frame.projection, $&all_refs, $&all_worlds, $&all_mats) >>>
    _ := host.scene_mods.collect_draws(&host.tree, &host.tree_ids, $&all_refs, $&all_worlds, $&all_mats) >>>

    $op_refs := []ren.MeshRef3D{}
    $op_worlds := []fm.Mat4{}
    $op_mats := []ren.Material3D{}
    $tq := ren.new_transparent_queue_3d()
    for di in 0:all_refs.len {
        if all_mats[di].is_alpha_blended() {
            _ := tq.submit(all_refs[di], all_worlds[di], all_mats[di], 0.0) >>>
        } else {
            op_refs.push(all_refs[di])
            op_worlds.push(all_worlds[di])
            op_mats.push(all_mats[di])
        }
    }

    _ := rect
    mp := $&gpu_pipes.items[0]
    _ := mp.prepare_lights_mode(device, ambient, frame.position, pp_cfg.exposure, &lights, frame.view, frame.proj, z_near, z_far, 0) >>>
    _ := mp.render_scene_effects_frame(
        device, show_grid, grid_mesh, &op_refs, &op_worlds, &op_mats, &sbind,
        has_atm, &gpu_fx.atm_list[0], &atm_cfg, &tq, &host.particles,
        frame.position, frame.view, frame.proj, z_near, z_far, clear_col, &pp_cfg
    ) >>>
    << 0
}

fn json_bool_or(doc &json.Doc, obj int, key string, fallback bool) bool {
    if !doc.has(obj, key + "") { << fallback }
    << doc.as_bool(doc.get(obj, key + "")) >>> (err) {
        _ := err
        << fallback
    }
}

fn json_int_or(doc &json.Doc, obj int, key string, fallback int) int {
    if !doc.has(obj, key + "") { << fallback }
    << doc.as_int(doc.get(obj, key + "")) >>> (err) {
        _ := err
        << fallback
    }
}

fn parse_cam_spec(doc &json.Doc, root int) EmbedCameraSpec {
    $spec := EmbedCameraSpec{
        center: fm.vec3(0.0, 0.5, 0.0),
        distance: 6.5,
        yaw: 0.55,
        pitch: 0.42,
        ortho_size: 8.0,
        ortho_axis: EMBED_ORTHO_TOP
    }
    spec.ortho_axis = json_int_or(doc, root, "ortho_axis", EMBED_ORTHO_TOP)
    if !doc.has(root, "cam") { << spec }
    arr := doc.get(root, "cam")
    if arr < 0 || !doc.is_list(arr) || doc.count(arr) < 7 { << spec }
    cx := doc.as_f64(doc.at(arr, 0)) >>> (err) { << spec }
    cy := doc.as_f64(doc.at(arr, 1)) >>> (err) { << spec }
    cz := doc.as_f64(doc.at(arr, 2)) >>> (err) { << spec }
    dist := doc.as_f64(doc.at(arr, 3)) >>> (err) { << spec }
    yaw := doc.as_f64(doc.at(arr, 4)) >>> (err) { << spec }
    pitch := doc.as_f64(doc.at(arr, 5)) >>> (err) { << spec }
    osize := doc.as_f64(doc.at(arr, 6)) >>> (err) { << spec }
    if fm.finite(cx) && fm.finite(cy) && fm.finite(cz) { spec.center = fm.vec3(cx, cy, cz) }
    if fm.finite(dist) && dist > 0.05 { spec.distance = dist }
    if fm.finite(yaw) { spec.yaw = yaw }
    if fm.finite(pitch) { spec.pitch = pitch }
    if fm.finite(osize) && osize > 0.1 { spec.ortho_size = osize }
    << spec
}

fn clamp_embed_dim(v int, lo int, hi int) int {
    if v < lo { << lo }
    if v > hi { << hi }
    << v
}

fn parse_embed_mat4(doc &json.Doc, root int) fm.Mat4 {
    if !doc.has(root, "mat") { << fm.identity_3d() }
    arr := doc.get(root, "mat")
    if arr < 0 || !doc.is_list(arr) || doc.count(arr) < 16 { << fm.identity_3d() }
    $vals := []f64{}
    for i in 0:16 {
        v := doc.as_f64(doc.at(arr, i)) >>> (err) {
            _ := err
            << fm.identity_3d()
        }
        if !fm.finite(v) { << fm.identity_3d() }
        vals.push(v)
    }
    << fm.Mat4{
        c0: fm.vec4(vals[0], vals[1], vals[2], vals[3]),
        c1: fm.vec4(vals[4], vals[5], vals[6], vals[7]),
        c2: fm.vec4(vals[8], vals[9], vals[10], vals[11]),
        c3: fm.vec4(vals[12], vals[13], vals[14], vals[15])
    }
}

fn try_set_embed_transform(hosts $&[]EmbedSceneHost, node_idx int, mat fm.Mat4) {
    if hosts.len == 0 || node_idx <= 0 { << }
    host := $&hosts[0]
    if node_idx >= host.tree_ids.len { << }
    tid := host.tree_ids[node_idx]
    if tid <= 0 { << }
    t := $&host.tree
    _ := t.set_transform_3d(tid, mat) >>> (err) {
        _ := err
        <<
    }
    _ := t.flush_transforms() >>> (err) {
        _ := err
        <<
    }
}

fn split_viewport_rects(w int, h int, split bool) []EmbedViewportRect {
    if !split || w < 160 {
        << [EmbedViewportRect{x: 0, y: 0, w: w, h: h}]
    }
    lw := int(f64(w) * 0.56)
    rw := w - lw - 2
    if rw < 32 {
        << [EmbedViewportRect{x: 0, y: 0, w: w, h: h}]
    }
    << [
        EmbedViewportRect{x: 0, y: 0, w: lw, h: h},
        EmbedViewportRect{x: lw + 2, y: 0, w: rw, h: h}
    ]
}

fn try_embed_device_backend(device &ren.Device3D) int {
    << device.backend() >>> (err) {
        _ := err
        << 0
    }
}

fn try_embed_set_nodelay(conn &net.Conn) {
    _ := conn.set_nodelay(true) >>> (err) {
        _ := err
        <<
    }
}

fn close_active_embed_slot(worlds $&[]world3d.Scene3D, hosts $&[]EmbedSceneHost) {
    if hosts.len > 0 {
        close_embed_scene($&hosts[0])
        if worlds.len > 0 {
            close_embed_world_quiet($&worlds[0], &hosts[0].tree)
        }
    }
}

fn run_embed_server(config &Options) int {
    mesh_program := mesh_shaders.load_mesh("build/mesh-shaders") >>>
    $device := ren.open_3d_offscreen_adaptive(640, 480, gpu.AUTO, &mesh_program) >>>
    $backend := "Software"
    $gpu_fx := EmbedGpuFx{
        has_gpu: false,
        cprog: ren.ClusteredProgram3D{format: 0, entrypoint: "", compute: []u8{}, vertex: []u8{}, fragment: []u8{}},
        iprog: ren.IndirectProgram3D{format: 0, entrypoint: "", hiz_depth: []u8{}, hiz_mip: []u8{}, cull: []u8{}, vertex: []u8{}, fragment: []u8{}},
        pprog: ren.empty_postprocess_program_3d(),
        sprog: ren.ShadowProgram3D{format: 0, entrypoint: "", vertex: []u8{}, fragment: []u8{}},
        aprog: ren.empty_atmosphere_program_3d(),
        vprog: ren.empty_particle_program_3d(),
        atm_list: []ren.AtmosphereRenderer3D{},
        shadow_maps: []ren.ShadowMap3D{},
        shadow_res: 0,
        shadow_faces: 0,
        fx_time: 0.0
    }
    $gpu_pipes := EmbedPipelines{items: []world3d.ModernPipeline3D{}}
    if device.is_gpu() {
        bcode := try_embed_device_backend(&device)
        backend = gpu_info.backend_name(bcode)
        gpu_fx.has_gpu = true
        gpu_fx.cprog = mesh_shaders.load_clustered_program("build/mesh-shaders") >>>
        gpu_fx.iprog = mesh_shaders.load_indirect_program("build/mesh-shaders") >>>
        gpu_fx.pprog = mesh_shaders.load_postprocess_program("build/mesh-shaders") >>>
        gpu_fx.sprog = mesh_shaders.load_shadow("build/mesh-shaders") >>>
        gpu_fx.aprog = mesh_shaders.load_atmosphere_program("build/mesh-shaders") >>>
        gpu_fx.vprog = mesh_shaders.load_particle_program("build/mesh-shaders") >>>
        ar0 := device.atmosphere_renderer(&gpu_fx.aprog) >>>
        gpu_fx.atm_list.push(ar0)
    }
    $grid_xz := build_plane_grid_mesh(&device, EMBED_ORTHO_TOP) >>>
    $grid_xy := build_plane_grid_mesh(&device, EMBED_ORTHO_FRONT) >>>
    $grid_yz := build_plane_grid_mesh(&device, EMBED_ORTHO_RIGHT) >>>
    $init_world := world3d.new_scene_3d(&device) >>> (err) {
        close_embed_gpu_pipelines($&gpu_pipes)
        close_embed_gpu_fx($&gpu_fx)
        close_embed_mesh_quiet($&grid_xz)
        close_embed_mesh_quiet($&grid_xy)
        close_embed_mesh_quiet($&grid_yz)
        close_embed_device_quiet($&device)
        >> err
    }
    init_host := load_embed_scene(&device, config.path + "", gpu_fx.has_gpu, &gpu_fx.vprog, $&init_world) >>> (err) {
        close_embed_gpu_pipelines($&gpu_pipes)
        close_embed_gpu_fx($&gpu_fx)
        close_embed_mesh_quiet($&grid_xz)
        close_embed_mesh_quiet($&grid_xy)
        close_embed_mesh_quiet($&grid_yz)
        close_embed_device_quiet($&device)
        >> err
    }
    $worlds := [init_world]
    $hosts := [init_host]

    $conn := net.dial_to("tcp", config.embed_connect + "") >>> (err) {
        close_active_embed_slot($&worlds, $&hosts)
        close_embed_gpu_pipelines($&gpu_pipes)
        close_embed_gpu_fx($&gpu_fx)
        close_embed_mesh_quiet($&grid_xz)
        close_embed_mesh_quiet($&grid_xy)
        close_embed_mesh_quiet($&grid_yz)
        close_embed_device_quiet($&device)
        >> err
    }
    try_embed_set_nodelay(&conn)
    ready_json := "{\"backend\":" + json.quote(&backend) + "}"
    send_embed_packet(&conn, EMBED_READY, 0, &ready_json) >>> (err) {
        close_embed_conn_quiet($&conn)
        close_active_embed_slot($&worlds, $&hosts)
        close_embed_gpu_pipelines($&gpu_pipes)
        close_embed_gpu_fx($&gpu_fx)
        close_embed_mesh_quiet($&grid_xz)
        close_embed_mesh_quiet($&grid_xy)
        close_embed_mesh_quiet($&grid_yz)
        close_embed_device_quiet($&device)
        >> err
    }

    $rem := ""
    $running := true
    while running {
        $line := ""
        while true {
            idx := strings.index_byte(&rem, 10)
            if idx >= 0 {
                line = strings.trim_space(&(rem[0:idx] + ""))
                rem = rem[idx + 1:rem.len] + ""
                if line.len > 0 { <- }
                ->
            }
            chunk := conn.read(8192) >>> (err) {
                _ := err
                running = false
                <-
            }
            if chunk.len == 0 {
                running = false
                <-
            }
            rem = rem + chunk
        }
        if !running || line.len == 0 { <- }

        doc := json.parse_max(&line, 1048576)
        if !doc.ok() || !doc.is_dict(doc.root()) { -> }
        root := doc.root()
        cmd := json_str_or(&doc, root, "cmd", "")
        seq := json_int_or(&doc, root, "seq", 0)

        if cmd == "quit" {
            running = false
            <-
        } else if cmd == "load" {
            sp := json_str_or(&doc, root, "scene", "")
            if sp.len > 0 {
                try_reload_embed_hosts(&device, &conn, sp, seq, gpu_fx.has_gpu, &gpu_fx.vprog, $&worlds, $&hosts)
            }
        } else if cmd == "set_transform" {
            node_idx := json_int_or(&doc, root, "node", -1)
            mat := parse_embed_mat4(&doc, root)
            try_set_embed_transform($&hosts, node_idx, mat)
        } else if cmd == "render" {
            w3 := $&worlds[0]
            host := $&hosts[0]
            w := clamp_embed_dim(json_int_or(&doc, root, "w", 640), 64, 1920)
            h := clamp_embed_dim(json_int_or(&doc, root, "h", 480), 64, 1200)
            split := json_bool_or(&doc, root, "split", false)
            show_grid := json_bool_or(&doc, root, "grid", true)
            cam := parse_cam_spec(&doc, root)
            if w != device.render_width() || h != device.render_height() {
                close_embed_gpu_pipelines($&gpu_pipes)
                device.resize_offscreen(w, h) >>>
            }
            rects := split_viewport_rects(w, h, split)
            persp := embed_persp_camera(&cam, rects[0]) >>>
            if rects.len == 1 && gpu_fx.has_gpu {
                render_embed_modern_single($&device, $&gpu_fx, $&gpu_pipes, w3, host, &grid_xz, rects[0], &persp, show_grid) >>>
            } else {
                device.begin(EMBED_PAPER_BG) >>>
                render_embed_pane($&device, $&gpu_fx, w3, host, &grid_xz, rects[0], &persp, show_grid) >>>
                if rects.len > 1 {
                    ortho := embed_ortho_camera(&cam, rects[1]) >>>
                    if cam.ortho_axis == EMBED_ORTHO_FRONT {
                        render_embed_pane($&device, $&gpu_fx, w3, host, &grid_xy, rects[1], &ortho, show_grid) >>>
                    } else if cam.ortho_axis == EMBED_ORTHO_RIGHT {
                        render_embed_pane($&device, $&gpu_fx, w3, host, &grid_yz, rects[1], &ortho, show_grid) >>>
                    } else {
                        render_embed_pane($&device, $&gpu_fx, w3, host, &grid_xz, rects[1], &ortho, show_grid) >>>
                    }
                }
                device.reset_viewport() >>>
            }
            cap_path := json_str_or(&doc, root, "capture", "")
            if cap_path.len > 0 {
                device.capture(cap_path + "") >>>
            }
            pixels := device.read_pixels_rgba() >>>
            device.finish_offscreen() >>>
            _ := send_embed_rgba(&conn, seq, w, h, &pixels) >>> (err) {
                _ := err
                running = false
                <-
            }
        } else if cmd == "pick" {
            w3 := $&worlds[0]
            host := &hosts[0]
            w := clamp_embed_dim(json_int_or(&doc, root, "w", 640), 64, 1920)
            h := clamp_embed_dim(json_int_or(&doc, root, "h", 480), 64, 1200)
            px := json_f64_or(&doc, root, "x", f64(w) * 0.5)
            py := json_f64_or(&doc, root, "y", f64(h) * 0.5)
            split := json_bool_or(&doc, root, "split", false)
            sel := json_int_or(&doc, root, "sel", -1)
            sub_mode := json_int_or(&doc, root, "sub_mode", 0)
            cam := parse_cam_spec(&doc, root)
            rects := split_viewport_rects(w, h, split)
            $use_rect := rects[0]
            $use_ortho := false
            if rects.len > 1 && px >= f64(rects[1].x) {
                use_rect = rects[1]
                use_ortho = true
            }
            $frame := embed_persp_camera(&cam, use_rect) >>>
            $ray := ViewRay{origin: frame.position, direction: frame.forward, near: frame.near, far: frame.far}
            if use_ortho {
                frame = embed_ortho_camera(&cam, use_rect) >>>
                ray = embed_ortho_ray(&cam, &frame, use_rect, px, py)
            } else {
                pt := fm.vec2(px - f64(use_rect.x), py - f64(use_rect.y))
                ray = frame.ray(pt) >>>
            }
            $resp := "{\"hit\":false,\"node\":-1,\"sub_mode\":0,\"sub_idx\":-1,\"v0\":-1,\"v1\":-1}"
            $sub_picked := false
            if sub_mode > 0 && sel > 0 {
                spick := host.scene_mods.pick_subobject_at(&host.tree, &host.tree_ids, sel, sub_mode, ray.origin, ray.direction)
                if spick.hit {
                    resp = "{\"hit\":true,\"node\":" + str(sel) + ",\"sub_mode\":" + str(sub_mode) +
                        ",\"sub_idx\":" + str(spick.index) + ",\"v0\":" + str(spick.v0) + ",\"v1\":" + str(spick.v1) + "}"
                    sub_picked = true
                }
            }
            if !sub_picked {
                $best_doc := -1
                $best_dist := ray.far
                hm := host.scene_mods.pick_node(&host.tree, &host.tree_ids, ray.origin, ray.direction, ray.near, ray.far)
                if hm.hit {
                    best_doc = hm.node_idx
                    best_dist = hm.distance
                }
                try_select_lods(w3, &host.tree, frame.position)
                ghit := safe_pick_3d(&host.picker, w3, &host.tree, ray.origin, ray.direction, ray.near, best_dist)
                if ghit.node > 0 {
                    for idx in 0:host.tree_ids.len {
                        if host.tree_ids[idx] == ghit.node {
                            best_doc = idx
                            <-
                        }
                    }
                }
                if best_doc > 0 {
                    resp = "{\"hit\":true,\"node\":" + str(best_doc) + ",\"sub_mode\":0,\"sub_idx\":-1,\"v0\":-1,\"v1\":-1}"
                }
            }
            _ := send_embed_packet(&conn, EMBED_PICK_RESULT, seq, &resp) >>> (err) {
                _ := err
                running = false
                <-
            }
        }
    }

    close_embed_conn_quiet($&conn)
    close_active_embed_slot($&worlds, $&hosts)
    close_embed_gpu_pipelines($&gpu_pipes)
    close_embed_gpu_fx($&gpu_fx)
    close_embed_mesh_quiet($&grid_xz)
    close_embed_mesh_quiet($&grid_xy)
    close_embed_mesh_quiet($&grid_yz)
    close_embed_device_quiet($&device)
    << 0
}
