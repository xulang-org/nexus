fn try_reload_embed_hosts(
    device &ren.Device3D,
    conn &net.Conn,
    sp string,
    seq int,
    has_gpu bool,
    vprog &ren.ParticleProgram3D,
    worlds $&[]world3d.Scene3D,
    hosts $&[]EmbedSceneHost
) {
    $next_world := world3d.new_scene_3d(device) >>> (err) {
        emsg := "{\"error\":" + json.quote(&err.msg()) + "}"
        _ := send_embed_packet(conn, EMBED_ERROR, seq, &emsg) >>> (serr) {
            _ := serr
            <<
        }
        <<
    }
    next_host := load_embed_scene(device, sp, has_gpu, vprog, $&next_world) >>> (err) {
        emsg := "{\"error\":" + json.quote(&err.msg()) + "}"
        _ := send_embed_packet(conn, EMBED_ERROR, seq, &emsg) >>> (serr) {
            _ := serr
            <<
        }
        <<
    }
    close_active_embed_slot(worlds, hosts)
    worlds[0] = next_world
    hosts[0] = next_host
}

fn safe_pick_3d(
    picker &models3d.ScenePicker3D,
    world &world3d.Scene3D,
    tree &scene.SceneTree,
    origin fm.Vec3,
    direction fm.Vec3,
    near f64,
    far f64
) models3d.ScenePick3D {
    << picker.pick(world, tree, origin, direction, near, far) >>> (err) {
        _ := err
        << models3d.ScenePick3D{node: 0, distance: far}
    }
}

