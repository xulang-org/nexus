const EMBED_FRAME_RGBA = 1
const EMBED_PICK_RESULT = 2
const EMBED_READY = 3
const EMBED_ERROR = 4

const EMBED_ORTHO_TOP = 0
const EMBED_ORTHO_FRONT = 1
const EMBED_ORTHO_RIGHT = 2

// Warm Paper studio viewport backdrop & axes from xu-ui-tokens.json
const EMBED_PAPER_BG = 0xede8e2ff
const EMBED_GRID_MINOR = 0xd2cac0ff
const EMBED_GRID_MAJOR = 0xb7aca0ff
const EMBED_AXIS_X = 0xb82138ff
const EMBED_AXIS_Y = 0x146747ff
const EMBED_AXIS_Z = 0x1b648fff

struct EmbedViewportRect {
    x int
    y int
    w int
    h int
}

struct EmbedCameraSpec {
    center fm.Vec3
    distance f64
    yaw f64
    pitch f64
    ortho_size f64
    ortho_axis int
}

struct EmbedSceneHost {
    directory string
    doc resource.Document
    tree scene.SceneTree
    root int
    tree_ids []int
    models models3d.SceneModels3D
    picker models3d.ScenePicker3D
    scene_mods imod.SceneModeling3D
    slights scene_lights.SceneLights3D
    has_lights bool
    particles []ren.GpuParticleSystem3D
    particle_nodes []int
}

struct EmbedGpuFx {
    has_gpu bool
    cprog ren.ClusteredProgram3D
    iprog ren.IndirectProgram3D
    pprog ren.PostProcessProgram3D
    sprog ren.ShadowProgram3D
    aprog ren.AtmosphereProgram3D
    vprog ren.ParticleProgram3D
    atm_list []ren.AtmosphereRenderer3D
    shadow_maps []ren.ShadowMap3D
    shadow_res int
    shadow_faces int
    fx_time f64
}

struct EmbedPipelines {
    items []world3d.ModernPipeline3D
}

struct EmbedBounds {
    center fm.Vec3
    radius f64
}

fn embed_write_all(conn &net.Conn, payload &string) int {
    total := payload.len
    if total == 0 { << 0 }
    $pos := 0
    while pos < total {
        if pos == 0 && total <= 262144 {
            wrote := conn.write(payload) >>>
            if wrote <= 0 {
                >> errors.new("embed server: socket write stalled")
            }
            pos = pos + wrote
            ->
        }
        $end := pos + 262144
        if end > total { end = total }
        chunk := (*payload)[pos:end]
        wrote := conn.write(&chunk) >>>
        if wrote <= 0 {
            >> errors.new("embed server: socket write stalled")
        }
        pos = pos + wrote
    }
    << 0
}

fn send_embed_packet(conn &net.Conn, kind int, seq int, payload &string) int {
    plen := payload.len
    $hdr := make_string(16)
    hdr[0] = 78
    hdr[1] = 88
    hdr[2] = 70
    hdr[3] = 49
    hdr[4] = kind & 255
    hdr[5] = (kind >> 8) & 255
    hdr[6] = (kind >> 16) & 255
    hdr[7] = (kind >> 24) & 255
    hdr[8] = seq & 255
    hdr[9] = (seq >> 8) & 255
    hdr[10] = (seq >> 16) & 255
    hdr[11] = (seq >> 24) & 255
    hdr[12] = plen & 255
    hdr[13] = (plen >> 8) & 255
    hdr[14] = (plen >> 16) & 255
    hdr[15] = (plen >> 24) & 255
    embed_write_all(conn, &hdr) >>>
    if plen > 0 {
        embed_write_all(conn, payload) >>>
    }
    << 0
}

fn send_embed_rgba(conn &net.Conn, seq int, w int, h int, pixels &[]u8) int {
    total := pixels.len
    plen := 8 + total
    $first_px := 262144
    if first_px > total { first_px = total }
    $first := make_string(24 + first_px)
    first[0] = 78
    first[1] = 88
    first[2] = 70
    first[3] = 49
    first[4] = EMBED_FRAME_RGBA & 255
    first[5] = (EMBED_FRAME_RGBA >> 8) & 255
    first[6] = (EMBED_FRAME_RGBA >> 16) & 255
    first[7] = (EMBED_FRAME_RGBA >> 24) & 255
    first[8] = seq & 255
    first[9] = (seq >> 8) & 255
    first[10] = (seq >> 16) & 255
    first[11] = (seq >> 24) & 255
    first[12] = plen & 255
    first[13] = (plen >> 8) & 255
    first[14] = (plen >> 16) & 255
    first[15] = (plen >> 24) & 255
    first[16] = w & 255
    first[17] = (w >> 8) & 255
    first[18] = (w >> 16) & 255
    first[19] = (w >> 24) & 255
    first[20] = h & 255
    first[21] = (h >> 8) & 255
    first[22] = (h >> 16) & 255
    first[23] = (h >> 24) & 255
    for i in 0:first_px {
        first[24 + i] = int(pixels[i])
    }
    embed_write_all(conn, &first) >>>
    $pos := first_px
    while pos < total {
        $n := 262144
        if pos + n > total { n = total - pos }
        $buf := make_string(n)
        for i in 0:n {
            buf[i] = int(pixels[pos + i])
        }
        embed_write_all(conn, &buf) >>>
        pos = pos + n
    }
    << 0
}

fn add_grid_quad(mesh $&meshes.MeshData3D, a fm.Vec3, b fm.Vec3, off fm.Vec3, normal fm.Vec3, col int) int {
    i0 := mesh.vertex_lit(a.sub(off), col, normal) >>>
    i1 := mesh.vertex_lit(a.add(off), col, normal) >>>
    i2 := mesh.vertex_lit(b.add(off), col, normal) >>>
    i3 := mesh.vertex_lit(b.sub(off), col, normal) >>>
    mesh.triangle(i0, i1, i2) >>>
    mesh.triangle(i0, i2, i3) >>>
    << 0
}

fn build_plane_grid_mesh(device &ren.Device3D, plane int) ren.Mesh3D {
    $m := meshes.new_mesh_data_3d()
    $k := -10
    while k <= 10 {
        fk := f64(k)
        $col_a := EMBED_GRID_MINOR
        $hw_a := 0.011
        $col_b := EMBED_GRID_MINOR
        $hw_b := 0.011
        if k % 5 == 0 && k != 0 {
            col_a = EMBED_GRID_MAJOR
            hw_a = 0.017
            col_b = EMBED_GRID_MAJOR
            hw_b = 0.017
        }
        if plane == EMBED_ORTHO_TOP {
            if k == 0 {
                col_a = EMBED_AXIS_Z
                hw_a = 0.024
                col_b = EMBED_AXIS_X
                hw_b = 0.024
            }
            n := fm.vec3(0.0, 1.0, 0.0)
            add_grid_quad($&m, fm.vec3(fk, 0.0, -10.0), fm.vec3(fk, 0.0, 10.0), fm.vec3(hw_a, 0.0, 0.0), n, col_a) >>>
            add_grid_quad($&m, fm.vec3(-10.0, 0.0, fk), fm.vec3(10.0, 0.0, fk), fm.vec3(0.0, 0.0, hw_b), n, col_b) >>>
        } else if plane == EMBED_ORTHO_FRONT {
            if k == 0 {
                col_a = EMBED_AXIS_Y
                hw_a = 0.024
                col_b = EMBED_AXIS_X
                hw_b = 0.024
            }
            n := fm.vec3(0.0, 0.0, 1.0)
            add_grid_quad($&m, fm.vec3(fk, -10.0, 0.0), fm.vec3(fk, 10.0, 0.0), fm.vec3(hw_a, 0.0, 0.0), n, col_a) >>>
            add_grid_quad($&m, fm.vec3(-10.0, fk, 0.0), fm.vec3(10.0, fk, 0.0), fm.vec3(0.0, hw_b, 0.0), n, col_b) >>>
        } else {
            if k == 0 {
                col_a = EMBED_AXIS_Y
                hw_a = 0.024
                col_b = EMBED_AXIS_Z
                hw_b = 0.024
            }
            n := fm.vec3(1.0, 0.0, 0.0)
            add_grid_quad($&m, fm.vec3(0.0, -10.0, fk), fm.vec3(0.0, 10.0, fk), fm.vec3(0.0, 0.0, hw_a), n, col_a) >>>
            add_grid_quad($&m, fm.vec3(0.0, fk, -10.0), fm.vec3(0.0, fk, 10.0), fm.vec3(0.0, hw_b, 0.0), n, col_b) >>>
        }
        k += 1
    }
    << device.upload(&m) >>>
}

fn build_embed_particle_emitter(
    att &resource.ParticleEmitter3DAttachment,
    origin fm.Vec3
) ren.ParticleEmitter3D {
    $em := ren.default_particle_emitter_3d(origin)
    rate := math.max(1.0, att.spawn_rate)
    life := math.max(0.15, att.lifetime)
    spd := math.max(0.0, att.speed)
    sz := math.max(0.03, att.size)
    sr := f64((att.start_color >> 16) & 255) / 255.0
    sg := f64((att.start_color >> 8) & 255) / 255.0
    sb := f64(att.start_color & 255) / 255.0
    $sa := f64((att.start_color >> 24) & 255) / 255.0
    if sa < 0.05 { sa = 1.0 }
    er := f64((att.end_color >> 16) & 255) / 255.0
    eg := f64((att.end_color >> 8) & 255) / 255.0
    eb := f64(att.end_color & 255) / 255.0
    ea := f64((att.end_color >> 24) & 255) / 255.0
    em.emit_rate = rate
    em.life_min = math.max(0.08, life * 0.7)
    em.life_max = life
    em.speed_min = spd * 0.65
    em.speed_max = math.max(0.1, spd)
    em.gravity = fm.vec3(0.0, att.gravity, 0.0)
    em.size_start_min = sz * 0.75
    em.size_start_max = sz
    em.color_keys = [
        sr, sg, sb, sa,
        (sr + er) * 0.5, (sg + eg) * 0.5, (sb + eb) * 0.5, sa * 0.75,
        er, eg, eb, math.max(0.15, (sa + ea) * 0.35),
        er, eg, eb, 0.0
    ]
    if att.additive {
        em.start_additive = 1.0
        em.end_additive = 1.0
        em.emissive_scale = 2.6
    } else {
        em.start_additive = 0.0
        em.end_additive = 0.0
        em.emissive_scale = 1.15
    }
    << em
}

fn close_embed_particle_quiet(ps $&ren.GpuParticleSystem3D) {
    _ := ps.close() >>> (err) {
        _ := err
        <<
    }
}

