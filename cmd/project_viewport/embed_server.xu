fn try_apply_world_mat(world $&world3d.Scene3D, tree &scene.SceneTree, nid int, mat ren.Material3D) bool {
    _ := world.set_material(tree, nid, mat) >>> (err) {
        _ := err
        << false
    }
    << true
}

fn try_set_world_mat_override(
    world $&world3d.Scene3D,
    tree &scene.SceneTree,
    nid int,
    mat ren.Material3D,
    fallback_mat ren.Material3D
) {
    keep_ds := world.is_node_double_sided(nid)
    $next_mat := mat
    if keep_ds && !next_mat.is_double_sided() {
        next_mat = next_mat.with_double_sided(true)
    }
    if try_apply_world_mat(world, tree, nid, next_mat) {
        <<
    }
    $plain := fallback_mat
    if keep_ds && !plain.is_double_sided() {
        plain = plain.with_double_sided(true)
    }
    _ := try_apply_world_mat(world, tree, nid, plain)
}

fn apply_world_material_overrides(
    doc &resource.Document,
    scene_mods &imod.SceneModeling3D,
    world $&world3d.Scene3D,
    tree &scene.SceneTree,
    tree_ids &[]int
) {
    for i in 0:doc.material_override_count() {
        ov := doc.material_override(i) >>> (err) {
            _ := err
            ->
        }
        if ov.slot != 0 || ov.node < 0 || ov.node >= tree_ids.len { -> }
        mat3d := scene_mods.resolve_material_3d(&ov.material) >>> (err) {
            _ := err
            ->
        }
        mat_plain := imod.material_asset_to_3d(&ov.material) >>> (err) {
            _ := err
            ->
        }
        try_set_world_mat_override(world, tree, tree_ids[ov.node], mat3d, mat_plain)
    }
}

fn clone_embed_document(doc &resource.Document) resource.Document {
    $refs := []resource.ResourceReference{}
    for i in 0:doc.resource_count() {
        refs.push(doc.resource(i) >>>)
    }
    << resource.with_references(doc, doc, refs) >>>
}

fn cleanup_partial_particles(particles $&[]ren.GpuParticleSystem3D) {
    for ppi in 0:particles.len {
        close_embed_particle_quiet($&particles[ppi])
    }
}

fn load_embed_scene(
    device &ren.Device3D,
    scene_path string,
    has_gpu bool,
    vprog &ren.ParticleProgram3D,
    world $&world3d.Scene3D
) EmbedSceneHost {
    directory := filepath.dir(&scene_path)
    doc_meta := files.load(scene_path + "") >>>
    name := (doc_meta.describe_node(0) >>>).name
    doc_copy := clone_embed_document(&doc_meta) >>>
    $models := models3d.prepare_surfaces(device, doc_copy, directory + "") >>>
    $tree := scene.new_scene_tree_3d("EmbedEditor", 4097) >>> (err) {
        close_embed_models_quiet($&models)
        >> err
    }
    parent := tree.root()
    root := models.instantiate(world, $&tree, parent, name + "") >>> (err) {
        close_embed_world_quiet(world, &tree)
        close_embed_models_quiet($&models)
        >> err
    }
    picker := models.picker(&tree, root) >>> (err) {
        close_embed_world_quiet(world, &tree)
        close_embed_models_quiet($&models)
        >> err
    }
    $scene_mods := imod.prepare_scene_modeling_in_dir(device, &doc_meta, directory + "") >>> (err) {
        close_embed_world_quiet(world, &tree)
        close_embed_models_quiet($&models)
        >> err
    }
    $slights := scene_lights.new_scene_lights_3d()
    has_lights := doc_meta.light_count() > 0
    if has_lights {
        scene_lighting.bind(&doc_meta, $&slights, &tree, root) >>> (err) {
            close_embed_scene_mods_quiet($&scene_mods)
            close_embed_world_quiet(world, &tree)
            close_embed_models_quiet($&models)
            >> err
        }
    }
    tree_ids := tree.subtree(root) >>> (err) {
        close_embed_scene_mods_quiet($&scene_mods)
        close_embed_world_quiet(world, &tree)
        close_embed_models_quiet($&models)
        >> err
    }
    apply_world_material_overrides(&doc_meta, &scene_mods, world, &tree, &tree_ids)

    $particles := []ren.GpuParticleSystem3D{}
    $particle_nodes := []int{}
    if has_gpu && doc_meta.particle_emitter_3d_count() > 0 {
        for pi in 0:doc_meta.particle_emitter_3d_count() {
            att := doc_meta.particle_emitter_3d(pi) >>> (err) {
                cleanup_partial_particles($&particles)
                close_embed_scene_mods_quiet($&scene_mods)
                close_embed_world_quiet(world, &tree)
                close_embed_models_quiet($&models)
                >> err
            }
            $origin := fm.vec3(0.0, 0.0, 0.0)
            if att.node >= 0 && att.node < tree_ids.len {
                origin = (tree.global_transform_3d(tree_ids[att.node]) >>> (err) {
                    cleanup_partial_particles($&particles)
                    close_embed_scene_mods_quiet($&scene_mods)
                    close_embed_world_quiet(world, &tree)
                    close_embed_models_quiet($&models)
                    >> err
                }).c3.xyz()
            }
            $ps := device.gpu_particle_system(vprog, att.max_particles, 2001 + pi * 37) >>> (err) {
                cleanup_partial_particles($&particles)
                close_embed_scene_mods_quiet($&scene_mods)
                close_embed_world_quiet(world, &tree)
                close_embed_models_quiet($&models)
                >> err
            }
            ps.set_emitter(&build_embed_particle_emitter(&att, origin)) >>> (err) {
                close_embed_particle_quiet($&ps)
                cleanup_partial_particles($&particles)
                close_embed_scene_mods_quiet($&scene_mods)
                close_embed_world_quiet(world, &tree)
                close_embed_models_quiet($&models)
                >> err
            }
            for _ in 0:24 {
                ps.step(device, 1.0 / 60.0) >>> (err) {
                    close_embed_particle_quiet($&ps)
                    cleanup_partial_particles($&particles)
                    close_embed_scene_mods_quiet($&scene_mods)
                    close_embed_world_quiet(world, &tree)
                    close_embed_models_quiet($&models)
                    >> err
                }
            }
            particles.push(ps)
            particle_nodes.push(att.node)
        }
    }

    << EmbedSceneHost{
        directory: directory + "",
        doc: doc_meta,
        tree: tree,
        root: root,
        tree_ids: tree_ids,
        models: models,
        picker: picker,
        scene_mods: scene_mods,
        slights: slights,
        has_lights: has_lights,
        particles: particles,
        particle_nodes: particle_nodes
    }
}

