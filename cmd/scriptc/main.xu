@main

compiler #"github.com/xulang-org/nexus/script/compiler"
files #"github.com/xulang-org/nexus/internal/file_snapshot"
#os
#errors

fn run() int {
    args := os.args()
    if args.len < 4 || (args[1] != "check" && args[1] != "build") ||
        (args[1] == "check" && args.len != 4) || (args[1] == "build" && args.len != 5) {
        >>> errors.new("usage: xu-nexus-script check source.xus schema.json | build source.xus schema.json output.xubc")
    }
    source := files.read(args[2] + "", compiler.MAX_SOURCE_BYTES) >>>
    schema := files.read(args[3] + "", compiler.MAX_SOURCE_BYTES) >>>
    program := compiler.compile(source, schema, args[2] + "") >>>
    if args[1] == "build" {
        raw := program.encode() >>>
        files.write_atomic(args[4] + "", &raw) >>>
    }
    println("XuScript scalar-v1: " + str(program.code_count()) + " instructions, " + str(program.field_count()) +
        " fields, " + str(program.signal_count()) + " signals, " + str(program.function_count()) + " callbacks; " + program.fingerprint())
    << 0
}
fn main() int { << run() >>> (err) { eprintln(err.msg())
    << 1 } }
