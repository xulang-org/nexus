@"github.com/xulang-org/game/gpu"

#game_gpu_native
#errors

// Owning GPU resource. Renderer close invalidates all its textures. Pixel
// input is synchronously copied and can be released after texture_rgba returns.
pub struct Texture2D {
    owner int
    handle int
    pub width int
    pub height int
}
pub fn (renderer &Renderer) texture_rgba(width int, height int, pixels &[]int, linear bool) Texture2D {
    $filter := 0
    if linear { filter = 1 }
    handle := checked(game_gpu_native.texture_new(renderer.handle, width, height, pixels, filter)) or >>
    << Texture2D{owner: renderer.handle, handle: handle, width: width, height: height}
}
pub fn (renderer $&Renderer) submit_texture(batch &Batch2D, texture &Texture2D) int {
    if texture.owner != renderer.handle || texture.handle <= 0 { >> errors.new("game GPU: invalid texture owner") }
    << submit_words(renderer.handle, texture.handle, &batch.words) or >>
}
pub fn (texture $&Texture2D) close() int {
    if texture.handle == 0 { << 0 }
    checked(game_gpu_native.texture_close(texture.owner, texture.handle)) or >>
    texture.handle = 0
    << 0
}
fn (texture $&Texture2D) drop() {
    if texture.handle > 0 { game_gpu_native.texture_close(texture.owner, texture.handle)
        texture.handle = 0 }
}
