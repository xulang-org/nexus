@"github.com/xulang-org/game/gpu"

game #"github.com/xulang-org/game"
#game_gpu_native
#errors
#math

// GPU scissor in output coordinates. Fractional edges expand to whole pixels.
// begin() resets the clip, so a previous frame cannot clip a new frame's output.
pub fn (renderer $&Renderer) clip_rect(bounds game.Rect2) int {
    if !bounds.valid() || bounds.position.x < 0.0 || bounds.position.y < 0.0 ||
        bounds.position.x + bounds.size.x > 16384.0 || bounds.position.y + bounds.size.y > 16384.0 {
        >> errors.new("game GPU: invalid clip rectangle")
    }
    x := int(math.floor(bounds.position.x))
    y := int(math.floor(bounds.position.y))
    width := int(math.ceil(bounds.position.x + bounds.size.x)) - x
    height := int(math.ceil(bounds.position.y + bounds.size.y)) - y
    << checked(game_gpu_native.clip(renderer.handle, x, y, width, height)) or >>
}
pub fn (renderer $&Renderer) reset_clip() int {
    << checked(game_gpu_native.reset_clip(renderer.handle)) or >>
}
