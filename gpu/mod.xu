@"github.com/xulang-org/game/gpu"

#game_gpu_native
#errors
game #"github.com/xulang-org/game"

pub const AUTO = 0
pub const METAL = 1
pub const VULKAN = 2
pub const D3D12 = 3
pub const EVENT_NONE = 0
pub const EVENT_QUIT = 1
pub const EVENT_KEY_DOWN = 2
pub const EVENT_KEY_UP = 3
pub const EVENT_FOCUS_LOST = 4
pub const EVENT_POINTER_DOWN = 5
pub const EVENT_POINTER_UP = 6
pub const EVENT_POINTER_MOVE = 7
// Physical positions, using SDL's stable scancode values.
pub const KEY_A = 4
pub const KEY_D = 7
pub const KEY_S = 22
pub const KEY_W = 26
pub const KEY_ESCAPE = 41
pub const KEY_SPACE = 44
pub const KEY_RIGHT = 79
pub const KEY_LEFT = 80
pub const KEY_DOWN = 81
pub const KEY_UP = 82
pub const MAX_VERTICES = 393216

fn checked(status int) int {
    if status >= 0 { << status }
    $message := "game GPU: "
    count := game_gpu_native.error_len()
    for i in 0:count { message = message + string_from_byte(game_gpu_native.error_byte(i)) }
    >> errors.new(message)
}
fn text_bytes(value &string) []int {
    $bytes := []int{}
    for i in 0:value.len { bytes.push(value[i] & 255) }
    << bytes
}
pub fn rgba(red int, green int, blue int, alpha int) int {
    if red < 0 || red > 255 || green < 0 || green > 255 || blue < 0 || blue > 255 || alpha < 0 || alpha > 255 {
        >> errors.new("game GPU: color component outside 0...255")
    }
    << (red << 24) | (green << 16) | (blue << 8) | alpha
}
pub fn backend_name(backend int) string {
    if backend == METAL { << "Metal" }
    if backend == VULKAN { << "Vulkan" }
    if backend == D3D12 { << "D3D12" }
    << "Auto"
}

// Single owning renderer, no public native pointer. Every operation and drop
// must stay on the application main thread. No software fallback is accepted.
pub struct Renderer { handle int }
pub fn open(title string, width int, height int, backend int) Renderer {
    bytes := text_bytes(&title)
    handle := checked(game_gpu_native.open(&bytes, width, height, backend, 0)) or >>
    << Renderer{handle: handle}
}
pub fn (renderer &Renderer) backend() int { << checked(game_gpu_native.backend(renderer.handle)) or >> }
pub fn (renderer &Renderer) width() int { << checked(game_gpu_native.size(renderer.handle, 0)) or >> }
pub fn (renderer &Renderer) height() int { << checked(game_gpu_native.size(renderer.handle, 1)) or >> }
pub fn (renderer $&Renderer) close() int {
    if renderer.handle == 0 { << 0 }
    checked(game_gpu_native.close(renderer.handle)) or >>
    renderer.handle = 0
    << 0
}
fn (renderer $&Renderer) drop() {
    if renderer.handle > 0 { game_gpu_native.close(renderer.handle)
        renderer.handle = 0 }
}
pub struct Event {
    pub kind int
    pub code int
    pub x int
    pub y int
    pub repeated bool
}
pub fn (renderer &Renderer) poll() Event {
    $words := [0, 0, 0, 0, 0]
    checked(game_gpu_native.poll(renderer.handle, $&words)) or >>
    << Event{kind: words[0], code: words[1], x: words[2], y: words[3], repeated: words[4] != 0}
}
pub fn apply_input(input $&game.InputMap, event &Event) int {
    if event.kind == EVENT_KEY_DOWN { input.feed_key(event.code, true) or >> }
    if event.kind == EVENT_KEY_UP { input.feed_key(event.code, false) or >> }
    if event.kind == EVENT_FOCUS_LOST { input.release_all() }
    << 0
}

pub struct Batch2D { words []int }
pub fn new_batch() Batch2D { << Batch2D{words: []int{}} }
pub fn (batch $&Batch2D) clear() { batch.words = []int{} }
pub fn (batch &Batch2D) vertex_count() int { << batch.words.len / 5 }
pub fn (batch &Batch2D) triangle_count() int { << batch.words.len / 15 }
fn valid_point(point game.Vec2) bool {
    << game.finite(point.x) && game.finite(point.y) && point.x >= -1000000.0 && point.x <= 1000000.0 &&
        point.y >= -1000000.0 && point.y <= 1000000.0
}
fn (batch $&Batch2D) vertex(point game.Vec2, color int, u f64, v f64) {
    batch.words.push(int(point.x * 1024.0))
    batch.words.push(int(point.y * 1024.0))
    batch.words.push(color)
    batch.words.push(int(u * 1048576.0))
    batch.words.push(int(v * 1048576.0))
}
pub fn (batch $&Batch2D) triangle(a game.Vec2, b game.Vec2, c game.Vec2, color int) int {
    if batch.vertex_count() > MAX_VERTICES - 3 || color < 0 || color > 4294967295 ||
        !valid_point(a) || !valid_point(b) || !valid_point(c) {
        >> errors.new("game GPU: triangle outside batch or coordinate limits")
    }
    batch.vertex(a, color, 0.0, 0.0)
    batch.vertex(b, color, 0.0, 0.0)
    batch.vertex(c, color, 0.0, 0.0)
    << 0
}
// Geometry is transformed in Xu, then submitted as one ordered triangle batch.
pub fn (batch $&Batch2D) quad(bounds game.Rect2, transform game.Transform2D, color int) int {
    << batch.quad_region(bounds, transform, color, game.rect2(0.0, 0.0, 1.0, 1.0)) or >>
}
// Normalized UV rectangle supports texture atlases; tint is straight RGBA8.
pub fn (batch $&Batch2D) quad_region(bounds game.Rect2, transform game.Transform2D, color int, uv game.Rect2) int {
    if !bounds.valid() || !transform.is_finite() { >> errors.new("game GPU: invalid quad") }
    if !uv.valid() || uv.position.x < 0.0 || uv.position.y < 0.0 ||
        uv.position.x + uv.size.x > 1.0 || uv.position.y + uv.size.y > 1.0 {
        >> errors.new("game GPU: UV region outside texture")
    }
    a := transform.point(bounds.position)
    b := transform.point(bounds.position.add(game.vec2(bounds.size.x, 0.0)))
    c := transform.point(bounds.position.add(bounds.size))
    d := transform.point(bounds.position.add(game.vec2(0.0, bounds.size.y)))
    if batch.vertex_count() > MAX_VERTICES - 6 || color < 0 || color > 4294967295 ||
        !valid_point(a) || !valid_point(b) || !valid_point(c) || !valid_point(d) {
        >> errors.new("game GPU: quad outside batch or coordinate limits")
    }
    batch.vertex(a, color, uv.position.x, uv.position.y)
    batch.vertex(b, color, uv.position.x + uv.size.x, uv.position.y)
    batch.vertex(c, color, uv.position.x + uv.size.x, uv.position.y + uv.size.y)
    batch.vertex(a, color, uv.position.x, uv.position.y)
    batch.vertex(c, color, uv.position.x + uv.size.x, uv.position.y + uv.size.y)
    batch.vertex(d, color, uv.position.x, uv.position.y + uv.size.y)
    << 0
}
pub fn (renderer $&Renderer) begin(background int) int {
    if background < 0 || background > 4294967295 { >> errors.new("game GPU: invalid clear color") }
    checked(game_gpu_native.begin(renderer.handle, background)) or >>
    << 0
}
// Batches execute in submission order. Adjacent sprites sharing a texture can batch.
pub fn (renderer $&Renderer) submit(batch &Batch2D) int {
    << submit_words(renderer.handle, 0, &batch.words) or >>
}
fn submit_words(handle int, texture int, words &[]int) int {
    << checked(game_gpu_native.triangles(handle, texture, words)) or >>
}
pub fn (renderer $&Renderer) present() int { << checked(game_gpu_native.present(renderer.handle)) or >> }
// Explicit GPU readback for diagnostics. Call after submit, before present.
pub fn (renderer &Renderer) read_pixel(x int, y int) int {
    << checked(game_gpu_native.read_pixel(renderer.handle, x, y)) or >>
}
pub fn (renderer &Renderer) capture(path string) int {
    bytes := text_bytes(&path)
    << checked(game_gpu_native.capture(renderer.handle, &bytes)) or >>
}
