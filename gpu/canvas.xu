@"github.com/xulang-org/game/gpu"

game #"github.com/xulang-org/game"
#errors

pub struct ColorRect2D {
    pub node int
    pub bounds game.Rect2
    pub color int
}
pub struct Canvas2D { items []ColorRect2D }
pub fn new_canvas() Canvas2D { << Canvas2D{items: []ColorRect2D{}} }
pub fn (canvas $&Canvas2D) add_rect(node int, bounds game.Rect2, color int) int {
    if node <= 0 || !bounds.valid() || color < 0 || color > 4294967295 || canvas.items.len >= 65536 {
        >> errors.new("game GPU: invalid canvas item or canvas capacity exceeded")
    }
    canvas.items.push(ColorRect2D{node: node, bounds: bounds, color: color})
    << 0
}
// Items follow scene pre-order. Freed or hidden nodes produce no geometry.
// Camera is a world-to-screen transform, independent of scene ownership.
pub fn (canvas &Canvas2D) record(tree &game.SceneTree, camera game.Transform2D, batch $&Batch2D) int {
    order := tree.subtree(tree.root()) or >>
    for id in order {
        if !(tree.is_visible(id) or >>) { -> }
        global := tree.global_transform(id) or >>
        transform := camera.multiply(global)
        for item in canvas.items {
            if item.node == id { batch.quad(item.bounds, transform, item.color) or >> }
        }
    }
    << 0
}
