@"github.com/xulang-org/game/gpu"

game #"github.com/xulang-org/game"

// Texture storage belongs to Texture2D; a sprite only records scene geometry.
// Record adjacent sprites into one Batch2D, then submit_texture with their atlas.
pub struct Sprite2D {
    pub node int
    pub bounds game.Rect2
    pub region game.Rect2
    pub tint int
}
pub fn (sprite &Sprite2D) record(tree &game.SceneTree, camera game.Transform2D, batch $&Batch2D) int {
    if !tree.is_alive(sprite.node) || !(tree.is_visible(sprite.node) or >>) { << 0 }
    global := tree.global_transform(sprite.node) or >>
    << batch.quad_region(sprite.bounds, camera.multiply(global), sprite.tint, sprite.region) or >>
}
