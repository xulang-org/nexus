const MAX_SINGLE_ASSET_WARN_BYTES = 67108864   // 64 MiB
const MAX_TOTAL_ASSETS_WARN_BYTES = 536870912 // 512 MiB
const MAX_HASH_DEDUP_BYTES = 16777216         // 16 MiB

pub struct DoctorOptions {
    pub fix bool
    pub dry_run bool
    pub check_toolchain bool
    pub category_filter string
}

pub fn default_doctor_options() DoctorOptions {
    << DoctorOptions{fix: false, dry_run: false, check_toolchain: false, category_filter: ""}
}

pub struct DoctorIssue {
    pub code string
    pub severity string
    pub category string
    pub path string
    pub message string
    pub hint string
    pub fixable bool
}

pub struct DoctorReport {
    pub project_path string
    pub passed bool
    pub checks_run int
    pub error_count int
    pub warning_count int
    pub fixed_count int
    pub dry_run bool
    pub fixes_applied []string
    pub issues []DoctorIssue
}

fn push_issue(issues $&[]DoctorIssue, errors $&int, warnings $&int,
        code string, severity string, category string, path string, message string, hint string, fixable bool) {
    if severity == "error" {
        *errors = *errors + 1
    } else if severity == "warning" {
        *warnings = *warnings + 1
    }
    issues.push(DoctorIssue{
        code: code + "",
        severity: severity + "",
        category: category + "",
        path: path + "",
        message: message + "",
        hint: hint + "",
        fixable: fixable
    })
}

fn try_resolve_rel(dir &string, rel &string) string {
    << resolve_project_path(dir, rel, true) >>> (err) {
        _ := err.msg()
        << ""
    }
}

fn try_dir_exists(dir &string, rel &string) bool {
    trimmed := strings.trim_space(rel)
    if trimmed.len == 0 { << false }
    full := filepath.join([*dir, trimmed + ""])
    info := os.stat(full + "") >>> (err) {
        _ := err.msg()
        << false
    }
    << info.is_dir
}

fn try_check_scene(proj &Project, s &Entry,
        referenced_uids $&map[string]bool,
        uid_expected_kind $&map[string]string,
        scene_ref_hashes $&[]string,
        scene_ref_uids $&[]string,
        scene_ref_scenes $&[]string,
        warn_msgs $&[]string) string {
    raw := snapshot.read(s.resolved + "", scene_fmt.MAX_BYTES) >>> (err) {
        << "cannot read scene: " + err.msg()
    }
    doc := scene_fmt.decode(&raw) >>> (err) {
        << "invalid scene format: " + err.msg()
    }
    for i in 0:doc.resource_count() {
        r := doc.resource(i) >>> (err) { << err.msg() }
        _ := proj.asset_source(&r.uid) >>> (err) {
            << "scene '" + s.key + "' references missing/unregistered asset UID '" + r.uid + "': " + err.msg()
        }
        referenced_uids[r.uid + ""] = true
        if !uid_expected_kind.has(r.uid + "") && r.kind.len > 0 {
            uid_expected_kind[r.uid + ""] = r.kind + ""
        }
        if r.content_hash.len > 0 {
            scene_ref_uids.push(r.uid + "")
            scene_ref_hashes.push(r.content_hash + "")
            scene_ref_scenes.push(s.path + "")
        }
    }
    if doc.node_count() > 3072 {
        warn_msgs.push("scene '" + s.key + "' has " + str(doc.node_count()) + " nodes (near limit " + str(resource.MAX_NODES) + ")")
    }
    if doc.audio_count() > 24 {
        warn_msgs.push("scene '" + s.key + "' has " + str(doc.audio_count()) + " audio emitters (near limit 32)")
    }
    if doc.script_count() > 24 {
        warn_msgs.push("scene '" + s.key + "' has " + str(doc.script_count()) + " scripts (near limit 32)")
    }
    << ""
}

struct I18nCheckResult {
    err string
    warn string
    parity_warns []string
}

fn try_check_i18n(resolved &string, default_locale &string) I18nCheckResult {
    $res := I18nCheckResult{err: "", warn: "", parity_warns: []string{}}
    raw := snapshot.read(*resolved + "", 4194304) >>> (err) {
        res.err = err.msg()
        << res
    }
    lower := strings.to_lower(resolved)
    $cat := ri.new_catalog("en-US") >>> (err) {
        res.err = err.msg()
        << res
    }
    if strings.ends_with(&lower, ".csv") {
        $def_l := "en-US"
        if default_locale.len > 0 { def_l = *default_locale + "" }
        cat = ri.decode_catalog_csv(&raw, def_l) >>> (err) {
            res.err = err.msg()
            << res
        }
    } else {
        cat = ri.decode_catalog_json(&raw) >>> (err) {
            res.err = err.msg()
            << res
        }
    }
    $norm := ""
    if default_locale.len > 0 {
        norm = ri.normalize_locale(default_locale) >>> (err) {
            res.err = err.msg()
            << res
        }
        locs := cat.locales()
        $found := false
        for i in 0:locs.len {
            if locs[i] == norm { found = true }
        }
        if !found {
            res.warn = "i18n catalog has no entries for default_locale '" + norm + "'"
        }
    } else {
        norm = cat.default_loc()
    }

    // Key parity across locales compared to base locale.
    locs := cat.locales()
    keys := cat.keys()
    if locs.len > 1 && keys.len > 0 {
        $base_loc := norm + ""
        $has_base := false
        for i in 0:locs.len {
            if locs[i] == base_loc { has_base = true }
        }
        if !has_base {
            base_loc = cat.default_loc()
            for i in 0:locs.len {
                if locs[i] == base_loc { has_base = true }
            }
        }
        if !has_base {
            base_loc = locs[0] + ""
        }
        $base_keys := []string{}
        for ki in 0:keys.len {
            k := keys[ki] + ""
            if cat.has_entry(base_loc + "", k + "") {
                base_keys.push(k)
            }
        }
        if base_keys.len > 0 {
            for li in 0:locs.len {
                loc := locs[li] + ""
                if loc == base_loc { -> }
                $missing_cnt := 0
                $sample_key := ""
                for ki in 0:base_keys.len {
                    k := base_keys[ki] + ""
                    if !cat.has_entry(loc + "", k + "") {
                        if missing_cnt == 0 { sample_key = k + "" }
                        missing_cnt += 1
                    }
                }
                if missing_cnt > 0 {
                    res.parity_warns.push("locale '" + loc + "' is missing " + str(missing_cnt) + " key(s) present in '" + base_loc + "' (e.g. '" + sample_key + "')")
                }
            }
        }
    }
    << res
}

fn try_check_input(resolved &string) string {
    raw := snapshot.read(*resolved + "", 262144) >>> (err) { << err.msg() }
    $im := inp.new_input_map()
    _ := im.import_bindings_json(&raw) >>> (err) { << err.msg() }
    << ""
}

fn try_check_perf_budgets(resolved &string, has_switch bool, template &string, warns $&[]string) string {
    raw := snapshot.read(*resolved + "", 1048576) >>> (err) { << err.msg() }
    _ := rp.validate_perf_budgets_json(&raw) >>> (err) { << err.msg() }
    doc := json.parse_max(&raw, 1048576)
    if doc.ok() {
        root := doc.root()
        if doc.has(root, "profiles") {
            profs := doc.get(root, "profiles")
            keys := doc.dict_keys(profs)
            $has_switch_prof := false
            $has_desktop_prof := false
            for i in 0:keys.len {
                k := strings.to_lower(&keys[i])
                if strings.contains(&k, "switch") { has_switch_prof = true }
                if strings.contains(&k, "desktop") || strings.contains(&k, "60fps") { has_desktop_prof = true }
            }
            if has_switch && !has_switch_prof {
                warns.push("Switch target is configured but perf_budgets.json has no Switch profile")
            }
            if (*template == rp.TEMPLATE_3D || *template == rp.TEMPLATE_25D) && !has_desktop_prof {
                warns.push("3D/25D project perf_budgets.json has no desktop/60fps baseline profile")
            }
        }
    }
    << ""
}

