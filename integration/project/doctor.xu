fn try_read_xun(path &string) string {
    << snapshot.read(*path + "", 65536) >>> (err) {
        _ := err.msg()
        << ""
    }
}

fn extract_nexus_file_dep(xun_raw &string) string {
    lines := strings.split(xun_raw, "\n")
    for i in 0:lines.len {
        line := strings.trim_space(&lines[i])
        if !strings.contains(&line, "github.com/xulang-org/nexus") { -> }
        idx := strings.index_of(&line, "file:")
        if idx < 0 { -> }
        $rest := line[idx + 5 : line.len] + ""
        rest = strings.trim_space(&rest)
        if rest.len >= 2 && (rest[0] & 255) == 34 {
            sub := rest[1:rest.len] + ""
            endq := strings.index_of(&sub, "\"")
            if endq >= 0 { rest = rest[1 : 1 + endq] + "" }
        } else {
            // Strip trailing whitespace or comment.
            $end := 0
            while end < rest.len {
                c := rest[end] & 255
                if c == 32 || c == 9 || c == 34 || c == 35 { <- }
                end += 1
            }
            rest = rest[0:end] + ""
        }
        << rest
    }
    << ""
}

fn walk_rel_files(base_abs &string, base_rel &string, max_depth int, out $&[]string) {
    $abs_q := []string{}
    abs_q.push(base_abs + "")
    $rel_q := []string{}
    rel_q.push(base_rel + "")
    $dep_q := []int{}
    dep_q.push(0)
    $head := 0
    while head < abs_q.len {
        cur_abs := abs_q[head] + ""
        cur_rel := rel_q[head] + ""
        cur_dep := dep_q[head]
        head += 1
        if cur_dep > max_depth { -> }
        ents := os.entries(cur_abs + "") >>> (err) {
            _ := err.msg()
            ->
        }
        for i in 0:ents.len {
            name := ents[i].name + ""
            if name.len == 0 || (name[0] & 255) == 46 { -> }
            next_abs := filepath.join([cur_abs + "", name + ""])
            $next_rel := name + ""
            if cur_rel.len > 0 {
                next_rel = cur_rel + "/" + name
            }
            if ents[i].is_dir {
                abs_q.push(next_abs)
                rel_q.push(next_rel)
                dep_q.push(cur_dep + 1)
            } else {
                out.push(next_rel)
            }
        }
    }
}

fn is_tracked_asset_ext(ext &string) bool {
    << *ext == ".glb" || *ext == ".obj" || *ext == ".stl" || *ext == ".png" ||
        *ext == ".jpg" || *ext == ".jpeg" || *ext == ".wav" || *ext == ".xubc" || *ext == ".xus"
}

fn read_header_16(path &string) string {
    $f := os.open(*path + "") >>> (err) {
        _ := err.msg()
        << ""
    }
    hdr := f.read(16) >>> (err) {
        _ := err.msg()
        _ := f.close()
        << ""
    }
    _ := f.close()
    << hdr
}

fn check_magic_bytes(ext &string, size_bytes int, hdr &string) string {
    if *ext == ".png" {
        if hdr.len < 8 ||
           (hdr[0] & 255) != 137 || (hdr[1] & 255) != 80 || (hdr[2] & 255) != 78 || (hdr[3] & 255) != 71 ||
           (hdr[4] & 255) != 13 || (hdr[5] & 255) != 10 || (hdr[6] & 255) != 26 || (hdr[7] & 255) != 10 {
            << "invalid PNG magic header"
        }
    } else if *ext == ".glb" {
        if size_bytes < 12 || hdr.len < 4 ||
           (hdr[0] & 255) != 103 || (hdr[1] & 255) != 108 || (hdr[2] & 255) != 84 || (hdr[3] & 255) != 70 {
            << "invalid GLB magic header (expected 'glTF')"
        }
    } else if *ext == ".wav" {
        if size_bytes < 12 || hdr.len < 12 ||
           (hdr[0] & 255) != 82 || (hdr[1] & 255) != 73 || (hdr[2] & 255) != 70 || (hdr[3] & 255) != 70 ||
           (hdr[8] & 255) != 87 || (hdr[9] & 255) != 65 || (hdr[10] & 255) != 86 || (hdr[11] & 255) != 69 {
            << "invalid WAV magic header (expected RIFF/WAVE)"
        }
    } else if *ext == ".jpg" || *ext == ".jpeg" {
        if hdr.len < 3 ||
           (hdr[0] & 255) != 255 || (hdr[1] & 255) != 216 || (hdr[2] & 255) != 255 {
            << "invalid JPEG magic header"
        }
    }
    << ""
}

fn kind_matches_ext(kind &string, ext &string) bool {
    if *kind == "glb_model" { << *ext == ".glb" }
    if *kind == "wav_clip" { << *ext == ".wav" }
    if *kind == "image_rgba" { << *ext == ".png" || *ext == ".jpg" || *ext == ".jpeg" }
    if *kind == "xu_bytecode" { << *ext == ".xubc" }
    << true
}

fn str_in_list(list &[]string, val &string) bool {
    for i in 0:list.len {
        if list[i] == *val { << true }
    }
    << false
}

fn int_in_list(list &[]int, val int) bool {
    for i in 0:list.len {
        if list[i] == val { << true }
    }
    << false
}

fn json_str_or_empty(doc &json.Doc, node int) string {
    << doc.as_string(node) >>> (err) {
        _ := err.msg()
        << ""
    }
}

fn json_int_or(doc &json.Doc, node int, fallback int) int {
    << doc.as_int(node) >>> (err) {
        _ := err.msg()
        << fallback
    }
}

