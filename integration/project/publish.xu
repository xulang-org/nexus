@"github.com/xulang-org/nexus/integration/project"

resource #"github.com/xulang-org/nexus/resources/scene"
node_files #"github.com/xulang-org/nexus/integration/scene"
scene_fmt #"github.com/xulang-org/nexus/formats/scene"
snapshot #"github.com/xulang-org/nexus/internal/file_snapshot"
#crypto/sha256
#encoding/json
#path/filepath
#strconv
#strings
#os
#os/exec
#errors

pub struct PrimitiveInfo {
    pub triangles int
    pub has_uvs bool
    pub has_tangents bool
    pub needs_uvs bool
    pub needs_tangents bool
}

pub struct ImportRecord {
    pub uid string
    pub kind string
    pub source_rel string
    pub resolved string
    pub source_hash string
    pub validator_hash string
    pub size_bytes int
    pub cached bool
    pub primitives []PrimitiveInfo
}

pub struct PublishResult {
    pub generation string
    pub root string
    pub rebuilt_assets int
    pub reused_assets int
    pub scenes []Entry
}

pub struct ImportAssetResult {
    pub uid string
    pub rel_path string
    pub resolved string
    pub reused bool
    pub primitive_count int
}

const MODE_READ_ONLY = 292 // 0o444

pub fn sha256_file(path string) string {
    $f := os.open(path + "") >>>
    $digest := sha256.new()
    while true {
        chunk := f.read(65536) >>> (err) {
            _ := f.close()
            >>> err
        }
        if chunk.len == 0 {
            <-
        }
        digest.write(&chunk)
    }
    f.close() >>>
    << digest.sum()
}

pub fn resolve_validator_path(validator string) string {
    raw := strings.trim_space(&validator)
    $cand := DEFAULT_VALIDATOR
    if raw.len > 0 {
        cand = raw
    }
    if strings.contains(&cand, "/") || strings.contains(&cand, "\\") {
        abs := filepath.abs(&cand) >>>
        info := os.stat(abs + "") >>>
        if info.is_dir {
            >>> errors.new("nexus project: validator path is a directory: " + abs)
        }
        << abs
    }
    found := exec.look_path(cand + "") >>>
    abs := filepath.abs(&found) >>>
    << abs
}

pub fn validate_glb_primitives(validator string, glb_path string) []PrimitiveInfo {
    bin := resolve_validator_path(validator + "") >>>
    cmd := exec.command(bin + "", "glb", glb_path + "")
    out := cmd.combined_output() >>> (err) {
        >>> errors.new("nexus project: GLB validation failed for " + glb_path + ": " + err.msg())
    }
    lines := strings.split(&out, "\n")
    $prims := []PrimitiveInfo{}
    for raw_line in lines {
        line := strings.trim_space(&raw_line)
        if line.len == 0 { -> }
        cols := strings.fields(&line)
        if cols.len != 5 {
            >>> errors.new("nexus project: malformed validator output: " + line)
        }
        tris := strconv.atoi(&cols[0]) >>>
        if tris < 0 {
            >>> errors.new("nexus project: negative primitive triangle count")
        }
        prims.push(PrimitiveInfo{
            triangles: tris,
            has_uvs: cols[1] == "1",
            has_tangents: cols[2] == "1",
            needs_uvs: cols[3] == "1",
            needs_tangents: cols[4] == "1"
        })
    }
    if prims.len == 0 {
        >>> errors.new("nexus project: GLB contains no mesh primitives: " + glb_path)
    }
    << prims
}

fn load_receipt(path &string, validator_hash &string, glb_hash &string) []PrimitiveInfo {
    if !path_exists(path + "") {
        << []PrimitiveInfo{}
    }
    raw := snapshot.read(path + "", 1048576) >>> (err) { << []PrimitiveInfo{} }
    doc := json.parse_max(&raw, 1048576)
    if !doc.ok() { << []PrimitiveInfo{} }
    root := doc.root()
    if !doc.is_dict(root) { << []PrimitiveInfo{} }
    vhash := doc.as_string(doc.get(root, "validator_sha256")) >>> (err) { << []PrimitiveInfo{} }
    ghash := doc.as_string(doc.get(root, "glb_sha256")) >>> (err) { << []PrimitiveInfo{} }
    if vhash != validator_hash + "" || ghash != glb_hash + "" {
        << []PrimitiveInfo{}
    }
    list := doc.get(root, "primitives")
    if list < 0 || !doc.is_list(list) || doc.count(list) < 1 {
        << []PrimitiveInfo{}
    }
    $prims := []PrimitiveInfo{}
    for i in 0:doc.count(list) {
        row := doc.at(list, i)
        if !doc.is_dict(row) { << []PrimitiveInfo{} }
        tris := doc.as_int(doc.get(row, "triangles")) >>> (err) { << []PrimitiveInfo{} }
        has_uvs := doc.as_bool(doc.get(row, "has_uvs")) >>> (err) { << []PrimitiveInfo{} }
        has_tangents := doc.as_bool(doc.get(row, "has_tangents")) >>> (err) { << []PrimitiveInfo{} }
        needs_uvs := doc.as_bool(doc.get(row, "needs_uvs")) >>> (err) { << []PrimitiveInfo{} }
        needs_tangents := doc.as_bool(doc.get(row, "needs_tangents")) >>> (err) { << []PrimitiveInfo{} }
        prims.push(PrimitiveInfo{
            triangles: tris,
            has_uvs: has_uvs,
            has_tangents: has_tangents,
            needs_uvs: needs_uvs,
            needs_tangents: needs_tangents
        })
    }
    << prims
}

fn save_receipt(path &string, validator_hash &string, glb_hash &string, prims &[]PrimitiveInfo) int {
    ensure_parent_dir(path) >>>
    $out := strings.new_byte_builder(512)
    out.write_str("{\"validator_sha256\":" + json.quote(validator_hash) +
        ",\"glb_sha256\":" + json.quote(glb_hash) + ",\"primitives\":[")
    for i in 0:prims.len {
        if i > 0 { out.write_str(",") }
        p := prims[i]
        out.write_str("{\"triangles\":" + str(p.triangles) +
            ",\"has_uvs\":" + strconv.format_bool(p.has_uvs) +
            ",\"has_tangents\":" + strconv.format_bool(p.has_tangents) +
            ",\"needs_uvs\":" + strconv.format_bool(p.needs_uvs) +
            ",\"needs_tangents\":" + strconv.format_bool(p.needs_tangents) + "}")
    }
    out.write_str("]}\n")
    raw := out.to_string()
    snapshot.write_atomic(path + "", &raw) >>>
    << 0
}

fn asset_filename(hash &string, kind &string) string {
    if *kind == "image_rgba" { << *hash + ".png" }
    if *kind == "wav_clip" { << *hash + ".wav" }
    if *kind == "xu_bytecode" { << *hash + ".xubc" }
    << *hash + ".glb"
}

fn published_asset_filename(record &ImportRecord) string {
    if record.kind == "image_rgba" { << record.uid + ".png" }
    if record.kind == "wav_clip" { << record.uid + ".wav" }
    if record.kind == "xu_bytecode" { << record.uid + ".xubc" }
    << asset_filename(&record.source_hash, &record.kind)
}

fn validate_simple_snapshot(raw &string, validator_bin &string, validator_hash &string,
    source_hash &string, cache_dir &string, mode string, ext string, label string) bool {
    receipt := filepath.join([*cache_dir, "imports", *source_hash + ext + ".receipt"])
    if path_exists(receipt + "") {
        saved := snapshot.read(receipt + "", 128) >>>
        if saved == *validator_hash { << true }
    }
    candidate := filepath.join([*cache_dir, ".validate-" + str(os.getpid()) + "-" + str(now_ns()) + ext])
    snapshot.write_atomic(candidate + "", raw) >>>
    cmd := exec.command(*validator_bin, mode + "", candidate + "")
    cmd.combined_output() >>> (err) {
        _ := os.remove(candidate + "")
        >>> errors.new("nexus project: " + label + " validation failed: " + err.msg())
    }
    os.remove(candidate + "") >>>
    ensure_parent_dir(&receipt) >>>
    snapshot.write_atomic(receipt, validator_hash) >>>
    << false
}

fn import_source(entry &Entry, validator_bin &string, validator_hash &string, cache_dir &string) ImportRecord {
    suffix := strings.to_lower(&filepath.ext(&entry.path))
    if suffix != ".glb" && suffix != ".png" && suffix != ".wav" && suffix != ".xubc" {
        >>> errors.new("nexus project: expected .glb, .png, .wav or .xubc source: " + entry.path)
    }
    raw := snapshot.read(entry.resolved + "", snapshot.MAX_BYTES) >>>
    source_hash := sha256.sum256(raw + "")
    if suffix == ".png" {
        cached := validate_simple_snapshot(&raw, validator_bin, validator_hash, &source_hash, cache_dir, "png", ".png", "PNG") >>>
        << ImportRecord{uid: entry.key + "", kind: "image_rgba", source_rel: entry.path + "", resolved: entry.resolved + "",
            source_hash: source_hash, validator_hash: *validator_hash, size_bytes: raw.len,
            cached: cached, primitives: []PrimitiveInfo{}}
    }
    if suffix == ".wav" {
        cached := validate_simple_snapshot(&raw, validator_bin, validator_hash, &source_hash, cache_dir, "wav", ".wav", "WAV") >>>
        << ImportRecord{uid: entry.key + "", kind: "wav_clip", source_rel: entry.path + "", resolved: entry.resolved + "",
            source_hash: source_hash, validator_hash: *validator_hash, size_bytes: raw.len,
            cached: cached, primitives: []PrimitiveInfo{}}
    }
    if suffix == ".xubc" {
        cached := validate_simple_snapshot(&raw, validator_bin, validator_hash, &source_hash, cache_dir, "script", ".xubc", "Script") >>>
        << ImportRecord{uid: entry.key + "", kind: "xu_bytecode", source_rel: entry.path + "", resolved: entry.resolved + "",
            source_hash: source_hash, validator_hash: *validator_hash, size_bytes: raw.len,
            cached: cached, primitives: []PrimitiveInfo{}}
    }
    receipt := filepath.join([cache_dir + "", "imports", source_hash + ".json"])
    $prims := load_receipt(&receipt, validator_hash, &source_hash)
    $cached := prims.len > 0
    if !cached {
        prims = validate_glb_primitives(validator_bin + "", entry.resolved + "") >>>
        save_receipt(&receipt, validator_hash, &source_hash, &prims) >>>
    }
    << ImportRecord{
        uid: entry.key + "",
        kind: "glb_model",
        source_rel: entry.path + "",
        resolved: entry.resolved + "",
        source_hash: source_hash,
        validator_hash: validator_hash + "",
        size_bytes: raw.len,
        cached: cached,
        primitives: prims
    }
}

fn check_primitive_binding(uid &string, prim_idx int, prims &[]PrimitiveInfo, context &string) PrimitiveInfo {
    if prim_idx < 0 || prim_idx >= prims.len {
        >>> errors.new("nexus project: " + context + " primitive " + str(prim_idx) +
            " outside GLB asset '" + uid + "' (count=" + str(prims.len) + ")")
    }
    p := prims[prim_idx]
    if p.needs_uvs && !p.has_uvs {
        >>> errors.new("nexus project: " + context + " requires UVs missing on '" + uid + "' primitive " + str(prim_idx))
    }
    if p.needs_tangents && !p.has_tangents {
        >>> errors.new("nexus project: " + context + " requires tangents missing on '" + uid + "' primitive " + str(prim_idx))
    }
    << p
}

pub fn check_surface_bindings(document &resource.Document, records &[]ImportRecord) int {
    $by_uid := map[string]int{}
    for i in 0:records.len {
        by_uid[records[i].uid + ""] = i
    }
    for i in 0:document.surface_count() {
        surface := document.surface(i) >>>
        if !by_uid.has(surface.resource_uid + "") {
            >>> errors.new("nexus project: surface references unregistered UID '" + surface.resource_uid + "'")
        }
        base_idx := by_uid[surface.resource_uid + ""]
        base_rec := &records[base_idx]
        base_prim := check_primitive_binding(&surface.resource_uid, surface.primitive, &base_rec.primitives, &"surface") >>>
        $prev_tris := base_prim.triangles
        $prev_dist := -1.0
        for j in 0:surface.levels.len {
            lvl := &surface.levels[j]
            if lvl.distance <= 0.0 || (prev_dist > 0.0 && lvl.distance <= prev_dist) {
                >>> errors.new("nexus project: surface LOD distances must be strictly increasing positive values")
            }
            if !by_uid.has(lvl.resource_uid + "") {
                >>> errors.new("nexus project: LOD level references unregistered UID '" + lvl.resource_uid + "'")
            }
            lrec_idx := by_uid[lvl.resource_uid + ""]
            lrec := &records[lrec_idx]
            lp := check_primitive_binding(&lvl.resource_uid, lvl.primitive, &lrec.primitives, &"LOD") >>>
            if lp.triangles > prev_tris {
                >>> errors.new("nexus project: LOD level triangles (" + str(lp.triangles) +
                    ") exceed finer level (" + str(prev_tris) + ")")
            }
            prev_tris = lp.triangles
            prev_dist = lvl.distance
        }
    }
    << 0
}

fn copy_document_with_resources(document &resource.Document, next_refs []resource.ResourceReference) resource.Document {
    << resource.with_references(document, document, next_refs) >>>
}

struct CookedScene {
    key string
    encoded string
    assets []string
}

fn cook_scene_raw(scene_key &string, raw &string, records &[]ImportRecord) CookedScene {
    document := scene_fmt.decode(raw) >>>
    if document.resource_count() > resource.MAX_RESOURCES {
        >>> errors.new("nexus project: scene exceeds resource limit of 32")
    }
    $by_uid := map[string]int{}
    for i in 0:records.len {
        by_uid[records[i].uid + ""] = i
    }
    check_surface_bindings(&document, records) >>>
    $seen_hashes := map[string]int{}
    $assets := []string{}
    $total_bytes := 0
    $next_refs := []resource.ResourceReference{}
    for i in 0:document.resource_count() {
        ref := document.resource(i) >>>
        if ref.kind != "glb_model" && ref.kind != "image_rgba" && ref.kind != "wav_clip" && ref.kind != "xu_bytecode" {
            >>> errors.new("nexus project: unsupported scene resource type '" + ref.kind + "' in " + scene_key)
        }
        if !by_uid.has(ref.uid + "") {
            >>> errors.new("nexus project: scene '" + scene_key + "' references unregistered UID '" + ref.uid + "'")
        }
        rec_idx := by_uid[ref.uid + ""]
        rec := &records[rec_idx]
        if rec.kind != ref.kind { >>> errors.new("nexus project: scene resource type does not match asset '" + ref.uid + "'") }
        filename := asset_filename(&rec.source_hash, &rec.kind)
        published_name := published_asset_filename(rec)
        assets.push(published_name + "")
        if !seen_hashes.has(filename + "") {
            seen_hashes[filename + ""] = 1
            total_bytes = total_bytes + rec.size_bytes
            if total_bytes > snapshot.MAX_BYTES {
                >>> errors.new("nexus project: scene '" + scene_key + "' asset source budget exceeds 32 MiB")
            }
        }
        next_refs.push(resource.ResourceReference{
            uid: ref.uid + "",
            kind: ref.kind + "",
            path: "assets/" + published_name,
            content_hash: rec.source_hash + ""
        })
    }
    cooked_doc := copy_document_with_resources(&document, next_refs) >>>
    encoded := scene_fmt.encode(&cooked_doc) >>>
    _ := scene_fmt.decode(&encoded) >>>
    << CookedScene{key: scene_key + "", encoded: encoded, assets: assets}
}

fn link_or_copy_readonly(src &string, dst &string) int {
    ensure_parent_dir(dst) >>>
    if path_exists(dst + "") {
        << 0
    }
    ln_res := exec.command("ln", src + "", dst + "").run_status() >>> (err) {
        << 1
    }
    if ln_res == 0 {
        _ := os.chmod(dst + "", MODE_READ_ONLY)
        << 0
    }
    data := snapshot.read(src + "", snapshot.MAX_BYTES) >>>
    snapshot.write_atomic(dst + "", &data) >>>
    os.chmod(dst + "", MODE_READ_ONLY) >>>
    << 0
}

fn ensure_store_asset(store_dir &string, rec &ImportRecord) string {
    store_path := filepath.join([store_dir + "", asset_filename(&rec.source_hash, &rec.kind)])
    if path_exists(store_path + "") {
        existing_hash := sha256_file(store_path + "") >>> (err) { << "" }
        if existing_hash == rec.source_hash {
            _ := os.chmod(store_path + "", MODE_READ_ONLY)
            << store_path
        }
    }
    ensure_parent_dir(&store_path) >>>
    raw := snapshot.read(rec.resolved + "", snapshot.MAX_BYTES) >>>
    if sha256.sum256(raw + "") != rec.source_hash {
        >>> errors.new("nexus project: source asset changed during publish: " + rec.source_rel)
    }
    snapshot.write_atomic(store_path + "", &raw) >>>
    os.chmod(store_path + "", MODE_READ_ONLY) >>>
    << store_path
}

fn finish_stage_rename(stage_dir &string, gen_dir &string) int {
    os.rename(stage_dir + "", gen_dir + "") >>> (err) {
        _ := os.remove_all(stage_dir + "")
        if !path_exists(gen_dir + "") {
            >>> err
        }
        << 0
    }
    << 0
}

fn install_generation(out_dir &string, cooked &[]CookedScene, records &[]ImportRecord, validator_hash &string) string {
    $digest := sha256.new()
    hdr := "nexus.generation.v1\nvalidator:" + validator_hash + "\n"
    digest.write(&hdr)
    for i in 0:cooked.len {
        cs := &cooked[i]
        s_line := "scene:" + cs.key + "\n"
        digest.write(&s_line)
        scene_hash := sha256.sum256(cs.encoded + "")
        h_line := scene_hash + "\n"
        digest.write(&h_line)
    }
    gen_hash := digest.sum()

    store_dir := filepath.join([out_dir + "", "store"])
    os.mkdir_all(store_dir + "") >>>
    $hash_to_store := map[string]string{}
    for i in 0:records.len {
        h := asset_filename(&records[i].source_hash, &records[i].kind)
        if !hash_to_store.has(h + "") {
            hash_to_store[h + ""] = ensure_store_asset(&store_dir, &records[i]) >>>
        }
    }

    gens_dir := filepath.join([out_dir + "", "generations"])
    os.mkdir_all(gens_dir + "") >>>
    gen_dir := filepath.join([gens_dir + "", gen_hash + ""])
    if !path_exists(gen_dir + "") {
        stage_dir := filepath.join([gens_dir + "", ".staging-" + gen_hash + "-" + str(os.getpid())])
        _ := os.remove_all(stage_dir + "")
        os.mkdir_all(stage_dir + "") >>>
        $needed_assets := map[string]int{}
        for i in 0:cooked.len {
            cs := &cooked[i]
            scene_dst := filepath.join([stage_dir + "", cs.key + ""])
            raw := cs.encoded + ""
            snapshot.write_atomic(scene_dst + "", &raw) >>> (err) {
                _ := os.remove_all(stage_dir + "")
                >>> err
            }
            _ := os.chmod(scene_dst + "", MODE_READ_ONLY)
            for k in 0:cs.assets.len {
                filename := cs.assets[k] + ""
                needed_assets[filename + ""] = 1
            }
        }
        assets_dir := filepath.join([stage_dir + "", "assets"])
        os.mkdir_all(assets_dir + "") >>>
        for i in 0:records.len {
            published_name := published_asset_filename(&records[i])
            if needed_assets.has(published_name + "") {
                dst := filepath.join([assets_dir + "", published_name])
                if !path_exists(dst + "") {
                    h := asset_filename(&records[i].source_hash, &records[i].kind)
                    store_src := hash_to_store[h + ""]
                    link_or_copy_readonly(&store_src, &dst) >>> (err) {
                        _ := os.remove_all(stage_dir + "")
                        >>> err
                    }
                }
            }
        }
        finish_stage_rename(&stage_dir, &gen_dir) >>>
    }
    << gen_hash
}

fn write_current_pointer(out_dir &string, gen_hash &string, scenes &[]Entry) int {
    $out := strings.new_byte_builder(512)
    out.write_str("{\n  \"format\": \"nexus.generation\",\n  \"version\": 1,\n  \"generation\": " +
        json.quote(gen_hash) + ",\n  \"scenes\": {")
    for i in 0:scenes.len {
        if i > 0 { out.write_str(",") }
        s := scenes[i]
        key := s.key + ""
        rel := s.path + ""
        out.write_str("\n    " + json.quote(&key) + ": " + json.quote(&rel))
    }
    if scenes.len > 0 { out.write_str("\n  ") }
    out.write_str("}\n}\n")
    raw := out.to_string()
    ptr := filepath.join([out_dir + "", "current.json"])
    snapshot.write_atomic(ptr, &raw) >>>
    << 0
}

pub fn publish_with_drafts(project_path string, output_dir string, validator_bin string, draft_key string, draft_doc &resource.Document, has_draft bool) PublishResult {
    project := load_project(project_path) >>>
    abs_out := filepath.abs(&output_dir) >>>
    os.mkdir_all(abs_out + "") >>>
    val_bin := resolve_validator_path(validator_bin + "") >>>
    val_hash := sha256_file(val_bin + "") >>>
    cache_dir := filepath.join([abs_out + "", "cache"])
    os.mkdir_all(cache_dir + "") >>>

    $records := []ImportRecord{}
    $session_cache := map[string]int{}
    $rebuilt := 0
    $reused := 0
    for i in 0:project.assets.len {
        entry := project.assets[i]
        $rec := import_source(&entry, &val_bin, &val_hash, &cache_dir) >>>
        filename := asset_filename(&rec.source_hash, &rec.kind)
        if session_cache.has(filename + "") {
            rec.cached = true
        }
        session_cache[filename + ""] = 1
        if rec.cached {
            reused = reused + 1
        } else {
            rebuilt = rebuilt + 1
        }
        records.push(rec)
    }

    $cooked := []CookedScene{}
    for i in 0:project.scenes.len {
        s := project.scenes[i]
        $raw := ""
        if has_draft && s.key == draft_key {
            raw = scene_fmt.encode(draft_doc) >>>
        } else {
            resolved := project.scene_source(i) >>>
            raw = snapshot.read(resolved + "", scene_fmt.MAX_BYTES) >>>
        }
        cooked.push(cook_scene_raw(&s.key, &raw, &records) >>>)
    }

    gen_hash := install_generation(&abs_out, &cooked, &records, &val_hash) >>>
    gen_dir := filepath.join([abs_out + "", "generations", gen_hash + ""])
    $pub_scenes := []Entry{}
    for s in project.scenes {
        rel := "generations/" + gen_hash + "/" + s.key
        resolved := filepath.join([gen_dir + "", s.key + ""])
        pub_scenes.push(Entry{key: s.key + "", path: rel, resolved: resolved})
    }
    write_current_pointer(&abs_out, &gen_hash, &pub_scenes) >>>
    << PublishResult{
        generation: gen_hash,
        root: gen_dir,
        rebuilt_assets: rebuilt,
        reused_assets: reused,
        scenes: pub_scenes
    }
}

pub fn publish(project_path string, output_dir string, validator_bin string) PublishResult {
    empty_doc := resource.make_document([resource.node(-1, "Empty", resource.NODE_3D)]) >>>
    << publish_with_drafts(project_path, output_dir, validator_bin, "", &empty_doc, false) >>>
}

pub fn published_scene(output_dir string, name string) string {
    abs_out := filepath.abs(&output_dir) >>>
    ptr := filepath.join([abs_out + "", "current.json"])
    raw := snapshot.read(ptr, snapshot.MAX_BYTES) >>>
    doc := json.parse_max(&raw, snapshot.MAX_BYTES)
    if !doc.ok() {
        >>> errors.new("nexus project: invalid current.json: " + doc.error())
    }
    root := doc.root()
    root_keys := dict_unique_keys(&doc, root, &"current.json") >>>
    if root_keys.len != 4 || !doc.has(root, "format") || !doc.has(root, "version") ||
        !doc.has(root, "generation") || !doc.has(root, "scenes") {
        >>> errors.new("nexus project: invalid current.json fields")
    }
    format := doc.as_string(doc.get(root, "format")) >>>
    if format != GENERATION_FORMAT {
        >>> errors.new("nexus project: invalid generation format '" + format + "'")
    }
    version := doc.as_int(doc.get(root, "version")) >>>
    if version != VERSION {
        >>> errors.new("nexus project: unsupported generation version " + str(version))
    }
    scenes_node := doc.get(root, "scenes")
    _ := dict_unique_keys(&doc, scenes_node, &"current.json scenes") >>>
    key := scene_name(&name) >>>
    if !doc.has(scenes_node, key + "") {
        >>> errors.new("nexus project: scene '" + key + "' not published in current generation")
    }
    rel_val := doc.as_string(doc.get(scenes_node, key + "")) >>>
    rel := relative_file(&rel_val) >>>
    resolved := resolve_project_path(&abs_out, &rel, true) >>>
    << resolved
}

fn try_asset_source(project &Project, uid &string) string {
    << project.asset_source(uid) >>> (err) {
        _ := err
        << ""
    }
}

fn try_resolve_existing(dir &string, rel &string) string {
    << resolve_project_path(dir, rel, true) >>> (err) {
        _ := err
        << ""
    }
}

pub fn stage_scene(project &Project, document &resource.Document, scene_path &string, directory &string) string {
    abs_dir := filepath.abs(directory) >>>
    os.mkdir_all(abs_dir + "") >>>
    assets_dir := filepath.join([abs_dir + "", "assets"])
    os.mkdir_all(assets_dir + "") >>>
    scene_base := filepath.base(scene_path)
    scene_dir := filepath.dir(scene_path)
    $next_refs := []resource.ResourceReference{}
    for i in 0:document.resource_count() {
        ref := document.resource(i) >>>
        if ref.kind == "glb_model" {
            src := project.asset_source(&ref.uid) >>>
            raw := snapshot.read(src + "", snapshot.MAX_BYTES) >>>
            hash := sha256.sum256(raw + "")
            rel := "assets/" + hash + ".glb"
            dst := filepath.join([assets_dir + "", hash + ".glb"])
            if !path_exists(dst + "") {
                snapshot.write_atomic(dst + "", &raw) >>>
            }
            next_refs.push(resource.ResourceReference{
                uid: ref.uid + "",
                kind: ref.kind + "",
                path: rel,
                content_hash: hash
            })
        } else {
            // Resolve non-GLB references via project manifest first, then scene/project dir.
            $src := try_asset_source(project, &ref.uid)
            if src.len == 0 {
                ref_rel := relative_file(&ref.path) >>>
                src = try_resolve_existing(&scene_dir, &ref_rel)
                if src.len == 0 {
                    src = resolve_project_path(&project.directory, &ref_rel, true) >>>
                }
            }
            raw := snapshot.read(src + "", snapshot.MAX_BYTES) >>>
            hash := sha256.sum256(raw + "")
            ext := filepath.ext(&src)
            rel := "assets/" + hash + ext
            dst := filepath.join([assets_dir + "", hash + ext])
            if !path_exists(dst + "") {
                snapshot.write_atomic(dst + "", &raw) >>>
            }
            next_refs.push(resource.ResourceReference{
                uid: ref.uid + "",
                kind: ref.kind + "",
                path: rel,
                content_hash: hash
            })
        }
    }
    staged_doc := copy_document_with_resources(document, next_refs) >>>
    encoded := scene_fmt.encode(&staged_doc) >>>
    staged_path := filepath.join([abs_dir + "", scene_base + ""])
    snapshot.write_atomic(staged_path + "", &encoded) >>>
    << staged_path
}

fn sanitize_asset_filename(name &string, expected_ext &string) string {
    base := filepath.base(name)
    $out := []int{}
    for i in 0:base.len {
        b := base[i] & 255
        if (b >= 48 && b <= 57) || (b >= 65 && b <= 90) || (b >= 97 && b <= 122) || b == 45 || b == 95 || b == 46 {
            out.push(b)
        } else {
            out.push(95)
        }
    }
    cleaned := string_from_bytes(out)
    ext := *expected_ext + ""
    if cleaned.len == 0 || cleaned == "." || cleaned == ".." {
        << "imported" + ext
    }
    lower := strings.to_lower(&cleaned)
    if !strings.ends_with(&lower, ext + "") {
        << cleaned + ext
    }
    << cleaned
}

fn try_sha256_file(path string) string {
    << sha256_file(path + "") >>> (err) {
        << ""
    }
}

fn try_rel_in_project(dir &string, abs_src &string) string {
    rel := filepath.rel(dir, abs_src) >>> (err) {
        << ""
    }
    slashed := filepath.to_slash(&rel)
    << try_project_rel(dir, &slashed, true)
}

pub fn import_external_asset(project_path string, external_path string, validator_bin string) ImportAssetResult {
    project := load_project(project_path + "") >>>
    abs_src := filepath.abs(&external_path) >>>
    info := os.stat(abs_src + "") >>>
    if info.is_dir {
        >>> errors.new("nexus project: selected asset is a directory")
    }
    suffix := strings.to_lower(&filepath.ext(&abs_src))
    $prim_count := 0
    if suffix == ".glb" {
        prims := validate_glb_primitives(validator_bin, abs_src + "") >>>
        prim_count = prims.len
    } else if suffix == ".png" || suffix == ".wav" || suffix == ".xubc" {
        bin := resolve_validator_path(validator_bin + "") >>>
        $mode := "png"
        $label := "PNG"
        if suffix == ".wav" {
            mode = "wav"
            label = "WAV"
        } else if suffix == ".xubc" {
            mode = "script"
            label = "Script"
        }
        _ := exec.command(bin + "", mode, abs_src + "").combined_output() >>> (err) {
            >>> errors.new("nexus project: " + label + " validation failed for " + external_path + ": " + err.msg())
        }
    } else {
        >>> errors.new("nexus project: unsupported asset extension (expected .glb, .png, .wav or .xubc): " + external_path)
    }

    raw := snapshot.read(abs_src + "", snapshot.MAX_BYTES) >>>
    src_hash := sha256.sum256(raw + "")

    $rel := try_rel_in_project(&project.directory, &abs_src)
    if rel.len == 0 {
        fname := sanitize_asset_filename(&abs_src, &suffix)
        $stem := fname + ""
        if fname.len > suffix.len {
            stem = fname[0 : fname.len - suffix.len] + ""
        }
        $cand_rel := "assets/" + fname
        $suffix_n := 2
        while suffix_n < 1000 {
            dest := resolve_project_path(&project.directory, &cand_rel, false) >>>
            if !path_exists(dest + "") {
                ensure_parent_dir(&dest) >>>
                snapshot.write_atomic(dest + "", &raw) >>>
                rel = cand_rel
                <-
            }
            if try_sha256_file(dest + "") == src_hash {
                rel = cand_rel
                <-
            }
            cand_rel = "assets/" + stem + "-" + str(suffix_n) + suffix
            suffix_n = suffix_n + 1
        }
        if rel.len == 0 {
            >>> errors.new("nexus project: unable to allocate unique destination for " + fname)
        }
    }

    existing_uid := project.find_asset_uid_by_rel(&rel)
    if existing_uid.len > 0 {
        resolved_existing := project.asset_source(&existing_uid) >>>
        << ImportAssetResult{
            uid: existing_uid,
            rel_path: rel,
            resolved: resolved_existing,
            reused: true,
            primitive_count: prim_count
        }
    }
    new_uid := register_asset(project_path + "", rel + "") >>>
    updated := load_project(project_path) >>>
    resolved_new := updated.asset_source(&new_uid) >>>
    << ImportAssetResult{
        uid: new_uid,
        rel_path: rel,
        resolved: resolved_new,
        reused: false,
        primitive_count: prim_count
    }
}

pub fn import_external_glb(project_path string, external_glb string, validator_bin string) ImportAssetResult {
    suffix := strings.to_lower(&filepath.ext(&external_glb))
    if suffix != ".glb" {
        >>> errors.new("nexus project: expected .glb asset: " + external_glb)
    }
    << import_external_asset(project_path, external_glb, validator_bin) >>>
}
