@"github.com/xulang-org/nexus/integration/gltf_render"

scene_render #"github.com/xulang-org/nexus/integration/rendering/three_d"
nexus #"github.com/xulang-org/nexus/scene"
ren #"github.com/xulang-org/nexus/rendering/three_d"
#errors

pub fn (model &GlbModel3D) primitive_count() int { << model.meshes.len }
fn (model &GlbModel3D) surface_material(primitive int) int {
    if model.closed || primitive < 0 || primitive >= model.meshes.len { >> errors.new("nexus GPU: closed GLB model or invalid primitive") }
    << model.primitive_materials[primitive]
}
pub fn (model &GlbModel3D) check_surface_binding(scene &scene_render.Scene3D, tree &nexus.SceneTree, node int, primitive int) int {
    material := model.surface_material(primitive) or >>
    << scene.check_surface_binding(tree, node, &model.meshes[primitive], &model.materials[material]) or >>
}
pub fn (model &GlbModel3D) attach_surface(scene $&scene_render.Scene3D, tree &nexus.SceneTree, node int, primitive int) int {
    material := model.surface_material(primitive) or >>
    << scene.attach_surface(tree, node, &model.meshes[primitive], model.materials[material]) or >>
}
pub fn (model &GlbModel3D) mesh_reference(primitive int) ren.MeshRef3D {
    model.surface_material(primitive) or >>
    << model.meshes[primitive].reference()
}
pub fn (model &GlbModel3D) primitive_material(primitive int) ren.Material3D {
    index := model.surface_material(primitive) or >>
    << model.materials[index]
}
