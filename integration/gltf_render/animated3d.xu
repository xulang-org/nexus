@"github.com/xulang-org/nexus/integration/gltf_render"

ren #"github.com/xulang-org/nexus/rendering/three_d"
scene_render #"github.com/xulang-org/nexus/integration/rendering/three_d"
assets #"github.com/xulang-org/nexus/assets/gltf"
gltf #"github.com/xulang-org/nexus/formats/gltf"
meshes #"github.com/xulang-org/nexus/resources/mesh"
fm #"github.com/xulang-org/nexus/foundation/math"
nexus #"github.com/xulang-org/nexus/scene"
#errors

// One player owns its posed meshes. Material/texture resources are shared
// within that player, while separate players retain independent poses.
pub struct GlbAnimated3D { model GlbModel3D
    posed []ren.Mesh3D
    closed bool }
pub fn upload_animated(device &ren.Device3D,asset &gltf.GlbGeometry) GlbAnimated3D {
    model := upload_material_model(device,asset) or >>
    << GlbAnimated3D{model: model,posed: []ren.Mesh3D{},closed: false}
}
pub fn posed_mesh_data(asset &gltf.GlbGeometry,primitive int,node int,worlds &[]fm.Mat4) meshes.MeshData3D {
    palette := asset.skin_palette(node,worlds) or >>
    $data := meshes.new_mesh_data_3d()
    for i in 0:(asset.vertex_count(primitive) or >>) {
        blend := asset.skin_matrix(primitive,i,&palette) or >>
        p := asset.position(primitive,i) or >>
        position := blend.transform(fm.vec4(p.x,p.y,p.z,1.0)).xyz()
        $normal := fm.vec3(0.0,0.0,0.0)
        if asset.has_normals(primitive) or >> {
            n := asset.normal(primitive,i) or >>
            inverse := blend.affine_inverse() or >>
            normal=inverse.transposed().transform(fm.vec4(n.x,n.y,n.z,0.0)).xyz().normalized() or >>
        }
        color := asset.color(primitive,i) or >>
        if asset.has_tangents(primitive) or >> {
            tangent := asset.tangent(primitive,i) or >>
            t := blend.transform(fm.vec4(tangent.x,tangent.y,tangent.z,0.0)).xyz()
            unit := t.sub(normal.scaled(t.dot(normal))).normalized() or >>
            sign := blend.determinant_sign() or >>
            data.vertex_tangent(position,color,normal,asset.uv(primitive,i) or >>,fm.vec4(unit.x,unit.y,unit.z,tangent.w*f64(sign))) or >>
        } else if asset.has_uvs(primitive) or >> { data.vertex_lit_uv(position,color,normal,asset.uv(primitive,i) or >>) or >>
        } else { data.vertex_lit(position,color,normal) or >> }
    }
    for i in 0:(asset.index_count(primitive) or >>)/3 {
        data.triangle(asset.index(primitive,i*3) or >>,asset.index(primitive,i*3+1) or >>,asset.index(primitive,i*3+2) or >>) or >>
    }
    data.validate() or >>
    << data
}
// Stages every skin before publishing the new pose/bindings. CPU validation
// and GPU allocation failures preserve the previously accepted frame resources.
// Skinning is currently CPU linear blend; rasterization and PBR run on the GPU.
pub fn (player $&GlbAnimated3D) sample(device &ren.Device3D,scene $&scene_render.Scene3D,tree $&nexus.SceneTree,
    asset &gltf.GlbGeometry,instance &assets.GlbInstance,clip int,time f64) int {
    if player.closed || player.model.source_hash!=asset.content_hash() || instance.content_hash()!=asset.content_hash() { >> errors.new("nexus GLB: closed player or mismatched pose source") }
    locals := asset.sample_pose(clip,time) or >>
    worlds := asset.world_pose(&locals) or >>
    $next := []ren.Mesh3D{}
    $slots := []int{}
    for i in 0:instance.primitive_count() {
        source := instance.primitive_source_node(i) or >>
        $slot := -1
        if (asset.node_skin(source) or >>)>=0 {
            data := posed_mesh_data(asset,instance.primitive_index(i) or >>,source,&worlds) or >>
            slot=next.len
            next.push(device.upload(&data) or >>)
        }
        slots.push(slot)
    }
    $added := 0
    for i in 0:instance.primitive_count() {
        node := instance.primitive_node(i) or >>
        p := instance.primitive_index(i) or >>
        mi := player.model.primitive_materials[p]
        slot := slots[i]
        if slot>=0 { added+=scene.check_surface_binding(tree,node,&next[slot],&player.model.materials[mi]) or >>
        } else { added+=scene.check_surface_binding(tree,node,&player.model.meshes[p],&player.model.materials[mi]) or >> }
    }
    if added>scene.remaining_bindings() { >> errors.new("nexus GLB: animated binding budget exceeded") }
    instance.apply_pose(tree,asset,&locals) or >>
    for i in 0:instance.primitive_count() {
        node := instance.primitive_node(i) or >>
        p := instance.primitive_index(i) or >>
        mi := player.model.primitive_materials[p]
        slot := slots[i]
        if slot>=0 { scene.attach_surface(tree,node,&next[slot],player.model.materials[mi]) or >>
        } else { scene.attach_surface(tree,node,&player.model.meshes[p],player.model.materials[mi]) or >> }
    }
    player.posed=next
    << instance.primitive_count()
}
pub fn (player $&GlbAnimated3D) close() int {
    if player.closed { << 0 }
    for i in 0:player.posed.len { mesh := $&player.posed[i]
        mesh.close() or >> }
    model := $&player.model
    model.close() or >>
    player.closed=true
    << 0
}
