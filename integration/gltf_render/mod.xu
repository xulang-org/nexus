@"github.com/xulang-org/nexus/integration/gltf_render"

meshes #"github.com/xulang-org/nexus/resources/mesh"
gltf #"github.com/xulang-org/nexus/formats/gltf"
ren #"github.com/xulang-org/nexus/rendering/three_d"
scene_render #"github.com/xulang-org/nexus/integration/rendering/three_d"
assets #"github.com/xulang-org/nexus/assets/gltf"
nexus #"github.com/xulang-org/nexus/scene"
#errors

// Owns one GPU mesh per source primitive; multiple scene instances share them.
pub struct GlbUnlit3D {
    source_hash string
    meshes []ren.Mesh3D
    closed bool
}
pub fn build_primitive_mesh(asset &gltf.GlbGeometry, primitive int, auto_mikktspace bool) meshes.MeshData3D {
    vertices := asset.vertex_count(primitive) >>>
    indices := asset.index_count(primitive) >>>
    $data := meshes.new_mesh_data_3d()
    normals := asset.has_normals(primitive) >>>
    uvs := asset.has_uvs(primitive) >>>
    tangents := asset.has_tangents(primitive) >>>
    for i in 0:vertices {
        position := asset.position(primitive, i) >>>
        color := asset.color(primitive, i) >>>
        if tangents {
            data.vertex_tangent(position, color, asset.normal(primitive, i) >>>, asset.uv(primitive, i) >>>, asset.tangent(primitive, i) >>>) >>>
        } else if normals && uvs {
            data.vertex_lit_uv(position, color, asset.normal(primitive, i) >>>, asset.uv(primitive, i) >>>) >>>
        } else if normals { data.vertex_lit(position, color, asset.normal(primitive, i) >>>) >>>
        } else if uvs { data.vertex_uv(position, color, asset.uv(primitive, i) >>>) >>>
        } else { data.vertex(position, color) >>> }
    }
    for i in 0:indices / 3 {
        a := asset.index(primitive, i * 3) >>>
        b := asset.index(primitive, i * 3 + 1) >>>
        c := asset.index(primitive, i * 3 + 2) >>>
        data.triangle(a, b, c) >>>
    }
    if auto_mikktspace && !tangents && normals && uvs {
        data.generate_mikktspace_tangents() >>>
    }
    << data
}

pub fn upload_primitive_with_mikktspace(device &ren.Device3D, asset &gltf.GlbGeometry, primitive int, auto_mikktspace bool) ren.Mesh3D {
    data := build_primitive_mesh(asset, primitive, auto_mikktspace) >>>
    << device.upload(&data) >>>
}

pub fn upload_primitive(device &ren.Device3D, asset &gltf.GlbGeometry, primitive int) ren.Mesh3D {
    << upload_primitive_with_mikktspace(device, asset, primitive, false) >>>
}
pub fn upload_unlit(device &ren.Device3D, asset &gltf.GlbGeometry) GlbUnlit3D {
    if asset.skin_count()>0 { >> errors.new("nexus GPU: skinned GLB requires upload_animated and explicit pose sampling") }
    if asset.primitive_count() < 1 { >> errors.new("nexus GPU: GLB has no drawable primitives") }
    $meshes := []ren.Mesh3D{}
    for i in 0:asset.primitive_count() { meshes.push(upload_primitive(device, asset, i) >>>) }
    << GlbUnlit3D{source_hash: asset.content_hash(), meshes: meshes, closed: false}
}
pub fn (model $&GlbUnlit3D) close() int {
    if model.closed { << 0 }
    if model.meshes.len == 0 { model.closed = true
        << 0 }
    first_mesh := $&model.meshes[0]
    first := first_mesh.close() >>>
    for i in 1:model.meshes.len { mesh := $&model.meshes[i]
        mesh.close() >>> }
    model.closed = true
    << first
}
// The array owns its Mesh3D elements, whose drop hooks release GPU storage.
pub fn (model &GlbUnlit3D) bind(scene $&scene_render.Scene3D, tree &nexus.SceneTree, instance &assets.GlbInstance) int {
    if model.closed || model.source_hash != instance.content_hash() {
        >> errors.new("nexus GPU: closed GLB model or mismatched source asset")
    }
    $added := 0
    for i in 0:instance.primitive_count() {
        node := instance.primitive_node(i) >>>
        primitive := instance.primitive_index(i) >>>
        if primitive < 0 || primitive >= model.meshes.len { >> errors.new("nexus GPU: GLB primitive outside uploaded model") }
        added = added + (scene.check_mesh_binding(tree, node, &model.meshes[primitive]) >>>)
    }
    if added > scene.remaining_bindings() { >> errors.new("nexus GPU: GLB binding budget exceeded") }
    for i in 0:instance.primitive_count() {
        node := instance.primitive_node(i) >>>
        primitive := instance.primitive_index(i) >>>
        scene.attach_mesh(tree, node, &model.meshes[primitive]) >>>
    }
    << instance.primitive_count()
}
