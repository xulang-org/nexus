@"github.com/xulang-org/game/integration/image_render/two_d"

images #"github.com/xulang-org/game/resources/image"
ren #"github.com/xulang-org/game/rendering/two_d"

// Image data is CPU-owned and reusable across devices. The result owns only its
// GPU allocation; releasing it does not affect the image or another upload.
pub fn upload_image_2d(renderer &ren.Renderer2D, image &images.ImageRGBA8, linear bool) ren.Texture2D {
    image.validate() or >>
    << renderer.texture_rgba(image.width, image.height, &image.pixels, linear) or >>
}

