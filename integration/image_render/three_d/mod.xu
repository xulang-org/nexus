@"github.com/xulang-org/nexus/integration/image_render/three_d"

images #"github.com/xulang-org/nexus/resources/image"
ren #"github.com/xulang-org/nexus/rendering/three_d"

// Color space is explicit: typical base-color PNG data uses srgb=true.
pub fn upload_image_3d(device &ren.Device3D, image &images.ImageRGBA8, srgb bool, linear bool, repeat bool) ren.Texture3D {
    image.validate() or >>
    << device.texture_rgba(image.width, image.height, &image.pixels, srgb, linear, repeat) or >>
}

// An explicit sampler controls mip generation, per-axis addressing and texel filters.
pub fn upload_image_3d_sampled(device &ren.Device3D, image &images.ImageRGBA8, srgb bool,
    sampling ren.TextureSampling3D) ren.Texture3D {
    image.validate() or >>
    << device.texture_rgba_sampled(image.width, image.height, &image.pixels, srgb, sampling) or >>
}
