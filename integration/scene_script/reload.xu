@"github.com/xulang-org/nexus/integration/scene_script"

resource #"github.com/xulang-org/nexus/resources/scene"
nexus #"github.com/xulang-org/nexus/scene"
bc #"github.com/xulang-org/nexus/script/bytecode"
snapshot #"github.com/xulang-org/nexus/internal/file_snapshot"
#crypto/sha256
#path/filepath
#errors

fn contract(document &resource.Document, uid &string, program &bc.Module) int {
    $nodes := map[int]bool{}
    for i in 0:document.script_count() {
        attachment := document.script(i) >>>
        if attachment.resource_uid != *uid { -> }
        nodes[attachment.node] = true
        for field in attachment.initial {
            if program.field_index(field.id) < 0 { >>> errors.new("nexus scene script: reload removes an authored initial field") }
        }
    }
    for i in 0:document.script_connection_count() {
        route := document.script_connection(i) >>>
        if (nodes.has(route.source) && program.signal_index(route.signal) < 0) || (nodes.has(route.target) && program.handler_index(route.handler) < 0) {
            >>> errors.new("nexus scene script: reload removes an authored signal/handler ID")
        }
    }
    << 0
}
fn reload(binding $&Bindings, tree &nexus.SceneTree, ids &[]int, raw &string) int {
    manager := $&binding.manager
    << manager.reload_many(tree, ids, raw) >>>
}
// Explicit activation of an independently prepared local artifact. Immutable
// generation paths can change without overwriting an accepted source revision.
pub fn (set $&ScriptScene) reload_from(tree &nexus.SceneTree, uid string, relative_path string) int {
    set.bound_index(0) >>>
    resource_index := set.resource_index(&uid) >>>
    source := filepath.join([set.base_directory + "", relative_path + ""])
    // Validate the portable path before opening it, using the resource schema.
    old := set.document.resource(resource_index) >>>
    $references := []resource.ResourceReference{}
    for i in 0:set.document.resource_count() {
        reference := set.document.resource(i) >>>
        if i == resource_index { references.push(resource.ResourceReference{uid: uid + "", kind: "xu_bytecode", path: relative_path + "", content_hash: old.content_hash + ""})
        } else { references.push(resource.ResourceReference{uid: reference.uid + "", kind: reference.kind + "", path: reference.path + "", content_hash: reference.content_hash + ""}) }
    }
    path_checked := resource.with_references(&set.document, &set.document, references) >>>
    raw := snapshot.read(source, bc.MAX_BYTES) >>>
    program := bc.decode(&raw) >>>
    contract(&set.document, &uid, &program) >>>
    hash := sha256.sum256(raw + "")
    $next_references := []resource.ResourceReference{}
    for i in 0:path_checked.resource_count() {
        reference := path_checked.resource(i) >>>
        if i == resource_index { next_references.push(resource.ResourceReference{uid: uid + "", kind: "xu_bytecode", path: relative_path + "", content_hash: hash + ""})
        } else { next_references.push(resource.ResourceReference{uid: reference.uid + "", kind: reference.kind + "", path: reference.path + "", content_hash: reference.content_hash + ""}) }
    }
    next_document := resource.with_references(&set.document, &set.document, next_references) >>>
    $bytes := map[string]string{}
    for i in 0:next_document.resource_count() {
        reference := next_document.resource(i) >>>
        if reference.kind != "xu_bytecode" { -> }
        key := reference.content_hash + ""
        if key == hash { bytes[key] = raw + ""
        } else { bytes[key] = set.bytes[reference.content_hash + ""] + "" }
    }
    $ids := []int{}
    for i in 0:set.document.script_count() {
        attachment := set.document.script(i) >>>
        if attachment.resource_uid == uid { ids.push(set.binding.ids[i]) }
    }
    changed := reload($&set.binding, tree, &ids, &raw) >>>
    set.document = next_document
    set.bytes = bytes
    << changed
}
