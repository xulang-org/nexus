@"github.com/xulang-org/nexus/integration/scene_tilemap2d"

images #"github.com/xulang-org/nexus/assets/image"
image_render #"github.com/xulang-org/nexus/integration/image_render/two_d"
node_files #"github.com/xulang-org/nexus/integration/scene"
scene2d #"github.com/xulang-org/nexus/integration/rendering/two_d"
snapshot #"github.com/xulang-org/nexus/internal/file_snapshot"
ren #"github.com/xulang-org/nexus/rendering/two_d"
resource #"github.com/xulang-org/nexus/resources/scene"
nexus #"github.com/xulang-org/nexus/scene"
#crypto/sha256
#errors
#path/filepath

const MAX_SOURCE_BYTES = 33554432

fn read_image_source(reference &resource.ResourceReference, directory string, consumed int) string {
    path := filepath.join([directory, reference.path + ""])
    $limit := images.MAX_IMAGE_BYTES
    if MAX_SOURCE_BYTES - consumed < limit { limit = MAX_SOURCE_BYTES - consumed }
    if limit < 1 { >> errors.new("nexus scene tilemap2d: image source budget exceeds 32 MiB") }
    raw := snapshot.read(path, limit) or >>
    if sha256.sum256(raw + "") != reference.content_hash {
        >> errors.new("nexus scene tilemap2d: image content hash mismatch: " + reference.path)
    }
    << raw
}

// Owns deduplicated 2D tileset Texture2D uploads for TileMap2D scene attachments.
pub struct SceneTileMaps2D {
    document resource.Document
    packed nexus.PackedScene
    textures []ren.Texture2D
    layer_textures []int
    closed bool
    base_directory string
}

pub fn prepare(renderer &ren.Renderer2D, document resource.Document, base_directory string) SceneTileMaps2D {
    if document.surface_count() > 0 || document.audio_count() > 0 || document.script_count() > 0 ||
        document.light_count() > 0 || document.sprite_3d_count() > 0 {
        >> errors.new("nexus scene tilemap2d: other attachments require explicit prepare_tilemaps and service binding")
    }
    << prepare_tilemaps(renderer, document, base_directory) or >>
}

pub fn prepare_tilemaps(renderer &ren.Renderer2D, document resource.Document, base_directory string) SceneTileMaps2D {
    renderer.backend() or >>
    directory := filepath.abs(&base_directory) or >>
    packed := node_files.to_packed_nodes(&document) or >>
    $refs_by_uid := map[string]int{}
    for i in 0:document.resource_count() {
        ref := document.resource(i) or >>
        if ref.kind == "image_rgba" { refs_by_uid[ref.uid + ""] = i }
    }
    $verified_refs := map[int]bool{}
    $source_by_hash := map[string]string{}
    $source_bytes := 0
    $textures := []ren.Texture2D{}
    $by_key := map[string]int{}
    $layer_textures := []int{}
    for i in 0:document.tilemap_2d_count() {
        item := document.tilemap_2d(i) or >>
        uid := item.resource_uid + ""
        if !refs_by_uid.has(uid + "") { >> errors.new("nexus scene tilemap2d: missing image_rgba resource") }
        ref_index := refs_by_uid[uid]
        ref := document.resource(ref_index) or >>
        hash := ref.content_hash + ""
        // Verify every referenced path even when another path has the same digest.
        if !verified_refs.has(ref_index) {
            raw := read_image_source(&ref, directory + "", source_bytes) or >>
            source_bytes += raw.len
            if !source_by_hash.has(hash + "") { source_by_hash[hash + ""] = raw }
            verified_refs[ref_index] = true
        }
        $filter_tag := "linear"
        if item.pixel_art { filter_tag = "nearest" }
        key := hash + ":" + filter_tag
        if !by_key.has(key + "") {
            bytes := source_by_hash[hash + ""] + ""
            img := images.decode_png(&bytes) or >>
            tex := image_render.upload_image_2d(renderer, &img, !item.pixel_art) or >>
            by_key[key + ""] = textures.len
            textures.push(tex)
        }
        layer_textures.push(by_key[key + ""])
    }
    << SceneTileMaps2D{
        document: document,
        packed: packed,
        textures: textures,
        layer_textures: layer_textures,
        closed: false,
        base_directory: directory
    }
}

pub fn load(renderer &ren.Renderer2D, path string) SceneTileMaps2D {
    document := node_files.load(path + "") or >>
    directory := filepath.dir(&path)
    << prepare(renderer, document, directory) or >>
}

pub fn load_tilemaps(renderer &ren.Renderer2D, path string) SceneTileMaps2D {
    document := node_files.load(path + "") or >>
    directory := filepath.dir(&path)
    << prepare_tilemaps(renderer, document, directory) or >>
}

pub fn (set &SceneTileMaps2D) document() &resource.Document { << &set.document }
pub fn (set &SceneTileMaps2D) layer_count() int { << set.document.tilemap_2d_count() }
pub fn (set &SceneTileMaps2D) texture_count() int { << set.textures.len }

pub fn (set &SceneTileMaps2D) texture_slot(layer_index int) int {
    if set.closed { >> errors.new("nexus scene tilemap2d: closed tilemap set") }
    if layer_index < 0 || layer_index >= set.layer_textures.len {
        >> errors.new("nexus scene tilemap2d: layer index outside document")
    }
    << set.layer_textures[layer_index]
}

pub fn (set &SceneTileMaps2D) texture(slot int) &ren.Texture2D {
    if set.closed { >> errors.new("nexus scene tilemap2d: closed tilemap set") }
    if slot < 0 || slot >= set.textures.len {
        >> errors.new("nexus scene tilemap2d: texture slot outside set")
    }
    << &set.textures[slot]
}

pub fn (set &SceneTileMaps2D) bind(tree &nexus.SceneTree, root int) []scene2d.TileMapLayer2D {
    if set.closed { >> errors.new("nexus scene tilemap2d: closed tilemap set") }
    ids := node_files.matching_nodes(&set.document, tree, root) or >>
    $layers := []scene2d.TileMapLayer2D{}
    for i in 0:set.document.tilemap_2d_count() {
        item := set.document.tilemap_2d(i) or >>
        grid := item.grid.clone() or >>
        layer := scene2d.new_tilemap_layer_2d(ids[item.node], grid, item.z_index, item.y_sort_cells, item.y_offset) or >>
        layers.push(layer)
    }
    << layers
}

pub fn (set &SceneTileMaps2D) instantiate(tree $&nexus.SceneTree, parent int, name string) int {
    if set.closed { >> errors.new("nexus scene tilemap2d: closed tilemap set") }
    << set.packed.instantiate(tree, parent, name) or >>
}

// Capture live Node2D transforms and TileMapLayer2D cell/elevation/tint edits.
pub fn (set &SceneTileMaps2D) capture(layers &[]scene2d.TileMapLayer2D, tree &nexus.SceneTree, root int) resource.Document {
    if set.closed { >> errors.new("nexus scene tilemap2d: closed tilemap set") }
    ids := node_files.matching_nodes(&set.document, tree, root) or >>
    if layers.len != set.document.tilemap_2d_count() {
        >> errors.new("nexus scene tilemap2d: layer count differs from document")
    }
    nodes := node_files.capture_nodes(tree, root) or >>
    $references := []resource.ResourceReference{}
    for i in 0:set.document.resource_count() { references.push(set.document.resource(i) or >>) }
    preserved := resource.with_references(&set.document, &nodes, references) or >>
    $next_maps := []resource.TileMap2DAttachment{}
    for i in 0:set.document.tilemap_2d_count() {
        saved := set.document.tilemap_2d(i) or >>
        live := &layers[i]
        if live.node != ids[saved.node] {
            >> errors.new("nexus scene tilemap2d: layer node binding differs from document")
        }
        next_maps.push(resource.tilemap_2d_attachment(saved.node, saved.resource_uid + "",
            live.z_index, live.y_sort_cells, live.y_offset, saved.pixel_art, live.grid.clone() or >>))
    }
    $refs_copy := []resource.ResourceReference{}
    for i in 0:preserved.resource_count() { refs_copy.push(preserved.resource(i) or >>) }
    << resource.with_tilemaps_2d(&preserved, refs_copy, next_maps) or >>
}

pub fn (set &SceneTileMaps2D) save(path string, layers &[]scene2d.TileMapLayer2D, tree &nexus.SceneTree, root int) int {
    if set.document.script_count() > 0 {
        >> errors.new("nexus scene tilemap2d: save script revisions through the script restoration owner")
    }
    captured := set.capture(layers, tree, root) or >>
    << node_files.save_rebased(path, &captured, set.base_directory + "") or >>
}

fn close_tileset_texture(tex $&ren.Texture2D) string {
    tex.close() or (err) { << err.msg() }
    << ""
}

pub fn (set $&SceneTileMaps2D) close() int {
    if set.closed { << 0 }
    $first := ""
    for i in 0:set.textures.len {
        tex := $&set.textures[i]
        msg := close_tileset_texture(tex)
        if first.len == 0 && msg.len > 0 { first = msg }
    }
    set.textures = []ren.Texture2D{}
    set.layer_textures = []int{}
    set.closed = true
    if first.len > 0 { >> errors.new(first) }
    << 0
}

fn (set $&SceneTileMaps2D) drop() { set.close() or (err) { << } }
