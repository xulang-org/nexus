@"github.com/xulang-org/nexus/integration/scene_sprites3d"

images #"github.com/xulang-org/nexus/assets/image"
image_render #"github.com/xulang-org/nexus/integration/image_render/three_d"
node_files #"github.com/xulang-org/nexus/integration/scene"
scene_render #"github.com/xulang-org/nexus/integration/rendering/three_d"
snapshot #"github.com/xulang-org/nexus/internal/file_snapshot"
ren #"github.com/xulang-org/nexus/rendering/three_d"
resource #"github.com/xulang-org/nexus/resources/scene"
nexus #"github.com/xulang-org/nexus/scene"
#crypto/sha256
#errors
#path/filepath

const MAX_SOURCE_BYTES = 33554432

fn read_image_source(reference &resource.ResourceReference, directory string, consumed int) string {
    path := filepath.join([directory, reference.path + ""])
    $limit := images.MAX_IMAGE_BYTES
    if MAX_SOURCE_BYTES - consumed < limit { limit = MAX_SOURCE_BYTES - consumed }
    if limit < 1 { >> errors.new("nexus scene sprites3d: image source budget exceeds 32 MiB") }
    raw := snapshot.read(path, limit) >>>
    if sha256.sum256(raw + "") != reference.content_hash {
        >> errors.new("nexus scene sprites3d: image content hash mismatch: " + reference.path)
    }
    << raw
}

// Owns Texture3D allocations loaded from image_rgba scene resources; sprite
// bindings in SceneSprites3D hold weak references to these textures.
pub struct SceneSpriteSet3D {
    document resource.Document
    packed nexus.PackedScene
    textures []ren.Texture3D
    sprite_textures []int
    closed bool
    base_directory string
}

pub fn prepare(device &ren.Device3D, document resource.Document, base_directory string) SceneSpriteSet3D {
    if document.surface_count() > 0 || document.audio_count() > 0 || document.script_count() > 0 ||
        document.light_count() > 0 || document.tilemap_2d_count() > 0 {
        >> errors.new("nexus scene sprites3d: other attachments require explicit prepare_sprites and service binding")
    }
    << prepare_sprites(device, document, base_directory) >>>
}

// Explicit partial restoration for scenes composing lights, meshes, audio, scripts, and 3D sprites.
pub fn prepare_sprites(device &ren.Device3D, document resource.Document, base_directory string) SceneSpriteSet3D {
    device.backend() >>>
    directory := filepath.abs(&base_directory) >>>
    packed := node_files.to_packed_nodes(&document) >>>
    $refs_by_uid := map[string]int{}
    for i in 0:document.resource_count() {
        ref := document.resource(i) >>>
        if ref.kind == "image_rgba" { refs_by_uid[ref.uid + ""] = i }
    }
    $verified_refs := map[int]bool{}
    $source_by_hash := map[string]string{}
    $source_bytes := 0
    $textures := []ren.Texture3D{}
    $by_key := map[string]int{}
    $sprite_textures := []int{}
    for i in 0:document.sprite_3d_count() {
        item := document.sprite_3d(i) >>>
        uid := item.resource_uid + ""
        if !refs_by_uid.has(uid + "") { >> errors.new("nexus scene sprites3d: missing image_rgba resource") }
        ref_index := refs_by_uid[uid]
        ref := document.resource(ref_index) >>>
        hash := ref.content_hash + ""
        // Verify every referenced path even when another path has the same digest.
        if !verified_refs.has(ref_index) {
            raw := read_image_source(&ref, directory + "", source_bytes) >>>
            source_bytes += raw.len
            if !source_by_hash.has(hash + "") { source_by_hash[hash + ""] = raw }
            verified_refs[ref_index] = true
        }
        $filter_tag := "linear"
        if item.sprite.pixel_art { filter_tag = "nearest" }
        key := hash + ":" + filter_tag
        if !by_key.has(key + "") {
            bytes := source_by_hash[hash + ""] + ""
            img := images.decode_png(&bytes) >>>
            tex := image_render.upload_image_3d(device, &img, true, !item.sprite.pixel_art, false) >>>
            by_key[key + ""] = textures.len
            textures.push(tex)
        }
        sprite_textures.push(by_key[key + ""])
    }
    << SceneSpriteSet3D{
        document: document,
        packed: packed,
        textures: textures,
        sprite_textures: sprite_textures,
        closed: false,
        base_directory: directory
    }
}

pub fn load(device &ren.Device3D, path string) SceneSpriteSet3D {
    document := node_files.load(path + "") >>>
    directory := filepath.dir(&path)
    << prepare(device, document, directory) >>>
}

pub fn load_sprites(device &ren.Device3D, path string) SceneSpriteSet3D {
    document := node_files.load(path + "") >>>
    directory := filepath.dir(&path)
    << prepare_sprites(device, document, directory) >>>
}

pub fn (set &SceneSpriteSet3D) document() &resource.Document { << &set.document }
pub fn (set &SceneSpriteSet3D) texture_count() int { << set.textures.len }
pub fn (set &SceneSpriteSet3D) sprite_count() int { << set.document.sprite_3d_count() }

pub fn (set &SceneSpriteSet3D) close_check() int {
    if set.closed { >> errors.new("nexus scene sprites3d: closed sprite set") }
    << 0
}

pub fn (set &SceneSpriteSet3D) bind(sprites $&scene_render.SceneSprites3D, tree &nexus.SceneTree, root int) int {
    set.close_check() >>>
    ids := node_files.matching_nodes(&set.document, tree, root) >>>
    $added := 0
    for i in 0:set.document.sprite_3d_count() {
        item := set.document.sprite_3d(i) >>>
        node := ids[item.node]
        tex_slot := set.sprite_textures[i]
        tex := &set.textures[tex_slot]
        base := ren.material_3d(item.sprite.tint, 0.0, 0.9, item.sprite.tint.scaled(0.0)) >>>
        mat := base.with_base_texture(tex) >>>
        added += sprites.check_binding(tree, node, &item.sprite, &mat) >>>
    }
    if added > sprites.remaining_bindings() {
        >> errors.new("nexus scene sprites3d: sprite binding capacity exceeded")
    }
    for i in 0:set.document.sprite_3d_count() {
        item := set.document.sprite_3d(i) >>>
        node := ids[item.node]
        tex_slot := set.sprite_textures[i]
        tex := &set.textures[tex_slot]
        sprites.attach(tree, node, item.sprite, tex) >>>
    }
    << set.document.sprite_3d_count()
}

pub fn (set &SceneSpriteSet3D) instantiate(sprites $&scene_render.SceneSprites3D, tree $&nexus.SceneTree, parent int, name string) int {
    set.close_check() >>>
    if set.document.sprite_3d_count() > sprites.remaining_bindings() {
        >> errors.new("nexus scene sprites3d: insufficient sprite binding capacity")
    }
    $staging := nexus.new_scene_tree("Staging", set.document.node_count() + 1) >>>
    container := staging.root()
    candidate := set.packed.instantiate($&staging, container, "Candidate") >>>
    ids := node_files.matching_nodes(&set.document, &staging, candidate) >>>
    for i in 0:set.document.sprite_3d_count() {
        item := set.document.sprite_3d(i) >>>
        tex_slot := set.sprite_textures[i]
        tex := &set.textures[tex_slot]
        base := ren.material_3d(item.sprite.tint, 0.0, 0.9, item.sprite.tint.scaled(0.0)) >>>
        mat := base.with_base_texture(tex) >>>
        sprites.check_binding(&staging, ids[item.node], &item.sprite, &mat) >>>
    }
    root := set.packed.instantiate(tree, parent, name) >>>
    set.bind(sprites, tree, root) >>>
    << root
}

// Capture live node transforms and Sprite3D spec edits while preserving resource UIDs and other attachments.
pub fn (set &SceneSpriteSet3D) capture(sprites &scene_render.SceneSprites3D, tree &nexus.SceneTree, root int) resource.Document {
    set.close_check() >>>
    ids := node_files.matching_nodes(&set.document, tree, root) >>>
    nodes := node_files.capture_nodes(tree, root) >>>
    $references := []resource.ResourceReference{}
    for i in 0:set.document.resource_count() { references.push(set.document.resource(i) >>>) }
    preserved := resource.with_references(&set.document, &nodes, references) >>>
    $next_sprites := []resource.Sprite3DAttachment{}
    for i in 0:set.document.sprite_3d_count() {
        saved := set.document.sprite_3d(i) >>>
        node_id := ids[saved.node]
        $spec := saved.sprite
        if sprites.has_sprite(node_id) { spec = sprites.spec(node_id) >>> }
        next_sprites.push(resource.sprite_3d_attachment(saved.node, saved.resource_uid + "", spec))
    }
    $refs_copy := []resource.ResourceReference{}
    for i in 0:preserved.resource_count() { refs_copy.push(preserved.resource(i) >>>) }
    << resource.with_sprites_3d(&preserved, refs_copy, next_sprites) >>>
}

pub fn (set &SceneSpriteSet3D) save(path string, sprites &scene_render.SceneSprites3D, tree &nexus.SceneTree, root int) int {
    if set.document.script_count() > 0 {
        >> errors.new("nexus scene sprites3d: save script revisions through the script restoration owner")
    }
    captured := set.capture(sprites, tree, root) >>>
    << node_files.save_rebased(path, &captured, set.base_directory + "") >>>
}

fn close_sprite_texture(tex $&ren.Texture3D) string {
    tex.close() >>> (err) { << err.msg() }
    << ""
}

pub fn (set $&SceneSpriteSet3D) close() int {
    if set.closed { << 0 }
    $first := ""
    for i in 0:set.textures.len {
        tex := $&set.textures[i]
        msg := close_sprite_texture(tex)
        if first.len == 0 && msg.len > 0 { first = msg }
    }
    set.textures = []ren.Texture3D{}
    set.sprite_textures = []int{}
    set.closed = true
    if first.len > 0 { >> errors.new(first) }
    << 0
}

fn (set $&SceneSpriteSet3D) drop() { set.close() >>> (err) { << } }
