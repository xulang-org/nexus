@"github.com/xulang-org/nexus/integration/streaming"

asset_gltf #"github.com/xulang-org/nexus/assets/gltf"
asset_img #"github.com/xulang-org/nexus/assets/image"
asset_mesh #"github.com/xulang-org/nexus/assets/mesh"
fm #"github.com/xulang-org/nexus/foundation/math"
ren #"github.com/xulang-org/nexus/rendering/three_d"
meshes #"github.com/xulang-org/nexus/resources/mesh"
images #"github.com/xulang-org/nexus/resources/image"
#errors
#math

pub const STREAM_KIND_MESH = 1
pub const STREAM_KIND_GLB_MESH = 2
pub const STREAM_KIND_TEXTURE = 3

pub const STREAM_STATE_PENDING = 0
pub const STREAM_STATE_READY_CPU = 1
pub const STREAM_STATE_RESIDENT = 2
pub const STREAM_STATE_EVICTED = 3
pub const STREAM_STATE_FAILED = 4

pub struct StreamConfig {
    pub workers int
    pub max_uploads_per_frame int
    pub max_bytes_per_frame int
    pub max_resident_bytes int
}

pub fn default_stream_config() StreamConfig {
    << StreamConfig{
        workers: 2,
        max_uploads_per_frame: 4,
        max_bytes_per_frame: 2097152,
        max_resident_bytes: 33554432
    }
}

pub struct StreamPumpStats {
    pub decoded_this_frame int
    pub uploaded_this_frame int
    pub bytes_uploaded_this_frame int
    pub evicted_this_frame int
    pub failed_this_frame int
    pub resident_bytes int
    pub pending_decode int
    pub ready_queue int
}

struct StreamJob {
    handle int
    kind int
    path string
    srgb bool
    sampling ren.TextureSampling3D
}

struct DecodedMeshMsg {
    handle int
    ok bool
    err string
    byte_size int
    data meshes.MeshData3D
}

struct DecodedTextureMsg {
    handle int
    ok bool
    err string
    byte_size int
    srgb bool
    sampling ren.TextureSampling3D
    imgs []images.ImageRGBA8
}

struct StreamEntry {
    handle int
    kind int
    path string
    priority f64
    pinned bool
    srgb bool
    sampling ren.TextureSampling3D
    state int
    err string
    byte_size int
    last_used_frame int
    gpu_slot int
    mesh_box chan DecodedMeshMsg
    tex_box chan DecodedTextureMsg
}

pub struct StreamingManager3D {
    owner ren.DeviceRef3D
    config StreamConfig
    jobs chan StreamJob
    mesh_done chan DecodedMeshMsg
    tex_done chan DecodedTextureMsg
    stop chan int
    worker_done chan int
    entries []StreamEntry
    ready_handles []int
    resident_meshes []ren.Mesh3D
    resident_textures []ren.Texture3D
    mesh_alive []bool
    tex_alive []bool
    resident_bytes int
    closed bool
}

fn glb_primitive0_mesh(path string) meshes.MeshData3D {
    asset := asset_gltf.load_glb_geometry(path + "") or >>
    if asset.primitive_count() < 1 { >> errors.new("nexus streaming: GLB contains no primitives") }
    verts := asset.vertex_count(0) or >>
    inds := asset.index_count(0) or >>
    $out := meshes.new_mesh_data_3d()
    hn := asset.has_normals(0) or >>
    hu := asset.has_uvs(0) or >>
    ht := asset.has_tangents(0) or >>
    for i in 0:verts {
        p := asset.position(0, i) or >>
        c := asset.color(0, i) or >>
        if ht {
            out.vertex_tangent(p, c, asset.normal(0, i) or >>, asset.uv(0, i) or >>, asset.tangent(0, i) or >>) or >>
        } else if hn && hu {
            out.vertex_lit_uv(p, c, asset.normal(0, i) or >>, asset.uv(0, i) or >>) or >>
        } else if hn {
            out.vertex_lit(p, c, asset.normal(0, i) or >>) or >>
        } else if hu {
            out.vertex_uv(p, c, asset.uv(0, i) or >>) or >>
        } else {
            out.vertex(p, c) or >>
        }
    }
    for i in 0:(inds / 3) {
        out.triangle(asset.index(0, i * 3) or >>, asset.index(0, i * 3 + 1) or >>, asset.index(0, i * 3 + 2) or >>) or >>
    }
    out.validate() or >>
    << out
}

fn decode_mesh_job(job &StreamJob) DecodedMeshMsg {
    $data := meshes.new_mesh_data_3d()
    if job.kind == STREAM_KIND_MESH {
        loaded := asset_mesh.load(job.path + "") or(err){
            << DecodedMeshMsg{handle: job.handle, ok: false, err: err.msg(), byte_size: 0, data: meshes.new_mesh_data_3d()}
        }
        data = loaded
    } else {
        loaded := glb_primitive0_mesh(job.path + "") or(err){
            << DecodedMeshMsg{handle: job.handle, ok: false, err: err.msg(), byte_size: 0, data: meshes.new_mesh_data_3d()}
        }
        data = loaded
    }
    bytes := data.vertices.len * 64 + data.indices.len * 4
    << DecodedMeshMsg{handle: job.handle, ok: true, err: "", byte_size: bytes, data: data}
}

fn decode_tex_job(job &StreamJob) DecodedTextureMsg {
    loaded := asset_img.load_png(job.path + "") or(err){
        << DecodedTextureMsg{
            handle: job.handle, ok: false, err: err.msg(), byte_size: 0,
            srgb: job.srgb, sampling: job.sampling, imgs: []images.ImageRGBA8{}
        }
    }
    bytes := loaded.width * loaded.height * 4
    << DecodedTextureMsg{
        handle: job.handle, ok: true, err: "", byte_size: bytes,
        srgb: job.srgb, sampling: job.sampling, imgs: [loaded]
    }
}

fn stream_worker(
    jobs chan StreamJob,
    mesh_done chan DecodedMeshMsg,
    tex_done chan DecodedTextureMsg,
    stop chan int,
    done chan int
) {
    $running := true
    while running {
        select {
            _ := <-stop {
                running = false
            }
            job := <-jobs {
                if job.kind == STREAM_KIND_TEXTURE {
                    res := decode_tex_job(&job)
                    tex_done <- res
                } else {
                    res := decode_mesh_job(&job)
                    mesh_done <- res
                }
            }
        }
    }
    done <- 1
}

pub fn new_streaming_manager(device &ren.Device3D, cfg StreamConfig) StreamingManager3D {
    device.alive() or >>
    if cfg.workers < 1 || cfg.workers > 8 || cfg.max_uploads_per_frame < 1 ||
        cfg.max_bytes_per_frame < 64 || cfg.max_resident_bytes < cfg.max_bytes_per_frame {
        >> errors.new("nexus streaming: invalid worker count or streaming memory budget")
    }
    jobs := chan StreamJob{cap: 256}
    mesh_done := chan DecodedMeshMsg{cap: 256}
    tex_done := chan DecodedTextureMsg{cap: 256}
    stop := chan int{cap: 16}
    worker_done := chan int{cap: 16}

    for _ in 0:cfg.workers {
        xu stream_worker(jobs, mesh_done, tex_done, stop, worker_done)
    }

    << StreamingManager3D{
        owner: device.reference(),
        config: cfg,
        jobs: jobs,
        mesh_done: mesh_done,
        tex_done: tex_done,
        stop: stop,
        worker_done: worker_done,
        entries: []StreamEntry{},
        ready_handles: []int{},
        resident_meshes: []ren.Mesh3D{},
        resident_textures: []ren.Texture3D{},
        mesh_alive: []bool{},
        tex_alive: []bool{},
        resident_bytes: 0,
        closed: false
    }
}

pub fn (mgr $&StreamingManager3D) request_mesh(path string, kind int, priority f64, pinned bool) int {
    if mgr.closed { >> errors.new("nexus streaming: manager is closed") }
    if kind != STREAM_KIND_MESH && kind != STREAM_KIND_GLB_MESH {
        >> errors.new("nexus streaming: expected STREAM_KIND_MESH or STREAM_KIND_GLB_MESH")
    }
    if !fm.finite(priority) || path.len == 0 {
        >> errors.new("nexus streaming: invalid mesh path or priority")
    }
    h := mgr.entries.len
    default_samp := ren.TextureSampling3D{min_linear: false, mag_linear: false, repeat_u: false, repeat_v: false, mip_filter: 0}
    mgr.entries.push(StreamEntry{
        handle: h, kind: kind, path: path + "", priority: priority, pinned: pinned,
        srgb: false, sampling: default_samp, state: STREAM_STATE_PENDING, err: "",
        byte_size: 0, last_used_frame: 0, gpu_slot: -1,
        mesh_box: chan DecodedMeshMsg{cap: 1}, tex_box: chan DecodedTextureMsg{cap: 1}
    })
    mgr.jobs <- StreamJob{handle: h, kind: kind, path: path + "", srgb: false, sampling: default_samp}
    << h
}

pub fn (mgr $&StreamingManager3D) request_texture(
    path string, srgb bool, sampling ren.TextureSampling3D, priority f64, pinned bool
) int {
    if mgr.closed { >> errors.new("nexus streaming: manager is closed") }
    if !fm.finite(priority) || path.len == 0 {
        >> errors.new("nexus streaming: invalid texture path or priority")
    }
    sampling.validate() or >>
    h := mgr.entries.len
    mgr.entries.push(StreamEntry{
        handle: h, kind: STREAM_KIND_TEXTURE, path: path + "", priority: priority, pinned: pinned,
        srgb: srgb, sampling: sampling, state: STREAM_STATE_PENDING, err: "",
        byte_size: 0, last_used_frame: 0, gpu_slot: -1,
        mesh_box: chan DecodedMeshMsg{cap: 1}, tex_box: chan DecodedTextureMsg{cap: 1}
    })
    mgr.jobs <- StreamJob{handle: h, kind: STREAM_KIND_TEXTURE, path: path + "", srgb: srgb, sampling: sampling}
    << h
}

pub fn (mgr $&StreamingManager3D) set_priority(handle int, priority f64) int {
    if handle < 0 || handle >= mgr.entries.len || !fm.finite(priority) {
        >> errors.new("nexus streaming: invalid handle or priority")
    }
    mgr.entries[handle].priority = priority
    << 0
}

pub fn (mgr $&StreamingManager3D) touch(handle int, frame int) int {
    if handle < 0 || handle >= mgr.entries.len {
        >> errors.new("nexus streaming: invalid asset handle")
    }
    mgr.entries[handle].last_used_frame = frame
    << 0
}

pub fn (mgr $&StreamingManager3D) restream(handle int, priority f64, frame int) int {
    if mgr.closed || handle < 0 || handle >= mgr.entries.len || !fm.finite(priority) {
        >> errors.new("nexus streaming: cannot restream invalid or closed handle")
    }
    e := $&mgr.entries[handle]
    if e.state == STREAM_STATE_RESIDENT {
        e.last_used_frame = frame
        << 0
    }
    if e.state != STREAM_STATE_EVICTED && e.state != STREAM_STATE_FAILED {
        e.priority = priority
        << 0
    }
    e.priority = priority
    e.state = STREAM_STATE_PENDING
    e.err = ""
    mgr.jobs <- StreamJob{handle: handle, kind: e.kind, path: e.path + "", srgb: e.srgb, sampling: e.sampling}
    << 0
}

fn (mgr $&StreamingManager3D) evict_one_lru(needed_free int) bool {
    $best := -1
    $oldest := 2147483647
    for i in 0:mgr.entries.len {
        e := &mgr.entries[i]
        if e.state == STREAM_STATE_RESIDENT && !e.pinned {
            if e.last_used_frame < oldest {
                oldest = e.last_used_frame
                best = i
            }
        }
    }
    if best < 0 { << false }
    e := $&mgr.entries[best]
    slot := e.gpu_slot
    if e.kind == STREAM_KIND_TEXTURE {
        if slot >= 0 && slot < mgr.resident_textures.len && mgr.tex_alive[slot] {
            t := $&mgr.resident_textures[slot]
            t.close() or >>
            mgr.tex_alive[slot] = false
        }
    } else {
        if slot >= 0 && slot < mgr.resident_meshes.len && mgr.mesh_alive[slot] {
            m := $&mgr.resident_meshes[slot]
            m.close() or >>
            mgr.mesh_alive[slot] = false
        }
    }
    mgr.resident_bytes -= e.byte_size
    if mgr.resident_bytes < 0 { mgr.resident_bytes = 0 }
    e.state = STREAM_STATE_EVICTED
    e.gpu_slot = -1
    << true
}

fn (mgr $&StreamingManager3D) ensure_vram_room(incoming_bytes int) int {
    $evicted := 0
    while mgr.resident_bytes + incoming_bytes > mgr.config.max_resident_bytes {
        ok := mgr.evict_one_lru(incoming_bytes) or >>
        if !ok { << evicted }
        evicted += 1
    }
    << evicted
}

fn drop_ready_handle_at(src &[]int, skip int) []int {
    $out := []int{}
    for i in 0:src.len {
        if i != skip { out.push(src[i]) }
    }
    << out
}

fn (mgr $&StreamingManager3D) accept_mesh_msg(msg DecodedMeshMsg) int {
    h := msg.handle
    if h < 0 || h >= mgr.entries.len { << 0 }
    if !msg.ok {
        mgr.entries[h].state = STREAM_STATE_FAILED
        mgr.entries[h].err = msg.err + ""
        << -1
    }
    mgr.entries[h].state = STREAM_STATE_READY_CPU
    mgr.entries[h].byte_size = msg.byte_size
    box := mgr.entries[h].mesh_box
    box <- msg
    mgr.ready_handles.push(h)
    << 1
}

fn (mgr $&StreamingManager3D) accept_tex_msg(msg DecodedTextureMsg) int {
    h := msg.handle
    if h < 0 || h >= mgr.entries.len { << 0 }
    if !msg.ok {
        mgr.entries[h].state = STREAM_STATE_FAILED
        mgr.entries[h].err = msg.err + ""
        << -1
    }
    mgr.entries[h].state = STREAM_STATE_READY_CPU
    mgr.entries[h].byte_size = msg.byte_size
    box := mgr.entries[h].tex_box
    box <- msg
    mgr.ready_handles.push(h)
    << 1
}

pub fn (mgr $&StreamingManager3D) pump(device &ren.Device3D, frame int) StreamPumpStats {
    device.alive() or >>
    if mgr.closed || !mgr.owner.matches(device) {
        >> errors.new("nexus streaming: closed or foreign streaming manager")
    }

    $decoded_n := 0
    $failed_n := 0

    // 1. Non-blocking drain of async worker decode results into per-entry ownership boxes.
    $draining_m := true
    while draining_m {
        select {
            msg := <-mgr.mesh_done {
                r := mgr.accept_mesh_msg(msg)
                if r > 0 { decoded_n += 1 }
                else if r < 0 { failed_n += 1 }
            }
            else {
                draining_m = false
            }
        }
    }

    $draining_t := true
    while draining_t {
        select {
            msg := <-mgr.tex_done {
                r := mgr.accept_tex_msg(msg)
                if r > 0 { decoded_n += 1 }
                else if r < 0 { failed_n += 1 }
            }
            else {
                draining_t = false
            }
        }
    }

    // 2. Priority-ordered, frame-budgeted GPU uploads + LRU cache eviction!
    $uploaded_n := 0
    $bytes_up := 0
    $evicted_n := 0

    while uploaded_n < mgr.config.max_uploads_per_frame && mgr.ready_handles.len > 0 {
        $best_pos := -1
        $best_prio := -1e30

        for i in 0:mgr.ready_handles.len {
            h := mgr.ready_handles[i]
            prio := mgr.entries[h].priority
            b := mgr.entries[h].byte_size
            fits := uploaded_n == 0 || (bytes_up + b <= mgr.config.max_bytes_per_frame)
            if fits && prio > best_prio {
                best_prio = prio
                best_pos = i
            }
        }
        if best_pos < 0 {
            << StreamPumpStats{
                decoded_this_frame: decoded_n,
                uploaded_this_frame: uploaded_n,
                bytes_uploaded_this_frame: bytes_up,
                evicted_this_frame: evicted_n,
                failed_this_frame: failed_n,
                resident_bytes: mgr.resident_bytes,
                pending_decode: mgr.count_state(STREAM_STATE_PENDING),
                ready_queue: mgr.ready_handles.len
            }
        }

        h := mgr.ready_handles[best_pos]
        mgr.ready_handles = drop_ready_handle_at(&mgr.ready_handles, best_pos)
        ibytes := mgr.entries[h].byte_size
        evicted_n += mgr.ensure_vram_room(ibytes) or >>

        if mgr.entries[h].kind == STREAM_KIND_TEXTURE {
            item := <-mgr.entries[h].tex_box
            tex := device.texture_rgba_sampled(item.imgs[0].width, item.imgs[0].height, &item.imgs[0].pixels, item.srgb, item.sampling) or >>
            actual_bytes := tex.storage_bytes() or >>
            slot := mgr.resident_textures.len
            mgr.resident_textures.push(tex)
            mgr.tex_alive.push(true)
            mgr.entries[h].state = STREAM_STATE_RESIDENT
            mgr.entries[h].byte_size = actual_bytes
            mgr.entries[h].gpu_slot = slot
            mgr.entries[h].last_used_frame = frame
            mgr.resident_bytes += actual_bytes
            uploaded_n += 1
            bytes_up += ibytes
        } else {
            item := <-mgr.entries[h].mesh_box
            gm := device.upload(&item.data) or >>
            slot := mgr.resident_meshes.len
            mgr.resident_meshes.push(gm)
            mgr.mesh_alive.push(true)
            mgr.entries[h].state = STREAM_STATE_RESIDENT
            mgr.entries[h].byte_size = ibytes
            mgr.entries[h].gpu_slot = slot
            mgr.entries[h].last_used_frame = frame
            mgr.resident_bytes += ibytes
            uploaded_n += 1
            bytes_up += ibytes
        }
    }

    << StreamPumpStats{
        decoded_this_frame: decoded_n,
        uploaded_this_frame: uploaded_n,
        bytes_uploaded_this_frame: bytes_up,
        evicted_this_frame: evicted_n,
        failed_this_frame: failed_n,
        resident_bytes: mgr.resident_bytes,
        pending_decode: mgr.count_state(STREAM_STATE_PENDING),
        ready_queue: mgr.ready_handles.len
    }
}

fn (mgr &StreamingManager3D) count_state(state int) int {
    $c := 0
    for i in 0:mgr.entries.len {
        if mgr.entries[i].state == state { c += 1 }
    }
    << c
}

pub fn (mgr &StreamingManager3D) state(handle int) int {
    if handle < 0 || handle >= mgr.entries.len { >> errors.new("nexus streaming: invalid handle") }
    << mgr.entries[handle].state
}

pub fn (mgr &StreamingManager3D) error_message(handle int) string {
    if handle < 0 || handle >= mgr.entries.len { >> errors.new("nexus streaming: invalid handle") }
    << mgr.entries[handle].err + ""
}

pub fn (mgr &StreamingManager3D) mesh_ref(handle int) ren.MeshRef3D {
    if mgr.closed || handle < 0 || handle >= mgr.entries.len {
        >> errors.new("nexus streaming: closed manager or invalid mesh handle")
    }
    e := &mgr.entries[handle]
    if e.kind == STREAM_KIND_TEXTURE || e.state != STREAM_STATE_RESIDENT {
        >> errors.new("nexus streaming: streamed mesh is not currently resident")
    }
    slot := e.gpu_slot
    << mgr.resident_meshes[slot].reference()
}

pub fn (mgr &StreamingManager3D) texture_ref(handle int) ren.TextureRef3D {
    if mgr.closed || handle < 0 || handle >= mgr.entries.len {
        >> errors.new("nexus streaming: closed manager or invalid texture handle")
    }
    e := &mgr.entries[handle]
    if e.kind != STREAM_KIND_TEXTURE || e.state != STREAM_STATE_RESIDENT {
        >> errors.new("nexus streaming: streamed texture is not currently resident")
    }
    slot := e.gpu_slot
    << mgr.resident_textures[slot].reference()
}

pub fn (mgr &StreamingManager3D) resident_bytes_used() int { << mgr.resident_bytes }

pub fn (mgr $&StreamingManager3D) shutdown() int {
    if mgr.closed { << 0 }
    for _ in 0:mgr.config.workers {
        mgr.stop <- 1
    }
    for _ in 0:mgr.config.workers {
        _ := <-mgr.worker_done
    }
    for i in 0:mgr.resident_meshes.len {
        if mgr.mesh_alive[i] {
            m := $&mgr.resident_meshes[i]
            m.close() or >>
            mgr.mesh_alive[i] = false
        }
    }
    for i in 0:mgr.resident_textures.len {
        if mgr.tex_alive[i] {
            t := $&mgr.resident_textures[i]
            t.close() or >>
            mgr.tex_alive[i] = false
        }
    }
    mgr.resident_meshes = []ren.Mesh3D{}
    mgr.resident_textures = []ren.Texture3D{}
    mgr.ready_handles = []int{}
    mgr.resident_bytes = 0
    mgr.closed = true
    << 0
}

fn (mgr $&StreamingManager3D) drop() {
    mgr.shutdown() or (err) { << }
}
