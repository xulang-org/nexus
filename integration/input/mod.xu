@"github.com/xulang-org/nexus/integration/input"

controls #"github.com/xulang-org/nexus/input"
window_events #window/events
#errors

// The caller routes each window's queue to its own action map. Portable input
// data has no window/device ownership and does not require the window backend.
pub fn apply_window_input(input $&controls.InputMap, event &window_events.Event) int {
    if event.kind == window_events.EVENT_INPUT_RESET || event.kind == window_events.EVENT_FOCUS_LOST ||
        event.kind == window_events.EVENT_CLOSE_REQUESTED {
        input.release_all()
        << 0
    }
    if event.kind != window_events.EVENT_KEY_DOWN && event.kind != window_events.EVENT_KEY_UP { << 0 }
    if event.physical_key < 0 || event.physical_key >= window_events.KEY_COUNT {
        >>> errors.new("nexus: portable physical key outside input range")
    }
    if event.physical_key == window_events.KEY_UNKNOWN { << 0 }
    if event.kind == window_events.EVENT_KEY_DOWN && event.repeated { << 0 }
    << input.feed_key(event.physical_key, event.kind == window_events.EVENT_KEY_DOWN) >>>
}
