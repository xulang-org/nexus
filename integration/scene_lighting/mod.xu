@"github.com/xulang-org/nexus/integration/scene_lighting"

resource #"github.com/xulang-org/nexus/resources/scene"
bindings #"github.com/xulang-org/nexus/integration/lighting"
node_files #"github.com/xulang-org/nexus/integration/scene"
nexus #"github.com/xulang-org/nexus/scene"
#errors

// Explicit partial restore for applications composing light, render, audio and
// script services. The whole batch is validated before any source is replaced.
pub fn bind(document &resource.Document, world $&bindings.SceneLights3D, tree &nexus.SceneTree, root int) int {
    ids := node_files.matching_nodes(document,tree,root) >>>
    $nodes := []int{}
    $sources := []bindings.LightBinding3D{}
    for i in 0:document.light_count() {
        light := document.light(i) >>>
        nodes.push(ids[light.node])
        sources.push(bindings.LightBinding3D{source: light.source, cascades: light.cascades, punctual: light.punctual})
    }
    << world.attach_bindings(tree,nodes,sources) >>>
}
// Node/light-only convenience. Other services require explicit composition;
// their attachments must never disappear through an apparently full restore.
pub fn instantiate(document &resource.Document, world $&bindings.SceneLights3D, tree $&nexus.SceneTree,
    parent int, name string) int {
    if document.surface_count()>0 || document.audio_count()>0 || document.script_count()>0 || document.sprite_3d_count()>0 || document.tilemap_2d_count()>0 {
        >> errors.new("nexus scene lights: other attachments require to_packed_nodes and explicit service binding")
    }
    if document.light_count()>nexus.MAX_NODES-world.binding_count() { >> errors.new("nexus scene lights: insufficient light binding capacity") }
    packed := node_files.to_packed_nodes(document) >>>
    // Immutable validated descriptions and node kinds cannot fail binding after
    // the PackedScene's naming/capacity preflight has committed the target tree.
    root := packed.instantiate(tree,parent,name) >>>
    bind(document,world,tree,root) >>>
    << root
}
fn capture_lights(world &bindings.SceneLights3D, tree &nexus.SceneTree, root int) []resource.LightAttachment {
    ids := tree.subtree(root) >>>
    $result := []resource.LightAttachment{}
    for i in 0:ids.len {
        if !world.has(ids[i]) { -> }
        binding := world.binding(tree, ids[i]) >>>
        result.push(resource.LightAttachment{node: i, source: binding.source, cascades: binding.cascades, punctual: binding.punctual})
    }
    << result
}
// Capture only the chosen subtree's current nodes and local sources, including
// hidden sources. Runtime IDs and accumulated world transforms are not stored.
pub fn capture_nodes(world &bindings.SceneLights3D, tree &nexus.SceneTree, root int) resource.Document {
    nodes := node_files.capture_nodes(tree,root) >>>
    sources := capture_lights(world,tree,root) >>>
    << resource.with_lights(&nodes,sources) >>>
}
// Preserve all other authored attachments while capturing live light edits.
// Topology changes require a new document rather than guessing index remaps.
pub fn capture(document &resource.Document, world &bindings.SceneLights3D, tree &nexus.SceneTree, root int) resource.Document {
    node_files.matching_nodes(document,tree,root) >>>
    nodes := node_files.capture_nodes(tree,root) >>>
    $references := []resource.ResourceReference{}
    for i in 0:document.resource_count() { references.push(document.resource(i) >>>) }
    preserved := resource.with_references(document,&nodes,references) >>>
    sources := capture_lights(world,tree,root) >>>
    << resource.with_lights(&preserved,sources) >>>
}
