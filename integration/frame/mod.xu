@"github.com/xulang-org/nexus/integration/frame"

controls #"github.com/xulang-org/nexus/input"
input_bridge #"github.com/xulang-org/nexus/integration/input"
timing #"github.com/xulang-org/nexus/timing"
events #window/events
#errors

// Host-neutral frame coordination. The host supplies a monotonic timestamp and
// a resume generation; scene/rendering owners remain with the application.
pub struct FrameLoop {
    clock timing.Clock
    last_ns int
    epoch int
    initialized bool
    open bool
    alive bool
    paused bool
    elapsed f64
}
pub fn new_frame_loop(ticks_per_second int, max_steps int) FrameLoop {
    clock := timing.new_clock(ticks_per_second, max_steps) >>>
    << FrameLoop{clock: clock, last_ns: 0, epoch: 0,
        initialized: false, open: false, alive: true, paused: false, elapsed: 0.0}
}
// Call once after the host grants a frame, before draining copied events.
// Returning true identifies a foreground transition, not a cold start.
pub fn (loop $&FrameLoop) begin_frame(input $&controls.InputMap, touch $&input_bridge.TouchControls,
    timestamp_ns int, resume_epoch int) bool {
    if !loop.alive || loop.open || timestamp_ns < 0 || resume_epoch < 0 ||
        (loop.initialized && timestamp_ns < loop.last_ns) {
        >>> errors.new("nexus frame: invalid frame boundary or monotonic timestamp")
    }
    resumed := loop.initialized && loop.epoch != resume_epoch
    $clock := loop.clock
    input.begin_frame()
    loop.elapsed = 0.0
    if loop.initialized && !resumed { loop.elapsed = f64(timestamp_ns - loop.last_ns) / 1000000000.0 }
    if resumed {
        input.release_all()
        touch.cancel(input) >>>
        clock.reset()
    }
    loop.clock = clock
    loop.last_ns = timestamp_ns
    loop.epoch = resume_epoch
    loop.initialized = true
    loop.open = true
    << resumed
}
pub fn (loop $&FrameLoop) feed(input $&controls.InputMap, touch $&input_bridge.TouchControls, event &events.Event) int {
    if !loop.open { >>> errors.new("nexus frame: input requires an open frame") }
    $clock := loop.clock
    touch.apply(input, event) >>>
    if event.kind == events.EVENT_CLOSE_REQUESTED { loop.alive = false }
    if event.kind == events.EVENT_INPUT_RESET || event.kind == events.EVENT_FOCUS_LOST {
        clock.reset()
        loop.elapsed = 0.0
    }
    loop.clock = clock
    << 0
}
pub fn (loop $&FrameLoop) reset_touches(input $&controls.InputMap, touch $&input_bridge.TouchControls) int {
    touch.cancel(input) >>>
    $clock := loop.clock
    clock.reset()
    loop.clock = clock
    loop.elapsed = 0.0
    << 0
}
pub fn (loop &FrameLoop) running() bool { << loop.alive }
pub fn (loop $&FrameLoop) finish_frame(paused bool) timing.FrameStep {
    if !loop.open { >>> errors.new("nexus frame: finish requires an open frame") }
    loop.open = false
    $clock := loop.clock
    if paused || paused != loop.paused || !loop.alive {
        clock.reset()
        loop.elapsed = 0.0
    }
    loop.paused = paused
    step := clock.advance(loop.elapsed) >>>
    loop.clock = clock
    << step
}
