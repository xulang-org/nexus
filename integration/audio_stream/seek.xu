@"github.com/xulang-org/nexus/integration/audio_stream"

assets #"github.com/xulang-org/nexus/assets/audio"
mix #"github.com/xulang-org/nexus/audio/mixer"
#math
#errors

fn (stream $&MusicStream) position(mixer $&mix.Mixer, frame int, resume bool) int {
    if stream.closed || frame < 0 || frame > stream.reader.frame_count() { >> errors.new("nexus music: closed stream or seek outside file") }
    info := mixer.stream_info(stream.source) >>>
    if info.sample_rate != stream.reader.sample_rate() || info.channels != stream.reader.channel_count() { >> errors.new("nexus music: mismatched source format") }
    if resume && !mixer.is_voice(info.consumer_voice) { >> errors.new("nexus music: restart requires an existing playback voice") }
    total := stream.reader.frame_count()
    if total == 0 { >> errors.new("nexus music: empty source") }
    $target := frame
    if stream.looping && target == total { target = 0 }
    $frames := info.capacity_frames
    if frames > assets.MAX_READ_FRAMES { frames = assets.MAX_READ_FRAMES }
    if stream.cache.len == 0 && frames > total - target { frames = total - target }
    $samples := []int{}
    if frames > 0 { samples = stream.read_window(target, frames) >>>
    } else { stream.reader.validate_source() >>> }
    finished := !stream.looping && target + frames == total
    // The prepared window may fail to read/decode. Only after it is valid can
    // the mixer drop old PCM, clear EOF, and reset the consumer/envelope.
    mixer.reset_stream(stream.source, &samples, finished, resume) >>>
    if stream.cache.len > 0 {
        if total == 0 { >> errors.new("nexus music: empty cached loop") }
        stream.cursor = (target + frames) % total
    } else { stream.cursor = target + frames }
    stream.origin_frame = target
    << target
}
pub fn (stream $&MusicStream) seek_frames(mixer $&mix.Mixer, frame int) int {
    << stream.position(mixer, frame, false) >>>
}
// Time rounds to the nearest source sample frame (ties to even), not an output
// device frame. Seeking preserves playing/stopped and voice/bus pause state.
pub fn (stream $&MusicStream) seek_seconds(mixer $&mix.Mixer, seconds f64) int {
    duration := stream.duration_seconds()
    if math.is_nan(seconds) || math.is_inf(seconds) || seconds < 0.0 || seconds > duration { >> errors.new("nexus music: invalid seek time") }
    target := int(math.round_to_even(seconds * f64(stream.reader.sample_rate())))
    << stream.position(mixer, target, false) >>>
}
pub fn (stream $&MusicStream) restart(mixer $&mix.Mixer) int {
    << stream.position(mixer, 0, true) >>>
}
pub fn (stream &MusicStream) duration_seconds() f64 {
    rate := stream.reader.sample_rate()
    if rate == 0 { << 0.0 }
    << f64(stream.reader.frame_count()) / f64(rate)
}
// Position of the mixer's committed source, including already queued output;
// this is not the hardware's audible cursor. Producer read_position is separate.
pub fn (stream &MusicStream) position_seconds(mixer &mix.Mixer) f64 {
    if stream.closed { >> errors.new("nexus music: closed stream") }
    info := mixer.stream_info(stream.source) >>>
    $position := f64(stream.origin_frame) + info.position_frames
    total := f64(stream.reader.frame_count())
    if stream.looping {
        if total == 0.0 { >> errors.new("nexus music: empty stream") }
        position = position - math.floor(position / total) * total
    } else if position > total { position = total }
    rate := stream.reader.sample_rate()
    if rate == 0 { >> errors.new("nexus music: zero sample rate") }
    << position / f64(rate)
}

pub fn (stream &MusicStream) frame_count() int { << stream.reader.frame_count() }
pub fn (stream &MusicStream) sample_rate() int { << stream.reader.sample_rate() }
