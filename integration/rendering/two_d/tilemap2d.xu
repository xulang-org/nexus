@"github.com/xulang-org/nexus/integration/rendering/two_d"

canvas #"github.com/xulang-org/nexus/resources/canvas"
tilemap #"github.com/xulang-org/nexus/resources/tilemap"
fm #"github.com/xulang-org/nexus/foundation/math"
nexus #"github.com/xulang-org/nexus/scene"
#errors

// Connects a Node2D and pure CPU TileMap2D to direct Batch2D recording,
// YSortQueue2D interleaving, and screen-to-cell isometric picking.
pub struct TileMapLayer2D {
    pub node int
    pub grid tilemap.TileMap2D
    pub z_index int
    pub y_sort_cells bool
    pub y_offset f64
}

pub fn new_tilemap_layer_2d(node int, grid tilemap.TileMap2D, z_index int, y_sort_cells bool, y_offset f64) TileMapLayer2D {
    if node <= 0 { >> errors.new("nexus tilemap: invalid Node2D") }
    grid.validate() >>>
    if !fm.finite(y_offset) { >> errors.new("nexus tilemap: non-finite y_offset") }
    << TileMapLayer2D{node: node, grid: grid, z_index: z_index, y_sort_cells: y_sort_cells, y_offset: y_offset}
}

// Fast single-batch recording in deterministic back-to-front cell order.
pub fn (layer &TileMapLayer2D) record(tree &nexus.SceneTree, camera fm.Transform2D, batch $&canvas.Batch2D) int {
    if !camera.is_finite() { >> errors.new("nexus tilemap: invalid camera transform") }
    if !tree.is_alive(layer.node) || !(tree.is_visible(layer.node) >>>) { << 0 }
    world := tree.global_transform(layer.node) >>>
    quad := layer.grid.tileset.local_quad_bounds() >>>
    order := layer.grid.draw_order() >>>
    $drawn := 0
    for coord in order {
        tile := layer.grid.cell(coord.col, coord.row) >>>
        if tile == tilemap.EMPTY_TILE { -> }
        uv := layer.grid.tileset.tile_uv(tile) >>>
        pos := layer.grid.cell_visual_center(coord.col, coord.row) >>>
        tint := layer.grid.tint(coord.col, coord.row) >>>
        cell_xform := world.multiply(fm.transform_2d(pos, 0.0, fm.vec2(1.0, 1.0)))
        batch.quad_region(quad, camera.multiply(cell_xform), tint, uv) >>>
        drawn += 1
    }
    << drawn
}

// Enqueue visible cells into YSortQueue2D so actors walk behind and in front of
// isometric walls, pillars, and elevated blocks.
pub fn (layer &TileMapLayer2D) enqueue(tree &nexus.SceneTree, queue $&YSortQueue2D, texture_id int) int {
    if !tree.is_alive(layer.node) || !(tree.is_visible(layer.node) >>>) { << 0 }
    world := tree.global_transform(layer.node) >>>
    quad := layer.grid.tileset.local_quad_bounds() >>>
    order := layer.grid.draw_order() >>>
    $pushed := 0
    for coord in order {
        tile := layer.grid.cell(coord.col, coord.row) >>>
        if tile == tilemap.EMPTY_TILE { -> }
        uv := layer.grid.tileset.tile_uv(tile) >>>
        visual := layer.grid.cell_visual_center(coord.col, coord.row) >>>
        tint := layer.grid.tint(coord.col, coord.row) >>>
        cell_world := world.multiply(fm.transform_2d(visual, 0.0, fm.vec2(1.0, 1.0)))
        $sort_y := world.ty + layer.y_offset
        if layer.y_sort_cells {
            ground := layer.grid.cell_center(coord.col, coord.row)
            ground_world := world.point(ground)
            sort_y = ground_world.y + layer.y_offset
        }
        queue.push_quad(quad, uv, cell_world, tint, texture_id, layer.z_index, sort_y) >>>
        pushed += 1
    }
    << pushed
}

// Map a screen pixel point through Camera2D and the TileMap node's inverse
// world transform onto the tile grid coordinate.
pub fn (layer &TileMapLayer2D) pick_cell(tree &nexus.SceneTree, camera &nexus.Camera2D,
    screen_point fm.Vec2, output_width f64, output_height f64) tilemap.CellCoord {
    world_point := camera.screen_to_world(screen_point, output_width, output_height) >>>
    world := tree.global_transform(layer.node) >>>
    inv := world.inverse() >>>
    local := inv.point(world_point)
    << layer.grid.point_to_cell(local) >>>
}
