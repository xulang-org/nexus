@"github.com/xulang-org/game/integration/rendering/two_d"

game #"github.com/xulang-org/game/scene"
fm #"github.com/xulang-org/game/foundation/math"
canvas #"github.com/xulang-org/game/resources/canvas"

// Texture storage belongs to Texture2D; a sprite only records scene geometry.
// Record adjacent sprites into one Batch2D, then submit_texture with their atlas.
pub struct Sprite2D {
    pub node int
    pub bounds fm.Rect2
    pub region fm.Rect2
    pub tint int
}
pub fn (sprite &Sprite2D) record(tree &game.SceneTree, camera fm.Transform2D, batch $&canvas.Batch2D) int {
    if !tree.is_alive(sprite.node) || !(tree.is_visible(sprite.node) or >>) { << 0 }
    scene_global := tree.global_transform(sprite.node) or >>
    << batch.quad_region(sprite.bounds, camera.multiply(scene_global), sprite.tint, sprite.region) or >>
}
