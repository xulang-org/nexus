@"github.com/xulang-org/nexus/integration/rendering/two_d"

ren_data #"github.com/xulang-org/nexus/resources/canvas"

nexus #"github.com/xulang-org/nexus/scene"
fm #"github.com/xulang-org/nexus/foundation/math"
#errors

pub struct ColorRect2D {
    pub node int
    pub bounds fm.Rect2
    pub color int
}
pub struct Canvas2D { items []ColorRect2D }
pub fn new_canvas_2d() Canvas2D { << Canvas2D{items: []ColorRect2D{}} }
pub fn (canvas $&Canvas2D) add_rect(node int, bounds fm.Rect2, color int) int {
    if node <= 0 || !bounds.valid() || color < 0 || color > 4294967295 || canvas.items.len >= 65536 {
        >> errors.new("nexus canvas: invalid canvas item or canvas capacity exceeded")
    }
    canvas.items.push(ColorRect2D{node: node, bounds: bounds, color: color})
    << 0
}
// Items follow scene pre-order. Freed or hidden nodes produce no geometry.
// Camera is a world-to-screen transform, independent of scene ownership.
pub fn (canvas &Canvas2D) record(tree &nexus.SceneTree, camera fm.Transform2D, batch $&ren_data.Batch2D) int {
    order := tree.subtree(tree.root()) >>>
    for id in order {
        if (tree.node_kind(id) >>>) != nexus.NODE_2D { -> }
        if !(tree.is_visible(id) >>>) { -> }
        scene_global := tree.global_transform(id) >>>
        transform := camera.multiply(scene_global)
        for item in canvas.items {
            if item.node == id { batch.quad(item.bounds, transform, item.color) >>> }
        }
    }
    << 0
}
