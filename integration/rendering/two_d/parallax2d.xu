@"github.com/xulang-org/nexus/integration/rendering/two_d"

tilemap #"github.com/xulang-org/nexus/resources/tilemap"
fm #"github.com/xulang-org/nexus/foundation/math"
nexus #"github.com/xulang-org/nexus/scene"
#errors

// Applies a 2.5D parallax scroll factor to Camera2D so background, midground,
// and foreground layers move at distinct apparent depths.
pub struct ParallaxLayer2D {
    pub config tilemap.Parallax2D
}

pub fn new_parallax_layer_2d(scale_x f64, scale_y f64, offset_x f64, offset_y f64) ParallaxLayer2D {
    cfg := tilemap.parallax_2d(scale_x, scale_y, offset_x, offset_y) or >>
    << ParallaxLayer2D{config: cfg}
}

pub fn (layer &ParallaxLayer2D) view_transform(camera &nexus.Camera2D, output_width f64, output_height f64) fm.Transform2D {
    layer.config.validate() or >>
    size := camera.design_size()
    $shifted := nexus.new_camera_2d(size.x, size.y) or >>
    shifted.position = fm.vec2(
        camera.position.x * layer.config.scroll_scale.x + layer.config.scroll_offset.x,
        camera.position.y * layer.config.scroll_scale.y + layer.config.scroll_offset.y)
    shifted.rotation = camera.rotation
    shifted.zoom = camera.zoom
    << shifted.view_transform(output_width, output_height) or >>
}
