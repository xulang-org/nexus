@"github.com/xulang-org/nexus/integration/rendering/three_d"

fm #"github.com/xulang-org/nexus/foundation/math"
nexus #"github.com/xulang-org/nexus/scene"
ren #"github.com/xulang-org/nexus/rendering/three_d"
#errors

// Weak mesh reference. Mesh3D retains ownership; the standard GPU identity is checked
// on attach/draw. Keep this binding set with the same SceneTree used to attach.
pub struct Scene3D {
    owner ren.DeviceRef3D
    meshes map[int]ren.MeshRef3D
    materials map[int]ren.Material3D
    lods map[int]MeshLods3D
    lod_levels map[int]int
    bound_nodes []int
    count int
}
pub struct SceneDraw3D {
    pub instances int
    pub triangles int
    pub culled_instances int
    pub culled_triangles int
    pub lod_instances int
    pub lod_triangles_saved int
}
pub fn new_scene_3d(device &ren.Device3D) Scene3D {
    device.backend() >>>
    << Scene3D{owner: device.reference(), meshes: map[int]ren.MeshRef3D{}, materials: map[int]ren.Material3D{},
        lods: map[int]MeshLods3D{},lod_levels: map[int]int{},bound_nodes: []int{},count: 0}
}
// One mesh per node; attaching again replaces that node's weak resource binding.
// Keys use the full node ID; no dependency on SceneTree's private slot encoding.
pub fn (scene $&Scene3D) attach_mesh(tree &nexus.SceneTree, node int, mesh &ren.Mesh3D) int {
    added := scene.check_mesh_binding(tree, node, mesh) >>>
    scene.clear_lods(node)
    scene.set_mesh_binding(node, mesh.reference(), added)
    << 0
}
fn (scene $&Scene3D) set_mesh_binding(node int, mesh ren.MeshRef3D, added int) {
    if added == 1 { scene.bound_nodes.push(node) }
    scene.meshes[node] = mesh
    scene.count = scene.count + added
}
// Read-only preflight for importers/tools. Returns 1 for a new binding, 0 for
// replacement. A caller binding several nodes must also check the total room.
pub fn (scene &Scene3D) check_mesh_binding(tree &nexus.SceneTree, node int, mesh &ren.Mesh3D) int {
    info := tree.node_info(node) >>>
    if info.kind != nexus.NODE_3D || info.queued_free { >>> errors.new("nexus GPU: mesh requires an editable Node3D") }
    if scene.materials.has(node) {
        material := &scene.materials[node]
        scene.owner.validate_material(mesh.reference(), material) >>>
    } else { scene.owner.validate_mesh(mesh.reference(), false) >>> }
    if !scene.meshes.has(node) {
        if scene.count >= nexus.MAX_NODES { >>> errors.new("nexus GPU: scene binding limit reached; prune retired nodes") }
        << 1
    }
    << 0
}
pub fn (scene &Scene3D) binding_count() int { << scene.count }
pub fn (scene &Scene3D) remaining_bindings() int { << nexus.MAX_NODES - scene.count }
pub fn (scene $&Scene3D) detach_mesh(node int) int {
    if node <= 0 { >>> errors.new("nexus GPU: invalid mesh node") }
    if !scene.meshes.has(node) { << 0 }
    scene.remove_mesh_binding(node)
    scene.compact_bound_nodes()
    << 1
}
fn (scene $&Scene3D) remove_mesh_binding(node int) {
    scene.clear_lods(node)
    meshes := $&scene.meshes
    meshes.delete(node)
    materials := $&scene.materials
    materials.delete(node)
    scene.count = scene.count - 1
}
// The mesh map has no key iteration, so this index is what lets prune find
// bindings whose node was already freed from the tree.
fn (scene $&Scene3D) compact_bound_nodes() {
    $kept := []int{}
    for i in 0:scene.bound_nodes.len {
        node := scene.bound_nodes[i]
        if scene.meshes.has(node) { kept.push(node) }
    }
    scene.bound_nodes = kept
}
// Clear freed/queued bindings; GPU resources are owned independently and survive.
// A node that was already flushed is gone from the tree, so it is found through
// the bound node index instead of by walking the live subtree.
pub fn (scene $&Scene3D) prune(tree &nexus.SceneTree) int {
    $drop := []int{}
    for i in 0:scene.bound_nodes.len {
        node := scene.bound_nodes[i]
        if !tree.is_alive(node) {
            drop.push(node)
            ->
        }
        info := tree.node_info(node) >>>
        if info.queued_free { drop.push(node) }
    }
    if drop.len == 0 { << 0 }
    for i in 0:drop.len {
        scene.remove_mesh_binding(drop[i])
    }
    scene.compact_bound_nodes()
    << drop.len
}
// Draw inside Device3D.begin/present. Hidden and queued nodes emit no draws.
// Stable scene pre-order decides equal-depth ties. Opaque depth resolves overlap.
pub fn (scene &Scene3D) draw(device $&ren.Device3D, tree &nexus.SceneTree, view_projection fm.Mat4) SceneDraw3D {
    if scene.materials.len() > 0 { >>> errors.new("nexus GPU: material-bound scene requires draw_lit and lighting") }
    if !scene.owner.matches(device) { >>> errors.new("nexus GPU: scene belongs to another device") }
    device.validate_recording() >>>
    if !view_projection.is_finite() { >>> errors.new("nexus GPU: invalid scene view-projection") }
    order := tree.subtree(tree.root()) >>>
    $instances := 0
    $triangles := 0
    $culled_instances := 0
    $culled_triangles := 0
    $lod_instances := 0
    $lod_triangles_saved := 0
    for node in order {
        if !scene.meshes.has(node) { -> }
        if !(tree.is_visible(node) >>>) { -> }
        mesh := scene.selected_mesh(node) >>>
        world := tree.global_transform_3d(node) >>>
        mvp := view_projection.multiply(world)
        if !(scene.owner.mesh_in_view(mesh,mvp) >>>) {
            culled_instances+=1
            culled_triangles+=mesh.triangle_count()
            ->
        }
        count := device.draw_reference(mesh, mvp) >>>
        instances = instances + 1
        triangles = triangles + count
        if (scene.lod_level(node) >>>)>0 { lod_instances+=1
            lod_triangles_saved+=scene.meshes[node].triangle_count()-count }
    }
    << SceneDraw3D{instances: instances,triangles: triangles,culled_instances: culled_instances,culled_triangles: culled_triangles,
        lod_instances: lod_instances,lod_triangles_saved: lod_triangles_saved}
}
