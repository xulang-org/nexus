@"github.com/xulang-org/nexus/integration/rendering/three_d"

lod #"github.com/xulang-org/nexus/resources/lod"
fm #"github.com/xulang-org/nexus/foundation/math"
nexus #"github.com/xulang-org/nexus/scene"
ren #"github.com/xulang-org/nexus/rendering/three_d"
#math
#errors

struct MeshLods3D { meshes []ren.MeshRef3D
    policy lod.DistanceLod }
fn copy_lods(binding &MeshLods3D) MeshLods3D {
    $meshes := []ren.MeshRef3D{}
    for mesh in binding.meshes { meshes.push(mesh) }
    $thresholds := []f64{}
    for i in 0:binding.policy.level_count()-1 { thresholds.push(binding.policy.threshold(i) >>>) }
    policy := lod.distance_lod(thresholds,binding.policy.hysteresis()) >>>
    << MeshLods3D{meshes: meshes,policy: policy}
}
pub struct LodSelection3D { pub nodes int
    pub changed int
    pub levels []int }
fn (scene &Scene3D) lod_binding_slot(tree &nexus.SceneTree, node int) int {
    info := tree.node_info(node) >>>
    if info.kind!=nexus.NODE_3D || info.queued_free { >>> errors.new("nexus LOD: binding requires an editable Node3D") }
    if scene.meshes.has(node) { << 0 }
    if scene.count >= nexus.MAX_NODES { >>> errors.new("nexus LOD: scene binding capacity exceeded") }
    << 1
}
fn validate_lod_levels(meshes &[]ren.MeshRef3D, policy &lod.DistanceLod) int {
    policy.validate() >>>
    if meshes.len!=policy.level_count() { >>> errors.new("nexus LOD: mesh count differs from policy levels") }
    $previous := -1
    for mesh in meshes {
        if previous>=0 && mesh.triangle_count()>previous { >>> errors.new("nexus LOD: coarser levels must not increase triangle count") }
        previous=mesh.triangle_count()
    }
    << 0
}
fn (scene $&Scene3D) set_lod_binding(node int, meshes []ren.MeshRef3D, policy &lod.DistanceLod, added int) int {
    $thresholds := []f64{}
    for i in 0:policy.level_count()-1 { thresholds.push(policy.threshold(i) >>>) }
    saved := lod.distance_lod(thresholds,policy.hysteresis()) >>>
    first := meshes[0]
    scene.lods[node]=MeshLods3D{meshes: meshes,policy: saved}
    $initial := -1
    if policy.level_count()==1 { initial=0 }
    scene.lod_levels[node]=initial
    scene.set_mesh_binding(node,first,added)
    << 0
}
// Non-owning levels share the node's coordinate system and current material.
pub fn (scene $&Scene3D) attach_lods(tree &nexus.SceneTree, node int, meshes []ren.MeshRef3D, policy &lod.DistanceLod) int {
    added := scene.lod_binding_slot(tree, node) >>>
    validate_lod_levels(&meshes, policy) >>>
    for mesh in meshes {
        if scene.materials.has(node) {
            material := &scene.materials[node]
            scene.owner.validate_material(mesh, material) >>>
        } else { scene.owner.validate_mesh(mesh, false) >>> }
    }
    << scene.set_lod_binding(node, meshes, policy, added) >>>
}
// Validate the replacement material on every level before changing any binding.
pub fn (scene &Scene3D) check_lod_surface_binding(tree &nexus.SceneTree, node int, meshes &[]ren.MeshRef3D,
    policy &lod.DistanceLod, material &ren.Material3D) int {
    added := scene.lod_binding_slot(tree, node) >>>
    validate_lod_levels(meshes, policy) >>>
    for mesh in meshes { scene.owner.validate_material(mesh, material) >>> }
    << added
}
pub fn (scene $&Scene3D) attach_lod_surface(tree &nexus.SceneTree, node int, meshes []ren.MeshRef3D,
    policy &lod.DistanceLod, material ren.Material3D) int {
    added := scene.check_lod_surface_binding(tree, node, &meshes, policy, &material) >>>
    scene.set_lod_binding(node, meshes, policy, added) >>>
    scene.materials[node] = material
    << 0
}
pub fn (scene &Scene3D) lod_level(node int) int {
    if !scene.meshes.has(node) { >>> errors.new("nexus LOD: no mesh binding at node") }
    if !scene.lods.has(node) { << 0 }
    << scene.lod_levels[node]
}
fn (scene &Scene3D) validate_lod_meshes(node int) int {
    if !scene.lods.has(node) { << 0 }
    binding := &scene.lods[node]
    for mesh in binding.meshes { scene.owner.validate_mesh(mesh,false) >>> }
    << 0
}
fn (scene &Scene3D) selected_mesh(node int) ren.MeshRef3D {
    if !scene.lods.has(node) { << scene.meshes[node] }
    scene.validate_lod_meshes(node) >>>
    level := scene.lod_levels[node]
    if level<0 { >>> errors.new("nexus LOD: call select_lods with the active camera before drawing") }
    binding := &scene.lods[node]
    << binding.meshes[level]
}
fn lod_distance(a fm.Vec3, b fm.Vec3) f64 {
    delta := a.sub(b)
    if !delta.is_finite() { >>> errors.new("nexus LOD: camera/node distance overflow") }
    scale := math.max(math.abs(delta.x),math.max(math.abs(delta.y),math.abs(delta.z)))
    if scale==0.0 { << 0.0 }
    distance := fm.vec3(delta.x/scale,delta.y/scale,delta.z/scale).length()*scale
    if !fm.finite(distance) { >>> errors.new("nexus LOD: camera/node distance overflow") }
    << distance
}
// Select all node-visible LOD groups before publishing any state. State belongs
// to this binding set; call again when switching views or editing transforms.
pub fn (scene $&Scene3D) select_lods(tree &nexus.SceneTree, eye fm.Vec3) LodSelection3D {
    if !eye.is_finite() { >>> errors.new("nexus LOD: camera position must be finite") }
    order := tree.subtree(tree.root()) >>>
    $nodes := []int{}
    $selected := []int{}
    $counts := []int{}
    for i in 0:lod.MAX_LEVELS { counts.push(0) }
    $changed := 0
    for node in order {
        if !scene.lods.has(node) || !(tree.is_visible(node) >>>) { -> }
        scene.validate_lod_meshes(node) >>>
        distance := lod_distance(eye,(tree.global_transform_3d(node) >>>).c3.xyz()) >>>
        binding := &scene.lods[node]
        previous := scene.lod_levels[node]
        level := binding.policy.choose(distance,previous) >>>
        nodes.push(node)
        selected.push(level)
        counts[level]+=1
        if level!=previous { changed+=1 }
    }
    for i in 0:nodes.len { scene.lod_levels[nodes[i]]=selected[i] }
    << LodSelection3D{nodes: nodes.len,changed: changed,levels: counts}
}
fn (scene $&Scene3D) clear_lods(node int) {
    if scene.lods.has(node) { groups := $&scene.lods
        groups.delete(node) }
    if scene.lod_levels.has(node) { levels := $&scene.lod_levels
        levels.delete(node) }
}
