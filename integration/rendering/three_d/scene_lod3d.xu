@"github.com/xulang-org/game/integration/rendering/three_d"

lod #"github.com/xulang-org/game/resources/lod"
fm #"github.com/xulang-org/game/foundation/math"
game #"github.com/xulang-org/game/scene"
ren #"github.com/xulang-org/game/rendering/three_d"
#math
#errors

struct MeshLods3D { meshes []ren.MeshRef3D
    policy lod.DistanceLod }
fn copy_lods(binding &MeshLods3D) MeshLods3D {
    $meshes := []ren.MeshRef3D{}
    for mesh in binding.meshes { meshes.push(mesh) }
    $thresholds := []f64{}
    for i in 0:binding.policy.level_count()-1 { thresholds.push(binding.policy.threshold(i) or >>) }
    policy := lod.distance_lod(thresholds,binding.policy.hysteresis()) or >>
    << MeshLods3D{meshes: meshes,policy: policy}
}
pub struct LodSelection3D { pub nodes int
    pub changed int
    pub levels []int }
// Non-owning, atomically installed levels. All meshes share the node's local
// coordinate system and material; GPU owners must outlive every binding.
pub fn (scene $&Scene3D) attach_lods(tree &game.SceneTree, node int, meshes []ren.MeshRef3D, policy &lod.DistanceLod) int {
    info := tree.node_info(node) or >>
    if info.kind!=game.NODE_3D || info.queued_free { >> errors.new("game LOD: binding requires an editable Node3D") }
    policy.validate() or >>
    if meshes.len!=policy.level_count() { >> errors.new("game LOD: mesh count differs from policy levels") }
    $previous := -1
    for mesh in meshes {
        if scene.materials.has(node) {
            material := scene.materials[node]
            scene.owner.validate_material(mesh,&material) or >>
        } else { scene.owner.validate_mesh(mesh,false) or >> }
        if previous>=0 && mesh.triangle_count()>previous { >> errors.new("game LOD: coarser levels must not increase triangle count") }
        previous=mesh.triangle_count()
    }
    $added := 0
    if !scene.meshes.has(node) {
        if scene.count>=game.MAX_NODES { >> errors.new("game LOD: scene binding capacity exceeded") }
        added=1
    }
    $thresholds := []f64{}
    for i in 0:policy.level_count()-1 { thresholds.push(policy.threshold(i) or >>) }
    saved := lod.distance_lod(thresholds,policy.hysteresis()) or >>
    first := meshes[0]
    scene.lods[node]=MeshLods3D{meshes: meshes,policy: saved}
    $initial := -1
    if policy.level_count()==1 { initial=0 }
    scene.lod_levels[node]=initial
    scene.meshes[node]=first
    scene.count+=added
    << 0
}
pub fn (scene &Scene3D) lod_level(node int) int {
    if !scene.meshes.has(node) { >> errors.new("game LOD: no mesh binding at node") }
    if !scene.lods.has(node) { << 0 }
    << scene.lod_levels[node]
}
fn (scene &Scene3D) validate_lod_meshes(node int) int {
    if !scene.lods.has(node) { << 0 }
    binding := &scene.lods[node]
    for mesh in binding.meshes { scene.owner.validate_mesh(mesh,false) or >> }
    << 0
}
fn (scene &Scene3D) selected_mesh(node int) ren.MeshRef3D {
    if !scene.lods.has(node) { << scene.meshes[node] }
    scene.validate_lod_meshes(node) or >>
    level := scene.lod_levels[node]
    if level<0 { >> errors.new("game LOD: call select_lods with the active camera before drawing") }
    binding := &scene.lods[node]
    << binding.meshes[level]
}
fn lod_distance(a fm.Vec3, b fm.Vec3) f64 {
    delta := a.sub(b)
    if !delta.is_finite() { >> errors.new("game LOD: camera/node distance overflow") }
    scale := math.max(math.abs(delta.x),math.max(math.abs(delta.y),math.abs(delta.z)))
    if scale==0.0 { << 0.0 }
    distance := fm.vec3(delta.x/scale,delta.y/scale,delta.z/scale).length()*scale
    if !fm.finite(distance) { >> errors.new("game LOD: camera/node distance overflow") }
    << distance
}
// Select all node-visible LOD groups before publishing any state. State belongs
// to this binding set; call again when switching views or editing transforms.
pub fn (scene $&Scene3D) select_lods(tree &game.SceneTree, eye fm.Vec3) LodSelection3D {
    if !eye.is_finite() { >> errors.new("game LOD: camera position must be finite") }
    order := tree.subtree(tree.root()) or >>
    $nodes := []int{}
    $selected := []int{}
    $counts := []int{}
    for i in 0:lod.MAX_LEVELS { counts.push(0) }
    $changed := 0
    for node in order {
        if !scene.lods.has(node) || !(tree.is_visible(node) or >>) { -> }
        scene.validate_lod_meshes(node) or >>
        distance := lod_distance(eye,(tree.global_transform_3d(node) or >>).c3.xyz()) or >>
        binding := &scene.lods[node]
        previous := scene.lod_levels[node]
        level := binding.policy.choose(distance,previous) or >>
        nodes.push(node)
        selected.push(level)
        counts[level]+=1
        if level!=previous { changed+=1 }
    }
    for i in 0:nodes.len { scene.lod_levels[nodes[i]]=selected[i] }
    << LodSelection3D{nodes: nodes.len,changed: changed,levels: counts}
}
fn (scene $&Scene3D) clear_lods(node int) {
    if scene.lods.has(node) { groups := $&scene.lods
        groups.delete(node) }
    if scene.lod_levels.has(node) { levels := $&scene.lod_levels
        levels.delete(node) }
}
