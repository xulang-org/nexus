@"github.com/xulang-org/nexus/integration/rendering/three_d"

colors #"github.com/xulang-org/nexus/foundation/color"
fm #"github.com/xulang-org/nexus/foundation/math"
light_data #"github.com/xulang-org/nexus/resources/lighting"
meshes #"github.com/xulang-org/nexus/resources/mesh"
sprite_data #"github.com/xulang-org/nexus/resources/sprite3d"
nexus #"github.com/xulang-org/nexus/scene"
ren #"github.com/xulang-org/nexus/rendering/three_d"
#errors

struct SpriteBinding3D {
    spec sprite_data.Sprite3D
    material ren.Material3D
}

// Owns one shared unit quad Mesh3D and weak material/texture bindings for Node3D
// billboards and HD-2D cutout sprites. Texture3D ownership stays with the caller.
pub struct SceneSprites3D {
    owner ren.DeviceRef3D
    quads []ren.Mesh3D
    bindings map[int]SpriteBinding3D
    bound_nodes []int
    count int
    closed bool
}

fn apply_sprite_material(material &ren.Material3D, spec &sprite_data.Sprite3D) ren.Material3D {
    spec.validate() >>>
    $next := material.with_alpha_cutoff(spec.effective_alpha_cutoff()) >>>
    next = next.with_double_sided(spec.double_sided)
    next = next.with_uv_region(spec.region) >>>
    next = next.with_uv_flip(spec.flip_x, spec.flip_y) >>>
    next = next.with_shaded(spec.shaded) >>>
    << next
}

pub fn new_scene_sprites_3d(device &ren.Device3D) SceneSprites3D {
    device.backend() >>>
    white := colors.rgba8(255, 255, 255, 255) >>>
    quad_data := meshes.quad_mesh_3d(1.0, 1.0, fm.vec2(0.0, 0.0), white) >>>
    quad := device.upload(&quad_data) >>>
    << SceneSprites3D{
        owner: device.reference(),
        quads: [quad],
        bindings: map[int]SpriteBinding3D{},
        bound_nodes: []int{},
        count: 0,
        closed: false
    }
}

fn (sprites &SceneSprites3D) require_open() int {
    if sprites.closed || sprites.quads.len == 0 {
        >>> errors.new("nexus sprite3d: sprite scene is closed")
    }
    << 0
}

fn (sprites &SceneSprites3D) quad_ref() ren.MeshRef3D {
    sprites.require_open() >>>
    << sprites.quads[0].reference()
}

pub fn (sprites &SceneSprites3D) binding_count() int { << sprites.count }
pub fn (sprites &SceneSprites3D) remaining_bindings() int { << sprite_data.MAX_SPRITES_3D - sprites.count }
pub fn (sprites &SceneSprites3D) has_sprite(node int) bool { << !sprites.closed && sprites.bindings.has(node) }

pub fn (sprites &SceneSprites3D) spec(node int) sprite_data.Sprite3D {
    sprites.require_open() >>>
    if !sprites.bindings.has(node) { >>> errors.new("nexus sprite3d: node has no Sprite3D binding") }
    << sprites.bindings[node].spec
}

pub fn (sprites &SceneSprites3D) check_binding(tree &nexus.SceneTree, node int, spec &sprite_data.Sprite3D, material &ren.Material3D) int {
    sprites.require_open() >>>
    spec.validate() >>>
    info := tree.node_info(node) >>>
    if info.kind != nexus.NODE_3D || info.queued_free {
        >>> errors.new("nexus sprite3d: Sprite3D requires an editable Node3D")
    }
    applied := apply_sprite_material(material, spec) >>>
    sprites.owner.validate_material(sprites.quad_ref() >>>, &applied) >>>
    if !sprites.bindings.has(node) {
        if sprites.count >= sprite_data.MAX_SPRITES_3D {
            >>> errors.new("nexus sprite3d: sprite binding limit reached; prune retired nodes")
        }
        << 1
    }
    << 0
}

pub fn (sprites $&SceneSprites3D) attach_material(tree &nexus.SceneTree, node int, spec sprite_data.Sprite3D, material ren.Material3D) int {
    added := sprites.check_binding(tree, node, &spec, &material) >>>
    applied := apply_sprite_material(&material, &spec) >>>
    if added == 1 { sprites.bound_nodes.push(node) }
    sprites.bindings[node] = SpriteBinding3D{spec: spec, material: applied}
    sprites.count = sprites.count + added
    << 0
}

pub fn (sprites $&SceneSprites3D) attach(tree &nexus.SceneTree, node int, spec sprite_data.Sprite3D, texture &ren.Texture3D) int {
    spec.validate() >>>
    base := ren.material_3d(spec.tint, 0.0, 0.9, fm.vec3(0.0, 0.0, 0.0)) >>>
    textured := base.with_base_texture(texture) >>>
    << sprites.attach_material(tree, node, spec, textured) >>>
}

pub fn (sprites $&SceneSprites3D) set_spec(tree &nexus.SceneTree, node int, spec sprite_data.Sprite3D) int {
    sprites.require_open() >>>
    spec.validate() >>>
    info := tree.node_info(node) >>>
    if info.kind != nexus.NODE_3D || info.queued_free {
        >>> errors.new("nexus sprite3d: Sprite3D requires an editable Node3D")
    }
    if !sprites.bindings.has(node) { >>> errors.new("nexus sprite3d: attach a sprite before updating its spec") }
    existing := &sprites.bindings[node]
    applied := apply_sprite_material(&existing.material, &spec) >>>
    sprites.owner.validate_material(sprites.quad_ref() >>>, &applied) >>>
    sprites.bindings[node] = SpriteBinding3D{spec: spec, material: applied}
    << 0
}

// Lightweight animation/facing update that reuses the shared quad without GPU uploads.
pub fn (sprites $&SceneSprites3D) set_region(node int, region fm.Rect2, flip_x bool, flip_y bool) int {
    sprites.require_open() >>>
    if !sprites.bindings.has(node) { >>> errors.new("nexus sprite3d: node has no Sprite3D binding") }
    existing := &sprites.bindings[node]
    next_spec := existing.spec.with_region(region) >>>
    flipped := next_spec.with_flip(flip_x, flip_y) >>>
    applied := apply_sprite_material(&existing.material, &flipped) >>>
    sprites.bindings[node] = SpriteBinding3D{spec: flipped, material: applied}
    << 0
}

fn (sprites $&SceneSprites3D) compact_bound_nodes() {
    $kept := []int{}
    for i in 0:sprites.bound_nodes.len {
        node := sprites.bound_nodes[i]
        if sprites.bindings.has(node) { kept.push(node) }
    }
    sprites.bound_nodes = kept
}

pub fn (sprites $&SceneSprites3D) detach(node int) int {
    if node <= 0 { >>> errors.new("nexus sprite3d: invalid sprite node") }
    if !sprites.bindings.has(node) { << 0 }
    bindings := $&sprites.bindings
    bindings.delete(node)
    sprites.count = sprites.count - 1
    sprites.compact_bound_nodes()
    << 1
}

pub fn (sprites $&SceneSprites3D) prune(tree &nexus.SceneTree) int {
    $drop := []int{}
    for i in 0:sprites.bound_nodes.len {
        node := sprites.bound_nodes[i]
        if !tree.is_alive(node) {
            drop.push(node)
            ->
        }
        info := tree.node_info(node) >>>
        if info.queued_free { drop.push(node) }
    }
    if drop.len == 0 { << 0 }
    bindings := $&sprites.bindings
    for i in 0:drop.len {
        bindings.delete(drop[i])
    }
    sprites.count = sprites.count - drop.len
    sprites.compact_bound_nodes()
    << drop.len
}

// Convenience world pose for Camera3D look-at rigs (matches CameraNode3D global transform).
pub fn camera_world_from_look_at(eye fm.Vec3, target fm.Vec3, up fm.Vec3) fm.Mat4 {
    view := nexus.look_at_3d(eye, target, up) >>>
    << view.affine_inverse() >>>
}

// Collect alpha-cutout shadow casters for all visible cast_shadow sprites.
pub fn (sprites &SceneSprites3D) shadow_casters(tree &nexus.SceneTree, camera_world fm.Mat4) []ren.ShadowCaster3D {
    sprites.require_open() >>>
    if !camera_world.is_affine() { >>> errors.new("nexus sprite3d: invalid camera world transform") }
    quad := sprites.quad_ref() >>>
    order := tree.subtree(tree.root()) >>>
    $casters := []ren.ShadowCaster3D{}
    for node in order {
        if !sprites.bindings.has(node) || !(tree.is_visible(node) >>>) { -> }
        binding := &sprites.bindings[node]
        if !binding.spec.cast_shadow { -> }
        node_world := tree.global_transform_3d(node) >>>
        world := binding.spec.quad_world_matrix(node_world, camera_world) >>>
        casters.push(ren.shadow_caster_material(quad, world, &binding.material) >>>)
    }
    << casters
}

pub fn (sprites &SceneSprites3D) draw_lit(device $&ren.Device3D, tree &nexus.SceneTree,
    camera_world fm.Mat4, view_projection fm.Mat4, lighting &light_data.Environment3D) SceneDraw3D {
    empty := ren.no_shadow_binding()
    << sprites.draw_lit_with_shadow(device, tree, camera_world, view_projection, lighting, &empty) >>>
}

pub fn (sprites &SceneSprites3D) draw_lit_shadowed(device $&ren.Device3D, tree &nexus.SceneTree,
    camera_world fm.Mat4, view_projection fm.Mat4, lighting &light_data.Environment3D,
    shadow &ren.ShadowMap3D, source int) SceneDraw3D {
    binding := shadow.binding(lighting, source) >>>
    binding.validate_camera(view_projection) >>>
    << sprites.draw_lit_with_shadow(device, tree, camera_world, view_projection, lighting, &binding) >>>
}

fn (sprites &SceneSprites3D) draw_lit_with_shadow(device $&ren.Device3D, tree &nexus.SceneTree,
    camera_world fm.Mat4, view_projection fm.Mat4, lighting &light_data.Environment3D,
    shadow &ren.ShadowBinding3D) SceneDraw3D {
    sprites.require_open() >>>
    if !sprites.owner.matches(device) { >>> errors.new("nexus sprite3d: sprite scene belongs to another device") }
    device.validate_recording() >>>
    lighting.validate() >>>
    if !camera_world.is_affine() || !view_projection.is_finite() {
        >>> errors.new("nexus sprite3d: invalid camera transform or view-projection")
    }
    quad := sprites.quad_ref() >>>
    order := tree.subtree(tree.root()) >>>
    $instances := 0
    $triangles := 0
    $culled_instances := 0
    $culled_triangles := 0
    for node in order {
        if !sprites.bindings.has(node) || !(tree.is_visible(node) >>>) { -> }
        binding := &sprites.bindings[node]
        node_world := tree.global_transform_3d(node) >>>
        world := binding.spec.quad_world_matrix(node_world, camera_world) >>>
        if !(sprites.owner.material_in_view(quad, world, view_projection, &binding.material) >>>) {
            culled_instances += 1
            culled_triangles += quad.triangle_count()
            ->
        }
        count := device.draw_material_shadowed_reference(quad, world, view_projection, &binding.material, lighting, shadow) >>>
        instances += 1
        triangles += count
    }
    << SceneDraw3D{
        instances: instances,
        triangles: triangles,
        culled_instances: culled_instances,
        culled_triangles: culled_triangles,
        lod_instances: 0,
        lod_triangles_saved: 0
    }
}

fn close_sprite_quad(quad $&ren.Mesh3D) string {
    quad.close() >>> (err) { << err.msg() }
    << ""
}

pub fn (sprites $&SceneSprites3D) close() int {
    if sprites.closed { << 0 }
    $first := ""
    for i in 0:sprites.quads.len {
        quad := $&sprites.quads[i]
        msg := close_sprite_quad(quad)
        if first.len == 0 && msg.len > 0 { first = msg }
    }
    sprites.quads = []ren.Mesh3D{}
    sprites.bindings = map[int]SpriteBinding3D{}
    sprites.bound_nodes = []int{}
    sprites.count = 0
    sprites.closed = true
    if first.len > 0 { >>> errors.new(first) }
    << 0
}

fn (sprites $&SceneSprites3D) drop() { sprites.close() >>> (err) { << } }
