@"github.com/xulang-org/nexus/integration/rendering/three_d"

nexus #"github.com/xulang-org/nexus/scene"
ren #"github.com/xulang-org/nexus/rendering/three_d"
#errors

// Validate the candidate surface, independently of an old material that is being
// replaced. Importers preflight the complete batch before publishing any entry.
pub fn (scene &Scene3D) check_surface_binding(tree &nexus.SceneTree, node int, mesh &ren.Mesh3D, material &ren.Material3D) int {
    << scene.check_surface_binding_ref(tree, node, mesh.reference(), material) >>>
}
pub fn (scene &Scene3D) check_surface_binding_ref(tree &nexus.SceneTree, node int, mesh ren.MeshRef3D, material &ren.Material3D) int {
    info := tree.node_info(node) >>>
    if info.kind != nexus.NODE_3D || info.queued_free { >>> errors.new("nexus GPU: surface requires an editable Node3D") }
    scene.owner.validate_material(mesh, material) >>>
    if !scene.meshes.has(node) {
        if scene.count >= nexus.MAX_NODES { >>> errors.new("nexus GPU: scene binding limit reached") }
        << 1
    }
    << 0
}
pub fn (scene $&Scene3D) attach_surface(tree &nexus.SceneTree, node int, mesh &ren.Mesh3D, material ren.Material3D) int {
    << scene.attach_surface_ref(tree, node, mesh.reference(), material) >>>
}
pub fn (scene $&Scene3D) attach_surface_ref(tree &nexus.SceneTree, node int, mesh ren.MeshRef3D, material ren.Material3D) int {
    added := scene.check_surface_binding_ref(tree, node, mesh, &material) >>>
    scene.clear_lods(node)
    scene.materials[node] = material
    scene.set_mesh_binding(node, mesh, added)
    << 0
}
