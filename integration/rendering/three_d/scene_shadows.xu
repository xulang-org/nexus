@"github.com/xulang-org/nexus/integration/rendering/three_d"

nexus #"github.com/xulang-org/nexus/scene"
ren #"github.com/xulang-org/nexus/rendering/three_d"
policy #"github.com/xulang-org/nexus/resources/shadow"
#errors

pub fn cascade_camera(camera &nexus.Camera3D,aspect f64) policy.CascadeCamera3D {
    view := nexus.look_at_3d(camera.position,camera.target,camera.up) >>>
    projection := nexus.perspective_3d(camera.vertical_fov,aspect,camera.near,camera.far) >>>
    << policy.cascade_camera(view,projection) >>>
}
pub fn cascade_node_camera(camera &nexus.CameraNode3D,tree &nexus.SceneTree,aspect f64) policy.CascadeCamera3D {
    info := tree.node_info(camera.node) >>>
    if info.queued_free { >>> errors.new("nexus shadow: cascade camera queued for deletion") }
    view := (tree.global_transform_3d(camera.node) >>>).affine_inverse() >>>
    projection := nexus.perspective_3d(camera.vertical_fov,aspect,camera.near,camera.far) >>>
    << policy.cascade_camera(view,projection) >>>
}

// Resolve either projection from a Node3D's current lens and world pose.
pub fn cascade_scene_camera(tree &nexus.SceneTree, node int, aspect f64) policy.CascadeCamera3D {
    projection := tree.camera_projection_3d(node, aspect) >>>
    view := (tree.global_transform_3d(node) >>>).affine_inverse() >>>
    << policy.cascade_camera(view, projection) >>>
}

// Shadow coverage is independent of the main camera's frustum. Hidden, queued
// or removed nodes do not cast; selected LOD and weak resource checks are shared.
pub fn (scene &Scene3D) shadow_casters(tree &nexus.SceneTree) []ren.ShadowCaster3D {
    order := tree.subtree(tree.root()) >>>
    $casters := []ren.ShadowCaster3D{}
    for node in order {
        if !scene.meshes.has(node) || !(tree.is_visible(node) >>>) { -> }
        mesh := scene.selected_mesh(node) >>>
        scene.owner.validate_mesh(mesh,false) >>>
        world := tree.global_transform_3d(node) >>>
        if scene.materials.has(node) {
            material := &scene.materials[node]
            casters.push(ren.shadow_caster_material(mesh, world, material) >>>)
        } else {
            casters.push(ren.shadow_caster(mesh, world))
        }
    }
    << casters
}
