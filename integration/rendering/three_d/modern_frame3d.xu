@"github.com/xulang-org/nexus/integration/rendering/three_d"

fm #"github.com/xulang-org/nexus/foundation/math"
ren #"github.com/xulang-org/nexus/rendering/three_d"
light_data #"github.com/xulang-org/nexus/resources/lighting"
#errors

// High-level unified modern GPU rendering frame combining:
// 1. Clustered 16x16x24 dynamic lighting (up to 1024 lights)
// 2. Meshlet GPU-Driven Culling (Frustum + Normal Cone + Hi-Z) + Visibility Buffer Shading
// 3. GPU Compute LBS dynamic skinned characters with conservative joint AABB pre-culling
// 4. L1 SH 3D Irradiance Probes GI + GTAO + Hi-Z SSR + Bloom + ACES + TAA Post-Processing
pub struct ModernPipeline3D {
    owner ren.DeviceRef3D
    clustered ren.ClusteredRenderer3D
    hiz ren.HizPyramid3D
    hdr ren.HdrTarget3D
    pp ren.PostProcessPipeline3D
    closed bool
}

pub struct ModernFrameStats3D {
    pub skinned_visible int
    pub transparent_visible int
    pub transparent_culled int
}

pub fn new_modern_pipeline_3d(
    device &ren.Device3D,
    cprog &ren.ClusteredProgram3D,
    iprog &ren.IndirectProgram3D,
    pprog &ren.PostProcessProgram3D
) ModernPipeline3D {
    device.alive() or >>
    if !device.is_gpu() { >> errors.new("nexus modern: ModernPipeline3D requires GPU backend") }
    $clustered := device.clustered_renderer(cprog) or >>
    $hiz := device.hiz_pyramid(iprog) or >>
    $hdr := device.hdr_target(pprog) or >>
    $pp := device.postprocess_pipeline(pprog) or >>
    << ModernPipeline3D{
        owner: device.reference(),
        clustered: clustered,
        hiz: hiz,
        hdr: hdr,
        pp: pp,
        closed: false
    }
}

pub fn (mp $&ModernPipeline3D) prepare_lights(
    device &ren.Device3D,
    ambient fm.Vec3,
    eye fm.Vec3,
    exposure f64,
    lights &[]light_data.Light3D,
    view fm.Mat4,
    proj fm.Mat4,
    z_near f64,
    z_far f64
) int {
    if mp.closed || !mp.owner.matches(device) {
        >> errors.new("nexus modern: closed or foreign ModernPipeline3D")
    }
    cl := $&mp.clustered
    << cl.bin_lights(device, ambient, eye, exposure, lights, view, proj, z_near, z_far, 0) or >>
}

fn (mp $&ModernPipeline3D) render_unified_core(
    device $&ren.Device3D,
    meshlets $&ren.MeshletVisRenderer3D,
    use_gi bool,
    irr &ren.IrradianceGpu3D,
    gi_strength f64,
    has_shadow bool,
    shadow &ren.ShadowBinding3D,
    use_ibl bool,
    has_ibl_obj bool,
    ibl &ren.EnvironmentIbl3D,
    skinned_refs &[]ren.MeshRef3D,
    skinned_worlds &[]fm.Mat4,
    skinned_mats &[]ren.Material3D,
    has_transparent bool,
    transparent &ren.TransparentQueue3D,
    eye fm.Vec3,
    view fm.Mat4,
    proj fm.Mat4,
    z_near f64,
    z_far f64,
    sky_linear fm.Vec3,
    clear_rgba int,
    use_hiz_cull bool,
    enable_cone_cull bool,
    pp_cfg &ren.PostProcessConfig3D
) ModernFrameStats3D {
    if mp.closed || !mp.owner.matches(device) {
        >> errors.new("nexus modern: closed or foreign ModernPipeline3D")
    }
    if skinned_refs.len != skinned_worlds.len || skinned_refs.len != skinned_mats.len {
        >> errors.new("nexus modern: skinned mesh/world/material arrays length mismatch")
    }
    vp := proj.multiply(view)

    // 1. Cull meshlets via Frustum + Normal Cone + optional previous-frame Hi-Z.
    if use_hiz_cull {
        meshlets.cull_with_hiz(device, &mp.hiz, eye, vp, enable_cone_cull, 0.0001) or >>
    } else {
        meshlets.cull(device, eye, vp, enable_cone_cull) or >>
    }

    // 2. Render Visibility Buffer + decoupled Clustered/GI/Shadow/IBL Compute Shading into shared HdrTarget3D.
    hdr_ref := $&mp.hdr
    if has_shadow || (use_ibl && has_ibl_obj) {
        meshlets.render_and_shade_pbr(
            device, hdr_ref, &mp.clustered, use_gi, irr, gi_strength,
            has_shadow, shadow, use_ibl, ibl, view, vp, sky_linear, false
        ) or >>
    } else {
        meshlets.render_and_shade_into(device, hdr_ref, &mp.clustered, use_gi, irr, gi_strength, view, vp, sky_linear, false) or >>
    }

    // 3. Draw visible GPU-skinned dynamic meshes using conservative joint bounds into the loaded HDR+Depth target!
    $visible_skinned := 0
    if skinned_refs.len > 0 {
        hdr_ref.begin_overlay(device) or >>
        for i in 0:skinned_refs.len {
            mref := skinned_refs[i]
            w := skinned_worlds[i]
            mvp := vp.multiply(w)
            // Conservative skinning bounds culling before HDR overlay submission.
            if !(mp.owner.mesh_in_view(mref, mvp) or >>) { -> }
            if use_gi {
                hdr_ref.draw_clustered_gi(device, &mp.clustered, irr, gi_strength, mref, w, view, vp, &skinned_mats[i]) or >>
            } else {
                hdr_ref.draw_clustered(device, &mp.clustered, mref, w, view, vp, &skinned_mats[i]) or >>
            }
            visible_skinned += 1
        }
        hdr_ref.end() or >>
    }

    // 4. Optional back-to-front sorted alpha-blended transparent queue into loaded HDR+Depth target.
    $tstats := ren.TransparentSortStats3D{submitted: 0, visible: 0, frustum_culled: 0}
    if has_transparent {
        tstats = transparent.flush_into_hdr(device, hdr_ref, &mp.clustered, use_gi, irr, gi_strength, view, vp) or >>
    }

    // 5. Hi-Z rebuild + GTAO + Hi-Z SSR + Bloom + TAA + ACES composite onto Device3D target.
    device.begin(clear_rgba) or >>
    pp_ref := $&mp.pp
    hiz_ref := $&mp.hiz
    pp_ref.apply(device, hdr_ref, hiz_ref, view, proj, z_near, z_far, pp_cfg) or >>
    << ModernFrameStats3D{
        skinned_visible: visible_skinned,
        transparent_visible: tstats.visible,
        transparent_culled: tstats.frustum_culled
    }
}

fn (mp $&ModernPipeline3D) render_unified_pbr_vfx_core(
    device $&ren.Device3D,
    meshlets $&ren.MeshletVisRenderer3D,
    use_gi bool,
    irr &ren.IrradianceGpu3D,
    gi_strength f64,
    has_shadow bool,
    shadow &ren.ShadowBinding3D,
    use_ibl bool,
    ibl &ren.EnvironmentIbl3D,
    skinned_refs &[]ren.MeshRef3D,
    skinned_worlds &[]fm.Mat4,
    skinned_mats &[]ren.Material3D,
    transparent &ren.TransparentQueue3D,
    particles &ren.GpuParticleSystem3D,
    eye fm.Vec3,
    view fm.Mat4,
    proj fm.Mat4,
    z_near f64,
    z_far f64,
    sky_linear fm.Vec3,
    clear_rgba int,
    use_hiz_cull bool,
    enable_cone_cull bool,
    pp_cfg &ren.PostProcessConfig3D
) ModernFrameStats3D {
    if mp.closed || !mp.owner.matches(device) {
        >> errors.new("nexus modern: closed or foreign ModernPipeline3D")
    }
    if skinned_refs.len != skinned_worlds.len || skinned_refs.len != skinned_mats.len {
        >> errors.new("nexus modern: skinned mesh/world/material arrays length mismatch")
    }
    vp := proj.multiply(view)

    if use_hiz_cull {
        meshlets.cull_with_hiz(device, &mp.hiz, eye, vp, enable_cone_cull, 0.0001) or >>
    } else {
        meshlets.cull(device, eye, vp, enable_cone_cull) or >>
    }

    hdr_ref := $&mp.hdr
    if has_shadow || (use_ibl) {
        meshlets.render_and_shade_pbr(
            device, hdr_ref, &mp.clustered, use_gi, irr, gi_strength,
            has_shadow, shadow, use_ibl, ibl, view, vp, sky_linear, false
        ) or >>
    } else {
        meshlets.render_and_shade_into(device, hdr_ref, &mp.clustered, use_gi, irr, gi_strength, view, vp, sky_linear, false) or >>
    }

    $visible_skinned := 0
    if skinned_refs.len > 0 {
        hdr_ref.begin_overlay(device) or >>
        for i in 0:skinned_refs.len {
            mref := skinned_refs[i]
            w := skinned_worlds[i]
            mvp := vp.multiply(w)
            if !(mp.owner.mesh_in_view(mref, mvp) or >>) { -> }
            if use_gi {
                hdr_ref.draw_clustered_gi(device, &mp.clustered, irr, gi_strength, mref, w, view, vp, &skinned_mats[i]) or >>
            } else {
                hdr_ref.draw_clustered(device, &mp.clustered, mref, w, view, vp, &skinned_mats[i]) or >>
            }
            visible_skinned += 1
        }
        hdr_ref.end() or >>
    }

    tstats := transparent.flush_into_hdr(device, hdr_ref, &mp.clustered, use_gi, irr, gi_strength, view, vp) or >>
    particles.draw_into_hdr(device, hdr_ref, view, proj) or >>

    device.begin(clear_rgba) or >>
    pp_ref := $&mp.pp
    hiz_ref := $&mp.hiz
    pp_ref.apply(device, hdr_ref, hiz_ref, view, proj, z_near, z_far, pp_cfg) or >>
    << ModernFrameStats3D{
        skinned_visible: visible_skinned,
        transparent_visible: tstats.visible,
        transparent_culled: tstats.frustum_culled
    }
}

// Executes one full unified modern GPU frame:
// (Meshlet Cull + VisBuffer + GI/Clustered Shade) -> (Dynamic GPU-Skinned Overlay) -> (PostProcess -> Device3D).
pub fn (mp $&ModernPipeline3D) render_unified_frame(
    device $&ren.Device3D,
    meshlets $&ren.MeshletVisRenderer3D,
    use_gi bool,
    irr &ren.IrradianceGpu3D,
    gi_strength f64,
    skinned_refs &[]ren.MeshRef3D,
    skinned_worlds &[]fm.Mat4,
    skinned_mats &[]ren.Material3D,
    eye fm.Vec3,
    view fm.Mat4,
    proj fm.Mat4,
    z_near f64,
    z_far f64,
    sky_linear fm.Vec3,
    clear_rgba int,
    use_hiz_cull bool,
    enable_cone_cull bool,
    pp_cfg &ren.PostProcessConfig3D
) int {
    empty_shadow := ren.no_shadow_binding()
    empty_ibl := ren.empty_environment_ibl_3d(device)
    empty_t := ren.new_transparent_queue_3d()
    stats := mp.render_unified_core(
        device, meshlets, use_gi, irr, gi_strength,
        false, &empty_shadow, false, false, &empty_ibl,
        skinned_refs, skinned_worlds, skinned_mats,
        false, &empty_t,
        eye, view, proj, z_near, z_far, sky_linear, clear_rgba,
        use_hiz_cull, enable_cone_cull, pp_cfg
    ) or >>
    << stats.skinned_visible
}

pub fn (mp $&ModernPipeline3D) render_unified_pbr_frame(
    device $&ren.Device3D,
    meshlets $&ren.MeshletVisRenderer3D,
    use_gi bool,
    irr &ren.IrradianceGpu3D,
    gi_strength f64,
    has_shadow bool,
    shadow &ren.ShadowBinding3D,
    use_ibl bool,
    ibl &ren.EnvironmentIbl3D,
    skinned_refs &[]ren.MeshRef3D,
    skinned_worlds &[]fm.Mat4,
    skinned_mats &[]ren.Material3D,
    eye fm.Vec3,
    view fm.Mat4,
    proj fm.Mat4,
    z_near f64,
    z_far f64,
    sky_linear fm.Vec3,
    clear_rgba int,
    use_hiz_cull bool,
    enable_cone_cull bool,
    pp_cfg &ren.PostProcessConfig3D
) int {
    empty_t := ren.new_transparent_queue_3d()
    stats := mp.render_unified_core(
        device, meshlets, use_gi, irr, gi_strength,
        has_shadow, shadow, use_ibl, true, ibl,
        skinned_refs, skinned_worlds, skinned_mats,
        false, &empty_t,
        eye, view, proj, z_near, z_far, sky_linear, clear_rgba,
        use_hiz_cull, enable_cone_cull, pp_cfg
    ) or >>
    << stats.skinned_visible
}

pub fn (mp $&ModernPipeline3D) render_unified_pbr_transparent_frame(
    device $&ren.Device3D,
    meshlets $&ren.MeshletVisRenderer3D,
    use_gi bool,
    irr &ren.IrradianceGpu3D,
    gi_strength f64,
    has_shadow bool,
    shadow &ren.ShadowBinding3D,
    use_ibl bool,
    ibl &ren.EnvironmentIbl3D,
    skinned_refs &[]ren.MeshRef3D,
    skinned_worlds &[]fm.Mat4,
    skinned_mats &[]ren.Material3D,
    transparent &ren.TransparentQueue3D,
    eye fm.Vec3,
    view fm.Mat4,
    proj fm.Mat4,
    z_near f64,
    z_far f64,
    sky_linear fm.Vec3,
    clear_rgba int,
    use_hiz_cull bool,
    enable_cone_cull bool,
    pp_cfg &ren.PostProcessConfig3D
) ModernFrameStats3D {
    << mp.render_unified_core(
        device, meshlets, use_gi, irr, gi_strength,
        has_shadow, shadow, use_ibl, true, ibl,
        skinned_refs, skinned_worlds, skinned_mats,
        true, transparent,
        eye, view, proj, z_near, z_far, sky_linear, clear_rgba,
        use_hiz_cull, enable_cone_cull, pp_cfg
    ) or >>
}

pub fn (mp $&ModernPipeline3D) render_unified_pbr_vfx_frame(
    device $&ren.Device3D,
    meshlets $&ren.MeshletVisRenderer3D,
    use_gi bool,
    irr &ren.IrradianceGpu3D,
    gi_strength f64,
    has_shadow bool,
    shadow &ren.ShadowBinding3D,
    use_ibl bool,
    ibl &ren.EnvironmentIbl3D,
    skinned_refs &[]ren.MeshRef3D,
    skinned_worlds &[]fm.Mat4,
    skinned_mats &[]ren.Material3D,
    transparent &ren.TransparentQueue3D,
    particles &ren.GpuParticleSystem3D,
    eye fm.Vec3,
    view fm.Mat4,
    proj fm.Mat4,
    z_near f64,
    z_far f64,
    sky_linear fm.Vec3,
