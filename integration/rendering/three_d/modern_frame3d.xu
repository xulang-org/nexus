        skinned_refs, skinned_worlds, skinned_mats,
        transparent, particles,
        eye, view, proj, z_near, z_far, sky_linear, clear_rgba,
        use_hiz_cull, enable_cone_cull, pp_cfg
    ) or >>
}

pub fn (mp $&ModernPipeline3D) render_terrain_foliage_frame(
    device $&ren.Device3D,
    terrain_ren &ren.TerrainRenderer3D,
    chunk_refs &[]ren.MeshRef3D,
    chunk_worlds &[]fm.Mat4,
    terrain_mat &ren.TerrainMaterial3D,
    has_foliage bool,
    foliage &ren.GpuFoliageBatch3D,
    wind &ren.FoliageWindConfig3D,
    foliage_mat &ren.FoliageMaterial3D,
    use_gi bool,
    irr &ren.IrradianceGpu3D,
    gi_strength f64,
    has_transparent bool,
    transparent &ren.TransparentQueue3D,
    has_particles bool,
    particles &ren.GpuParticleSystem3D,
    eye fm.Vec3,
    view fm.Mat4,
    proj fm.Mat4,
    z_near f64,
    z_far f64,
    clear_rgba int,
    pp_cfg &ren.PostProcessConfig3D
) int {
    if mp.closed || !mp.owner.matches(device) {
        >> errors.new("nexus modern: closed or foreign ModernPipeline3D")
    }
    vp := proj.multiply(view)
    hdr_ref := $&mp.hdr
    tris := terrain_ren.draw_chunks_into_hdr(
        device, hdr_ref, &mp.clustered, use_gi, irr, gi_strength,
        chunk_refs, chunk_worlds, view, vp, terrain_mat, true, clear_rgba
    ) or >>
    if has_foliage {
        foliage.draw_into_hdr(
            device, hdr_ref, &mp.clustered, use_gi, irr, gi_strength,
            eye, view, vp, wind, foliage_mat
        ) or >>
    }
    if has_transparent {
        _ := transparent.flush_into_hdr(device, hdr_ref, &mp.clustered, use_gi, irr, gi_strength, view, vp) or >>
    }
    if has_particles {
        particles.draw_into_hdr(device, hdr_ref, view, proj) or >>
    }
    device.begin(clear_rgba) or >>
    pp_ref := $&mp.pp
    hiz_ref := $&mp.hiz
    pp_ref.apply(device, hdr_ref, hiz_ref, view, proj, z_near, z_far, pp_cfg) or >>
    << tris
}

pub fn (mp $&ModernPipeline3D) render_unified_atmosphere_frame(
    device $&ren.Device3D,
    opaque_refs &[]ren.MeshRef3D,
    opaque_worlds &[]fm.Mat4,
    opaque_mats &[]ren.Material3D,
    has_decals bool,
    decals_ren &ren.DecalRenderer3D,
    decals_queue &ren.DecalQueue3D,
    has_atmosphere bool,
    atm_ren &ren.AtmosphereRenderer3D,
    atm_cfg &ren.AtmosphereConfig3D,
    use_gi bool,
    irr &ren.IrradianceGpu3D,
    gi_strength f64,
    has_transparent bool,
    transparent &ren.TransparentQueue3D,
    has_particles bool,
    particles &ren.GpuParticleSystem3D,
    eye fm.Vec3,
    view fm.Mat4,
    proj fm.Mat4,
    z_near f64,
    z_far f64,
    clear_rgba int,
    pp_cfg &ren.PostProcessConfig3D
) int {
    if mp.closed || !mp.owner.matches(device) {
        >> errors.new("nexus modern: closed or foreign ModernPipeline3D")
    }
    if opaque_refs.len != opaque_worlds.len || opaque_refs.len != opaque_mats.len {
        >> errors.new("nexus modern: opaque mesh/world/material arrays length mismatch")
    }
    vp := proj.multiply(view)
    hdr_ref := $&mp.hdr

    hdr_ref.begin(device, clear_rgba) or >>
    for i in 0:opaque_refs.len {
        if use_gi {
            hdr_ref.draw_clustered_gi(device, &mp.clustered, irr, gi_strength, opaque_refs[i], opaque_worlds[i], view, vp, &opaque_mats[i]) or >>
        } else {
            hdr_ref.draw_clustered(device, &mp.clustered, opaque_refs[i], opaque_worlds[i], view, vp, &opaque_mats[i]) or >>
        }
    }
    hdr_ref.end() or >>

    if has_decals {
        _ := decals_ren.draw_into_hdr(device, hdr_ref, &mp.clustered, use_gi, irr, gi_strength, decals_queue, view, vp) or >>
    }
    if has_atmosphere {
        _ := atm_ren.apply_into_hdr(device, hdr_ref, &mp.clustered, eye, view, proj, atm_cfg) or >>
    }
    if has_transparent {
        _ := transparent.flush_into_hdr(device, hdr_ref, &mp.clustered, use_gi, irr, gi_strength, view, vp) or >>
    }
    if has_particles {
        particles.draw_into_hdr(device, hdr_ref, view, proj) or >>
    }

    device.begin(clear_rgba) or >>
    pp_ref := $&mp.pp
    hiz_ref := $&mp.hiz
    pp_ref.apply(device, hdr_ref, hiz_ref, view, proj, z_near, z_far, pp_cfg) or >>
    << opaque_refs.len
}

pub fn (mp $&ModernPipeline3D) render_clustered_hdr_frame(
    device $&ren.Device3D,
    opaque_refs &[]ren.MeshRef3D,
    opaque_worlds &[]fm.Mat4,
    opaque_mats &[]ren.Material3D,
    view fm.Mat4,
    proj fm.Mat4,
    z_near f64,
    z_far f64,
    clear_rgba int,
    pp_cfg &ren.PostProcessConfig3D
) int {
    if mp.closed || !mp.owner.matches(device) {
        >> errors.new("nexus modern: closed or foreign ModernPipeline3D")
    }
    if opaque_refs.len != opaque_worlds.len || opaque_refs.len != opaque_mats.len {
        >> errors.new("nexus modern: opaque mesh/world/material arrays length mismatch")
    }
    vp := proj.multiply(view)
    hdr_ref := $&mp.hdr
    hdr_ref.begin(device, clear_rgba) or >>
    for i in 0:opaque_refs.len {
        hdr_ref.draw_clustered(device, &mp.clustered, opaque_refs[i], opaque_worlds[i], view, vp, &opaque_mats[i]) or >>
    }
    hdr_ref.end() or >>
    device.begin(clear_rgba) or >>
    pp_ref := $&mp.pp
    hiz_ref := $&mp.hiz
    pp_ref.apply(device, hdr_ref, hiz_ref, view, proj, z_near, z_far, pp_cfg) or >>
    << opaque_refs.len
}

pub fn (mp $&ModernPipeline3D) update_ddgi(
    device &ren.Device3D,
    ddgi $&ren.DdgiVolume3D
) int {
    if mp.closed || !mp.owner.matches(device) {
        >> errors.new("nexus modern: closed or foreign ModernPipeline3D")
    }
    << ddgi.update(device, &mp.clustered) or >>
}

pub fn (mp $&ModernPipeline3D) render_unified_ddgi_frame(
    device $&ren.Device3D,
    opaque_refs &[]ren.MeshRef3D,
    opaque_worlds &[]fm.Mat4,
    opaque_mats &[]ren.Material3D,
    ddgi $&ren.DdgiVolume3D,
    update_ddgi bool,
    apply_chebyshev_pass bool,
    use_chebyshev bool,
    gi_strength f64,
    albedo_tint fm.Vec3,
    has_transparent bool,
    transparent &ren.TransparentQueue3D,
    has_particles bool,
    particles &ren.GpuParticleSystem3D,
    eye fm.Vec3,
    view fm.Mat4,
    proj fm.Mat4,
    z_near f64,
    z_far f64,
    clear_rgba int,
    pp_cfg &ren.PostProcessConfig3D
) int {
    if mp.closed || !mp.owner.matches(device) {
        >> errors.new("nexus modern: closed or foreign ModernPipeline3D")
    }
    if opaque_refs.len != opaque_worlds.len || opaque_refs.len != opaque_mats.len {
        >> errors.new("nexus modern: opaque mesh/world/material arrays length mismatch")
    }
    if update_ddgi {
        _ := ddgi.update(device, &mp.clustered) or >>
    }

    vp := proj.multiply(view)
    hdr_ref := $&mp.hdr

    hdr_ref.begin(device, clear_rgba) or >>
    for i in 0:opaque_refs.len {
        if apply_chebyshev_pass {
            hdr_ref.draw_clustered(device, &mp.clustered, opaque_refs[i], opaque_worlds[i], view, vp, &opaque_mats[i]) or >>
        } else {
            hdr_ref.draw_clustered_ddgi(device, &mp.clustered, ddgi, gi_strength, opaque_refs[i], opaque_worlds[i], view, vp, &opaque_mats[i]) or >>
        }
    }
    hdr_ref.end() or >>

    if apply_chebyshev_pass {
        ddgi.apply_into_hdr(device, hdr_ref, eye, view, proj, gi_strength, albedo_tint, use_chebyshev) or >>
    }
    if has_transparent {
        empty_irr := ren.irradiance_grid_3d(fm.vec3(0.0, 0.0, 0.0), fm.vec3(1.0, 1.0, 1.0), 1, 1, 1) or >>
        $tmp_irr := empty_irr.upload(device) or >>
        _ := transparent.flush_into_hdr(device, hdr_ref, &mp.clustered, false, &tmp_irr, gi_strength, view, vp) or >>
        tmp_irr.close() or >>
    }
    if has_particles {
        particles.draw_into_hdr(device, hdr_ref, view, proj) or >>
    }

    device.begin(clear_rgba) or >>
    pp_ref := $&mp.pp
    hiz_ref := $&mp.hiz
    pp_ref.apply(device, hdr_ref, hiz_ref, view, proj, z_near, z_far, pp_cfg) or >>
    << opaque_refs.len
}

pub struct MasterFrameOptions3D {
    pub has_terrain bool
    pub has_foliage bool
    pub has_ddgi bool
    pub update_ddgi bool
    pub apply_ddgi_chebyshev bool
    pub ddgi_use_chebyshev bool
    pub ddgi_albedo_tint fm.Vec3
    pub use_static_gi bool
    pub gi_strength f64
    pub has_decals bool
    pub has_atmosphere bool
    pub has_transparent bool
    pub has_particles bool
    pub clear_rgba int
}

pub fn default_master_frame_options_3d() MasterFrameOptions3D {
    << MasterFrameOptions3D{
        has_terrain: false,
        has_foliage: false,
        has_ddgi: false,
        update_ddgi: false,
        apply_ddgi_chebyshev: false,
        ddgi_use_chebyshev: true,
        ddgi_albedo_tint: fm.vec3(0.85, 0.85, 0.85),
        use_static_gi: false,
        gi_strength: 1.0,
        has_decals: false,
        has_atmosphere: false,
        has_transparent: false,
        has_particles: false,
        clear_rgba: 255
    }
}

pub struct MasterFrameStats3D {
    pub terrain_triangles int
    pub opaque_draws int
    pub decals_drawn int
    pub transparent_visible int
}

pub fn (mp $&ModernPipeline3D) render_master_world_frame(
    device $&ren.Device3D,
    terrain_ren &ren.TerrainRenderer3D,
    terrain_chunks &[]ren.MeshRef3D,
    terrain_worlds &[]fm.Mat4,
    terrain_mat &ren.TerrainMaterial3D,
    foliage &ren.GpuFoliageBatch3D,
    wind &ren.FoliageWindConfig3D,
    foliage_mat &ren.FoliageMaterial3D,
    opaque_refs &[]ren.MeshRef3D,
    opaque_worlds &[]fm.Mat4,
    opaque_mats &[]ren.Material3D,
    ddgi $&ren.DdgiVolume3D,
    static_irr &ren.IrradianceGpu3D,
    decals_ren &ren.DecalRenderer3D,
    decals_queue &ren.DecalQueue3D,
    atm_ren &ren.AtmosphereRenderer3D,
    atm_cfg &ren.AtmosphereConfig3D,
    transparent &ren.TransparentQueue3D,
    particles &ren.GpuParticleSystem3D,
    eye fm.Vec3,
    view fm.Mat4,
    proj fm.Mat4,
    z_near f64,
    z_far f64,
    pp_cfg &ren.PostProcessConfig3D,
    opts &MasterFrameOptions3D
) MasterFrameStats3D {
    if mp.closed || !mp.owner.matches(device) {
        >> errors.new("nexus modern: closed or foreign ModernPipeline3D")
    }
    if opaque_refs.len != opaque_worlds.len || opaque_refs.len != opaque_mats.len {
        >> errors.new("nexus modern: opaque mesh/world/material arrays length mismatch")
    }

    if opts.has_ddgi && opts.update_ddgi {
        _ := ddgi.update(device, &mp.clustered) or >>
    }

    vp := proj.multiply(view)
    hdr_ref := $&mp.hdr

    $terrain_tris := 0
    if opts.has_terrain {
        terrain_tris = terrain_ren.draw_chunks_into_hdr(
            device, hdr_ref, &mp.clustered, opts.use_static_gi, static_irr, opts.gi_strength,
            terrain_chunks, terrain_worlds, view, vp, terrain_mat, true, opts.clear_rgba
        ) or >>
    }

    if !opts.has_terrain || opaque_refs.len > 0 {
        if opts.has_terrain {
            hdr_ref.begin_overlay(device) or >>
        } else {
            hdr_ref.begin(device, opts.clear_rgba) or >>
        }
        for i in 0:opaque_refs.len {
            if opts.has_ddgi && !opts.apply_ddgi_chebyshev {
                hdr_ref.draw_clustered_ddgi(device, &mp.clustered, ddgi, opts.gi_strength, opaque_refs[i], opaque_worlds[i], view, vp, &opaque_mats[i]) or >>
            } else if opts.use_static_gi {
                hdr_ref.draw_clustered_gi(device, &mp.clustered, static_irr, opts.gi_strength, opaque_refs[i], opaque_worlds[i], view, vp, &opaque_mats[i]) or >>
            } else {
                hdr_ref.draw_clustered(device, &mp.clustered, opaque_refs[i], opaque_worlds[i], view, vp, &opaque_mats[i]) or >>
            }
        }
        hdr_ref.end() or >>
    }

    if opts.has_foliage {
        foliage.draw_into_hdr(
            device, hdr_ref, &mp.clustered, opts.use_static_gi, static_irr, opts.gi_strength,
            eye, view, vp, wind, foliage_mat
        ) or >>
    }

    if opts.has_ddgi && opts.apply_ddgi_chebyshev {
        ddgi.apply_into_hdr(
            device, hdr_ref, eye, view, proj,
            opts.gi_strength, opts.ddgi_albedo_tint, opts.ddgi_use_chebyshev
        ) or >>
    }

    $decals_drawn := 0
    if opts.has_decals {
        decals_drawn = decals_ren.draw_into_hdr(
            device, hdr_ref, &mp.clustered, opts.use_static_gi, static_irr, opts.gi_strength,
            decals_queue, view, vp
        ) or >>
    }

    if opts.has_atmosphere {
        _ := atm_ren.apply_into_hdr(device, hdr_ref, &mp.clustered, eye, view, proj, atm_cfg) or >>
    }

    $trans_vis := 0
    if opts.has_transparent {
        tstats := transparent.flush_into_hdr(
            device, hdr_ref, &mp.clustered, opts.use_static_gi, static_irr, opts.gi_strength, view, vp
        ) or >>
        trans_vis = tstats.visible
    }

    if opts.has_particles {
        particles.draw_into_hdr(device, hdr_ref, view, proj) or >>
    }

    device.begin(opts.clear_rgba) or >>
    pp_ref := $&mp.pp
    hiz_ref := $&mp.hiz
    pp_ref.apply(device, hdr_ref, hiz_ref, view, proj, z_near, z_far, pp_cfg) or >>

    << MasterFrameStats3D{
        terrain_triangles: terrain_tris,
        opaque_draws: opaque_refs.len,
        decals_drawn: decals_drawn,
        transparent_visible: trans_vis
    }
}

pub fn (mp $&ModernPipeline3D) close() int {
    if mp.closed { << 0 }
    pp := $&mp.pp
    pp.close() or >>
    hdr := $&mp.hdr
    hdr.close() or >>
    hiz := $&mp.hiz
    hiz.close() or >>
    cl := $&mp.clustered
    cl.close() or >>
    mp.closed = true
    << 0
}

fn (mp $&ModernPipeline3D) drop() {
    mp.close() or (err) { << }
}
