@"github.com/xulang-org/nexus/integration/rendering/three_d"

fm #"github.com/xulang-org/nexus/foundation/math"
nexus #"github.com/xulang-org/nexus/scene"
ren #"github.com/xulang-org/nexus/rendering/three_d"
#errors

pub fn (scene &Scene3D) draw_clustered(
    device $&ren.Device3D,
    clustered &ren.ClusteredRenderer3D,
    tree &nexus.SceneTree,
    view fm.Mat4,
    view_projection fm.Mat4
) SceneDraw3D {
    if !scene.owner.matches(device) { >> errors.new("nexus GPU: scene belongs to another device") }
    if !view.is_affine() || !view_projection.is_finite() { >> errors.new("nexus GPU: invalid clustered scene transforms") }
    order := tree.subtree(tree.root()) or >>
    $instances := 0
    $triangles := 0
    $culled_instances := 0
    $culled_triangles := 0
    $lod_instances := 0
    $lod_triangles_saved := 0
    default_mat := ren.material_3d(fm.vec3(1.0, 1.0, 1.0), 0.0, 0.8, fm.vec3(0.0, 0.0, 0.0)) or >>
    for node in order {
        if !scene.meshes.has(node) { -> }
        if !(tree.is_visible(node) or >>) { -> }
        mesh := scene.selected_mesh(node) or >>
        world := tree.global_transform_3d(node) or >>
        mvp := view_projection.multiply(world)
        if !(scene.owner.mesh_in_view(mesh, mvp) or >>) {
            culled_instances += 1
            culled_triangles += mesh.triangle_count()
            ->
        }
        $tris := 0
        if scene.materials.has(node) {
            tris = clustered.draw_material_reference(device, mesh, world, view, view_projection, &scene.materials[node]) or >>
        } else {
            tris = clustered.draw_material_reference(device, mesh, world, view, view_projection, &default_mat) or >>
        }
        instances = instances + 1
        triangles = triangles + tris
        if (scene.lod_level(node) or >>) > 0 {
            lod_instances += 1
            lod_triangles_saved += scene.meshes[node].triangle_count() - tris
        }
    }
    << SceneDraw3D{
        instances: instances,
        triangles: triangles,
        culled_instances: culled_instances,
        culled_triangles: culled_triangles,
        lod_instances: lod_instances,
        lod_triangles_saved: lod_triangles_saved
    }
}
