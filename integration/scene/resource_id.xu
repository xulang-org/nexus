@"github.com/xulang-org/nexus/integration/scene"

resource #"github.com/xulang-org/nexus/resources/scene"
#crypto/rand
#encoding/hex
#errors

pub fn new_resource_id() string {
    raw := rand.read(16) >>>
    uid := hex.encode_to_string(raw)
    if !resource.valid_resource_id(&uid) { >>> errors.new("nexus scene: invalid random resource identity") }
    << uid
}
