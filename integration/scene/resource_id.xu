@"github.com/xulang-org/game/integration/scene"

resource #"github.com/xulang-org/game/resources/scene"
#crypto/rand
#encoding/hex
#errors

pub fn new_resource_id() string {
    raw := rand.read(16) or >>
    uid := hex.encode_to_string(raw)
    if !resource.valid_resource_id(&uid) { >> errors.new("game scene: invalid random resource identity") }
    << uid
}
