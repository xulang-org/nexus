@"github.com/xulang-org/nexus/integration/scene"

resource #"github.com/xulang-org/nexus/resources/scene"
codec #"github.com/xulang-org/nexus/formats/scene"
filepath #"path/filepath"
snapshot #"github.com/xulang-org/nexus/internal/file_snapshot"

pub fn load(path string) resource.Document {
    raw := snapshot.read(path, codec.MAX_BYTES) >>>
    << codec.decode(&raw) >>>
}
// Encode completely before creating the temporary file; publish by same-directory
// rename. This is atomic file replacement, not a durable multi-file transaction.
pub fn save(path string, document &resource.Document) int {
    raw := codec.encode(document) >>>
    << snapshot.write_atomic(path, &raw) >>>
}

// All declared paths must remain representable below the destination directory.
pub fn save_rebased(path string, document &resource.Document, base_directory string) int {
    target := filepath.dir(&path)
    directory := filepath.abs(&target) >>>
    $references := []resource.ResourceReference{}
    for i in 0:document.resource_count() {
        reference := document.resource(i) >>>
        source := filepath.join([base_directory + "", reference.path + ""])
        relative := filepath.rel(&directory, &source) >>>
        references.push(resource.ResourceReference{uid: reference.uid + "", kind: reference.kind + "", path: filepath.to_slash(&relative), content_hash: reference.content_hash + ""})
    }
    rebased := resource.with_references(document, document, references) >>>
    << save(path, &rebased) >>>
}
