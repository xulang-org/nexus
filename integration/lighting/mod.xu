@"github.com/xulang-org/nexus/integration/lighting"

scene #"github.com/xulang-org/nexus/scene"
lights #"github.com/xulang-org/nexus/resources/lighting"
shadows #"github.com/xulang-org/nexus/resources/shadow"
#errors

// Bindings use full IDs scoped to the same SceneTree, like scene mesh/sprite
// bindings. They store CPU descriptions and never create renderer resources.
pub struct LightBinding3D {
    pub source lights.Light3D
    pub cascades shadows.CascadeProfile3D
    pub punctual shadows.PunctualProfile3D
}
pub struct ShadowSelection3D {
    pub source int
    pub cascades shadows.CascadeProfile3D
    pub punctual shadows.PunctualProfile3D
}
pub fn no_shadow_selection() ShadowSelection3D {
    << ShadowSelection3D{source: -1, cascades: shadows.CascadeProfile3D{}, punctual: shadows.PunctualProfile3D{}}
}
pub struct SceneLights3D { sources map[int]LightBinding3D }
pub fn new_scene_lights_3d() SceneLights3D { << SceneLights3D{sources: map[int]LightBinding3D{}} }
pub fn (world &SceneLights3D) binding_count() int { << world.sources.len() }
pub fn (world &SceneLights3D) has(node int) bool { << world.sources.has(node) }
// Return the local description, before any world transform or visibility test.
pub fn (world &SceneLights3D) binding(tree &scene.SceneTree, node int) LightBinding3D {
    info := tree.node_info(node) or >>
    if info.queued_free || !world.sources.has(node) { >> errors.new("nexus lights: no editable source binding") }
    << world.sources[node]
}
pub fn (world &SceneLights3D) source(tree &scene.SceneTree, node int) lights.Light3D {
    binding := world.binding(tree, node) or >>
    << binding.source
}
// Validate the complete batch before publishing any replacement. Undeclared
// bindings remain unchanged; callers detach explicitly when removing sources.
pub fn (world $&SceneLights3D) attach_bindings(tree &scene.SceneTree, nodes []int, bindings []LightBinding3D) int {
    if nodes.len!=bindings.len || nodes.len>scene.MAX_NODES { >> errors.new("nexus lights: invalid binding batch length") }
    $seen := map[int]bool{}
    $added := 0
    for i in 0:nodes.len {
        info := tree.node_info(nodes[i]) or >>
        if info.kind!=scene.NODE_3D || info.queued_free || seen.has(nodes[i]) { >> errors.new("nexus lights: batch requires unique editable Node3D IDs") }
        binding := bindings[i]
        shadows.validate_profiles(binding.source, binding.cascades, binding.punctual) or >>
        seen[nodes[i]]=true
        if !world.sources.has(nodes[i]) { added+=1 }
    }
    if added>scene.MAX_NODES-world.sources.len() { >> errors.new("nexus lights: scene binding capacity exceeded; prune retired nodes") }
    for i in 0:nodes.len { world.sources[nodes[i]]=bindings[i] }
    << nodes.len
}
// Source-only edits retain the profile when the light kind stays the same.
pub fn (world $&SceneLights3D) attach_batch(tree &scene.SceneTree, nodes []int, sources []lights.Light3D) int {
    if nodes.len != sources.len || nodes.len > scene.MAX_NODES { >> errors.new("nexus lights: invalid binding batch length") }
    $bindings := []LightBinding3D{}
    for i in 0:nodes.len {
        source := sources[i]
        $binding := LightBinding3D{source: source, cascades: shadows.CascadeProfile3D{}, punctual: shadows.PunctualProfile3D{}}
        if world.sources.has(nodes[i]) {
            previous := world.sources[nodes[i]]
            if source.kind() == previous.source.kind() {
                binding.cascades = previous.cascades
                binding.punctual = previous.punctual
            }
        }
        bindings.push(binding)
    }
    << world.attach_bindings(tree,nodes,bindings) or >>
}
pub fn (world $&SceneLights3D) attach(tree &scene.SceneTree, node int, source lights.Light3D) int {
    world.attach_batch(tree,[node],[source]) or >>
    << 0
}
pub fn (world $&SceneLights3D) detach(node int) int {
    if node<=0 { >> errors.new("nexus lights: invalid binding node") }
    if !world.sources.has(node) { << 0 }
    sources := $&world.sources
    sources.delete(node)
    << 1
}
// Stable scene pre-order. Hidden/queued/freed nodes emit no source; pausing nexus
// processing does not turn off rendered light. Invalid output is all-or-nothing.
pub fn (world &SceneLights3D) gather_with_shadows(tree &scene.SceneTree, selection $&ShadowSelection3D) []lights.Light3D {
    order := tree.subtree(tree.root()) or >>
    $result := []lights.Light3D{}
    $selected := no_shadow_selection()
    for node in order {
        if !world.sources.has(node) { -> }
        info := tree.node_info(node) or >>
        if info.queued_free || !(tree.is_visible(node) or >>) { -> }
        if result.len>=lights.MAX_SOURCES { >> errors.new("nexus lights: more than 256 visible candidate sources") }
        binding := world.sources[node]
        // The renderer accepts one shadow map per draw. Choose the first visible
        // configured light in the same order used for candidate indices.
        if selected.source < 0 && (binding.cascades.enabled() || binding.punctual.enabled()) {
            selected = ShadowSelection3D{source: result.len, cascades: binding.cascades, punctual: binding.punctual}
        }
        result.push(binding.source.transformed(tree.global_transform_3d(node) or >>) or >>)
    }
    selection.source = selected.source
    selection.cascades = selected.cascades
    selection.punctual = selected.punctual
    << result
}
pub fn (world &SceneLights3D) gather(tree &scene.SceneTree) []lights.Light3D {
    $selection := no_shadow_selection()
    << world.gather_with_shadows(tree, $&selection) or >>
}
pub fn (world $&SceneLights3D) prune(tree &scene.SceneTree) int {
    order := tree.subtree(tree.root()) or >>
    $next := map[int]LightBinding3D{}
    for node in order {
        if !world.sources.has(node) { -> }
        if !(tree.node_info(node) or >>).queued_free { next[node]=world.sources[node] }
    }
    removed := world.sources.len()-next.len()
    world.sources=next
    << removed
}
