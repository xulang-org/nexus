@"github.com/xulang-org/nexus/integration/terrain"

fm #"github.com/xulang-org/nexus/foundation/math"
phys #"github.com/xulang-org/nexus/physics3d"
ren #"github.com/xulang-org/nexus/rendering/three_d"
meshes #"github.com/xulang-org/nexus/resources/mesh"
terr #"github.com/xulang-org/nexus/resources/terrain"
#errors
#math

fn clamp_i(v int, lo int, hi int) int {
    if v < lo { << lo }
    if v > hi { << hi }
    << v
}

pub fn terrain_region_static_triangles(
    terrain &terr.HeightmapTerrain,
    start_x int,
    start_z int,
    cells_x int,
    cells_z int,
    lod int,
    layer int
) []phys.StaticTriangle3D {
    if lod < 0 || lod > terr.MAX_TERRAIN_LOD {
        >>> errors.new("nexus integration/terrain: physics triangle LOD must be in 0..4")
    }
    if cells_x < 1 || cells_z < 1 || start_x < 0 || start_z < 0 ||
        start_x + cells_x >= terrain.width || start_z + cells_z >= terrain.depth {
        >>> errors.new("nexus integration/terrain: region out of terrain bounds")
    }
    if layer <= 0 {
        >>> errors.new("nexus integration/terrain: physics collision layer must be > 0")
    }

    $step := 1
    for _ in 0:lod { step *= 2 }
    $tris := []phys.StaticTriangle3D{}
    $gz := start_z
    while gz < start_z + cells_z {
        $nz := gz + step
        if nz > start_z + cells_z { nz = start_z + cells_z }
        $gx := start_x
        while gx < start_x + cells_x {
            $nx := gx + step
            if nx > start_x + cells_x { nx = start_x + cells_x }

            v00 := terrain.vertex_position(gx, gz)
            v10 := terrain.vertex_position(nx, gz)
            v01 := terrain.vertex_position(gx, nz)
            v11 := terrain.vertex_position(nx, nz)

            if tris.len + 2 > phys.MAX_COLLIDERS {
                >>> errors.new("nexus integration/terrain: region exceeds physics3d.MAX_COLLIDERS (4096); use smaller region or higher LOD")
            }
            ta := phys.static_triangle_3d(v00, v01, v11, layer) >>>
            tb := phys.static_triangle_3d(v00, v11, v10, layer) >>>
            tris.push(ta)
            tris.push(tb)
            gx = nx
        }
        gz = nz
    }
    << tris
}

pub fn terrain_static_triangles_lod(terrain &terr.HeightmapTerrain, lod int, layer int) []phys.StaticTriangle3D {
    << terrain_region_static_triangles(terrain, 0, 0, terrain.width - 1, terrain.depth - 1, lod, layer) >>>
}

pub fn upload_foliage_placements(
    device &ren.Device3D,
    program &ren.FoliageProgram3D,
    mesh &meshes.MeshData3D,
    placements &[]terr.FoliagePlacement
) ren.GpuFoliageBatch3D {
    $instances := []ren.FoliageInstance3D{}
    for i in 0:placements.len {
        p := &placements[i]
        instances.push(ren.FoliageInstance3D{
            position: p.position,
            yaw: p.yaw,
            scale: p.scale,
            height_scale: p.height_scale,
            bend_phase: p.bend_phase,
            tint: p.tint,
            variation: p.variation
        })
    }
    << device.foliage_batch(program, mesh, &instances) >>>
}

pub struct TerrainDrawStats3D {
    pub total_chunks int
    pub drawn_chunks int
    pub frustum_culled_chunks int
    pub lod0_chunks int
    pub lod1_chunks int
    pub lod2_plus_chunks int
}

pub struct TerrainVisibleSelection3D {
    pub refs []ren.MeshRef3D
    pub worlds []fm.Mat4
    pub stats TerrainDrawStats3D
}

pub struct TerrainChunkedGpu3D {
    pub chunks_x int
    pub chunks_z int
    pub lod_levels int
    chunk_meshes []ren.Mesh3D
    chunk_bounds []fm.Aabb3
    splat_tex ren.Texture3D
    world fm.Mat4
    closed bool
}

fn aabb_in_frustum_rz(bounds fm.Aabb3, vp fm.Mat4) bool {
    bmin := bounds.minimum
    bmax := bounds.maximum
    $out_l := true
    $out_r := true
    $out_b := true
    $out_t := true
    $out_f := true
    $out_n := true
    $all_behind := true
    for corner in 0:8 {
        $px := bmin.x
        if (corner & 1) != 0 { px = bmax.x }
        $py := bmin.y
        if (corner & 2) != 0 { py = bmax.y }
        $pz := bmin.z
        if (corner & 4) != 0 { pz = bmax.z }
        c := vp.transform(fm.vec4(px, py, pz, 1.0))
        if c.x + c.w >= 0.0 { out_l = false }
        if -c.x + c.w >= 0.0 { out_r = false }
        if c.y + c.w >= 0.0 { out_b = false }
        if -c.y + c.w >= 0.0 { out_t = false }
        if c.z >= 0.0 { out_f = false }
        if c.w - c.z >= 0.0 { out_n = false }
        if c.w > 0.0 { all_behind = false }
    }
    << !(out_l || out_r || out_b || out_t || out_f || out_n || all_behind)
}

pub fn new_terrain_chunked_gpu_3d(
    device &ren.Device3D,
    terrain &terr.HeightmapTerrain,
    chunk_cells int,
    lod_levels int,
    skirt_depth f64,
    bake_splat_tint bool
) TerrainChunkedGpu3D {
    if lod_levels < 1 || lod_levels > terr.MAX_TERRAIN_LOD + 1 {
        >>> errors.new("nexus integration/terrain: lod_levels must be in 1..5")
    }
    dims := terrain.chunk_grid_dims(chunk_cells) >>>
    cx_count := dims[0]
    cz_count := dims[1]
    pixels := terrain.splat_rgba_pixels()
    splat_tex := device.texture_rgba(terrain.width, terrain.depth, &pixels, false, true, false) >>>

    $cmeshes := []ren.Mesh3D{}
    $cbounds := []fm.Aabb3{}
    for cz in 0:cz_count {
        sz := cz * chunk_cells
        rem_z := terrain.depth - 1 - sz
        cells_z := clamp_i(chunk_cells, 1, rem_z)
        for cx in 0:cx_count {
            sx := cx * chunk_cells
            rem_x := terrain.width - 1 - sx
            cells_x := clamp_i(chunk_cells, 1, rem_x)
            b := terrain.chunk_bounds(cx, cz, chunk_cells) >>>
            cbounds.push(b)
            for lod in 0:lod_levels {
                spec := terr.TerrainChunkSpec{
                    chunk_x: cx,
                    chunk_z: cz,
                    start_x: sx,
                    start_z: sz,
                    cells_x: cells_x,
                    cells_z: cells_z,
                    lod: lod,
                    skirt_depth: skirt_depth,
                    bake_splat_tint: bake_splat_tint
                }
                cpu_m := terrain.build_chunk_mesh(spec) >>>
                gpu_m := device.upload(&cpu_m) >>>
                cmeshes.push(gpu_m)
            }
        }
    }

    << TerrainChunkedGpu3D{
        chunks_x: cx_count,
        chunks_z: cz_count,
        lod_levels: lod_levels,
        chunk_meshes: cmeshes,
        chunk_bounds: cbounds,
        splat_tex: splat_tex,
        world: fm.identity_3d(),
        closed: false
    }
}

pub fn (tc &TerrainChunkedGpu3D) splat_texture_ref() ren.TextureRef3D {
    << tc.splat_tex.reference()
}

pub fn (tc &TerrainChunkedGpu3D) select_visible_chunks(
    camera_pos fm.Vec3,
    view_projection fm.Mat4,
    lod_distances &[]f64
) TerrainVisibleSelection3D {
    if tc.closed {
        >>> errors.new("nexus integration/terrain: TerrainChunkedGpu3D is closed")
    }
    total := tc.chunks_x * tc.chunks_z
    $refs := []ren.MeshRef3D{}
    $worlds := []fm.Mat4{}
    $culled := 0
    $lod0 := 0
    $lod1 := 0
    $lod2p := 0
    for idx in 0:total {
        b := tc.chunk_bounds[idx]
        if !aabb_in_frustum_rz(b, view_projection) {
            culled += 1
            ->
        }
        $lod := terr.select_chunk_lod(b, camera_pos, lod_distances)
        if lod >= tc.lod_levels { lod = tc.lod_levels - 1 }
        if lod == 0 {
            lod0 += 1
        } else if lod == 1 {
            lod1 += 1
        } else {
            lod2p += 1
        }
        mesh_idx := idx * tc.lod_levels + lod
        mref := tc.chunk_meshes[mesh_idx].reference()
        refs.push(mref)
        worlds.push(tc.world)
    }
    drawn := refs.len
    << TerrainVisibleSelection3D{
        refs: refs,
        worlds: worlds,
        stats: TerrainDrawStats3D{
            total_chunks: total,
            drawn_chunks: drawn,
            frustum_culled_chunks: culled,
            lod0_chunks: lod0,
            lod1_chunks: lod1,
            lod2_plus_chunks: lod2p
        }
    }
}

pub fn (tc &TerrainChunkedGpu3D) draw_into_hdr(
    device &ren.Device3D,
    hdr $&ren.HdrTarget3D,
    clustered &ren.ClusteredRenderer3D,
    tr &ren.TerrainRenderer3D,
    use_gi bool,
    irr &ren.IrradianceGpu3D,
    gi_strength f64,
    camera_pos fm.Vec3,
    view fm.Mat4,
    view_projection fm.Mat4,
    lod_distances &[]f64,
    mat &ren.TerrainMaterial3D,
    clear_hdr bool,
    clear_rgba int
) TerrainDrawStats3D {
    sel := tc.select_visible_chunks(camera_pos, view_projection, lod_distances) >>>
    _ := tr.draw_chunks_into_hdr(
        device, hdr, clustered, use_gi, irr, gi_strength,
        &sel.refs, &sel.worlds, view, view_projection, mat, clear_hdr, clear_rgba
    ) >>>
    << sel.stats
}

pub fn (tc $&TerrainChunkedGpu3D) close() int {
    if tc.closed { << 0 }
    for i in 0:tc.chunk_meshes.len {
        m := $&tc.chunk_meshes[i]
        m.close() >>>
    }
    st := $&tc.splat_tex
    st.close() >>>
    tc.chunk_meshes = []ren.Mesh3D{}
    tc.chunk_bounds = []fm.Aabb3{}
    tc.closed = true
    << 0
}

fn (tc $&TerrainChunkedGpu3D) drop() {
    tc.close() >>> (err) { << }
}
