@"github.com/xulang-org/nexus/integration/scene_render"

fm #"github.com/xulang-org/nexus/foundation/math"
gltf #"github.com/xulang-org/nexus/formats/gltf"
scene_data #"github.com/xulang-org/nexus/resources/scene"
scene_files #"github.com/xulang-org/nexus/integration/scene"
renderer #"github.com/xulang-org/nexus/integration/rendering/three_d"
nexus #"github.com/xulang-org/nexus/scene"
#math
#errors

struct PickMesh {
    points []fm.Vec3
    indices []int
    bounds fm.Aabb3
    double_sided bool
}
struct PickModel { meshes []PickMesh }
struct PickLevel { model int
    primitive int }
struct PickSurface {
    node int
    levels []PickLevel
    double_sided bool
}
pub struct ScenePicker3D {
    models []PickModel
    surfaces []PickSurface
}
pub struct ScenePick3D {
    pub node int
    pub distance f64
}

fn lower(a fm.Vec3, b fm.Vec3) fm.Vec3 {
    << fm.vec3(math.min(a.x, b.x), math.min(a.y, b.y), math.min(a.z, b.z))
}
fn upper(a fm.Vec3, b fm.Vec3) fm.Vec3 {
    << fm.vec3(math.max(a.x, b.x), math.max(a.y, b.y), math.max(a.z, b.z))
}
fn pick_model(source &gltf.GlbGeometry) PickModel {
    $meshes := []PickMesh{}
    for i in 0:source.primitive_count() {
        initial := source.position(i, 0) or >>
        $low := initial
        $high := initial
        $points := []fm.Vec3{}
        vertices := source.vertex_count(i) or >>
        for j in 0:vertices {
            point := source.position(i, j) or >>
            low = lower(low, point)
            high = upper(high, point)
            points.push(point)
        }
        $indices := []int{}
        count := source.index_count(i) or >>
        for j in 0:count { indices.push(source.index(i, j) or >>) }
        material := source.primitive_material(i) or >>
        $two_sided := false
        if material >= 0 { two_sided = (source.material(material) or >>).double_sided }
        meshes.push(PickMesh{points: points, indices: indices, bounds: fm.aabb3(low, high) or >>, double_sided: two_sided})
    }
    << PickModel{meshes: meshes}
}

// Designed for a restored scene whose topology and surface attachments stay
// fixed while editing transforms/visibility. Geometry is shared by source hash.
fn prepare_picker(document &scene_data.Document, directory string, tree &nexus.SceneTree, root int) ScenePicker3D {
    nodes := scene_files.matching_nodes(document, tree, root) or >>
    $models := []PickModel{}
    $by_hash := map[string]int{}
    $by_uid := map[string]int{}
    $consumed := 0
    for i in 0:document.resource_count() {
        source := document.resource(i) or >>
        if source.kind != "glb_model" { -> }
        raw := read_glb_source(&source, directory + "", consumed) or >>
        consumed += raw.len
        hash := source.content_hash + ""
        if !by_hash.has(hash + "") {
            asset := gltf.decode_glb_geometry(&raw) or >>
            by_hash[hash + ""] = models.len
            models.push(pick_model(&asset) or >>)
        }
        by_uid[source.uid + ""] = by_hash[hash]
    }
    $surfaces := []PickSurface{}
    for i in 0:document.surface_count() {
        entry := document.surface(i) or >>
        slot := by_uid[entry.resource_uid + ""]
        if entry.primitive >= models[slot].meshes.len { >> errors.new("nexus scene: picker primitive outside GLB") }
        material := models[slot].meshes[entry.primitive].double_sided
        $levels := [PickLevel{model: slot, primitive: entry.primitive}]
        for level in entry.levels {
            level_slot := by_uid[level.resource_uid + ""]
            if level.primitive >= models[level_slot].meshes.len { >> errors.new("nexus scene: picker LOD outside GLB") }
            levels.push(PickLevel{model: level_slot, primitive: level.primitive})
        }
        surfaces.push(PickSurface{node: nodes[entry.node], levels: levels, double_sided: material})
    }
    << ScenePicker3D{models: models, surfaces: surfaces}
}

pub fn (set &SceneModels3D) picker(tree &nexus.SceneTree, root int) ScenePicker3D {
    if set.closed { >> errors.new("nexus scene: closed model set") }
    << prepare_picker(&set.document, set.base_directory + "", tree, root) or >>
}

struct Interval { lower f64
    upper f64 }
fn clip_pick_axis(origin f64, delta f64, low f64, high f64, range Interval) Interval {
    if delta == 0.0 {
        if origin < low || origin > high { << Interval{lower: 1.0, upper: 0.0} }
        << range
    }
    a := (low - origin) / delta
    b := (high - origin) / delta
    << Interval{lower: math.max(math.min(a, b), range.lower), upper: math.min(math.max(a, b), range.upper)}
}
fn reaches_bounds(origin fm.Vec3, direction fm.Vec3, bounds fm.Aabb3, near f64, far f64) bool {
    low := bounds.minimum
    high := bounds.maximum
    x := clip_pick_axis(origin.x, direction.x, low.x, high.x, Interval{lower: near, upper: far})
    if x.lower > x.upper { << false }
    y := clip_pick_axis(origin.y, direction.y, low.y, high.y, x)
    if y.lower > y.upper { << false }
    z := clip_pick_axis(origin.z, direction.z, low.z, high.z, y)
    << z.lower <= z.upper
}
fn triangle_pick(origin fm.Vec3, direction fm.Vec3, a fm.Vec3, b fm.Vec3, c fm.Vec3, two_sided bool) f64 {
    ab := b.sub(a)
    ac := c.sub(a)
    cross := direction.cross(ac)
    det := ab.dot(cross)
    limit := (ab.length() * ac.length() * direction.length()) * 0.000000000001
    if math.abs(det) <= limit || (!two_sided && det <= 0.0) { << -1.0 }
    from := origin.sub(a)
    u := from.dot(cross) / det
    if u < -0.000000000001 || u > 1.000000000001 { << -1.0 }
    normal_side := from.cross(ab)
    v := direction.dot(normal_side) / det
    if v < -0.000000000001 || u + v > 1.000000000001 { << -1.0 }
    << ac.dot(normal_side) / det
}
fn mesh_pick(mesh &PickMesh, origin fm.Vec3, direction fm.Vec3, limits Interval, two_sided bool) f64 {
    if !reaches_bounds(origin, direction, mesh.bounds, limits.lower, limits.upper) { << -1.0 }
    $best := -1.0
    for i in 0:mesh.indices.len / 3 {
        start := i * 3
        a := mesh.points[mesh.indices[start]]
        b := mesh.points[mesh.indices[start + 1]]
        c := mesh.points[mesh.indices[start + 2]]
        hit := triangle_pick(origin, direction, a, b, c, two_sided)
        if hit >= limits.lower && hit <= limits.upper && (best < 0.0 || hit < best) { best = hit }
    }
    << best
}

// Distances remain in world units after transforming the ray into each mesh.
// The caller selects Scene3D LOD for the current camera before using this query.
pub fn (picker &ScenePicker3D) pick(scene &renderer.Scene3D, tree &nexus.SceneTree,
    origin fm.Vec3, direction fm.Vec3, near f64, far f64) ScenePick3D {
    if !origin.is_finite() || !fm.finite(near) || !fm.finite(far) || near < 0.0 || far <= near {
        >> errors.new("nexus scene: invalid pick ray range")
    }
    unit := direction.normalized() or >>
    $best := ScenePick3D{node: 0, distance: far}
    for surface in picker.surfaces {
        if !(tree.is_visible(surface.node) or >>) { -> }
        $level := 0
        if surface.levels.len > 1 { level = scene.lod_level(surface.node) or >> }
        if level < 0 || level >= surface.levels.len { >> errors.new("nexus scene: select LOD before picking") }
        binding := surface.levels[level]
        slot := binding.model
        primitive := binding.primitive
        model := &picker.models[slot]
        mesh := &model.meshes[primitive]
        transform := tree.global_transform_3d(surface.node) or >>
        inverse := transform.affine_inverse() or (err) { -> }
        local_origin := inverse.transform(fm.vec4(origin.x, origin.y, origin.z, 1.0)).xyz()
        local_ray := inverse.transform(fm.vec4(unit.x, unit.y, unit.z, 0.0)).xyz()
        hit := mesh_pick(mesh, local_origin, local_ray, Interval{lower: near, upper: best.distance}, surface.double_sided)
        if hit >= near && (best.node == 0 || hit < best.distance) { best = ScenePick3D{node: surface.node, distance: hit} }
    }
    << best
}

pub fn (picker &ScenePicker3D) visible_bounds(tree &nexus.SceneTree, node int) fm.Aabb3 {
    $selection := []int{}
    if node != 0 { selection.push(node) }
    << picker.visible_selection_bounds(tree, &selection) or >>
}

pub fn (picker &ScenePicker3D) visible_selection_bounds(tree &nexus.SceneTree, selection &[]int) fm.Aabb3 {
    $selected := map[int]bool{}
    for node in selection { selected[node] = true }
    $low := fm.vec3(0.0, 0.0, 0.0)
    $high := low
    $found := false
    for surface in picker.surfaces {
        if (selection.len > 0 && !selected.has(surface.node)) || !(tree.is_visible(surface.node) or >>) { -> }
        binding := surface.levels[0]
        bounds := picker.models[binding.model].meshes[binding.primitive].bounds
        world := tree.global_transform_3d(surface.node) or >>
        for x in [bounds.minimum.x, bounds.maximum.x] {
            for y in [bounds.minimum.y, bounds.maximum.y] {
                for z in [bounds.minimum.z, bounds.maximum.z] {
                    at := world.transform(fm.vec4(x, y, z, 1.0)).xyz()
                    if !found { low = at
                        high = at
                        found = true }
                    low = lower(low, at)
                    high = upper(high, at)
                }
            }
        }
    }
    << fm.aabb3(low, high) or >>
}
