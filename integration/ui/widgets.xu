@"github.com/xulang-org/nexus/integration/ui"

fm #"github.com/xulang-org/nexus/foundation/math"
#ui/draw
#ui/layout
widgets #ui/widgets
font #ui/font
#math

fn scaled_font_size(styles &widgets.Styles, c &widgets.ControlStyle) f64 {
    $fsize := c.font.size
    if c.inherit_font { fsize = styles.font.size }
    << math.max(4.0, fsize * styles.text_scale * styles.density)
}

// Renders a #ui/widgets ControlStyle box (background, border, and inward focus ring).
pub fn (frame $&UiFrame) style_box(bounds &layout.Rect, style &widgets.ControlStyle, state int) int {
    recording(frame) >>>
    if bounds.width <= 0.0 || bounds.height <= 0.0 { << 0 }
    d := frame.styles.density
    rp := style.resolve(state)
    radius := math.max(0.0, math.min(style.radius * d, math.min(bounds.width, bounds.height) * 0.5))
    frame.record_sdf_rect(fm.rect2(bounds.x, bounds.y, bounds.width, bounds.height),
        radius, rp.background.value(), style.border_width * d, rp.border.value()) >>>
    if (state & widgets.STATE_FOCUSED) != 0 && (state & widgets.STATE_DISABLED) == 0 && style.focus_width > 0.0 {
        fi := style.focus_inset * d
        fw := math.max(0.0, bounds.width - 2.0 * fi)
        fh := math.max(0.0, bounds.height - 2.0 * fi)
        if fw > 0.0 && fh > 0.0 {
            frame.record_sdf_rect(fm.rect2(bounds.x + fi, bounds.y + fi, fw, fh),
                math.max(0.0, radius - fi), 0, style.focus_width * d, rp.focus.value()) >>>
        }
    }
    << 0
}

fn draw_beside_indicator(frame $&UiFrame, bounds &layout.Rect, c &widgets.ControlStyle,
    ind_w f64, ind_h f64, caption &string, text_color draw.Color) fm.Vec2 {
    d := frame.styles.density
    left := c.padding.left * d
    top := c.padding.top * d
    avail_w := math.max(0.0, bounds.width - left - c.padding.right * d)
    avail_h := math.max(0.0, bounds.height - top - c.padding.bottom * d)
    if caption.len == 0 {
        ox := bounds.x + left + (avail_w - ind_w) * c.align_x
        oy := bounds.y + top + (avail_h - ind_h) * c.align_y
        << fm.vec2(ox, oy)
    }
    $gap := c.gap * d
    if ind_w <= 0.0 { gap = 0.0 }
    fsize := scaled_font_size(&frame.styles, c)
    ly := frame.measure_text(caption, fsize) >>>
    text_w := ly.metrics.width
    text_h := ly.metrics.height
    $content_w := ind_w + gap + text_w
    $content_h := math.max(ind_h, text_h)
    if c.icon_placement == widgets.ICON_ABOVE || c.icon_placement == widgets.ICON_BELOW {
        content_w = math.max(ind_w, text_w)
        content_h = ind_h + gap + text_h
    }
    ox := bounds.x + left + (avail_w - content_w) * c.align_x
    oy := bounds.y + top + (avail_h - content_h) * c.align_y
    $ix := ox
    $iy := oy + (content_h - ind_h) * 0.5
    $tx := ox + ind_w + gap
    $ty := oy + (content_h - text_h) * 0.5
    if c.icon_placement == widgets.ICON_TRAILING {
        tx = ox
        ix = ox + text_w + gap
    } else if c.icon_placement == widgets.ICON_ABOVE {
        ix = ox + (content_w - ind_w) * c.align_x
        iy = oy
        tx = ox + (content_w - text_w) * c.align_x
        ty = oy + ind_h + gap
    } else if c.icon_placement == widgets.ICON_BELOW {
        tx = ox + (content_w - text_w) * c.align_x
        ty = oy
        ix = ox + (content_w - ind_w) * c.align_x
        iy = oy + text_h + gap
    }
    frame.record_text_layout(ly, fm.vec2(tx, ty), text_color) >>>
    << fm.vec2(ix, iy)
}

pub fn (frame $&UiFrame) button(btn &widgets.Button, caption &string) int {
    b := btn.bounds()
    c := btn.style_or(&frame.styles)
    state := btn.visual_state()
    frame.style_box(&b, &c, state) >>>
    if caption.len == 0 { << 0 }
    d := frame.styles.density
    left := c.padding.left * d
    top := c.padding.top * d
    inner := layout.Rect{
        x: b.x + left,
        y: b.y + top,
        width: math.max(0.0, b.width - left - c.padding.right * d),
        height: math.max(0.0, b.height - top - c.padding.bottom * d)
    }
    rp := c.resolve(state)
    fsize := scaled_font_size(&frame.styles, &c)
    << frame.draw_label(&inner, caption, rp.foreground, fsize, c.align_x, c.align_y) >>>
}

pub fn (frame $&UiFrame) switch_control(sw &widgets.Switch, caption &string) int {
    b := sw.bounds()
    c := sw.style_or(&frame.styles)
    state := sw.visual_state()
    rp := c.resolve(state)
    d := frame.styles.density
    avail_h := math.max(0.0, b.height - (c.padding.top + c.padding.bottom) * d)
    avail_w := math.max(0.0, b.width - (c.padding.left + c.padding.right) * d)
    track_h := math.max(8.0, math.min(c.indicator_size * d, avail_h))
    track_w := math.max(track_h, math.min(track_h * 1.8, avail_w))
    $text_style := c.clone()
    text_style.palette.on_accent = c.palette.foreground
    ind_pos := draw_beside_indicator(frame, &b, &c, track_w, track_h, caption,
        text_style.resolve(state).foreground) >>>
    track_rect := layout.Rect{x: ind_pos.x, y: ind_pos.y, width: track_w, height: track_h}
    frame.style_box(&track_rect, &c, state) >>>
    $pos := 0.0
    if sw.value() { pos = 1.0 }
    inset := math.max(2.0, c.mark_width * d)
    thumb_d := math.max(4.0, track_h - inset * 2.0)
    thumb_r := thumb_d * 0.5
    thumb_cx := ind_pos.x + inset + thumb_r + math.max(0.0, track_w - inset * 2.0 - thumb_d) * pos
    thumb_cy := ind_pos.y + track_h * 0.5
    << frame.record_sdf_circle(fm.vec2(thumb_cx, thumb_cy), thumb_r, rp.foreground.value(), 0.0, 0) >>>
}

pub fn (frame $&UiFrame) checkbox(cb &widgets.Checkbox, caption &string) int {
    b := cb.bounds()
    c := cb.style_or(&frame.styles)
    state := cb.visual_state()
    rp := c.resolve(state)
    d := frame.styles.density
    avail_w := math.max(0.0, b.width - (c.padding.left + c.padding.right) * d)
    avail_h := math.max(0.0, b.height - (c.padding.top + c.padding.bottom) * d)
    side := math.max(8.0, math.min(c.indicator_size * d, math.min(avail_w, avail_h)))
    $text_style := c.clone()
    text_style.palette.on_accent = c.palette.foreground
    ind_pos := draw_beside_indicator(frame, &b, &c, side, side, caption,
        text_style.resolve(state).foreground) >>>
    box_rect := layout.Rect{x: ind_pos.x, y: ind_pos.y, width: side, height: side}
    frame.style_box(&box_rect, &c, state) >>>
    if cb.is_indeterminate() {
        bw := math.max(2.0, side * 0.56)
        bh := math.max(2.0, c.mark_width * d)
        bx := ind_pos.x + (side - bw) * 0.5
        by := ind_pos.y + (side - bh) * 0.5
        frame.record_sdf_rect(fm.rect2(bx, by, bw, bh), bh * 0.5, rp.foreground.value(), 0.0, 0) >>>
    } else if cb.value() {
        pad := math.max(2.0, side * 0.25)
        inner := math.max(2.0, side - pad * 2.0)
        frame.record_sdf_rect(fm.rect2(ind_pos.x + pad, ind_pos.y + pad, inner, inner),
            math.min(2.0 * d, inner * 0.35), rp.foreground.value(), 0.0, 0) >>>
    }
    << 0
}

pub fn (frame $&UiFrame) radio(rd &widgets.Radio, caption &string) int {
    b := rd.bounds()
    c := rd.style_or(&frame.styles)
    state := rd.visual_state()
    rp := c.resolve(state)
    d := frame.styles.density
    avail_w := math.max(0.0, b.width - (c.padding.left + c.padding.right) * d)
    avail_h := math.max(0.0, b.height - (c.padding.top + c.padding.bottom) * d)
    side := math.max(8.0, math.min(c.indicator_size * d, math.min(avail_w, avail_h)))
    $text_style := c.clone()
    text_style.palette.on_accent = c.palette.foreground
    ind_pos := draw_beside_indicator(frame, &b, &c, side, side, caption,
        text_style.resolve(state).foreground) >>>
    circle_rect := layout.Rect{x: ind_pos.x, y: ind_pos.y, width: side, height: side}
    frame.style_box(&circle_rect, &c, state) >>>
    if rd.value() {
        dot_r := math.max(1.5, side * 0.22)
        frame.record_sdf_circle(fm.vec2(ind_pos.x + side * 0.5, ind_pos.y + side * 0.5),
            dot_r, rp.foreground.value(), 0.0, 0) >>>
    }
    << 0
}

pub fn (frame $&UiFrame) slider(sli &widgets.Slider) int {
    b := sli.bounds()
    if b.width <= 0.0 || b.height <= 0.0 { << 0 }
    c := sli.style_or(&frame.styles)
    state := sli.visual_state()
    rp := c.resolve(state)
    d := frame.styles.density
    left := c.padding.left * d
    top := c.padding.top * d
    inner_w := math.max(0.0, b.width - left - c.padding.right * d)
    inner_h := math.max(0.0, b.height - top - c.padding.bottom * d)
    thumb := math.max(4.0, math.min(c.indicator_size * d, math.min(inner_w, inner_h)))
    track_h := math.max(4.0, math.min(c.mark_width * d, inner_h))
    track_y := b.y + top + (inner_h - track_h) * 0.5
    track_x := b.x + left
    track_r := math.min(c.radius * d, track_h * 0.5)
    frame.record_sdf_rect(fm.rect2(track_x, track_y, inner_w, track_h), track_r,
        rp.background.value(), c.border_width * d, rp.border.value()) >>>
    usable := math.max(0.0, inner_w - thumb)
    cx := track_x + thumb * 0.5 + usable * sli.ratio()
    $fill_col := c.palette.accent.value()
    if sli.is_invalid() { fill_col = c.palette.invalid.value() }
    if !sli.is_enabled() { fill_col = c.palette.muted.value() }
    fill_w := math.max(0.0, cx - track_x)
    if fill_w > 0.0 {
        frame.record_sdf_rect(fm.rect2(track_x, track_y, fill_w, track_h), track_r,
            fill_col, 0.0, 0) >>>
    }
    knob_y := b.y + top + inner_h * 0.5
    frame.record_sdf_circle(fm.vec2(cx, knob_y), thumb * 0.5,
        c.palette.foreground.value(), 1.5 * d, fill_col) >>>
    if sli.is_focused() && sli.is_enabled() && c.focus_width > 0.0 {
        fi := c.focus_inset * d
        fw := math.max(0.0, b.width - 2.0 * fi)
        fh := math.max(0.0, b.height - 2.0 * fi)
        if fw > 0.0 && fh > 0.0 {
            frame.record_sdf_rect(fm.rect2(b.x + fi, b.y + fi, fw, fh),
                math.max(0.0, track_r), 0, c.focus_width * d, rp.focus.value()) >>>
        }
    }
    << 0
}

pub fn (frame $&UiFrame) progress(pr &widgets.Progress) int {
    b := pr.bounds()
    if b.width <= 0.0 || b.height <= 0.0 { << 0 }
    c := pr.style_or(&frame.styles)
    state := pr.visual_state()
    rp := c.resolve(state)
    d := frame.styles.density
    radius := math.max(0.0, math.min(c.radius * d, math.min(b.width, b.height) * 0.5))
    frame.record_sdf_rect(fm.rect2(b.x, b.y, b.width, b.height), radius,
        rp.background.value(), c.border_width * d, rp.border.value()) >>>
    fill_w := math.max(0.0, b.width * pr.value())
    if fill_w > 0.0 {
        $fill_col := c.palette.accent.value()
        if pr.is_invalid() { fill_col = c.palette.invalid.value() }
        if !pr.is_enabled() { fill_col = c.palette.muted.value() }
        frame.record_sdf_rect(fm.rect2(b.x, b.y, fill_w, b.height),
            math.min(radius, fill_w * 0.5), fill_col, 0.0, 0) >>>
    }
    << 0
}

pub fn (frame $&UiFrame) modal_backdrop(viewport &layout.Rect, m &widgets.Modal) int {
    recording(frame) >>>
    if !m.is_visible() { << 0 }
    scrim := frame.styles.overlay_scrim()
    alpha := int(f64(scrim.value() & 255) * m.opacity())
    frame.record_sdf_rect(fm.rect2(viewport.x, viewport.y, viewport.width, viewport.height),
        0.0, scrim.with_alpha(alpha).value(), 0.0, 0) >>>
    panel := m.bounds()
    panel_style := frame.styles.overlay_style()
    frame.style_box(&panel, &panel_style, 0) >>>
    cb := m.close_bounds()
    close_txt := "x"
    << frame.draw_label(&cb, &close_txt, panel_style.palette.foreground,
        math.max(10.0, cb.height * 0.65), 0.5, 0.5) >>>
}

// Draws a horizontal or vertical widgets.Divider rule using its resolved border tone.
pub fn (frame $&UiFrame) divider(div &widgets.Divider) int {
    recording(frame) >>>
    b := div.bounds()
    c := div.style_or(&frame.styles)
    rp := c.resolve(div.visual_state())
    d := math.max(frame.styles.density, 0.5)
    thick := math.max(1.0, c.border_width * d)
    if div.axis() == widgets.AXIS_HORIZONTAL {
        y := b.y + (b.height - thick) * 0.5
        << frame.record_sdf_rect(fm.rect2(b.x, y, b.width, thick), 0.0, rp.border.value(), 0.0, 0) >>>
    }
    x := b.x + (b.width - thick) * 0.5
    << frame.record_sdf_rect(fm.rect2(x, b.y, thick, b.height), 0.0, rp.border.value(), 0.0, 0) >>>
}

fn inset_scaled(bounds &layout.Rect, padding &layout.Insets, d f64) layout.Rect {
    l := padding.left * d
    t := padding.top * d
    r := padding.right * d
    b := padding.bottom * d
    << layout.Rect{
        x: bounds.x + l,
        y: bounds.y + t,
        width: math.max(0.0, bounds.width - l - r),
        height: math.max(0.0, bounds.height - t - b)
    }
}

// Draws a widgets.Badge pill and optional centered caption.
pub fn (frame $&UiFrame) badge(bg &widgets.Badge, label &string) int {
    recording(frame) >>>
    b := bg.bounds()
    c := bg.style_or(&frame.styles)
    state := bg.visual_state()
    frame.style_box(&b, &c, state) >>>
    if label.len > 0 {
        rp := c.resolve(state)
        fsize := scaled_font_size(&frame.styles, &c)
        d := math.max(frame.styles.density, 0.5)
        inner := inset_scaled(&b, &c.padding, d)
        frame.draw_label(&inner, label, rp.foreground, fsize, 0.5, 0.5) >>>
    }
    << 0
}

// Draws a widgets.Card container with optional header caption and divider rule.
pub fn (frame $&UiFrame) card(cd &widgets.Card, title &string) int {
    recording(frame) >>>
    b := cd.bounds()
    c := cd.style_or(&frame.styles)
    state := cd.visual_state()
    frame.style_box(&b, &c, state) >>>
    if title.len > 0 {
        rp := c.resolve(state)
        inner := cd.content_bounds(&frame.styles)
        fsize := scaled_font_size(&frame.styles, &c)
        head_h := math.min(inner.height, math.max(fsize * 1.35, 16.0))
        head := layout.Rect{x: inner.x, y: inner.y, width: inner.width, height: head_h}
        frame.draw_label(&head, title, rp.foreground, fsize, c.align_x, 0.5) >>>
        d := math.max(frame.styles.density, 0.5)
        sep_y := inner.y + head_h + c.gap * d * 0.35
        if sep_y + 1.0 < inner.y + inner.height && c.border_width > 0.0 {
            frame.record_sdf_rect(fm.rect2(inner.x, sep_y, inner.width, math.max(1.0, c.border_width * d)),
                0.0, rp.border.value(), 0.0, 0) >>>
        }
    }
    << 0
}
