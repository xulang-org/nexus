@"github.com/xulang-org/nexus/integration/ui"

#errors
#math
#ui
#ui/draw
#ui/font
#ui/layout
#ui/widgets
fm #"github.com/xulang-org/nexus/foundation/math"

fn clamp_unit(v f64) f64 {
    if v < 0.0 { << 0.0 }
    if v > 1.0 { << 1.0 }
    << v
}

// Computes the drawable HUD rect after applying `insets` (notch/status/nav safe area).
pub fn safe_viewport(width f64, height f64, insets &layout.Insets) layout.Rect {
    if math.is_nan(width) || math.is_inf(width) || width < 0.0 ||
       math.is_nan(height) || math.is_inf(height) || height < 0.0 {
        >>> errors.new("integration/ui: invalid viewport size")
    }
    insets.validate() >>>
    << layout.Rect{
        x: insets.left,
        y: insets.top,
        width: math.max(0.0, width - insets.left - insets.right),
        height: math.max(0.0, height - insets.top - insets.bottom)
    }
}

// Anchors a box of `size` inside `safe` using normalized alignment `0..1` and margins.
pub fn anchor_rect(safe &layout.Rect, size &layout.Size,
        align_x f64, align_y f64, margin_x f64, margin_y f64) layout.Rect {
    clean_safe := layout.intersect(safe, safe) >>>
    if math.is_nan(size.width) || math.is_inf(size.width) || size.width < 0.0 ||
       math.is_nan(size.height) || math.is_inf(size.height) || size.height < 0.0 {
        >>> errors.new("integration/ui: invalid anchor size")
    }
    inner_w := math.max(0.0, clean_safe.width - margin_x * 2.0)
    inner_h := math.max(0.0, clean_safe.height - margin_y * 2.0)
    ax := clean_safe.x + margin_x + (inner_w - size.width) * clamp_unit(align_x)
    ay := clean_safe.y + margin_y + (inner_h - size.height) * clamp_unit(align_y)
    << layout.Rect{x: ax, y: ay, width: size.width, height: size.height}
}

// Interactive pure-Xu HUD text input state backed by `#ui/font` shaping and `UiFrame`.
pub struct UiTextField {
    pub id int
    pub bounds layout.Rect
    pub text string
    pub placeholder string
    pub caret int
    pub focused bool
    pub hovered bool
    pub enabled bool
    pub submitted bool
    pub max_bytes int
}

pub fn new_text_field(id int, bounds &layout.Rect, initial string, placeholder string) UiTextField {
    clean := layout.intersect(bounds, bounds) >>>
    << UiTextField{
        id: id,
        bounds: clean,
        text: initial + "",
        placeholder: placeholder + "",
        caret: initial.len,
        focused: false,
        hovered: false,
        enabled: true,
        submitted: false,
        max_bytes: 0
    }
}

pub fn (tf $&UiTextField) set_bounds(bounds &layout.Rect) int {
    clean := layout.intersect(bounds, bounds) >>>
    tf.bounds = clean
    << 0
}

pub fn (tf $&UiTextField) set_focus(focused bool) {
    tf.focused = focused && tf.enabled
}

pub fn (tf $&UiTextField) set_text(value string) {
    tf.text = value + ""
    tf.caret = tf.text.len
}

pub fn (tf $&UiTextField) set_max_bytes(limit int) {
    if limit >= 0 { tf.max_bytes = limit }
}

pub fn (tf $&UiTextField) clear_submitted() bool {
    out := tf.submitted
    tf.submitted = false
    << out
}

fn utf8_is_cont(b int) bool {
    << (b & 0xC0) == 0x80
}

fn utf8_prev(s &string, pos int) int {
    if pos <= 0 { << 0 }
    $p := pos - 1
    if p > s.len - 1 { p = s.len - 1 }
    while p > 0 && utf8_is_cont(s[p]) { p = p - 1 }
    << p
}

fn utf8_next(s &string, pos int) int {
    if pos < 0 { << 0 }
    if pos >= s.len { << s.len }
    $p := pos + 1
    while p < s.len && utf8_is_cont(s[p]) { p = p + 1 }
    << p
}

fn clamp_caret(s &string, caret int) int {
    if caret <= 0 { << 0 }
    if caret >= s.len { << s.len }
    $c := caret
    while c > 0 && utf8_is_cont(s[c]) { c = c - 1 }
    << c
}

fn sanitize_single_line(raw &string) string {
    $out := ""
    for i in 0:raw.len {
        b := raw[i]
        if b != 10 && b != 13 { out = out + raw[i:i + 1] }
    }
    << out
}

fn text_field_inner(styles &widgets.Styles, bounds &layout.Rect) layout.Rect {
    c := &styles.input
    d := math.max(styles.density, 0.5)
    << inset_scaled(bounds, &c.padding, d)
}

fn text_field_scroll_x(shaped &font.TextLayout, caret int, inner_w f64) f64 {
    if shaped.metrics.width <= inner_w || inner_w <= 4.0 { << 0.0 }
    ch := shaped.caret(caret, false) >>> (err) { << 0.0 }
    if ch.x <= inner_w - 6.0 { << 0.0 }
    << ch.x - (inner_w - 6.0)
}

pub fn (tf $&UiTextField) insert_text(raw &string) bool {
    clean := sanitize_single_line(raw)
    if clean.len == 0 { << false }
    if tf.max_bytes > 0 && tf.text.len + clean.len > tf.max_bytes { << false }
    c := clamp_caret(&tf.text, tf.caret)
    tf.text = tf.text[0:c] + clean + tf.text[c:tf.text.len]
    tf.caret = c + clean.len
    << true
}

// Handles pointer focus/caret hit-testing, UTF-8 text commits, and editing keys.
pub fn (tf $&UiTextField) handle_input(frame &UiFrame, ui_ev &ui.InputEvent, text_commit &string) bool {
    inside := tf.bounds.contains(ui_ev.x, ui_ev.y)

    if ui_ev.kind == ui.EV_POINTER_MOVE {
        tf.hovered = inside && tf.enabled
    } else if ui_ev.kind == ui.EV_POINTER_LEAVE || ui_ev.kind == ui.EV_POINTER_CANCEL {
        tf.hovered = false
    } else if ui_ev.kind == ui.EV_POINTER_DOWN && ui_ev.button == ui.BUTTON_LEFT {
        if inside && tf.enabled {
            tf.focused = true
            tf.caret = clamp_caret(&tf.text, tf.caret)
            if tf.text.len > 0 {
                inner := text_field_inner(&frame.styles, &tf.bounds)
                fsize := scaled_font_size(&frame.styles, &frame.styles.input)
                shaped := frame.measure_text(&tf.text, fsize) >>> (err) { << true }
                scroll_x := text_field_scroll_x(&shaped, tf.caret, inner.width)
                ty := inner.y + (inner.height - shaped.metrics.height) * 0.5
                hit := shaped.hit_test(ui_ev.x - (inner.x - scroll_x), ui_ev.y - ty) >>> (err) {
                    << true
                }
                tf.caret = clamp_caret(&tf.text, hit.byte_index())
            } else {
                tf.caret = 0
            }
            << true
        }
        tf.focused = false
        << false
    }

    if !tf.focused || !tf.enabled { << false }

    if text_commit.len > 0 {
        << tf.insert_text(text_commit)
    }

    if ui_ev.kind == ui.EV_KEY_DOWN {
        c := clamp_caret(&tf.text, tf.caret)
        if ui_ev.key == ui.KEY_BACKSPACE {
            if c > 0 {
                prev := utf8_prev(&tf.text, c)
                tf.text = tf.text[0:prev] + tf.text[c:tf.text.len]
                tf.caret = prev
            }
            << true
        }
        if ui_ev.key == ui.KEY_DELETE {
            if c < tf.text.len {
                next := utf8_next(&tf.text, c)
                tf.text = tf.text[0:c] + tf.text[next:tf.text.len]
                tf.caret = c
            }
            << true
        }
        if ui_ev.key == ui.KEY_LEFT {
            tf.caret = utf8_prev(&tf.text, c)
            << true
        }
        if ui_ev.key == ui.KEY_RIGHT {
            tf.caret = utf8_next(&tf.text, c)
            << true
        }
        if ui_ev.key == ui.KEY_HOME {
            tf.caret = 0
            << true
        }
        if ui_ev.key == ui.KEY_END {
            tf.caret = tf.text.len
            << true
        }
        if ui_ev.key == ui.KEY_ENTER {
            tf.submitted = true
            << true
        }
        if ui_ev.key == ui.KEY_ESCAPE {
            tf.focused = false
            << true
        }
    }

    << false
}

fn text_field_caret_hit(shaped &font.TextLayout, caret int, fallback_h f64) font.TextHit {
    << shaped.caret(caret, false) >>> (err) {
        << font.TextHit{index: 0, length: 0, trailing: false, inside: false, x: 0.0, y: 0.0, height: fallback_h}
    }
}

// Draws `tf` using `frame.styles.input`, clipped text layout, and an active caret bar.
pub fn (frame $&UiFrame) text_field(tf &UiTextField) int {
    recording(frame) >>>
    c := frame.styles.input.clone()
    $state := 0
    if !tf.enabled { state = state | widgets.STATE_DISABLED }
    if tf.hovered { state = state | widgets.STATE_HOVERED }
    if tf.focused && tf.enabled { state = state | widgets.STATE_FOCUSED }
    frame.style_box(&tf.bounds, &c, state) >>>

    rp := c.resolve(state)
    fsize := scaled_font_size(&frame.styles, &c)
    inner := text_field_inner(&frame.styles, &tf.bounds)
    if inner.width <= 0.0 || inner.height <= 0.0 { << 0 }

    frame.push_clip(&inner) >>>

    if tf.text.len > 0 {
        caret := clamp_caret(&tf.text, tf.caret)
        shaped := frame.measure_text(&tf.text, fsize)
        scroll_x := text_field_scroll_x(&shaped, caret, inner.width)
        ty := inner.y + (inner.height - shaped.metrics.height) * 0.5
        $has_caret := false
        $caret_x := 0.0
        $caret_h := math.max(fsize, shaped.line_height)
        if tf.focused && tf.enabled {
            ch := text_field_caret_hit(&shaped, caret, math.max(fsize, 12.0))
            caret_x = inner.x - scroll_x + ch.x
            caret_h = math.max(fsize, ch.height)
            has_caret = true
        }
        frame.record_text_layout(shaped, fm.vec2(inner.x - scroll_x, ty), rp.foreground) >>>
        if has_caret {
            caret_y := inner.y + (inner.height - caret_h) * 0.5
            d := math.max(frame.styles.density, 0.5)
            frame.record_sdf_rect(fm.rect2(caret_x, caret_y, math.max(1.5, 2.0 * d), caret_h),
                0.0, c.palette.accent.value(), 0.0, 0) >>>
        }
    } else {
        if tf.placeholder.len > 0 {
            shaped := frame.measure_text(&tf.placeholder, fsize)
            ty := inner.y + (inner.height - shaped.metrics.height) * 0.5
            frame.record_text_layout(shaped, fm.vec2(inner.x, ty), rp.placeholder) >>>
        }
        if tf.focused && tf.enabled {
            caret_h := math.min(inner.height, math.max(fsize * 1.15, 12.0))
            caret_y := inner.y + (inner.height - caret_h) * 0.5
            d := math.max(frame.styles.density, 0.5)
            frame.record_sdf_rect(fm.rect2(inner.x, caret_y, math.max(1.5, 2.0 * d), caret_h),
                0.0, c.palette.accent.value(), 0.0, 0) >>>
        }
    }

    frame.pop_clip() >>>
    << 0
}
