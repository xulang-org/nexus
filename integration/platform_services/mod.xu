@"github.com/xulang-org/nexus/integration/platform_services"

fm #"github.com/xulang-org/nexus/foundation/math"
inp #"github.com/xulang-org/nexus/input"
vp #"github.com/xulang-org/nexus/integration/viewport"
snapshot #"github.com/xulang-org/nexus/internal/file_snapshot"
rs #"github.com/xulang-org/nexus/resources/steam"
rc #"github.com/xulang-org/nexus/resources/console"
rt #"github.com/xulang-org/nexus/resources/taptap"
st #"github.com/xulang-org/nexus/steam"
cs #"github.com/xulang-org/nexus/console"
tt #"github.com/xulang-org/nexus/taptap"
timing #"github.com/xulang-org/nexus/timing"
#crypto/sha256
#errors
#os
#path/filepath
#strings

pub struct PlatformServices {
    kind int
    steam_client st.SteamClient
    console_svc cs.ConsoleService
    taptap_client tt.TapTapClient
    mapping rc.MultiPlatformMapping
}

fn clone_mapping(m &rc.MultiPlatformMapping) rc.MultiPlatformMapping {
    $am := []rc.LogicalAchievementMap{}
    for i in 0:m.achievements.len {
        a := &m.achievements[i]
        am.push(rc.LogicalAchievementMap{
            logical_id: a.logical_id + "",
            steam_id: a.steam_id + "",
            xbox_id: a.xbox_id + "",
            ps_trophy_id: a.ps_trophy_id,
            taptap_id: a.taptap_id + ""
        })
    }
    $dm := []rc.LogicalDlcMap{}
    for i in 0:m.dlcs.len {
        d := &m.dlcs[i]
        dm.push(rc.LogicalDlcMap{
            logical_id: d.logical_id + "",
            steam_app_id: d.steam_app_id,
            xbox_store_id: d.xbox_store_id + "",
            ps_entitlement: d.ps_entitlement + "",
            switch_aoc_index: d.switch_aoc_index,
            taptap_dlc_id: d.taptap_dlc_id + ""
        })
    }
    << rc.MultiPlatformMapping{achievements: am, dlcs: dm}
}

pub fn open_steam(cfg rs.SteamAppConfig, save_dir string, mapping rc.MultiPlatformMapping) PlatformServices {
    client := st.init_auto(cfg, save_dir + "") or >>
    << PlatformServices{
        kind: rc.PLATFORM_PC_STEAM,
        steam_client: client,
        console_svc: cs.empty_service(),
        taptap_client: tt.empty_client(),
        mapping: mapping
    }
}

pub fn open_xbox(cfg rc.XboxAppConfig, platform int, save_dir string, mapping rc.MultiPlatformMapping) PlatformServices {
    svc := cs.init_xbox_auto(cfg, platform, save_dir + "") or >>
    << PlatformServices{
        kind: platform,
        steam_client: st.empty_client(),
        console_svc: svc,
        taptap_client: tt.empty_client(),
        mapping: mapping
    }
}

pub fn open_playstation(cfg rc.PlayStationAppConfig, platform int, save_dir string, mapping rc.MultiPlatformMapping) PlatformServices {
    svc := cs.init_ps_auto(cfg, platform, save_dir + "") or >>
    << PlatformServices{
        kind: platform,
        steam_client: st.empty_client(),
        console_svc: svc,
        taptap_client: tt.empty_client(),
        mapping: mapping
    }
}

pub fn open_switch(cfg rc.SwitchAppConfig, platform int, save_dir string, mapping rc.MultiPlatformMapping) PlatformServices {
    svc := cs.init_switch_auto(cfg, platform, save_dir + "") or >>
    << PlatformServices{
        kind: platform,
        steam_client: st.empty_client(),
        console_svc: svc,
        taptap_client: tt.empty_client(),
        mapping: mapping
    }
}

pub fn open_taptap(cfg rt.TapTapAppConfig, save_dir string, mapping rc.MultiPlatformMapping) PlatformServices {
    $plat := rc.PLATFORM_TAPTAP_ANDROID
    if cfg.target_platform == rt.TARGET_IOS { plat = rc.PLATFORM_TAPTAP_IOS }
    else if cfg.target_platform == rt.TARGET_PC { plat = rc.PLATFORM_TAPTAP_PC }
    tc := tt.init_auto(cfg, save_dir + "") or >>
    << PlatformServices{
        kind: plat,
        steam_client: st.empty_client(),
        console_svc: cs.empty_service(),
        taptap_client: tc,
        mapping: mapping
    }
}

pub fn (p &PlatformServices) platform() int { << p.kind }
pub fn (p &PlatformServices) is_steam() bool { << p.kind == rc.PLATFORM_PC_STEAM }
pub fn (p &PlatformServices) is_xbox() bool { << rc.is_xbox_platform(p.kind) }
pub fn (p &PlatformServices) is_playstation() bool { << rc.is_playstation_platform(p.kind) }
pub fn (p &PlatformServices) is_switch() bool { << rc.is_switch_platform(p.kind) }
pub fn (p &PlatformServices) is_taptap() bool { << rc.is_taptap_platform(p.kind) }

pub fn (p &PlatformServices) platform_name() string {
    if p.kind == rc.PLATFORM_PC_STEAM { << "PC Steam" }
    if p.is_taptap() {
        hw := rc.hardware_profile(p.kind) or (err) {
            _ := err.msg()
            << "TapTap"
        }
        << hw.name + ""
    }
    hw := p.console_svc.hardware()
    << hw.name + ""
}

pub fn (p &PlatformServices) glyph_family() int {
    if p.is_xbox() { << rc.GLYPH_XBOX }
    if p.is_playstation() { << rc.GLYPH_PLAYSTATION }
    if p.is_switch() { << rc.GLYPH_SWITCH }
    if p.is_taptap() {
        if p.kind == rc.PLATFORM_TAPTAP_PC { << rc.GLYPH_KEYBOARD_MOUSE }
        << rc.GLYPH_TOUCH
    }
    prof := p.steam_client.profile()
    if prof.on_steam_deck { << rc.GLYPH_STEAM_DECK }
    << rc.GLYPH_KEYBOARD_MOUSE
}

pub fn (p &PlatformServices) confirm_label() string {
    if p.is_xbox() { << "A" }
    if p.is_switch() { << "A" }
    if p.is_playstation() {
        if p.console_svc.confirm_button_layout() == rc.CONFIRM_CIRCLE_B { << "Circle" }
        << "Cross"
    }
    if p.is_taptap() {
        if p.kind == rc.PLATFORM_TAPTAP_PC { << "Enter" }
        << "Tap"
    }
    if p.steam_client.profile().on_steam_deck { << "A" }
    << "Enter"
}

pub fn (p &PlatformServices) cancel_label() string {
    if p.is_xbox() { << "B" }
    if p.is_switch() { << "B" }
    if p.is_playstation() {
        if p.console_svc.confirm_button_layout() == rc.CONFIRM_CIRCLE_B { << "Cross" }
        << "Circle"
    }
    if p.is_taptap() {
        if p.kind == rc.PLATFORM_TAPTAP_PC { << "Esc" }
        << "Back"
    }
    if p.steam_client.profile().on_steam_deck { << "B" }
    << "Esc"
}

fn find_ach_idx_opt(mapping &rc.MultiPlatformMapping, logical_id &string) int {
    for i in 0:mapping.achievements.len {
        if mapping.achievements[i].logical_id == *logical_id { << i }
    }
    << -1
}

fn find_dlc_idx_opt(mapping &rc.MultiPlatformMapping, logical_id &string) int {
    for i in 0:mapping.dlcs.len {
        if mapping.dlcs[i].logical_id == *logical_id { << i }
    }
    << -1
}

fn find_ach_idx(mapping &rc.MultiPlatformMapping, logical_id &string) int {
    idx := find_ach_idx_opt(mapping, logical_id)
    if idx < 0 { >> errors.new("nexus platform_services: unknown logical achievement: " + logical_id) }
    << idx
}

fn find_dlc_idx(mapping &rc.MultiPlatformMapping, logical_id &string) int {
    idx := find_dlc_idx_opt(mapping, logical_id)
    if idx < 0 { >> errors.new("nexus platform_services: unknown logical dlc: " + logical_id) }
    << idx
}

pub fn (p $&PlatformServices) unlock_logical_achievement(logical_id string) int {
    idx := find_ach_idx(&p.mapping, &logical_id) or >>
    entry := &p.mapping.achievements[idx]
    if p.is_steam() {
        sid := entry.steam_id + ""
        sc := $&p.steam_client
        sc.unlock_achievement(sid + "") or >>
        << 0
    }
    if p.is_taptap() {
        $tid := entry.taptap_id + ""
        if tid.len == 0 { tid = entry.logical_id + "" }
        tc := $&p.taptap_client
        << tc.unlock_achievement(tid + "") or >>
    }
    $aid := ""
    $pid := entry.ps_trophy_id
    if p.is_xbox() {
        aid = entry.xbox_id + ""
        pid = 0
    } else if p.is_switch() {
        aid = entry.logical_id + ""
        pid = 0
    }
    cv := $&p.console_svc
    << cv.unlock_achievement(aid, pid) or >>
}

pub fn (p &PlatformServices) has_logical_achievement(logical_id string) bool {
    idx := find_ach_idx_opt(&p.mapping, &logical_id)
    if idx < 0 { << false }
    entry := &p.mapping.achievements[idx]
    if p.is_steam() {
        << p.steam_client.has_achievement(entry.steam_id + "")
    }
    if p.is_taptap() {
        $tid := entry.taptap_id + ""
        if tid.len == 0 { tid = entry.logical_id + "" }
        << p.taptap_client.has_achievement(tid + "")
    }
    if p.is_xbox() {
        << p.console_svc.has_achievement(entry.xbox_id + "", 0)
    }
    if p.is_switch() {
        << p.console_svc.has_achievement(entry.logical_id + "", 0)
    }
    << p.console_svc.has_achievement("", entry.ps_trophy_id)
}

pub fn (p &PlatformServices) has_logical_dlc(logical_id string) bool {
    idx := find_dlc_idx_opt(&p.mapping, &logical_id)
    if idx < 0 { << false }
    entry := &p.mapping.dlcs[idx]
    if p.is_steam() {
        << p.steam_client.is_dlc_installed(entry.steam_app_id)
    }
    if p.is_taptap() {
        $did := entry.taptap_dlc_id + ""
        if did.len == 0 { did = entry.logical_id + "" }
        << p.taptap_client.has_dlc(did + "")
    }
    if p.is_xbox() {
        << p.console_svc.has_entitlement(entry.xbox_store_id + "")
    }
    if p.is_switch() {
        << p.console_svc.has_aoc(entry.switch_aoc_index)
    }
    << p.console_svc.has_entitlement(entry.ps_entitlement + "")
}

pub fn (p $&PlatformServices) grant_mock_logical_dlc(logical_id string) int {
    idx := find_dlc_idx(&p.mapping, &logical_id) or >>
    entry := &p.mapping.dlcs[idx]
    if p.is_steam() {
        sc := $&p.steam_client
        << sc.register_mock_dlc(rs.SteamDlcInfo{app_id: entry.steam_app_id, installed: true, name: entry.logical_id + ""}) or >>
    }
    if p.is_taptap() {
        $did := entry.taptap_dlc_id + ""
        if did.len == 0 { did = entry.logical_id + "" }
        tc := $&p.taptap_client
        << tc.grant_mock_dlc(did + "") or >>
    }
    cv := $&p.console_svc
    if p.is_xbox() {
        << cv.grant_mock_entitlement(entry.xbox_store_id + "") or >>
    }
    if p.is_switch() {
        << cv.grant_mock_aoc(entry.switch_aoc_index) or >>
    }
    << cv.grant_mock_entitlement(entry.ps_entitlement + "") or >>
}

pub fn (p $&PlatformServices) set_rich_activity(status string, activity_id string) int {
    if p.is_steam() {
        sc := $&p.steam_client
        << sc.set_rich_presence("status", status + "") or >>
    }
    if p.is_taptap() { << 0 }
    cv := $&p.console_svc
    << cv.set_presence(status + "", activity_id + "") or >>
}

pub fn (p $&PlatformServices) apply_haptics(pad_idx int, cmd rc.GamepadHapticCommand) int {
    rc.validate_haptic_command(&cmd) or >>
    if p.is_steam() || p.is_taptap() { << 0 }
    cv := $&p.console_svc
    << cv.apply_haptics(pad_idx, cmd) or >>
}

pub fn (p &PlatformServices) can_use_multiplayer(require_crossplay bool) bool {
    if p.is_steam() {
        << p.steam_client.profile().logged_on
    }
    if p.is_taptap() {
        << p.taptap_client.is_logged_in() && !p.taptap_client.compliance_state().restricted
    }
    u := p.console_svc.primary_user()
    if !u.signed_in || !u.has_multiplayer_privilege { << false }
    if require_crossplay && !u.crossplay_allowed { << false }
    << true
}

pub fn (p $&PlatformServices) shutdown() int {
    if p.is_steam() {
        sc := $&p.steam_client
        << sc.shutdown() or >>
    }
    if p.is_taptap() {
        tc := $&p.taptap_client
        << tc.shutdown() or >>
    }
    cv := $&p.console_svc
    << cv.shutdown() or >>
}

pub fn (p &PlatformServices) current_confirm_layout() int {
    if p.is_steam() || p.is_taptap() { << rc.CONFIRM_CROSS_A }
    << p.console_svc.confirm_button_layout()
}

pub fn (p &PlatformServices) current_presence() string {
    if p.is_steam() { << p.steam_client.get_rich_presence("status") }
    if p.is_taptap() { << "" }
    << p.console_svc.current_presence()
}

pub fn (p &PlatformServices) last_haptics(pad_idx int) rc.GamepadHapticCommand {
    if p.is_steam() || p.is_taptap() { << rc.default_haptic_command() }
    << p.console_svc.last_haptics(pad_idx)
}

pub fn (p &PlatformServices) platinum_unlocked() bool {
    if !p.is_playstation() { << false }
    << p.console_svc.platinum_unlocked()
}

pub fn (p $&PlatformServices) create_session(max_players int, crossplay bool) int {
    if p.is_steam() {
        sc := $&p.steam_client
        << sc.create_lobby(rs.LOBBY_PUBLIC, max_players) or >>
    }
    if p.is_taptap() { << 1 }
    cv := $&p.console_svc
    << cv.create_session(max_players, crossplay) or >>
}

pub fn (p $&PlatformServices) start_activity(activity_id string) int {
    if p.is_steam() || p.is_taptap() { << 0 }
    cv := $&p.console_svc
    << cv.start_activity(activity_id + "") or >>
}

pub fn (p $&PlatformServices) end_activity(activity_id string, outcome int) int {
    if p.is_steam() || p.is_taptap() { << 0 }
    cv := $&p.console_svc
    << cv.end_activity(activity_id + "", outcome) or >>
}

pub fn (p $&PlatformServices) set_mock_overlay_or_constrained(active bool) {
    if p.is_steam() {
        sc := $&p.steam_client
        sc.set_mock_overlay_active(active)
        <<
    }
    if p.is_taptap() {
        tc := $&p.taptap_client
        if active {
            tc.open_moment("forum") or (err) {
                _ := err.msg()
                <<
            }
        } else {
            tc.close_mock_moment()
        }
        <<
    }
    cv := $&p.console_svc
    cv.simulate_constrained(active)
}

pub fn (p $&PlatformServices) set_mock_confirm_button(layout int) int {
    if p.is_steam() || p.is_taptap() { << 0 }
    cv := $&p.console_svc
    << cv.set_mock_confirm_button(layout) or >>
}

pub fn (p $&PlatformServices) simulate_suspend() {
    if !p.is_steam() && !p.is_taptap() {
        cv := $&p.console_svc
        cv.simulate_suspend()
    }
}

pub fn (p $&PlatformServices) simulate_resume() {
    if !p.is_steam() && !p.is_taptap() {
        cv := $&p.console_svc
        cv.simulate_resume()
    }
}

pub fn (p $&PlatformServices) simulate_user_sign_out() {
    if p.is_taptap() {
        tc := $&p.taptap_client
        tc.simulate_switch_account() or (err) {
            _ := err.msg()
            <<
        }
        <<
    }
    if !p.is_steam() {
        cv := $&p.console_svc
        cv.simulate_user_sign_out()
    }
}

pub fn (p $&PlatformServices) simulate_controller_disconnect(disconnected bool) {
    if !p.is_steam() && !p.is_taptap() {
        cv := $&p.console_svc
        cv.simulate_controller_disconnect(disconnected)
    }
}

pub fn (p &PlatformServices) taptap_compliance_restricted() bool {
    if !p.is_taptap() { << false }
    << p.taptap_client.compliance_state().restricted
}

pub fn (p &PlatformServices) taptap_check_payment(amount_cents int) int {
