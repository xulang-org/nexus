pub struct UnifiedStepStatus {
    pub platform int
    pub should_pause bool
    pub must_flush_saves bool
    pub must_reverify_user bool
    pub return_to_title_required bool
    pub controller_disconnected bool
    pub safe_area_percent int
    pub safe_ui_rect fm.Rect2
    pub ui_scale f64
    pub glyph_family int
    pub confirm_label string
    pub operation_mode int
    pub npad_style int
    pub touch_enabled bool
    pub render_width int
    pub render_height int
    pub compliance_restricted bool
    pub compliance_remaining_seconds int
}

// Unified per-frame coordinator automating Steam Overlay / Xbox Constrained /
// PlayStation Rest-Mode / Switch Home-Sleep / TapTap Moment & Compliance pausing,
// input release, user sign-out, Handheld-Docked transitions, and TV safe-area margins.
pub struct UnifiedRuntimeBridge {
    paused_by_platform bool
    clock_was_paused bool
    controller_disconnected bool
    auto_pause bool
}

pub fn new_unified_bridge(auto_pause bool) UnifiedRuntimeBridge {
    << UnifiedRuntimeBridge{
        paused_by_platform: false,
        clock_was_paused: false,
        controller_disconnected: false,
        auto_pause: auto_pause
    }
}

fn resolve_taptap_hw(platform int) rc.ConsoleHardwareProfile {
    hw := rc.hardware_profile(platform) or (err) {
        _ := err.msg()
        << rc.ConsoleHardwareProfile{
            platform: platform, name: "TapTap", gfx_api: rc.GFX_VULKAN,
            target_width: 1920, target_height: 1080, max_refresh_hz: 60,
            memory_budget_mb: 4096, tv_safe_area_pct: 100,
            supports_hdr: false, supports_vrr: false, supports_spatial_audio: false
        }
    }
    << hw
}

pub fn (b $&UnifiedRuntimeBridge) step(svc $&PlatformServices, clock $&timing.ScaledClock,
        input_map $&inp.InputMap, viewport &vp.Viewport) UnifiedStepStatus {
    $should_pause := false
    $must_flush := false
    $must_reverify := false
    $return_title := false
    $safe_pct := 100
    $ui_scale := 1.0
    $op_mode := rc.OPERATION_MODE_DOCKED
    $npad := 0
    $touch_on := false
    $ren_w := int(viewport.safe_rect.size.x)
    $ren_h := int(viewport.safe_rect.size.y)
    $comp_restricted := false
    $comp_rem := -1

    if svc.is_steam() {
        sc := $&svc.steam_client
        sc.tick() or >>
        _ := sc.drain_events()
        if sc.overlay_active() { should_pause = true }
        prof := sc.profile()
        if prof.on_steam_deck { ui_scale = 1.25 }
    } else if svc.is_taptap() {
        tc := $&svc.taptap_client
        tc.poll() or >>
        tevs := tc.drain_events()
        for i in 0:tevs.len {
            ek := tevs[i].kind
            if ek == rt.EVENT_COMPLIANCE_PERIOD_RESTRICT ||
                ek == rt.EVENT_COMPLIANCE_DURATION_LIMIT ||
                ek == rt.EVENT_COMPLIANCE_AGE_LIMIT {
                must_flush = true
                should_pause = true
                comp_restricted = true
            }
            if ek == rt.EVENT_COMPLIANCE_EXITED || ek == rt.EVENT_COMPLIANCE_SWITCH_ACCOUNT {
                return_title = true
            }
        }
        cs_t := tc.compliance_state()
        comp_rem = cs_t.remaining_seconds
        if cs_t.restricted {
            comp_restricted = true
            should_pause = true
            must_flush = true
        }
        if tc.is_moment_open() { should_pause = true }
        if !tc.is_logged_in() { return_title = true }
        if svc.platform() == rc.PLATFORM_TAPTAP_ANDROID || svc.platform() == rc.PLATFORM_TAPTAP_IOS {
            touch_on = true
        }
        hw := resolve_taptap_hw(svc.platform())
        ren_w = hw.target_width
        ren_h = hw.target_height
    } else {
        cv := $&svc.console_svc
        cv.poll() or >>
        evs := cv.drain_events()
        for i in 0:evs.len {
            ek := evs[i].kind
            if ek == rc.EVENT_SUSPENDED { must_flush = true }
            if ek == rc.EVENT_RESUMED { must_reverify = true }
            if ek == rc.EVENT_USER_SIGNED_OUT { return_title = true }
            if ek == rc.EVENT_CONTROLLER_DISCONNECTED { b.controller_disconnected = true }
            if ek == rc.EVENT_CONTROLLER_RECONNECTED { b.controller_disconnected = false }
        }
        lc := cv.lifecycle_state()
        if lc == rc.LIFECYCLE_CONSTRAINED || lc == rc.LIFECYCLE_SUSPENDED || b.controller_disconnected {
            should_pause = true
        }
        if !cv.primary_user().signed_in { return_title = true }
        safe_pct = cv.safe_area_percent()
        hw := cv.hardware()
        if cv.is_switch() {
            op_mode = cv.operation_mode()
            npad = cv.npad_style()
            touch_on = cv.touch_screen_active()
            res := rc.switch_resolution(svc.platform(), op_mode)
            ren_w = res[0]
            ren_h = res[1]
            if op_mode == rc.OPERATION_MODE_HANDHELD || ren_w >= 3840 {
                ui_scale = 1.25
            }
        } else {
            ren_w = hw.target_width
            ren_h = hw.target_height
            if hw.target_width >= 3840 { ui_scale = 1.25 }
        }
    }

    if b.auto_pause {
        if should_pause && !b.paused_by_platform {
            input_map.release_all()
            b.clock_was_paused = clock.is_paused()
            clock.set_paused(true)
            b.paused_by_platform = true
        } else if !should_pause && b.paused_by_platform {
            clock.set_paused(b.clock_was_paused)
            b.paused_by_platform = false
        }
    }

    $margin_frac := f64(100 - safe_pct) * 0.005
    if margin_frac < 0.0 { margin_frac = 0.0 }
    pad_x := viewport.safe_rect.size.x * margin_frac
    pad_y := viewport.safe_rect.size.y * margin_frac
    safe_rect := viewport.safe_inset_rect(pad_x, pad_y, pad_x, pad_y) or >>

    << UnifiedStepStatus{
        platform: svc.platform(),
        should_pause: should_pause,
        must_flush_saves: must_flush,
        must_reverify_user: must_reverify,
        return_to_title_required: return_title,
        controller_disconnected: b.controller_disconnected,
        safe_area_percent: safe_pct,
        safe_ui_rect: safe_rect,
        ui_scale: ui_scale,
        glyph_family: svc.glyph_family(),
        confirm_label: svc.confirm_label(),
        operation_mode: op_mode,
        npad_style: npad,
        touch_enabled: touch_on,
        render_width: ren_w,
        render_height: ren_h,
        compliance_restricted: comp_restricted,
        compliance_remaining_seconds: comp_rem
    }
}

const SAVE_ENVELOPE_PREFIX = "NXSV1|"

// Integrity-verified save slot store backed transparently by Steam Cloud,
// Xbox Connected Storage, PlayStation sceSaveData, Nintendo Switch save:/, or TapTap CloudSave.
pub struct UnifiedSaveStore {
    pub local_dir string
}

pub fn new_unified_save_store(local_dir string) UnifiedSaveStore {
    << UnifiedSaveStore{local_dir: local_dir + ""}
}

fn slice_to_string(data &[]u8, start int, stop int) string {
    $b := strings.new_byte_builder(stop - start + 1)
    for i in start:stop { b.write_byte(int(data[i])) }
    << b.to_string()
}

fn encode_save_envelope(data &[]u8) []u8 {
    body := slice_to_string(data, 0, data.len)
    digest := sha256.sum256(body)
    hdr := SAVE_ENVELOPE_PREFIX + digest + "|"
    $out := []u8{}
    for i in 0:hdr.len { out.push(u8(hdr[i] & 255)) }
    for i in 0:data.len { out.push(data[i]) }
    << out
}

fn decode_save_envelope(raw &[]u8) []u8 {
    if raw.len < 71 { >> errors.new("nexus platform save: envelope truncated") }
    if slice_to_string(raw, 0, 6) != SAVE_ENVELOPE_PREFIX || (raw[70] & 255) != 124 {
        >> errors.new("nexus platform save: invalid envelope header")
    }
    expected := slice_to_string(raw, 6, 70)
    body := slice_to_string(raw, 71, raw.len)
    if sha256.sum256(body) != expected {
        >> errors.new("nexus platform save: SHA-256 verification failed")
    }
    $out := []u8{}
    for i in 71:raw.len { out.push(raw[i]) }
    << out
}

fn console_container_name(p &PlatformServices) string {
    if p.is_xbox() { << "saves" }
    if p.is_switch() { << "save" }
    << "SAVEDATA"
}

fn console_blob_name(clean &string) string {
    << strings.replace_all(clean, "/", "_")
}

pub fn (s &UnifiedSaveStore) write_slot(svc $&PlatformServices, slot string, data &[]u8) int {
    clean := rs.validate_cloud_filename(&slot) or >>
    env := encode_save_envelope(data)
    if svc.is_steam() {
        sc := $&svc.steam_client
        if sc.is_initialized() && sc.cloud_enabled() {
            sc.cloud_write(clean + "", &env) or >>
        }
    } else if svc.is_taptap() {
        tc := $&svc.taptap_client
        if tc.is_initialized() {
            tc.cloud_write(clean + "", "Nexus Save", &env) or >>
        }
    } else {
        cont := console_container_name(svc)
        blob := console_blob_name(&clean)
        cv := $&svc.console_svc
        cv.save_write(cont, blob, &env) or >>
    }
    if s.local_dir.len > 0 {
        dest := filepath.join([s.local_dir + "", clean + ""])
        os.mkdir_all(filepath.dir(dest)) or >>
        raw := slice_to_string(&env, 0, env.len)
        snapshot.write_atomic(dest + "", &raw) or >>
    }
    << 0
}

pub fn (s &UnifiedSaveStore) read_slot(svc &PlatformServices, slot string) []u8 {
    clean := rs.validate_cloud_filename(&slot) or >>
    if svc.is_steam() {
        if svc.steam_client.is_initialized() && svc.steam_client.cloud_enabled() && svc.steam_client.cloud_exists(clean + "") {
            env := svc.steam_client.cloud_read(clean + "") or >>
            << decode_save_envelope(&env) or >>
        }
    } else if svc.is_taptap() {
        if svc.taptap_client.is_initialized() && svc.taptap_client.cloud_exists(clean + "") {
            env := svc.taptap_client.cloud_read(clean + "") or >>
            << decode_save_envelope(&env) or >>
        }
    } else {
        cont := console_container_name(svc)
        blob := console_blob_name(&clean)
        if svc.console_svc.is_initialized() && svc.console_svc.save_exists(cont + "", blob + "") {
            env := svc.console_svc.save_read(cont + "", blob + "") or >>
            << decode_save_envelope(&env) or >>
        }
    }
    if s.local_dir.len > 0 {
        src := filepath.join([s.local_dir + "", clean + ""])
        raw := snapshot.read(src, rs.MAX_CLOUD_FILE_BYTES) or >>
        $env := []u8{}
        for i in 0:raw.len { env.push(u8(raw[i] & 255)) }
        << decode_save_envelope(&env) or >>
    }
    >> errors.new("nexus platform save: save slot missing: " + clean)
}
