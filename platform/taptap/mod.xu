pub fn raw_compliance_remaining_time() int { << nexus_taptap_native.compliance_remaining_time() }
pub fn raw_compliance_status() int { << nexus_taptap_native.compliance_status() }
pub fn raw_compliance_check_payment(amount_cents int) int { << nexus_taptap_native.compliance_check_payment(amount_cents) }
pub fn raw_compliance_submit_payment(amount_cents int) int { << nexus_taptap_native.compliance_submit_payment(amount_cents) }
pub fn raw_verify_license() int { << nexus_taptap_native.verify_license() }
pub fn raw_has_dlc(sku &[]u8) int { << nexus_taptap_native.has_dlc(sku) }
pub fn raw_query_dlc_page(sku &[]u8) int { << nexus_taptap_native.query_dlc_page(sku) }
