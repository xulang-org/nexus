pub fn raw_increment_achievement(id &[]u8, steps int, max_steps int) int { << nexus_taptap_native.increment_achievement(id, steps, max_steps) }
pub fn raw_has_achievement(id &[]u8) int { << nexus_taptap_native.has_achievement(id) }
