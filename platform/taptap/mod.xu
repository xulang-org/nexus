pub fn raw_user_union_id(out $&[]u8) int { << nexus_taptap_native.user_union_id(out) }
pub fn raw_user_name(out $&[]u8) int { << nexus_taptap_native.user_name(out) }
pub fn raw_compliance_startup() int { << nexus_taptap_native.compliance_startup() }
pub fn raw_compliance_exit() int { << nexus_taptap_native.compliance_exit() }
