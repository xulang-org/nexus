pub fn raw_moment_is_open() int { << nexus_taptap_native.moment_is_open() }
pub fn raw_check_update() int { << nexus_taptap_native.check_update() }

pub fn last_error() string {
    $message := ""
    n := raw_error_len()
    for i in 0:n {
        message = message + string_from_byte(raw_error_byte(i))
    }
    << message
}

pub fn checked(status int) int {
    if status >= 0 { << status }
    msg := last_error()
    if msg.len == 0 { >> errors.new("nexus taptap: native operation failed") }
    >> errors.new("nexus taptap: " + msg)
}

pub fn str_to_u8(s &string) []u8 {
    $out := []u8{}
    for i in 0:s.len {
        out.push(u8(s[i] & 255))
    }
    << out
}

pub fn alloc_u8(count int) []u8 {
    $out := []u8{}
    for _ in 0:count { out.push(u8(0)) }
    << out
}

pub fn u8_to_str(buf &[]u8, length int) string {
    if length <= 0 { << "" }
    $n := length
    if n > buf.len { n = buf.len }
    $out := ""
    for i in 0:n {
        out = out + string_from_byte(int(buf[i]))
    }
    << out
}
