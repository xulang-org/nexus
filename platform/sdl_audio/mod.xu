@"github.com/xulang-org/nexus/platform/sdl_audio"

#nexus_audio_native
#errors

pub fn raw_error_len() int { << nexus_audio_native.error_len() }
pub fn raw_error_byte(index int) int { << nexus_audio_native.error_byte(index) }
pub fn raw_open(rate int) int { << nexus_audio_native.open(rate) }
pub fn raw_close(handle int) int { << nexus_audio_native.close(handle) }
pub fn raw_pause(handle int, paused int) int { << nexus_audio_native.pause(handle, paused) }
pub fn raw_queued(handle int) int { << nexus_audio_native.queued(handle) }
pub fn raw_submit(handle int, samples &[]int) int { << nexus_audio_native.submit(handle, samples) }
pub fn raw_clear(handle int) int { << nexus_audio_native.clear(handle) }
pub fn raw_driver_len(handle int) int { << nexus_audio_native.driver_len(handle) }
pub fn raw_driver_byte(handle int, index int) int { << nexus_audio_native.driver_byte(handle, index) }
pub fn checked(status int) int {
    if status >= 0 { << status }
    $message := "nexus audio device: "
    for i in 0:raw_error_len() { message = message + string_from_byte(raw_error_byte(i)) }
    >>> errors.new(message)
}
