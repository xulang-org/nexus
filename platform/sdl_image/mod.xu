@"github.com/xulang-org/nexus/platform/sdl_image"

#nexus_image_native
#errors

pub fn raw_error_len() int { << nexus_image_native.error_len() }
pub fn raw_error_byte(index int) int { << nexus_image_native.error_byte(index) }
pub fn raw_decode_png(source &[]u8, width int, height int, pixels $&[]int) int {
    << nexus_image_native.decode_png(source,width,height,pixels)
}
pub fn check_status(status int) int {
    if status >= 0 { << status }
    $message := "nexus image: "
    count := nexus_image_native.error_len()
    for i in 0:count { message.push_str(string_from_byte(nexus_image_native.error_byte(i))) }
    >>> errors.new(message)
}
