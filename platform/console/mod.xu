@"github.com/xulang-org/nexus/platform/console"

#nexus_console_native
#errors

pub fn raw_error_len() int { << nexus_console_native.error_len() }
pub fn raw_error_byte(index int) int { << nexus_console_native.error_byte(index) }
pub fn raw_is_available(platform_id int) int { << nexus_console_native.is_available(platform_id) }
pub fn raw_init(platform_id int) int { << nexus_console_native.init(platform_id) }
pub fn raw_shutdown() int { << nexus_console_native.shutdown() }
pub fn raw_poll_events(out $&[]int) int { << nexus_console_native.poll_events(out) }
pub fn raw_lifecycle_state() int { << nexus_console_native.lifecycle_state() }
pub fn raw_confirm_button() int { << nexus_console_native.confirm_button() }
pub fn raw_safe_area_percent() int { << nexus_console_native.safe_area_percent() }
pub fn raw_user_id(out $&[]u8) int { << nexus_console_native.user_id(out) }
pub fn raw_user_name(out $&[]u8) int { << nexus_console_native.user_name(out) }
pub fn raw_user_flags() int { << nexus_console_native.user_flags() }
pub fn raw_unlock_achievement(id &[]u8, numeric_id int, pct int) int { << nexus_console_native.unlock_achievement(id, numeric_id, pct) }
pub fn raw_has_achievement(id &[]u8, numeric_id int) int { << nexus_console_native.has_achievement(id, numeric_id) }
pub fn raw_set_presence(status &[]u8, activity_id &[]u8) int { << nexus_console_native.set_presence(status, activity_id) }
pub fn raw_activity_start(activity_id &[]u8) int { << nexus_console_native.activity_start(activity_id) }
pub fn raw_activity_end(activity_id &[]u8, outcome int) int { << nexus_console_native.activity_end(activity_id, outcome) }
pub fn raw_save_write(container &[]u8, blob &[]u8, data &[]u8) int { << nexus_console_native.save_write(container, blob, data) }
pub fn raw_save_read(container &[]u8, blob &[]u8, out $&[]u8) int { << nexus_console_native.save_read(container, blob, out) }
pub fn raw_save_exists(container &[]u8, blob &[]u8) int { << nexus_console_native.save_exists(container, blob) }
pub fn raw_save_delete(container &[]u8, blob &[]u8) int { << nexus_console_native.save_delete(container, blob) }
pub fn raw_has_entitlement(id &[]u8) int { << nexus_console_native.has_entitlement(id) }
pub fn raw_set_haptics(pad int, low f64, high f64, lt f64, rt f64, params &[]int) int { << nexus_console_native.set_haptics(pad, low, high, lt, rt, params) }
pub fn raw_show_system_ui(kind int, arg &[]u8) int { << nexus_console_native.show_system_ui(kind, arg) }
pub fn raw_session_create(max_players int, crossplay int) int { << nexus_console_native.session_create(max_players, crossplay) }
pub fn raw_session_join(session_id int) int { << nexus_console_native.session_join(session_id) }
pub fn raw_session_leave() int { << nexus_console_native.session_leave() }
pub fn raw_operation_mode() int { << nexus_console_native.operation_mode() }
pub fn raw_npad_style() int { << nexus_console_native.npad_style() }

pub fn last_error() string {
    $message := ""
    n := raw_error_len()
    for i in 0:n {
        message = message + string_from_byte(raw_error_byte(i))
    }
    << message
}

pub fn checked(status int) int {
    if status >= 0 { << status }
    msg := last_error()
    if msg.len == 0 { >> errors.new("nexus console: native operation failed") }
    >> errors.new("nexus console: " + msg)
}

pub fn str_to_u8(s &string) []u8 {
    $out := []u8{}
    for i in 0:s.len {
        out.push(u8(s[i] & 255))
    }
    << out
}

pub fn alloc_u8(count int) []u8 {
    $out := []u8{}
    for _ in 0:count { out.push(u8(0)) }
    << out
}

pub fn u8_to_str(buf &[]u8, length int) string {
    if length <= 0 { << "" }
    $n := length
    if n > buf.len { n = buf.len }
    $out := ""
    for i in 0:n {
        out = out + string_from_byte(int(buf[i]))
    }
    << out
}
