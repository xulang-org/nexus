@"github.com/xulang-org/nexus/platform/present"

#gpu
#window
#window/events
#errors
#image/png
#strings

pub const POLICY_AUTO = 0
pub const POLICY_GPU_ONLY = 1
pub const POLICY_SOFTWARE = 2
pub const POLICY_HEADLESS = 3

pub const MODE_GPU = 1
pub const MODE_SOFTWARE = 2
pub const MODE_HEADLESS = 3

pub struct Session {
    mode int
    pub windows []window.Window
    pub devices []gpu.Device
    surfaces []gpu.Surface
    surface_format int
    pub width int
    pub height int
    pub pixels []u8
    closed bool
}

fn validate_dimensions(width int, height int) int {
    if width < 1 || height < 1 || width > 16384 || height > 16384 {
        >> errors.new("present: invalid output dimensions")
    }
    stride := height * 4
    if stride <= 0 {
        >> errors.new("present: invalid output dimensions")
    }
    if width > 67108864 / stride {
        >> errors.new("present: RGBA8 framebuffer exceeds 64 MiB limit")
    }
    << 0
}

fn alloc_rgba_bytes(width int, height int) []u8 {
    total := width * height * 4
    $out := []u8{}
    for i in 0:total { out.push(u8(0)) }
    << out
}

fn window_pixel_width(state &window.State, fallback int) int {
    if state.pixel_width > 0 { << state.pixel_width }
    if state.width > 0 { << state.width }
    << fallback
}

fn window_pixel_height(state &window.State, fallback int) int {
    if state.pixel_height > 0 { << state.pixel_height }
    if state.height > 0 { << state.height }
    << fallback
}

fn close_gpu_only(dev $&gpu.Device) {
    dev.close() >>> (err) { << }
}

fn software_session(target window.Window, width int, height int) Session {
    validate_dimensions(width, height) >>>
    << Session{mode: MODE_SOFTWARE, windows: [target], devices: []gpu.Device{},
        surfaces: []gpu.Surface{}, surface_format: 0, width: width, height: height,
        pixels: alloc_rgba_bytes(width, height), closed: false}
}

pub fn open_headless(width int, height int) Session {
    validate_dimensions(width, height) >>>
    << Session{mode: MODE_HEADLESS, windows: []window.Window{}, devices: []gpu.Device{},
        surfaces: []gpu.Surface{}, surface_format: 0, width: width, height: height,
        pixels: alloc_rgba_bytes(width, height), closed: false}
}

fn probe_gpu(opts gpu.DeviceOptions) bool {
    << gpu.is_available(opts) >>> (err) { << false }
}

pub fn open_window(options window.Options, gpu_backend int, shader_formats int, policy int) Session {
    if policy < POLICY_AUTO || policy > POLICY_SOFTWARE {
        >> errors.new("present: open_window requires POLICY_AUTO, POLICY_GPU_ONLY or POLICY_SOFTWARE")
    }
    validate_dimensions(options.width, options.height) >>>
    $target := window.open(&options) >>>
    state := target.state() >>>
    pw := window_pixel_width(&state, options.width)
    ph := window_pixel_height(&state, options.height)
    validate_dimensions(pw, ph) >>>
    if policy == POLICY_SOFTWARE {
        << software_session(target, pw, ph) >>>
    }
    opts := gpu.DeviceOptions{backend: gpu_backend, debug: false, shader_formats: shader_formats}
    if policy == POLICY_AUTO && !probe_gpu(opts) {
        << software_session(target, pw, ph) >>>
    }
    $dev := gpu.open(opts) >>> (err) {
        if policy == POLICY_AUTO { << software_session(target, pw, ph) >>> }
        >> err
    }
    $surf := dev.surface(&target, gpu.SurfaceOptions{present_mode: gpu.PRESENT_VSYNC}) >>> (err) {
        close_gpu_only($&dev)
        if policy == POLICY_AUTO { << software_session(target, pw, ph) >>> }
        >> err
    }
    format := surf.format()
    << Session{mode: MODE_GPU, windows: [target], devices: [dev], surfaces: [surf],
        surface_format: format, width: pw, height: ph, pixels: []u8{}, closed: false}
}

// Degrades cleanly across tiers: GPU+Window -> Software+Window -> Headless CPU offscreen.
pub fn open_adaptive(options window.Options, gpu_backend int, shader_formats int) Session {
    w := options.width
    h := options.height
    validate_dimensions(w, h) >>>
    << open_window(options, gpu_backend, shader_formats, POLICY_AUTO) >>> (err) {
        << open_headless(w, h) >>>
    }
}

fn (s &Session) alive() int {
    if s.closed { >> errors.new("present: closed session") }
    << 0
}

pub fn (s &Session) backend_mode() int { s.alive() >>>
    << s.mode }

pub fn (s &Session) mode_name() string {
    s.alive() >>>
    if s.mode == MODE_GPU { << "gpu" }
    if s.mode == MODE_SOFTWARE { << "software" }
    << "headless"
}

pub fn (s &Session) is_gpu() bool { << !s.closed && s.mode == MODE_GPU && s.devices.len > 0 }
pub fn (s &Session) is_software() bool { << !s.closed && s.mode != MODE_GPU }
pub fn (s &Session) has_display_window() bool { << !s.closed && s.windows.len > 0 }
pub fn (s &Session) swapchain_format() int { s.alive() >>>
    << s.surface_format }

pub fn (s &Session) gpu_device() &gpu.Device {
    s.alive() >>>
    if s.devices.len == 0 { >> errors.new("present: session has no GPU device") }
    << &s.devices[0]
}

pub fn (s &Session) window() &window.Window {
    s.alive() >>>
    if s.windows.len == 0 { >> errors.new("present: headless session has no window") }
    << &s.windows[0]
}

pub fn (s $&Session) ensure_software_size(width int, height int) int {
    s.alive() >>>
    if s.mode == MODE_GPU { >> errors.new("present: ensure_software_size requires software or headless mode") }
    validate_dimensions(width, height) >>>
    if s.width == width && s.height == height && s.pixels.len == width * height * 4 { << 0 }
    s.width = width
    s.height = height
    s.pixels = alloc_rgba_bytes(width, height)
    << 0
}

pub fn (s $&Session) sync_software_window_size() int {
    s.alive() >>>
    if s.mode == MODE_GPU || s.windows.len == 0 { << 0 }
    state := s.windows[0].state() >>>
    pw := window_pixel_width(&state, s.width)
    ph := window_pixel_height(&state, s.height)
    << s.ensure_software_size(pw, ph) >>>
}

pub fn (s $&Session) clear_software(rgba int) int {
    s.alive() >>>
    if s.mode == MODE_GPU { >> errors.new("present: clear_software requires software or headless mode") }
    if rgba < 0 || rgba > 4294967295 { >> errors.new("present: invalid RGBA color") }
    r := u8((rgba >> 24) & 255)
    g := u8((rgba >> 16) & 255)
    b := u8((rgba >> 8) & 255)
    a := u8(rgba & 255)
    count := s.width * s.height
    for i in 0:count {
        off := i * 4
        s.pixels[off] = r
        s.pixels[off + 1] = g
        s.pixels[off + 2] = b
        s.pixels[off + 3] = a
    }
    << 0
}

pub fn (s &Session) read_software_pixel(x int, y int) int {
    s.alive() >>>
    if s.mode == MODE_GPU { >> errors.new("present: read_software_pixel requires software or headless mode") }
    if x < 0 || y < 0 || x >= s.width || y >= s.height {
        >> errors.new("present: pixel outside software framebuffer")
    }
    off := (y * s.width + x) * 4
    << (int(s.pixels[off]) << 24) | (int(s.pixels[off + 1]) << 16) |
        (int(s.pixels[off + 2]) << 8) | int(s.pixels[off + 3])
}

pub fn (s &Session) capture_software_png(path string) int {
    s.alive() >>>
    if s.mode == MODE_GPU { >> errors.new("present: capture_software_png requires software or headless mode") }
    $bytes := strings.new_byte_builder(s.pixels.len)
    for value in s.pixels { bytes.write_byte(int(value)) }
    raw := bytes.to_string()
    encoded := png.encode_rgba_bytes(&raw, s.width, s.height) >>>
    write_file(path, encoded) >>>
    << 0
}

pub fn (s $&Session) acquire_frame() gpu.Frame {
    s.alive() >>>
    if s.devices.len == 0 || s.surfaces.len == 0 { >> errors.new("present: GPU window surface is unavailable") }
    << s.surfaces[0].acquire() >>>
}

pub fn (s $&Session) present_software() int {
    s.alive() >>>
    if s.mode == MODE_GPU { >> errors.new("present: present_software cannot be used in GPU mode") }
    if s.mode == MODE_SOFTWARE && s.windows.len > 0 {
        s.windows[0].present_rgba(&s.pixels, s.width, s.height) >>>
    }
    << 0
}

pub fn (s &Session) poll() events.Event {
    s.alive() >>>
    if s.windows.len == 0 { << events.empty() }
    << s.windows[0].poll() >>>
}

fn close_surface(surf $&gpu.Surface) string {
    surf.close() >>> (err) { << err.msg() }
    << ""
}

fn close_dev(dev $&gpu.Device) string {
    dev.close() >>> (err) { << err.msg() }
    << ""
}

fn close_win(win $&window.Window) string {
    win.close() >>> (err) { << err.msg() }
    << ""
}

pub fn (s $&Session) close() int {
    if s.closed { << 0 }
    $err_msg := ""
    if s.surfaces.len > 0 {
        e := close_surface($&s.surfaces[0])
        if err_msg.len == 0 && e.len > 0 { err_msg = e }
    }
    if s.devices.len > 0 {
        e := close_dev($&s.devices[0])
        if err_msg.len == 0 && e.len > 0 { err_msg = e }
    }
    if s.windows.len > 0 {
        e := close_win($&s.windows[0])
        if err_msg.len == 0 && e.len > 0 { err_msg = e }
    }
    s.surfaces = []gpu.Surface{}
    s.devices = []gpu.Device{}
    s.windows = []window.Window{}
    s.pixels = []u8{}
    s.closed = true
    if err_msg.len > 0 { >> errors.new(err_msg) }
    << 0
}

fn (s $&Session) drop() {
    s.close() >>> (err) { << }
}
