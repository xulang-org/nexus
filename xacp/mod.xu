@"github.com/xulang-org/game/xacp"

game #"github.com/xulang-org/game"
#os
#strconv
#errors

// XACP (Xu Agent Control Protocol) Game Engine Adapter
//
// Provides full compliance with the XACP/1 specification for 2D games:
// - Protocol framing and handshake (xacp.hello, nonce replay checking, token auth)
// - Process state inspection (proc.status)
// - 2D scene tree hierarchy inspection and paging (ui.tree)
// - Hardware GPU screenshot capture via PNG (ui.screenshot)
// - Automated keyboard & pointer input feeding (ui.input)
// - Interactive control actions like pause/resume (ui.act)
// - Stepping and frame-by-frame simulation control for AI agents (game.step, game.state)

pub const VERSION = "0.1.0"
pub const DEFAULT_PORT = 19876

// Automatically parse command line arguments for --xacp-port or --xacp-tcp.
// Returns the configured port, or 0 if XACP is not enabled via command line.
pub fn parse_cli_port() int {
    args := os.args()
    $i := 1
    while i < args.len {
        arg := args[i]
        if arg == "--" { <- }
        if arg == "--xacp-tcp" {
            << DEFAULT_PORT
        }
        if arg == "--xacp-port" {
            if i + 1 < args.len {
                port_str := args[i + 1]
                port := strconv.atoi(&port_str) or (err) { << DEFAULT_PORT }
                if port > 0 && port <= 65535 { << port }
            }
            << DEFAULT_PORT
        }
        i = i + 1
    }
    << 0
}
