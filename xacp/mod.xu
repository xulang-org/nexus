@"github.com/xulang-org/nexus/xacp"

#os
#strconv
#errors

// XACP (Xu Agent Control Protocol) Game Engine Adapter
//
// Provides XACP/1 inspection and control for Nexus 2D/3D/Group SceneTrees, UI mirrors,
// diagnostics logs/CVars, and frame profilers:
// - Protocol framing, handshake, request IDs, nonce replay, timeouts, and XU_XACP_TOKEN (xacp.hello)
// - Process state and bounded output ring/logger inspection (proc.status, proc.output)
// - SceneTree + UiNodeSnapshot inspection with scopes, subtree/focus filters, and revisions (ui.tree)
// - Hardware GPU screenshot capture via PNG with frame-budget & error reporting (ui.screenshot)
// - Keyboard, pointer, wheel, and modifier input injection with structured feedback (ui.input)
// - Scene pause/resume and UI widget actions (ui.act)
// - Synchronous/deferred stepping, runtime metrics, and CVar console control (nexus.step, nexus.state, nexus.cvar)

pub const VERSION = "0.2.0"
pub const DEFAULT_PORT = 19876

// Automatically parse command line arguments for --xacp-port or --xacp-tcp.
// Returns the configured port, or 0 if XACP is not enabled via command line.
pub fn parse_cli_port() int {
    args := os.args()
    $i := 1
    while i < args.len {
        arg := args[i]
        if arg == "--" { <- }
        if arg == "--xacp-tcp" {
            << DEFAULT_PORT
        }
        if arg == "--xacp-port" {
            if i + 1 < args.len {
                port_str := args[i + 1]
                port := strconv.atoi(&port_str) >>> (err) { << DEFAULT_PORT }
                if port > 0 && port <= 65535 { << port }
            }
            << DEFAULT_PORT
        }
        i = i + 1
    }
    << 0
}
