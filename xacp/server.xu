@"github.com/xulang-org/nexus/xacp"

scene #"github.com/xulang-org/nexus/scene"
controls #"github.com/xulang-org/nexus/input"
#encoding/xun
#net
#os
#strconv
#strings
#errors
#time

struct FrameReader {
    fd int
    remainder string
    stop chan int
    stopped bool
}

fn new_frame_reader(fd int, stop chan int) FrameReader {
    << FrameReader{fd: fd, remainder: "", stop: stop, stopped: false}
}

fn should_stop(stop chan int) bool {
    select {
        _ := <-stop { << true }
        else {}
    }
    << false
}

fn tokens_equal(a &string, b &string) bool {
    if a.len != b.len { << false }
    $diff := 0
    for i in 0:a.len {
        diff = diff | ((a[i] & 255) ^ (b[i] & 255))
    }
    << diff == 0
}

fn (r $&FrameReader) wait_readable() int {
    while true {
        if should_stop(r.stop) {
            r.stopped = true
            >> errors.new("xacp: stopped")
        }
        ready := os.socket_poll(r.fd, 1) or >>
        if ready != 0 { << 0 }
        time.sleep(2000000)
    }
    << 0
}

fn (r $&FrameReader) read_line() string {
    while true {
        idx := strings.index_byte(&r.remainder, 10)
        if idx >= 0 {
            line := r.remainder[0:idx]
            r.remainder = r.remainder[idx + 1:r.remainder.len]
            if line.len > 0 && line[line.len - 1] == 13 {
                << line[0:line.len - 1]
            }
            << line
        }
        r.wait_readable() or >>
        chunk := os.socket_read(r.fd, 4096) or >>
        if chunk.len == 0 {
            >> errors.new("EOF")
        }
        r.remainder = r.remainder + chunk
    }
}

fn (r $&FrameReader) read_bytes(count int) string {
    while r.remainder.len < count {
        r.wait_readable() or >>
        chunk := os.socket_read(r.fd, 4096) or >>
        if chunk.len == 0 {
            >> errors.new("EOF")
        }
        r.remainder = r.remainder + chunk
    }
    body := r.remainder[0:count]
    r.remainder = r.remainder[count:r.remainder.len]
    << body
}

fn (r $&FrameReader) read_frame() string {
    magic := r.read_line() or >>
    if magic != "XACP/1" {
        >> errors.new("invalid XACP/1 magic line: " + magic)
    }
    len_line := r.read_line() or >>
    length := strconv.atoi(&len_line) or >>
    if length <= 0 || length > 1048576 {
        >> errors.new("invalid XACP/1 frame length")
    }
    body := r.read_bytes(length) or >>
    << body
}

fn write_frame(fd int, body string) int {
    header := "XACP/1\n" + str(body.len) + "\n"
    full := header + body
    $offset := 0
    while offset < full.len {
        $chunk_end := offset + 1024
        if chunk_end > full.len { chunk_end = full.len }
        n := os.socket_write(fd, full[offset:chunk_end]) or >>
        if n <= 0 { >> errors.new("xacp: socket write error") }
        offset += n
    }
    << 0
}

fn write_error_frame(fd int, id int, code string, msg string) int {
    res := "id: !i " + str(id) + "\n" +
        "ok: !b false\n" +
        "error:\n" +
        "  code: " + code + "\n" +
        "  msg: " + quote_xun_string(&msg) + "\n"
    << write_frame(fd, res) or >>
}

// Returns 1 if interrupted by control shutdown, 0 on normal disconnect/EOF.
fn run_peer_session(peer int, expected_token string, jobs chan GameJob, stop chan int) int {
    $reader := new_frame_reader(peer, stop)
    requires_token := expected_token.len > 0
    $authenticated := !requires_token
    $perms := 0
    $perm_label := "none"
    if authenticated {
        perms = 31
        perm_label = "development"
    }

    while true {
        body := reader.read_frame() or (err) {
            if reader.stopped { << 1 }
            << 0
        }
        doc := xun.parse(&body)
        if !doc.ok() {
            write_error_frame(peer, 0, "frame_error", "invalid XUN body") or (err) { << 0 }
            ->
        }
        root := doc.root()
        id_node := doc.get(root, "id")
        op_node := doc.get(root, "op")
        if id_node < 0 || op_node < 0 {
            write_error_frame(peer, 0, "frame_error", "missing id or op") or (err) { << 0 }
            ->
        }
        req_id := doc.as_int(id_node)
        req_op := doc.text(op_node)
        req_args := doc.get(root, "args")

        if req_op == "xacp.hello" {
            $nonce := ""
            $client_token := ""
            if req_args >= 0 {
                nonce_node := doc.get(req_args, "nonce")
                if nonce_node >= 0 { nonce = doc.text(nonce_node) }
                token_node := doc.get(req_args, "token")
                if token_node >= 0 { client_token = doc.text(token_node) }
            }

            if requires_token {
                if !tokens_equal(&client_token, &expected_token) {
                    write_error_frame(peer, req_id, "auth_failed", "invalid token") or (err) { << 0 }
                    << 0
                }
            }
            authenticated = true
            perms = 31
            perm_label = "development"

            hello_res := "id: !i " + str(req_id) + "\n" +
                "ok: !b true\n" +
                "data:\n" +
                "  ver: !ver 1.0.0\n" +
                "  nonce: " + quote_xun_string(&nonce) + "\n" +
                "  permissions: !i " + str(perms) + "\n" +
                "  permission_label: " + quote_xun_string(&perm_label) + "\n" +
                "  target: \"nexus\"\n" +
                "  engine: \"github.com/xulang-org/nexus\"\n"
            write_frame(peer, hello_res) or (err) { << 0 }
            ->
        }

        if requires_token && !authenticated {
            write_error_frame(peer, req_id, "auth_required", "xacp.hello authentication required") or (err) { << 0 }
            ->
        }

        if req_op == "proc.status" {
            status_res := "id: !i " + str(req_id) + "\n" +
                "ok: !b true\n" +
                "data:\n" +
                "  pid: !i " + str(os.getpid()) + "\n" +
                "  state: \"OPEN\"\n"
            write_frame(peer, status_res) or (err) { << 0 }
            ->
        }

        if should_stop(stop) { << 1 }
        reply_chan := chan GameReply{cap: 1}
        jobs <- GameJob{
            id: req_id,
            op: req_op + "",
            body: body + "",
            permissions: perms,
            reply: reply_chan
        }

        $reply := GameReply{ok: false, err_code: "closed", err_msg: "xacp control closed", data: ""}
        select {
            r := <-reply_chan {
                reply = r
            }
            _ := <-stop {
                << 1
            }
        }
        if reply.ok {
            res := "id: !i " + str(req_id) + "\n" +
                "ok: !b true\n" +
                "data:\n" +
                reply.data
            write_frame(peer, res) or (err) { << 0 }
        } else {
            write_error_frame(peer, req_id, reply.err_code, reply.err_msg) or (err) { << 0 }
        }
    }
    << 0
}

fn tcp_server_worker(lfd int, expected_token string, jobs chan GameJob, stop chan int, done chan int) int {
    while true {
        if should_stop(stop) { <- }
        ready := os.socket_poll(lfd, 1) or (err) { <- }
        if ready == 0 {
            time.sleep(2000000)
            ->
        }
        peer := net.accept(lfd) or (err) { <- }
        session_rc := run_peer_session(peer, expected_token + "", jobs, stop)
        os.socket_close(peer) or (ce) {
            if session_rc != 0 { <- }
            ->
        }
        if session_rc != 0 { <- }
    }
    _ := os.socket_close(lfd) or (ce) { << 0 }
    done <- 1
    << 0
}

fn parse_bound_port(addr &string, fallback int) int {
    idx := strings.last_index_byte(addr, 58)
    if idx < 0 || idx + 1 >= addr.len { << fallback }
    tail := addr[idx + 1:addr.len]
    parsed := strconv.atoi(&tail) or (err) { << fallback }
    << parsed
}

fn attach_tcp_internal(port int, expected_token string) GameControl {
    if port < 0 || port > 65535 {
        << inactive()
    }
    lfd := net.listen("127.0.0.1:" + str(port)) or (err) {
        << inactive()
    }
    $actual_port := port
    if actual_port == 0 {
        raw_addr := os.getsockname(lfd) or (err) {
            _ := os.socket_close(lfd) or (ce) { << inactive() }
            << inactive()
        }
        bound_addr := net.unpack_sockaddr(raw_addr)
        actual_port = parse_bound_port(&bound_addr, port)
    }
    jobs := chan GameJob{cap: 1}
    done := chan int{cap: 1}
    stop := chan int{cap: 1}
    dummy_reply := chan GameReply{cap: 1}
    dummy_job := GameJob{id: 0, op: "", body: "", permissions: 0, reply: dummy_reply}
    xu tcp_server_worker(lfd, expected_token + "", jobs, stop, done)
    << GameControl{
        jobs: jobs,
        done: done,
        stop: stop,
        stopped: false,
        active: true,
        paused: false,
        steps_remaining: 0,
        port: actual_port,
        canvas_width: 960,
        canvas_height: 640,
        has_screenshot_job: false,
        screenshot_job: dummy_job
    }
}

pub fn attach_tcp(port int) GameControl {
    << attach_tcp_internal(port, os.getenv("XU_XACP_TOKEN"))
}

pub fn attach_tcp_with_token(port int, token string) GameControl {
    << attach_tcp_internal(port, token + "")
}

pub fn (ctrl $&GameControl) poll(tree $&scene.SceneTree, input $&controls.InputMap) bool {
    if !ctrl.active { << false }
    select {
        job := <-ctrl.jobs {
            reply := ctrl.dispatch_job(&job, tree, input)
            if reply.err_code == "deferred" {
                << true
            }
            job.reply <- reply
            << true
        }
        else {}
    }
    << false
}
