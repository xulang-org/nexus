@"github.com/xulang-org/nexus/timing"

#encoding/json
#errors
#math
#strconv
#strings

pub struct ScopeBudget {
    pub name string
    pub max_avg_ms f64
    pub max_peak_ms f64
}

pub struct PerfBudget {
    pub profile_name string
    pub max_avg_ms f64
    pub max_p95_ms f64
    pub max_p99_ms f64
    pub min_samples int
    pub max_regression_ratio f64
    pub scope_budgets []ScopeBudget
}

pub struct PerfViolation {
    pub metric string
    pub actual f64
    pub limit f64
    pub message string
}

pub struct PerfGateReport {
    pub profile_name string
    pub passed bool
    pub frame_count int
    pub summary ProfilerSummary
    pub violations []PerfViolation
}

pub fn budget_desktop_60fps() PerfBudget {
    << PerfBudget{
        profile_name: "desktop_60fps",
        max_avg_ms: 14.0,
        max_p95_ms: 16.67,
        max_p99_ms: 20.0,
        min_samples: 10,
        max_regression_ratio: 0.10,
        scope_budgets: []ScopeBudget{}
    }
}

pub fn budget_console_120fps() PerfBudget {
    << PerfBudget{
        profile_name: "console_120fps",
        max_avg_ms: 7.0,
        max_p95_ms: 8.33,
        max_p99_ms: 10.5,
        min_samples: 10,
        max_regression_ratio: 0.10,
        scope_budgets: []ScopeBudget{}
    }
}

