@"github.com/xulang-org/nexus/formats/stl"

mesh #"github.com/xulang-org/nexus/resources/mesh"
fm #"github.com/xulang-org/nexus/foundation/math"
#strings
#strconv
#unicode/utf8
#encoding/binary
#errors

pub const MAX_BYTES = 16777216
fn number(token &string) f64 {
    value := strconv.parse_float(token) or >>
    if !fm.finite(value) { >> errors.new("nexus STL: non-finite number") }
    << value
}
fn append_triangle(output $&mesh.MeshData3D,a fm.Vec3,b fm.Vec3,c fm.Vec3) int {
    if output.vertex_count()>mesh.MAX_VERTICES-3 { >> errors.new("nexus STL: vertex budget exceeded") }
    normal := mesh.triangle_normal(a,b,c) or >>
    first := output.vertex_count()
    for p in [a,b,c] { output.vertex_lit(p,4294967295,normal) or >> }
    output.triangle(first,first+1,first+2) or >>
    << 0
}
fn binary_decode(raw &string,count int) mesh.MeshData3D {
    if count<1 || count>mesh.MAX_VERTICES/3 || raw.len!=84+count*50 { >> errors.new("nexus STL: invalid binary triangle count/length") }
    $bytes := []u8{}
    for i in 0:raw.len { bytes.push(u8(raw[i])) }
    $output := mesh.new_mesh_data_3d()
    for i in 0:count {
        at := 84+i*50
        if (binary.little_endian().get_u16_bytes(&bytes,at+48) or >>)!=0 { >> errors.new("nexus STL: binary attributes/colors unsupported") }
        $values := []f64{}
        for j in 0:12 {
            value := binary.little_endian().get_f32(&bytes,at+j*4) or >>
            if !fm.finite(value) { >> errors.new("nexus STL: non-finite binary coordinate/normal") }
            values.push(value)
        }
        append_triangle($&output,fm.vec3(values[3],values[4],values[5]),fm.vec3(values[6],values[7],values[8]),fm.vec3(values[9],values[10],values[11])) or >>
    }
    output.validate() or >>
    << output
}
fn ascii_decode(raw &string) mesh.MeshData3D {
    if !utf8.valid(raw) { >> errors.new("nexus STL: invalid text") }
    $output := mesh.new_mesh_data_3d()
    $state := 0
    $name := ""
    $points := []fm.Vec3{}
    $offset := 0
    $lines := 0
    while offset<raw.len {
        start := offset
        while offset<raw.len && raw[offset]!=10 {
            if raw[offset]==0 || offset-start>=65536 { >> errors.new("nexus STL: NUL or oversized line") }
            offset+=1
        }
        part := raw[start:offset]+""
        line := strings.trim_space(&part)
        offset+=1
        lines+=1
        if lines>1048576 { >> errors.new("nexus STL: line budget exceeded") }
        tokens := strings.fields(&line)
        if tokens.len==0 { -> }
        if state==0 {
            if tokens[0]!="solid" { >> errors.new("nexus STL: expected solid header") }
            tail := line[5:]+""
            name=strings.trim_space(&tail)
            state=1
        } else if state==1 {
            if tokens[0]=="endsolid" {
                tail := line[8:]+""
                end_name := strings.trim_space(&tail)
                if end_name.len>0 && end_name!=name { >> errors.new("nexus STL: solid names differ") }
                state=8
            } else {
                if tokens.len!=5 || tokens[0]!="facet" || tokens[1]!="normal" { >> errors.new("nexus STL: expected facet normal") }
                for i in 2:5 { number(&tokens[i]) or >> }
                points=[]fm.Vec3{}
                state=2
            }
        } else if state==2 {
            if tokens.len!=2 || tokens[0]!="outer" || tokens[1]!="loop" { >> errors.new("nexus STL: expected outer loop") }
            state=3
        } else if state>=3 && state<=5 {
            if tokens.len!=4 || tokens[0]!="vertex" { >> errors.new("nexus STL: expected three vertices") }
            points.push(fm.vec3(number(&tokens[1]) or >>,number(&tokens[2]) or >>,number(&tokens[3]) or >>))
            state+=1
        } else if state==6 {
            if tokens.len!=1 || tokens[0]!="endloop" { >> errors.new("nexus STL: expected endloop") }
            state=7
        } else if state==7 {
            if tokens.len!=1 || tokens[0]!="endfacet" { >> errors.new("nexus STL: expected endfacet") }
            append_triangle($&output,points[0],points[1],points[2]) or >>
            state=1
        } else { >> errors.new("nexus STL: trailing content after endsolid") }
    }
    if state!=8 { >> errors.new("nexus STL: truncated ASCII solid") }
    output.validate() or >>
    << output
}
// Binary layout wins over a textual 'solid' prefix: binary headers are opaque.
// Facet normals are regenerated from winding in both variants; finite supplied
// normals are accepted, including zero. No vendor color/attribute interpretation.
pub fn decode(raw &string) mesh.MeshData3D {
    if raw.len<1 || raw.len>MAX_BYTES { >> errors.new("nexus STL: byte budget exceeded or empty input") }
    if raw.len>=84 {
        bytes := [u8(raw[80]),u8(raw[81]),u8(raw[82]),u8(raw[83])]
        count := binary.little_endian().get_u32_bytes(&bytes,0) or >>
        if count<=mesh.MAX_VERTICES/3 && raw.len==84+count*50 { << binary_decode(raw,count) or >> }
    }
    << ascii_decode(raw) or >>
}
