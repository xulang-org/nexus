@"github.com/xulang-org/nexus/formats/wav"

#errors

pub const MAX_STREAM_BYTES = 2147483648
pub struct Layout {
    total int
    offset int
    bytes int
    rate int
    channels int
    bits int
    encoding int
    alignment int
}
pub fn (layout &Layout) validate() int {
    if layout.total < 44 || layout.total > MAX_STREAM_BYTES || layout.offset < 12 || layout.offset > layout.total ||
        layout.bytes < 1 || layout.bytes > layout.total - layout.offset || layout.rate < 8000 || layout.rate > 192000 ||
        layout.channels < 1 || layout.channels > 2 || (layout.encoding != 1 && layout.encoding != 3) ||
        (layout.encoding == 3 && layout.bits != 32) || (layout.bits != 8 && layout.bits != 16 && layout.bits != 24 && layout.bits != 32) ||
        layout.alignment != layout.channels * (layout.bits / 8) { >>> errors.new("nexus WAV: invalid layout") }
    alignment := layout.alignment
    if alignment == 0 { >>> errors.new("nexus WAV: zero layout alignment") }
    if layout.bytes % alignment != 0 { >>> errors.new("nexus WAV: data is not frame aligned") }
    << 0
}
pub fn (layout &Layout) sample_rate() int { << layout.rate }
pub fn (layout &Layout) channel_count() int { << layout.channels }
pub fn (layout &Layout) bytes_per_frame() int { << layout.alignment }
pub fn (layout &Layout) data_offset() int { << layout.offset }
pub fn (layout &Layout) total_bytes() int { << layout.total }
pub fn (layout &Layout) frame_count() int {
    alignment := layout.alignment
    if alignment == 0 { << 0 }
    << layout.bytes / alignment
}
pub struct LayoutParser {
    layout Layout
    position int
    chunks int
    saw_format bool
    saw_data bool
}
pub fn begin_layout(header &string, extent int) LayoutParser {
    if header.len != 12 || extent < 44 || extent > MAX_STREAM_BYTES { >>> errors.new("nexus WAV: invalid container extent") }
    if !tag(header, 0, "RIFF") || !tag(header, 8, "WAVE") || read32(header, 4) != extent - 8 { >>> errors.new("nexus WAV: invalid RIFF/WAVE extent") }
    layout := Layout{total: extent, offset: 0, bytes: 0, rate: 0, channels: 0, bits: 0, encoding: 0, alignment: 0}
    << LayoutParser{layout: layout, position: 12, chunks: 0, saw_format: false, saw_data: false}
}
pub fn (parser &LayoutParser) position() int { << parser.position }
pub fn (parser &LayoutParser) done() bool { << parser.position == parser.layout.total }
// Preflight before a loader reads any payload: only fmt needs at most 18 bytes.
pub fn (parser &LayoutParser) format_bytes(header &string) int {
    if header.len != 8 || parser.chunks >= 256 || parser.position < 12 || parser.layout.total - parser.position < 8 {
        >>> errors.new("nexus WAV: invalid chunk table")
    }
    size := read32(header, 4)
    room := parser.layout.total - parser.position - 8
    if size > room || size % 2 > room - size { >>> errors.new("nexus WAV: chunk exceeds RIFF extent") }
    if tag(header, 0, "fmt ") {
        if parser.saw_format || (size != 16 && size != 18) { >>> errors.new("nexus WAV: unsupported or duplicate fmt chunk") }
        << size
    }
    if tag(header, 0, "data") && parser.saw_data { >>> errors.new("nexus WAV: duplicate data chunk") }
    << 0
}
pub fn (parser $&LayoutParser) accept(header &string, payload &string) int {
    required := parser.format_bytes(header) >>>
    if payload.len != required { >>> errors.new("nexus WAV: invalid format payload extent") }
    size := read32(header, 4)
    if required > 0 {
        if required == 18 && read16(payload, 16) != 0 { >>> errors.new("nexus WAV: extended format unsupported") }
        encoding := read16(payload, 0)
        channels := read16(payload, 2)
        rate := read32(payload, 4)
        alignment := read16(payload, 12)
        bits := read16(payload, 14)
        if channels < 1 || channels > 2 || rate < 8000 || rate > 192000 || (encoding != 1 && encoding != 3) ||
            (encoding == 3 && bits != 32) || (bits != 8 && bits != 16 && bits != 24 && bits != 32) ||
            alignment != channels * (bits / 8) || read32(payload, 8) != rate * alignment {
            >>> errors.new("nexus WAV: unsupported encoding or invalid rate/alignment")
        }
        parser.layout.encoding = encoding
        parser.layout.channels = channels
        parser.layout.rate = rate
        parser.layout.alignment = alignment
        parser.layout.bits = bits
        parser.saw_format = true
    } else if tag(header, 0, "data") {
        parser.layout.offset = parser.position + 8
        parser.layout.bytes = size
        parser.saw_data = true
    }
    parser.position = parser.position + 8 + size + size % 2
    parser.chunks = parser.chunks + 1
    << 0
}
pub fn (parser &LayoutParser) finish() Layout {
    if !parser.done() || !parser.saw_format || !parser.saw_data { >>> errors.new("nexus WAV: incomplete chunk layout") }
    parser.layout.validate() >>>
    << parser.layout
}
