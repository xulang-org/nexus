@"github.com/xulang-org/nexus/formats/wav"

#errors
#math

pub const MAX_STREAM_BYTES = 2147483648
pub const ENCODING_PCM = 1
pub const ENCODING_FLOAT = 3
pub const ENCODING_IMA_ADPCM = 17
pub struct Layout {
    total int
    offset int
    bytes int
    rate int
    channels int
    bits int
    encoding int
    alignment int
    samples_per_block int
    fact_frames int
}
pub fn (layout &Layout) validate() int {
    if layout.total < 44 || layout.total > MAX_STREAM_BYTES || layout.offset < 12 || layout.offset > layout.total ||
        layout.bytes < 1 || layout.bytes > layout.total - layout.offset || layout.rate < 8000 || layout.rate > 192000 ||
        layout.channels < 1 || layout.channels > 2 {
        >> errors.new("nexus WAV: invalid layout")
    }
    if layout.encoding == ENCODING_IMA_ADPCM {
        ch := layout.channels
        hdr := 4 * ch
        if ch < 1 || hdr < 4 || layout.alignment < hdr * 2 { >> errors.new("nexus WAV: invalid IMA ADPCM alignment") }
        expected_spb := ((layout.alignment - hdr) * 2) / ch + 1
        if layout.bits != 4 || (layout.alignment - hdr) % hdr != 0 ||
            layout.samples_per_block != expected_spb || layout.samples_per_block < 9 ||
            layout.bytes % layout.alignment != 0 {
            >> errors.new("nexus WAV: invalid IMA ADPCM layout")
        }
        blocks := layout.bytes / layout.alignment
        if blocks < 1 || layout.fact_frames < 0 || layout.fact_frames > blocks * layout.samples_per_block {
            >> errors.new("nexus WAV: invalid IMA ADPCM block or frame count")
        }
        << 0
    }
    if (layout.encoding != ENCODING_PCM && layout.encoding != ENCODING_FLOAT) ||
        (layout.encoding == ENCODING_FLOAT && layout.bits != 32) || (layout.bits != 8 && layout.bits != 16 && layout.bits != 24 && layout.bits != 32) ||
        layout.alignment != layout.channels * (layout.bits / 8) || layout.samples_per_block != 0 {
        >> errors.new("nexus WAV: invalid layout")
    }
    alignment := layout.alignment
    if alignment == 0 { >> errors.new("nexus WAV: zero layout alignment") }
    if layout.bytes % alignment != 0 { >> errors.new("nexus WAV: data is not frame aligned") }
    << 0
}
pub fn (layout &Layout) encoding_tag() int { << layout.encoding }
pub fn (layout &Layout) block_samples() int { << layout.samples_per_block }
pub fn (layout &Layout) sample_rate() int { << layout.rate }
pub fn (layout &Layout) channel_count() int { << layout.channels }
pub fn (layout &Layout) bytes_per_frame() int { << layout.alignment }
pub fn (layout &Layout) data_offset() int { << layout.offset }
pub fn (layout &Layout) total_bytes() int { << layout.total }
pub fn (layout &Layout) frame_count() int {
    alignment := layout.alignment
    if alignment == 0 { << 0 }
    if layout.encoding == ENCODING_IMA_ADPCM {
        if layout.fact_frames > 0 { << layout.fact_frames }
        << (layout.bytes / alignment) * layout.samples_per_block
    }
    << layout.bytes / alignment
}
pub struct LayoutParser {
    layout Layout
    position int
    chunks int
    saw_format bool
    saw_data bool
    saw_fact bool
}
pub fn begin_layout(header &string, extent int) LayoutParser {
    if header.len != 12 || extent < 44 || extent > MAX_STREAM_BYTES { >> errors.new("nexus WAV: invalid container extent") }
    if !tag(header, 0, "RIFF") || !tag(header, 8, "WAVE") || read32(header, 4) != extent - 8 { >> errors.new("nexus WAV: invalid RIFF/WAVE extent") }
    layout := Layout{total: extent, offset: 0, bytes: 0, rate: 0, channels: 0, bits: 0, encoding: 0, alignment: 0, samples_per_block: 0, fact_frames: 0}
    << LayoutParser{layout: layout, position: 12, chunks: 0, saw_format: false, saw_data: false, saw_fact: false}
}
pub fn (parser &LayoutParser) position() int { << parser.position }
pub fn (parser &LayoutParser) done() bool { << parser.position == parser.layout.total }
// Preflight before a loader reads any payload: fmt takes 16/18/20 bytes, optional fact takes 4 bytes.
pub fn (parser &LayoutParser) format_bytes(header &string) int {
    if header.len != 8 || parser.chunks >= 256 || parser.position < 12 || parser.layout.total - parser.position < 8 {
        >> errors.new("nexus WAV: invalid chunk table")
    }
    size := read32(header, 4)
    room := parser.layout.total - parser.position - 8
    if size > room || size % 2 > room - size { >> errors.new("nexus WAV: chunk exceeds RIFF extent") }
    if tag(header, 0, "fmt ") {
        if parser.saw_format || (size != 16 && size != 18 && size != 20) { >> errors.new("nexus WAV: unsupported or duplicate fmt chunk") }
        << size
    }
    if tag(header, 0, "fact") {
        if parser.saw_fact || size != 4 { >> errors.new("nexus WAV: unsupported or duplicate fact chunk") }
        << 4
    }
    if tag(header, 0, "data") && parser.saw_data { >> errors.new("nexus WAV: duplicate data chunk") }
    << 0
}
pub fn (parser $&LayoutParser) accept(header &string, payload &string) int {
    required := parser.format_bytes(header) or >>
    if payload.len != required { >> errors.new("nexus WAV: invalid format payload extent") }
    size := read32(header, 4)
    if tag(header, 0, "fmt ") {
        encoding := read16(payload, 0)
        channels := read16(payload, 2)
        rate := read32(payload, 4)
        byte_rate := read32(payload, 8)
        alignment := read16(payload, 12)
        bits := read16(payload, 14)
        if encoding == ENCODING_IMA_ADPCM {
            if required != 20 || read16(payload, 16) != 2 || channels < 1 || channels > 2 ||
                rate < 8000 || rate > 192000 || bits != 4 {
                >> errors.new("nexus WAV: unsupported IMA ADPCM header")
            }
            spb := read16(payload, 18)
            hdr := 4 * channels
            if spb < 9 || hdr < 4 || alignment < hdr * 2 || (alignment - hdr) % hdr != 0 {
                >> errors.new("nexus WAV: invalid IMA ADPCM block alignment")
            }
            expected_spb := ((alignment - hdr) * 2) / channels + 1
            if spb != expected_spb {
                >> errors.new("nexus WAV: invalid IMA ADPCM block alignment")
            }
            expected_bps := int(math.round_to_even(f64(rate) * f64(alignment) / f64(spb)))
            if byte_rate < 1 || math.abs(f64(byte_rate - expected_bps)) > f64(alignment) {
                >> errors.new("nexus WAV: invalid IMA ADPCM byte rate")
            }
            parser.layout.encoding = encoding
            parser.layout.channels = channels
            parser.layout.rate = rate
            parser.layout.alignment = alignment
            parser.layout.bits = bits
            parser.layout.samples_per_block = spb
            parser.saw_format = true
        } else {
            if required == 20 { >> errors.new("nexus WAV: 20-byte fmt requires IMA ADPCM encoding") }
            if required == 18 && read16(payload, 16) != 0 { >> errors.new("nexus WAV: extended format unsupported") }
            if channels < 1 || channels > 2 || rate < 8000 || rate > 192000 ||
                (encoding != ENCODING_PCM && encoding != ENCODING_FLOAT) ||
                (encoding == ENCODING_FLOAT && bits != 32) || (bits != 8 && bits != 16 && bits != 24 && bits != 32) ||
                alignment != channels * (bits / 8) || byte_rate != rate * alignment {
                >> errors.new("nexus WAV: unsupported encoding or invalid rate/alignment")
            }
            parser.layout.encoding = encoding
            parser.layout.channels = channels
            parser.layout.rate = rate
            parser.layout.alignment = alignment
            parser.layout.bits = bits
            parser.layout.samples_per_block = 0
            parser.saw_format = true
        }
    } else if tag(header, 0, "fact") {
        parser.layout.fact_frames = read32(payload, 0)
        parser.saw_fact = true
    } else if tag(header, 0, "data") {
        parser.layout.offset = parser.position + 8
        parser.layout.bytes = size
        parser.saw_data = true
    }
    parser.position = parser.position + 8 + size + size % 2
    parser.chunks = parser.chunks + 1
    << 0
}
pub fn (parser &LayoutParser) finish() Layout {
    if !parser.done() || !parser.saw_format || !parser.saw_data { >> errors.new("nexus WAV: incomplete chunk layout") }
    parser.layout.validate() or >>
    << parser.layout
}
