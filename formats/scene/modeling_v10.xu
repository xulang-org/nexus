@"github.com/xulang-org/nexus/formats/scene"

resource #"github.com/xulang-org/nexus/resources/scene"
rm #"github.com/xulang-org/nexus/resources/modeling"
#encoding/json
#strings

fn decode_editable_meshes_v10(doc &json.Doc, root int, version int) []resource.EditableMeshAttachment {
    if version < MODELING_VERSION { << []resource.EditableMeshAttachment{} }
    rows := rows_min(doc, doc.get(root, "editable_meshes"), 0, resource.MAX_SCENE_EDITABLE_MESHES) or >>
    expected := ["node", "mesh"]
    $out := []resource.EditableMeshAttachment{}
    for at in rows {
        fields(doc, at, &expected) or >>
        node := doc.as_int(doc.get(at, "node")) or >>
        mesh := rm.decode_editable_mesh_node(doc, doc.get(at, "mesh")) or >>
        out.push(resource.editable_mesh_attachment(node, mesh))
    }
    << out
}

fn decode_csg_trees_v10(doc &json.Doc, root int, version int) []resource.CsgTreeAttachment {
    if version < MODELING_VERSION { << []resource.CsgTreeAttachment{} }
    rows := rows_min(doc, doc.get(root, "csg_brushes"), 0, resource.MAX_SCENE_CSG_TREES) or >>
    expected := ["node", "tree"]
    $out := []resource.CsgTreeAttachment{}
    for at in rows {
        fields(doc, at, &expected) or >>
        node := doc.as_int(doc.get(at, "node")) or >>
        tree := rm.decode_csg_tree_node(doc, doc.get(at, "tree")) or >>
        out.push(resource.csg_tree_attachment(node, tree))
    }
    << out
}

fn decode_material_overrides_v10(doc &json.Doc, root int, version int) []resource.MaterialOverrideAttachment {
    if version < MODELING_VERSION { << []resource.MaterialOverrideAttachment{} }
    rows := rows_min(doc, doc.get(root, "material_overrides"), 0, resource.MAX_SCENE_MATERIAL_OVERRIDES) or >>
    expected := ["node", "slot", "material"]
    $out := []resource.MaterialOverrideAttachment{}
    for at in rows {
        fields(doc, at, &expected) or >>
        node := doc.as_int(doc.get(at, "node")) or >>
        slot := doc.as_int(doc.get(at, "slot")) or >>
        mat := rm.decode_material_asset_node(doc, doc.get(at, "material")) or >>
        out.push(resource.material_override_attachment(node, slot, mat))
    }
    << out
}

fn encode_modeling_v10(document &resource.Document) string {
    $out := strings.new_byte_builder(2048)

    out.write_str(",\"editable_meshes\":[\n")
    for i in 0:document.editable_mesh_count() {
        if i > 0 { out.write_str(",\n") }
        item := document.editable_mesh(i) or >>
        raw_m := item.mesh.encode_json()
        out.write_str("{\"node\":" + str(item.node) + ",\"mesh\":" + strings.trim_space(&raw_m) + "}")
    }

    out.write_str("\n],\"csg_brushes\":[\n")
    for i in 0:document.csg_tree_count() {
        if i > 0 { out.write_str(",\n") }
        item := document.csg_tree(i) or >>
        raw_t := item.tree.encode_json()
        out.write_str("{\"node\":" + str(item.node) + ",\"tree\":" + strings.trim_space(&raw_t) + "}")
    }

    out.write_str("\n],\"material_overrides\":[\n")
    for i in 0:document.material_override_count() {
        if i > 0 { out.write_str(",\n") }
        item := document.material_override(i) or >>
        raw_mat := item.material.encode_json()
        out.write_str("{\"node\":" + str(item.node) + ",\"slot\":" + str(item.slot) + ",\"material\":" + strings.trim_space(&raw_mat) + "}")
    }
    out.write_str("\n]")
    << out.to_string()
}
