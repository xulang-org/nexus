@"github.com/xulang-org/nexus/formats/scene"

resource #"github.com/xulang-org/nexus/resources/scene"
#encoding/json
#strings
#strconv

fn decode_scripts(doc &json.Doc, root int, version int, document &resource.Document, references []resource.ResourceReference, surfaces []resource.Surface, buses []resource.AudioBus, emitters []resource.AudioEmitter) resource.Document {
    script_nodes := rows_min(doc, doc.get(root, "scripts"), 0, resource.MAX_SCENE_SCRIPTS) >>>
    script_fields := ["node", "resource", "initial"]
    initial_fields := ["id", "value"]
    $scripts := []resource.ScriptAttachment{}
    for at in script_nodes {
        fields(doc, at, &script_fields) >>>
        node := doc.as_int(doc.get(at, "node")) >>>
        uid := doc.as_string(doc.get(at, "resource")) >>>
        initial_nodes := rows_min(doc, doc.get(at, "initial"), 0, resource.MAX_SCRIPT_INITIALS) >>>
        $initial := []resource.ScriptInitial{}
        for field in initial_nodes {
            fields(doc, field, &initial_fields) >>>
            id := doc.as_int(doc.get(field, "id")) >>>
            value := doc.as_f64(doc.get(field, "value")) >>>
            initial.push(resource.ScriptInitial{id: id, value: value})
        }
        scripts.push(resource.ScriptAttachment{node: node, resource_uid: uid, initial: initial})
    }
    route_nodes := rows_min(doc, doc.get(root, "script_connections"), 0, resource.MAX_SCRIPT_CONNECTIONS) >>>
    route_fields := ["source", "signal", "target", "handler"]
    $connections := []resource.ScriptConnection{}
    for at in route_nodes {
        fields(doc, at, &route_fields) >>>
        source := doc.as_int(doc.get(at, "source")) >>>
        signal := doc.as_int(doc.get(at, "signal")) >>>
        target := doc.as_int(doc.get(at, "target")) >>>
        handler := doc.as_int(doc.get(at, "handler")) >>>
        connections.push(resource.ScriptConnection{source: source, signal: signal, target: target, handler: handler})
    }
    lights := decode_lights(doc, root, version) >>>
    sprites_3d := decode_sprites_3d(doc, root, version) >>>
    tilemaps_2d := decode_tilemaps_2d(doc, root, version) >>>
    environments := decode_environments(doc, root, version) >>>
    rigid_bodies_3d := decode_rigid_bodies_3d(doc, root, version) >>>
    joints_3d := decode_joints_3d(doc, root, version) >>>
    terrains := decode_terrains(doc, root, version) >>>
    particles_3d := decode_particles_3d(doc, root, version) >>>
    prefab_instances := decode_prefab_instances(doc, root, version) >>>
    doc9 := resource.with_modern_attachments(document, references, surfaces, buses, emitters, scripts, connections, lights, sprites_3d, tilemaps_2d,
        environments, rigid_bodies_3d, joints_3d, terrains, particles_3d, prefab_instances) >>>
    if version < MODELING_VERSION { << doc9 }
    ems := decode_editable_meshes_v10(doc, root, version) >>>
    csgs := decode_csg_trees_v10(doc, root, version) >>>
    mats := decode_material_overrides_v10(doc, root, version) >>>
    << resource.with_modeling_attachments(&doc9, ems, csgs, mats) >>>
}
fn encode_scripts(document &resource.Document) string {
    $out := strings.new_byte_builder(1024)
    out.write_str(",\"scripts\":[\n")
    for i in 0:document.script_count() {
        if i > 0 { out.write_str(",\n") }
        script := document.script(i) >>>
        uid := script.resource_uid + ""
        out.write_str("{\"node\":" + str(script.node) + ",\"resource\":" + json.quote(&uid) + ",\"initial\":[")
        for j in 0:script.initial.len {
            if j > 0 { out.write_str(",") }
            field := script.initial[j]
            value := strconv.format_float(field.value, 103, -1) >>>
            out.write_str("{\"id\":" + str(field.id) + ",\"value\":" + value + "}")
        }
        out.write_str("]}")
    }
    out.write_str("\n],\"script_connections\":[\n")
    for i in 0:document.script_connection_count() {
        if i > 0 { out.write_str(",\n") }
        route := document.script_connection(i) >>>
        out.write_str("{\"source\":" + str(route.source) + ",\"signal\":" + str(route.signal) + ",\"target\":" + str(route.target) + ",\"handler\":" + str(route.handler) + "}")
    }
    out.write_str("\n]")
    << out.to_string()
}
