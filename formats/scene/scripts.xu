@"github.com/xulang-org/nexus/formats/scene"

resource #"github.com/xulang-org/nexus/resources/scene"
#encoding/json
#strings
#strconv

fn decode_scripts(doc &json.Doc, root int, document &resource.Document, references []resource.ResourceReference, surfaces []resource.Surface, buses []resource.AudioBus, emitters []resource.AudioEmitter) resource.Document {
    script_nodes := rows_min(doc, doc.get(root, "scripts"), 0, resource.MAX_SCENE_SCRIPTS) or >>
    script_fields := ["node", "resource", "initial"]
    initial_fields := ["id", "value"]
    $scripts := []resource.ScriptAttachment{}
    for at in script_nodes {
        fields(doc, at, &script_fields) or >>
        node := doc.as_int(doc.get(at, "node")) or >>
        uid := doc.as_string(doc.get(at, "resource")) or >>
        initial_nodes := rows_min(doc, doc.get(at, "initial"), 0, resource.MAX_SCRIPT_INITIALS) or >>
        $initial := []resource.ScriptInitial{}
        for field in initial_nodes {
            fields(doc, field, &initial_fields) or >>
            id := doc.as_int(doc.get(field, "id")) or >>
            value := doc.as_f64(doc.get(field, "value")) or >>
            initial.push(resource.ScriptInitial{id: id, value: value})
        }
        scripts.push(resource.ScriptAttachment{node: node, resource_uid: uid, initial: initial})
    }
    route_nodes := rows_min(doc, doc.get(root, "script_connections"), 0, resource.MAX_SCRIPT_CONNECTIONS) or >>
    route_fields := ["source", "signal", "target", "handler"]
    $connections := []resource.ScriptConnection{}
    for at in route_nodes {
        fields(doc, at, &route_fields) or >>
        source := doc.as_int(doc.get(at, "source")) or >>
        signal := doc.as_int(doc.get(at, "signal")) or >>
        target := doc.as_int(doc.get(at, "target")) or >>
        handler := doc.as_int(doc.get(at, "handler")) or >>
        connections.push(resource.ScriptConnection{source: source, signal: signal, target: target, handler: handler})
    }
    lights := decode_lights(doc, root) or >>
    << resource.with_attachments(document, references, surfaces, buses, emitters, scripts, connections, lights) or >>
}
fn encode_scripts(document &resource.Document) string {
    $out := strings.new_byte_builder(1024)
    out.write_str(",\"scripts\":[\n")
    for i in 0:document.script_count() {
        if i > 0 { out.write_str(",\n") }
        script := document.script(i) or >>
        uid := script.resource_uid + ""
        out.write_str("{\"node\":" + str(script.node) + ",\"resource\":" + json.quote(&uid) + ",\"initial\":[")
        for j in 0:script.initial.len {
            if j > 0 { out.write_str(",") }
            field := script.initial[j]
            value := strconv.format_float(field.value, 103, -1) or >>
            out.write_str("{\"id\":" + str(field.id) + ",\"value\":" + value + "}")
        }
        out.write_str("]}")
    }
    out.write_str("\n],\"script_connections\":[\n")
    for i in 0:document.script_connection_count() {
        if i > 0 { out.write_str(",\n") }
        route := document.script_connection(i) or >>
        out.write_str("{\"source\":" + str(route.source) + ",\"signal\":" + str(route.signal) + ",\"target\":" + str(route.target) + ",\"handler\":" + str(route.handler) + "}")
    }
    out.write_str("\n]")
    << out.to_string()
}
