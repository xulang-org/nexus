@"github.com/xulang-org/nexus/formats/scene"

resource #"github.com/xulang-org/nexus/resources/scene"
#encoding/json
#strconv
#strings

fn decode_buses(doc &json.Doc, root int, minimum int) []resource.AudioBus {
    bus_nodes := rows_min(doc, doc.get(root, "audio_buses"), minimum, resource.MAX_AUDIO_BUSES) >>>
    bus_fields := ["parent", "name", "volume", "muted", "paused"]
    $buses := []resource.AudioBus{}
    for at in bus_nodes {
        fields(doc, at, &bus_fields) >>>
        parent := doc.as_int(doc.get(at, "parent")) >>>
        name := doc.as_string(doc.get(at, "name")) >>>
        volume := doc.as_f64(doc.get(at, "volume")) >>>
        muted := doc.as_bool(doc.get(at, "muted")) >>>
        paused := doc.as_bool(doc.get(at, "paused")) >>>
        buses.push(resource.AudioBus{parent: parent, name: name, volume: volume, muted: muted, paused: paused})
    }
    << buses
}
fn decode_emitters(doc &json.Doc, root int, minimum int) []resource.AudioEmitter {
    emitter_nodes := rows_min(doc, doc.get(root, "audio_emitters"), minimum, resource.MAX_AUDIO_EMITTERS) >>>
    emitter_fields := ["node", "resource", "bus", "volume", "pan", "looping", "autoplay", "spatial", "listener", "max_distance"]
    $emitters := []resource.AudioEmitter{}
    for at in emitter_nodes {
        fields(doc, at, &emitter_fields) >>>
        node := doc.as_int(doc.get(at, "node")) >>>
        uid := doc.as_string(doc.get(at, "resource")) >>>
        bus := doc.as_int(doc.get(at, "bus")) >>>
        volume := doc.as_f64(doc.get(at, "volume")) >>>
        pan := doc.as_f64(doc.get(at, "pan")) >>>
        looping := doc.as_bool(doc.get(at, "looping")) >>>
        autoplay := doc.as_bool(doc.get(at, "autoplay")) >>>
        spatial := doc.as_string(doc.get(at, "spatial")) >>>
        listener := doc.as_int(doc.get(at, "listener")) >>>
        maximum := doc.as_f64(doc.get(at, "max_distance")) >>>
        emitters.push(resource.AudioEmitter{node: node, resource_uid: uid, bus: bus, volume: volume, pan: pan, looping: looping,
            autoplay: autoplay, spatial: spatial, listener: listener, max_distance: maximum})
    }
    << emitters
}
fn encode_audio(document &resource.Document) string {
    $out := strings.new_byte_builder(1024)
    out.write_str(",\"audio_buses\":[\n")
    for i in 0:document.audio_bus_count() {
        if i > 0 { out.write_str(",\n") }
        bus := document.audio_bus(i) >>>
        name := bus.name + ""
        volume := strconv.format_float(bus.volume, 103, -1) >>>
        out.write_str("{\"parent\":" + str(bus.parent) + ",\"name\":" + json.quote(&name) + ",\"volume\":" + volume + ",\"muted\":" + str(bus.muted) + ",\"paused\":" + str(bus.paused) + "}")
    }
    out.write_str("\n],\"audio_emitters\":[\n")
    for i in 0:document.audio_count() {
        if i > 0 { out.write_str(",\n") }
        emitter := document.audio_emitter(i) >>>
        uid := emitter.resource_uid + ""
        spatial := emitter.spatial + ""
        volume := strconv.format_float(emitter.volume, 103, -1) >>>
        pan := strconv.format_float(emitter.pan, 103, -1) >>>
        maximum := strconv.format_float(emitter.max_distance, 103, -1) >>>
        out.write_str("{\"node\":" + str(emitter.node) + ",\"resource\":" + json.quote(&uid) + ",\"bus\":" + str(emitter.bus) + ",\"volume\":" + volume + ",\"pan\":" + pan +
            ",\"looping\":" + str(emitter.looping) + ",\"autoplay\":" + str(emitter.autoplay) + ",\"spatial\":" + json.quote(&spatial) + ",\"listener\":" + str(emitter.listener) + ",\"max_distance\":" + maximum + "}")
    }
    out.write_str("\n]")
    << out.to_string()
}
