@"github.com/xulang-org/nexus/formats/scene"

resource #"github.com/xulang-org/nexus/resources/scene"
#encoding/json
#strconv
#strings
#errors

fn type_name(kind int) string {
    if kind == resource.NODE_GROUP { << "Node" }
    if kind == resource.NODE_2D { << "Node2D" }
    << "Node3D"
}
fn process_name(mode int) string {
    if mode == resource.PROCESS_INHERIT { << "inherit" }
    if mode == resource.PROCESS_PAUSABLE { << "pausable" }
    if mode == resource.PROCESS_ALWAYS { << "always" }
    if mode == resource.PROCESS_WHEN_PAUSED { << "when_paused" }
    << "disabled"
}
fn transform(node &resource.NodeData) []f64 {
    if node.kind == resource.NODE_2D {
        t := node.local
        << [t.a, t.b, t.c, t.d, t.tx, t.ty]
    }
    m := node.local_3d
    << [m.c0.x, m.c0.y, m.c0.z, m.c0.w, m.c1.x, m.c1.y, m.c1.z, m.c1.w,
        m.c2.x, m.c2.y, m.c2.z, m.c2.w, m.c3.x, m.c3.y, m.c3.z, m.c3.w]
}
pub fn encode(document &resource.Document) string {
    if document.node_count() < 1 { >> errors.new("nexus scene: cannot encode an empty document") }
    $out := strings.new_byte_builder(4096)
    $version := LEGACY_VERSION
    out.write_str(",\"nodes\":[\n")
    for i in 0:document.node_count() {
        if i > 0 { out.write_str(",\n") }
        node := document.describe_node(i) or >>
        name := node.name + ""
        out.write_str("{\"parent\":" + str(node.parent) + ",\"name\":" + json.quote(&name) + ",\"type\":\"" + type_name(node.kind) +
            "\",\"visible\":" + str(node.visible) + ",\"process\":\"" + process_name(node.process_mode) + "\"")
        if node.kind != resource.NODE_GROUP {
            out.write_str(",\"transform\":[")
            values := transform(&node)
            for j in 0:values.len {
                if j > 0 { out.write_str(",") }
                // SDK shortest round-trippable decimal; str(f64) loses precision.
                decimal := strconv.format_float(values[j], 103, -1) or >>
                out.write_str(decimal)
            }
            out.write_str("]")
        }
        if node.camera_2d.is_set() || node.orthographic.is_set() {
            version = CAMERA_VERSION
        } else if node.camera.is_set() && version == LEGACY_VERSION {
            version = PERSPECTIVE_VERSION
        }
        out.write_str(encode_camera(&node) or >>)
        out.write_str("}")
    }
    out.write_str("\n]")
    out.write_str(encode_surfaces(document) or >>)
    out.write_str(encode_audio(document) or >>)
    out.write_str(encode_scripts(document) or >>)
    out.write_str(encode_lights(document) or >>)
    for i in 0:document.light_count() {
        light := document.light(i) or >>
        if light.punctual.enabled() {
            if version < PUNCTUAL_SHADOW_VERSION { version = PUNCTUAL_SHADOW_VERSION }
        } else if light.cascades.enabled() {
            if version < CASCADE_VERSION { version = CASCADE_VERSION }
        }
    }
    for i in 0:document.surface_count() {
        if (document.surface(i) or >>).levels.len > 0 {
            if version < LOD_VERSION { version = LOD_VERSION }
            <-
        }
    }
    has_v10 := document.has_modeling_attachments()
    if document.sprite_3d_count() > 0 || document.tilemap_2d_count() > 0 || document.has_modern_attachments() || has_v10 {
        version = SPRITE_TILEMAP_VERSION
        if document.has_solid_tiles_2d() { version = TILE_COLLISION_VERSION }
        if document.has_modern_attachments() { version = MODERN_COMPONENTS_VERSION }
        if has_v10 { version = MODELING_VERSION }
        out.write_str(encode_sprites_3d(document) or >>)
        out.write_str(encode_tilemaps_2d(document, version) or >>)
    }
    if document.has_modern_attachments() || has_v10 {
        out.write_str(encode_modern(document) or >>)
    }
    if has_v10 {
        out.write_str(encode_modeling_v10(document) or >>)
    }
    out.write_str("}\n")
    raw := "{\"format\":\"" + FORMAT + "\",\"version\":" + str(version) + out.to_string()
    if raw.len > MAX_BYTES { >> errors.new("nexus scene: encoded file exceeds byte limit") }
    // A JSON node occupies at least one byte. Larger documents must also fit
    // the exact reader budget before the file can be published.
    if raw.len > MAX_JSON_NODES { parse_scene_json(&raw) or >> }
    << raw
}
