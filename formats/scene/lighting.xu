@"github.com/xulang-org/nexus/formats/scene"

resource #"github.com/xulang-org/nexus/resources/scene"
light_data #"github.com/xulang-org/nexus/resources/lighting"
shadows #"github.com/xulang-org/nexus/resources/shadow"
fm #"github.com/xulang-org/nexus/foundation/math"
#encoding/json
#strconv
#strings
#errors

fn light_vector(doc &json.Doc, object int, name string) fm.Vec3 {
    values := vector(doc,doc.get(object,name),3) or >>
    << fm.vec3(values[0],values[1],values[2])
}
fn decode_lights(doc &json.Doc, root int, version int) []resource.LightAttachment {
    rows := rows_min(doc,doc.get(root,"lights"),0,resource.MAX_SCENE_LIGHTS) or >>
    $result := []resource.LightAttachment{}
    for at in rows {
        if !doc.is_dict(at) || !doc.has(at,"type") { >> errors.new("nexus scene: expected light object with a type") }
        kind := doc.as_string(doc.get(at,"type")) or >>
        $names := ["node","type","radiance"]
        if kind=="directional" { names.push("direction")
        } else if kind=="point" || kind=="spot" {
            names.push("position")
            names.push("radius")
            if kind=="spot" { names.push("direction")
                names.push("inner_cosine")
                names.push("outer_cosine") }
        } else { >> errors.new("nexus scene: unsupported light type") }
        has_cascades := kind == "directional" && version >= CASCADE_VERSION && doc.has(at, "cascades")
        has_shadow := kind != "directional" && version >= PUNCTUAL_SHADOW_VERSION && doc.has(at, "shadow")
        if has_cascades { names.push("cascades") }
        if has_shadow { names.push("shadow") }
        fields(doc,at,&names) or >>
        index := doc.as_int(doc.get(at,"node")) or >>
        radiance := light_vector(doc,at,"radiance") or >>
        $source := light_data.Light3D{}
        if kind=="directional" {
            source=light_data.directional(light_vector(doc,at,"direction") or >>,radiance) or >>
        } else {
            position := light_vector(doc,at,"position") or >>
            radius := doc.as_f64(doc.get(at,"radius")) or >>
            if kind=="point" { source=light_data.point(position,radiance,radius) or >>
            } else {
                direction := light_vector(doc,at,"direction") or >>
                inner := doc.as_f64(doc.get(at,"inner_cosine")) or >>
                outer := doc.as_f64(doc.get(at,"outer_cosine")) or >>
                source=light_data.spot_cosines(position,direction,radiance,radius,inner,outer) or >>
            }
        }
        $attachment := resource.light_attachment(index, source)
        if has_cascades { attachment.cascades = decode_cascades(doc, doc.get(at, "cascades")) or >> }
        if has_shadow { attachment.punctual = decode_punctual(doc, doc.get(at, "shadow"), source) or >> }
        result.push(attachment)
    }
    << result
}
fn light_decimal(value f64) string { << strconv.format_float(value,103,-1) or >> }
fn decode_punctual(doc &json.Doc, at int, source light_data.Light3D) shadows.PunctualProfile3D {
    names := ["near", "resolution", "constant_bias", "slope_bias"]
    fields(doc, at, &names) or >>
    << shadows.punctual_profile(source, shadows.PunctualSettings3D{
        near: doc.as_f64(doc.get(at, "near")) or >>,
        resolution: doc.as_int(doc.get(at, "resolution")) or >>,
        constant_bias: doc.as_f64(doc.get(at, "constant_bias")) or >>,
        slope_bias: doc.as_f64(doc.get(at, "slope_bias")) or >>}) or >>
}
fn encode_punctual(settings shadows.PunctualSettings3D) string {
    near := light_decimal(settings.near) or >>
    constant_bias := light_decimal(settings.constant_bias) or >>
    slope_bias := light_decimal(settings.slope_bias) or >>
    << "{\"near\":" + near + ",\"resolution\":" + str(settings.resolution) +
        ",\"constant_bias\":" + constant_bias + ",\"slope_bias\":" + slope_bias + "}"
}
fn decode_cascades(doc &json.Doc, at int) shadows.CascadeProfile3D {
    names := ["count", "resolution", "distance", "split_lambda", "blend_fraction", "caster_padding",
        "stabilization_step", "raster_bias_texels"]
    fields(doc, at, &names) or >>
    << shadows.cascade_profile(shadows.CascadeSettings3D{
        count: doc.as_int(doc.get(at, "count")) or >>,
        resolution: doc.as_int(doc.get(at, "resolution")) or >>,
        distance: doc.as_f64(doc.get(at, "distance")) or >>,
        split_lambda: doc.as_f64(doc.get(at, "split_lambda")) or >>,
        blend_fraction: doc.as_f64(doc.get(at, "blend_fraction")) or >>,
        caster_padding: doc.as_f64(doc.get(at, "caster_padding")) or >>,
        stabilization_step: doc.as_f64(doc.get(at, "stabilization_step")) or >>,
        raster_bias_texels: doc.as_f64(doc.get(at, "raster_bias_texels")) or >>}) or >>
}
fn encode_cascades(settings shadows.CascadeSettings3D) string {
    distance := light_decimal(settings.distance) or >>
    split := light_decimal(settings.split_lambda) or >>
    blend := light_decimal(settings.blend_fraction) or >>
    padding := light_decimal(settings.caster_padding) or >>
    step := light_decimal(settings.stabilization_step) or >>
    bias := light_decimal(settings.raster_bias_texels) or >>
    << "{\"count\":" + str(settings.count) + ",\"resolution\":" + str(settings.resolution) +
        ",\"distance\":" + distance + ",\"split_lambda\":" + split + ",\"blend_fraction\":" + blend +
        ",\"caster_padding\":" + padding + ",\"stabilization_step\":" + step + ",\"raster_bias_texels\":" + bias + "}"
}
fn light_vec(value fm.Vec3) string {
    x := light_decimal(value.x) or >>
    y := light_decimal(value.y) or >>
    z := light_decimal(value.z) or >>
    << "["+x+","+y+","+z+"]"
}
fn encode_lights(document &resource.Document) string {
    $out := strings.new_byte_builder(1024)
    out.write_str(",\"lights\":[\n")
    for i in 0:document.light_count() {
        if i>0 { out.write_str(",\n") }
        attachment := document.light(i) or >>
        source := attachment.source
        source.validate() or >>
        $kind := "directional"
        if source.kind()==light_data.POINT { kind="point" }
        if source.kind()==light_data.SPOT { kind="spot" }
        out.write_str("{\"node\":"+str(attachment.node)+",\"type\":\""+kind+"\",\"radiance\":"+(light_vec(source.radiance()) or >>))
        if source.kind()!=light_data.DIRECTIONAL {
            out.write_str(",\"position\":"+(light_vec(source.position()) or >>)+",\"radius\":"+(light_decimal(source.radius()) or >>))
        }
        if source.kind()!=light_data.POINT { out.write_str(",\"direction\":"+(light_vec(source.direction()) or >>)) }
        if source.kind()==light_data.SPOT {
            out.write_str(",\"inner_cosine\":"+(light_decimal(source.inner_cosine()) or >>)+",\"outer_cosine\":"+(light_decimal(source.outer_cosine()) or >>))
        }
        if attachment.cascades.enabled() {
            settings := attachment.cascades.settings() or >>
            out.write_str(",\"cascades\":" + (encode_cascades(settings) or >>))
        }
        if attachment.punctual.enabled() {
            settings := attachment.punctual.settings() or >>
            out.write_str(",\"shadow\":" + (encode_punctual(settings) or >>))
        }
        out.write_str("}")
    }
    out.write_str("\n]")
    << out.to_string()
}
