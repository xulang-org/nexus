@"github.com/xulang-org/nexus/formats/scene"

resource #"github.com/xulang-org/nexus/resources/scene"
light_data #"github.com/xulang-org/nexus/resources/lighting"
shadows #"github.com/xulang-org/nexus/resources/shadow"
fm #"github.com/xulang-org/nexus/foundation/math"
#encoding/json
#strconv
#strings
#errors

fn light_vector(doc &json.Doc, object int, name string) fm.Vec3 {
    values := vector(doc,doc.get(object,name),3) >>>
    << fm.vec3(values[0],values[1],values[2])
}
fn decode_lights(doc &json.Doc, root int, version int) []resource.LightAttachment {
    rows := rows_min(doc,doc.get(root,"lights"),0,resource.MAX_SCENE_LIGHTS) >>>
    $result := []resource.LightAttachment{}
    for at in rows {
        if !doc.is_dict(at) || !doc.has(at,"type") { >>> errors.new("nexus scene: expected light object with a type") }
        kind := doc.as_string(doc.get(at,"type")) >>>
        $names := ["node","type","radiance"]
        if kind=="directional" { names.push("direction")
        } else if kind=="point" || kind=="spot" {
            names.push("position")
            names.push("radius")
            if kind=="spot" { names.push("direction")
                names.push("inner_cosine")
                names.push("outer_cosine") }
        } else { >>> errors.new("nexus scene: unsupported light type") }
        has_cascades := kind == "directional" && version >= CASCADE_VERSION && doc.has(at, "cascades")
        has_shadow := kind != "directional" && version >= PUNCTUAL_SHADOW_VERSION && doc.has(at, "shadow")
        if has_cascades { names.push("cascades") }
        if has_shadow { names.push("shadow") }
        fields(doc,at,&names) >>>
        index := doc.as_int(doc.get(at,"node")) >>>
        radiance := light_vector(doc,at,"radiance") >>>
        $source := light_data.Light3D{}
        if kind=="directional" {
            source=light_data.directional(light_vector(doc,at,"direction") >>>,radiance) >>>
        } else {
            position := light_vector(doc,at,"position") >>>
            radius := doc.as_f64(doc.get(at,"radius")) >>>
            if kind=="point" { source=light_data.point(position,radiance,radius) >>>
            } else {
                direction := light_vector(doc,at,"direction") >>>
                inner := doc.as_f64(doc.get(at,"inner_cosine")) >>>
                outer := doc.as_f64(doc.get(at,"outer_cosine")) >>>
                source=light_data.spot_cosines(position,direction,radiance,radius,inner,outer) >>>
            }
        }
        $attachment := resource.light_attachment(index, source)
        if has_cascades { attachment.cascades = decode_cascades(doc, doc.get(at, "cascades")) >>> }
        if has_shadow { attachment.punctual = decode_punctual(doc, doc.get(at, "shadow"), source) >>> }
        result.push(attachment)
    }
    << result
}
fn light_decimal(value f64) string { << strconv.format_float(value,103,-1) >>> }
fn decode_punctual(doc &json.Doc, at int, source light_data.Light3D) shadows.PunctualProfile3D {
    names := ["near", "resolution", "constant_bias", "slope_bias"]
    fields(doc, at, &names) >>>
    << shadows.punctual_profile(source, shadows.PunctualSettings3D{
        near: doc.as_f64(doc.get(at, "near")) >>>,
        resolution: doc.as_int(doc.get(at, "resolution")) >>>,
        constant_bias: doc.as_f64(doc.get(at, "constant_bias")) >>>,
        slope_bias: doc.as_f64(doc.get(at, "slope_bias")) >>>}) >>>
}
fn encode_punctual(settings shadows.PunctualSettings3D) string {
    near := light_decimal(settings.near) >>>
    constant_bias := light_decimal(settings.constant_bias) >>>
    slope_bias := light_decimal(settings.slope_bias) >>>
    << "{\"near\":" + near + ",\"resolution\":" + str(settings.resolution) +
        ",\"constant_bias\":" + constant_bias + ",\"slope_bias\":" + slope_bias + "}"
}
fn decode_cascades(doc &json.Doc, at int) shadows.CascadeProfile3D {
    names := ["count", "resolution", "distance", "split_lambda", "blend_fraction", "caster_padding",
        "stabilization_step", "raster_bias_texels"]
    fields(doc, at, &names) >>>
    << shadows.cascade_profile(shadows.CascadeSettings3D{
        count: doc.as_int(doc.get(at, "count")) >>>,
        resolution: doc.as_int(doc.get(at, "resolution")) >>>,
        distance: doc.as_f64(doc.get(at, "distance")) >>>,
        split_lambda: doc.as_f64(doc.get(at, "split_lambda")) >>>,
        blend_fraction: doc.as_f64(doc.get(at, "blend_fraction")) >>>,
        caster_padding: doc.as_f64(doc.get(at, "caster_padding")) >>>,
        stabilization_step: doc.as_f64(doc.get(at, "stabilization_step")) >>>,
        raster_bias_texels: doc.as_f64(doc.get(at, "raster_bias_texels")) >>>}) >>>
}
fn encode_cascades(settings shadows.CascadeSettings3D) string {
    distance := light_decimal(settings.distance) >>>
    split := light_decimal(settings.split_lambda) >>>
    blend := light_decimal(settings.blend_fraction) >>>
    padding := light_decimal(settings.caster_padding) >>>
    step := light_decimal(settings.stabilization_step) >>>
    bias := light_decimal(settings.raster_bias_texels) >>>
    << "{\"count\":" + str(settings.count) + ",\"resolution\":" + str(settings.resolution) +
        ",\"distance\":" + distance + ",\"split_lambda\":" + split + ",\"blend_fraction\":" + blend +
        ",\"caster_padding\":" + padding + ",\"stabilization_step\":" + step + ",\"raster_bias_texels\":" + bias + "}"
}
fn light_vec(value fm.Vec3) string {
    x := light_decimal(value.x) >>>
    y := light_decimal(value.y) >>>
    z := light_decimal(value.z) >>>
    << "["+x+","+y+","+z+"]"
}
fn encode_lights(document &resource.Document) string {
    $out := strings.new_byte_builder(1024)
    out.write_str(",\"lights\":[\n")
    for i in 0:document.light_count() {
        if i>0 { out.write_str(",\n") }
        attachment := document.light(i) >>>
        source := attachment.source
        source.validate() >>>
        $kind := "directional"
        if source.kind()==light_data.POINT { kind="point" }
        if source.kind()==light_data.SPOT { kind="spot" }
        out.write_str("{\"node\":"+str(attachment.node)+",\"type\":\""+kind+"\",\"radiance\":"+(light_vec(source.radiance()) >>>))
        if source.kind()!=light_data.DIRECTIONAL {
            out.write_str(",\"position\":"+(light_vec(source.position()) >>>)+",\"radius\":"+(light_decimal(source.radius()) >>>))
        }
        if source.kind()!=light_data.POINT { out.write_str(",\"direction\":"+(light_vec(source.direction()) >>>)) }
        if source.kind()==light_data.SPOT {
            out.write_str(",\"inner_cosine\":"+(light_decimal(source.inner_cosine()) >>>)+",\"outer_cosine\":"+(light_decimal(source.outer_cosine()) >>>))
        }
        if attachment.cascades.enabled() {
            settings := attachment.cascades.settings() >>>
            out.write_str(",\"cascades\":" + (encode_cascades(settings) >>>))
        }
        if attachment.punctual.enabled() {
            settings := attachment.punctual.settings() >>>
            out.write_str(",\"shadow\":" + (encode_punctual(settings) >>>))
        }
        out.write_str("}")
    }
    out.write_str("\n]")
    << out.to_string()
}
