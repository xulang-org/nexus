@"github.com/xulang-org/nexus/formats/scene"

resource #"github.com/xulang-org/nexus/resources/scene"
camera_data #"github.com/xulang-org/nexus/resources/camera"
#encoding/json
#strconv
#errors

fn decode_camera(doc &json.Doc, at int, version int, node $&resource.NodeData) int {
    if node.kind == resource.NODE_2D {
        if version < CAMERA_VERSION { >>> errors.new("nexus scene: Node2D camera requires version 3") }
        names := ["design_width", "design_height", "zoom"]
        fields(doc, at, &names) >>>
        width := doc.as_f64(doc.get(at, "design_width")) >>>
        height := doc.as_f64(doc.get(at, "design_height")) >>>
        zoom := doc.as_f64(doc.get(at, "zoom")) >>>
        node.camera_2d = camera_data.view_2d(width, height, zoom) >>>
        << 0
    }
    if version >= CAMERA_VERSION && doc.has(at, "projection") {
        names := ["projection", "vertical_size", "near", "far"]
        fields(doc, at, &names) >>>
        kind := doc.as_string(doc.get(at, "projection")) >>>
        if kind != "orthographic" { >>> errors.new("nexus scene: unknown camera projection") }
        size := doc.as_f64(doc.get(at, "vertical_size")) >>>
        near := doc.as_f64(doc.get(at, "near")) >>>
        far := doc.as_f64(doc.get(at, "far")) >>>
        node.orthographic = camera_data.orthographic(size, near, far) >>>
        << 0
    }
    names := ["vertical_fov", "near", "far"]
    fields(doc, at, &names) >>>
    vertical_fov := doc.as_f64(doc.get(at, "vertical_fov")) >>>
    near := doc.as_f64(doc.get(at, "near")) >>>
    far := doc.as_f64(doc.get(at, "far")) >>>
    node.camera = camera_data.perspective(vertical_fov, near, far) >>>
    << 0
}

fn encode_camera(node &resource.NodeData) string {
    if node.camera_2d.is_set() {
        width := strconv.format_float(node.camera_2d.width(), 103, -1) >>>
        height := strconv.format_float(node.camera_2d.height(), 103, -1) >>>
        zoom := strconv.format_float(node.camera_2d.zoom(), 103, -1) >>>
        << ",\"camera\":{\"design_width\":" + width + ",\"design_height\":" + height + ",\"zoom\":" + zoom + "}"
    }
    if node.orthographic.is_set() {
        size := strconv.format_float(node.orthographic.vertical_size(), 103, -1) >>>
        near := strconv.format_float(node.orthographic.near(), 103, -1) >>>
        far := strconv.format_float(node.orthographic.far(), 103, -1) >>>
        << ",\"camera\":{\"projection\":\"orthographic\",\"vertical_size\":" + size + ",\"near\":" + near + ",\"far\":" + far + "}"
    }
    if node.camera.is_set() {
        fov := strconv.format_float(node.camera.vertical_fov(), 103, -1) >>>
        near := strconv.format_float(node.camera.near(), 103, -1) >>>
        far := strconv.format_float(node.camera.far(), 103, -1) >>>
        << ",\"camera\":{\"vertical_fov\":" + fov + ",\"near\":" + near + ",\"far\":" + far + "}"
    }
    << ""
}
