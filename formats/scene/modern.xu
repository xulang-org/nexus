@"github.com/xulang-org/nexus/formats/scene"

fm #"github.com/xulang-org/nexus/foundation/math"
resource #"github.com/xulang-org/nexus/resources/scene"
#encoding/json
#strconv
#strings
#errors

fn sky_mode_name(mode int) string {
    if mode == resource.SKY_SOLID { << "solid" }
    << "atmosphere"
}

fn sky_mode_value(name string) int {
    if name == "solid" { << resource.SKY_SOLID }
    if name == "atmosphere" { << resource.SKY_ATMOSPHERE }
    >> errors.new("nexus scene: unsupported environment sky_mode")
}

fn body_type_name(t int) string {
    if t == resource.BODY_STATIC { << "static" }
    if t == resource.BODY_KINEMATIC { << "kinematic" }
    << "dynamic"
}

fn body_type_value(name string) int {
    if name == "static" { << resource.BODY_STATIC }
    if name == "kinematic" { << resource.BODY_KINEMATIC }
    if name == "dynamic" { << resource.BODY_DYNAMIC }
    >> errors.new("nexus scene: unsupported RigidBody3D body_type")
}

fn shape_kind_name(k int) string {
    if k == resource.SHAPE_BOX { << "box" }
    if k == resource.SHAPE_SPHERE { << "sphere" }
    if k == resource.SHAPE_CAPSULE { << "capsule" }
    << "mesh"
}

fn shape_kind_value(name string) int {
    if name == "box" { << resource.SHAPE_BOX }
    if name == "sphere" { << resource.SHAPE_SPHERE }
    if name == "capsule" { << resource.SHAPE_CAPSULE }
    if name == "mesh" { << resource.SHAPE_MESH }
    >> errors.new("nexus scene: unsupported RigidBody3D shape_kind")
}

fn joint_kind_name(k int) string {
    if k == resource.JOINT_BALL { << "ball" }
    if k == resource.JOINT_HINGE { << "hinge" }
    << "distance"
}

fn joint_kind_value(name string) int {
    if name == "ball" { << resource.JOINT_BALL }
    if name == "hinge" { << resource.JOINT_HINGE }
    if name == "distance" { << resource.JOINT_DISTANCE }
    >> errors.new("nexus scene: unsupported Joint3D kind")
}

fn decode_vec3(doc &json.Doc, at int, field string) fm.Vec3 {
    v := vector(doc, doc.get(at, field), 3) >>>
    << fm.vec3(v[0], v[1], v[2])
}

fn fmt_vec3(v fm.Vec3) string {
    << fmt_f64_list(&[v.x, v.y, v.z]) >>>
}

fn fmt_dec(v f64) string {
    << strconv.format_float(v, 103, -1) >>>
}

fn decode_environments(doc &json.Doc, root int, version int) []resource.EnvironmentAttachment {
    if version < MODERN_COMPONENTS_VERSION { << []resource.EnvironmentAttachment{} }
    rows := rows_min(doc, doc.get(root, "environments"), 0, resource.MAX_SCENE_ENVIRONMENTS) >>>
    expected := ["node", "sky_mode", "sun_dir", "sun_intensity", "turbidity", "ambient",
        "exposure", "fog_density", "fog_scattering", "bloom_enabled", "bloom_threshold",
        "bloom_intensity", "gtao_enabled", "ssr_enabled", "taa_enabled", "ibl_strength",
        "ddgi_enabled", "ddgi_origin", "ddgi_spacing"]
    $out := []resource.EnvironmentAttachment{}
    for at in rows {
        fields(doc, at, &expected) >>>
        env := resource.EnvironmentAttachment{
            node: doc.as_int(doc.get(at, "node")) >>>,
            sky_mode: sky_mode_value(doc.as_string(doc.get(at, "sky_mode")) >>>) >>>,
            sun_dir: decode_vec3(doc, at, "sun_dir") >>>,
            sun_intensity: doc.as_f64(doc.get(at, "sun_intensity")) >>>,
            turbidity: doc.as_f64(doc.get(at, "turbidity")) >>>,
            ambient: decode_vec3(doc, at, "ambient") >>>,
            exposure: doc.as_f64(doc.get(at, "exposure")) >>>,
            fog_density: doc.as_f64(doc.get(at, "fog_density")) >>>,
            fog_scattering: doc.as_f64(doc.get(at, "fog_scattering")) >>>,
            bloom_enabled: doc.as_bool(doc.get(at, "bloom_enabled")) >>>,
            bloom_threshold: doc.as_f64(doc.get(at, "bloom_threshold")) >>>,
            bloom_intensity: doc.as_f64(doc.get(at, "bloom_intensity")) >>>,
            gtao_enabled: doc.as_bool(doc.get(at, "gtao_enabled")) >>>,
            ssr_enabled: doc.as_bool(doc.get(at, "ssr_enabled")) >>>,
            taa_enabled: doc.as_bool(doc.get(at, "taa_enabled")) >>>,
            ibl_strength: doc.as_f64(doc.get(at, "ibl_strength")) >>>,
            ddgi_enabled: doc.as_bool(doc.get(at, "ddgi_enabled")) >>>,
            ddgi_origin: decode_vec3(doc, at, "ddgi_origin") >>>,
            ddgi_spacing: doc.as_f64(doc.get(at, "ddgi_spacing")) >>>
        }
        env.validate() >>>
        out.push(env)
    }
    << out
}

fn decode_rigid_bodies_3d(doc &json.Doc, root int, version int) []resource.RigidBody3DAttachment {
    if version < MODERN_COMPONENTS_VERSION { << []resource.RigidBody3DAttachment{} }
    rows := rows_min(doc, doc.get(root, "rigid_bodies_3d"), 0, resource.MAX_SCENE_RIGID_BODIES_3D) >>>
    expected := ["node", "body_type", "shape_kind", "half_extents", "radius", "height",
        "mass", "restitution", "friction", "layer", "mask", "is_trigger"]
    $out := []resource.RigidBody3DAttachment{}
    for at in rows {
        fields(doc, at, &expected) >>>
        b := resource.RigidBody3DAttachment{
            node: doc.as_int(doc.get(at, "node")) >>>,
            body_type: body_type_value(doc.as_string(doc.get(at, "body_type")) >>>) >>>,
            shape_kind: shape_kind_value(doc.as_string(doc.get(at, "shape_kind")) >>>) >>>,
            half_extents: decode_vec3(doc, at, "half_extents") >>>,
            radius: doc.as_f64(doc.get(at, "radius")) >>>,
            height: doc.as_f64(doc.get(at, "height")) >>>,
            mass: doc.as_f64(doc.get(at, "mass")) >>>,
            restitution: doc.as_f64(doc.get(at, "restitution")) >>>,
            friction: doc.as_f64(doc.get(at, "friction")) >>>,
            layer: doc.as_int(doc.get(at, "layer")) >>>,
            mask: doc.as_int(doc.get(at, "mask")) >>>,
            is_trigger: doc.as_bool(doc.get(at, "is_trigger")) >>>
        }
        b.validate() >>>
        out.push(b)
    }
    << out
}

fn decode_joints_3d(doc &json.Doc, root int, version int) []resource.Joint3DAttachment {
    if version < MODERN_COMPONENTS_VERSION { << []resource.Joint3DAttachment{} }
    rows := rows_min(doc, doc.get(root, "joints_3d"), 0, resource.MAX_SCENE_JOINTS_3D) >>>
    expected := ["node_a", "node_b", "kind", "anchor_a", "anchor_b", "axis",
        "limit_min", "limit_max", "motor_speed", "motor_torque"]
    $out := []resource.Joint3DAttachment{}
    for at in rows {
        fields(doc, at, &expected) >>>
        j := resource.Joint3DAttachment{
            node_a: doc.as_int(doc.get(at, "node_a")) >>>,
            node_b: doc.as_int(doc.get(at, "node_b")) >>>,
            kind: joint_kind_value(doc.as_string(doc.get(at, "kind")) >>>) >>>,
            anchor_a: decode_vec3(doc, at, "anchor_a") >>>,
            anchor_b: decode_vec3(doc, at, "anchor_b") >>>,
            axis: decode_vec3(doc, at, "axis") >>>,
            limit_min: doc.as_f64(doc.get(at, "limit_min")) >>>,
            limit_max: doc.as_f64(doc.get(at, "limit_max")) >>>,
            motor_speed: doc.as_f64(doc.get(at, "motor_speed")) >>>,
            motor_torque: doc.as_f64(doc.get(at, "motor_torque")) >>>
        }
        j.validate() >>>
        out.push(j)
    }
    << out
}

