fn decode_particles_3d(doc &json.Doc, root int, version int) []resource.ParticleEmitter3DAttachment {
    if version < MODERN_COMPONENTS_VERSION { << []resource.ParticleEmitter3DAttachment{} }
    rows := rows_min(doc, doc.get(root, "particles_3d"), 0, resource.MAX_SCENE_PARTICLES_3D) >>>
    expected := ["node", "max_particles", "spawn_rate", "lifetime", "speed", "gravity", "start_color", "end_color", "size", "additive"]
    $out := []resource.ParticleEmitter3DAttachment{}
    for at in rows {
        fields(doc, at, &expected) >>>
        p := resource.ParticleEmitter3DAttachment{
            node: doc.as_int(doc.get(at, "node")) >>>,
            max_particles: doc.as_int(doc.get(at, "max_particles")) >>>,
            spawn_rate: doc.as_f64(doc.get(at, "spawn_rate")) >>>,
            lifetime: doc.as_f64(doc.get(at, "lifetime")) >>>,
            speed: doc.as_f64(doc.get(at, "speed")) >>>,
            gravity: doc.as_f64(doc.get(at, "gravity")) >>>,
            start_color: doc.as_int(doc.get(at, "start_color")) >>>,
            end_color: doc.as_int(doc.get(at, "end_color")) >>>,
            size: doc.as_f64(doc.get(at, "size")) >>>,
