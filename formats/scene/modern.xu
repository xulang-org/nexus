}

fn decode_prefab_instances(doc &json.Doc, root int, version int) []resource.PrefabInstanceAttachment {
    if version < MODERN_COMPONENTS_VERSION { << []resource.PrefabInstanceAttachment{} }
    rows := rows_min(doc, doc.get(root, "prefab_instances"), 0, resource.MAX_SCENE_PREFAB_INSTANCES) >>>
    expected := ["node", "resource", "overrides"]
    ov_fields := ["target_path", "visible_set", "visible", "position_set", "position"]
    $out := []resource.PrefabInstanceAttachment{}
    for at in rows {
        fields(doc, at, &expected) >>>
        node := doc.as_int(doc.get(at, "node")) >>>
        uid := doc.as_string(doc.get(at, "resource")) >>>
        ov_rows := rows_min(doc, doc.get(at, "overrides"), 0, resource.MAX_PREFAB_OVERRIDES) >>>
        $ovs := []resource.PrefabOverride{}
        for item in ov_rows {
            fields(doc, item, &ov_fields) >>>
            ovs.push(resource.PrefabOverride{
                target_path: doc.as_string(doc.get(item, "target_path")) >>>,
                visible_set: doc.as_bool(doc.get(item, "visible_set")) >>>,
                visible: doc.as_bool(doc.get(item, "visible")) >>>,
                position_set: doc.as_bool(doc.get(item, "position_set")) >>>,
                position: decode_vec3(doc, item, "position") >>>
            })
        }
        prefab := resource.prefab_instance_attachment(node, uid, ovs)
        prefab.validate() >>>
        out.push(prefab)
    }
    << out
}

fn encode_modern(document &resource.Document) string {
    $out := strings.new_byte_builder(2048)

    out.write_str(",\"environments\":[\n")
    for i in 0:document.environment_count() {
        if i > 0 { out.write_str(",\n") }
        e := document.environment(i) >>>
        out.write_str("{\"node\":" + str(e.node) +
            ",\"sky_mode\":\"" + sky_mode_name(e.sky_mode) +
            "\",\"sun_dir\":" + (fmt_vec3(e.sun_dir) >>>) +
            ",\"sun_intensity\":" + (fmt_dec(e.sun_intensity) >>>) +
            ",\"turbidity\":" + (fmt_dec(e.turbidity) >>>) +
            ",\"ambient\":" + (fmt_vec3(e.ambient) >>>) +
            ",\"exposure\":" + (fmt_dec(e.exposure) >>>) +
            ",\"fog_density\":" + (fmt_dec(e.fog_density) >>>) +
            ",\"fog_scattering\":" + (fmt_dec(e.fog_scattering) >>>) +
            ",\"bloom_enabled\":" + str(e.bloom_enabled) +
            ",\"bloom_threshold\":" + (fmt_dec(e.bloom_threshold) >>>) +
            ",\"bloom_intensity\":" + (fmt_dec(e.bloom_intensity) >>>) +
            ",\"gtao_enabled\":" + str(e.gtao_enabled) +
            ",\"ssr_enabled\":" + str(e.ssr_enabled) +
            ",\"taa_enabled\":" + str(e.taa_enabled) +
            ",\"ibl_strength\":" + (fmt_dec(e.ibl_strength) >>>) +
            ",\"ddgi_enabled\":" + str(e.ddgi_enabled) +
            ",\"ddgi_origin\":" + (fmt_vec3(e.ddgi_origin) >>>) +
            ",\"ddgi_spacing\":" + (fmt_dec(e.ddgi_spacing) >>>) + "}")
    }
    out.write_str("\n],\"rigid_bodies_3d\":[\n")
    for i in 0:document.rigid_body_3d_count() {
        if i > 0 { out.write_str(",\n") }
        b := document.rigid_body_3d(i) >>>
        out.write_str("{\"node\":" + str(b.node) +
            ",\"body_type\":\"" + body_type_name(b.body_type) +
            "\",\"shape_kind\":\"" + shape_kind_name(b.shape_kind) +
            "\",\"half_extents\":" + (fmt_vec3(b.half_extents) >>>) +
            ",\"radius\":" + (fmt_dec(b.radius) >>>) +
            ",\"height\":" + (fmt_dec(b.height) >>>) +
            ",\"mass\":" + (fmt_dec(b.mass) >>>) +
            ",\"restitution\":" + (fmt_dec(b.restitution) >>>) +
            ",\"friction\":" + (fmt_dec(b.friction) >>>) +
            ",\"layer\":" + str(b.layer) +
            ",\"mask\":" + str(b.mask) +
            ",\"is_trigger\":" + str(b.is_trigger) + "}")
    }
    out.write_str("\n],\"joints_3d\":[\n")
    for i in 0:document.joint_3d_count() {
        if i > 0 { out.write_str(",\n") }
        j := document.joint_3d(i) >>>
        out.write_str("{\"node_a\":" + str(j.node_a) +
            ",\"node_b\":" + str(j.node_b) +
            ",\"kind\":\"" + joint_kind_name(j.kind) +
            "\",\"anchor_a\":" + (fmt_vec3(j.anchor_a) >>>) +
            ",\"anchor_b\":" + (fmt_vec3(j.anchor_b) >>>) +
            ",\"axis\":" + (fmt_vec3(j.axis) >>>) +
            ",\"limit_min\":" + (fmt_dec(j.limit_min) >>>) +
            ",\"limit_max\":" + (fmt_dec(j.limit_max) >>>) +
            ",\"motor_speed\":" + (fmt_dec(j.motor_speed) >>>) +
            ",\"motor_torque\":" + (fmt_dec(j.motor_torque) >>>) + "}")
    }
    out.write_str("\n],\"terrains\":[\n")
    for i in 0:document.terrain_count() {
        if i > 0 { out.write_str(",\n") }
        t := document.terrain(i) >>>
        out.write_str("{\"node\":" + str(t.node) +
            ",\"grid_x\":" + str(t.grid_x) +
            ",\"grid_z\":" + str(t.grid_z) +
            ",\"cell_size\":" + (fmt_dec(t.cell_size) >>>) +
            ",\"height_scale\":" + (fmt_dec(t.height_scale) >>>) +
            ",\"seed\":" + str(t.seed) +
            ",\"foliage_density\":" + (fmt_dec(t.foliage_density) >>>) +
            ",\"wind_strength\":" + (fmt_dec(t.wind_strength) >>>) + "}")
    }
    out.write_str("\n],\"particles_3d\":[\n")
    for i in 0:document.particle_emitter_3d_count() {
        if i > 0 { out.write_str(",\n") }
        p := document.particle_emitter_3d(i) >>>
        out.write_str("{\"node\":" + str(p.node) +
            ",\"max_particles\":" + str(p.max_particles) +
            ",\"spawn_rate\":" + (fmt_dec(p.spawn_rate) >>>) +
            ",\"lifetime\":" + (fmt_dec(p.lifetime) >>>) +
            ",\"speed\":" + (fmt_dec(p.speed) >>>) +
            ",\"gravity\":" + (fmt_dec(p.gravity) >>>) +
            ",\"start_color\":" + str(p.start_color) +
            ",\"end_color\":" + str(p.end_color) +
            ",\"size\":" + (fmt_dec(p.size) >>>) +
            ",\"additive\":" + str(p.additive) + "}")
    }
    out.write_str("\n],\"prefab_instances\":[\n")
    for i in 0:document.prefab_instance_count() {
        if i > 0 { out.write_str(",\n") }
        pf := document.prefab_instance(i) >>>
        uid := pf.scene_uid + ""
        out.write_str("{\"node\":" + str(pf.node) + ",\"resource\":" + json.quote(&uid) + ",\"overrides\":[")
        for j in 0:pf.overrides.len {
            if j > 0 { out.write_str(",") }
            ov := &pf.overrides[j]
            tp := ov.target_path + ""
            out.write_str("{\"target_path\":" + json.quote(&tp) +
                ",\"visible_set\":" + str(ov.visible_set) +
                ",\"visible\":" + str(ov.visible) +
                ",\"position_set\":" + str(ov.position_set) +
                ",\"position\":" + (fmt_vec3(ov.position) >>>) + "}")
        }
        out.write_str("]}")
    }
    out.write_str("\n]")
    << out.to_string()
}
