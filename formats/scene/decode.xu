@"github.com/xulang-org/nexus/formats/scene"

resource #"github.com/xulang-org/nexus/resources/scene"
fm #"github.com/xulang-org/nexus/foundation/math"
#encoding/json
#errors

pub const FORMAT = "xu.scene"
pub const VERSION = 10
const MODELING_VERSION = 10
const MODERN_COMPONENTS_VERSION = 9
const TILE_COLLISION_VERSION = 8
const SPRITE_TILEMAP_VERSION = 7
const LOD_VERSION = 6
const PUNCTUAL_SHADOW_VERSION = 5
const CASCADE_VERSION = 4
const CAMERA_VERSION = 3
const PERSPECTIVE_VERSION = 2
const LEGACY_VERSION = 1
pub const MAX_BYTES = 4194304
const MAX_JSON_NODES = 131072
fn fields(doc &json.Doc, node int, expected &[]string) int {
    if node < 0 || !doc.is_dict(node) || doc.count(node) != expected.len { >> errors.new("nexus scene: invalid object fields") }
    for name in expected { if !doc.has(node, name + "") { >> errors.new("nexus scene: missing property " + name) } }
    << 0
}
fn vector(doc &json.Doc, node int, count int) []f64 {
    if node < 0 || !doc.is_list(node) || doc.count(node) != count { >> errors.new("nexus scene: invalid transform length") }
    $values := []f64{}
    for i in 0:count {
        value := doc.as_f64(doc.at(node, i)) >>>
        if !fm.finite(value) { >> errors.new("nexus scene: transform must be finite") }
        values.push(value)
    }
    << values
}
fn kind(value string) int {
    if value == "Node" { << resource.NODE_GROUP }
    if value == "Node2D" { << resource.NODE_2D }
    if value == "Node3D" { << resource.NODE_3D }
    >> errors.new("nexus scene: unsupported node type")
}
fn process_mode(value string) int {
    if value == "inherit" { << resource.PROCESS_INHERIT }
    if value == "pausable" { << resource.PROCESS_PAUSABLE }
    if value == "always" { << resource.PROCESS_ALWAYS }
    if value == "when_paused" { << resource.PROCESS_WHEN_PAUSED }
    if value == "disabled" { << resource.PROCESS_DISABLED }
    >> errors.new("nexus scene: unsupported process mode")
}
fn parse_scene_json(raw &string) json.Doc {
    doc := json.parse_max(raw, MAX_BYTES)
    if !doc.ok() { >> errors.new("nexus scene JSON: " + doc.error()) }
    if doc.kinds.len > MAX_JSON_NODES { >> errors.new("nexus scene: JSON node budget exceeded") }
    << doc
}
pub fn decode(raw &string) resource.Document {
    if raw.len < 1 || raw.len > MAX_BYTES { >> errors.new("nexus scene: file size outside profile") }
    doc := parse_scene_json(raw) >>>
    root := doc.root()
    if !doc.is_dict(root) || !doc.has(root, "version") { >> errors.new("nexus scene: missing version object") }
    version := doc.as_int(doc.get(root, "version")) >>>
    if version < LEGACY_VERSION || version > VERSION {
        >> errors.new("nexus scene: unsupported format/version")
    }
    $header := ["format", "version", "nodes", "resources", "surfaces", "audio_buses", "audio_emitters", "scripts", "script_connections", "lights"]
    if version >= SPRITE_TILEMAP_VERSION {
        header.push("sprites_3d")
        header.push("tilemaps_2d")
    }
    if version >= MODERN_COMPONENTS_VERSION {
        header.push("environments")
        header.push("rigid_bodies_3d")
        header.push("joints_3d")
        header.push("terrains")
        header.push("particles_3d")
        header.push("prefab_instances")
    }
    if version >= MODELING_VERSION {
        header.push("editable_meshes")
        header.push("csg_brushes")
        header.push("material_overrides")
    }
    fields(&doc, root, &header) >>>
    if (doc.as_string(doc.get(root, "format")) >>>) != FORMAT { >> errors.new("nexus scene: unsupported format/version") }
    list := doc.get(root, "nodes")
    if list < 0 || !doc.is_list(list) || doc.count(list) < 1 || doc.count(list) > resource.MAX_NODES { >> errors.new("nexus scene: node count outside 1...4096") }
    $nodes := []resource.NodeData{}
    for i in 0:doc.count(list) {
        at := doc.at(list, i)
        if !doc.is_dict(at) { >> errors.new("nexus scene: expected node object") }
        type_at := doc.get(at, "type")
        if type_at < 0 { >> errors.new("nexus scene: missing node type") }
        node_kind := kind(doc.as_string(type_at) >>>) >>>
        $names := ["parent", "name", "type", "visible", "process"]
        if node_kind != resource.NODE_GROUP { names.push("transform") }
        has_camera := version >= PERSPECTIVE_VERSION && node_kind != resource.NODE_GROUP && doc.has(at, "camera")
        if has_camera { names.push("camera") }
        fields(&doc, at, &names) >>>
        parent := doc.as_int(doc.get(at, "parent")) >>>
        name := doc.as_string(doc.get(at, "name")) >>>
        $current := resource.node(parent, name, node_kind)
        current.visible = doc.as_bool(doc.get(at, "visible")) >>>
        current.process_mode = process_mode(doc.as_string(doc.get(at, "process")) >>>) >>>
        if node_kind == resource.NODE_2D {
            values := vector(&doc, doc.get(at, "transform"), 6) >>>
            current.local = fm.Transform2D{a: values[0], b: values[1], c: values[2], d: values[3], tx: values[4], ty: values[5]}
        }
        if node_kind == resource.NODE_3D {
            values := vector(&doc, doc.get(at, "transform"), 16) >>>
            current.local_3d = fm.Mat4{c0: fm.vec4(values[0], values[1], values[2], values[3]),
                c1: fm.vec4(values[4], values[5], values[6], values[7]), c2: fm.vec4(values[8], values[9], values[10], values[11]),
                c3: fm.vec4(values[12], values[13], values[14], values[15])}
        }
        if has_camera {
            decode_camera(&doc, doc.get(at, "camera"), version, $&current) >>>
        }
        nodes.push(current)
    }
    document := resource.make_document(nodes) >>>
    << decode_attachments(&doc, root, version, &document) >>>
}
