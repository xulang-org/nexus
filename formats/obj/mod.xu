@"github.com/xulang-org/game/formats/obj"

mesh #"github.com/xulang-org/game/resources/mesh"
fm #"github.com/xulang-org/game/foundation/math"
#strings
#strconv
#unicode/utf8
#math
#errors

pub const MAX_BYTES = 16777216
struct Corner { position int
    uv int
    normal int }
fn number(token &string, maximum f64) f64 {
    value := strconv.parse_float(token) or >>
    if !fm.finite(value) || math.abs(value)>maximum { >> errors.new("game OBJ: numeric value outside profile") }
    << value
}
fn index(token &string,count int) int {
    value := strconv.atoi(token) or >>
    if value==0 { >> errors.new("game OBJ: index zero is invalid") }
    $at := 0
    if value<0 { at=count+value
    } else { at=value-1 }
    if at<0 || at>=count { >> errors.new("game OBJ: forward or out-of-range index") }
    << at
}
fn corner(token &string,positions int,uvs int,normals int) Corner {
    parts := strings.split(token,"/")
    if parts.len<1 || parts.len>3 || parts[0].len==0 ||
        (parts.len==2 && parts[1].len==0) || (parts.len==3 && parts[2].len==0) { >> errors.new("game OBJ: invalid face corner syntax") }
    position := index(&parts[0],positions) or >>
    $uv := -1
    $normal := -1
    if parts.len>1 && parts[1].len>0 { uv=index(&parts[1],uvs) or >> }
    if parts.len==3 { normal=index(&parts[2],normals) or >> }
    << Corner{position: position,uv: uv,normal: normal}
}
fn append_face(output $&mesh.MeshData3D, tokens &[]string, positions &[]fm.Vec3,uvs &[]fm.Vec2,normals &[]fm.Vec3,smoothing bool) int {
    if tokens.len<4 || tokens.len>5 { >> errors.new("game OBJ: profile accepts triangles and convex planar quads") }
    $corners := []Corner{}
    for i in 1:tokens.len { corners.push(corner(&tokens[i],positions.len,uvs.len,normals.len) or >>) }
    a := positions[corners[0].position]
    b := positions[corners[1].position]
    c := positions[corners[2].position]
    face_normal := mesh.triangle_normal(a,b,c) or >>
    if corners.len==4 {
        d := positions[corners[3].position]
        size := math.max(b.sub(a).length(),math.max(c.sub(a).length(),d.sub(a).length()))
        if math.abs(d.sub(a).dot(face_normal))>size*0.000001 { >> errors.new("game OBJ: nonplanar quad") }
        for i in 0:4 {
            p := positions[corners[i].position]
            q := positions[corners[(i+1)%4].position]
            r := positions[corners[(i+2)%4].position]
            n := mesh.triangle_normal(p,q,r) or >>
            if n.dot(face_normal)<0.999999 { >> errors.new("game OBJ: concave or crossed quad") }
        }
    }
    has_uv := corners[0].uv>=0
    has_normal := corners[0].normal>=0
    if smoothing && !has_normal { >> errors.new("game OBJ: smoothing groups require explicit normals") }
    if corners.len>mesh.MAX_VERTICES-output.vertex_count() { >> errors.new("game OBJ: expanded vertex budget exceeded") }
    first := output.vertex_count()
    for item in corners {
        if (item.uv>=0)!=has_uv || (item.normal>=0)!=has_normal { >> errors.new("game OBJ: mixed attributes within one face") }
        $normal := face_normal
        if has_normal { normal=normals[item.normal] }
        p := positions[item.position]
        if has_uv { output.vertex_lit_uv(p,4294967295,normal,uvs[item.uv]) or >>
        } else { output.vertex_lit(p,4294967295,normal) or >> }
    }
    output.triangle(first,first+1,first+2) or >>
    if corners.len==4 { output.triangle(first,first+2,first+3) or >> }
    << 0
}
// Bounded static polygon profile. o/g labels coalesce into one mesh; materials,
// freeform geometry and implicit smooth-normal generation are explicit errors.
pub fn decode(raw &string) mesh.MeshData3D {
    if raw.len<1 || raw.len>MAX_BYTES || !utf8.valid(raw) { >> errors.new("game OBJ: invalid text or byte budget") }
    $positions := []fm.Vec3{}
    $uvs := []fm.Vec2{}
    $normals := []fm.Vec3{}
    $output := mesh.new_mesh_data_3d()
    $offset := 0
    $lines := 0
    $smoothing := false
    while offset<raw.len {
        start := offset
        while offset<raw.len && raw[offset]!=10 {
            if raw[offset]==0 || offset-start>=65536 { >> errors.new("game OBJ: NUL or oversized line") }
            offset+=1
        }
        $line := raw[start:offset]+""
        offset+=1
        lines+=1
        if lines>1048576 { >> errors.new("game OBJ: line budget exceeded") }
        comment := strings.index_byte(&line,35)
        if comment>=0 { line=line[0:comment]+"" }
        tokens := strings.fields(&line)
        if tokens.len==0 { -> }
        kind := tokens[0]+""
        if kind=="v" || kind=="vn" {
            if (kind=="v" && tokens.len!=4 && tokens.len!=5) || (kind=="vn" && tokens.len!=4) { >> errors.new("game OBJ: invalid vertex/normal arity") }
            $limit := 1e308
            if kind=="v" { limit=1000000000.0 }
            p := fm.vec3(number(&tokens[1],limit) or >>,number(&tokens[2],limit) or >>,number(&tokens[3],limit) or >>)
            if kind=="v" {
                if tokens.len==5 && (number(&tokens[4],1e308) or >>)!=1.0 { >> errors.new("game OBJ: nonunit homogeneous vertex weight unsupported") }
                if positions.len>=mesh.MAX_VERTICES { >> errors.new("game OBJ: source vertex budget exceeded") }
                positions.push(p)
            } else {
                if normals.len>=mesh.MAX_VERTICES { >> errors.new("game OBJ: normal budget exceeded") }
                normals.push(p.normalized() or >>)
            }
        } else if kind=="vt" {
            if tokens.len<2 || tokens.len>4 { >> errors.new("game OBJ: invalid texture coordinate arity") }
            u := number(&tokens[1],1000000.0) or >>
            $v := 0.0
            if tokens.len>2 { v=number(&tokens[2],1000000.0) or >> }
            if tokens.len==4 && (number(&tokens[3],1000000.0) or >>)!=0.0 { >> errors.new("game OBJ: 3D texture coordinates unsupported") }
            if uvs.len>=mesh.MAX_VERTICES { >> errors.new("game OBJ: UV budget exceeded") }
            uvs.push(fm.vec2(u,v))
        } else if kind=="f" { append_face($&output,&tokens,&positions,&uvs,&normals,smoothing) or >>
        } else if kind=="s" {
            if tokens.len!=2 { >> errors.new("game OBJ: invalid smoothing group") }
            smoothing=false
            if tokens[1]!="off" && tokens[1]!="0" {
                group := strconv.atoi(&tokens[1]) or >>
                if group<1 { >> errors.new("game OBJ: invalid smoothing group") }
                smoothing=true
            }
        } else if kind!="o" && kind!="g" { >> errors.new("game OBJ: unsupported statement "+kind) }
    }
    output.validate() or >>
    << output
}
