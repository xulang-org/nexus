@"github.com/xulang-org/game/formats/gltf"

fm #"github.com/xulang-org/game/foundation/math"
#math
#errors

fn absent_accessor() Accessor {
    << Accessor{view: -1, offset: 0, stride: 0, count: 0, component: 0, size: 0, components: 0,
        normalized: false, minimum: fm.vec4(0.0, 0.0, 0.0, 0.0), maximum: fm.vec4(0.0, 0.0, 0.0, 0.0), bounds: false, usage: 0}
}
fn (parser $&GlbParser) read_meshes(root int, asset $&GlbGeometry) int {
    meshes := array_property(&parser.doc, root, "meshes", 1, 256) or >>
    mesh_fields := ["primitives", "name"]
    for mesh in meshes {
        fields(&parser.doc, mesh, &mesh_fields) or >>
        primitives := array_property(&parser.doc, mesh, "primitives", 1, MAX_PRIMITIVES) or >>
        if primitives.len > MAX_PRIMITIVES - asset.primitives.len { >> errors.new("game GLB: primitive budget exceeded") }
        first := asset.primitives.len
        for primitive in primitives { parser.read_primitive(primitive, asset) or >> }
        asset.meshes.push(GlbMesh{first: first, count: primitives.len})
    }
    << 0
}
fn (parser $&GlbParser) read_primitive(node int, asset $&GlbGeometry) int {
    allowed := ["attributes", "indices", "mode", "material"]
    fields(&parser.doc, node, &allowed) or >>
    mode := integer(&parser.doc, node, "mode", 4, 0, 6) or >>
    if mode != 4 { >> errors.new("game GLB: only TRIANGLES are supported") }
    attributes := required(&parser.doc, node, "attributes") or >>
    attribute_fields := ["POSITION", "NORMAL", "TEXCOORD_0", "COLOR_0", "TANGENT", "JOINTS_0", "WEIGHTS_0"]
    fields(&parser.doc, attributes, &attribute_fields) or >>
    position_index := integer(&parser.doc, attributes, "POSITION", -1, 0, parser.accessors.len - 1) or >>
    position := parser.attribute(position_index, 3, 0) or >>
    if position.component != 5126 || position.normalized || !position.bounds ||
        position.count > MAX_ASSET_VERTICES - asset.positions.len { >> errors.new("game GLB: POSITION requires bounded float VEC3 and min/max") }
    normal_index := integer(&parser.doc, attributes, "NORMAL", -1, 0, parser.accessors.len - 1) or >>
    uv_index := integer(&parser.doc, attributes, "TEXCOORD_0", -1, 0, parser.accessors.len - 1) or >>
    color_index := integer(&parser.doc, attributes, "COLOR_0", -1, 0, parser.accessors.len - 1) or >>
    tangent_index := integer(&parser.doc, attributes, "TANGENT", -1, 0, parser.accessors.len - 1) or >>
    $tangent := absent_accessor()
    $normal := absent_accessor()
    $uv := absent_accessor()
    $color := absent_accessor()
    if normal_index >= 0 {
        normal = parser.attribute(normal_index, 3, position.count) or >>
        if normal.component != 5126 || normal.normalized { >> errors.new("game GLB: NORMAL requires float VEC3") }
    }
    if uv_index >= 0 {
        uv = parser.attribute(uv_index, 2, position.count) or >>
        if uv.component == 5125 || (uv.component != 5126 && !uv.normalized) { >> errors.new("game GLB: unsupported UV component encoding") }
    }
    if tangent_index >= 0 {
        if normal_index < 0 || uv_index < 0 { >> errors.new("game GLB: TANGENT profile requires NORMAL and TEXCOORD_0") }
        tangent = parser.attribute(tangent_index, 4, position.count) or >>
        if tangent.component != 5126 || tangent.normalized { >> errors.new("game GLB: TANGENT requires float VEC4") }
    }
    if color_index >= 0 {
        if color_index >= parser.accessors.len { >> errors.new("game GLB: color accessor invalid") }
        components := parser.accessors[color_index].components
        if components != 3 && components != 4 { >> errors.new("game GLB: COLOR_0 requires VEC3 or VEC4") }
        color = parser.attribute(color_index, components, position.count) or >>
        if color.component == 5125 || (color.component != 5126 && !color.normalized) { >> errors.new("game GLB: unsupported color encoding") }
    }
    first_vertex := asset.positions.len
    influences := parser.read_influences(attributes,position.count) or >>
    $minimum := fm.vec3(1000000000.0, 1000000000.0, 1000000000.0)
    $maximum := fm.vec3(-1000000000.0, -1000000000.0, -1000000000.0)
    for i in 0:position.count {
        point := parser.vector3(position, i) or >>
        if math.abs(point.x) > 1000000000.0 || math.abs(point.y) > 1000000000.0 || math.abs(point.z) > 1000000000.0 {
            >> errors.new("game GLB: position outside engine scalar limits")
        }
        minimum = fm.vec3(math.min(minimum.x, point.x), math.min(minimum.y, point.y), math.min(minimum.z, point.z))
        maximum = fm.vec3(math.max(maximum.x, point.x), math.max(maximum.y, point.y), math.max(maximum.z, point.z))
        $normal_value := fm.vec3(0.0, 0.0, 0.0)
        if normal_index >= 0 {
            normal_value = parser.vector3(normal, i) or >>
            if math.abs(normal_value.length() - 1.0) > 0.0001 { >> errors.new("game GLB: NORMAL must be unit length") }
        }
        $uv_value := fm.vec2(0.0, 0.0)
        if uv_index >= 0 {
            u := parser.component(uv, i, 0) or >>
            v := parser.component(uv, i, 1) or >>
            uv_value = fm.vec2(u, v)
        }
        $tangent_value := fm.vec4(0.0, 0.0, 0.0, 0.0)
        if tangent_index >= 0 {
            xyz := parser.vector3(tangent, i) or >>
            w := parser.component(tangent, i, 3) or >>
            if math.abs(xyz.length() - 1.0) > 0.0001 || (w != -1.0 && w != 1.0) {
                >> errors.new("game GLB: TANGENT must be unit with W = ±1")
            }
            // glTF requires unit tangent XYZ, but does not require exporter
            // tangents to be perpendicular to normals. Canonicalize the basis
            // used by our mesh contract, as the fragment shader also does.
            projected := xyz.sub(normal_value.scaled(xyz.dot(normal_value)))
            if projected.dot(projected)<1e-24 { >> errors.new("game GLB: TANGENT must be unit with a stable normal basis") }
            unit := projected.normalized() or >>
            tangent_value = fm.vec4(unit.x, unit.y, unit.z, w)
        }
        $packed_color := 4294967295
        if color_index >= 0 {
            $channels := [0, 0, 0]
            for channel in 0:3 {
                value := parser.component(color, i, channel) or >>
                if value < 0.0 || value > 1.0 { >> errors.new("game GLB: color outside 0...1") }
                channels[channel] = int(math.round_to_even(value * 255.0))
            }
            if color.components == 4 {
                alpha := parser.component(color, i, 3) or >>
                if alpha != 1.0 { >> errors.new("game GLB: geometry preview requires opaque vertex alpha") }
            }
            packed_color = (channels[0] << 24) | (channels[1] << 16) | (channels[2] << 8) | 255
        }
        asset.positions.push(point)
        asset.normals.push(normal_value)
        asset.tangents.push(tangent_value)
        asset.uvs.push(uv_value)
        asset.colors.push(packed_color)
        $js := []int{}
        $ws := []f64{}
        for value in influences[i].joints { js.push(value) }
        for value in influences[i].weights { ws.push(value) }
        asset.joints.push(JointWeights{joints: js,weights: ws})
    }
    if !bound_matches(minimum, position.minimum.xyz()) || !bound_matches(maximum, position.maximum.xyz()) {
        >> errors.new("game GLB: POSITION min/max do not match binary data")
    }
    indices_index := integer(&parser.doc, node, "indices", -1, 0, parser.accessors.len - 1) or >>
    first_index := asset.indices.len
    $index_count := position.count
    $indices := absent_accessor()
    if indices_index >= 0 { indices = parser.index_accessor(indices_index) or >>
        index_count = indices.count }
    if index_count % 3 != 0 || index_count > MAX_ASSET_INDICES - asset.indices.len { >> errors.new("game GLB: TRIANGLES index count invalid or budget exceeded") }
    for i in 0:index_count {
        $index := i
        if indices_index >= 0 {
            index = read_integer(&parser.bytes, indices.offset + i * indices.stride, indices.size) or >>
            $restart := 4294967295
            if indices.component == 5121 { restart = 255 }
            if indices.component == 5123 { restart = 65535 }
            if index == restart { >> errors.new("game GLB: primitive restart index is forbidden") }
        }
        if index < 0 || index >= position.count { >> errors.new("game GLB: mesh index outside vertex array") }
        asset.indices.push(index)
    }
    if tangent_index >= 0 {
        for i in 0:index_count / 3 {
            a := asset.indices[first_index + i * 3] + first_vertex
            b := asset.indices[first_index + i * 3 + 1] + first_vertex
            c := asset.indices[first_index + i * 3 + 2] + first_vertex
            if asset.tangents[a].w != asset.tangents[b].w || asset.tangents[a].w != asset.tangents[c].w {
                >> errors.new("game GLB: triangle has mixed tangent handedness")
            }
        }
    }
    material := integer(&parser.doc, node, "material", -1, 0, asset.materials.len - 1) or >>
    asset.primitives.push(GlbPrimitive{first_vertex: first_vertex, vertex_count: position.count,
        first_index: first_index, index_count: index_count, normals: normal_index >= 0, uvs: uv_index >= 0, tangents: tangent_index >= 0, material: material})
    << 0
}
fn bound_matches(actual fm.Vec3, declared fm.Vec3) bool {
    << math.abs(actual.x - declared.x) <= 0.000001 * math.max(1.0, math.abs(actual.x)) &&
        math.abs(actual.y - declared.y) <= 0.000001 * math.max(1.0, math.abs(actual.y)) &&
        math.abs(actual.z - declared.z) <= 0.000001 * math.max(1.0, math.abs(actual.z))
}
