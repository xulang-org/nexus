@"github.com/xulang-org/nexus/formats/gltf"

fm #"github.com/xulang-org/nexus/foundation/math"
#encoding/json
#math
#errors

fn node_transform(doc &json.Doc, node int) fm.Mat4 {
    matrix_node := doc.get(node, "matrix")
    if matrix_node >= 0 {
        if doc.has(node, "translation") || doc.has(node, "rotation") || doc.has(node, "scale") {
            >>> errors.new("nexus GLB: node matrix and TRS cannot coexist")
        }
        values := float_vector(doc, matrix_node, 16) >>>
        result := fm.Mat4{c0: fm.vec4(values[0], values[1], values[2], values[3]),
            c1: fm.vec4(values[4], values[5], values[6], values[7]), c2: fm.vec4(values[8], values[9], values[10], values[11]),
            c3: fm.vec4(values[12], values[13], values[14], values[15])}
        if !result.is_affine() { >>> errors.new("nexus GLB: node matrix must be finite affine") }
        // glTF matrices must be decomposable into TRS, hence no sheared basis.
        axes := [result.c0.xyz(), result.c1.xyz(), result.c2.xyz()]
        for i in 0:3 {
            for j in i + 1:3 {
                a := axes[i]
                b := axes[j]
                if a.length() == 0.0 || b.length() == 0.0 { -> }
                an := a.normalized() >>>
                bn := b.normalized() >>>
                if math.abs(an.dot(bn)) > 0.00001 { >>> errors.new("nexus GLB: sheared node matrix is not TRS") }
            }
        }
        << result
    }
    translation := property_vec3(doc, node, "translation", fm.vec3(0.0, 0.0, 0.0)) >>>
    scale := property_vec3(doc, node, "scale", fm.vec3(1.0, 1.0, 1.0)) >>>
    $rotation := fm.identity_3d()
    rotation_node := doc.get(node, "rotation")
    if rotation_node >= 0 {
        values := float_vector(doc, rotation_node, 4) >>>
        length := values[0] * values[0] + values[1] * values[1] + values[2] * values[2] + values[3] * values[3]
        if !fm.finite(length) || math.abs(length - 1.0) > 0.0001 { >>> errors.new("nexus GLB: rotation quaternion must be unit length") }
        rotation = fm.quaternion(values[0], values[1], values[2], values[3]).rotation_matrix() >>>
    }
    result := fm.translation_3d(translation).multiply(rotation).multiply(fm.scale_3d(scale))
    if !result.is_affine() { >>> errors.new("nexus GLB: TRS transform overflow") }
    << result
}
fn read_nodes(doc &json.Doc, root int, asset $&GlbGeometry) int {
    nodes := array_property(doc, root, "nodes", 1, MAX_ASSET_NODES) >>>
    allowed := ["name", "children", "mesh", "matrix", "translation", "rotation", "scale", "skin"]
    for node in nodes {
        fields(doc, node, &allowed) >>>
        mesh := integer(doc, node, "mesh", -1, 0, asset.meshes.len - 1) >>>
        local := node_transform(doc, node) >>>
        for column in [local.c0, local.c1, local.c2, local.c3] {
            if math.abs(column.x) > 1000000000.0 || math.abs(column.y) > 1000000000.0 || math.abs(column.z) > 1000000000.0 {
                >>> errors.new("nexus GLB: node transform exceeds engine scalar limits")
            }
        }
        name := text(doc, node, "name", "") >>>
        $rotation := fm.vec4(0.0,0.0,0.0,1.0)
        r := doc.get(node,"rotation")
        if r>=0 { values := float_vector(doc,r,4) >>>
            rotation=fm.vec4(values[0],values[1],values[2],values[3]) }
        asset.nodes.push(GlbNode{parent: -1, mesh: mesh, local: local, name: name, depth: 0, selected: false,
            skin: integer(doc,node,"skin",-1,0,127) >>>,
            translation: property_vec3(doc,node,"translation",fm.vec3(0.0,0.0,0.0)) >>>,
            rotation: rotation,scale: property_vec3(doc,node,"scale",fm.vec3(1.0,1.0,1.0)) >>>,matrix: doc.has(node,"matrix")})
    }
    // A forest with one parent per node. Parent assignment detects duplicate
    // edges; breadth-first reachability detects cycles even outside the scene.
    $children := []int{}
    $firsts := []int{}
    $counts := []int{}
    for i in 0:nodes.len {
        firsts.push(children.len)
        child_list := doc.get(nodes[i], "children")
        $count := 0
        if child_list >= 0 {
            items := list(doc, child_list, 1, MAX_ASSET_NODES) >>>
            for item in items {
                child := doc.as_int(item) >>>
                if child < 0 || child >= nodes.len || child == i || asset.nodes[child].parent >= 0 {
                    >>> errors.new("nexus GLB: invalid child, multiple parents or duplicate edge")
                }
                asset.nodes[child].parent = i
                children.push(child)
            }
            count = items.len
        }
        counts.push(count)
    }
    $order := []int{}
    for i in 0:nodes.len { if asset.nodes[i].parent < 0 { order.push(i) } }
    $cursor := 0
    while cursor < order.len {
        index := order[cursor]
        for i in 0:counts[index] {
            child := children[firsts[index] + i]
            depth := asset.nodes[index].depth + 1
            if depth > 64 { >>> errors.new("nexus GLB: node hierarchy exceeds depth 64") }
            asset.nodes[child].depth = depth
            order.push(child)
        }
        cursor = cursor + 1
    }
    if order.len != nodes.len { >>> errors.new("nexus GLB: cyclic node hierarchy") }
    scenes := array_property(doc, root, "scenes", 1, 64) >>>
    selected := integer(doc, root, "scene", 0, 0, scenes.len - 1) >>>
    scene_fields := ["nodes", "name"]
    for i in 0:scenes.len {
        fields(doc, scenes[i], &scene_fields) >>>
        scene_nodes := array_property(doc, scenes[i], "nodes", 1, MAX_ASSET_NODES) >>>
        $seen := map[int]bool{}
        for node in scene_nodes {
            index := doc.as_int(node) >>>
            if index < 0 || index >= asset.nodes.len || asset.nodes[index].parent >= 0 || seen.has(index) {
                >>> errors.new("nexus GLB: invalid or duplicate scene root")
            }
            seen[index] = true
            if i == selected { asset.nodes[index].selected = true }
        }
    }
    for index in order {
        parent := asset.nodes[index].parent
        if parent >= 0 { asset.nodes[index].selected = asset.nodes[parent].selected }
        if asset.nodes[index].selected { asset.order.push(index) }
    }
    << 0
}
pub fn (asset &GlbGeometry) node_transform(index int) fm.Mat4 {
    if index < 0 || index >= asset.nodes.len { >>> errors.new("nexus GLB: node index out of range") }
    << asset.nodes[index].local
}
pub fn (asset &GlbGeometry) node_name(index int) string {
    if index < 0 || index >= asset.nodes.len { >>> errors.new("nexus GLB: node index out of range") }
    << asset.nodes[index].name + ""
}
