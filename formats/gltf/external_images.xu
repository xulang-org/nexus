@"github.com/xulang-org/game/formats/gltf"

#strings
#errors
#crypto/sha256

// A bounded portable relative-file subset; filesystem adapter rejects symlink escapes.
fn validate_image_uri(uri &string) int {
    if uri.len<5 || uri.len>1024 || (!strings.has_suffix(uri,".png") && !strings.has_suffix(uri,".jpg") && !strings.has_suffix(uri,".jpeg")) { >> errors.new("game GLB: external image requires a relative PNG/JPEG URI") }
    for i in 0:uri.len { c := uri[i]
        if c<32 || c==58 || c==92 || c==37 || c==63 || c==35 { >> errors.new("game GLB: unsupported external image URI character") } }
    for part in strings.split(uri,"/") { if part.len==0 || part=="." || part==".." { >> errors.new("game GLB: external image path escapes asset directory") } }
    << 0
}
pub fn (asset &GlbGeometry) image_uri(index int) string {
    if index<0 || index>=asset.images.len { >> errors.new("game GLB: image index out of range") }
    << asset.images[index].uri+""
}
pub fn (asset &GlbGeometry) image_mime(index int) string {
    if index<0 || index>=asset.images.len { >> errors.new("game GLB: image index out of range") }
    << asset.images[index].mime+""
}
fn image_signature(bytes &[]int,mime string) int {
    if bytes.len<8 { >> errors.new("game GLB: truncated image signature") }
    if mime=="image/jpeg" {
        if bytes[0]==255 && bytes[1]==216 && bytes[2]==255 { << 0 }
    } else {
        expected := [137,80,78,71,13,10,26,10]
        $matches := true
        for i in 0:8 { if bytes[i]!=expected[i] { matches=false } }
        if matches { << 0 }
    }
    >> errors.new("game GLB: image signature does not match MIME")
}
pub fn (asset $&GlbGeometry) resolve_image(index int,raw &string) int {
    if index<0 || index>=asset.images.len || asset.images[index].uri.len==0 || raw.len<8 { >> errors.new("game GLB: invalid external image resolution") }
    $total := raw.len
    for i in 0:asset.images.len { if i!=index { total+=asset.images[i].bytes.len } }
    if total>8388608 { >> errors.new("game GLB: combined encoded image budget exceeded") }
    $bytes := []int{}
    for i in 0:raw.len { bytes.push(raw[i] & 255) }
    image_signature(&bytes,asset.images[index].mime+"") or >>
    asset.images[index].bytes=bytes
    $fingerprint := strings.new_byte_builder(1024)
    fingerprint.write_str(asset.source_hash+"")
    for i in 0:asset.images.len {
        uri := asset.images[i].uri+""
        if uri.len==0 { -> }
        $content := strings.new_byte_builder(asset.images[i].bytes.len)
        for octet in asset.images[i].bytes { content.write_byte(octet) }
        fingerprint.write_str("/"+str(uri.len)+":"+uri+":"+sha256.sum256(content.to_string()))
    }
    asset.resolved_hash=sha256.sum256(fingerprint.to_string())
    << 0
}
