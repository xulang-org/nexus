@"github.com/xulang-org/nexus/formats/gltf"

fm #"github.com/xulang-org/nexus/foundation/math"
#math
#encoding/json
#encoding/binary
#errors

struct BufferView {
    offset int
    length int
    stride int
    target int
    usage int
    attributes int
}
struct Accessor {
    view int
    offset int
    stride int
    count int
    component int
    size int
    components int
    normalized bool
    minimum fm.Vec4
    maximum fm.Vec4
    bounds bool
    usage int
}
struct GlbParser {
    doc json.Doc
    bytes []int
    length int
    views []BufferView
    accessors []Accessor
}
fn new_glb_parser(doc json.Doc, bytes []int, length int) GlbParser {
    << GlbParser{doc: doc, bytes: bytes, length: length, views: []BufferView{}, accessors: []Accessor{}}
}
fn (parser $&GlbParser) read_views(root int) int {
    nodes := array_property(&parser.doc, root, "bufferViews", 1, 4096) >>>
    allowed := ["buffer", "byteOffset", "byteLength", "byteStride", "target", "name"]
    for node in nodes {
        fields(&parser.doc, node, &allowed) >>>
        buffer := integer(&parser.doc, node, "buffer", -1, 0, 0) >>>
        offset := integer(&parser.doc, node, "byteOffset", 0, 0, parser.length) >>>
        length := integer(&parser.doc, node, "byteLength", -1, 1, parser.length) >>>
        stride := integer(&parser.doc, node, "byteStride", 0, 4, 252) >>>
        target := integer(&parser.doc, node, "target", 0, 34962, 34963) >>>
        if buffer != 0 || length < 1 || length > parser.length - offset || (stride != 0 && stride % 4 != 0) {
            >>> errors.new("nexus GLB: invalid bufferView range or stride")
        }
        parser.views.push(BufferView{offset: offset, length: length, stride: stride, target: target, usage: 0, attributes: 0})
    }
    << 0
}
fn component_size(component int) int {
    if component == 5121 { << 1 }
    if component == 5123 { << 2 }
    if component == 5125 || component == 5126 { << 4 }
    >>> errors.new("nexus GLB: unsupported accessor component type")
}
fn component_count(kind &string) int {
    if *kind == "SCALAR" { << 1 }
    if *kind == "VEC2" { << 2 }
    if *kind == "VEC3" { << 3 }
    if *kind == "VEC4" { << 4 }
    if *kind == "MAT4" { << 16 }
    >>> errors.new("nexus GLB: unsupported accessor shape")
}
fn accessor_bound(doc &json.Doc, node int, key string, count int) fm.Vec4 {
    value := doc.get(node, key)
    if value < 0 { << fm.vec4(0.0, 0.0, 0.0, 0.0) }
    numbers := float_vector(doc, value, count) >>>
    $result := fm.vec4(numbers[0], 0.0, 0.0, 0.0)
    if count > 1 { result.y = numbers[1] }
    if count > 2 { result.z = numbers[2] }
    if count > 3 { result.w = numbers[3] }
    << result
}
fn (parser $&GlbParser) read_accessors(root int) int {
    nodes := array_property(&parser.doc, root, "accessors", 1, 4096) >>>
    allowed := ["bufferView", "byteOffset", "componentType", "normalized", "count", "type", "min", "max", "name"]
    for node in nodes {
        fields(&parser.doc, node, &allowed) >>>
        view_index := integer(&parser.doc, node, "bufferView", -1, 0, parser.views.len - 1) >>>
        if view_index < 0 { >>> errors.new("nexus GLB: accessors require a bufferView; sparse is unsupported") }
        view := parser.views[view_index]
        offset := integer(&parser.doc, node, "byteOffset", 0, 0, view.length) >>>
        component := integer(&parser.doc, node, "componentType", -1, 5121, 5126) >>>
        size := component_size(component) >>>
        if size < 1 { >>> errors.new("nexus GLB: invalid component byte size") }
        kind := text(&parser.doc, node, "type", "") >>>
        components := component_count(&kind) >>>
        count := integer(&parser.doc, node, "count", -1, 1, MAX_ASSET_INDICES) >>>
        normalized := boolean(&parser.doc, node, "normalized", false) >>>
        if normalized && (component == 5125 || component == 5126) { >>> errors.new("nexus GLB: invalid normalized component type") }
        element := size * components
        $stride := view.stride
        if stride == 0 { stride = element }
        if stride < 1 { >>> errors.new("nexus GLB: empty stride") }
        if count < 1 || offset % size != 0 || (view.offset + offset) % size != 0 || stride < element || stride % size != 0 ||
            element > view.length - offset {
            >>> errors.new("nexus GLB: accessor alignment or range invalid")
        }
        if count - 1 > (view.length - offset - element) / stride { >>> errors.new("nexus GLB: accessor exceeds bufferView") }
        if components==16 && (parser.doc.has(node,"min") || parser.doc.has(node,"max")) { >>> errors.new("nexus GLB: matrix accessor bounds unsupported") }
        $bound_components := components
        if components==16 { bound_components=4 }
        minimum := accessor_bound(&parser.doc, node, "min", bound_components) >>>
        maximum := accessor_bound(&parser.doc, node, "max", bound_components) >>>
        has_min := parser.doc.has(node, "min")
        has_max := parser.doc.has(node, "max")
        if has_min && has_max && (minimum.x > maximum.x || minimum.y > maximum.y || minimum.z > maximum.z || minimum.w > maximum.w) {
            >>> errors.new("nexus GLB: reversed accessor bounds")
        }
        parser.accessors.push(Accessor{view: view_index, offset: view.offset + offset, stride: stride,
            count: count, component: component, size: size, components: components, normalized: normalized,
            minimum: minimum, maximum: maximum, bounds: has_min && has_max, usage: 0})
    }
    << 0
}
fn (parser $&GlbParser) attribute(index int, expected int, count int) Accessor {
    if index < 0 || index >= parser.accessors.len { >>> errors.new("nexus GLB: attribute accessor index invalid") }
    accessor := parser.accessors[index]
    view := parser.views[accessor.view]
    if accessor.components != expected || (count > 0 && accessor.count != count) ||
        accessor.offset % 4 != 0 || (accessor.offset - view.offset) % 4 != 0 || accessor.stride % 4 != 0 || accessor.usage == 2 || view.usage == 2 || view.usage == 4 ||
        (view.target != 0 && view.target != 34962) {
        >>> errors.new("nexus GLB: incompatible vertex attribute or layout")
    }
    if accessor.usage == 0 {
        parser.views[accessor.view].attributes = view.attributes + 1
        if view.attributes > 0 && view.stride == 0 { >>> errors.new("nexus GLB: shared vertex bufferView requires byteStride") }
        parser.accessors[index].usage = 1
        parser.views[accessor.view].usage = 1
    }
    << accessor
}
fn (parser $&GlbParser) index_accessor(index int) Accessor {
    if index < 0 || index >= parser.accessors.len { >>> errors.new("nexus GLB: indices accessor invalid") }
    accessor := parser.accessors[index]
    view := parser.views[accessor.view]
    if accessor.components != 1 || accessor.component == 5126 || accessor.normalized || view.stride != 0 ||
        accessor.usage == 1 || view.usage == 1 || view.usage == 4 || (view.target != 0 && view.target != 34963) {
        >>> errors.new("nexus GLB: incompatible index accessor")
    }
    parser.accessors[index].usage = 2
    parser.views[accessor.view].usage = 2
    << accessor
}
fn read_integer(bytes &[]int, offset int, size int) int {
    if size == 1 { << bytes[offset] }
    if size == 2 { << binary.little_endian().get_u16(bytes, offset) >>> }
    << binary.little_endian().get_u32(bytes, offset) >>>
}
fn (parser &GlbParser) component(accessor Accessor, index int, component int) f64 {
    offset := accessor.offset + accessor.stride * index + accessor.size * component
    bits := read_integer(&parser.bytes, offset, accessor.size) >>>
    if accessor.component == 5126 {
        if ((bits >> 23) & 255) == 255 { >>> errors.new("nexus GLB: non-finite input component") }
        << math.float32_from_bits(bits)
    }
    if accessor.component == 5121 { << f64(bits) / 255.0 }
    << f64(bits) / 65535.0
}
fn (parser &GlbParser) vector3(accessor Accessor, index int) fm.Vec3 {
    x := parser.component(accessor, index, 0) >>>
    y := parser.component(accessor, index, 1) >>>
    z := parser.component(accessor, index, 2) >>>
    << fm.vec3(x, y, z)
}
