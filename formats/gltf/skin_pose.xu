@"github.com/xulang-org/nexus/formats/gltf"

fm #"github.com/xulang-org/nexus/foundation/math"
#errors

pub fn (asset &GlbGeometry) skin_palette(node int,worlds &[]fm.Mat4) []fm.Mat4 {
    skin_index := asset.node_skin(node) >>>
    if worlds.len!=asset.nodes.len || skin_index<0 { >>> errors.new("nexus GLB: skin palette requires complete world pose and skinned node") }
    inverse := worlds[node].affine_inverse() >>>
    skin := &asset.skins[skin_index]
    $palette := []fm.Mat4{}
    for i in 0:skin.joints.len {
        matrix := inverse.multiply(worlds[skin.joints[i]]).multiply(skin.inverse_bind[i])
        if !matrix.is_affine() { >>> errors.new("nexus GLB: non-finite skin palette") }
        palette.push(matrix)
    }
    << palette
}
pub fn (asset &GlbGeometry) skin_matrix(primitive int,vertex int,palette &[]fm.Mat4) fm.Mat4 {
    at := asset.vertex_index(primitive,vertex) >>>
    influence := &asset.joints[at]
    if influence.joints.len!=4 { >>> errors.new("nexus GLB: vertex has no skin influences") }
    $columns := [fm.vec4(0.0,0.0,0.0,0.0),fm.vec4(0.0,0.0,0.0,0.0),fm.vec4(0.0,0.0,0.0,0.0),fm.vec4(0.0,0.0,0.0,0.0)]
    for i in 0:4 {
        j := influence.joints[i]
        if j<0 || j>=palette.len { >>> errors.new("nexus GLB: skin influence outside palette") }
        matrix := palette[j]
        source := [matrix.c0,matrix.c1,matrix.c2,matrix.c3]
        for c in 0:4 { columns[c]=mix4(columns[c],source[c],1.0,influence.weights[i]) }
    }
    columns[0].w=0.0
    columns[1].w=0.0
    columns[2].w=0.0
    columns[3].w=1.0
    result := fm.Mat4{c0: columns[0],c1: columns[1],c2: columns[2],c3: columns[3]}
    if !result.is_affine() { >>> errors.new("nexus GLB: invalid blended skin matrix") }
    << result
}
pub fn (asset &GlbGeometry) skin_joint_count(skin int) int {
    if skin < 0 || skin >= asset.skins.len { >>> errors.new("nexus GLB: skin index out of range") }
    << asset.skins[skin].joints.len
}
pub fn (asset &GlbGeometry) vertex_skin_joints(primitive int, vertex int) []int {
    at := asset.vertex_index(primitive, vertex) >>>
    influence := &asset.joints[at]
    if influence.joints.len != 4 { >>> errors.new("nexus GLB: vertex has no skin influences") }
    << [influence.joints[0], influence.joints[1], influence.joints[2], influence.joints[3]]
}
pub fn (asset &GlbGeometry) vertex_skin_weights(primitive int, vertex int) []f64 {
    at := asset.vertex_index(primitive, vertex) >>>
    influence := &asset.joints[at]
    if influence.weights.len != 4 { >>> errors.new("nexus GLB: vertex has no skin influences") }
    << [influence.weights[0], influence.weights[1], influence.weights[2], influence.weights[3]]
}
