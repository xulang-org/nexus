@"github.com/xulang-org/nexus/formats/gltf"

fm #"github.com/xulang-org/nexus/foundation/math"
#math
#errors

struct AnimationTrack { node int
    path string
    interpolation string
    times []f64
    values []fm.Vec4 }
struct AnimationDescription { name string
    duration f64
    tracks []AnimationTrack }
fn (parser $&GlbParser) read_animations(root int,asset $&GlbGeometry) int {
    nodes := optional_array(&parser.doc,root,"animations",128) or >>
    $budget := 0
    for node in nodes {
        allowed := ["name","channels","samplers"]
        fields(&parser.doc,node,&allowed) or >>
        samplers := array_property(&parser.doc,node,"samplers",1,4096) or >>
        for sampler in samplers {
            sf := ["input","output","interpolation"]
            fields(&parser.doc,sampler,&sf) or >>
            mode := text(&parser.doc,sampler,"interpolation","LINEAR") or >>
            if mode!="LINEAR" && mode!="STEP" && mode!="CUBICSPLINE" { >> errors.new("nexus GLB: invalid animation interpolation") }
            input := parser.data_accessor(integer(&parser.doc,sampler,"input",-1,0,parser.accessors.len-1) or >>,1) or >>
            oi := integer(&parser.doc,sampler,"output",-1,0,parser.accessors.len-1) or >>
            if oi<0 || (parser.accessors[oi].components!=3 && parser.accessors[oi].components!=4) { >> errors.new("nexus GLB: animation output must be VEC3/VEC4") }
            output := parser.data_accessor(oi,parser.accessors[oi].components) or >>
            $factor := 1
            if mode=="CUBICSPLINE" { factor=3 }
            if output.count!=input.count*factor || !input.bounds { >> errors.new("nexus GLB: animation sample counts or time bounds invalid") }
            $previous := -1.0
            for k in 0:input.count {
                t := parser.component(input,k,0) or >>
                if t<0.0 || t<=previous || t>1000000000.0 { >> errors.new("nexus GLB: animation times must be finite, nonnegative and strictly increasing") }
                if k==0 && math.abs(t-input.minimum.x)>0.000001 { >> errors.new("nexus GLB: animation minimum time mismatch") }
                previous=t
            }
            if math.abs(previous-input.maximum.x)>0.000001 { >> errors.new("nexus GLB: animation maximum time mismatch") }
        }
        channels := array_property(&parser.doc,node,"channels",1,4096) or >>
        $tracks := []AnimationTrack{}
        $seen := map[string]bool{}
        $duration := 0.0
        for channel in channels {
            cf := ["sampler","target"]
            fields(&parser.doc,channel,&cf) or >>
            si := integer(&parser.doc,channel,"sampler",-1,0,samplers.len-1) or >>
            if si<0 { >> errors.new("nexus GLB: animation channel needs sampler") }
            target := required(&parser.doc,channel,"target") or >>
            tf := ["node","path"]
            fields(&parser.doc,target,&tf) or >>
            ni := integer(&parser.doc,target,"node",-1,0,asset.nodes.len-1) or >>
            path := text(&parser.doc,target,"path","") or >>
            if ni<0 || asset.nodes[ni].matrix || (path!="translation" && path!="rotation" && path!="scale") { >> errors.new("nexus GLB: animation targets require TRS nodes and translation/rotation/scale paths") }
            key := str(ni)+"/"+path
            if seen.has(key+"") { >> errors.new("nexus GLB: duplicate animation channel target") }
            seen[key]=true
            sampler := samplers[si]
            input := parser.data_accessor(integer(&parser.doc,sampler,"input",-1,0,parser.accessors.len-1) or >>,1) or >>
            $components := 3
            if path=="rotation" { components=4 }
            output := parser.data_accessor(integer(&parser.doc,sampler,"output",-1,0,parser.accessors.len-1) or >>,components) or >>
            if output.count>262144-budget { >> errors.new("nexus GLB: animation key budget exceeded") }
            budget+=output.count
            mode := text(&parser.doc,sampler,"interpolation","LINEAR") or >>
            $times := []f64{}
            $values := []fm.Vec4{}
            for k in 0:input.count { times.push(parser.component(input,k,0) or >>) }
            for k in 0:output.count {
                xyz := parser.vector3(output,k) or >>
                $w := 0.0
                if components==4 { w=parser.component(output,k,3) or >> }
                value := fm.vec4(xyz.x,xyz.y,xyz.z,w)
                if path=="rotation" && (mode!="CUBICSPLINE" || k%3==1) && math.abs(xyz.dot(xyz)+w*w-1.0)>0.0001 { >> errors.new("nexus GLB: rotation keys must be unit quaternions") }
                values.push(value)
            }
            duration=math.max(duration,times[times.len-1])
            tracks.push(AnimationTrack{node: ni,path: path,interpolation: mode,times: times,values: values})
        }
        asset.animations.push(AnimationDescription{name: text(&parser.doc,node,"name","") or >>,duration: duration,tracks: tracks})
    }
    << 0
}
fn mix4(a fm.Vec4,b fm.Vec4,x f64,y f64) fm.Vec4 { << fm.vec4(a.x*x+b.x*y,a.y*x+b.y*y,a.z*x+b.z*y,a.w*x+b.w*y) }
fn rotation_unit(v fm.Vec4) fm.Vec4 {
    q := fm.quaternion(v.x,v.y,v.z,v.w).normalized() or >>
    << fm.vec4(q.x,q.y,q.z,q.w)
}
fn sample_track(track &AnimationTrack,time f64) fm.Vec4 {
    $at := 0
    // Binary search supports random access and clips with many keys.
    $high := track.times.len
    while at<high {
        mid := at+(high-at)/2
        if track.times[mid]<=time { at=mid+1
        } else { high=mid }
    }
    if at>0 { at-=1 }
    $factor := 1
    $offset := 0
    if track.interpolation=="CUBICSPLINE" { factor=3
        offset=1 }
    a := track.values[at*factor+offset]
    if time<=track.times[0] || at+1>=track.times.len || track.interpolation=="STEP" { << a }
    delta := track.times[at+1]-track.times[at]
    t := (time-track.times[at])/delta
    $b := track.values[(at+1)*factor+offset]
    if track.interpolation=="CUBICSPLINE" {
        p := mix4(a,b,2.0*t*t*t-3.0*t*t+1.0,-2.0*t*t*t+3.0*t*t)
        tangent := mix4(track.values[at*3+2],track.values[(at+1)*3],(t*t*t-2.0*t*t+t)*delta,(t*t*t-t*t)*delta)
        result := mix4(p,tangent,1.0,1.0)
        if track.path=="rotation" { << rotation_unit(result) or >> }
        << result
    }
    if track.path!="rotation" { << mix4(a,b,1.0-t,t) }
    $dot := a.x*b.x+a.y*b.y+a.z*b.z+a.w*b.w
    if dot<0.0 { b=mix4(b,b,-1.0,0.0)
        dot = -dot }
    dot=math.min(dot,1.0)
    if dot>0.9995 { << rotation_unit(mix4(a,b,1.0-t,t)) or >> }
    angle := math.acos(dot)
    << rotation_unit(mix4(a,b,math.sin((1.0-t)*angle)/math.sin(angle),math.sin(t*angle)/math.sin(angle))) or >>
}
pub fn (asset &GlbGeometry) animation_count() int { << asset.animations.len }
pub fn (asset &GlbGeometry) animation_name(index int) string {
    if index<0 || index>=asset.animations.len { >> errors.new("nexus GLB: animation index out of range") }
    << asset.animations[index].name+""
}
pub fn (asset &GlbGeometry) animation_duration(index int) f64 {
    if index<0 || index>=asset.animations.len { >> errors.new("nexus GLB: animation index out of range") }
    << asset.animations[index].duration
}
// Explicit time, clamped to each track. Looping/blending belongs to a player.
// -1 returns the authored pose. Each sample starts from authored TRS values.
pub fn (asset &GlbGeometry) sample_pose(index int,time f64) []fm.Mat4 {
    if index< -1 || index>=asset.animations.len || !fm.finite(time) { >> errors.new("nexus GLB: invalid animation sample") }
    $translations := []fm.Vec3{}
    $rotations := []fm.Vec4{}
    $scales := []fm.Vec3{}
    for node in asset.nodes { translations.push(node.translation)
        rotations.push(node.rotation)
        scales.push(node.scale) }
    if index>=0 {
        for j in 0:asset.animations[index].tracks.len {
            track := &asset.animations[index].tracks[j]
            value := sample_track(track,time) or >>
            if track.path=="translation" { translations[track.node]=value.xyz()
            } else if track.path=="rotation" { rotations[track.node]=value
            } else { scales[track.node]=value.xyz() }
        }
    }
    $result := []fm.Mat4{}
    for i in 0:asset.nodes.len {
        $local := asset.nodes[i].local
        if !asset.nodes[i].matrix {
            q := rotations[i]
            rotation := fm.quaternion(q.x,q.y,q.z,q.w).rotation_matrix() or >>
            local=fm.translation_3d(translations[i]).multiply(rotation).multiply(fm.scale_3d(scales[i]))
        }
        if !local.is_affine() { >> errors.new("nexus GLB: animated transform overflow") }
        result.push(local)
    }
    << result
}
pub fn (asset &GlbGeometry) world_pose(locals &[]fm.Mat4) []fm.Mat4 {
    if locals.len!=asset.nodes.len { >> errors.new("nexus GLB: pose node count mismatch") }
    $result := []fm.Mat4{}
    for matrix in locals { if !matrix.is_affine() { >> errors.new("nexus GLB: invalid pose matrix") }
        result.push(matrix) }
    // Depth ordering includes joints outside the selected scene.
    for depth in 1:65 { for i in 0:asset.nodes.len {
        if asset.nodes[i].depth==depth { result[i]=result[asset.nodes[i].parent].multiply(locals[i]) }
    } }
    for matrix in result { if !matrix.is_affine() { >> errors.new("nexus GLB: world pose overflow") } }
    << result
}
