@"github.com/xulang-org/nexus/formats/gltf"

fm #"github.com/xulang-org/nexus/foundation/math"
#errors

// Format-level descriptions; no live scene IDs, GPU handles, or engine object.
pub struct NodeDescription {
    pub parent int
    pub mesh int
    pub local fm.Mat4
    pub name string
}
pub fn (asset &GlbGeometry) describe_node(index int) NodeDescription {
    if index < 0 || index >= asset.nodes.len { >>> errors.new("nexus GLB: node index out of range") }
    node := &asset.nodes[index]
    << NodeDescription{parent: node.parent, mesh: node.mesh, local: node.local, name: node.name + ""}
}
pub fn (asset &GlbGeometry) selected_node_count() int { << asset.order.len }
pub fn (asset &GlbGeometry) selected_node(index int) int {
    if index < 0 || index >= asset.order.len { >>> errors.new("nexus GLB: selected node index out of range") }
    << asset.order[index]
}
pub fn (asset &GlbGeometry) mesh_first_primitive(index int) int {
    if index < 0 || index >= asset.meshes.len { >>> errors.new("nexus GLB: mesh index out of range") }
    << asset.meshes[index].first
}
pub fn (asset &GlbGeometry) mesh_primitive_count(index int) int {
    if index < 0 || index >= asset.meshes.len { >>> errors.new("nexus GLB: mesh index out of range") }
    << asset.meshes[index].count
}
