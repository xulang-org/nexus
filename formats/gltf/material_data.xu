@"github.com/xulang-org/game/formats/gltf"

fm #"github.com/xulang-org/game/foundation/math"
#encoding/json
#errors
#strings

pub struct MaterialDescription {
    pub base fm.Vec3
    pub alpha f64
    pub metallic f64
    pub roughness f64
    pub emission fm.Vec3
    pub base_texture int
    pub metallic_roughness_texture int
    pub normal_texture int
    pub normal_scale f64
    pub occlusion_texture int
    pub occlusion_strength f64
    pub emission_texture int
    pub double_sided bool
}
pub struct TextureDescription { pub image int
    pub sampler int }
pub struct SamplerDescription { pub min_filter int
    pub mag_filter int
    pub wrap_u int
    pub wrap_v int }
struct EmbeddedImage { bytes []int
    uri string
    mime string }
pub fn default_material() MaterialDescription {
    << MaterialDescription{base: fm.vec3(1.0, 1.0, 1.0), alpha: 1.0, metallic: 1.0, roughness: 1.0,
        emission: fm.vec3(0.0, 0.0, 0.0), base_texture: -1, metallic_roughness_texture: -1,
        normal_texture: -1, normal_scale: 1.0, occlusion_texture: -1, occlusion_strength: 1.0,
        emission_texture: -1, double_sided: false}
}
pub fn default_sampler() SamplerDescription {
    << SamplerDescription{min_filter: 9987, mag_filter: 9729, wrap_u: 10497, wrap_v: 10497}
}
fn optional_array(doc &json.Doc, root int, key string, maximum int) []int {
    node := doc.get(root, key)
    if node < 0 { << []int{} }
    << list(doc, node, 1, maximum) or >>
}
fn bounded_number(doc &json.Doc, node int, key string, fallback f64, maximum f64) f64 {
    at := doc.get(node, key + "")
    if at < 0 { << fallback }
    value := number(doc, at) or >>
    if value < 0.0 || value > maximum { >> errors.new("game GLB: material number outside profile: " + key) }
    << value
}
fn texture_info(doc &json.Doc, parent int, key string, count int, extra string) int {
    node := doc.get(parent, key)
    if node < 0 { << -1 }
    $allowed := ["index", "texCoord"]
    if extra.len > 0 { allowed.push(extra) }
    supported := ["KHR_texture_transform"]
    fields_extensions(doc,node,&allowed,&supported) or >>
    extension := doc.get(node,"extensions")
    if extension>=0 {
        transform := doc.get(extension,"KHR_texture_transform")
        if transform>=0 {
            tf := ["offset","rotation","scale","texCoord"]
            fields(doc,transform,&tf) or >>
            if (integer(doc,transform,"texCoord",0,0,2147483647) or >>)!=0 { >> errors.new("game GLB: texture transform requires UV0") }
            if (bounded_number(doc,transform,"rotation",0.0,0.0) or >>)!=0.0 { >> errors.new("game GLB: nonidentity texture transform unsupported") }
            for key in ["offset","scale"] {
                value := doc.get(transform,key+"")
                if value>=0 {
                    values := float_vector(doc,value,2) or >>
                    $expected := 0.0
                    if key=="scale" { expected=1.0 }
                    if values[0]!=expected || values[1]!=expected { >> errors.new("game GLB: nonidentity texture transform unsupported") }
                }
            }
        }
    }
    index := integer(doc, node, "index", -1, 0, count - 1) or >>
    if index < 0 { >> errors.new("game GLB: textureInfo requires index") }
    if (integer(doc, node, "texCoord", 0, 0, 2147483647) or >>) != 0 { >> errors.new("game GLB: material profile only supports TEXCOORD_0") }
    << index
}
fn (parser $&GlbParser) read_material_data(root int, asset $&GlbGeometry) int {
    image_nodes := optional_array(&parser.doc, root, "images", 32) or >>
    $encoded_size := 0
    for node in image_nodes {
        allowed := ["bufferView", "mimeType", "name", "uri"]
        fields(&parser.doc, node, &allowed) or >>
        text(&parser.doc, node, "name", "") or >>
        uri := text(&parser.doc,node,"uri","") or >>
        if uri.len>0 {
            validate_image_uri(&uri) or >>
            $fallback := "image/png"
            if !strings.has_suffix(&uri,".png") { fallback="image/jpeg" }
            mime := text(&parser.doc,node,"mimeType",fallback+"") or >>
            if parser.doc.has(node,"bufferView") || mime!=fallback { >> errors.new("game GLB: external image MIME/path mismatch or duplicate bufferView") }
            asset.images.push(EmbeddedImage{bytes: []int{},uri: uri,mime: mime})
            ->
        }
        mime := text(&parser.doc,node,"mimeType","") or >>
        if mime!="image/png" && mime!="image/jpeg" { >> errors.new("game GLB: material profile requires image/png or image/jpeg") }
        view_index := integer(&parser.doc, node, "bufferView", -1, 0, parser.views.len - 1) or >>
        if view_index < 0 { >> errors.new("game GLB: image requires bufferView") }
        view := parser.views[view_index]
        if view.stride != 0 || view.target != 0 { >> errors.new("game GLB: image bufferView cannot have stride or GPU target") }
        if view.length > 8388608 - encoded_size { >> errors.new("game GLB: embedded image byte budget exceeded") }
        encoded_size = encoded_size + view.length
        // The same image view may be named by multiple image records.
        parser.views[view_index].usage = 4
        $bytes := []int{}
        for i in view.offset:view.offset + view.length { bytes.push(parser.bytes[i]) }
        asset.images.push(EmbeddedImage{bytes: bytes,uri: "",mime: mime})
    }
    sampler_nodes := optional_array(&parser.doc, root, "samplers", 64) or >>
    for node in sampler_nodes {
        allowed := ["minFilter", "magFilter", "wrapS", "wrapT", "name"]
        fields(&parser.doc, node, &allowed) or >>
        text(&parser.doc, node, "name", "") or >>
        min_filter := integer(&parser.doc, node, "minFilter", 9987, 0, 2147483647) or >>
        mag_filter := integer(&parser.doc, node, "magFilter", 9729, 9728, 9729) or >>
        u := integer(&parser.doc, node, "wrapS", 10497, 0, 2147483647) or >>
        v := integer(&parser.doc, node, "wrapT", 10497, 0, 2147483647) or >>
        if (min_filter != 9728 && min_filter != 9729 && (min_filter < 9984 || min_filter > 9987)) ||
            (u != 10497 && u != 33071) || (v != 10497 && v != 33071) { >> errors.new("game GLB: unsupported sampler filter or wrap") }
        asset.samplers.push(SamplerDescription{min_filter: min_filter, mag_filter: mag_filter, wrap_u: u, wrap_v: v})
    }
    texture_nodes := optional_array(&parser.doc, root, "textures", 64) or >>
    for node in texture_nodes {
        allowed := ["source", "sampler", "name"]
        fields(&parser.doc, node, &allowed) or >>
        text(&parser.doc, node, "name", "") or >>
        source := integer(&parser.doc, node, "source", -1, 0, asset.images.len - 1) or >>
        sampler := integer(&parser.doc, node, "sampler", -1, 0, asset.samplers.len - 1) or >>
        if source < 0 { >> errors.new("game GLB: texture requires an embedded image source") }
        asset.textures.push(TextureDescription{image: source, sampler: sampler})
    }
    material_nodes := optional_array(&parser.doc, root, "materials", 128) or >>
    for node in material_nodes { parser.read_material(node, asset) or >> }
    << 0
}
fn (parser &GlbParser) read_material(node int, asset $&GlbGeometry) int {
    allowed := ["name", "pbrMetallicRoughness", "normalTexture", "occlusionTexture", "emissiveTexture", "emissiveFactor", "alphaMode", "alphaCutoff", "doubleSided"]
    fields(&parser.doc, node, &allowed) or >>
    text(&parser.doc, node, "name", "") or >>
    if (text(&parser.doc, node, "alphaMode", "OPAQUE") or >>) != "OPAQUE" { >> errors.new("game GLB: material profile only supports OPAQUE") }
    cutoff := parser.doc.get(node, "alphaCutoff")
    if cutoff >= 0 {
        if (number(&parser.doc, cutoff) or >>) < 0.0 { >> errors.new("game GLB: alphaCutoff must be nonnegative") }
    }
    $material := default_material()
    material.double_sided = boolean(&parser.doc, node, "doubleSided", false) or >>
    material.emission = property_vec3(&parser.doc, node, "emissiveFactor", fm.vec3(0.0, 0.0, 0.0)) or >>
    if material.emission.x < 0.0 || material.emission.y < 0.0 || material.emission.z < 0.0 ||
        material.emission.x > 1.0 || material.emission.y > 1.0 || material.emission.z > 1.0 { >> errors.new("game GLB: emissiveFactor must be in 0...1") }
    material.emission_texture = texture_info(&parser.doc, node, "emissiveTexture", asset.textures.len, "") or >>
    material.normal_texture = texture_info(&parser.doc, node, "normalTexture", asset.textures.len, "scale") or >>
    normal := parser.doc.get(node, "normalTexture")
    if normal >= 0 { material.normal_scale = bounded_number(&parser.doc, normal, "scale", 1.0, 8.0) or >> }
    material.occlusion_texture = texture_info(&parser.doc, node, "occlusionTexture", asset.textures.len, "strength") or >>
    occlusion := parser.doc.get(node, "occlusionTexture")
    if occlusion >= 0 { material.occlusion_strength = bounded_number(&parser.doc, occlusion, "strength", 1.0, 1.0) or >> }
    pbr := parser.doc.get(node, "pbrMetallicRoughness")
    if pbr >= 0 {
        pbr_fields := ["baseColorFactor", "baseColorTexture", "metallicFactor", "roughnessFactor", "metallicRoughnessTexture"]
        fields(&parser.doc, pbr, &pbr_fields) or >>
        factor := parser.doc.get(pbr, "baseColorFactor")
        if factor >= 0 {
            values := float_vector(&parser.doc, factor, 4) or >>
            for value in values { if value < 0.0 || value > 1.0 { >> errors.new("game GLB: baseColorFactor must be in 0...1") } }
            material.base = fm.vec3(values[0], values[1], values[2])
            material.alpha = values[3]
        }
        material.metallic = bounded_number(&parser.doc, pbr, "metallicFactor", 1.0, 1.0) or >>
        material.roughness = bounded_number(&parser.doc, pbr, "roughnessFactor", 1.0, 1.0) or >>
        material.base_texture = texture_info(&parser.doc, pbr, "baseColorTexture", asset.textures.len, "") or >>
        material.metallic_roughness_texture = texture_info(&parser.doc, pbr, "metallicRoughnessTexture", asset.textures.len, "") or >>
    }
    asset.materials.push(material)
    << 0
}
pub fn (asset &GlbGeometry) material_count() int { << asset.materials.len }
pub fn (asset &GlbGeometry) texture_count() int { << asset.textures.len }
pub fn (asset &GlbGeometry) image_count() int { << asset.images.len }
pub fn (asset &GlbGeometry) material(index int) MaterialDescription {
    if index < 0 || index >= asset.materials.len { >> errors.new("game GLB: material index out of range") }
    << asset.materials[index]
}
pub fn (asset &GlbGeometry) primitive_material(index int) int {
    primitive := asset.primitive(index) or >>
    << primitive.material
}
pub fn (asset &GlbGeometry) texture(index int) TextureDescription {
    if index < 0 || index >= asset.textures.len { >> errors.new("game GLB: texture index out of range") }
    << asset.textures[index]
}
pub fn (asset &GlbGeometry) texture_sampler(index int) SamplerDescription {
    texture := asset.texture(index) or >>
    if texture.sampler < 0 { << default_sampler() }
    << asset.samplers[texture.sampler]
}
pub fn (asset &GlbGeometry) image_bytes(index int) []int {
    if index < 0 || index >= asset.images.len { >> errors.new("game GLB: image index out of range") }
    if asset.images[index].bytes.len==0 { >> errors.new("game GLB: external image is unresolved; use assets/gltf loader") }
    $bytes := []int{}
    for value in asset.images[index].bytes { bytes.push(value) }
    << bytes
}
