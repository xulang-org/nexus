@"github.com/xulang-org/nexus/formats/gltf"

fm #"github.com/xulang-org/nexus/foundation/math"
#encoding/json
#errors

fn object(doc &json.Doc, node int, label string) int {
    if node < 0 || !doc.is_dict(node) { >>> errors.new("nexus GLB: expected object: " + label) }
    << node
}
fn required(doc &json.Doc, node int, key string) int {
    value := doc.get(node, key + "")
    if value < 0 { >>> errors.new("nexus GLB: missing " + key) }
    << value
}
fn integer(doc &json.Doc, node int, key string, fallback int, minimum int, maximum int) int {
    value := doc.get(node, key + "")
    if value < 0 { << fallback }
    number := doc.as_int(value) >>>
    if number < minimum || number > maximum { >>> errors.new("nexus GLB: integer outside limits: " + key) }
    << number
}
fn number(doc &json.Doc, node int) f64 {
    value := doc.as_f64(node) >>>
    if !fm.finite(value) { >>> errors.new("nexus GLB: non-finite JSON number") }
    << value
}
fn boolean(doc &json.Doc, node int, key string, fallback bool) bool {
    value := doc.get(node, key)
    if value < 0 { << fallback }
    << doc.as_bool(value) >>>
}
fn text(doc &json.Doc, node int, key string, fallback string) string {
    value := doc.get(node, key)
    if value < 0 { << fallback }
    << doc.as_string(value) >>>
}
fn list(doc &json.Doc, node int, minimum int, maximum int) []int {
    if node < 0 || !doc.is_list(node) { >>> errors.new("nexus GLB: expected array") }
    count := doc.count(node)
    if count < minimum || count > maximum { >>> errors.new("nexus GLB: array outside profile limits") }
    $items := []int{}
    for i in 0:count { items.push(doc.at(node, i)) }
    << items
}
fn array_property(doc &json.Doc, node int, key string, minimum int, maximum int) []int {
    value := required(doc, node, key) >>>
    << list(doc, value, minimum, maximum) >>>
}
fn fields(doc &json.Doc, node int, allowed &[]string) int {
    empty := []string{}
    << fields_extensions(doc,node,allowed,&empty) >>>
}
fn fields_extensions(doc &json.Doc,node int,allowed &[]string,supported &[]string) int {
    object(doc, node, "schema object") >>>
    extension := doc.get(node, "extensions")
    if extension >= 0 {
        object(doc, extension, "extensions") >>>
        for key in doc.dict_keys(extension) {
            $found := false
            for name in supported { if name==key { found=true } }
            if !found { >>> errors.new("nexus GLB: unsupported object extension "+key) }
        }
    }
    keys := doc.dict_keys(node)
    for key in keys {
        if key == "extras" || key == "extensions" { -> }
        $found := false
        for field in allowed { if key == field { found = true } }
        if !found { >>> errors.new("nexus GLB: unsupported property: " + key) }
    }
    << 0
}
fn float_vector(doc &json.Doc, node int, count int) []f64 {
    items := list(doc, node, count, count) >>>
    $result := []f64{}
    for item in items { result.push(number(doc, item) >>>) }
    << result
}
fn property_vec3(doc &json.Doc, node int, key string, fallback fm.Vec3) fm.Vec3 {
    value := doc.get(node, key)
    if value < 0 { << fallback }
    values := float_vector(doc, value, 3) >>>
    << fm.vec3(values[0], values[1], values[2])
}
