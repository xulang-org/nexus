@"github.com/xulang-org/nexus/gameplay"

#errors
#math
#strconv

const RNG_MODULUS = 2147483647
const RNG_MULT = 48271

// Deterministic Lehmer/Park-Miller 31-bit LCG PRNG for reproducible crits and loot rolls.
pub struct GameplayRng {
    pub state int
}

pub fn new_rng(seed int) GameplayRng {
    $s := seed % RNG_MODULUS
    if s < 0 { s = s + RNG_MODULUS }
    if s == 0 { s = 123456789 }
    << GameplayRng{state: s}
}

pub fn (r $&GameplayRng) next_int() int {
    if r.state <= 0 || r.state >= RNG_MODULUS {
        r.state = 123456789
    }
    r.state = (r.state * RNG_MULT) % RNG_MODULUS
    if r.state <= 0 {
        r.state = 1
    }
    << r.state
}

pub fn (r $&GameplayRng) next_f64() f64 {
    v := r.next_int()
    << f64(v - 1) / f64(RNG_MODULUS - 1)
}

pub fn (r $&GameplayRng) range_int(lo int, hi int) int {
    if hi < lo {
        >> errors.new("nexus gameplay: rng range_int requires hi >= lo")
    }
    if hi <= lo { << lo }
    span := hi - lo + 1
    if span <= 0 { << lo }
    v := r.next_int()
    << lo + (v % span)
}

fn gp_clamp(v f64, lo f64, hi f64) f64 {
    if v < lo { << lo }
    if v > hi { << hi }
    << v
}

fn gp_min_int(a int, b int) int {
    if a < b { << a }
    << b
}

fn gp_max_int(a int, b int) int {
    if a > b { << a }
    << b
}

fn gp_bool_str(v bool) string {
    if v { << "true" }
    << "false"
}

fn gp_f64_str(v f64) string {
    << strconv.format_float(v, 103, -1) or (err) {
        _ := err.msg()
        << "0"
    }
}
