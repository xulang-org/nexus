@"github.com/xulang-org/nexus/script/compiler"

bc #"github.com/xulang-org/nexus/script/bytecode"
#encoding/json
#errors

fn handler_schema(doc &json.Doc, root int) []Handler {
    $handlers := []Handler{}
    if !doc.has(root, "handlers") { << handlers }
    list := doc.get(root, "handlers")
    if !doc.is_list(list) || doc.count(list) > bc.MAX_HANDLERS { >> errors.new("XuScript: invalid handler schema") }
    keys := ["id", "name"]
    for i in 0:doc.count(list) {
        node := doc.at(list, i)
        schema_shape(doc, node, &keys) or >>
        id := doc.as_int(doc.get(node, "id")) or >>
        name := doc.as_string(doc.get(node, "name")) or >>
        if id < 1 || id > 2147483647 || !bc.identifier(&name) || name == "physics_process" || name == "emit_signal" {
            >> errors.new("XuScript: invalid handler ID/name")
        }
        for handler in handlers {
            if handler.id == id || handler.name == name { >> errors.new("XuScript: duplicate handler schema") }
        }
        handlers.push(Handler{id: id, name: name})
    }
    << handlers
}

fn coroutine_schema(doc &json.Doc, root int) []Handler {
    $coros := []Handler{}
    if !doc.has(root, "coroutines") { << coros }
    list := doc.get(root, "coroutines")
    if !doc.is_list(list) || doc.count(list) > bc.MAX_COROUTINES { >> errors.new("XuScript: invalid coroutine schema") }
    keys := ["id", "name"]
    for i in 0:doc.count(list) {
        node := doc.at(list, i)
        schema_shape(doc, node, &keys) or >>
        id := doc.as_int(doc.get(node, "id")) or >>
        name := doc.as_string(doc.get(node, "name")) or >>
        if id < 1 || id > 2147483647 || !bc.identifier(&name) || name == "physics_process" ||
            name == "emit_signal" || name == "host_call" || name == "yield_frame" ||
            name == "yield_seconds" || name == "yield_signal" {
            >> errors.new("XuScript: invalid coroutine ID/name")
        }
        for c in coros {
            if c.id == id || c.name == name { >> errors.new("XuScript: duplicate coroutine schema") }
        }
        coros.push(Handler{id: id, name: name})
    }
    << coros
}
