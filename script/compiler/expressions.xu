@"github.com/xulang-org/game/script/compiler"

bc #"github.com/xulang-org/game/script/bytecode"
#math
#xu/ast
#errors

fn (compiler &Compiler) require_kind(register int, kind int, node int) int {
    if compiler.registers[register] != kind { >> errors.new(compiler.error(node, "expression type mismatch")) }
    << 0
}
fn (compiler $&Compiler) expr(node int) int {
    if compiler.depth >= 64 || node < 0 { >> errors.new(compiler.error(node, "missing expression or nesting limit")) }
    compiler.depth = compiler.depth + 1
    value := compiler.expression(node) or >>
    compiler.depth = compiler.depth - 1
    << value
}
fn (compiler $&Compiler) expression(node int) int {
    expression := compiler.syntax(node)
    kind := expression.kind
    if kind == ast.NK_FLOAT {
        value := math.float64_from_bits(expression.ival)
        if !bc.valid_scalar(value) || compiler.constants.len >= bc.MAX_REGISTERS { >> errors.new(compiler.error(node, "constant outside scalar profile limits")) }
        constant := compiler.constants.len
        compiler.constants.push(value)
        register := compiler.allocate(bc.F64, node) or >>
        compiler.emit(bc.CONSTANT, register, constant, 0, node) or >>
        << register
    }
    if kind == ast.NK_BOOL {
        register := compiler.allocate(bc.BOOL, node) or >>
        compiler.emit(bc.BOOLEAN, register, expression.ival, 0, node) or >>
        << register
    }
    if kind == ast.NK_IDENT {
        index := compiler.local_index(&expression.sval)
        if index < 0 { >> errors.new(compiler.error(node, "unknown/out-of-scope local variable")) }
        << compiler.locals[index].register
    }
    if kind == ast.NK_FIELD {
        index := compiler.field_index(node) or >>
        register := compiler.allocate(bc.F64, node) or >>
        compiler.emit(bc.LOAD_FIELD, register, index, 0, node) or >>
        << register
    }
    if kind == ast.NK_UN_OP {
        operand := compiler.expr(expression.a) or >>
        $type := bc.F64
        $op := bc.NEGATE
        if expression.ival == ast.UN_NOT { type = bc.BOOL
            op = bc.NOT
        } else if expression.ival != ast.UN_NEG { >> errors.new(compiler.error(node, "unsupported unary expression")) }
        compiler.require_kind(operand, type, node) or >>
        register := compiler.allocate(type, node) or >>
        compiler.emit(op, register, operand, 0, node) or >>
        << register
    }
    if kind == ast.NK_BIN_OP {
        if expression.ival == ast.OP_AND || expression.ival == ast.OP_OR { << compiler.logical(node) or >> }
        left := compiler.expr(expression.a) or >>
        right := compiler.expr(expression.b) or >>
        compiler.require_kind(left, bc.F64, node) or >>
        compiler.require_kind(right, bc.F64, node) or >>
        $op := 0
        $type := bc.F64
        operator := expression.ival
        if operator == ast.OP_ADD { op = bc.ADD
        } else if operator == ast.OP_SUB { op = bc.SUBTRACT
        } else if operator == ast.OP_MUL { op = bc.MULTIPLY
        } else if operator == ast.OP_DIV { op = bc.DIVIDE
        } else if operator == ast.OP_EQ { op = bc.EQUAL
        } else if operator == ast.OP_NE { op = bc.NOT_EQUAL
        } else if operator == ast.OP_LT { op = bc.LESS
        } else if operator == ast.OP_LE { op = bc.LESS_EQUAL
        } else if operator == ast.OP_GT { op = bc.GREATER
        } else if operator == ast.OP_GE { op = bc.GREATER_EQUAL
        } else { >> errors.new(compiler.error(node, "unsupported binary operator")) }
        if op >= bc.EQUAL && op <= bc.GREATER_EQUAL { type = bc.BOOL }
        register := compiler.allocate(type, node) or >>
        compiler.emit(op, register, left, right, node) or >>
        << register
    }
    >> errors.new(compiler.error(node, "syntax is outside the scalar script profile"))
}
fn (compiler $&Compiler) logical(node int) int {
    expression := compiler.syntax(node)
    left := compiler.expr(expression.a) or >>
    compiler.require_kind(left, bc.BOOL, node) or >>
    register := compiler.allocate(bc.BOOL, node) or >>
    compiler.emit(bc.MOVE, register, left, 0, node) or >>
    branch := compiler.emit(bc.BRANCH_FALSE, 0, left, 0, node) or >>
    $skip := -1
    if expression.ival == ast.OP_OR {
        skip = compiler.emit(bc.JUMP, 0, 0, 0, node) or >>
        compiler.code[branch].dst = compiler.code.len
    }
    right := compiler.expr(expression.b) or >>
    compiler.require_kind(right, bc.BOOL, node) or >>
    compiler.emit(bc.MOVE, register, right, 0, node) or >>
    if skip >= 0 { compiler.code[skip].dst = compiler.code.len
    } else { compiler.code[branch].dst = compiler.code.len }
    << register
}
