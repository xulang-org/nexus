@"github.com/xulang-org/nexus/script/bytecode"

#errors
#math
#strings
#strconv
#crypto/sha256
#encoding/json

pub const PROFILE = "xu-scalar-v1"
pub const FORMAT = 1
pub const API = 1
pub const MAX_BYTES = 131072
pub const MAX_FIELDS = 32
pub const MAX_SIGNALS = 32
pub const MAX_HANDLERS = 16
pub const MAX_COROUTINES = 16
pub const MAX_FUNCTIONS = 17
pub const PHYSICS_FUNCTION = 1
pub const SIGNAL_FUNCTION = 2
pub const COROUTINE_FUNCTION = 3
pub const MAX_REGISTERS = 256
pub const MAX_CODE = 2048
pub const MAX_SCALAR = 1000000000
pub const F64 = 1
pub const BOOL = 2
pub const CONSTANT = 1
pub const BOOLEAN = 2
pub const MOVE = 3
pub const LOAD_FIELD = 4
pub const STORE_FIELD = 5
pub const ADD = 6
pub const SUBTRACT = 7
pub const MULTIPLY = 8
pub const DIVIDE = 9
pub const NEGATE = 10
pub const EQUAL = 11
pub const NOT_EQUAL = 12
pub const LESS = 13
pub const LESS_EQUAL = 14
pub const GREATER = 15
pub const GREATER_EQUAL = 16
pub const NOT = 17
pub const JUMP = 18
pub const BRANCH_FALSE = 19
pub const RETURN = 20
pub const EMIT_SIGNAL = 21
pub const MATH_UNARY = 22
pub const MIN = 23
pub const MAX = 24
pub const HOST_ARG = 25
pub const CALL_HOST = 26
pub const YIELD_FRAME = 27
pub const YIELD_SECONDS = 28
pub const YIELD_SIGNAL = 29
const MAGIC = "XUNEXUS-SCRIPT-1\n"

pub struct Field { pub id int
    pub name string
    pub initial f64 }
pub struct Signal { pub id int
    pub name string }
// Code ranges partition the module. Calls and jumps cannot cross a range.
pub struct Function {
    pub id int
    pub name string
    pub kind int
    pub entry int
    pub end int
}
pub struct Instruction { pub op int
    pub dst int
    pub a int
    pub b int
    pub line int
    pub col int }
// Construction and loading both verify the same immutable private storage.
pub struct Module {
    name string
    class_name string
    source_hash string
    fields []Field
    signals []Signal
    functions []Function
    registers []int
    constants []f64
    code []Instruction
    fingerprint string
}
pub fn valid_scalar(value f64) bool { << !math.is_nan(value) && !math.is_inf(value) && math.abs(value) <= f64(MAX_SCALAR) }
pub fn identifier(value &string) bool {
    if value.len < 1 || value.len > 64 { << false }
    for i in 0:value.len {
        c := value[i]
        if c == 95 || (c >= 65 && c <= 90) || (c >= 97 && c <= 122) { -> }
        if i > 0 && c >= 48 && c <= 57 { -> }
        << false
    }
    << true
}
fn valid_hash(value &string) bool {
    if value.len != 64 { << false }
    for i in 0:value.len { c := value[i]
        if (c < 48 || c > 57) && (c < 97 || c > 102) { << false } }
    << true
}
pub fn make_module(name string, class_name string, source_hash string, fields []Field,
    registers []int, constants []f64, code []Instruction) Module {
    << make_module_with_signals(name, class_name, source_hash, fields, []Signal{}, registers, constants, code) >>>
}
pub fn make_module_with_signals(name string, class_name string, source_hash string, fields []Field,
    signals []Signal, registers []int, constants []f64, code []Instruction) Module {
    functions := [Function{id: 0, name: "physics_process", kind: PHYSICS_FUNCTION, entry: 0, end: code.len}]
    << make_module_with_functions(name, class_name, source_hash, fields, signals, functions, registers, constants, code) >>>
}
pub fn make_module_with_functions(name string, class_name string, source_hash string, fields []Field,
    signals []Signal, functions []Function, registers []int, constants []f64, code []Instruction) Module {
    $program := Module{name: name, class_name: class_name, source_hash: source_hash, fields: fields,
        signals: signals, functions: functions, registers: registers, constants: constants, code: code, fingerprint: ""}
    program.verify() >>>
    payload := program.payload() >>>
    if payload.len + MAGIC.len > MAX_BYTES { >> errors.new("XuScript: encoded module exceeds byte limit") }
    program.fingerprint = sha256.sum256(payload)
    << program
}
pub fn (program &Module) name() string { << program.name + "" }
pub fn (program &Module) class_name() string { << program.class_name + "" }
pub fn (program &Module) fingerprint() string { << program.fingerprint + "" }
pub fn (program &Module) check() int { << program.verify() >>> }
pub fn (program &Module) field_count() int { << program.fields.len }
pub fn (program &Module) signal_count() int { << program.signals.len }
pub fn (program &Module) function_count() int { << program.functions.len }
pub fn (program &Module) function(index int) Function {
    if index < 0 || index >= program.functions.len { >> errors.new("XuScript: function index outside module") }
    f := &program.functions[index]
    << Function{id: f.id, name: f.name + "", kind: f.kind, entry: f.entry, end: f.end}
}
pub fn (program &Module) physics_index() int {
    for i in 0:program.functions.len { if program.functions[i].kind == PHYSICS_FUNCTION { << i } }
    << -1
}
pub fn (program &Module) handler_index(id int) int {
    for i in 0:program.functions.len {
        if program.functions[i].kind == SIGNAL_FUNCTION && program.functions[i].id == id { << i }
    }
    << -1
}
pub fn (program &Module) handler_id(name string) int {
    for f in program.functions { if f.kind == SIGNAL_FUNCTION && f.name == name { << f.id } }
    >> errors.new("XuScript: unknown signal handler")
}
pub fn (program &Module) coroutine_index(id int) int {
    for i in 0:program.functions.len {
        if program.functions[i].kind == COROUTINE_FUNCTION && program.functions[i].id == id { << i }
    }
    << -1
}
pub fn (program &Module) coroutine_id(name string) int {
    for f in program.functions { if f.kind == COROUTINE_FUNCTION && f.name == name { << f.id } }
    >> errors.new("XuScript: unknown coroutine callback")
}
pub fn (program &Module) signal(index int) Signal {
    if index < 0 || index >= program.signals.len { >> errors.new("XuScript: signal index outside module") }
    << Signal{id: program.signals[index].id, name: program.signals[index].name + ""}
}
pub fn (program &Module) signal_index(id int) int {
    for i in 0:program.signals.len { if program.signals[i].id == id { << i } }
    << -1
}
pub fn (program &Module) signal_id(name string) int {
    for signal in program.signals { if signal.name == name { << signal.id } }
    >> errors.new("XuScript: unknown signal name")
}
pub fn (program &Module) register_count() int { << program.registers.len }
pub fn (program &Module) register_kind(index int) int {
    if index < 0 || index >= program.registers.len { >> errors.new("XuScript: register index outside module") }
    << program.registers[index]
}
pub fn (program &Module) code_count() int { << program.code.len }
pub fn (program &Module) constant_count() int { << program.constants.len }
pub fn (program &Module) field(index int) Field {
    if index < 0 || index >= program.fields.len { >> errors.new("XuScript: field index outside module") }
    << Field{id: program.fields[index].id, name: program.fields[index].name + "", initial: program.fields[index].initial}
}
pub fn (program &Module) instruction(index int) Instruction {
    if index < 0 || index >= program.code.len { >> errors.new("XuScript: instruction index outside module") }
    << program.code[index]
}
pub fn (program &Module) constant(index int) f64 {
    if index < 0 || index >= program.constants.len { >> errors.new("XuScript: constant index outside module") }
    << program.constants[index]
}
pub fn (program &Module) field_index(id int) int {
    for i in 0:program.fields.len { if program.fields[i].id == id { << i } }
    << -1
}
fn (program &Module) register(index int, kind int, writable bool, arguments int) int {
    if index < 0 || index >= program.registers.len || (writable && index < 2) ||
        (index < 2 && index >= arguments) ||
        (kind != 0 && program.registers[index] != kind) { >> errors.new("XuScript: invalid register operand/type") }
    << program.registers[index]
}
fn (program &Module) verify() int {
    if program.name.len < 1 || program.name.len > 128 || !identifier(&program.class_name) || !valid_hash(&program.source_hash) ||
        program.fields.len > MAX_FIELDS || program.signals.len > MAX_SIGNALS ||
        program.functions.len < 1 || program.functions.len > MAX_FUNCTIONS ||
        program.registers.len < 2 || program.registers.len > MAX_REGISTERS ||
        program.constants.len > MAX_REGISTERS || program.code.len < 1 || program.code.len > MAX_CODE {
        >> errors.new("XuScript: invalid module identity or resource limits")
    }
    for i in 0:program.name.len { if program.name[i] < 33 || program.name[i] > 126 { >> errors.new("XuScript: invalid module name") } }
    for i in 0:program.fields.len {
        field := &program.fields[i]
        field_name := field.name + ""
        if field.id < 1 || field.id > 2147483647 || !identifier(&field_name) || !valid_scalar(field.initial) {
            >> errors.new("XuScript: invalid state field id=" + str(field.id) + " name=" + field_name)
        }
        for j in 0:i { if program.fields[j].id == field.id || program.fields[j].name == field.name { >> errors.new("XuScript: duplicate field ID/name") } }
    }
    for i in 0:program.signals.len {
        signal := &program.signals[i]
        signal_name := signal.name + ""
        if signal.id < 1 || signal.id > 2147483647 || !identifier(&signal_name) {
            >> errors.new("XuScript: invalid signal ID/name")
        }
        for j in 0:i {
            if program.signals[j].id == signal.id || program.signals[j].name == signal.name {
                >> errors.new("XuScript: duplicate signal ID/name")
            }
        }
    }
    if program.registers[0] != F64 || program.registers[1] != F64 { >> errors.new("XuScript: callback requires two f64 arguments") }
    for kind in program.registers { if kind != F64 && kind != BOOL { >> errors.new("XuScript: unknown register type") } }
    for value in program.constants { if !valid_scalar(value) { >> errors.new("XuScript: non-finite/out-of-range constant") } }
    program.verify_functions() >>>
    << 0
}
fn (program &Module) verify_instruction(i Instruction, entry int, end int, arguments int, fn_kind int) int {
    if i.op < CONSTANT || i.op > YIELD_SIGNAL || i.line < 1 || i.line > 1000000 || i.col < 1 || i.col > 65536 {
        >> errors.new("XuScript: unknown opcode or invalid source location")
    }
    if i.op == JUMP || i.op == BRANCH_FALSE {
        if i.dst < entry || i.dst >= end || i.b != 0 { >> errors.new("XuScript: invalid jump target outside function") }
        if i.op == JUMP { if i.a != 0 { >> errors.new("XuScript: invalid jump encoding") }
        } else { program.register(i.a, BOOL, false, arguments) >>> }
        << 0
    }
    if i.op == RETURN {
        if i.dst != 0 || i.b != 0 { >> errors.new("XuScript: invalid return encoding") }
        program.register(i.a, F64, false, arguments) >>>
        << 0
    }
    if i.op == STORE_FIELD {
        if i.dst < 0 || i.dst >= program.fields.len || i.b != 0 { >> errors.new("XuScript: invalid state store") }
        program.register(i.a, F64, false, arguments) >>>
        << 0
    }
    if i.op == EMIT_SIGNAL {
        if i.dst < 0 || i.dst >= program.signals.len || i.b != 0 { >> errors.new("XuScript: invalid signal operand") }
        program.register(i.a, F64, false, arguments) >>>
        << 0
    }
    if i.op == MATH_UNARY {
        program.register(i.dst, F64, true, arguments) >>>
        if i.a < MATH_ABS || i.a > MATH_CEIL { >> errors.new("XuScript: unknown math unary intrinsic") }
        program.register(i.b, F64, false, arguments) >>>
        << 0
    }
    if i.op == MIN || i.op == MAX {
        program.register(i.dst, F64, true, arguments) >>>
        program.register(i.a, F64, false, arguments) >>>
        program.register(i.b, F64, false, arguments) >>>
        << 0
    }
    if i.op == HOST_ARG {
        if i.dst < 0 || i.dst >= MAX_HOST_ARGS || i.b != 0 { >> errors.new("XuScript: invalid host argument slot") }
        program.register(i.a, F64, false, arguments) >>>
        << 0
    }
    if i.op == CALL_HOST {
        program.register(i.dst, F64, true, arguments) >>>
        if i.a < 1 || i.a > MAX_HOST_FN_ID || i.b < 0 || i.b > MAX_HOST_ARGS {
            >> errors.new("XuScript: invalid host function ID or argument count")
        }
        << 0
    }
    if i.op == YIELD_FRAME {
        if fn_kind != COROUTINE_FUNCTION { >> errors.new("XuScript: yield is only valid inside coroutine callbacks") }
        if i.dst != 0 || i.a != 0 || i.b != 0 { >> errors.new("XuScript: invalid yield_frame encoding") }
        << 0
    }
    if i.op == YIELD_SECONDS {
        if fn_kind != COROUTINE_FUNCTION { >> errors.new("XuScript: yield is only valid inside coroutine callbacks") }
        if i.dst != 0 || i.b != 0 { >> errors.new("XuScript: invalid yield_seconds encoding") }
        program.register(i.a, F64, false, arguments) >>>
        << 0
    }
    if i.op == YIELD_SIGNAL {
        if fn_kind != COROUTINE_FUNCTION { >> errors.new("XuScript: yield is only valid inside coroutine callbacks") }
        if i.b != 0 { >> errors.new("XuScript: invalid yield_signal encoding") }
        program.register(i.dst, F64, true, arguments) >>>
        program.register(i.a, F64, false, arguments) >>>
        << 0
    }
    if i.op >= ADD && i.op <= DIVIDE {
        program.register(i.dst, F64, true, arguments) >>>
        program.register(i.a, F64, false, arguments) >>>
        program.register(i.b, F64, false, arguments) >>>
        << 0
    }
    if i.op >= EQUAL && i.op <= GREATER_EQUAL {
        program.register(i.dst, BOOL, true, arguments) >>>
        program.register(i.a, F64, false, arguments) >>>
        program.register(i.b, F64, false, arguments) >>>
        << 0
    }
    if i.b != 0 { >> errors.new("XuScript: nonzero reserved instruction operand") }
    if i.op == MOVE {
        kind := program.register(i.a, 0, false, arguments) >>>
        program.register(i.dst, kind, true, arguments) >>>
    } else if i.op == CONSTANT {
        program.register(i.dst, F64, true, arguments) >>>
        if i.a < 0 || i.a >= program.constants.len { >> errors.new("XuScript: invalid constant operand") }
    } else if i.op == BOOLEAN {
        program.register(i.dst, BOOL, true, arguments) >>>
        if i.a != 0 && i.a != 1 { >> errors.new("XuScript: invalid boolean literal") }
    } else if i.op == LOAD_FIELD {
        program.register(i.dst, F64, true, arguments) >>>
        if i.a < 0 || i.a >= program.fields.len { >> errors.new("XuScript: invalid state load") }
    } else if i.op == NEGATE {
        program.register(i.dst, F64, true, arguments) >>>
        program.register(i.a, F64, false, arguments) >>>
    } else if i.op == NOT {
        program.register(i.dst, BOOL, true, arguments) >>>
        program.register(i.a, BOOL, false, arguments) >>>
    } else { >> errors.new("XuScript: unsupported instruction") }
    << 0
}
fn (program &Module) payload() string {
    if program.code.len < 1 || program.code.len > MAX_CODE { >> errors.new("XuScript: cannot encode an empty/oversized program") }
    $out := strings.new_byte_builder(1024)
    out.write_str("{\"format\":" + str(FORMAT) + ",\"api\":" + str(API) + ",\"profile\":\"" + PROFILE + "\",\"module\":" + json.quote(&program.name) +
        ",\"class\":" + json.quote(&program.class_name) + ",\"source_hash\":" + json.quote(&program.source_hash) + ",\"fields\":[")
    for i in 0:program.fields.len {
        if i > 0 { out.write_str(",") }
        field := &program.fields[i]
        field_name := field.name + ""
        out.write_str("{\"id\":" + str(field.id) + ",\"name\":" + json.quote(&field_name) +
            ",\"default\":" + (strconv.format_float(field.initial, 103, -1) >>>) + "}")
    }
    out.write_str("],\"signals\":[")
    for i in 0:program.signals.len {
        if i > 0 { out.write_str(",") }
        signal := &program.signals[i]
        signal_name := signal.name + ""
        out.write_str("{\"id\":" + str(signal.id) + ",\"name\":" + json.quote(&signal_name) + "}")
    }
    out.write_str("],\"functions\":[")
    for i in 0:program.functions.len {
        if i > 0 { out.write_str(",") }
        f := &program.functions[i]
        function_name := f.name + ""
        out.write_str("{\"id\":" + str(f.id) + ",\"name\":" + json.quote(&function_name) +
            ",\"kind\":" + str(f.kind) + ",\"entry\":" + str(f.entry) + ",\"end\":" + str(f.end) + "}")
    }
    out.write_str("],\"registers\":[")
    for i in 0:program.registers.len { if i > 0 { out.write_str(",") }
        out.write_str(str(program.registers[i])) }
    out.write_str("],\"constants\":[")
    for i in 0:program.constants.len { if i > 0 { out.write_str(",") }
        out.write_str(strconv.format_float(program.constants[i], 103, -1) >>>) }
    out.write_str("],\"code\":[")
    for n in 0:program.code.len {
        if n > 0 { out.write_str(",") }
        i := program.code[n]
        out.write_str("[" + str(i.op) + "," + str(i.dst) + "," + str(i.a) + "," + str(i.b) + "," + str(i.line) + "," + str(i.col) + "]")
    }
    out.write_str("]}")
    << out.to_string()
}
pub fn (program &Module) encode() string { payload := program.payload() >>>
    << MAGIC + payload }
