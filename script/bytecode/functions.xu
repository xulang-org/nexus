@"github.com/xulang-org/game/script/bytecode"

#errors

fn (program &Module) verify_functions() int {
    $cursor := 0
    $handlers := 0
    $physics := false
    for i in 0:program.functions.len {
        f := &program.functions[i]
        name := f.name + ""
        if !identifier(&name) || name == "emit_signal" || f.entry != cursor || f.end <= f.entry || f.end > program.code.len {
            >> errors.new("XuScript: invalid function name/code range")
        }
        $arguments := 1
        if f.kind == PHYSICS_FUNCTION {
            if physics || f.id != 0 || name != "physics_process" { >> errors.new("XuScript: invalid physics function identity") }
            physics = true
            arguments = 2
        } else if f.kind == SIGNAL_FUNCTION {
            if f.id < 1 || f.id > 2147483647 || name == "physics_process" { >> errors.new("XuScript: invalid handler identity") }
            handlers = handlers + 1
        } else { >> errors.new("XuScript: unknown function kind") }
        for j in 0:i {
            if program.functions[j].name == name || (f.kind == SIGNAL_FUNCTION &&
                program.functions[j].kind == SIGNAL_FUNCTION && program.functions[j].id == f.id) {
                >> errors.new("XuScript: duplicate function ID/name")
            }
        }
        if program.code[f.end - 1].op != RETURN { >> errors.new("XuScript: callback must end with return") }
        for pc in f.entry:f.end { program.verify_instruction(program.code[pc], f.entry, f.end, arguments) or >> }
        cursor = f.end
    }
    if cursor != program.code.len || handlers > MAX_HANDLERS { >> errors.new("XuScript: invalid function partition/handler limit") }
    << 0
}
