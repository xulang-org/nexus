@"github.com/xulang-org/nexus/script/bytecode"

#encoding/json
#errors
#strings

fn expect_fields(doc &json.Doc, node int, names &[]string) int {
    if node < 0 || !doc.is_dict(node) || doc.count(node) != names.len { >> errors.new("XuScript: invalid object shape") }
    for name in names { if !doc.has(node, name + "") { >> errors.new("XuScript: missing property: " + name) } }
    << 0
}
fn items(doc &json.Doc, node int, limit int) []int {
    if node < 0 || !doc.is_list(node) { >> errors.new("XuScript: expected array") }
    count := doc.count(node)
    if count > limit { >> errors.new("XuScript: array limit exceeded") }
    $out := []int{}
    for i in 0:count { out.push(doc.at(node, i)) }
    << out
}
pub fn decode(raw &string) Module {
    if raw.len > MAX_BYTES || !strings.has_prefix(raw, MAGIC) { >> errors.new("XuScript: invalid bytecode magic/size") }
    json_text := raw[MAGIC.len:raw.len] + ""
    doc := json.parse_max(&json_text, MAX_BYTES)
    if !doc.ok() { >> errors.new("XuScript bytecode JSON: " + doc.error()) }
    root := doc.root()
    names := ["format", "api", "profile", "module", "class", "source_hash", "fields", "signals", "functions", "registers", "constants", "code"]
    expect_fields(&doc, root, &names) >>>
    format := doc.as_int(doc.get(root, "format")) >>>
    api := doc.as_int(doc.get(root, "api")) >>>
    profile := doc.as_string(doc.get(root, "profile")) >>>
    if format != FORMAT || api != API || profile != PROFILE { >> errors.new("XuScript: incompatible format/profile/API") }
    name := doc.as_string(doc.get(root, "module")) >>>
    class_name := doc.as_string(doc.get(root, "class")) >>>
    source_hash := doc.as_string(doc.get(root, "source_hash")) >>>
    field_nodes := items(&doc, doc.get(root, "fields"), MAX_FIELDS) >>>
    field_names := ["id", "name", "default"]
    $fields := []Field{}
    for field in field_nodes {
        expect_fields(&doc, field, &field_names) >>>
        id := doc.as_int(doc.get(field, "id")) >>>
        field_name := doc.as_string(doc.get(field, "name")) >>>
        value := doc.as_f64(doc.get(field, "default")) >>>
        fields.push(Field{id: id, name: field_name, initial: value})
    }
    signal_nodes := items(&doc, doc.get(root, "signals"), MAX_SIGNALS) >>>
    signal_names := ["id", "name"]
    $signals := []Signal{}
    for signal in signal_nodes {
        expect_fields(&doc, signal, &signal_names) >>>
        id := doc.as_int(doc.get(signal, "id")) >>>
        signal_name := doc.as_string(doc.get(signal, "name")) >>>
        signals.push(Signal{id: id, name: signal_name})
    }
    function_nodes := items(&doc, doc.get(root, "functions"), MAX_FUNCTIONS) >>>
    function_names := ["id", "name", "kind", "entry", "end"]
    $functions := []Function{}
    for f in function_nodes {
        expect_fields(&doc, f, &function_names) >>>
        id := doc.as_int(doc.get(f, "id")) >>>
        function_name := doc.as_string(doc.get(f, "name")) >>>
        kind := doc.as_int(doc.get(f, "kind")) >>>
        entry := doc.as_int(doc.get(f, "entry")) >>>
        end := doc.as_int(doc.get(f, "end")) >>>
        functions.push(Function{id: id, name: function_name, kind: kind, entry: entry, end: end})
    }
    register_nodes := items(&doc, doc.get(root, "registers"), MAX_REGISTERS) >>>
    $registers := []int{}
    for node in register_nodes { registers.push(doc.as_int(node) >>>) }
    constant_nodes := items(&doc, doc.get(root, "constants"), MAX_REGISTERS) >>>
    $constants := []f64{}
    for node in constant_nodes { constants.push(doc.as_f64(node) >>>) }
    code_nodes := items(&doc, doc.get(root, "code"), MAX_CODE) >>>
    $code := []Instruction{}
    for node in code_nodes {
        row := items(&doc, node, 6) >>>
        if row.len != 6 { >> errors.new("XuScript: instruction needs six words") }
        op := doc.as_int(row[0]) >>>
        dst := doc.as_int(row[1]) >>>
        a := doc.as_int(row[2]) >>>
        b := doc.as_int(row[3]) >>>
        line := doc.as_int(row[4]) >>>
        col := doc.as_int(row[5]) >>>
        code.push(Instruction{op: op, dst: dst, a: a, b: b, line: line, col: col})
    }
    << make_module_with_functions(name, class_name, source_hash, fields, signals, functions, registers, constants, code) >>>
}
