@"github.com/xulang-org/nexus/script/host"

nexus #"github.com/xulang-org/nexus/scene"
fm #"github.com/xulang-org/nexus/foundation/math"
bc #"github.com/xulang-org/nexus/script/bytecode"
vm #"github.com/xulang-org/nexus/script/vm"
#errors

pub const MAX_ACTIVE_COROUTINES = 256
pub const CORO_READY = 1
pub const CORO_WAIT_FRAME = 2
pub const CORO_WAIT_SECONDS = 3
pub const CORO_WAIT_SIGNAL = 4
pub const CORO_COMPLETED = 5
pub const CORO_CANCELLED = 6
pub const CORO_FAILED = 7

pub fn (script &NodeScript) node_id() int { << script.node }
pub fn (script &NodeScript) coroutine_id(name string) int { << script.machine.coroutine_id(name) or >> }
pub fn (script &NodeScript) has_coroutine(id int) bool { << script.machine.has_coroutine(id) }

pub fn (script $&NodeScript) start_physics_fiber(tree &nexus.SceneTree, delta f64, axis f64) vm.Fiber {
    if !fm.finite(delta) || delta < 0.0 || delta > 0.25 || !fm.finite(axis) || axis < -1.0 || axis > 1.0 {
        >> errors.new("XuScript: invalid fixed-step delta or axis")
    }
    info := tree.node_info(script.node) or >>
    if info.queued_free { >> errors.new("XuScript: cannot run physics fiber on queued node") }
    << script.machine.start_physics_fiber(delta, axis, vm.DEFAULT_BUDGET, 1024.0) or >>
}

pub fn (script $&NodeScript) start_handler_fiber(tree &nexus.SceneTree, handler int, value f64) vm.Fiber {
    info := tree.node_info(script.node) or >>
    if info.queued_free { >> errors.new("XuScript: cannot invoke handler fiber on queued node") }
    << script.machine.start_handler_fiber(handler, value, vm.DEFAULT_BUDGET, f64(bc.MAX_SCALAR)) or >>
}

pub fn (script $&NodeScript) start_coroutine_fiber(tree &nexus.SceneTree, coro_id int, arg f64) vm.Fiber {
    info := tree.node_info(script.node) or >>
    if info.queued_free { >> errors.new("XuScript: cannot start coroutine on queued node") }
    << script.machine.start_coroutine_fiber(coro_id, arg, vm.DEFAULT_BUDGET, f64(bc.MAX_SCALAR)) or >>
}

pub fn (script $&NodeScript) resume_fiber(fiber $&vm.Fiber) vm.StepOutcome {
    machine := $&script.machine
    << machine.resume_fiber(fiber) or >>
}

pub fn (scripts &SceneScripts) node_of(id int) int {
    index := scripts.index(id) or >>
    << scripts.slots[index].node
}

pub fn (scripts &SceneScripts) coroutine_id(id int, name string) int {
    index := scripts.index(id) or >>
    << scripts.slots[index].script.coroutine_id(name) or >>
}

pub fn (scripts &SceneScripts) is_active(id int) bool {
    << scripts.active_id(id)
}

pub fn (scripts $&SceneScripts) start_physics_fiber(tree &nexus.SceneTree, id int, delta f64, axis f64) vm.Fiber {
    scripts.prune(tree)
    index := scripts.index(id) or >>
    behavior := $&scripts.slots[index].script
    << behavior.start_physics_fiber(tree, delta, axis) or >>
}

pub fn (scripts $&SceneScripts) start_handler_fiber(tree &nexus.SceneTree, id int, handler int, value f64) vm.Fiber {
    scripts.prune(tree)
    index := scripts.index(id) or >>
    behavior := $&scripts.slots[index].script
    << behavior.start_handler_fiber(tree, handler, value) or >>
}

pub fn (scripts $&SceneScripts) start_coroutine_fiber(tree &nexus.SceneTree, id int, coro_id int, arg f64) vm.Fiber {
    scripts.prune(tree)
    index := scripts.index(id) or >>
    behavior := $&scripts.slots[index].script
    << behavior.start_coroutine_fiber(tree, coro_id, arg) or >>
}

pub fn (scripts $&SceneScripts) resume_fiber(id int, fiber $&vm.Fiber) vm.StepOutcome {
    index := scripts.index(id) or >>
    behavior := $&scripts.slots[index].script
    << behavior.resume_fiber(fiber) or >>
}

struct CoroutineTask {
    handle int
    script_id int
    epoch int
    status int
    wait_remaining f64
    wait_signal int
    result f64
    error_msg string
    fiber vm.Fiber
}

pub struct CoroutineScheduler {
    tasks []CoroutineTask
    next_handle int
}

pub fn new_coroutine_scheduler() CoroutineScheduler {
    << CoroutineScheduler{tasks: []CoroutineTask{}, next_handle: 1}
}

fn (sched &CoroutineScheduler) task_index(handle int) int {
    for i in 0:sched.tasks.len {
        if sched.tasks[i].handle == handle { << i }
    }
    >> errors.new("XuScript: unknown coroutine handle")
}

pub fn (sched &CoroutineScheduler) active_count() int {
    $count := 0
    for i in 0:sched.tasks.len {
        st := sched.tasks[i].status
        if st >= CORO_READY && st <= CORO_WAIT_SIGNAL { count += 1 }
    }
    << count
}

pub fn (sched &CoroutineScheduler) status(handle int) int {
    idx := sched.task_index(handle) or >>
    << sched.tasks[idx].status
}

pub fn (sched &CoroutineScheduler) result(handle int) f64 {
    idx := sched.task_index(handle) or >>
    << sched.tasks[idx].result
}

pub fn (sched &CoroutineScheduler) error_msg(handle int) string {
    idx := sched.task_index(handle) or >>
    << sched.tasks[idx].error_msg + ""
}

pub fn (sched &CoroutineScheduler) task_script_id(handle int) int {
    idx := sched.task_index(handle) or >>
    << sched.tasks[idx].script_id
}

pub fn (sched $&CoroutineScheduler) spawn(
    scripts $&SceneScripts,
    tree &nexus.SceneTree,
    script_id int,
    coro_name string,
    arg f64
) int {
    coro_id := scripts.coroutine_id(script_id, coro_name) or >>
    << sched.spawn_id(scripts, tree, script_id, coro_id, arg) or >>
}

pub fn (sched $&CoroutineScheduler) spawn_id(
    scripts $&SceneScripts,
    tree &nexus.SceneTree,
    script_id int,
    coro_id int,
    arg f64
) int {
    if sched.active_count() >= MAX_ACTIVE_COROUTINES {
        >> errors.new("XuScript: active coroutine limit exhausted")
    }
    epoch := scripts.epoch(script_id) or >>
    fiber := scripts.start_coroutine_fiber(tree, script_id, coro_id, arg) or >>
    handle := sched.next_handle
    sched.next_handle += 1
    sched.tasks.push(CoroutineTask{
        handle: handle,
        script_id: script_id,
        epoch: epoch,
        status: CORO_READY,
        wait_remaining: 0.0,
        wait_signal: 0,
        result: 0.0,
        error_msg: "",
        fiber: fiber
    })
    << handle
}

pub fn (sched $&CoroutineScheduler) cancel(handle int) int {
    idx := sched.task_index(handle) or >>
    st := sched.tasks[idx].status
    if st >= CORO_READY && st <= CORO_WAIT_SIGNAL {
        sched.tasks[idx].status = CORO_CANCELLED
        << 1
    }
    << 0
}

pub fn (sched $&CoroutineScheduler) cancel_for_script(script_id int) int {
    $cancelled := 0
    for i in 0:sched.tasks.len {
        st := sched.tasks[i].status
        if sched.tasks[i].script_id == script_id && st >= CORO_READY && st <= CORO_WAIT_SIGNAL {
            sched.tasks[i].status = CORO_CANCELLED
            cancelled += 1
        }
    }
    << cancelled
}

pub fn (sched $&CoroutineScheduler) notify_signal(sig_id int, payload f64) int {
    if !fm.finite(payload) || !bc.valid_scalar(payload) {
        >> errors.new("XuScript: non-finite signal payload")
    }
    $woken := 0
    for i in 0:sched.tasks.len {
        if sched.tasks[i].status == CORO_WAIT_SIGNAL && sched.tasks[i].wait_signal == sig_id {
            t := $&sched.tasks[i]
            fb := $&t.fiber
            fb.provide_signal_result(payload) or >>
            t.status = CORO_READY
            t.wait_signal = 0
            woken += 1
        }
    }
    << woken
}

pub fn (sched $&CoroutineScheduler) prepare_tick(
    scripts $&SceneScripts,
    tree &nexus.SceneTree,
    dt f64
) []int {
    if !fm.finite(dt) || dt < 0.0 || dt > 1.0 {
        >> errors.new("XuScript: invalid coroutine tick delta")
    }
    scripts.prune(tree)
    $ready := []int{}
    for i in 0:sched.tasks.len {
        st := sched.tasks[i].status
        if st < CORO_READY || st > CORO_WAIT_SIGNAL { -> }
        sid := sched.tasks[i].script_id
        if !scripts.is_active(sid) {
            sched.tasks[i].status = CORO_CANCELLED
            ->
        }
        ep := scripts.epoch(sid) or >>
        if ep != sched.tasks[i].epoch {
            sched.tasks[i].status = CORO_CANCELLED
            ->
        }
        node := scripts.node_of(sid) or >>
        if !live_node(tree, node) {
            sched.tasks[i].status = CORO_CANCELLED
            ->
        }
        if !(tree.can_process(node) or >>) {
            ->
        }
        t := $&sched.tasks[i]
        if t.status == CORO_WAIT_FRAME {
            t.status = CORO_READY
        } else if t.status == CORO_WAIT_SECONDS {
            t.wait_remaining -= dt
            if t.wait_remaining <= 1e-9 {
                t.wait_remaining = 0.0
                t.status = CORO_READY
            }
        }
        if t.status == CORO_READY {
            fb := $&t.fiber
            fb.reset_budget(vm.DEFAULT_BUDGET) or >>
            ready.push(t.handle)
        }
    }
    << ready
}

pub fn (sched $&CoroutineScheduler) step_task(scripts $&SceneScripts, handle int) vm.StepOutcome {
    idx := sched.task_index(handle) or >>
    t := $&sched.tasks[idx]
    if t.status != CORO_READY {
        >> errors.new("XuScript: coroutine task is not ready")
    }
    sid := t.script_id
    out := scripts.resume_fiber(sid, $&t.fiber) or (err) {
        t.status = CORO_FAILED
        t.error_msg = err.msg()
        >> err
    }
    if out.status == vm.STEP_COMPLETED {
        t.status = CORO_COMPLETED
        t.result = out.value
    } else if out.status == vm.STEP_YIELD_FRAME {
        t.status = CORO_WAIT_FRAME
    } else if out.status == vm.STEP_YIELD_SECONDS {
        t.status = CORO_WAIT_SECONDS
        t.wait_remaining = out.value
    } else if out.status == vm.STEP_YIELD_SIGNAL {
        t.status = CORO_WAIT_SIGNAL
        t.wait_signal = out.wait_signal
    }
    << out
}

pub fn (sched $&CoroutineScheduler) provide_host_result(handle int, value f64) int {
    idx := sched.task_index(handle) or >>
    t := $&sched.tasks[idx]
    fb := $&t.fiber
    << fb.provide_host_result(value) or >>
}

pub fn (sched $&CoroutineScheduler) tick_pure(scripts $&SceneScripts, tree &nexus.SceneTree, dt f64) int {
    handles := sched.prepare_tick(scripts, tree, dt) or >>
    for h in handles {
        out := sched.step_task(scripts, h) or >>
        if out.status == vm.STEP_HOST_CALL {
            >> errors.new("XuScript: pure coroutine tick cannot service host_call; use ScriptHostContext")
        }
    }
    << handles.len
}
