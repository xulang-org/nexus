@"github.com/xulang-org/nexus/script/host"

nexus #"github.com/xulang-org/nexus/scene"
bc #"github.com/xulang-org/nexus/script/bytecode"
#errors

fn duplicate_script(script &NodeScript) NodeScript {
    machine := script.machine.duplicate() >>>
    $connections := []SignalConnection{}
    for connection in script.connections {
        connections.push(SignalConnection{id: connection.id, signal: connection.signal, target: connection.target, handler: connection.handler + ""})
    }
    << NodeScript{node: script.node, machine: machine, connections: connections, next_connection: script.next_connection}
}
// Prepare complete replacement storage before the only publication assignment.
// Routes and queued delivery snapshots retain their IDs and order.
pub fn (scripts $&SceneScripts) reload_many(tree &nexus.SceneTree, ids &[]int, raw &string) int {
    if ids.len < 1 || ids.len > MAX_SCRIPTS { >> errors.new("XuScript: invalid reload batch size") }
    $targets := map[int]bool{}
    for id in ids {
        index := scripts.index(id) >>>
        if targets.has(index) || !live_node(tree, scripts.slots[index].node) { >> errors.new("XuScript: duplicate or retired reload target") }
        targets[index] = true
    }
    $next := []ScriptSlot{}
    $changed := 0
    for i in 0:scripts.slots.len {
        generation := scripts.slots[i].generation
        active := scripts.slots[i].active
        node := scripts.slots[i].node
        $behavior := empty_script()
        if active {
            // Borrow the indexed owning field directly, avoiding nested views.
            behavior = duplicate_script(&scripts.slots[i].script) >>>
            if targets.has(i) {
                candidate := bc.decode(raw) >>>
                changed = changed + (behavior.reload(tree, candidate) >>>)
            }
        }
        next.push(ScriptSlot{generation: generation, active: active, node: node, script: behavior})
    }
    scripts.slots = next
    scripts.prune_routes()
    << changed
}
