@"github.com/xulang-org/nexus/script/host"

fm #"github.com/xulang-org/nexus/foundation/math"
nexus #"github.com/xulang-org/nexus/scene"
bc #"github.com/xulang-org/nexus/script/bytecode"
vm #"github.com/xulang-org/nexus/script/vm"
#errors

// One scalar behavior, scoped to the same SceneTree for its entire lifetime.
// No native handles or mutable engine borrows are visible to the script.
pub struct NodeScript {
    node int
    machine vm.Instance
    connections []SignalConnection
    next_connection int
}
fn empty_script() NodeScript {
    << NodeScript{node: 0, machine: vm.Instance{}, connections: []SignalConnection{}, next_connection: 0}
}
pub fn attach(tree &nexus.SceneTree, node int, program bc.Module) NodeScript {
    info := tree.node_info(node) >>>
    if info.queued_free { >> errors.new("XuScript: cannot attach to a queued node") }
    machine := vm.instantiate(program) >>>
    << NodeScript{node: node, machine: machine, connections: []SignalConnection{}, next_connection: 1}
}
pub fn (script &NodeScript) epoch() int { << script.machine.epoch() }
pub fn (script &NodeScript) calls() int { << script.machine.calls() }
pub fn (script &NodeScript) state(id int) f64 { << script.machine.state(id) >>> }
pub fn (script &NodeScript) handler_id(name string) int { << script.machine.handler_id(name) >>> }
// A committed signal is processed independently of pause/process mode. Host
// dispatch is synchronous and generation/liveness checked before VM entry.
pub fn (script $&NodeScript) receive_signal(tree &nexus.SceneTree, handler int, value f64) f64 {
    info := tree.node_info(script.node) >>>
    if info.queued_free { >> errors.new("XuScript: cannot invoke a queued receiver") }
    machine := $&script.machine
    << machine.invoke_handler(handler, value, vm.DEFAULT_BUDGET, f64(bc.MAX_SCALAR)) >>>
}
pub fn (script $&NodeScript) reload(tree &nexus.SceneTree, candidate bc.Module) int {
    info := tree.node_info(script.node) >>>
    if info.queued_free { >> errors.new("XuScript: cannot reload a queued node") }
    machine := $&script.machine
    changed := machine.reload(candidate) >>>
    script.prune_connections(tree)
    << changed
}
pub fn (script $&NodeScript) physics_process(tree &nexus.SceneTree, delta f64, axis f64) f64 {
    if !fm.finite(delta) || delta < 0.0 || delta > 0.25 || !fm.finite(axis) || axis < -1.0 || axis > 1.0 {
        >> errors.new("XuScript: invalid fixed-step delta or axis")
    }
    if !(tree.can_process(script.node) >>>) { << 0.0 }
    machine := $&script.machine
    << machine.execute(delta, axis, vm.DEFAULT_BUDGET, 1024.0) >>>
}

pub fn (script $&NodeScript) set_state(tree &nexus.SceneTree, field int, value f64) int {
    info := tree.node_info(script.node) >>>
    if info.queued_free { >> errors.new("XuScript: cannot initialize a queued script") }
    machine := $&script.machine
    << machine.set_state(field, value) >>>
}
