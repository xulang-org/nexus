@"github.com/xulang-org/nexus/script/vm"

bc #"github.com/xulang-org/nexus/script/bytecode"
#errors
#math

pub const DEFAULT_BUDGET = 4096
const MAX_BUDGET = 100000
const MAX_RETIRED_IDS = 4096
pub const MAX_SIGNALS_PER_CALL = 32
pub const MAX_PENDING_SIGNALS = 128
// Values are immutable snapshots. No host function runs inside the VM.
pub struct SignalEvent {
    pub id int
    pub value f64
    pub epoch int
    pub call int
}
pub struct Instance {
    program bc.Module
    values []f64
    retired []int
    retired_signals []int
    retired_handlers []int
    signals []SignalEvent
    epoch int
    calls int
}
pub fn instantiate(program bc.Module) Instance {
    program.check() or >>
    $values := []f64{}
    for i in 0:program.field_count() { field := program.field(i) or >>
        values.push(field.initial) }
    << Instance{program: program, values: values, retired: []int{}, retired_signals: []int{}, retired_handlers: []int{},
        signals: []SignalEvent{}, epoch: 1, calls: 0}
}
pub fn (instance &Instance) epoch() int { << instance.epoch }
pub fn (instance &Instance) calls() int { << instance.calls }
pub fn (instance &Instance) fingerprint() string { << instance.program.fingerprint() }
pub fn (instance &Instance) field_count() int { << instance.values.len }
pub fn (instance &Instance) has_signal(id int) bool { << instance.program.signal_index(id) >= 0 }
pub fn (instance &Instance) signal_id(name string) int { << instance.program.signal_id(name) or >> }
pub fn (instance &Instance) has_handler(id int) bool { << instance.program.handler_index(id) >= 0 }
pub fn (instance &Instance) handler_id(name string) int { << instance.program.handler_id(name) or >> }
pub fn (instance &Instance) pending_signals() int { << instance.signals.len }
// Draining transfers committed events exactly once. The caller owns delivery.
pub fn (instance $&Instance) drain_signals() []SignalEvent {
    if instance.epoch < 1 { >> errors.new("XuScript: uninitialized VM instance") }
    $out := []SignalEvent{}
    for event in instance.signals { out.push(event) }
    instance.signals = []SignalEvent{}
    << out
}
pub fn (instance &Instance) state(id int) f64 {
    index := instance.program.field_index(id)
    if index < 0 { >> errors.new("XuScript: unknown state field ID") }
    << instance.values[index]
}
pub fn (instance $&Instance) set_state(id int, value f64) int {
    index := instance.program.field_index(id)
    if index < 0 || !bc.valid_scalar(value) { >> errors.new("XuScript: invalid state write") }
    instance.values[index] = value
    << 0
}
// Synchronous, no callbacks or suspension. Candidate validation has completed
// before this call; prepare all state/history before replacing the live program.
pub fn (instance $&Instance) reload(candidate bc.Module) int {
    if instance.epoch < 1 { >> errors.new("XuScript: uninitialized VM instance") }
    candidate.check() or >>
    if candidate.name() != instance.program.name() || candidate.class_name() != instance.program.class_name() {
        >> errors.new("XuScript: candidate module/class identity differs")
    }
    if candidate.fingerprint() == instance.program.fingerprint() { << 0 }
    if instance.epoch >= 2147483647 { >> errors.new("XuScript: module epoch exhausted") }
    $next := []f64{}
    $retired := []int{}
    $retired_signals := []int{}
    $retired_handlers := []int{}
    for id in instance.retired { retired.push(id) }
    for id in instance.retired_signals { retired_signals.push(id) }
    for id in instance.retired_handlers { retired_handlers.push(id) }
    for i in 0:candidate.function_count() {
        f := candidate.function(i) or >>
        if f.kind != bc.SIGNAL_FUNCTION { -> }
        for id in instance.retired_handlers {
            if id == f.id { >> errors.new("XuScript: retired handler ID cannot be reused") }
        }
    }
    for i in 0:instance.program.function_count() {
        f := instance.program.function(i) or >>
        if f.kind == bc.SIGNAL_FUNCTION && candidate.handler_index(f.id) < 0 { retired_handlers.push(f.id) }
    }
    for i in 0:candidate.signal_count() {
        signal := candidate.signal(i) or >>
        for id in instance.retired_signals {
            if id == signal.id { >> errors.new("XuScript: retired signal ID cannot be reused") }
        }
    }
    for i in 0:instance.program.signal_count() {
        signal := instance.program.signal(i) or >>
        if candidate.signal_index(signal.id) < 0 { retired_signals.push(signal.id) }
    }
    for i in 0:candidate.field_count() {
        field := candidate.field(i) or >>
        for id in instance.retired { if id == field.id { >> errors.new("XuScript: retired field ID cannot be reused") } }
        old := instance.program.field_index(field.id)
        if old >= 0 { next.push(instance.values[old]) } else { next.push(field.initial) }
    }
    for i in 0:instance.program.field_count() {
        field := instance.program.field(i) or >>
        if candidate.field_index(field.id) < 0 { retired.push(field.id) }
    }
    if retired.len > MAX_RETIRED_IDS || retired_signals.len > MAX_RETIRED_IDS || retired_handlers.len > MAX_RETIRED_IDS {
        >> errors.new("XuScript: field/signal/handler retirement history limit exceeded") }
    instance.program = candidate
    instance.values = next
    instance.retired = retired
    instance.retired_signals = retired_signals
    instance.retired_handlers = retired_handlers
    instance.epoch = instance.epoch + 1
    << 1
}
fn failure(program &bc.Module, instruction bc.Instruction, message string) string {
    << "XuScript " + program.name() + ":" + str(instruction.line) + ":" + str(instruction.col) + ": " + message
}
fn read(registers &[]f64, initialized &[]bool, index int, program &bc.Module, instruction bc.Instruction) f64 {
    if !initialized[index] { >> errors.new(failure(program, instruction, "read of uninitialized register")) }
    << registers[index]
}
pub fn (instance $&Instance) execute(delta f64, axis f64, budget int, result_limit f64) f64 {
    if instance.epoch < 1 { >> errors.new("XuScript: uninitialized VM instance") }
    index := instance.program.physics_index()
    if index < 0 { >> errors.new("XuScript: module has no physics_process callback") }
    << instance.execute_entry(index, delta, axis, budget, result_limit) or >>
}
pub fn (instance $&Instance) invoke_handler(id int, value f64, budget int, result_limit f64) f64 {
    if instance.epoch < 1 { >> errors.new("XuScript: uninitialized VM instance") }
    index := instance.program.handler_index(id)
    if index < 0 { >> errors.new("XuScript: unknown signal handler ID") }
    << instance.execute_entry(index, value, 0.0, budget, result_limit) or >>
}
fn (instance $&Instance) execute_entry(index int, argument_a f64, argument_b f64, budget int, result_limit f64) f64 {
    if instance.epoch < 1 { >> errors.new("XuScript: uninitialized VM instance") }
    if !bc.valid_scalar(argument_a) || !bc.valid_scalar(argument_b) || budget < 1 || budget > MAX_BUDGET ||
        !bc.valid_scalar(result_limit) || result_limit <= 0.0 {
        >> errors.new("XuScript: invalid callback arguments/budget/result bound")
    }
    $registers := []f64{}
    $initialized := []bool{}
    for i in 0:instance.program.register_count() { registers.push(0.0)
        initialized.push(false) }
    function := instance.program.function(index) or >>
    registers[0] = argument_a
    initialized[0] = true
    if function.kind == bc.PHYSICS_FUNCTION {
        registers[1] = argument_b
        initialized[1] = true
    }
    $state := []f64{}
    $signals := []SignalEvent{}
    for value in instance.values { state.push(value) }
    $pc := function.entry
    $remaining := budget
    while true {
        if pc < function.entry || pc >= function.end { >> errors.new("XuScript: callback escaped function range") }
        instruction := instance.program.instruction(pc) or >>
        if remaining <= 0 { >> errors.new(failure(&instance.program, instruction, "instruction budget exhausted")) }
        remaining = remaining - 1
        pc = pc + 1
        op := instruction.op
        if op == bc.JUMP { pc = instruction.dst
            -> }
        if op == bc.BRANCH_FALSE {
            condition := read(&registers, &initialized, instruction.a, &instance.program, instruction) or >>
            if condition == 0.0 { pc = instruction.dst }
            ->
        }
        if op == bc.RETURN {
            result := read(&registers, &initialized, instruction.a, &instance.program, instruction) or >>
            if !bc.valid_scalar(result) || math.abs(result) > result_limit {
                >> errors.new(failure(&instance.program, instruction, "callback result outside host bound"))
            }
            if instance.calls >= 9223372036854775806 { >> errors.new("XuScript: callback counter exhausted") }
            instance.values = state
            instance.calls = instance.calls + 1
            for event in signals { instance.signals.push(event) }
            << result
        }
        if op == bc.EMIT_SIGNAL {
            if signals.len >= MAX_SIGNALS_PER_CALL || instance.signals.len + signals.len >= MAX_PENDING_SIGNALS {
                >> errors.new(failure(&instance.program, instruction, "signal outbox limit exceeded"))
            }
            value := read(&registers, &initialized, instruction.a, &instance.program, instruction) or >>
            signal := instance.program.signal(instruction.dst) or >>
            signals.push(SignalEvent{id: signal.id, value: value, epoch: instance.epoch, call: instance.calls + 1})
            ->
        }
        if op == bc.STORE_FIELD {
            value := read(&registers, &initialized, instruction.a, &instance.program, instruction) or >>
            state[instruction.dst] = value
            ->
        }
        $value := 0.0
        if op == bc.CONSTANT { value = instance.program.constant(instruction.a) or >>
        } else if op == bc.BOOLEAN { value = f64(instruction.a)
        } else if op == bc.LOAD_FIELD { value = state[instruction.a]
        } else {
            a := read(&registers, &initialized, instruction.a, &instance.program, instruction) or >>
            if op == bc.MOVE { value = a
            } else if op == bc.NEGATE { value = -a
            } else if op == bc.NOT { if a == 0.0 { value = 1.0 }
            } else {
                b := read(&registers, &initialized, instruction.b, &instance.program, instruction) or >>
                if op == bc.ADD { value = a + b
                } else if op == bc.SUBTRACT { value = a - b
                } else if op == bc.MULTIPLY { value = a * b
                } else if op == bc.DIVIDE {
                    if b == 0.0 { >> errors.new(failure(&instance.program, instruction, "division by zero")) }
                    value = a / b
                } else if op == bc.EQUAL { if a == b { value = 1.0 }
                } else if op == bc.NOT_EQUAL { if a != b { value = 1.0 }
                } else if op == bc.LESS { if a < b { value = 1.0 }
                } else if op == bc.LESS_EQUAL { if a <= b { value = 1.0 }
                } else if op == bc.GREATER { if a > b { value = 1.0 }
                } else if op == bc.GREATER_EQUAL { if a >= b { value = 1.0 } }
            }
        }
        if !bc.valid_scalar(value) { >> errors.new(failure(&instance.program, instruction, "non-finite or out-of-range scalar result")) }
        registers[instruction.dst] = value
        initialized[instruction.dst] = true
    }
    >> errors.new("XuScript: callback did not return")
}
