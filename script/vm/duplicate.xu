@"github.com/xulang-org/nexus/script/vm"

bc #"github.com/xulang-org/nexus/script/bytecode"
#errors

// An independent in-memory candidate, including retirement history and outbox.
// This is not a persistent execution snapshot format.
pub fn (instance &Instance) duplicate() Instance {
    if instance.epoch < 1 { >> errors.new("XuScript: cannot duplicate an uninitialized VM") }
    raw := instance.program.encode() >>>
    program := bc.decode(&raw) >>>
    $values := []f64{}
    $retired := []int{}
    $signals_retired := []int{}
    $handlers_retired := []int{}
    $coros_retired := []int{}
    $signals := []SignalEvent{}
    for value in instance.values { values.push(value) }
    for id in instance.retired { retired.push(id) }
    for id in instance.retired_signals { signals_retired.push(id) }
    for id in instance.retired_handlers { handlers_retired.push(id) }
    for id in instance.retired_coroutines { coros_retired.push(id) }
    for event in instance.signals { signals.push(event) }
    reg_n := program.register_count()
    $s_state := []f64{}
    for v in values { s_state.push(v) }
    << Instance{program: program, values: values, retired: retired, retired_signals: signals_retired,
        retired_handlers: handlers_retired, retired_coroutines: coros_retired,
        signals: signals, epoch: instance.epoch, calls: instance.calls,
        scratch_regs: init_scratch_regs(reg_n), scratch_stamps: init_scratch_stamps(reg_n),
        reg_stamp: 0, scratch_state: s_state}
}
