@"github.com/xulang-org/nexus/rendering/three_d"

#math
#errors

// Renderer policy: finite |value| <= 1e9 and canonical positive zero.
// IEEE conversion belongs to the Xu standard library.
fn scalar_word(value f64) int {
    if math.is_nan(value) || math.is_inf(value) || math.abs(value) > 1000000000.0 {
        >>> errors.new("nexus GPU: scalar must be finite and within +/-1e9")
    }
    bits := math.float32_bits(value)
    if (bits & 2147483647) == 0 { << 0 }
    << bits
}
