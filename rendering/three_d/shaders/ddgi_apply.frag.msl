#include <metal_stdlib>
using namespace metal;

struct ProbeShGpu {
    float4 dc; // xyz=dc, w=validity
    float4 px;
    float4 py;
    float4 pz;
};

struct DdgiApplyUniform {
    float4x4 inv_vp;
    float4 eye_strength; // xyz=eye, w=gi_strength
    float4 origin_nx;    // xyz=origin, w=nx
    float4 spacing_ny;   // xyz=spacing, w=ny
    float4 dims_flags;   // x=nz, y=use_chebyshev, z=normal_bias, w=view_bias
    float4 tint_visres;  // rgb=albedo_tint, w=vis_res(6)
    float4 bias_misc;    // x=min_chebyshev, y=0, z=0, w=0
    float4 pad0;
    float4 pad1;
};

struct FragIn {
    float4 position [[position]];
    float2 uv;
};

static inline float2 sign_not_zero(float2 v) {
    return float2((v.x >= 0.0) ? 1.0 : -1.0, (v.y >= 0.0) ? 1.0 : -1.0);
}

static inline float2 oct_encode(float3 v) {
    float l1 = abs(v.x) + abs(v.y) + abs(v.z);
    float2 p = v.xy / max(l1, 1e-6);
    if (v.z < 0.0) {
        p = (1.0 - abs(p.yx)) * sign_not_zero(p);
    }
    return p * 0.5 + 0.5;
}

static inline float2 sample_oct_vis(
    device const float2* probe_vis,
    uint probe_idx,
    uint vis_res,
    float3 dir
) {
    uint texels = vis_res * vis_res;
    uint base = probe_idx * texels;
    float2 uv = clamp(oct_encode(dir), float2(0.0), float2(1.0));
    float fx = clamp(uv.x * float(vis_res) - 0.5, 0.0, float(vis_res - 1u));
    float fy = clamp(uv.y * float(vis_res) - 0.5, 0.0, float(vis_res - 1u));
    uint x0 = uint(floor(fx));
    uint y0 = uint(floor(fy));
    uint x1 = min(x0 + 1u, vis_res - 1u);
    uint y1 = min(y0 + 1u, vis_res - 1u);
    float tx = fx - float(x0);
    float ty = fy - float(y0);
    float2 m00 = probe_vis[base + y0 * vis_res + x0];
    float2 m10 = probe_vis[base + y0 * vis_res + x1];
    float2 m01 = probe_vis[base + y1 * vis_res + x0];
    float2 m11 = probe_vis[base + y1 * vis_res + x1];
    return mix(mix(m00, m10, tx), mix(m01, m11, tx), ty);
}

fragment float4 main0(
    FragIn in [[stage_in]],
    depth2d<float> scene_depth_tex [[texture(0)]],
    texture2d<float> normal_rough_tex [[texture(1)]],
    sampler depth_samp [[sampler(0)]],
    sampler norm_samp [[sampler(1)]],
    constant DdgiApplyUniform& u [[buffer(0)]],
    device const ProbeShGpu* probes [[buffer(1)]],
    device const float2* probe_vis [[buffer(2)]]
) {
    float d = scene_depth_tex.sample(depth_samp, in.uv);
    float4 nr = normal_rough_tex.sample(norm_samp, in.uv);
    if (d <= 1e-6 || dot(nr.xyz, nr.xyz) < 0.01) {
        return float4(0.0, 0.0, 0.0, 0.0);
    }

    float ndc_x = in.uv.x * 2.0 - 1.0;
    float ndc_y = 1.0 - in.uv.y * 2.0;
    float4 wp4 = u.inv_vp * float4(ndc_x, ndc_y, d, 1.0);
    float3 world_pos = wp4.xyz / max(wp4.w, 1e-6);

    float3 N = normalize(nr.xyz);
    float3 V = normalize(u.eye_strength.xyz - world_pos);
    float3 biased_pos = world_pos + N * u.dims_flags.z + V * u.dims_flags.w;

    int nx = int(u.origin_nx.w);
    int ny = int(u.spacing_ny.w);
    int nz = int(u.dims_flags.x);
    if (nx <= 0 || ny <= 0 || nz <= 0) {
        return float4(0.0, 0.0, 0.0, 0.0);
    }

    float3 rel = (biased_pos - u.origin_nx.xyz) / max(u.spacing_ny.xyz, float3(1e-4));
    float fx = clamp(rel.x, 0.0, float(max(nx - 1, 0)));
    float fy = clamp(rel.y, 0.0, float(max(ny - 1, 0)));
    float fz = clamp(rel.z, 0.0, float(max(nz - 1, 0)));

    int x0 = min(int(floor(fx)), max(nx - 1, 0));
    int y0 = min(int(floor(fy)), max(ny - 1, 0));
    int z0 = min(int(floor(fz)), max(nz - 1, 0));
    int x1 = min(x0 + 1, max(nx - 1, 0));
    int y1 = min(y0 + 1, max(ny - 1, 0));
    int z1 = min(z0 + 1, max(nz - 1, 0));

    float tx = fx - float(x0);
    float ty = fy - float(y0);
    float tz = fz - float(z0);

    bool use_chebyshev = (u.dims_flags.y > 0.5);
    uint vis_res = max(uint(u.tint_visres.w), 1u);
    float min_cheb = clamp(u.bias_misc.x, 0.0, 0.2);

    float3 sum_irr = float3(0.0);
    float sum_w = 0.0;

    for (int dz = 0; dz < 2; ++dz) {
        int iz = (dz == 0) ? z0 : z1;
        float wz = (dz == 0) ? (1.0 - tz) : tz;
        for (int dy = 0; dy < 2; ++dy) {
            int iy = (dy == 0) ? y0 : y1;
            float wy = (dy == 0) ? (1.0 - ty) : ty;
            for (int dx = 0; dx < 2; ++dx) {
                int ix = (dx == 0) ? x0 : x1;
                float wx = (dx == 0) ? (1.0 - tx) : tx;
                uint pid = uint((iz * ny + iy) * nx + ix);
                ProbeShGpu sh = probes[pid];
                float w_tri = wx * wy * wz;
                float w = w_tri;

                if (use_chebyshev) {
                    if (sh.dc.w < 0.5) continue;
                    float3 probe_pos = u.origin_nx.xyz + float3(float(ix), float(iy), float(iz)) * u.spacing_ny.xyz;
                    float3 to_probe = probe_pos - world_pos;
                    float3 dir_to_probe = to_probe / max(length(to_probe), 1e-5);
                    float wrap = clamp((dot(dir_to_probe, N) + 1.0) * 0.5, 0.0, 1.0);
                    float w_bf = wrap * wrap + 0.05;

                    float3 to_bias = biased_pos - probe_pos;
                    float dist = length(to_bias);
                    float3 oct_dir = to_bias / max(dist, 1e-5);
                    float2 moments = sample_oct_vis(probe_vis, pid, vis_res, oct_dir);
                    float cheb = 1.0;
                    if (dist > moments.x) {
                        float var = max(abs(moments.y - moments.x * moments.x), 1e-4);
                        float diff = dist - moments.x;
                        cheb = var / (var + diff * diff);
                        cheb = max(cheb * cheb * cheb, min_cheb);
                    }
                    w = w_tri * w_bf * cheb;
                }

                float3 irr_i = max(sh.dc.xyz + sh.px.xyz * N.x + sh.py.xyz * N.y + sh.pz.xyz * N.z, float3(0.0));
                sum_irr += irr_i * w;
                sum_w += w;
            }
        }
    }

    float3 final_irr = (sum_w > 1e-6) ? (sum_irr / sum_w) : float3(0.0);
    float3 out_rgb = max(final_irr * u.tint_visres.rgb * u.eye_strength.w, float3(0.0));
    return float4(out_rgb, 0.0);
}
