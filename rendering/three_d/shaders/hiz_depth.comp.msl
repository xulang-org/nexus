#include <metal_stdlib>
using namespace metal;

struct HizParams {
    uint sw;
    uint sh;
    uint dw;
    uint dh;
};

kernel void main0(
    depth2d<float> src_depth [[texture(0)]],
    texture2d<float, access::write> dst_hiz [[texture(1)]],
    sampler src_sampler [[sampler(0)]],
    constant HizParams& params [[buffer(0)]],
    uint2 gid [[thread_position_in_grid]]
) {
    if (gid.x >= params.dw || gid.y >= params.dh) return;
    float fdx = float(gid.x);
    float fdy = float(gid.y);
    float fdw = float(params.dw);
    float fdh = float(params.dh);
    float fsw = float(params.sw);
    float fsh = float(params.sh);

    int sx0 = clamp(int(floor((fdx / fdw) * fsw)), 0, int(params.sw) - 1);
    int sx1 = clamp(int(floor(((fdx + 1.0) / fdw) * fsw - 1e-5)), sx0, int(params.sw) - 1);
    int sy0 = clamp(int(floor((fdy / fdh) * fsh)), 0, int(params.sh) - 1);
    int sy1 = clamp(int(floor(((fdy + 1.0) / fdh) * fsh - 1e-5)), sy0, int(params.sh) - 1);

    float min_d = 1.0;
    float2 inv_src = float2(1.0 / fsw, 1.0 / fsh);
    for (int y = sy0; y <= sy1; ++y) {
        for (int x = sx0; x <= sx1; ++x) {
            float2 uv = (float2(float(x), float(y)) + 0.5) * inv_src;
            float d = src_depth.sample(src_sampler, uv);
            min_d = min(min_d, d);
        }
    }
    dst_hiz.write(float4(min_d, 0.0, 0.0, 1.0), gid);
}
