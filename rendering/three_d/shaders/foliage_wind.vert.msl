#include <metal_stdlib>
using namespace metal;

struct FoliageVertUniform {
    float4x4 view_proj;
    float4x4 view;
    float4 wind_dir_strength; // x=dir_x, y=dir_z, z=strength, w=time
    float4 wind_wave;         // x=freq, y=spatial_freq, z=gust_strength, w=gust_freq
    float4 fade_camera;       // xyz=cam_pos, w=fade_start
    float4 fade_extra;        // x=max_draw_dist, y=inv_mesh_height, z=stiffness, w=0
};

struct FoliageInstanceGpu {
    float4 pos_scale; // xyz=world_pos, w=scale
    float4 rot_wind;  // x=cos_y, y=sin_y, z=bend_phase, w=height_scale
    float4 tint_var;  // rgb=tint, w=variation
};

struct VertexIn {
    float3 position [[attribute(0)]];
    float4 color [[attribute(1)]];
    float3 normal [[attribute(2)]];
    float2 uv [[attribute(3)]];
    float4 tangent [[attribute(4)]];
};

struct VertexOut {
    float4 position [[position]];
    float4 vertex_color;
    float3 world;
    float3 world_normal;
    float2 texture_uv;
    float3 instance_tint;
    float height_frac;
    float fade;
    float view_depth;
};

vertex VertexOut main0(
    VertexIn in [[stage_in]],
    constant FoliageVertUniform& u [[buffer(0)]],
    device const FoliageInstanceGpu* instances [[buffer(1)]],
    device const uint* visible_indices [[buffer(2)]],
    uint iid [[instance_id]]
) {
    uint real_idx = visible_indices[iid];
    FoliageInstanceGpu inst = instances[real_idx];

    float dist = length(inst.pos_scale.xyz - u.fade_camera.xyz);
    float fade_start = u.fade_camera.w;
    float max_dist = max(u.fade_extra.x, fade_start + 0.001);
    float fade = 1.0 - smoothstep(fade_start, max_dist, dist);

    float s_xz = inst.pos_scale.w;
    float s_y = s_xz * inst.rot_wind.w * mix(0.35, 1.0, fade);

    float3 lp = float3(in.position.x * s_xz, in.position.y * s_y, in.position.z * s_xz);
    float cy = inst.rot_wind.x;
    float sy = inst.rot_wind.y;
    float3 rot_p = float3(lp.x * cy + lp.z * sy, lp.y, -lp.x * sy + lp.z * cy);
    float3 rot_n = float3(in.normal.x * cy + in.normal.z * sy, in.normal.y, -in.normal.x * sy + in.normal.z * cy);

    float h_frac = clamp(max(in.uv.y, in.position.y * u.fade_extra.y), 0.0, 1.0);
    float bend = (h_frac * h_frac) / max(u.fade_extra.z, 0.25);

    float2 wdir = u.wind_dir_strength.xy;
    float wlen = max(length(wdir), 1e-5);
    wdir /= wlen;
    float2 perp = float2(-wdir.y, wdir.x);

    float time = u.wind_dir_strength.w;
    float phase = dot(inst.pos_scale.xz, wdir) * u.wind_wave.y + inst.rot_wind.z;
    float primary = sin(time * u.wind_wave.x + phase);
    float gust = sin(time * u.wind_wave.w + dot(inst.pos_scale.xz, perp) * (u.wind_wave.y * 0.65) + inst.rot_wind.z * 1.7);
    float disp_main = (u.wind_dir_strength.z * (0.45 + 0.55 * primary) + u.wind_wave.z * gust) * bend;
    float disp_cross = u.wind_wave.z * 0.45 * cos(time * u.wind_wave.x * 1.3 + inst.rot_wind.z) * bend;

    float3 world_pos = inst.pos_scale.xyz + rot_p;
    world_pos.xz += wdir * disp_main + perp * disp_cross;
    world_pos.y -= min(abs(disp_main) * 0.18, s_y * 0.35 * h_frac);

    float3 bent_n = normalize(rot_n + float3(wdir.x * disp_main, 0.35, wdir.y * disp_main));

    VertexOut out;
    out.position = u.view_proj * float4(world_pos, 1.0);
    out.vertex_color = in.color;
    out.world = world_pos;
    out.world_normal = bent_n;
    out.texture_uv = in.uv;
    out.instance_tint = inst.tint_var.rgb;
    out.height_frac = h_frac;
    out.fade = fade;
    out.view_depth = -(u.view * float4(world_pos, 1.0)).z;
    return out;
}
