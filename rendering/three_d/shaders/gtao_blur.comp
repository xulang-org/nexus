#version 450

layout(set = 0, binding = 0) uniform sampler2D src_ao;
layout(set = 0, binding = 1) uniform sampler2D src_depth;
layout(set = 1, binding = 0, r16f) uniform writeonly image2D dst_ao;

layout(set = 2, binding = 0, std140) uniform BlurParams {
    vec4 info;
} params;

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

void main() {
    uvec2 gid = gl_GlobalInvocationID.xy;
    uint w = uint(params.info.x), h = uint(params.info.y);
    if (gid.x >= w || gid.y >= h) return;

    vec2 inv_res = vec2(1.0 / params.info.x, 1.0 / params.info.y);
    vec2 uv = (vec2(gid) + 0.5) * inv_res;
    float center_d = textureLod(src_depth, uv, 0.0).r;
    float center_ao = textureLod(src_ao, uv, 0.0).r;
    if (center_d <= 1e-6) {
        imageStore(dst_ao, ivec2(gid), vec4(1.0, 0.0, 0.0, 1.0));
        return;
    }

    float sum_ao = 0.0, sum_w = 0.0;
    for (int dy = -2; dy <= 2; ++dy) {
        for (int dx = -2; dx <= 2; ++dx) {
            vec2 suv = clamp(uv + vec2(float(dx), float(dy)) * inv_res, vec2(0.0001), vec2(0.9999));
            float sd = textureLod(src_depth, suv, 0.0).r;
            float sao = textureLod(src_ao, suv, 0.0).r;
            float depth_diff = abs(sd - center_d) * 180.0;
            float spatial = exp(-float(dx * dx + dy * dy) * 0.2);
            float weight = spatial * exp(-depth_diff * depth_diff);
            sum_ao += sao * weight;
            sum_w += weight;
        }
    }
    float out_ao = (sum_w > 1e-5) ? (sum_ao / sum_w) : center_ao;
    imageStore(dst_ao, ivec2(gid), vec4(clamp(out_ao, 0.0, 1.0), 0.0, 0.0, 1.0));
}
