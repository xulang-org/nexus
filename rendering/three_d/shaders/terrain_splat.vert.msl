#include <metal_stdlib>
using namespace metal;

struct TerrainVertUniform {
    float4x4 view_proj;
    float4x4 model;
    float4x4 view;
};

struct VertexIn {
    float3 position [[attribute(0)]];
    float4 color [[attribute(1)]];
    float3 normal [[attribute(2)]];
    float2 uv [[attribute(3)]];
    float4 tangent [[attribute(4)]];
};

struct VertexOut {
    float4 position [[position]];
    float4 vertex_color;
    float3 world;
    float3 world_normal;
    float2 splat_uv;
    float view_depth;
};

vertex VertexOut main0(
    VertexIn in [[stage_in]],
    constant TerrainVertUniform& u [[buffer(0)]]
) {
    VertexOut out;
    float4 world4 = u.model * float4(in.position, 1.0);
    out.position = u.view_proj * world4;
    out.vertex_color = in.color;
    out.world = world4.xyz;
    out.world_normal = normalize((u.model * float4(in.normal, 0.0)).xyz);
    out.splat_uv = in.uv;
    out.view_depth = -(u.view * float4(world4.xyz, 1.0)).z;
    return out;
}
