#include <metal_stdlib>
using namespace metal;
#define XU_VEC3 float3
#define XU_VEC4 float4
#define XU_MIX mix
#define XU_FINITE isfinite
#include "lighting.inc"
#define XU_VEC2 float2
#define XU_DDX(v) dfdx(v)
#define XU_DDY(v) dfdy(v)
#define XU_MAT4 float4x4
#define XU_MUL(m,v) ((m)*(v))
#define XU_SHADOW_RESOURCES texture2d<float> shadow_map, sampler shadow_sampling
#define XU_SHADOW_READ(uv) shadow_map.sample(shadow_sampling,uv,level(0.0)).r
#define XU_SHADOW_ARGS shadow_map,shadow_sampling
#include "shadow.inc"
struct Input { float4 position [[position]]; float4 color; float3 world; float3 normal; float2 uv; float3 tangent; float3 bitangent; };
struct Material { float4 base_metallic; float4 emission_roughness; float4 maps_normal; float4 surface; float4 uv_rect; };
struct Shadow { float4x4 mvp[4]; float4 direction_bias; float4 shadow_filter; float4 depth; float4 camera_depth; float4 ranges[4]; float4 limits; float4 gradient_scales; };
struct Lighting { float4 ambient_count; float4 eye_exposure; float4 sources[XU_MAX_LIGHTS*4]; };
fragment float4 main0(Input input [[stage_in]], constant Material& p [[buffer(0)]], constant Lighting& l [[buffer(1)]], constant Shadow& s [[buffer(2)]],
    texture2d<float> base_texture [[texture(0)]], sampler base_sampler [[sampler(0)]],
    texture2d<float> orm_texture [[texture(1)]], sampler orm_sampler [[sampler(1)]],
    texture2d<float> emission_texture [[texture(2)]], sampler emission_sampler [[sampler(2)]],
    texture2d<float> normal_texture [[texture(3)]], sampler normal_sampler [[sampler(3)]],
    texture2d<float> occlusion_texture [[texture(4)]], sampler occlusion_sampler [[sampler(4)]],
    texture2d<float> shadow_texture [[texture(5)]], sampler shadow_sampler [[sampler(5)]], bool front [[front_facing]]) {
    if (p.surface.z < 0.5) return input.color;
    int mask = int(p.maps_normal.x);
    float2 sample_uv = p.uv_rect.xy + input.uv * p.uv_rect.zw;
    float3 base = p.base_metallic.xyz * input.color.xyz;
    float alpha = input.color.a;
    if ((mask & 1) != 0) {
        float4 base_texel = base_texture.sample(base_sampler, sample_uv);
        base *= base_texel.rgb;
        alpha *= base_texel.a;
    }
    if (p.surface.w > 0.0 && alpha < p.surface.w) discard_fragment();
    if (p.surface.z > 1.5) {
        float3 clamped = clamp(base, float3(0.0, 0.0, 0.0), float3(1.0, 1.0, 1.0));
        return float4(srgb_channel(clamped.x), srgb_channel(clamped.y), srgb_channel(clamped.z), 1.0);
    }
    float3 orm = float3(1.0, 1.0, 1.0);
    if ((mask & 2) != 0) orm = orm_texture.sample(orm_sampler, sample_uv).rgb;
    float ao_strength = p.maps_normal.y;
    if ((mask & 16) != 0) { orm.x = occlusion_texture.sample(occlusion_sampler, sample_uv).r; ao_strength = p.surface.y; }
    float3 emission = p.emission_roughness.xyz;
    if ((mask & 4) != 0) emission *= emission_texture.sample(emission_sampler, sample_uv).rgb;
    float3 shading_normal = input.normal;
    if ((mask & 8) != 0) {
        float3 adj_tangent = p.uv_rect.z < 0.0 ? -input.tangent : input.tangent;
        float3 adj_bitangent = p.uv_rect.w < 0.0 ? -input.bitangent : input.bitangent;
        shading_normal = normal_map_direction(input.normal, adj_tangent, adj_bitangent, normal_texture.sample(normal_sampler, sample_uv).rgb, p.maps_normal.z);
    }
    bool surface_front = front;
    if (p.surface.x < 0.0) surface_front = !surface_front;
    if (p.maps_normal.w == 1.0 && !surface_front) shading_normal = -shading_normal;
    float metallic = p.base_metallic.w * orm.z;
    float roughness = max(0.045, p.emission_roughness.w * orm.y);
    float occlusion = 1.0 + ao_strength * (orm.x - 1.0);
    float3 linear_color = l.ambient_count.xyz * occlusion * base * (1.0 - metallic) + emission;
    for (int i = 0; i < XU_MAX_LIGHTS && i < int(l.ambient_count.w); ++i) {
        int offset = i * 4;
        float visibility = 1.0;
        if (s.shadow_filter.w > 0.5 && i == int(s.shadow_filter.z)) {
            if (s.shadow_filter.w > 3.5) visibility = cascade_shadow_visibility(input.world,input.normal,XU_MUL(s.mvp[0],XU_VEC4(input.world,1.0)),XU_MUL(s.mvp[1],XU_VEC4(input.world,1.0)),XU_MUL(s.mvp[2],XU_VEC4(input.world,1.0)),XU_MUL(s.mvp[3],XU_VEC4(input.world,1.0)),s.camera_depth,s.ranges[0],s.ranges[1],s.ranges[2],s.ranges[3],s.limits,s.direction_bias,s.shadow_filter,s.depth,s.gradient_scales,shadow_texture,shadow_sampler);
            else visibility = shadow_visibility(input.world,input.normal,s.mvp[0],s.direction_bias,s.shadow_filter,s.depth,shadow_texture,shadow_sampler);
        }
        linear_color += source_direct(base, metallic, roughness, shading_normal, input.world, l.eye_exposure.xyz,
            l.sources[offset], l.sources[offset+1], l.sources[offset+2], l.sources[offset+3]) * visibility;
    }
    return float4(finish_lighting(linear_color,l.eye_exposure.w),1.0);
}
