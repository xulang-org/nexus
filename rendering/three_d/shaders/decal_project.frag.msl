#include <metal_stdlib>
using namespace metal;

constant uint MAX_LIGHTS_PER_CLUSTER = 64u;

struct LightGpu {
    float4 position_kind;
    float4 direction_range;
    float4 radiance_inner;
    float4 cone;
};

struct ClusteredLighting {
    float4 ambient_count;
    float4 eye_exposure;
    float4 screen_depth;
    float4 grid_mode;
    float4 log_info;
};

struct IrradianceUniform {
    float4 origin_nx;
    float4 spacing_ny;
    float4 dims_mode;
};

struct ProbeShGpu {
    float4 dc;
    float4 px;
    float4 py;
    float4 pz;
};

struct DecalFragUniform {
    float4x4 inv_vp;
    float4x4 inv_model;
    float4 decal_up_angle;  // xyz=decal_up, w=angle_fade_min
    float4 albedo_opacity;  // rgb=albedo, w=opacity
    float4 emission_rough;  // rgb=emission, w=roughness
    float4 meta0;           // x=metallic, y=blend_mode(0=alpha,1=add,2=stain), z=shape_mode(0=tex,1=disc,2=ring), w=edge_fade
    float4 viewport_shape;  // x=width, y=height, z=ring_inner, w=radial_power
    float4 view_row2;       // dot(view_row2.xyz, world) + view_row2.w = view.z
};

struct FragIn {
    float4 position [[position]];
};

static inline float3 unit_safe(float3 value) {
    float largest = max(abs(value.x), max(abs(value.y), abs(value.z)));
    if (!isfinite(largest) || largest == 0.0) return float3(0.0, 1.0, 0.0);
    float3 scaled = value / largest;
    return scaled / sqrt(dot(scaled, scaled));
}

static inline float3 eval_probe(device const ProbeShGpu* probes, uint idx, float3 n) {
    ProbeShGpu sh = probes[idx];
    return max(sh.dc.xyz + sh.px.xyz * n.x + sh.py.xyz * n.y + sh.pz.xyz * n.z, float3(0.0));
}

static inline float3 sample_irradiance(
    device const ProbeShGpu* probes,
    constant IrradianceUniform& irr,
    float3 world,
    float3 n
) {
    int nx = int(irr.origin_nx.w);
    int ny = int(irr.spacing_ny.w);
    int nz = int(irr.dims_mode.x);
    if (nx <= 0 || ny <= 0 || nz <= 0) return float3(0.0);
    float3 rel = (world - irr.origin_nx.xyz) / max(irr.spacing_ny.xyz, float3(1e-4));
    float fx = clamp(rel.x, 0.0, float(max(nx - 1, 0)));
    float fy = clamp(rel.y, 0.0, float(max(ny - 1, 0)));
    float fz = clamp(rel.z, 0.0, float(max(nz - 1, 0)));
    int x0 = min(int(floor(fx)), max(nx - 1, 0));
    int y0 = min(int(floor(fy)), max(ny - 1, 0));
    int z0 = min(int(floor(fz)), max(nz - 1, 0));
    int x1 = min(x0 + 1, max(nx - 1, 0));
    int y1 = min(y0 + 1, max(ny - 1, 0));
    int z1 = min(z0 + 1, max(nz - 1, 0));
    float tx = fx - float(x0);
    float ty = fy - float(y0);
    float tz = fz - float(z0);
    uint nxy = uint(nx * ny);
    uint ux = uint(nx);
    float3 c000 = eval_probe(probes, uint(z0) * nxy + uint(y0) * ux + uint(x0), n);
    float3 c100 = eval_probe(probes, uint(z0) * nxy + uint(y0) * ux + uint(x1), n);
    float3 c010 = eval_probe(probes, uint(z0) * nxy + uint(y1) * ux + uint(x0), n);
    float3 c110 = eval_probe(probes, uint(z0) * nxy + uint(y1) * ux + uint(x1), n);
    float3 c001 = eval_probe(probes, uint(z1) * nxy + uint(y0) * ux + uint(x0), n);
    float3 c101 = eval_probe(probes, uint(z1) * nxy + uint(y0) * ux + uint(x1), n);
    float3 c011 = eval_probe(probes, uint(z1) * nxy + uint(y1) * ux + uint(x0), n);
    float3 c111 = eval_probe(probes, uint(z1) * nxy + uint(y1) * ux + uint(x1), n);
    float3 c00 = mix(c000, c100, tx);
    float3 c10 = mix(c010, c110, tx);
    float3 c01 = mix(c001, c101, tx);
    float3 c11 = mix(c011, c111, tx);
    return mix(mix(c00, c10, ty), mix(c01, c11, ty), tz);
}

static inline float3 pbr_direct(
    float3 base, float metallic, float roughness,
    float3 normal, float3 position, float3 eye, float3 light, float3 radiance
) {
    float3 n = unit_safe(normal);
    float3 v = unit_safe(eye - position);
    float3 l = unit_safe(light);
    float3 h = unit_safe(v + l);
    float nv = max(dot(n, v), 0.0001);
    float nl = max(dot(n, l), 0.0);
    float nh = max(dot(n, h), 0.0);
    float vh = clamp(dot(v, h), 0.0, 1.0);
    float alpha = roughness * roughness;
    float a2 = alpha * alpha;
    float denom = (nh * a2 - nh) * nh + 1.0;
    float d = a2 / (3.14159265359 * max(denom * denom, 1e-12));
    float vis = 0.5 / max(nl * sqrt(nv * nv * (1.0 - a2) + a2) +
        nv * sqrt(nl * nl * (1.0 - a2) + a2), 0.000001);
    float3 f0 = mix(float3(0.04), base, metallic);
    float3 f = f0 + (float3(1.0) - f0) * pow(1.0 - vh, 5.0);
    float3 diff = (float3(1.0) - f) * (1.0 - metallic) * base / 3.14159265359;
    return (diff + d * vis * f) * radiance * nl;
}

static inline float3 light_contrib(
    float3 base, float metallic, float roughness,
    float3 normal, float3 position, float3 eye, LightGpu src
) {
    float3 light = src.direction_range.xyz;
    float atten = 1.0;
    if (src.position_kind.w > 0.5) {
        float3 delta = src.position_kind.xyz - position;
        float d2 = dot(delta, delta);
        float r2 = src.direction_range.w * src.direction_range.w;
        if (d2 < 1e-12 || d2 >= r2) return float3(0.0);
        light = delta / sqrt(d2);
        float rel2 = d2 / r2;
        float edge = max(0.0, 1.0 - rel2 * rel2);
        atten = edge * edge / max(d2, 0.0001);
        if (src.position_kind.w > 1.5) {
            float cos_a = dot(src.direction_range.xyz, -light);
            float t = clamp((cos_a - src.cone.x) / max(src.radiance_inner.w - src.cone.x, 1e-6), 0.0, 1.0);
            atten *= t * t * (3.0 - 2.0 * t);
        }
    }
    return pbr_direct(base, metallic, roughness, normal, position, eye, light, src.radiance_inner.xyz * atten);
}

fragment float4 main0(
    FragIn in [[stage_in]],
    texture2d<float> albedo_tex [[texture(0)]],
    depth2d<float> scene_depth_tex [[texture(1)]],
    texture2d<float> scene_normal_tex [[texture(2)]],
    sampler albedo_samp [[sampler(0)]],
    sampler depth_samp [[sampler(1)]],
    sampler norm_samp [[sampler(2)]],
    constant DecalFragUniform& u [[buffer(0)]],
    constant ClusteredLighting& l [[buffer(1)]],
    constant IrradianceUniform& irr [[buffer(2)]],
    device const LightGpu* lights [[buffer(3)]],
    device const uint* cluster_counts [[buffer(4)]],
    device const uint* cluster_indices [[buffer(5)]],
    device const ProbeShGpu* probes [[buffer(6)]]
) {
    float2 screen_uv = clamp(in.position.xy / max(u.viewport_shape.xy, float2(1.0)), float2(0.0), float2(1.0));
    float scene_d = scene_depth_tex.sample(depth_samp, screen_uv);
    if (scene_d <= 1e-6) discard_fragment();

    float ndc_x = screen_uv.x * 2.0 - 1.0;
    float ndc_y = 1.0 - screen_uv.y * 2.0;
    float4 wp4 = u.inv_vp * float4(ndc_x, ndc_y, scene_d, 1.0);
    float3 world_pos = wp4.xyz / max(wp4.w, 1e-6);

    float3 local = (u.inv_model * float4(world_pos, 1.0)).xyz;
    if (abs(local.x) > 0.5 || abs(local.y) > 0.5 || abs(local.z) > 0.5) {
        discard_fragment();
    }

    float2 duv = float2(local.x + 0.5, local.z + 0.5);
    float3 scene_n_raw = scene_normal_tex.sample(norm_samp, screen_uv, level(0.0)).xyz;
    float3 decal_up = unit_safe(u.decal_up_angle.xyz);
    float3 n = length(scene_n_raw) > 1e-4 ? unit_safe(scene_n_raw) : decal_up;

    float angle_min = u.decal_up_angle.w;
    float afade = 1.0;
    if (angle_min > 0.0) {
        float ndot = abs(dot(n, decal_up));
        afade = smoothstep(angle_min, min(angle_min + 0.15, 0.999), ndot);
        if (afade <= 1e-4) discard_fragment();
    }

    float edge_fade = u.meta0.w;
    float yfade = 1.0;
    if (edge_fade > 0.0) {
        yfade = 1.0 - smoothstep(max(0.0, 0.5 - edge_fade), 0.5, abs(local.y));
        if (yfade <= 1e-4) discard_fragment();
    }

    int smode = int(u.meta0.z + 0.5);
    float shape_a = 1.0;
    float2 centered = duv * 2.0 - 1.0;
    float r2 = dot(centered, centered);
    if (smode == 1) {
        shape_a = pow(clamp(1.0 - r2, 0.0, 1.0), max(u.viewport_shape.w, 0.25));
    } else if (smode == 2) {
        float r = sqrt(r2);
        float inner = clamp(u.viewport_shape.z, 0.05, 0.9);
        shape_a = smoothstep(inner, inner + 0.10, r) * (1.0 - smoothstep(0.88, 1.0, r));
    }

    float4 texel = albedo_tex.sample(albedo_samp, duv);
    float alpha = clamp(u.albedo_opacity.w * texel.a * shape_a * afade * yfade, 0.0, 1.0);
    if (alpha <= 1e-4) discard_fragment();

    float3 base = u.albedo_opacity.rgb * texel.rgb;
    float3 emission = u.emission_rough.rgb;
    int bmode = int(u.meta0.y + 0.5);
    if (bmode == 1) {
        // Additive HDR premultiplied output: src.a = 0 so destination is untouched, src.rgb adds directly.
        return float4((base + emission) * alpha, 0.0);
    }
    if (bmode == 2) {
        // Stain/darkener: blends darkened albedo over underlying HDR scene.
        return float4(base * 0.15 * alpha, alpha);
    }

    float roughness = max(0.045, u.emission_rough.w);
    float metallic = clamp(u.meta0.x, 0.0, 1.0);
    float3 indirect_ambient = l.ambient_count.xyz;
    if (irr.dims_mode.y > 0.5) {
        indirect_ambient += sample_irradiance(probes, irr, world_pos, n) * irr.dims_mode.z;
    }
    float3 linear_color = indirect_ambient * base * (1.0 - metallic) + emission;

    uint total_clusters = uint(l.grid_mode.x) * uint(l.grid_mode.y) * uint(l.grid_mode.z);
    uint dir_count = min(cluster_counts[total_clusters], MAX_LIGHTS_PER_CLUSTER);
    for (uint di = 0u; di < dir_count; ++di) {
        uint li = cluster_indices[total_clusters * MAX_LIGHTS_PER_CLUSTER + di];
        linear_color += light_contrib(base, metallic, roughness, n, world_pos, l.eye_exposure.xyz, lights[li]);
    }

    if (l.ambient_count.w > 0.5) {
        uint cx = uint(l.grid_mode.x);
        uint cy = uint(l.grid_mode.y);
        uint cz = uint(l.grid_mode.z);
        uint tx = min(uint(max(0.0, floor(in.position.x / l.screen_depth.x * float(cx)))), cx - 1u);
        uint ty = min(uint(max(0.0, floor(in.position.y / l.screen_depth.y * float(cy)))), cy - 1u);
        float z_near = l.screen_depth.z;
        float z_far = l.screen_depth.w;
        float view_depth = -(dot(u.view_row2.xyz, world_pos) + u.view_row2.w);
        float vd = clamp(view_depth, z_near, z_far);
        float norm_z = l.grid_mode.w < 0.5 ? (log(vd / z_near) / l.log_info.x) : ((vd - z_near) / max(z_far - z_near, 1e-6));
        uint tz = min(uint(max(0.0, floor(norm_z * float(cz)))), cz - 1u);
        uint cid = (tz * cy + ty) * cx + tx;
        uint local_count = min(cluster_counts[cid], MAX_LIGHTS_PER_CLUSTER);
        uint base_idx = cid * MAX_LIGHTS_PER_CLUSTER;
        for (uint ci = 0u; ci < local_count; ++ci) {
            uint li = cluster_indices[base_idx + ci];
            linear_color += light_contrib(base, metallic, roughness, n, world_pos, l.eye_exposure.xyz, lights[li]);
        }
    }

    return float4(max(linear_color, float3(0.0)) * alpha, alpha);
}
