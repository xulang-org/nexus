#include <metal_stdlib>
using namespace metal;

constant uint MAX_LIGHTS_PER_CLUSTER = 64u;

struct LightGpu {
    float4 position_kind;
    float4 direction_range;
    float4 radiance_inner;
    float4 cone;
};

struct Material {
    float4 base_metallic;
    float4 emission_roughness;
    float4 maps_normal;
    float4 surface;
    float4 uv_rect;
    float4 pbr_ext0; // x=alpha, y=clearcoat, z=clearcoat_roughness, w=ior
    float4 pbr_ext1; // xyz=sheen_color, w=sheen_roughness
};

struct ClusteredLighting {
    float4 ambient_count;
    float4 eye_exposure;
    float4 screen_depth;
    float4 grid_mode;
    float4 log_info;
};

struct Shadow {
    float4x4 mvp[4];
    float4 direction_bias;
    float4 shadow_filter;
    float4 depth;
    float4 camera_depth;
    float4 ranges[4];
    float4 limits;
    float4 gradient_scales;
};

struct IrradianceUniform {
    float4 origin_nx;   // xyz=origin, w=nx
    float4 spacing_ny;  // xyz=spacing, w=ny
    float4 dims_mode;   // x=nz, y=enabled, z=strength, w=0
};

struct ProbeShGpu {
    float4 dc;
    float4 px;
    float4 py;
    float4 pz;
};

struct FragIn {
    float4 position [[position]];
    float4 vertex_color;
    float3 world;
    float3 world_normal;
    float2 texture_uv;
    float3 world_tangent;
    float3 world_bitangent;
    float view_depth;
};

struct FragOut {
    float4 hdr_color [[color(0)]];
    float4 normal_roughness [[color(1)]];
};

static inline float3 unit_safe(float3 value) {
    float largest = max(abs(value.x), max(abs(value.y), abs(value.z)));
    if (!isfinite(largest) || largest == 0.0) return float3(0.0, 0.0, 0.0);
    float3 scaled = value / largest;
    return scaled / sqrt(dot(scaled, scaled));
}

#define XU_VEC2 float2
#define XU_VEC3 float3
#define XU_VEC4 float4
#define XU_MIX mix
#define XU_DDX(v) dfdx(v)
#define XU_DDY(v) dfdy(v)
#define XU_MAT4 float4x4
#define XU_MUL(m,v) ((m)*(v))
#define XU_SHADOW_RESOURCES texture2d<float> shadow_map, sampler shadow_sampling
#define XU_SHADOW_READ(uv) shadow_map.sample(shadow_sampling,uv,level(0.0)).r
#define XU_SHADOW_ARGS shadow_map,shadow_sampling
#include "shadow.inc"

static inline float3 material_direct(float3 base, float metallic, float roughness,
    float clearcoat, float clearcoat_roughness, float ior,
    float3 sheen_color, float sheen_roughness,
    float3 normal, float3 position, float3 eye, float3 light, float3 radiance) {
    float3 n = unit_safe(normal), v = unit_safe(eye - position), l = unit_safe(light), h = unit_safe(v + l);
    float nv = max(dot(n, v), 0.0001), nl = max(dot(n, l), 0.0);
    float nh = max(dot(n, h), 0.0), vh = clamp(dot(v, h), 0.0, 1.0);
    float alpha = roughness * roughness, a2 = alpha * alpha;
    float denominator = (nh * a2 - nh) * nh + 1.0;
    float distribution = a2 / (3.14159265359 * max(denominator * denominator, 1e-12));
    float visibility = 0.5 / max(nl * sqrt(nv * nv * (1.0 - a2) + a2) +
        nv * sqrt(nl * nl * (1.0 - a2) + a2), 0.000001);
    float ior_ratio = (ior - 1.0) / max(ior + 1.0, 1e-4);
    float f0_dielectric = ior_ratio * ior_ratio;
    float3 f0 = mix(float3(f0_dielectric), base, metallic);
    float factor = pow(1.0 - vh, 5.0);
    float3 fresnel = f0 + (float3(1.0, 1.0, 1.0) - f0) * factor;
    // Fdez-Aguera analytical GGX multi-scattering energy compensation.
    float4 r_ms = roughness * float4(-1.0, -0.0275, -0.572, 0.022) + float4(1.0, 0.0425, 1.04, -0.04);
    float a004 = min(r_ms.x * r_ms.x, exp2(-9.28 * nv)) * r_ms.x + r_ms.y;
    float2 ab_ms = float2(-1.04, 1.04) * a004 + r_ms.zw;
    float ess = clamp(ab_ms.x + ab_ms.y, 0.05, 1.0);
    float3 ms_comp = float3(1.0, 1.0, 1.0) + f0 * (1.0 / ess - 1.0);
    float3 diffuse = (float3(1.0, 1.0, 1.0) - fresnel) * (1.0 - metallic) * base / 3.14159265359;
    float3 brdf = diffuse + distribution * visibility * fresnel * ms_comp;

    float max_sheen = max(sheen_color.x, max(sheen_color.y, sheen_color.z));
    if (max_sheen > 0.0) {
        float inv_r = 1.0 / max(sheen_roughness * sheen_roughness, 0.002);
        float sin2h = max(1.0 - nh * nh, 1e-6);
        float d_charlie = (2.0 + inv_r) * pow(sin2h, inv_r * 0.5) / (2.0 * 3.14159265359);
        float v_sheen = 1.0 / max(4.0 * (nl + nv - nl * nv), 1e-4);
        float3 sheen_brdf = sheen_color * d_charlie * v_sheen;
        float sheen_scale = max(0.0, 1.0 - max_sheen * pow(1.0 - nv, 3.0) * 0.5);
        brdf = brdf * sheen_scale + sheen_brdf;
    }

    if (clearcoat > 0.0) {
        float cc_alpha = clearcoat_roughness * clearcoat_roughness;
        float cc_a2 = cc_alpha * cc_alpha;
        float cc_denom = (nh * cc_a2 - nh) * nh + 1.0;
        float cc_d = cc_a2 / (3.14159265359 * max(cc_denom * cc_denom, 1e-12));
        float cc_v = 0.5 / max(nl * sqrt(nv * nv * (1.0 - cc_a2) + cc_a2) +
            nv * sqrt(nl * nl * (1.0 - cc_a2) + cc_a2), 0.000001);
        float cc_f = 0.04 + 0.96 * factor;
        brdf = brdf * (1.0 - clearcoat * cc_f) + float3(clearcoat * cc_d * cc_v * cc_f);
    }

    return brdf * radiance * nl;
}

static inline float3 source_direct(float3 base, float metallic, float roughness,
    float clearcoat, float clearcoat_roughness, float ior,
    float3 sheen_color, float sheen_roughness,
    float3 normal, float3 position, float3 eye, LightGpu src) {
    float3 light = src.direction_range.xyz;
    float attenuation = 1.0;
    if (src.position_kind.w > 0.5) {
        float3 delta = src.position_kind.xyz - position;
        float distance2 = dot(delta, delta), radius2 = src.direction_range.w * src.direction_range.w;
        if (distance2 < 1e-12 || distance2 >= radius2) return float3(0.0, 0.0, 0.0);
        light = delta / sqrt(distance2);
        float relative2 = distance2 / radius2;
        float edge = max(0.0, 1.0 - relative2 * relative2);
        attenuation = edge * edge / max(distance2, 0.0001);
        if (src.position_kind.w > 1.5) {
            float cosine = dot(src.direction_range.xyz, -light);
            float transition = clamp((cosine - src.cone.x) / max(src.radiance_inner.w - src.cone.x, 0.000001), 0.0, 1.0);
            attenuation *= transition * transition * (3.0 - 2.0 * transition);
        }
    }
    return material_direct(base, metallic, roughness, clearcoat, clearcoat_roughness, ior,
        sheen_color, sheen_roughness, normal, position, eye, light, src.radiance_inner.xyz * attenuation);
}

static inline float3 eval_probe(device const ProbeShGpu* probes, uint idx, float3 n) {
    ProbeShGpu sh = probes[idx];
    return max(sh.dc.xyz + sh.px.xyz * n.x + sh.py.xyz * n.y + sh.pz.xyz * n.z, float3(0.0));
}

static inline float3 sample_irradiance(
    device const ProbeShGpu* probes,
    constant IrradianceUniform& irr,
    float3 world,
    float3 n
) {
    int nx = int(irr.origin_nx.w);
    int ny = int(irr.spacing_ny.w);
    int nz = int(irr.dims_mode.x);
    float3 f = (world - irr.origin_nx.xyz) / irr.spacing_ny.xyz;
    int x0 = clamp(int(floor(f.x)), 0, nx - 1);
    int y0 = clamp(int(floor(f.y)), 0, ny - 1);
    int z0 = clamp(int(floor(f.z)), 0, nz - 1);
    int x1 = min(x0 + 1, nx - 1);
    int y1 = min(y0 + 1, ny - 1);
    int z1 = min(z0 + 1, nz - 1);
    float tx = clamp(f.x - float(x0), 0.0, 1.0);
    float ty = clamp(f.y - float(y0), 0.0, 1.0);
    float tz = clamp(f.z - float(z0), 0.0, 1.0);

    float3 c000 = eval_probe(probes, uint((z0 * ny + y0) * nx + x0), n);
    float3 c100 = eval_probe(probes, uint((z0 * ny + y0) * nx + x1), n);
    float3 c010 = eval_probe(probes, uint((z0 * ny + y1) * nx + x0), n);
    float3 c110 = eval_probe(probes, uint((z0 * ny + y1) * nx + x1), n);
    float3 c001 = eval_probe(probes, uint((z1 * ny + y0) * nx + x0), n);
    float3 c101 = eval_probe(probes, uint((z1 * ny + y0) * nx + x1), n);
    float3 c011 = eval_probe(probes, uint((z1 * ny + y1) * nx + x0), n);
    float3 c111 = eval_probe(probes, uint((z1 * ny + y1) * nx + x1), n);

    float3 c00 = mix(c000, c100, tx);
    float3 c10 = mix(c010, c110, tx);
    float3 c01 = mix(c001, c101, tx);
    float3 c11 = mix(c011, c111, tx);
    return mix(mix(c00, c10, ty), mix(c01, c11, ty), tz);
}

static inline float3 normal_map_direction(float3 normal, float3 tangent, float3 bitangent,
    float3 texel, float scale) {
    float3 n = unit_safe(normal);
    if (scale == 0.0) return n;
    float3 t = unit_safe(tangent);
    t = unit_safe(t - n * dot(n, t));
    float3 b = unit_safe(cross(n, t));
    if (dot(b, unit_safe(bitangent)) < 0.0) b = -b;
    float3 mapped = texel * 2.0 - float3(1.0, 1.0, 1.0);
    mapped.x *= scale; mapped.y *= scale;
    mapped = unit_safe(mapped);
    float3 result = unit_safe(t * mapped.x + b * mapped.y + n * mapped.z);
    if (dot(result, result) == 0.0) return n;
    return result;
}

fragment FragOut main0(
    FragIn in [[stage_in]],
    bool is_front [[front_facing]],
    texture2d<float> base_texture [[texture(0)]],
    texture2d<float> orm_texture [[texture(1)]],
    texture2d<float> emission_texture [[texture(2)]],
    texture2d<float> normal_texture [[texture(3)]],
    texture2d<float> occlusion_texture [[texture(4)]],
    texture2d<float> shadow_texture [[texture(5)]],
    sampler base_sampler [[sampler(0)]],
    sampler orm_sampler [[sampler(1)]],
    sampler emission_sampler [[sampler(2)]],
    sampler normal_sampler [[sampler(3)]],
    sampler occlusion_sampler [[sampler(4)]],
    sampler shadow_sampler [[sampler(5)]],
    constant Material& p [[buffer(0)]],
    constant ClusteredLighting& l [[buffer(1)]],
    constant Shadow& s [[buffer(2)]],
    constant IrradianceUniform& irr [[buffer(3)]],
    device const LightGpu* lights [[buffer(4)]],
    device const uint* cluster_counts [[buffer(5)]],
    device const uint* cluster_indices [[buffer(6)]],
    device const ProbeShGpu* probes [[buffer(7)]]
) {
    FragOut out;
    int mask = int(p.maps_normal.x);
    float2 sample_uv = p.uv_rect.xy + in.texture_uv * p.uv_rect.zw;
    float3 base = p.base_metallic.xyz * in.vertex_color.xyz;
    float alpha = in.vertex_color.a;
    if ((mask & 1) != 0) {
        float4 base_texel = base_texture.sample(base_sampler, sample_uv);
        base *= base_texel.rgb;
        alpha *= base_texel.a;
    }
    alpha *= p.pbr_ext0.x;
    if (p.surface.w > 0.0 && alpha < p.surface.w) discard_fragment();

    float clearcoat = clamp(p.pbr_ext0.y, 0.0, 1.0);
    float clearcoat_roughness = max(0.045, p.pbr_ext0.z);
    float ior = max(1.0, p.pbr_ext0.w);
    float3 sheen_color = max(p.pbr_ext1.xyz, float3(0.0));
    float sheen_roughness = max(0.045, p.pbr_ext1.w);

    float3 shading_normal = unit_safe(in.world_normal);
    if ((mask & 8) != 0) {
        float3 adj_tangent = p.uv_rect.z < 0.0 ? -in.world_tangent : in.world_tangent;
        float3 adj_bitangent = p.uv_rect.w < 0.0 ? -in.world_bitangent : in.world_bitangent;
        shading_normal = normal_map_direction(in.world_normal, adj_tangent, adj_bitangent,
            normal_texture.sample(normal_sampler, sample_uv).rgb, p.maps_normal.z);
    }
    bool surface_front = is_front;
    if (p.surface.x < 0.0) surface_front = !surface_front;
    if (p.maps_normal.w == 1.0 && !surface_front) shading_normal = -shading_normal;

    float3 orm = float3(1.0, 1.0, 1.0);
    if ((mask & 2) != 0) orm = orm_texture.sample(orm_sampler, sample_uv).rgb;
    float ao_strength = p.maps_normal.y;
    if ((mask & 16) != 0) {
        orm.x = occlusion_texture.sample(occlusion_sampler, sample_uv).r;
        ao_strength = p.surface.y;
    }
    float metallic = p.base_metallic.w * orm.z;
    float roughness = max(0.045, p.emission_roughness.w * orm.y);
    float occlusion = 1.0 + ao_strength * (orm.x - 1.0);
    float3 emission = p.emission_roughness.xyz;
    if ((mask & 4) != 0) emission *= emission_texture.sample(emission_sampler, sample_uv).rgb;

    if (p.surface.z < 0.5) {
        out.hdr_color = float4(in.vertex_color.rgb, alpha);
        out.normal_roughness = float4(shading_normal, roughness);
        return out;
    }
    if (p.surface.z > 1.5) {
        out.hdr_color = float4(max(base + emission, float3(0.0)), alpha);
        out.normal_roughness = float4(shading_normal, roughness);
        return out;
    }

    float3 indirect_ambient = l.ambient_count.xyz;
    if (irr.dims_mode.y > 0.5) {
        indirect_ambient += sample_irradiance(probes, irr, in.world, shading_normal) * irr.dims_mode.z;
    }
    float3 linear_color = indirect_ambient * occlusion * base * (1.0 - metallic) + emission;
    float3 v_ind = unit_safe(l.eye_exposure.xyz - in.world);
    float nv_ind = max(dot(shading_normal, v_ind), 0.0001);
    float max_sheen_ind = max(sheen_color.x, max(sheen_color.y, sheen_color.z));
    if (max_sheen_ind > 0.0) {
        linear_color += indirect_ambient * occlusion * sheen_color * pow(1.0 - nv_ind, 2.0) * 0.35;
    }
    float3 refl_dir = reflect(-v_ind, shading_normal);
    float sky_t = clamp(refl_dir.y * 0.5 + 0.5, 0.0, 1.0);
    float3 env_hemi = indirect_ambient * mix(float3(0.42, 0.40, 0.38), float3(1.50, 1.58, 1.72), sky_t);
    if (metallic > 0.001) {
        float ior_r_ind = (ior - 1.0) / max(ior + 1.0, 1e-4);
        float3 f0_ind = mix(float3(ior_r_ind * ior_r_ind), base, metallic);
        float3 f_rough = f0_ind + (max(float3(1.0 - roughness), f0_ind) - f0_ind) * pow(1.0 - nv_ind, 5.0);
        linear_color += env_hemi * occlusion * f_rough * metallic * (1.0 - roughness * 0.45);
    }
    if (clearcoat > 0.001) {
        float cc_f_ind = 0.04 + 0.96 * pow(1.0 - nv_ind, 5.0);
        linear_color += env_hemi * occlusion * (clearcoat * cc_f_ind * (1.0 - clearcoat_roughness * 0.55));
    }

    float shadow_vis = 1.0;
    int shadow_light_idx = -1;
    if (s.shadow_filter.w > 0.5) {
        shadow_light_idx = int(s.shadow_filter.z);
        if (s.shadow_filter.w > 3.5) {
            shadow_vis = cascade_shadow_visibility(in.world, in.world_normal,
                XU_MUL(s.mvp[0], XU_VEC4(in.world, 1.0)), XU_MUL(s.mvp[1], XU_VEC4(in.world, 1.0)),
                XU_MUL(s.mvp[2], XU_VEC4(in.world, 1.0)), XU_MUL(s.mvp[3], XU_VEC4(in.world, 1.0)),
                s.camera_depth, s.ranges[0], s.ranges[1], s.ranges[2], s.ranges[3], s.limits,
                s.direction_bias, s.shadow_filter, s.depth, s.gradient_scales, shadow_texture, shadow_sampler);
        } else {
            shadow_vis = shadow_visibility(in.world, in.world_normal, s.mvp[0], s.direction_bias,
                s.shadow_filter, s.depth, s.gradient_scales.x, shadow_texture, shadow_sampler);
        }
    }

    uint total_clusters = uint(l.grid_mode.x) * uint(l.grid_mode.y) * uint(l.grid_mode.z);
    uint dir_count = min(cluster_counts[total_clusters], MAX_LIGHTS_PER_CLUSTER);
    for (uint di = 0u; di < dir_count; ++di) {
        uint li = cluster_indices[total_clusters * MAX_LIGHTS_PER_CLUSTER + di];
        float vis = (int(li) == shadow_light_idx) ? shadow_vis : 1.0;
        linear_color += source_direct(base, metallic, roughness, clearcoat, clearcoat_roughness, ior,
            sheen_color, sheen_roughness, shading_normal, in.world, l.eye_exposure.xyz, lights[li]) * vis;
    }

    if (l.ambient_count.w > 0.5) {
        uint cx = uint(l.grid_mode.x);
        uint cy = uint(l.grid_mode.y);
        uint cz = uint(l.grid_mode.z);
        uint tx = min(uint(max(0.0, floor(in.position.x / l.screen_depth.x * float(cx)))), cx - 1u);
        uint ty = min(uint(max(0.0, floor(in.position.y / l.screen_depth.y * float(cy)))), cy - 1u);
        float z_near = l.screen_depth.z;
        float z_far = l.screen_depth.w;
        float vd = clamp(in.view_depth, z_near, z_far);
        float norm_z = l.grid_mode.w < 0.5 ? (log(vd / z_near) / l.log_info.x) : ((vd - z_near) / max(z_far - z_near, 1e-6));
        uint tz = min(uint(max(0.0, floor(norm_z * float(cz)))), cz - 1u);
        uint cid = (tz * cy + ty) * cx + tx;

        uint local_count = min(cluster_counts[cid], MAX_LIGHTS_PER_CLUSTER);
        uint base_idx = cid * MAX_LIGHTS_PER_CLUSTER;
        for (uint ci = 0u; ci < local_count; ++ci) {
            uint li = cluster_indices[base_idx + ci];
            float vis = (int(li) == shadow_light_idx) ? shadow_vis : 1.0;
            linear_color += source_direct(base, metallic, roughness, clearcoat, clearcoat_roughness, ior,
                sheen_color, sheen_roughness, shading_normal, in.world, l.eye_exposure.xyz, lights[li]) * vis;
        }
    }

    out.hdr_color = float4(max(linear_color, float3(0.0)), alpha);
    out.normal_roughness = float4(shading_normal, roughness);
    return out;
}
