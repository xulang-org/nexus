#include <metal_stdlib>
using namespace metal;

struct AtmosphereApplyUniform {
    float4x4 inv_vp;
    float4x4 view;
    float4 eye_flags;    // xyz=eye, w=sky_enabled
    float4 sun_dir_fog;  // xyz=sun_dir, w=fog_enabled
    float4 sun_rad_disc; // rgb=sun_radiance, w=sun_disc_intensity
    float4 sky_rayleigh; // rgb=rayleigh_beta, w=rayleigh_scale_h
    float4 sky_mie;      // x=mie_beta, y=mie_g, z=mie_scale_h, w=sun_disc_cos
    float4 ground_near;  // rgb=ground_albedo, w=fog_near
    float4 grid_far;     // x=FX, y=FY, z=FZ, w=fog_far
};

struct FragIn {
    float4 position [[position]];
    float2 uv;
};

static inline float ray_sphere_exit(float3 ro, float3 rd, float radius) {
    float b = dot(ro, rd);
    float c = dot(ro, ro) - radius * radius;
    float disc = b * b - c;
    if (disc < 0.0) return -1.0;
    return -b + sqrt(disc);
}

static inline float3 compute_physical_sky(
    float3 rd,
    constant AtmosphereApplyUniform& u
) {
    const float Re = 6360000.0;
    const float Ra = 6420000.0;
    float3 sun_dir = normalize(u.sun_dir_fog.xyz);
    float mu = dot(rd, sun_dir);

    float3 ray_dir = rd;
    float horizon_ground_mix = 0.0;
    if (ray_dir.y < 0.02) {
        horizon_ground_mix = smoothstep(0.02, -0.18, ray_dir.y);
        ray_dir = normalize(float3(ray_dir.x, max(ray_dir.y, 0.02), ray_dir.z));
    }

    float3 ro = float3(0.0, Re + 120.0, 0.0);
    float t_max = ray_sphere_exit(ro, ray_dir, Ra);
    if (t_max <= 0.0) return float3(0.0);

    const int STEPS_V = 8;
    const int STEPS_L = 4;
    float seg_v = t_max / float(STEPS_V);

    float3 beta_r = u.sky_rayleigh.rgb;
    float h_r = max(u.sky_rayleigh.w, 100.0);
    float beta_m = u.sky_mie.x;
    float g = clamp(u.sky_mie.y, -0.95, 0.95);
    float h_m = max(u.sky_mie.z, 50.0);

    float opt_r = 0.0;
    float opt_m = 0.0;
    float3 sum_r = float3(0.0);
    float3 sum_m = float3(0.0);

    for (int i = 0; i < STEPS_V; ++i) {
        float3 pos = ro + ray_dir * ((float(i) + 0.5) * seg_v);
        float alt = max(length(pos) - Re, 0.0);
        float hr = exp(-alt / h_r) * seg_v;
        float hm = exp(-alt / h_m) * seg_v;
        opt_r += hr;
        opt_m += hm;

        float t_light = ray_sphere_exit(pos, sun_dir, Ra);
        if (t_light <= 0.0) continue;
        float seg_l = t_light / float(STEPS_L);
        float opt_lr = 0.0;
        float opt_lm = 0.0;
        bool blocked = false;
        for (int j = 0; j < STEPS_L; ++j) {
            float3 lpos = pos + sun_dir * ((float(j) + 0.5) * seg_l);
            float lalt = length(lpos) - Re;
            if (lalt < 0.0) { blocked = true; break; }
            opt_lr += exp(-lalt / h_r) * seg_l;
            opt_lm += exp(-lalt / h_m) * seg_l;
        }
        if (blocked) continue;
        float3 tau = beta_r * (opt_r + opt_lr) + float3(beta_m * 1.1) * (opt_m + opt_lm);
        float3 atten = exp(-tau);
        sum_r += atten * hr;
        sum_m += atten * hm;
    }

    float phase_r = 3.0 / (16.0 * 3.14159265359) * (1.0 + mu * mu);
    float g2 = g * g;
    float phase_m = 3.0 / (8.0 * 3.14159265359) * ((1.0 - g2) * (1.0 + mu * mu)) /
        max((2.0 + g2) * pow(max(1.0 + g2 - 2.0 * g * mu, 1e-4), 1.5), 1e-4);

    float3 sun_energy = u.sun_rad_disc.rgb * 8.5;
    float3 sky = sun_energy * (sum_r * beta_r * phase_r + sum_m * beta_m * phase_m);

    if (rd.y >= -0.02 && u.sun_rad_disc.w > 0.0) {
        float cos_r = u.sky_mie.w;
        float disc = smoothstep(cos_r - 0.0005, cos_r + 0.0004, mu);
        float3 limb_tau = beta_r * opt_r + float3(beta_m * 1.1) * opt_m;
        sky += u.sun_rad_disc.rgb * u.sun_rad_disc.w * exp(-limb_tau * 0.45) * disc;
    }

    if (horizon_ground_mix > 0.0) {
        float sun_up = clamp(sun_dir.y * 2.0 + 0.25, 0.05, 1.0);
        float3 ground_col = u.ground_near.rgb * u.sun_rad_disc.rgb * sun_up;
        sky = mix(sky, ground_col, horizon_ground_mix);
    }

    return max(sky, float3(0.0));
}

static inline float4 sample_froxel_trilinear(
    device const float4* froxel_accum,
    float2 uv,
    float z_norm,
    uint fx_n,
    uint fy_n,
    uint fz_n
) {
    float fx = clamp(uv.x * float(fx_n) - 0.5, 0.0, float(fx_n - 1u));
    float fy = clamp(uv.y * float(fy_n) - 0.5, 0.0, float(fy_n - 1u));
    float fz = clamp(z_norm * float(fz_n) - 0.5, 0.0, float(fz_n - 1u));

    uint x0 = uint(floor(fx));
    uint y0 = uint(floor(fy));
    uint z0 = uint(floor(fz));
    uint x1 = min(x0 + 1u, fx_n - 1u);
    uint y1 = min(y0 + 1u, fy_n - 1u);
    uint z1 = min(z0 + 1u, fz_n - 1u);

    float tx = fx - float(x0);
    float ty = fy - float(y0);
    float tz = fz - float(z0);

    uint slice_xy = fx_n * fy_n;
    float4 c000 = froxel_accum[z0 * slice_xy + y0 * fx_n + x0];
    float4 c100 = froxel_accum[z0 * slice_xy + y0 * fx_n + x1];
    float4 c010 = froxel_accum[z0 * slice_xy + y1 * fx_n + x0];
    float4 c110 = froxel_accum[z0 * slice_xy + y1 * fx_n + x1];
    float4 c001 = froxel_accum[z1 * slice_xy + y0 * fx_n + x0];
    float4 c101 = froxel_accum[z1 * slice_xy + y0 * fx_n + x1];
    float4 c011 = froxel_accum[z1 * slice_xy + y1 * fx_n + x0];
    float4 c111 = froxel_accum[z1 * slice_xy + y1 * fx_n + x1];

    float4 c00 = mix(c000, c100, tx);
    float4 c10 = mix(c010, c110, tx);
    float4 c01 = mix(c001, c101, tx);
    float4 c11 = mix(c011, c111, tx);
    return mix(mix(c00, c10, ty), mix(c01, c11, ty), tz);
}

fragment float4 main0(
    FragIn in [[stage_in]],
    depth2d<float> scene_depth_tex [[texture(0)]],
    sampler depth_samp [[sampler(0)]],
    constant AtmosphereApplyUniform& u [[buffer(0)]],
    device const float4* froxel_accum [[buffer(1)]]
) {
    float scene_d = scene_depth_tex.sample(depth_samp, in.uv);
    float ndc_x = in.uv.x * 2.0 - 1.0;
    float ndc_y = 1.0 - in.uv.y * 2.0;

    if (scene_d <= 1e-6) {
        if (u.eye_flags.w < 0.5) {
            return float4(0.0, 0.0, 0.0, 0.0);
        }
        float4 far4 = u.inv_vp * float4(ndc_x, ndc_y, 0.001, 1.0);
        float3 far_p = far4.xyz / max(far4.w, 1e-6);
        float3 rd = normalize(far_p - u.eye_flags.xyz);
        float3 sky_rgb = compute_physical_sky(rd, u);
        // Premultiplied alpha=1 replaces cleared backdrop with rendered atmospheric sky.
        return float4(sky_rgb, 1.0);
    }

    if (u.sun_dir_fog.w < 0.5) {
        return float4(0.0, 0.0, 0.0, 0.0);
    }

    float4 wp4 = u.inv_vp * float4(ndc_x, ndc_y, scene_d, 1.0);
    float3 world_pos = wp4.xyz / max(wp4.w, 1e-6);
    float view_dist = -(u.view * float4(world_pos, 1.0)).z;
    if (view_dist <= 0.0) {
        return float4(0.0, 0.0, 0.0, 0.0);
    }

    float fog_near = u.ground_near.w;
    float fog_far = u.grid_far.w;
    float clamped_z = clamp(view_dist, fog_near, fog_far);
    float z_norm = log(clamped_z / max(fog_near, 1e-4)) / max(log(fog_far / max(fog_near, 1e-4)), 1e-4);

    uint fx_n = uint(u.grid_far.x);
    uint fy_n = uint(u.grid_far.y);
    uint fz_n = uint(u.grid_far.z);
    float4 fog = sample_froxel_trilinear(froxel_accum, in.uv, z_norm, fx_n, fy_n, fz_n);

    float near_ramp = clamp(view_dist / max(fog_near, 0.05), 0.0, 1.0);
    float3 in_scatter = fog.rgb * near_ramp;
    float trans = mix(1.0, clamp(fog.a, 0.0, 1.0), near_ramp);
    // BLEND_PREMULTIPLIED: src.rgb + dst.rgb * (1 - src.a) = in_scatter + dst.rgb * trans.
    return float4(max(in_scatter, float3(0.0)), clamp(1.0 - trans, 0.0, 1.0));
}
