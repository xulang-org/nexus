#include <metal_stdlib>
using namespace metal;

struct SsrParams {
    float4x4 view;
    float4x4 proj;
    float4x4 inv_proj;
    float4 info;  // x=width, y=height, z=max_roughness, w=max_distance
    float4 zinfo; // x=z_near, y=z_far, z=thickness, w=enabled
};

static inline float3 reconstruct_view(float4x4 inv_proj, float2 uv, float depth) {
    float ndc_x = uv.x * 2.0 - 1.0;
    float ndc_y = 1.0 - uv.y * 2.0;
    float4 v = inv_proj * float4(ndc_x, ndc_y, depth, 1.0);
    return v.xyz / max(v.w, 1e-6);
}

static inline float3 project_uv_z(float4x4 proj, float3 vp) {
    float4 c = proj * float4(vp, 1.0);
    if (c.w <= 1e-5) return float3(-1.0, -1.0, -1.0);
    float3 ndc = c.xyz / c.w;
    return float3(ndc.x * 0.5 + 0.5, 0.5 - ndc.y * 0.5, ndc.z);
}

static inline float view_depth_from_ndc(float4x4 inv_proj, float2 uv, float depth) {
    return -reconstruct_view(inv_proj, uv, depth).z;
}

kernel void main0(
    texture2d<float> src_color [[texture(0)]],
    texture2d<float> src_normal [[texture(1)]],
    depth2d<float> src_depth [[texture(2)]],
    texture2d<float> hiz0 [[texture(3)]],
    texture2d<float, access::write> dst_ssr [[texture(4)]],
    sampler color_sampler [[sampler(0)]],
    sampler normal_sampler [[sampler(1)]],
    sampler depth_sampler [[sampler(2)]],
    sampler hiz_sampler [[sampler(3)]],
    constant SsrParams& params [[buffer(0)]],
    uint2 gid [[thread_position_in_grid]]
) {
    uint w = uint(params.info.x);
    uint h = uint(params.info.y);
    if (gid.x >= w || gid.y >= h) return;

    if (params.zinfo.w < 0.5) {
        dst_ssr.write(float4(0.0), gid);
        return;
    }

    float2 inv_res = float2(1.0 / params.info.x, 1.0 / params.info.y);
    float2 uv = (float2(gid) + 0.5) * inv_res;
    float d = src_depth.sample(depth_sampler, uv);
    float4 nr = src_normal.sample(normal_sampler, uv, level(0.0));
    float roughness = nr.w;
    float nlen = length(nr.xyz);
    if (d <= 1e-6 || nlen < 1e-4 || roughness > params.info.z) {
        dst_ssr.write(float4(0.0), gid);
        return;
    }

    float3 P = reconstruct_view(params.inv_proj, uv, d);
    float3 N = normalize((params.view * float4(nr.xyz / nlen, 0.0)).xyz);
    float3 V = normalize(-P);
    float3 R = reflect(-V, N);
    if (R.z > 0.3) {
        dst_ssr.write(float4(0.0), gid);
        return;
    }

    float max_dist = params.info.w;
    float thickness = params.zinfo.z;
    const int STEPS = 32;
    float step_len = max_dist / float(STEPS);
    float jitter = fract(52.9829189 * fract(dot(float2(gid), float2(0.06711056, 0.00583715))));

    bool hit = false;
    float2 hit_uv = float2(0.0);
    float prev_t = 0.0;
    float hit_t = step_len * 0.5;

    for (int i = 1; i <= STEPS; ++i) {
        float t = step_len * (float(i) - 1.0 + max(jitter, 0.05));
        float3 sample_vp = P + R * t;
        if (-sample_vp.z <= params.zinfo.x || -sample_vp.z >= params.zinfo.y) break;
        float3 uvd = project_uv_z(params.proj, sample_vp);
        if (uvd.x <= 0.0 || uvd.x >= 1.0 || uvd.y <= 0.0 || uvd.y >= 1.0) break;

        // Fast conservative Hi-Z skip against coarse half-res min-depth (Reverse-Z).
        float coarse_z = hiz0.sample(hiz_sampler, uvd.xy, level(0.0)).r;
        if (coarse_z <= 1e-6) {
            prev_t = t;
            continue;
        }
        float fine_z = src_depth.sample(depth_sampler, uvd.xy);
        if (fine_z <= 1e-6) {
            prev_t = t;
            continue;
        }
        float ray_dist = -sample_vp.z;
        float surf_dist = view_depth_from_ndc(params.inv_proj, uvd.xy, fine_z);
        float delta = ray_dist - surf_dist;
        if (delta > 0.0 && delta < thickness) {
            hit = true;
            hit_uv = uvd.xy;
            hit_t = t;
            break;
        }
        prev_t = t;
    }

    if (!hit) {
        dst_ssr.write(float4(0.0), gid);
        return;
    }

    // 4-step binary refinement for crisp sub-step reflection contact.
    float lo = prev_t;
    float hi = hit_t;
    for (int r = 0; r < 4; ++r) {
        float mid = 0.5 * (lo + hi);
        float3 vp = P + R * mid;
        float3 uvd = project_uv_z(params.proj, vp);
        if (uvd.x > 0.0 && uvd.x < 1.0 && uvd.y > 0.0 && uvd.y < 1.0) {
            float fz = src_depth.sample(depth_sampler, uvd.xy);
            float sd = view_depth_from_ndc(params.inv_proj, uvd.xy, fz);
            if ((-vp.z) - sd > 0.0) {
                hi = mid;
                hit_uv = uvd.xy;
            } else {
                lo = mid;
            }
        }
    }

    float3 refl_color = src_color.sample(color_sampler, hit_uv, level(0.0)).rgb;
    float edge_x = min(hit_uv.x, 1.0 - hit_uv.x);
    float edge_y = min(hit_uv.y, 1.0 - hit_uv.y);
    float edge_fade = clamp(min(edge_x, edge_y) * 8.0, 0.0, 1.0);
    float rough_fade = clamp(1.0 - (roughness / max(params.info.z, 1e-4)), 0.0, 1.0);
    float nv = clamp(dot(N, V), 0.0, 1.0);
    float fresnel = 0.04 + 0.96 * pow(1.0 - nv, 4.0);
    float dist_fade = 1.0 - smoothstep(max_dist * 0.75, max_dist, hit_t);
    float cam_fade = clamp(1.0 - max(R.z, 0.0) * 3.0, 0.0, 1.0);
    float weight = clamp(edge_fade * rough_fade * fresnel * dist_fade * cam_fade, 0.0, 1.0);
    dst_ssr.write(float4(refl_color, weight), gid);
}
