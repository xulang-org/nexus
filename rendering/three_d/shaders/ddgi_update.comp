#version 450

struct ProbeShGpu { vec4 dc; vec4 px; vec4 py; vec4 pz; };

layout(set = 2, binding = 0, std140) uniform DdgiUpdateUniform {
    vec4 dims_rays; vec4 depth_params; vec4 rot_row0; vec4 rot_row1; vec4 rot_row2;
    vec4 pad0; vec4 pad1; vec4 pad2;
} u;

layout(set = 0, binding = 0, std430) readonly buffer RayResBuf { vec4 ray_results[]; };
layout(set = 0, binding = 1, std430) readonly buffer PrevProbesBuf { ProbeShGpu prev_probes[]; };
layout(set = 0, binding = 2, std430) readonly buffer PrevVisBuf { vec2 prev_vis[]; };
layout(set = 1, binding = 0, std430) writeonly buffer OutProbesBuf { ProbeShGpu out_probes[]; };
layout(set = 1, binding = 1, std430) writeonly buffer OutVisBuf { vec2 out_vis[]; };

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

vec3 fibonacci_dir(uint ray_idx, uint ray_count, vec3 r0, vec3 r1, vec3 r2) {
    float n = max(float(ray_count), 1.0), fi = float(ray_idx) + 0.5, phi = 2.399963229728653 * float(ray_idx);
    float cos_theta = 1.0 - 2.0 * fi / n, sin_theta = sqrt(max(0.0, 1.0 - cos_theta * cos_theta));
    vec3 d = vec3(cos(phi) * sin_theta, cos_theta, sin(phi) * sin_theta);
    return normalize(vec3(dot(r0, d), dot(r1, d), dot(r2, d)));
}

vec3 oct_decode(vec2 uv01) {
    vec2 f = uv01 * 2.0 - 1.0;
    vec3 n = vec3(f.x, f.y, 1.0 - abs(f.x) - abs(f.y));
    float t = clamp(-n.z, 0.0, 1.0);
    n.x += (n.x >= 0.0) ? -t : t;
    n.y += (n.y >= 0.0) ? -t : t;
    return normalize(n);
}

void main() {
    uint gid = gl_GlobalInvocationID.x;
    uint probe_count = uint(u.dims_rays.x);
    if (gid >= probe_count) return;

    uint rays_per_probe = uint(u.dims_rays.y), ray_base = gid * rays_per_probe;
    vec3 sum_dc = vec3(0.0), sum_px = vec3(0.0), sum_py = vec3(0.0), sum_pz = vec3(0.0);
    uint valid_rays = 0u, backface_rays = 0u;

    for (uint r = 0u; r < rays_per_probe; ++r) {
        vec4 rr = ray_results[ray_base + r];
        if (rr.w < 0.0) { backface_rays += 1u; continue; }
        vec3 d = fibonacci_dir(r, rays_per_probe, u.rot_row0.xyz, u.rot_row1.xyz, u.rot_row2.xyz);
        vec3 rad = max(rr.xyz, vec3(0.0));
        sum_dc += rad; sum_px += rad * d.x; sum_py += rad * d.y; sum_pz += rad * d.z;
        valid_rays += 1u;
    }

    float bf_ratio = float(backface_rays) / max(float(rays_per_probe), 1.0);
    float validity = (bf_ratio > u.depth_params.y || valid_rays == 0u) ? 0.0 : 1.0;
    vec3 new_dc = vec3(0.0), new_px = vec3(0.0), new_py = vec3(0.0), new_pz = vec3(0.0);
    if (valid_rays > 0u && validity > 0.5) {
        float inv_n = 1.0 / float(valid_rays);
        new_dc = sum_dc * inv_n;
        new_px = sum_px * (2.0 * inv_n);
        new_py = sum_py * (2.0 * inv_n);
        new_pz = sum_pz * (2.0 * inv_n);
    }

    float h = (u.depth_params.w > 0.5) ? 0.0 : clamp(u.dims_rays.z, 0.0, 0.98);
    ProbeShGpu prev = prev_probes[gid];
    ProbeShGpu next_sh;
    next_sh.dc = vec4(mix(new_dc, prev.dc.xyz, h), validity);
    next_sh.px = vec4(mix(new_px, prev.px.xyz, h), 0.0);
    next_sh.py = vec4(mix(new_py, prev.py.xyz, h), 0.0);
    next_sh.pz = vec4(mix(new_pz, prev.pz.xyz, h), 0.0);
    out_probes[gid] = next_sh;

    uint vis_res = max(uint(u.depth_params.z), 1u), vis_texels = vis_res * vis_res, vis_base = gid * vis_texels;
    float max_pdist = max(u.dims_rays.w, 0.5), sharp = max(u.depth_params.x, 1.0);
    for (uint ty = 0u; ty < vis_res; ++ty) {
        for (uint tx = 0u; tx < vis_res; ++tx) {
            vec2 oct_uv = vec2((float(tx) + 0.5) / float(vis_res), (float(ty) + 0.5) / float(vis_res));
            vec3 tex_dir = oct_decode(oct_uv);
            float sum_d = 0.0, sum_d2 = 0.0, sum_w = 0.0;
            for (uint r = 0u; r < rays_per_probe; ++r) {
                vec4 rr = ray_results[ray_base + r];
                vec3 d = fibonacci_dir(r, rays_per_probe, u.rot_row0.xyz, u.rot_row1.xyz, u.rot_row2.xyz);
                float c = max(dot(tex_dir, d), 0.0);
                if (c <= 1e-4) continue;
                float w = pow(c, sharp), dist = (rr.w < 0.0) ? 0.0 : min(rr.w, max_pdist);
                sum_d += w * dist; sum_d2 += w * dist * dist; sum_w += w;
            }
            vec2 cur_m = (sum_w > 1e-6) ? vec2(sum_d / sum_w, sum_d2 / sum_w) : vec2(max_pdist, max_pdist * max_pdist);
            vec2 pm = prev_vis[vis_base + ty * vis_res + tx];
            out_vis[vis_base + ty * vis_res + tx] = mix(cur_m, pm, h);
        }
    }
}
