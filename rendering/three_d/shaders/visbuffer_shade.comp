#version 450

const uint MAX_LIGHTS_PER_CLUSTER = 64u;

struct ShadowData {
    mat4 mvp[4];
    vec4 direction_bias;
    vec4 shadow_filter;
    vec4 depth;
    vec4 camera_depth;
    vec4 ranges[4];
    vec4 limits;
    vec4 gradient_scales;
};

struct MeshletGpu {
    vec4 bound_sphere;
    vec4 cone;
    uvec4 info;
};

struct MeshletInstanceGpu {
    mat4 model;
    mat4 normals;
    vec4 scale_info;
    vec4 base_metallic;
    vec4 emission_roughness;
    vec4 maps_normal;
    vec4 surface;
    vec4 uv_rect;
};

struct LightGpu {
    vec4 position_kind;
    vec4 direction_range;
    vec4 radiance_inner;
    vec4 cone;
};

struct ProbeShGpu {
    vec4 dc;
    vec4 px;
    vec4 py;
    vec4 pz;
};

layout(set = 0, binding = 0) uniform sampler2D ibl_brdf;
layout(set = 0, binding = 1) uniform sampler2D ibl_env;
layout(set = 0, binding = 2) uniform sampler2D shadow_map;
layout(set = 0, binding = 3) uniform sampler2D albedo0;
layout(set = 0, binding = 4) uniform sampler2D albedo1;
layout(set = 0, binding = 5) uniform sampler2D albedo2;
layout(set = 0, binding = 6) uniform sampler2D albedo3;
layout(set = 0, binding = 7, r32ui) uniform readonly uimage2D vis_tex;

layout(set = 0, binding = 8, std430) readonly buffer MeshletsBuf { MeshletGpu meshlets[]; };
layout(set = 0, binding = 9, std430) readonly buffer InstancesBuf { MeshletInstanceGpu instances[]; };
layout(set = 0, binding = 10, std430) readonly buffer VertsBuf { float verts[]; };
layout(set = 0, binding = 11, std430) readonly buffer IndicesBuf { uint indices[]; };
layout(set = 0, binding = 12, std430) readonly buffer LightsBuf { LightGpu lights[]; };
layout(set = 0, binding = 13, std430) readonly buffer CountsBuf { uint cluster_counts[]; };
layout(set = 0, binding = 14, std430) readonly buffer ClusterIdxBuf { uint cluster_indices[]; };
layout(set = 0, binding = 15, std430) readonly buffer ProbesBuf { ProbeShGpu probes[]; };

layout(set = 1, binding = 0, rgba16f) uniform writeonly image2D out_hdr;
layout(set = 1, binding = 1, rgba16f) uniform writeonly image2D out_norm_rough;

layout(set = 2, binding = 0, std140) uniform VisShadeUniform {
    mat4 view_proj;
    mat4 view;
    vec4 ambient_count;
    vec4 eye_exposure;
    vec4 screen_depth;
    vec4 grid_mode;
    vec4 log_info;
    vec4 sky_color;
    vec4 irr_origin_nx;
    vec4 irr_spacing_ny;
    vec4 irr_dims;
    ShadowData s;
} u;

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

float cross2(vec2 a, vec2 b) { return a.x * b.y - a.y * b.x; }

vec3 unit_safe(vec3 value) {
    float largest = max(abs(value.x), max(abs(value.y), abs(value.z)));
    if (isnan(largest) || isinf(largest) || largest == 0.0) return vec3(0.0);
    vec3 scaled = value / largest;
    return scaled / sqrt(dot(scaled, scaled));
}

vec3 compute_bary(vec4 c0, vec4 c1, vec4 c2, vec2 ndc0, vec2 ndc1, vec2 ndc2, float area, vec2 px_ndc) {
    if (abs(area) <= 1e-12) return vec3(1.0 / 3.0);
    float l0 = cross2(ndc1 - px_ndc, ndc2 - px_ndc) / area;
    float l1 = cross2(ndc2 - px_ndc, ndc0 - px_ndc) / area;
    float l2 = 1.0 - l0 - l1;
    float pw0 = l0 / max(c0.w, 1e-5);
    float pw1 = l1 / max(c1.w, 1e-5);
    float pw2 = l2 / max(c2.w, 1e-5);
    float psum = pw0 + pw1 + pw2;
    if (abs(psum) <= 1e-12) return vec3(1.0 / 3.0);
    return clamp(vec3(pw0, pw1, pw2) / psum, -0.5, 1.5);
}

vec3 material_direct(vec3 base, float metallic, float roughness,
    vec3 normal, vec3 position, vec3 eye, vec3 light, vec3 radiance) {
    vec3 n = unit_safe(normal), v = unit_safe(eye - position), l = unit_safe(light), h = unit_safe(v + l);
    float nv = max(dot(n, v), 0.0001), nl = max(dot(n, l), 0.0);
    float nh = max(dot(n, h), 0.0), vh = clamp(dot(v, h), 0.0, 1.0);
    float alpha = roughness * roughness, a2 = alpha * alpha;
    float denominator = (nh * a2 - nh) * nh + 1.0;
    float distribution = a2 / (3.14159265359 * max(denominator * denominator, 1e-12));
    float visibility = 0.5 / max(nl * sqrt(nv * nv * (1.0 - a2) + a2) +
        nv * sqrt(nl * nl * (1.0 - a2) + a2), 0.000001);
    vec3 f0 = mix(vec3(0.04), base, metallic);
    float factor = pow(1.0 - vh, 5.0);
    vec3 fresnel = f0 + (vec3(1.0) - f0) * factor;
    vec3 diffuse = (vec3(1.0) - fresnel) * (1.0 - metallic) * base / 3.14159265359;
    return (diffuse + distribution * visibility * fresnel) * radiance * nl;
}

vec3 source_direct(vec3 base, float metallic, float roughness,
    vec3 normal, vec3 position, vec3 eye, LightGpu src) {
    vec3 light = src.direction_range.xyz;
    float attenuation = 1.0;
    if (src.position_kind.w > 0.5) {
        vec3 delta = src.position_kind.xyz - position;
        float distance2 = dot(delta, delta), radius2 = src.direction_range.w * src.direction_range.w;
        if (distance2 < 1e-12 || distance2 >= radius2) return vec3(0.0);
        light = delta / sqrt(distance2);
        float relative2 = distance2 / radius2;
        float edge = max(0.0, 1.0 - relative2 * relative2);
        attenuation = edge * edge / max(distance2, 0.0001);
        if (src.position_kind.w > 1.5) {
            float cosine = dot(src.direction_range.xyz, -light);
            float transition = clamp((cosine - src.cone.x) / max(src.radiance_inner.w - src.cone.x, 0.000001), 0.0, 1.0);
            attenuation *= transition * transition * (3.0 - 2.0 * transition);
        }
    }
    return material_direct(base, metallic, roughness, normal, position, eye, light, src.radiance_inner.xyz * attenuation);
}

vec3 eval_probe(uint idx, vec3 n) {
    ProbeShGpu sh = probes[idx];
    return max(sh.dc.xyz + sh.px.xyz * n.x + sh.py.xyz * n.y + sh.pz.xyz * n.z, vec3(0.0));
}

vec3 sample_irradiance(vec3 wpos, vec3 n) {
    int nx = int(u.irr_origin_nx.w);
    int ny = int(u.irr_spacing_ny.w);
    int nz = int(u.irr_dims.x);
    vec3 f = (wpos - u.irr_origin_nx.xyz) / u.irr_spacing_ny.xyz;
    int x0 = clamp(int(floor(f.x)), 0, nx - 1), y0 = clamp(int(floor(f.y)), 0, ny - 1), z0 = clamp(int(floor(f.z)), 0, nz - 1);
    int x1 = min(x0 + 1, nx - 1), y1 = min(y0 + 1, ny - 1), z1 = min(z0 + 1, nz - 1);
    float tx = clamp(f.x - float(x0), 0.0, 1.0), ty = clamp(f.y - float(y0), 0.0, 1.0), tz = clamp(f.z - float(z0), 0.0, 1.0);
    vec3 c000 = eval_probe(uint((z0 * ny + y0) * nx + x0), n), c100 = eval_probe(uint((z0 * ny + y0) * nx + x1), n);
    vec3 c010 = eval_probe(uint((z0 * ny + y1) * nx + x0), n), c110 = eval_probe(uint((z0 * ny + y1) * nx + x1), n);
    vec3 c001 = eval_probe(uint((z1 * ny + y0) * nx + x0), n), c101 = eval_probe(uint((z1 * ny + y0) * nx + x1), n);
    vec3 c011 = eval_probe(uint((z1 * ny + y1) * nx + x0), n), c111 = eval_probe(uint((z1 * ny + y1) * nx + x1), n);
    vec3 c00 = mix(c000, c100, tx), c10 = mix(c010, c110, tx), c01 = mix(c001, c101, tx), c11 = mix(c011, c111, tx);
    return mix(mix(c00, c10, ty), mix(c01, c11, ty), tz);
}

vec2 shadow_slope_grad(vec3 p, vec3 px, vec3 py) {
    vec3 n = unit_safe(cross(px - p, py - p));
    if (abs(n.z) <= 0.00001) return vec2(0.0);
    return vec2(-2.0 * n.x, 2.0 * n.y) / n.z;
}

float cascade_layer_pcf(vec3 p, vec2 gradient, int layer, float bias, float texel, vec2 atlas_size, float raster_bias) {
    if (p.x < -1.0 || p.x > 1.0 || p.y < -1.0 || p.y > 1.0 || p.z < 0.0 || p.z > 1.0) return 1.0;
    float adj_bias = bias + max(abs(gradient.x), abs(gradient.y)) * texel * raster_bias;
    vec2 uv = vec2(p.x * 0.5 + 0.5, 0.5 - p.y * 0.5);
    float visible = 0.0, total = 0.0;
    for (int y = -1; y <= 1; ++y) {
        for (int x = -1; x <= 1; ++x) {
            vec2 at = (floor(uv / texel) + vec2(float(x), float(y)) + vec2(0.5)) * texel;
            vec2 weights = max(vec2(1.5) - abs((at - uv) / texel), vec2(0.0));
            float weight = weights.x * weights.y;
            total += weight;
            if (weight <= 0.0) continue;
            if (at.x < 0.0 || at.x > 1.0 || at.y < 0.0 || at.y > 1.0) { visible += weight; continue; }
            vec2 atlas = (at + vec2(float(layer % 2), float(layer / 2))) / atlas_size;
            float ref_d = textureLod(shadow_map, atlas, 0.0).r;
            visible += (p.z + dot(gradient, at - uv) + adj_bias >= ref_d ? 1.0 : 0.0) * weight;
        }
    }
    return visible / max(total, 1e-6);
}

float eval_vis_shadow(vec3 world, vec3 world_x, vec3 world_y, vec3 normal) {
    if (u.s.shadow_filter.w < 0.5) return 1.0;
    if (u.s.shadow_filter.w > 3.5) {
        vec4 c0 = u.s.mvp[0] * vec4(world, 1.0), c0x = u.s.mvp[0] * vec4(world_x, 1.0), c0y = u.s.mvp[0] * vec4(world_y, 1.0);
        vec2 g0 = shadow_slope_grad(c0.xyz, c0x.xyz, c0y.xyz);
        float dist = dot(u.s.camera_depth, vec4(world, 1.0));
        if (dist < u.s.limits.x || dist > u.s.limits.y) return 1.0;
        int layer = 0;
        if (dist > u.s.ranges[0].y && u.s.limits.z > 1.5) layer = 1;
        if (dist > u.s.ranges[1].y && u.s.limits.z > 2.5) layer = 2;
        if (dist > u.s.ranges[2].y && u.s.limits.z > 3.5) layer = 3;
        vec4 p_cur = u.s.mvp[layer] * vec4(world, 1.0);
        float scale = (layer == 0) ? 1.0 : ((layer == 1) ? u.s.gradient_scales.y : ((layer == 2) ? u.s.gradient_scales.z : u.s.gradient_scales.w));
        float bias = u.s.direction_bias.w + u.s.shadow_filter.y * (1.0 - max(0.0, dot(unit_safe(normal), u.s.direction_bias.xyz)));
        return cascade_layer_pcf(p_cur.xyz, g0 * scale, layer, bias * u.s.ranges[layer].w, u.s.shadow_filter.x, u.s.depth.zw, u.s.limits.w);
    }
    vec4 proj = u.s.mvp[0] * vec4(world, 1.0), proj_x = u.s.mvp[0] * vec4(world_x, 1.0), proj_y = u.s.mvp[0] * vec4(world_y, 1.0);
    vec3 p = proj.xyz / max(proj.w, 0.000001), px = proj_x.xyz / max(proj_x.w, 0.000001), py = proj_y.xyz / max(proj_y.w, 0.000001);
    if (proj.w <= 0.000001 || p.x < -1.0 || p.x > 1.0 || p.y < -1.0 || p.y > 1.0 || p.z < 0.0 || p.z > 1.0) return 1.0;
    vec2 grad = shadow_slope_grad(p, px, py);
    vec2 uv = vec2(p.x * 0.5 + 0.5, 0.5 - p.y * 0.5);
    vec3 to_l = u.s.shadow_filter.w > 1.5 ? unit_safe(u.s.direction_bias.xyz - world) : u.s.direction_bias.xyz;
    float bias = u.s.direction_bias.w + u.s.shadow_filter.y * (1.0 - max(0.0, dot(unit_safe(normal), to_l)));
    float vis = 0.0;
    for (int y = -1; y <= 1; ++y) {
        for (int x = -1; x <= 1; ++x) {
            vec2 at = (floor(uv / u.s.shadow_filter.x) + vec2(float(x), float(y)) + vec2(0.5)) * u.s.shadow_filter.x;
            if (at.x < 0.0 || at.x > 1.0 || at.y < 0.0 || at.y > 1.0) vis += 1.0;
            else vis += (p.z + dot(grad, at - uv) + bias >= textureLod(shadow_map, at, 0.0).r ? 1.0 : 0.0);
        }
    }
    return vis / 9.0;
}

vec4 sample_albedo_grad(int slot, vec2 uv, vec2 grad_x, vec2 grad_y) {
    if (slot == 1) return textureGrad(albedo0, uv, grad_x, grad_y);
    if (slot == 2) return textureGrad(albedo1, uv, grad_x, grad_y);
    if (slot == 3) return textureGrad(albedo2, uv, grad_x, grad_y);
    if (slot == 4) return textureGrad(albedo3, uv, grad_x, grad_y);
    return vec4(1.0);
}

void main() {
    uvec2 gid = gl_GlobalInvocationID.xy;
    uint sw = uint(u.screen_depth.x), sh = uint(u.screen_depth.y);
    if (gid.x >= sw || gid.y >= sh) return;

    uint vis_id = imageLoad(vis_tex, ivec2(gid)).r;
    if (vis_id == 0u) {
        imageStore(out_hdr, ivec2(gid), vec4(u.sky_color.rgb, 1.0));
        imageStore(out_norm_rough, ivec2(gid), vec4(0.0, 0.0, 0.0, 1.0));
        return;
    }

    uint raw = vis_id - 1u, mid = raw >> 8u, prim = raw & 0xFFu;
    MeshletGpu m = meshlets[mid];
    MeshletInstanceGpu inst = instances[m.info.x];
    uint base_idx = m.info.y + prim * 3u;
    uint i0 = indices[base_idx + 0u], i1 = indices[base_idx + 1u], i2 = indices[base_idx + 2u];
    uint v0b = i0 * 16u, v1b = i1 * 16u, v2b = i2 * 16u;

    vec3 lp0 = vec3(verts[v0b + 0u], verts[v0b + 1u], verts[v0b + 2u]);
    vec3 lp1 = vec3(verts[v1b + 0u], verts[v1b + 1u], verts[v1b + 2u]);
    vec3 lp2 = vec3(verts[v2b + 0u], verts[v2b + 1u], verts[v2b + 2u]);
    vec4 w0_4 = inst.model * vec4(lp0, 1.0), w1_4 = inst.model * vec4(lp1, 1.0), w2_4 = inst.model * vec4(lp2, 1.0);
    vec4 c0 = u.view_proj * w0_4, c1 = u.view_proj * w1_4, c2 = u.view_proj * w2_4;

    vec2 ndc0 = c0.xy / max(abs(c0.w), 1e-6) * (c0.w < 0.0 ? -1.0 : 1.0);
    vec2 ndc1 = c1.xy / max(abs(c1.w), 1e-6) * (c1.w < 0.0 ? -1.0 : 1.0);
    vec2 ndc2 = c2.xy / max(abs(c2.w), 1e-6) * (c2.w < 0.0 ? -1.0 : 1.0);

    vec2 inv_wh = vec2(1.0 / u.screen_depth.x, 1.0 / u.screen_depth.y);
    vec2 px_ndc = vec2((float(gid.x) + 0.5) * inv_wh.x * 2.0 - 1.0, 1.0 - (float(gid.y) + 0.5) * inv_wh.y * 2.0);
    vec2 dx_ndc = vec2(2.0 * inv_wh.x, 0.0), dy_ndc = vec2(0.0, -2.0 * inv_wh.y);

    float area = cross2(ndc1 - ndc0, ndc2 - ndc0);
    vec3 bary = compute_bary(c0, c1, c2, ndc0, ndc1, ndc2, area, px_ndc);
    vec3 bary_dx = compute_bary(c0, c1, c2, ndc0, ndc1, ndc2, area, px_ndc + dx_ndc);
    vec3 bary_dy = compute_bary(c0, c1, c2, ndc0, ndc1, ndc2, area, px_ndc + dy_ndc);

    vec3 world_pos = w0_4.xyz * bary.x + w1_4.xyz * bary.y + w2_4.xyz * bary.z;
    vec3 world_x = w0_4.xyz * bary_dx.x + w1_4.xyz * bary_dx.y + w2_4.xyz * bary_dx.z;
    vec3 world_y = w0_4.xyz * bary_dy.x + w1_4.xyz * bary_dy.y + w2_4.xyz * bary_dy.z;

    vec4 col0 = vec4(verts[v0b + 3u], verts[v0b + 4u], verts[v0b + 5u], verts[v0b + 6u]);
    vec4 col1 = vec4(verts[v1b + 3u], verts[v1b + 4u], verts[v1b + 5u], verts[v1b + 6u]);
    vec4 col2 = vec4(verts[v2b + 3u], verts[v2b + 4u], verts[v2b + 5u], verts[v2b + 6u]);
    vec4 vcol = col0 * bary.x + col1 * bary.y + col2 * bary.z;

    vec3 ln0 = vec3(verts[v0b + 7u], verts[v0b + 8u], verts[v0b + 9u]);
    vec3 ln1 = vec3(verts[v1b + 7u], verts[v1b + 8u], verts[v1b + 9u]);
    vec3 ln2 = vec3(verts[v2b + 7u], verts[v2b + 8u], verts[v2b + 9u]);
    vec3 local_n = unit_safe(ln0 * bary.x + ln1 * bary.y + ln2 * bary.z);
    if (dot(local_n, local_n) == 0.0) local_n = unit_safe(cross(lp1 - lp0, lp2 - lp0));
    vec3 wn = unit_safe((inst.normals * vec4(local_n, 0.0)).xyz);
    vec3 to_eye = unit_safe(u.eye_exposure.xyz - world_pos);
    if (dot(wn, to_eye) < 0.0) wn = -wn;

    vec2 uv0 = vec2(verts[v0b + 10u], verts[v0b + 11u]);
    vec2 uv1 = vec2(verts[v1b + 10u], verts[v1b + 11u]);
    vec2 uv2 = vec2(verts[v2b + 10u], verts[v2b + 11u]);
    vec2 uv_c = uv0 * bary.x + uv1 * bary.y + uv2 * bary.z;
    vec2 uv_x = uv0 * bary_dx.x + uv1 * bary_dx.y + uv2 * bary_dx.z;
    vec2 uv_y = uv0 * bary_dy.x + uv1 * bary_dy.y + uv2 * bary_dy.z;
    vec2 sample_uv = inst.uv_rect.xy + uv_c * inst.uv_rect.zw;
    vec2 grad_x = (uv_x - uv_c) * inst.uv_rect.zw;
    vec2 grad_y = (uv_y - uv_c) * inst.uv_rect.zw;

    vec3 base = clamp(inst.base_metallic.rgb * vcol.rgb, 0.0, 1.0);
    int tex_slot = int(inst.scale_info.y + 0.5);
    if (tex_slot >= 1 && tex_slot <= 4) base *= sample_albedo_grad(tex_slot, sample_uv, grad_x, grad_y).rgb;

    float metallic = clamp(inst.base_metallic.w, 0.0, 1.0);
    float roughness = clamp(inst.emission_roughness.w, 0.045, 1.0);
    vec3 emission = max(inst.emission_roughness.rgb, 0.0);

    float shadow_vis = eval_vis_shadow(world_pos, world_x, world_y, wn);
    uint shadow_lid = uint(u.s.shadow_filter.z + 0.5);

    uint gx = max(uint(u.grid_mode.x), 1u), gy = max(uint(u.grid_mode.y), 1u), gz = max(uint(u.grid_mode.z), 1u);
    uint total_clusters = gx * gy * gz;
    vec3 direct = vec3(0.0);

    if (u.ambient_count.w > 0.5) {
        uint dir_count = min(cluster_counts[total_clusters], MAX_LIGHTS_PER_CLUSTER);
        for (uint di = 0u; di < dir_count; ++di) {
            uint lid = cluster_indices[total_clusters * MAX_LIGHTS_PER_CLUSTER + di];
            float vis = (u.s.shadow_filter.w > 0.5 && lid == shadow_lid) ? shadow_vis : 1.0;
            direct += source_direct(base, metallic, roughness, wn, world_pos, u.eye_exposure.xyz, lights[lid]) * vis;
        }
        float view_depth = -(u.view * vec4(world_pos, 1.0)).z;
        uint cx = min(uint((float(gid.x) + 0.5) * inv_wh.x * float(gx)), gx - 1u);
        uint cy = min(uint((float(gid.y) + 0.5) * inv_wh.y * float(gy)), gy - 1u);
        float zn = u.screen_depth.z, zf = u.screen_depth.w, z_clamped = clamp(view_depth, zn, zf);
        float z_norm = (u.grid_mode.w < 0.5) ? clamp(log(max(z_clamped, zn) / zn) / max(u.log_info.x, 1e-6), 0.0, 0.999999)
            : clamp((z_clamped - zn) / max(zf - zn, 1e-6), 0.0, 0.999999);
        uint cz = min(uint(z_norm * float(gz)), gz - 1u), cid = (cz * gy + cy) * gx + cx;
        uint lcount = min(cluster_counts[cid], MAX_LIGHTS_PER_CLUSTER), list_base = cid * MAX_LIGHTS_PER_CLUSTER;
        for (uint i = 0u; i < lcount; ++i) {
            uint lid = cluster_indices[list_base + i];
            float vis = (u.s.shadow_filter.w > 0.5 && lid == shadow_lid) ? shadow_vis : 1.0;
            direct += source_direct(base, metallic, roughness, wn, world_pos, u.eye_exposure.xyz, lights[lid]) * vis;
        }
    }

    vec3 irr = u.ambient_count.xyz;
    if (u.log_info.y > 0.5) irr += sample_irradiance(world_pos, wn) * u.log_info.z;

    float nv = clamp(dot(wn, to_eye), 0.001, 0.999);
    vec3 f0 = mix(vec3(0.04), base, metallic);
    vec3 ks_ibl = f0 + (max(vec3(1.0 - roughness), f0) - f0) * pow(1.0 - nv, 5.0);
    float m4 = metallic * metallic;
    vec3 kd_ibl = (u.irr_dims.y > 0.5) ? ((vec3(1.0) - ks_ibl) * (1.0 - metallic)) : vec3(1.0 - m4 * m4);
    vec3 specular_ibl = vec3(0.0);
    if (u.irr_dims.y > 0.5) {
        vec3 r_vec = unit_safe(reflect(-to_eye, wn));
        float u_eq = atan(r_vec.z, r_vec.x) * (0.5 / 3.14159265359) + 0.5;
        float v_eq = acos(clamp(r_vec.y, -1.0, 1.0)) / 3.14159265359;
        float lod = clamp(roughness * 4.0, 0.0, 4.0);
        vec3 prefiltered = textureLod(ibl_env, vec2(u_eq, v_eq), lod).rgb;
        vec2 env_brdf = textureLod(ibl_brdf, vec2(nv, roughness), 0.0).rg;
        specular_ibl = prefiltered * (f0 * env_brdf.x + env_brdf.y) * u.log_info.w;
    }

    vec3 hdr_rgb = max(direct + irr * base * kd_ibl + specular_ibl + emission, 0.0);
    imageStore(out_hdr, ivec2(gid), vec4(hdr_rgb, 1.0));
    imageStore(out_norm_rough, ivec2(gid), vec4(wn, roughness));
}
