#include <metal_stdlib>
using namespace metal;

struct FragIn {
    float4 position [[position]];
    uint meshlet_id [[flat]];
};

fragment uint main0(
    FragIn in [[stage_in]],
    uint prim_id [[primitive_id]]
) {
    // 0 is reserved for cleared sky/background pixels.
    // Encode upper 24 bits as meshlet_id and low 8 bits as local primitive_id (max 124 tris <= 255).
    return (((in.meshlet_id & 0xFFFFFFu) << 8u) | (prim_id & 0xFFu)) + 1u;
}
