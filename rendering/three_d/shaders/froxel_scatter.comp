#version 450

struct LightGpu { vec4 position_kind; vec4 direction_range; vec4 radiance_inner; vec4 cone; };

layout(set = 2, binding = 0, std140) uniform FroxelScatterParams {
    mat4 inv_vp;
    vec4 eye_time;
    vec4 cam_fwd_count;
    vec4 grid_near;
    vec4 fog_far_dens;
    vec4 fog_phase_ext;
    vec4 fog_albedo_scat;
    vec4 fog_ambient_lboost;
    vec4 sun_dir_en;
    vec4 sun_rad_boost;
    vec4 wind_vel_pad;
    vec4 pad0;
} p;

layout(set = 0, binding = 0, std430) readonly buffer LightsBuf { LightGpu lights[]; };
layout(set = 1, binding = 0, std430) writeonly buffer ScatterBuf { vec4 froxel_scatter[]; };

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

float hg_phase(float cos_theta, float g) {
    float g2 = g * g;
    float denom = max(1.0 + g2 - 2.0 * g * cos_theta, 1e-4);
    return (1.0 - g2) / (4.0 * 3.14159265359 * pow(denom, 1.5));
}

float hash31(vec3 pt) {
    pt = fract(pt * 0.1031);
    pt += dot(pt, pt.yzx + 33.33);
    return fract((pt.x + pt.y) * pt.z);
}

float noise3d(vec3 x) {
    vec3 i = floor(x), f = fract(x);
    f = f * f * (3.0 - 2.0 * f);
    return mix(
        mix(mix(hash31(i + vec3(0,0,0)), hash31(i + vec3(1,0,0)), f.x),
            mix(hash31(i + vec3(0,1,0)), hash31(i + vec3(1,1,0)), f.x), f.y),
        mix(mix(hash31(i + vec3(0,0,1)), hash31(i + vec3(1,0,1)), f.x),
            mix(hash31(i + vec3(0,1,1)), hash31(i + vec3(1,1,1)), f.x), f.y),
        f.z
    );
}

void main() {
    uint gid = gl_GlobalInvocationID.x;
    uint fx_n = uint(p.grid_near.x), fy_n = uint(p.grid_near.y), fz_n = uint(p.grid_near.z);
    uint total = fx_n * fy_n * fz_n;
    if (gid >= total) return;

    if (p.sun_dir_en.w < 0.5) {
        froxel_scatter[gid] = vec4(0.0);
        return;
    }

    uint slice_xy = fx_n * fy_n;
    uint fz = gid / slice_xy, rem = gid - fz * slice_xy, fy = rem / fx_n, fx = rem - fy * fx_n;

    vec2 uv = vec2((float(fx) + 0.5) / float(fx_n), (float(fy) + 0.5) / float(fy_n));
    float ndc_x = uv.x * 2.0 - 1.0, ndc_y = 1.0 - uv.y * 2.0;
    vec4 far4 = p.inv_vp * vec4(ndc_x, ndc_y, 0.001, 1.0);
    vec3 far_p = far4.xyz / max(far4.w, 1e-6);
    vec3 eye = p.eye_time.xyz, ray_dir = normalize(far_p - eye), cam_fwd = normalize(p.cam_fwd_count.xyz);
    float cos_ang = max(dot(ray_dir, cam_fwd), 0.1);

    float fog_near = p.grid_near.w, fog_far = p.fog_far_dens.x, ratio = fog_far / max(fog_near, 1e-4);
    float z0 = fog_near * pow(ratio, float(fz) / float(fz_n)), z1 = fog_near * pow(ratio, float(fz + 1u) / float(fz_n));
    vec3 world_pos = eye + ray_dir * (0.5 * (z0 + z1) / cos_ang);

    float h_above = max(world_pos.y - p.fog_far_dens.w, 0.0);
    float dens = p.fog_far_dens.y * exp(-h_above * p.fog_far_dens.z);
    if (p.fog_phase_ext.z > 0.0) {
        vec3 sample_p = (world_pos + p.wind_vel_pad.xyz * p.eye_time.w) * p.fog_phase_ext.w;
        dens *= max(0.0, mix(1.0, 0.35 + 1.3 * noise3d(sample_p), p.fog_phase_ext.z));
    }

    float g = p.fog_phase_ext.x;
    vec3 albedo = p.fog_albedo_scat.rgb, sun_dir = normalize(p.sun_dir_en.xyz);
    float sun_phase = hg_phase(dot(ray_dir, sun_dir), g);
    vec3 in_scatter = p.fog_ambient_lboost.rgb * albedo + p.sun_rad_boost.rgb * albedo * sun_phase * p.sun_rad_boost.w;

    uint lcount = min(uint(p.cam_fwd_count.w), 64u);
    float lboost = p.fog_ambient_lboost.w;
    if (lboost > 0.0) {
        for (uint li = 0u; li < lcount; ++li) {
            LightGpu src = lights[li];
            if (src.position_kind.w < 0.5) continue;
            vec3 delta = src.position_kind.xyz - world_pos;
            float d2 = dot(delta, delta), r2 = src.direction_range.w * src.direction_range.w;
            if (d2 >= r2) continue;
            vec3 ldir = delta / sqrt(max(d2, 1e-6));
            float rel2 = d2 / r2, edge = max(0.0, 1.0 - rel2 * rel2);
            float atten = edge * edge / max(d2, 0.25);
            if (src.position_kind.w > 1.5) {
                float cos_a = dot(src.direction_range.xyz, -ldir);
                float sp = clamp((cos_a - src.cone.x) / max(src.radiance_inner.w - src.cone.x, 1e-6), 0.0, 1.0);
                atten *= sp * sp * (3.0 - 2.0 * sp);
            }
            float lphase = hg_phase(dot(ray_dir, ldir), g * 0.65);
            in_scatter += src.radiance_inner.xyz * atten * albedo * lphase * lboost;
        }
    }

    vec3 scat = in_scatter * (dens * p.fog_albedo_scat.w);
    float ext = dens * p.fog_phase_ext.y;
    froxel_scatter[gid] = vec4(max(scat, vec3(0.0)), max(ext, 0.0));
}
