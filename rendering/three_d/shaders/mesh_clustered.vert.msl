#include <metal_stdlib>
using namespace metal;

struct Matrices {
    float4x4 mvp;
    float4x4 model;
    float4x4 normals;
    float4x4 view;
};

struct VertexIn {
    float3 position [[attribute(0)]];
    float4 color [[attribute(1)]];
    float3 normal [[attribute(2)]];
    float2 uv [[attribute(3)]];
    float4 tangent [[attribute(4)]];
};

struct VertexOut {
    float4 position [[position]];
    float4 vertex_color;
    float3 world;
    float3 world_normal;
    float2 texture_uv;
    float3 world_tangent;
    float3 world_bitangent;
    float view_depth;
};

vertex VertexOut main0(VertexIn in [[stage_in]], constant Matrices& m [[buffer(0)]]) {
    VertexOut out;
    out.texture_uv = in.uv;
    out.position = m.mvp * float4(in.position, 1.0);
    out.vertex_color = in.color;
    float4 world4 = m.model * float4(in.position, 1.0);
    out.world = world4.xyz;
    out.world_tangent = (m.model * float4(in.tangent.xyz, 0.0)).xyz;
    out.world_bitangent = (m.model * float4(cross(in.normal, in.tangent.xyz) * in.tangent.w, 0.0)).xyz;
    out.world_normal = (m.normals * float4(in.normal, 0.0)).xyz;
    out.view_depth = -(m.view * float4(world4.xyz, 1.0)).z;
    return out;
}
