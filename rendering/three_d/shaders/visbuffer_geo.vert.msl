#include <metal_stdlib>
using namespace metal;

struct ViewUniform {
    float4x4 view_proj;
    float4x4 view;
};

struct MeshletGpu {
    float4 bound_sphere;
    float4 cone;
    uint4 info; // x=instance_id, y=first_index, z=index_count, w=pad
};

struct MeshletInstanceGpu {
    float4x4 model;
    float4x4 normals;
    float4 scale_info;
    float4 base_metallic;
    float4 emission_roughness;
    float4 maps_normal;
    float4 surface;
    float4 uv_rect;
};

struct VertexIn {
    float3 position [[attribute(0)]];
    float4 color [[attribute(1)]];
    float3 normal [[attribute(2)]];
    float2 uv [[attribute(3)]];
    float4 tangent [[attribute(4)]];
};

struct VertexOut {
    float4 position [[position]];
    uint meshlet_id [[flat]];
};

vertex VertexOut main0(
    VertexIn in [[stage_in]],
    constant ViewUniform& u [[buffer(0)]],
    device const MeshletGpu* meshlets [[buffer(1)]],
    device const MeshletInstanceGpu* instances [[buffer(2)]],
    uint iid [[instance_id]]
) {
    MeshletGpu m = meshlets[iid];
    MeshletInstanceGpu inst = instances[m.info.x];
    VertexOut out;
    out.position = u.view_proj * (inst.model * float4(in.position, 1.0));
    out.meshlet_id = iid;
    return out;
}
