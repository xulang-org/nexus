#include <metal_stdlib>
using namespace metal;
struct Input { float3 position [[attribute(0)]]; float4 color [[attribute(1)]]; float3 normal [[attribute(2)]]; float2 uv [[attribute(3)]]; float4 tangent [[attribute(4)]]; };
struct Output { float4 position [[position]]; float4 color; float3 world; float3 normal; float2 uv; float3 tangent; float3 bitangent; };
struct Matrices { float4x4 mvp; float4x4 model; float4x4 normals; };
vertex Output main0(Input input [[stage_in]], constant Matrices& matrices [[buffer(0)]]) {
    Output output;
    output.position = matrices.mvp * float4(input.position, 1.0);
    output.color = input.color; output.uv = input.uv;
    output.world = (matrices.model * float4(input.position, 1.0)).xyz;
    output.normal = (matrices.normals * float4(input.normal, 0.0)).xyz;
    output.tangent = (matrices.model * float4(input.tangent.xyz, 0.0)).xyz;
    output.bitangent = (matrices.model * float4(cross(input.normal, input.tangent.xyz) * input.tangent.w, 0.0)).xyz;
    return output;
}
