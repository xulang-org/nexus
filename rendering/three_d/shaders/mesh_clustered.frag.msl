#include <metal_stdlib>
using namespace metal;

constant uint MAX_LIGHTS_PER_CLUSTER = 64u;

struct LightGpu {
    float4 position_kind;
    float4 direction_range;
    float4 radiance_inner;
    float4 cone;
};

struct Material {
    float4 base_metallic;
    float4 emission_roughness;
    float4 maps_normal;
    float4 surface;
    float4 uv_rect;
};

struct ClusteredLighting {
    float4 ambient_count; // rgb, light_count
    float4 eye_exposure;  // xyz, exposure
    float4 screen_depth;  // w, h, z_near, z_far
    float4 grid_mode;     // cx, cy, cz, slice_mode
    float4 log_info;      // log(z_far/z_near), 0, 0, 0
};

struct Shadow {
    float4x4 mvp[4];
    float4 direction_bias;
    float4 shadow_filter;
    float4 depth;
    float4 camera_depth;
    float4 ranges[4];
    float4 limits;
    float4 gradient_scales;
};

struct FragIn {
    float4 position [[position]];
    float4 vertex_color;
    float3 world;
    float3 world_normal;
    float2 texture_uv;
    float3 world_tangent;
    float3 world_bitangent;
    float view_depth;
};

static inline float3 unit_safe(float3 value) {
    float largest = max(abs(value.x), max(abs(value.y), abs(value.z)));
    if (!isfinite(largest) || largest == 0.0) return float3(0.0, 0.0, 0.0);
    float3 scaled = value / largest;
    return scaled / sqrt(dot(scaled, scaled));
}

static inline float srgb_channel(float value) {
    return value <= 0.0031308 ? 12.92 * value : 1.055 * pow(value, 1.0 / 2.4) - 0.055;
}

static inline float3 material_direct(float3 base, float metallic, float roughness,
    float3 normal, float3 position, float3 eye, float3 light, float3 radiance) {
    float3 n = unit_safe(normal), v = unit_safe(eye - position), l = unit_safe(light), h = unit_safe(v + l);
    float nv = max(dot(n, v), 0.0001), nl = max(dot(n, l), 0.0);
    float nh = max(dot(n, h), 0.0), vh = clamp(dot(v, h), 0.0, 1.0);
    float alpha = roughness * roughness, a2 = alpha * alpha;
    float denominator = (nh * a2 - nh) * nh + 1.0;
    float distribution = a2 / (3.14159265359 * max(denominator * denominator, 1e-12));
    float visibility = 0.5 / max(nl * sqrt(nv * nv * (1.0 - a2) + a2) +
        nv * sqrt(nl * nl * (1.0 - a2) + a2), 0.000001);
    float3 f0 = mix(float3(0.04, 0.04, 0.04), base, metallic);
    float factor = pow(1.0 - vh, 5.0);
    float3 fresnel = f0 + (float3(1.0, 1.0, 1.0) - f0) * factor;
    float3 diffuse = (float3(1.0, 1.0, 1.0) - fresnel) * (1.0 - metallic) * base / 3.14159265359;
    return (diffuse + distribution * visibility * fresnel) * radiance * nl;
}

static inline float3 source_direct(float3 base, float metallic, float roughness,
    float3 normal, float3 position, float3 eye, LightGpu src) {
    float3 light = src.direction_range.xyz;
    float attenuation = 1.0;
    if (src.position_kind.w > 0.5) {
        float3 delta = src.position_kind.xyz - position;
        float distance2 = dot(delta, delta), radius2 = src.direction_range.w * src.direction_range.w;
        if (distance2 < 1e-12 || distance2 >= radius2) return float3(0.0, 0.0, 0.0);
        light = delta / sqrt(distance2);
        float relative2 = distance2 / radius2;
        float edge = max(0.0, 1.0 - relative2 * relative2);
        attenuation = edge * edge / max(distance2, 0.0001);
        if (src.position_kind.w > 1.5) {
            float cosine = dot(src.direction_range.xyz, -light);
            float transition = clamp((cosine - src.cone.x) / max(src.radiance_inner.w - src.cone.x, 0.000001), 0.0, 1.0);
            attenuation *= transition * transition * (3.0 - 2.0 * transition);
        }
    }
    return material_direct(base, metallic, roughness, normal, position, eye, light, src.radiance_inner.xyz * attenuation);
}

static inline float3 finish_lighting(float3 linear_color, float exposure) {
    float3 exposed = max(linear_color * exposure, float3(0.0, 0.0, 0.0));
    float3 mapped = exposed / (float3(1.0, 1.0, 1.0) + exposed);
    return float3(srgb_channel(mapped.x), srgb_channel(mapped.y), srgb_channel(mapped.z));
}

static inline float3 normal_map_direction(float3 normal, float3 tangent, float3 bitangent,
    float3 texel, float scale) {
    float3 n = unit_safe(normal);
    if (scale == 0.0) return n;
    float3 t = unit_safe(tangent);
    t = unit_safe(t - n * dot(n, t));
    float3 b = unit_safe(cross(n, t));
    if (dot(b, unit_safe(bitangent)) < 0.0) b = -b;
    float3 mapped = texel * 2.0 - float3(1.0, 1.0, 1.0);
    mapped.x *= scale; mapped.y *= scale;
    mapped = unit_safe(mapped);
    float3 result = unit_safe(t * mapped.x + b * mapped.y + n * mapped.z);
    if (dot(result, result) == 0.0) return n;
    return result;
}

static inline int point_shadow_face(float3 d) {
    float3 a = abs(d);
    if (a.x >= a.y && a.x >= a.z) return d.x >= 0.0 ? 0 : 1;
    if (a.y >= a.z) return d.y >= 0.0 ? 2 : 3;
    return d.z >= 0.0 ? 4 : 5;
}

static inline float2 point_shadow_uv(float3 d, int face) {
    float2 p;
    if (face == 0) p = float2(d.z, d.y) / abs(d.x);
    else if (face == 1) p = float2(-d.z, d.y) / abs(d.x);
    else if (face == 2) p = float2(d.x, d.z) / abs(d.y);
    else if (face == 3) p = float2(-d.x, d.z) / abs(d.y);
    else if (face == 4) p = float2(-d.x, d.y) / abs(d.z);
    else p = float2(d.x, d.y) / abs(d.z);
    return p * float2(0.5, -0.5) + float2(0.5, 0.5);
}

static inline float3 point_shadow_ray(float2 uv, int face) {
    float2 p = uv * float2(2.0, -2.0) + float2(-1.0, 1.0);
    if (face == 0) return float3(1.0, p.y, p.x);
    if (face == 1) return float3(-1.0, p.y, -p.x);
    if (face == 2) return float3(p.x, 1.0, p.y);
    if (face == 3) return float3(-p.x, -1.0, p.y);
    if (face == 4) return float3(-p.x, p.y, 1.0);
    return float3(p.x, p.y, -1.0);
}

static inline float point_shadow_visibility(float3 world, float3 normal,
    float4 light_bias, float4 shadow_filter, float4 depth,
    texture2d<float> shadow_texture, sampler shadow_sampler) {
    float3 n = unit_safe(cross(dfdx(world), dfdy(world)));
    if (dot(n, n) == 0.0) n = unit_safe(normal);
    float3 delta = world - light_bias.xyz;
    float major = max(abs(delta.x), max(abs(delta.y), abs(delta.z)));
    float receiver_z = depth.x / max(major, 0.000001) - depth.y;
    if (major <= 0.000001 || receiver_z < 0.0 || receiver_z > 1.0) return 1.0;
    int face = point_shadow_face(delta);
    float2 uv = point_shadow_uv(delta, face);
    float plane_distance = dot(n, delta);
    float bias = light_bias.w + shadow_filter.y * (1.0 - max(0.0, dot(unit_safe(normal), unit_safe(-delta))));
    float visibility = 0.0;
    float weight_sum = 0.0;
    for (int y = -1; y <= 1; ++y) {
        for (int x = -1; x <= 1; ++x) {
            float2 tap = (floor(uv / shadow_filter.x) + float2(float(x), float(y)) + float2(0.5, 0.5)) * shadow_filter.x;
            float2 distance_in_texels = tap / shadow_filter.x - uv / shadow_filter.x;
            float2 weights = max(float2(1.5, 1.5) - abs(distance_in_texels), float2(0.0, 0.0));
            float weight = weights.x * weights.y;
            weight_sum += weight;
            if (weight <= 0.0) continue;
            float3 ray = point_shadow_ray(tap, face);
            int adjacent = point_shadow_face(ray);
            float2 at = (clamp(floor(point_shadow_uv(ray, adjacent) / shadow_filter.x), float2(0.0, 0.0), float2(1.0 / shadow_filter.x - 1.0, 1.0 / shadow_filter.x - 1.0)) + float2(0.5, 0.5)) * shadow_filter.x;
            ray = point_shadow_ray(at, adjacent);
            float denominator = dot(n, ray);
            if (abs(denominator) <= 0.000001) { visibility += weight; continue; }
            float distance = plane_distance / denominator;
            if (distance <= 0.0) { visibility += weight; continue; }
            float reference = depth.x / distance - depth.y;
            if (reference < 0.0 || reference > 1.0) { visibility += weight; continue; }
            float2 atlas = (at + float2(float(adjacent % 3), float(adjacent / 3))) / depth.zw;
            visibility += (reference + bias >= shadow_texture.sample(shadow_sampler, atlas, level(0.0)).r ? 1.0 : 0.0) * weight;
        }
    }
    return visibility / weight_sum;
}

static inline float2 cascade_gradient(float3 p) {
    float3 n = unit_safe(cross(dfdx(p), dfdy(p)));
    if (abs(n.z) <= 0.00001) return float2(0.0, 0.0);
    return float2(-2.0 * n.x, 2.0 * n.y) / n.z;
}

static inline float cascade_sample(float3 p, float2 gradient, int layer, float bias,
    float texel, float2 atlas_size, float raster_bias,
    texture2d<float> shadow_texture, sampler shadow_sampler) {
    if (p.x < -1.0 || p.x > 1.0 || p.y < -1.0 || p.y > 1.0 || p.z < 0.0 || p.z > 1.0) return 1.0;
    bias += max(abs(gradient.x), abs(gradient.y)) * texel * raster_bias;
    float2 uv = float2(p.x * 0.5 + 0.5, 0.5 - p.y * 0.5);
    float visible = 0.0, total = 0.0;
    for (int y = -1; y <= 1; ++y) {
        for (int x = -1; x <= 1; ++x) {
            float2 at = (floor(uv / texel) + float2(float(x), float(y)) + float2(0.5, 0.5)) * texel;
            float2 weights = max(float2(1.5, 1.5) - abs((at - uv) / texel), float2(0.0, 0.0));
            float weight = weights.x * weights.y;
            total += weight;
            if (weight <= 0.0) continue;
            if (at.x < 0.0 || at.x > 1.0 || at.y < 0.0 || at.y > 1.0) { visible += weight; continue; }
            float2 atlas = (at + float2(float(layer % 2), float(layer / 2))) / atlas_size;
            visible += (p.z + dot(gradient, at - uv) + bias >= shadow_texture.sample(shadow_sampler, atlas, level(0.0)).r ? 1.0 : 0.0) * weight;
        }
    }
    return visible / total;
}

static inline float cascade_shadow_visibility(float3 world, float3 normal, constant Shadow& s,
    texture2d<float> shadow_texture, sampler shadow_sampler) {
    float3 p0 = (s.mvp[0] * float4(world, 1.0)).xyz;
    float3 p1 = (s.mvp[1] * float4(world, 1.0)).xyz;
    float3 p2 = (s.mvp[2] * float4(world, 1.0)).xyz;
    float3 p3 = (s.mvp[3] * float4(world, 1.0)).xyz;
    float2 g0 = cascade_gradient(p0);
    float2 g1 = g0 * s.gradient_scales.y, g2 = g0 * s.gradient_scales.z, g3 = g0 * s.gradient_scales.w;
    float distance = dot(s.camera_depth, float4(world, 1.0));
    if (distance < s.limits.x || distance > s.limits.y) return 1.0;
    int layer = 0;
    if (distance > s.ranges[0].y && s.limits.z > 1.5) layer = 1;
    if (distance > s.ranges[1].y && s.limits.z > 2.5) layer = 2;
    if (distance > s.ranges[2].y && s.limits.z > 3.5) layer = 3;
    float3 p = p0; float2 g = g0; float4 range = s.ranges[0];
    float3 next_p = p1; float2 next_g = g1; float4 next_range = s.ranges[1];
    if (layer == 1) { p = p1; g = g1; range = s.ranges[1]; next_p = p2; next_g = g2; next_range = s.ranges[2]; }
    if (layer == 2) { p = p2; g = g2; range = s.ranges[2]; next_p = p3; next_g = g3; next_range = s.ranges[3]; }
    if (layer == 3) { p = p3; g = g3; range = s.ranges[3]; }
    float bias = s.direction_bias.w + s.shadow_filter.y * (1.0 - max(0.0, dot(unit_safe(normal), s.direction_bias.xyz)));
    float current = cascade_sample(p, g, layer, bias * range.w, s.shadow_filter.x, s.depth.zw, s.limits.w, shadow_texture, shadow_sampler);
    if (range.y > range.z && distance > range.z) {
        float next = 1.0;
        if (float(layer + 1) < s.limits.z) next = cascade_sample(next_p, next_g, layer + 1, bias * next_range.w, s.shadow_filter.x, s.depth.zw, s.limits.w, shadow_texture, shadow_sampler);
        float alpha = clamp((distance - range.z) / (range.y - range.z), 0.0, 1.0);
        alpha = alpha * alpha * (3.0 - 2.0 * alpha);
        current = mix(current, next, alpha);
    }
    return current;
}

static inline float shadow_visibility(float3 world, float3 normal, constant Shadow& s,
    texture2d<float> shadow_texture, sampler shadow_sampler) {
    if (s.shadow_filter.w > 2.5) return point_shadow_visibility(world, normal, s.direction_bias, s.shadow_filter, s.depth, shadow_texture, shadow_sampler);
    float4 projected = s.mvp[0] * float4(world, 1.0);
    float3 p = projected.xyz / max(projected.w, 0.000001);
    float3 n = unit_safe(cross(dfdx(p), dfdy(p)));
    float2 gradient = float2(0.0, 0.0);
    if (abs(n.z) > 0.00001) gradient = float2(-2.0 * n.x, 2.0 * n.y) / n.z;
    if (projected.w <= 0.000001 || p.x < -1.0 || p.x > 1.0 || p.y < -1.0 || p.y > 1.0 || p.z < 0.0 || p.z > 1.0) return 1.0;
    float2 uv = float2(p.x * 0.5 + 0.5, 0.5 - p.y * 0.5);
    float3 toward_light = s.direction_bias.xyz;
    if (s.shadow_filter.w > 1.5) toward_light = unit_safe(s.direction_bias.xyz - world);
    float bias = s.direction_bias.w + s.shadow_filter.y * (1.0 - max(0.0, dot(unit_safe(normal), toward_light)));
    float visibility = 0.0;
    for (int y = -1; y <= 1; ++y) {
        for (int x = -1; x <= 1; ++x) {
            float2 at = (floor(uv / s.shadow_filter.x) + float2(float(x), float(y)) + float2(0.5, 0.5)) * s.shadow_filter.x;
            if (at.x < 0.0 || at.x > 1.0 || at.y < 0.0 || at.y > 1.0) visibility += 1.0;
            else visibility += (p.z + dot(gradient, at - uv) + bias >= shadow_texture.sample(shadow_sampler, at, level(0.0)).r) ? 1.0 : 0.0;
        }
    }
    return visibility / 9.0;
}

fragment float4 main0(
    FragIn in [[stage_in]],
    bool is_front [[front_facing]],
    texture2d<float> base_texture [[texture(0)]],
    texture2d<float> orm_texture [[texture(1)]],
    texture2d<float> emission_texture [[texture(2)]],
    texture2d<float> normal_texture [[texture(3)]],
    texture2d<float> occlusion_texture [[texture(4)]],
    texture2d<float> shadow_texture [[texture(5)]],
    sampler base_sampler [[sampler(0)]],
    sampler orm_sampler [[sampler(1)]],
    sampler emission_sampler [[sampler(2)]],
    sampler normal_sampler [[sampler(3)]],
    sampler occlusion_sampler [[sampler(4)]],
    sampler shadow_sampler [[sampler(5)]],
    constant Material& p [[buffer(0)]],
    constant ClusteredLighting& l [[buffer(1)]],
    constant Shadow& s [[buffer(2)]],
    device const LightGpu* lights [[buffer(3)]],
    device const uint* cluster_counts [[buffer(4)]],
    device const uint* cluster_indices [[buffer(5)]]
) {
    if (p.surface.z < 0.5) return in.vertex_color;
    int mask = int(p.maps_normal.x);
    float2 sample_uv = p.uv_rect.xy + in.texture_uv * p.uv_rect.zw;
    float3 base = p.base_metallic.xyz * in.vertex_color.xyz;
    float alpha = in.vertex_color.a;
    if ((mask & 1) != 0) {
        float4 base_texel = base_texture.sample(base_sampler, sample_uv);
        base *= base_texel.rgb;
        alpha *= base_texel.a;
    }
    if (p.surface.w > 0.0 && alpha < p.surface.w) discard_fragment();
    if (p.surface.z > 1.5) {
        float3 clamped = clamp(base, float3(0.0, 0.0, 0.0), float3(1.0, 1.0, 1.0));
        return float4(srgb_channel(clamped.x), srgb_channel(clamped.y), srgb_channel(clamped.z), 1.0);
    }
    float3 orm = float3(1.0, 1.0, 1.0);
    if ((mask & 2) != 0) orm = orm_texture.sample(orm_sampler, sample_uv).rgb;
    float ao_strength = p.maps_normal.y;
    if ((mask & 16) != 0) {
        orm.x = occlusion_texture.sample(occlusion_sampler, sample_uv).r;
        ao_strength = p.surface.y;
    }
    float3 emission = p.emission_roughness.xyz;
    if ((mask & 4) != 0) emission *= emission_texture.sample(emission_sampler, sample_uv).rgb;
    float3 shading_normal = in.world_normal;
    if ((mask & 8) != 0) {
        float3 adj_tangent = p.uv_rect.z < 0.0 ? -in.world_tangent : in.world_tangent;
        float3 adj_bitangent = p.uv_rect.w < 0.0 ? -in.world_bitangent : in.world_bitangent;
        shading_normal = normal_map_direction(in.world_normal, adj_tangent, adj_bitangent,
            normal_texture.sample(normal_sampler, sample_uv).rgb, p.maps_normal.z);
    }
    bool surface_front = is_front;
    if (p.surface.x < 0.0) surface_front = !surface_front;
    if (p.maps_normal.w == 1.0 && !surface_front) shading_normal = -shading_normal;
    float metallic = p.base_metallic.w * orm.z;
    float roughness = max(0.045, p.emission_roughness.w * orm.y);
    float occlusion = 1.0 + ao_strength * (orm.x - 1.0);
    float3 linear_color = l.ambient_count.xyz * occlusion * base * (1.0 - metallic) + emission;

    // 1. Directional lights (global slot).
    uint total_clusters = uint(l.grid_mode.x) * uint(l.grid_mode.y) * uint(l.grid_mode.z);
    uint dir_count = min(cluster_counts[total_clusters], MAX_LIGHTS_PER_CLUSTER);
    for (uint di = 0u; di < dir_count; ++di) {
        uint li = cluster_indices[total_clusters * MAX_LIGHTS_PER_CLUSTER + di];
        float visibility = 1.0;
        if (s.shadow_filter.w > 0.5 && li == uint(s.shadow_filter.z)) {
            if (s.shadow_filter.w > 3.5) visibility = cascade_shadow_visibility(in.world, in.world_normal, s, shadow_texture, shadow_sampler);
            else visibility = shadow_visibility(in.world, in.world_normal, s, shadow_texture, shadow_sampler);
        }
        linear_color += source_direct(base, metallic, roughness, shading_normal, in.world, l.eye_exposure.xyz, lights[li]) * visibility;
    }

    // 2. Local clustered punctual lights (point / spot) in cluster (tx, ty, tz).
    uint cx = uint(l.grid_mode.x);
    uint cy = uint(l.grid_mode.y);
    uint cz = uint(l.grid_mode.z);
    uint tx = min(uint(max(0.0, floor(in.position.x / l.screen_depth.x * float(cx)))), cx - 1u);
    uint ty = min(uint(max(0.0, floor(in.position.y / l.screen_depth.y * float(cy)))), cy - 1u);
    float z_near = l.screen_depth.z;
    float z_far = l.screen_depth.w;
    float vd = clamp(in.view_depth, z_near, z_far);
    float norm_z = 0.0;
    if (l.grid_mode.w < 0.5) {
        norm_z = log(vd / z_near) / l.log_info.x;
    } else {
        norm_z = (vd - z_near) / max(z_far - z_near, 1e-6);
    }
    uint tz = min(uint(max(0.0, floor(norm_z * float(cz)))), cz - 1u);
    uint cid = (tz * cy + ty) * cx + tx;

    uint local_count = min(cluster_counts[cid], MAX_LIGHTS_PER_CLUSTER);
    uint base_idx = cid * MAX_LIGHTS_PER_CLUSTER;
    for (uint ci = 0u; ci < local_count; ++ci) {
        uint li = cluster_indices[base_idx + ci];
        float visibility = 1.0;
        if (s.shadow_filter.w > 0.5 && li == uint(s.shadow_filter.z)) {
            if (s.shadow_filter.w > 3.5) visibility = cascade_shadow_visibility(in.world, in.world_normal, s, shadow_texture, shadow_sampler);
            else visibility = shadow_visibility(in.world, in.world_normal, s, shadow_texture, shadow_sampler);
        }
        linear_color += source_direct(base, metallic, roughness, shading_normal, in.world, l.eye_exposure.xyz, lights[li]) * visibility;
    }

    return float4(finish_lighting(linear_color, l.eye_exposure.w), 1.0);
}
