#version 450

struct LightGpu { vec4 position_kind; vec4 direction_range; vec4 radiance_inner; vec4 cone; };
struct ProbeShGpu { vec4 dc; vec4 px; vec4 py; vec4 pz; };
struct BvhNodeGpu { vec4 bmin_left; vec4 bmax_right; };
struct RtTriGpu { vec4 v0_mat; vec4 e1_pad; vec4 e2_pad; vec4 n_ds; };
struct RtMatGpu { vec4 albedo_rough; vec4 emission_metal; };

layout(set = 2, binding = 0, std140) uniform DdgiTraceUniform {
    vec4 origin_nx; vec4 spacing_ny; vec4 dims_rays; vec4 counts;
    vec4 sky_color_dir; vec4 ground_color_emi; vec4 rot_row0; vec4 rot_row1;
    vec4 rot_row2; vec4 ambient_pad; vec4 pad0; vec4 pad1;
} u;

layout(set = 0, binding = 0, std430) readonly buffer BvhBuf { BvhNodeGpu bvh_nodes[]; };
layout(set = 0, binding = 1, std430) readonly buffer TriBuf { RtTriGpu rt_tris[]; };
layout(set = 0, binding = 2, std430) readonly buffer MatBuf { RtMatGpu rt_mats[]; };
layout(set = 0, binding = 3, std430) readonly buffer LightBuf { LightGpu lights[]; };
layout(set = 0, binding = 4, std430) readonly buffer PrevProbeBuf { ProbeShGpu prev_probes[]; };
layout(set = 1, binding = 0, std430) writeonly buffer RayResBuf { vec4 ray_results[]; };

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

vec3 fibonacci_dir(uint ray_idx, uint ray_count, vec3 r0, vec3 r1, vec3 r2) {
    float n = max(float(ray_count), 1.0), fi = float(ray_idx) + 0.5, phi = 2.399963229728653 * float(ray_idx);
    float cos_theta = 1.0 - 2.0 * fi / n, sin_theta = sqrt(max(0.0, 1.0 - cos_theta * cos_theta));
    vec3 d = vec3(cos(phi) * sin_theta, cos_theta, sin(phi) * sin_theta);
    return normalize(vec3(dot(r0, d), dot(r1, d), dot(r2, d)));
}

bool intersect_aabb(vec3 ro, vec3 inv_rd, vec3 bmin, vec3 bmax, float t_max, out float out_tmin) {
    vec3 t0 = (bmin - ro) * inv_rd, t1 = (bmax - ro) * inv_rd;
    vec3 tsmaller = min(t0, t1), tbigger = max(t0, t1);
    float tmin = max(0.0, max(tsmaller.x, max(tsmaller.y, tsmaller.z)));
    float tmax = min(t_max, min(tbigger.x, min(tbigger.y, tbigger.z)));
    out_tmin = tmin;
    return tmin <= tmax;
}

bool intersect_tri(vec3 ro, vec3 rd, RtTriGpu tri, float t_min, float t_max, out float out_t) {
    vec3 v0 = tri.v0_mat.xyz, e1 = tri.e1_pad.xyz, e2 = tri.e2_pad.xyz;
    vec3 pvec = cross(rd, e2);
    float det = dot(e1, pvec);
    if (abs(det) < 1e-7) return false;
    float inv_det = 1.0 / det;
    vec3 tvec = ro - v0;
    float u_b = dot(tvec, pvec) * inv_det;
    if (u_b < -1e-5 || u_b > 1.00001) return false;
    vec3 qvec = cross(tvec, e1);
    float v_b = dot(rd, qvec) * inv_det;
    if (v_b < -1e-5 || (u_b + v_b) > 1.00002) return false;
    float t = dot(e2, qvec) * inv_det;
    if (t <= t_min || t >= t_max) return false;
    out_t = t;
    return true;
}

vec3 make_inv_dir(vec3 rd) {
    return vec3(
        abs(rd.x) > 1e-8 ? (1.0 / rd.x) : (rd.x >= 0.0 ? 1e8 : -1e8),
        abs(rd.y) > 1e-8 ? (1.0 / rd.y) : (rd.y >= 0.0 ? 1e8 : -1e8),
        abs(rd.z) > 1e-8 ? (1.0 / rd.z) : (rd.z >= 0.0 ? 1e8 : -1e8)
    );
}

int trace_closest(vec3 ro, vec3 rd, float max_dist, uint node_count, uint tri_count, out float out_t) {
    out_t = max_dist;
    int best_tri = -1;
    if (node_count == 0u || tri_count == 0u) return -1;
    vec3 inv_rd = make_inv_dir(rd);
    uint stack[32];
    int sp = 0;
    stack[sp++] = 0u;
    while (sp > 0) {
        uint ni = stack[--sp];
        if (ni >= node_count) continue;
        BvhNodeGpu node = bvh_nodes[ni];
        float box_t = 0.0;
        if (!intersect_aabb(ro, inv_rd, node.bmin_left.xyz, node.bmax_right.xyz, out_t, box_t)) continue;
        if (node.bmax_right.w > 0.5) {
            uint first = uint(max(0.0, node.bmin_left.w)), end = min(first + uint(node.bmax_right.w), tri_count);
            for (uint ti = first; ti < end; ++ti) {
                float hit_t = 0.0;
                if (intersect_tri(ro, rd, rt_tris[ti], 1e-4, out_t, hit_t)) { out_t = hit_t; best_tri = int(ti); }
            }
        } else {
            uint left = uint(max(0.0, node.bmin_left.w)), right = uint(max(0.0, -node.bmax_right.w));
            float tl = 0.0, tr = 0.0;
            bool hl = (left < node_count) && intersect_aabb(ro, inv_rd, bvh_nodes[left].bmin_left.xyz, bvh_nodes[left].bmax_right.xyz, out_t, tl);
            bool hr = (right < node_count) && intersect_aabb(ro, inv_rd, bvh_nodes[right].bmin_left.xyz, bvh_nodes[right].bmax_right.xyz, out_t, tr);
            if (hl && hr) {
                if (tl < tr) { if (sp < 31) stack[sp++] = right; if (sp < 31) stack[sp++] = left; }
                else { if (sp < 31) stack[sp++] = left; if (sp < 31) stack[sp++] = right; }
            } else if (hl) { if (sp < 31) stack[sp++] = left; }
            else if (hr) { if (sp < 31) stack[sp++] = right; }
        }
    }
    return best_tri;
}

bool trace_any_hit(vec3 ro, vec3 rd, float t_min, float t_max, uint node_count, uint tri_count) {
    if (node_count == 0u || tri_count == 0u || t_max <= t_min) return false;
    vec3 inv_rd = make_inv_dir(rd);
    uint stack[32];
    int sp = 0;
    stack[sp++] = 0u;
    while (sp > 0) {
        uint ni = stack[--sp];
        if (ni >= node_count) continue;
        BvhNodeGpu node = bvh_nodes[ni];
        float box_t = 0.0;
        if (!intersect_aabb(ro, inv_rd, node.bmin_left.xyz, node.bmax_right.xyz, t_max, box_t)) continue;
        if (node.bmax_right.w > 0.5) {
            uint first = uint(max(0.0, node.bmin_left.w)), end = min(first + uint(node.bmax_right.w), tri_count);
            for (uint ti = first; ti < end; ++ti) {
                float hit_t = 0.0;
                if (intersect_tri(ro, rd, rt_tris[ti], t_min, t_max, hit_t)) return true;
            }
        } else {
            uint left = uint(max(0.0, node.bmin_left.w)), right = uint(max(0.0, -node.bmax_right.w));
            if (left < node_count && sp < 31) stack[sp++] = left;
            if (right < node_count && sp < 31) stack[sp++] = right;
        }
    }
    return false;
}

vec3 sample_prev_sh_valid(vec3 wpos, vec3 n) {
    int nx = int(u.origin_nx.w), ny = int(u.spacing_ny.w), nz = int(u.dims_rays.x);
    if (nx <= 0 || ny <= 0 || nz <= 0) return vec3(0.0);
    vec3 rel = (wpos - u.origin_nx.xyz) / max(u.spacing_ny.xyz, vec3(1e-4));
    float fx = clamp(rel.x, 0.0, float(max(nx - 1, 0))), fy = clamp(rel.y, 0.0, float(max(ny - 1, 0))), fz = clamp(rel.z, 0.0, float(max(nz - 1, 0)));
    int x0 = min(int(floor(fx)), max(nx - 1, 0)), y0 = min(int(floor(fy)), max(ny - 1, 0)), z0 = min(int(floor(fz)), max(nz - 1, 0));
    int x1 = min(x0 + 1, max(nx - 1, 0)), y1 = min(y0 + 1, max(ny - 1, 0)), z1 = min(z0 + 1, max(nz - 1, 0));
    float tx = fx - float(x0), ty = fy - float(y0), tz = fz - float(z0);
    vec3 sum_irr = vec3(0.0);
    float sum_w = 0.0;
    for (int dz = 0; dz < 2; ++dz) {
        int iz = (dz == 0) ? z0 : z1; float wz = (dz == 0) ? (1.0 - tz) : tz;
        for (int dy = 0; dy < 2; ++dy) {
            int iy = (dy == 0) ? y0 : y1; float wy = (dy == 0) ? (1.0 - ty) : ty;
            for (int dx = 0; dx < 2; ++dx) {
                int ix = (dx == 0) ? x0 : x1; float wx = (dx == 0) ? (1.0 - tx) : tx;
                ProbeShGpu sh = prev_probes[uint((iz * ny + iy) * nx + ix)];
                if (sh.dc.w < 0.5) continue;
                float w = wx * wy * wz;
                sum_irr += max(sh.dc.xyz + sh.px.xyz * n.x + sh.py.xyz * n.y + sh.pz.xyz * n.z, vec3(0.0)) * w;
                sum_w += w;
            }
        }
    }
    return sum_w > 1e-5 ? (sum_irr / sum_w) : vec3(0.0);
}

void main() {
    uint gid = gl_GlobalInvocationID.x;
    uint nx = uint(u.origin_nx.w), ny = uint(u.spacing_ny.w), nz = uint(u.dims_rays.x);
    uint rays_per_probe = uint(u.dims_rays.y), probe_count = nx * ny * nz, total_rays = probe_count * rays_per_probe;
    if (gid >= total_rays) return;

    uint probe_idx = gid / rays_per_probe, ray_idx = gid - probe_idx * rays_per_probe;
    uint slice_xy = nx * ny, iz = probe_idx / slice_xy, rem = probe_idx - iz * slice_xy, iy = rem / nx, ix = rem - iy * nx;
    vec3 probe_pos = u.origin_nx.xyz + vec3(float(ix), float(iy), float(iz)) * u.spacing_ny.xyz;
    vec3 rd = fibonacci_dir(ray_idx, rays_per_probe, u.rot_row0.xyz, u.rot_row1.xyz, u.rot_row2.xyz);

    uint node_count = uint(u.counts.x), tri_count = uint(u.counts.y);
    float max_dist = u.dims_rays.w, hit_t = max_dist;
    int hit_tri = trace_closest(probe_pos, rd, max_dist, node_count, tri_count, hit_t);
    if (hit_tri < 0) {
        float t_sky = clamp(rd.y * 0.5 + 0.5, 0.0, 1.0);
        ray_results[gid] = vec4(max(mix(u.ground_color_emi.rgb, u.sky_color_dir.rgb, t_sky), vec3(0.0)), max_dist);
        return;
    }

    RtTriGpu tri = rt_tris[uint(hit_tri)];
    vec3 n = tri.n_ds.xyz;
    if (dot(rd, n) > 0.0) {
        if (tri.n_ds.w < 0.5) { ray_results[gid] = vec4(0.0, 0.0, 0.0, -hit_t); return; }
        n = -n;
    }

    RtMatGpu mat = rt_mats[uint(max(0.0, tri.v0_mat.w))];
    vec3 diffuse_albedo = max(mat.albedo_rough.rgb, vec3(0.0)) * (1.0 - clamp(mat.emission_metal.w, 0.0, 1.0));
    vec3 rad = max(mat.emission_metal.rgb, vec3(0.0)) * u.ground_color_emi.w + u.ambient_pad.rgb * diffuse_albedo;

    vec3 hit_p = probe_pos + rd * hit_t;
    float bias = max(u.rot_row1.w, 0.002);
    vec3 shadow_ro = hit_p + n * bias;

    uint lcount = min(uint(u.counts.z), 64u);
    float dir_scale = u.sky_color_dir.w;
    if (dir_scale > 0.0) {
        for (uint li = 0u; li < lcount; ++li) {
            LightGpu src = lights[li];
            vec3 ldir = src.direction_range.xyz;
            float atten = 1.0, shadow_max = max_dist;
            if (src.position_kind.w > 0.5) {
                vec3 delta = src.position_kind.xyz - hit_p;
                float d2 = dot(delta, delta), r2 = src.direction_range.w * src.direction_range.w;
                if (d2 < 1e-10 || d2 >= r2) continue;
                float d = sqrt(d2); ldir = delta / d;
                float rel2 = d2 / r2, edge = max(0.0, 1.0 - rel2 * rel2);
                atten = edge * edge / max(d2, 0.0001);
                if (src.position_kind.w > 1.5) {
                    float cos_a = dot(src.direction_range.xyz, -ldir);
                    float sp = clamp((cos_a - src.cone.x) / max(src.radiance_inner.w - src.cone.x, 1e-6), 0.0, 1.0);
                    atten *= sp * sp * (3.0 - 2.0 * sp);
                }
                shadow_max = max(d - bias * 2.0, 0.002);
            } else ldir = normalize(ldir);
            float nl = max(dot(n, ldir), 0.0);
            if (nl <= 0.0 || trace_any_hit(shadow_ro, ldir, 0.001, shadow_max, node_count, tri_count)) continue;
            rad += (diffuse_albedo / 3.14159265359) * src.radiance_inner.xyz * atten * nl * dir_scale;
        }
    }

    if (u.rot_row0.w > 0.5 && u.counts.w > 0.0) {
        rad += diffuse_albedo * sample_prev_sh_valid(hit_p + n * 0.05, n) * u.counts.w;
    }
    ray_results[gid] = vec4(clamp(rad, vec3(0.0), vec3(32.0)), hit_t);
}
