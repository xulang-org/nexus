#include <metal_stdlib>
using namespace metal;

struct BloomUpParams {
    float4 dims;   // lw, lh, dw, dh
    float4 weight; // blend_weight, 0, 0, 0
};

kernel void main0(
    texture2d<float> src_low [[texture(0)]],
    texture2d<float> src_curr [[texture(1)]],
    texture2d<float, access::write> dst_tex [[texture(2)]],
    sampler s_low [[sampler(0)]],
    sampler s_curr [[sampler(1)]],
    constant BloomUpParams& params [[buffer(0)]],
    uint2 gid [[thread_position_in_grid]]
) {
    uint dw = uint(params.dims.z);
    uint dh = uint(params.dims.w);
    if (gid.x >= dw || gid.y >= dh) return;

    float2 uv = (float2(gid) + 0.5) / float2(params.dims.z, params.dims.w);
    float2 texel = float2(1.0 / params.dims.x, 1.0 / params.dims.y);

    float3 low =
        src_low.sample(s_low, uv + float2(-texel.x, -texel.y), level(0.0)).rgb * 1.0 +
        src_low.sample(s_low, uv + float2( 0.0,     -texel.y), level(0.0)).rgb * 2.0 +
        src_low.sample(s_low, uv + float2( texel.x, -texel.y), level(0.0)).rgb * 1.0 +
        src_low.sample(s_low, uv + float2(-texel.x,  0.0    ), level(0.0)).rgb * 2.0 +
        src_low.sample(s_low, uv,                              level(0.0)).rgb * 4.0 +
        src_low.sample(s_low, uv + float2( texel.x,  0.0    ), level(0.0)).rgb * 2.0 +
        src_low.sample(s_low, uv + float2(-texel.x,  texel.y), level(0.0)).rgb * 1.0 +
        src_low.sample(s_low, uv + float2( 0.0,      texel.y), level(0.0)).rgb * 2.0 +
        src_low.sample(s_low, uv + float2( texel.x,  texel.y), level(0.0)).rgb * 1.0;
    low *= (1.0 / 16.0);

    float3 curr = src_curr.sample(s_curr, uv, level(0.0)).rgb;
    dst_tex.write(float4(curr + low * params.weight.x, 1.0), gid);
}
