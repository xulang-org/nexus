#include <metal_stdlib>
using namespace metal;

struct BloomDownParams {
    float4 dims; // sw, sh, dw, dh
    float4 cfg;  // threshold, soft_knee, extract_pass, 0
};

static inline float karis_weight(float3 c) {
    float l = max(dot(c, float3(0.2126, 0.7152, 0.0722)), 0.0);
    return 1.0 / (1.0 + l);
}

static inline float3 soft_threshold(float3 c, float thresh, float knee) {
    float lum = max(c.r, max(c.g, c.b));
    float soft = clamp(lum - thresh + knee, 0.0, 2.0 * knee);
    soft = (soft * soft) / (4.0 * knee);
    float contrib = max(soft, lum - thresh) / max(lum, 1e-5);
    return c * max(contrib, 0.0);
}

kernel void main0(
    texture2d<float> src_tex [[texture(0)]],
    texture2d<float, access::write> dst_tex [[texture(1)]],
    sampler src_sampler [[sampler(0)]],
    constant BloomDownParams& params [[buffer(0)]],
    uint2 gid [[thread_position_in_grid]]
) {
    uint dw = uint(params.dims.z);
    uint dh = uint(params.dims.w);
    if (gid.x >= dw || gid.y >= dh) return;

    float2 uv = (float2(gid) + 0.5) / float2(params.dims.z, params.dims.w);
    float2 dx = float2(1.0 / params.dims.x, 0.0);
    float2 dy = float2(0.0, 1.0 / params.dims.y);

    // 13-tap Jimenez Call of Duty pyramid filter.
    float3 a = src_tex.sample(src_sampler, uv - 2.0 * dx - 2.0 * dy, level(0.0)).rgb;
    float3 b = src_tex.sample(src_sampler, uv - 2.0 * dy, level(0.0)).rgb;
    float3 c = src_tex.sample(src_sampler, uv + 2.0 * dx - 2.0 * dy, level(0.0)).rgb;
    float3 d = src_tex.sample(src_sampler, uv - 2.0 * dx, level(0.0)).rgb;
    float3 e = src_tex.sample(src_sampler, uv, level(0.0)).rgb;
    float3 f = src_tex.sample(src_sampler, uv + 2.0 * dx, level(0.0)).rgb;
    float3 g = src_tex.sample(src_sampler, uv - 2.0 * dx + 2.0 * dy, level(0.0)).rgb;
    float3 h = src_tex.sample(src_sampler, uv + 2.0 * dy, level(0.0)).rgb;
    float3 i = src_tex.sample(src_sampler, uv + 2.0 * dx + 2.0 * dy, level(0.0)).rgb;

    float3 j = src_tex.sample(src_sampler, uv - dx - dy, level(0.0)).rgb;
    float3 k = src_tex.sample(src_sampler, uv + dx - dy, level(0.0)).rgb;
    float3 l = src_tex.sample(src_sampler, uv - dx + dy, level(0.0)).rgb;
    float3 m = src_tex.sample(src_sampler, uv + dx + dy, level(0.0)).rgb;

    float3 out_rgb;
    if (params.cfg.z > 0.5) {
        float thresh = params.cfg.x;
        float knee = max(params.cfg.y, 1e-4);
        float3 g0 = soft_threshold((a + b + d + e) * 0.25, thresh, knee);
        float3 g1 = soft_threshold((b + c + e + f) * 0.25, thresh, knee);
        float3 g2 = soft_threshold((d + e + g + h) * 0.25, thresh, knee);
        float3 g3 = soft_threshold((e + f + h + i) * 0.25, thresh, knee);
        float3 g4 = soft_threshold((j + k + l + m) * 0.25, thresh, knee);
        float w0 = karis_weight(g0), w1 = karis_weight(g1), w2 = karis_weight(g2), w3 = karis_weight(g3), w4 = karis_weight(g4);
        out_rgb = (g0 * w0 + g1 * w1 + g2 * w2 + g3 * w3 + g4 * w4) / max(w0 + w1 + w2 + w3 + w4, 1e-5);
    } else {
        out_rgb = e * 0.125 + (a + c + g + i) * 0.03125 + (b + d + f + h) * 0.0625 + (j + k + l + m) * 0.125;
    }

    dst_tex.write(float4(max(out_rgb, float3(0.0)), 1.0), gid);
}
