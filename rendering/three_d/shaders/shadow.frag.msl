#include <metal_stdlib>
using namespace metal;
struct Input { float4 position [[position]]; float2 uv; };
struct Cutout { float4 params; float4 uv_rect; };
fragment float4 main0(Input input [[stage_in]], constant Cutout& cutout [[buffer(0)]],
    texture2d<float> base_texture [[texture(0)]], sampler base_sampler [[sampler(0)]]) {
    if (cutout.params.x > 0.0) {
        float2 sample_uv = cutout.uv_rect.xy + input.uv * cutout.uv_rect.zw;
        float alpha = cutout.params.y > 0.5 ? base_texture.sample(base_sampler, sample_uv).a : 1.0;
        if (alpha < cutout.params.x) discard_fragment();
    }
    return float4(input.position.z,0.0,0.0,1.0);
}
