#version 450

layout(set = 0, binding = 0) uniform sampler2D src_tex;
layout(set = 1, binding = 0, rgba16f) uniform writeonly image2D dst_tex;

layout(set = 2, binding = 0, std140) uniform BloomDownParams {
    vec4 dims;
    vec4 cfg;
} params;

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

void main() {
    uvec2 gid = gl_GlobalInvocationID.xy;
    uint dw = uint(params.dims.z), dh = uint(params.dims.w);
    if (gid.x >= dw || gid.y >= dh) return;

    vec2 uv = (vec2(gid) + 0.5) / vec2(params.dims.z, params.dims.w);
    vec2 dx = vec2(1.0 / params.dims.x, 0.0);
    vec2 dy = vec2(0.0, 1.0 / params.dims.y);

    vec3 a = textureLod(src_tex, uv - dx - dy, 0.0).rgb;
    vec3 b = textureLod(src_tex, uv + dx - dy, 0.0).rgb;
    vec3 c = textureLod(src_tex, uv - dx + dy, 0.0).rgb;
    vec3 d = textureLod(src_tex, uv + dx + dy, 0.0).rgb;
    vec3 e = textureLod(src_tex, uv, 0.0).rgb;
    vec3 avg = (a + b + c + d) * 0.125 + e * 0.5;

    if (params.cfg.z > 0.5) {
        float lum = max(avg.r, max(avg.g, avg.b));
        float thresh = params.cfg.x;
        float knee = max(params.cfg.y, 1e-4);
        float soft = clamp(lum - thresh + knee, 0.0, 2.0 * knee);
        soft = (soft * soft) / (4.0 * knee);
        float contrib = max(soft, lum - thresh) / max(lum, 1e-5);
        avg *= max(contrib, 0.0);
    }

    imageStore(dst_tex, ivec2(gid), vec4(max(avg, vec3(0.0)), 1.0));
}
