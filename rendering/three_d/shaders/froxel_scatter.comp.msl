#include <metal_stdlib>
using namespace metal;

struct LightGpu {
    float4 position_kind;
    float4 direction_range;
    float4 radiance_inner;
    float4 cone;
};

struct FroxelScatterParams {
    float4x4 inv_vp;
    float4 eye_time;           // xyz=eye, w=time
    float4 cam_fwd_count;      // xyz=cam_forward, w=light_count
    float4 grid_near;          // x=FX, y=FY, z=FZ, w=fog_near
    float4 fog_far_dens;       // x=fog_far, y=base_density, z=height_falloff, w=base_height
    float4 fog_phase_ext;      // x=anisotropy_g, y=extinction_scale, z=noise_strength, w=noise_scale
    float4 fog_albedo_scat;    // rgb=fog_albedo, w=scattering_strength
    float4 fog_ambient_lboost; // rgb=fog_ambient, w=local_light_boost
    float4 sun_dir_en;         // xyz=sun_dir, w=fog_enabled
    float4 sun_rad_boost;      // rgb=sun_radiance, w=sun_shaft_boost
    float4 wind_vel_pad;       // xyz=wind_vel, w=0
    float4 pad0;
};

static inline float hg_phase(float cos_theta, float g) {
    float g2 = g * g;
    float denom = max(1.0 + g2 - 2.0 * g * cos_theta, 1e-4);
    return (1.0 - g2) / (4.0 * 3.14159265359 * pow(denom, 1.5));
}

static inline float hash31(float3 p) {
    p = fract(p * 0.1031);
    p += dot(p, p.yzx + 33.33);
    return fract((p.x + p.y) * p.z);
}

static inline float noise3d(float3 x) {
    float3 i = floor(x);
    float3 f = fract(x);
    f = f * f * (3.0 - 2.0 * f);
    return mix(
        mix(mix(hash31(i + float3(0,0,0)), hash31(i + float3(1,0,0)), f.x),
            mix(hash31(i + float3(0,1,0)), hash31(i + float3(1,1,0)), f.x), f.y),
        mix(mix(hash31(i + float3(0,0,1)), hash31(i + float3(1,0,1)), f.x),
            mix(hash31(i + float3(0,1,1)), hash31(i + float3(1,1,1)), f.x), f.y),
        f.z
    );
}

kernel void main0(
    constant FroxelScatterParams& p [[buffer(0)]],
    device const LightGpu* lights [[buffer(1)]],
    device float4* froxel_scatter [[buffer(2)]],
    uint gid [[thread_position_in_grid]]
) {
    uint fx_n = uint(p.grid_near.x);
    uint fy_n = uint(p.grid_near.y);
    uint fz_n = uint(p.grid_near.z);
    uint total = fx_n * fy_n * fz_n;
    if (gid >= total) return;

    if (p.sun_dir_en.w < 0.5) {
        froxel_scatter[gid] = float4(0.0, 0.0, 0.0, 0.0);
        return;
    }

    uint slice_xy = fx_n * fy_n;
    uint fz = gid / slice_xy;
    uint rem = gid - fz * slice_xy;
    uint fy = rem / fx_n;
    uint fx = rem - fy * fx_n;

    float2 uv = float2((float(fx) + 0.5) / float(fx_n), (float(fy) + 0.5) / float(fy_n));
    float ndc_x = uv.x * 2.0 - 1.0;
    float ndc_y = 1.0 - uv.y * 2.0;
    float4 far4 = p.inv_vp * float4(ndc_x, ndc_y, 0.001, 1.0);
    float3 far_p = far4.xyz / max(far4.w, 1e-6);
    float3 eye = p.eye_time.xyz;
    float3 ray_dir = normalize(far_p - eye);
    float3 cam_fwd = normalize(p.cam_fwd_count.xyz);
    float cos_ang = max(dot(ray_dir, cam_fwd), 0.1);

    float fog_near = p.grid_near.w;
    float fog_far = p.fog_far_dens.x;
    float ratio = fog_far / max(fog_near, 1e-4);
    float t0 = float(fz) / float(fz_n);
    float t1 = float(fz + 1u) / float(fz_n);
    float z0 = fog_near * pow(ratio, t0);
    float z1 = fog_near * pow(ratio, t1);
    float z_mid = 0.5 * (z0 + z1);

    float3 world_pos = eye + ray_dir * (z_mid / cos_ang);

    float h_above = max(world_pos.y - p.fog_far_dens.w, 0.0);
    float dens = p.fog_far_dens.y * exp(-h_above * p.fog_far_dens.z);

    if (p.fog_phase_ext.z > 0.0) {
        float3 sample_p = (world_pos + p.wind_vel_pad.xyz * p.eye_time.w) * p.fog_phase_ext.w;
        float n = noise3d(sample_p);
        dens *= max(0.0, mix(1.0, 0.35 + 1.3 * n, p.fog_phase_ext.z));
    }

    float g = p.fog_phase_ext.x;
    float3 albedo = p.fog_albedo_scat.rgb;
    float3 sun_dir = normalize(p.sun_dir_en.xyz);
    float sun_phase = hg_phase(dot(ray_dir, sun_dir), g);

    float3 in_scatter = p.fog_ambient_lboost.rgb * albedo;
    in_scatter += p.sun_rad_boost.rgb * albedo * sun_phase * p.sun_rad_boost.w;

    uint lcount = min(uint(p.cam_fwd_count.w), 64u);
    float lboost = p.fog_ambient_lboost.w;
    if (lboost > 0.0) {
        for (uint li = 0u; li < lcount; ++li) {
            LightGpu src = lights[li];
            if (src.position_kind.w < 0.5) continue; // directional handled via sun
            float3 delta = src.position_kind.xyz - world_pos;
            float d2 = dot(delta, delta);
            float r2 = src.direction_range.w * src.direction_range.w;
            if (d2 >= r2) continue;
            float dlen = sqrt(max(d2, 1e-6));
            float3 ldir = delta / dlen;
            float rel2 = d2 / r2;
            float edge = max(0.0, 1.0 - rel2 * rel2);
            float atten = edge * edge / max(d2, 0.25);
            if (src.position_kind.w > 1.5) {
                float cos_a = dot(src.direction_range.xyz, -ldir);
                float sp = clamp((cos_a - src.cone.x) / max(src.radiance_inner.w - src.cone.x, 1e-6), 0.0, 1.0);
                atten *= sp * sp * (3.0 - 2.0 * sp);
            }
            float lphase = hg_phase(dot(ray_dir, ldir), g * 0.65);
            in_scatter += src.radiance_inner.xyz * atten * albedo * lphase * lboost;
        }
    }

    float3 scat = in_scatter * (dens * p.fog_albedo_scat.w);
    float ext = dens * p.fog_phase_ext.y;
    froxel_scatter[gid] = float4(max(scat, float3(0.0)), max(ext, 0.0));
}
