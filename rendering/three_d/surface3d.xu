@"github.com/xulang-org/game/rendering/three_d"

fm #"github.com/xulang-org/game/foundation/math"
#errors

pub fn (material &Material3D) has_occlusion_texture() bool { << material.occlusion_texture.present }
// An independent R-channel map overrides ORM's R, retaining the ORM G/B factors.
pub fn (material &Material3D) with_occlusion_texture(texture &Texture3D, strength f64) Material3D {
    material.check() or >>
    if !fm.finite(strength) || strength < 0.0 || strength > 1.0 { >> errors.new("game GPU: occlusion strength must be finite and in 0...1") }
    if texture.is_srgb() or >> { >> errors.new("game GPU: occlusion maps require a linear GPU image") }
    << Material3D{base: material.base, metallic: material.metallic, roughness: material.roughness,
        emission: material.emission, texture: material.texture, orm_texture: material.orm_texture,
        emission_texture: material.emission_texture, occlusion_strength: material.occlusion_strength,
        normal_texture: material.normal_texture, normal_scale: material.normal_scale,
        occlusion_texture: texture.reference(), occlusion_texture_strength: strength, surface_mode: material.surface_mode}
}
pub fn (material &Material3D) without_occlusion_texture() Material3D {
    << Material3D{base: material.base, metallic: material.metallic, roughness: material.roughness,
        emission: material.emission, texture: material.texture, orm_texture: material.orm_texture,
        emission_texture: material.emission_texture, occlusion_strength: material.occlusion_strength,
        normal_texture: material.normal_texture, normal_scale: material.normal_scale,
        occlusion_texture: no_texture(), occlusion_texture_strength: 1.0, surface_mode: material.surface_mode}
}
// Single-sided surfaces cull their logical back face; double-sided surfaces reverse back-face normals.
pub fn (material &Material3D) with_double_sided(enabled bool) Material3D {
    $mode := 0
    if enabled { mode = 1 }
    << Material3D{base: material.base, metallic: material.metallic, roughness: material.roughness,
        emission: material.emission, texture: material.texture, orm_texture: material.orm_texture,
        emission_texture: material.emission_texture, occlusion_strength: material.occlusion_strength,
        normal_texture: material.normal_texture, normal_scale: material.normal_scale,
        occlusion_texture: material.occlusion_texture, occlusion_texture_strength: material.occlusion_texture_strength, surface_mode: mode}
}
