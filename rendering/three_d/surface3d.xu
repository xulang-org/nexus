@"github.com/xulang-org/nexus/rendering/three_d"

fm #"github.com/xulang-org/nexus/foundation/math"
#errors

pub fn (material &Material3D) has_occlusion_texture() bool { << material.occlusion_texture.present }
// An independent R-channel map overrides ORM's R, retaining the ORM G/B factors.
pub fn (material &Material3D) with_occlusion_texture(texture &Texture3D, strength f64) Material3D {
    material.check() >>>
    if !fm.finite(strength) || strength < 0.0 || strength > 1.0 { >> errors.new("nexus GPU: occlusion strength must be finite and in 0...1") }
    if texture.is_srgb() >>> { >> errors.new("nexus GPU: occlusion maps require a linear GPU image") }
    $next := material.clone_material()
    next.occlusion_texture = texture.reference()
    next.occlusion_texture_strength = strength
    << next
}
pub fn (material &Material3D) without_occlusion_texture() Material3D {
    $next := material.clone_material()
    next.occlusion_texture = no_texture()
    next.occlusion_texture_strength = 1.0
    << next
}
// Single-sided surfaces cull their logical back face; double-sided surfaces reverse back-face normals.
pub fn (material &Material3D) with_double_sided(enabled bool) Material3D {
    $mode := 0
    if enabled { mode = 1 }
    $next := material.clone_material()
    next.surface_mode = mode
    << next
}
