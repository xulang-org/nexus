@"github.com/xulang-org/nexus/rendering/three_d"

fm #"github.com/xulang-org/nexus/foundation/math"
#errors

pub fn (material &Material3D) has_normal_texture() bool { << material.normal_texture.present }
// RGB encodes tangent-space XYZ as 2*RGB-1, with +Y along the bitangent.
// Scale changes X/Y before renormalization; zero uses the geometric normal.
// Scale is bounded to 0...8.
pub fn (material &Material3D) with_normal_texture(texture &Texture3D, scale f64) Material3D {
    material.check() >>>
    if !fm.finite(scale) || scale < 0.0 || scale > 8.0 { >>> errors.new("nexus GPU: normal scale must be finite and in 0...8") }
    if texture.is_srgb() >>> { >>> errors.new("nexus GPU: normal maps require a linear GPU image") }
    $next := material.clone_material()
    next.normal_texture = texture.reference()
    next.normal_scale = scale
    << next
}
pub fn (material &Material3D) without_normal_texture() Material3D {
    $next := material.clone_material()
    next.normal_texture = no_texture()
    next.normal_scale = 1.0
    << next
}
