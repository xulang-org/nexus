@"github.com/xulang-org/game/rendering/three_d"

fm #"github.com/xulang-org/game/foundation/math"
#errors

pub fn (material &Material3D) has_normal_texture() bool { << material.normal_texture.present }
// RGB encodes tangent-space XYZ as 2*RGB-1, with +Y along the bitangent.
// Scale changes X/Y before renormalization; zero uses the geometric normal.
// Scale is bounded to 0...8.
pub fn (material &Material3D) with_normal_texture(texture &Texture3D, scale f64) Material3D {
    material.check() or >>
    if !fm.finite(scale) || scale < 0.0 || scale > 8.0 { >> errors.new("game GPU: normal scale must be finite and in 0...8") }
    if texture.is_srgb() or >> { >> errors.new("game GPU: normal maps require a linear GPU image") }
    << Material3D{base: material.base, metallic: material.metallic, roughness: material.roughness,
        emission: material.emission, texture: material.texture, orm_texture: material.orm_texture,
        emission_texture: material.emission_texture, occlusion_strength: material.occlusion_strength,
        normal_texture: texture.reference(), normal_scale: scale, occlusion_texture: material.occlusion_texture, occlusion_texture_strength: material.occlusion_texture_strength, surface_mode: material.surface_mode}
}
pub fn (material &Material3D) without_normal_texture() Material3D {
    << Material3D{base: material.base, metallic: material.metallic, roughness: material.roughness,
        emission: material.emission, texture: material.texture, orm_texture: material.orm_texture,
        emission_texture: material.emission_texture, occlusion_strength: material.occlusion_strength,
        normal_texture: no_texture(), normal_scale: 1.0, occlusion_texture: material.occlusion_texture, occlusion_texture_strength: material.occlusion_texture_strength, surface_mode: material.surface_mode}
}
