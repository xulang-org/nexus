@"github.com/xulang-org/nexus/rendering/three_d"

#gpu
#encoding/binary
#errors
fm #"github.com/xulang-org/nexus/foundation/math"
meshes #"github.com/xulang-org/nexus/resources/mesh"

pub struct Mesh3D {
    vertices []gpu.Buffer
    indices []gpu.Buffer
    soft_blobs []gpu.SoftBlob
    has_gpu bool
    device_id int
    count int
    normals bool
    uvs bool
    tangents bool
    bounds fm.Aabb3
    closed bool
}
fn zero_bytes(count int) []u8 {
    $bytes := []u8{}
    for i in 0:count { bytes.push(u8(0)) }
    << bytes
}
fn put_scalar(bytes $&[]u8, offset int, value f64) int {
    word := scalar_word(value) >>>
    << binary.little_endian().put_u32_bytes(bytes,offset,word) >>>
}
pub fn (device &Device3D) upload(mesh &meshes.MeshData3D) Mesh3D {
    device.alive() >>>
    if device.active { >>> errors.new("nexus 3D: upload meshes outside a frame") }
    authored_bounds := mesh.bounds() >>>
    uploaded_bounds := quantized_bounds(authored_bounds) >>>
    size := mesh.vertices.len*64+mesh.indices.len*4
    if device.is_gpu() {
        dev := device.gpu_device() >>>
        stats := dev.stats() >>>
        if stats.buffer_count>=1024 || size>67108864-stats.buffer_bytes { >>> errors.new("nexus 3D: mesh capacity or 64 MiB budget exceeded") }
    } else if size>67108864 {
        >>> errors.new("nexus 3D: mesh capacity or 64 MiB budget exceeded")
    }
    $vertices := zero_bytes(mesh.vertices.len*64)
    $indices := zero_bytes(mesh.indices.len*4)
    $normals := true
    $uvs := true
    $tangents := true
    for i in 0:mesh.vertices.len {
        vertex := &mesh.vertices[i]
        if vertex.normal.dot(vertex.normal)==0.0 { normals=false }
        if !vertex.has_uv { uvs=false }
        if !vertex.has_tangent { tangents=false }
        values := [vertex.position.x,vertex.position.y,vertex.position.z,
            f64((vertex.color >> 24) & 255)/255.0,f64((vertex.color >> 16) & 255)/255.0,
            f64((vertex.color >> 8) & 255)/255.0,f64(vertex.color & 255)/255.0,
            vertex.normal.x,vertex.normal.y,vertex.normal.z,vertex.uv.x,vertex.uv.y,
            vertex.tangent.x,vertex.tangent.y,vertex.tangent.z,vertex.tangent.w]
        for j in 0:16 { put_scalar($&vertices,i*64+j*4,values[j]) >>> }
    }
    for i in 0:mesh.indices.len { binary.little_endian().put_u32_bytes($&indices,i*4,mesh.indices[i]) >>> }
    if !device.is_gpu() {
        $sb_v := gpu.soft_blob_create(device.device_id,&vertices) >>>
        $sb_i := gpu.soft_blob_create(device.device_id,&indices) >>>
        << Mesh3D{vertices: []gpu.Buffer{},indices: []gpu.Buffer{},soft_blobs: [sb_v,sb_i],
            has_gpu: false,device_id: device.device_id,
            count: mesh.indices.len,normals: normals,uvs: uvs,tangents: tangents,bounds: uploaded_bounds,closed: false}
    }
    dev := device.gpu_device() >>>
    $vb := dev.buffer(vertices.len,gpu.BUFFER_VERTEX) >>>
    $ib := dev.buffer(indices.len,gpu.BUFFER_INDEX) >>>
    $v_upload := dev.upload(&vb,0,&vertices) >>>
    v_upload.close() >>>
    $i_upload := dev.upload(&ib,0,&indices) >>>
    i_upload.close() >>>
    << Mesh3D{vertices: [vb],indices: [ib],soft_blobs: []gpu.SoftBlob{},has_gpu: true,device_id: 0,
        count: mesh.indices.len,normals: normals,uvs: uvs,tangents: tangents,bounds: uploaded_bounds,closed: false}
}
fn close_soft_blob(blob $&gpu.SoftBlob) string { blob.close() >>> (err){ << err.msg() }
    << "" }
pub fn (mesh $&Mesh3D) close() int {
    if mesh.closed { << 0 }
    $first := ""
    $second := ""
    if mesh.vertices.len>0 { first = close_buffer($&mesh.vertices[0]) }
    if mesh.indices.len>0 { second = close_buffer($&mesh.indices[0]) }
    for i in 0:mesh.soft_blobs.len {
        err := close_soft_blob($&mesh.soft_blobs[i])
        if first.len==0 && err.len>0 { first = err }
    }
    mesh.vertices = []gpu.Buffer{}
    mesh.indices = []gpu.Buffer{}
    mesh.soft_blobs = []gpu.SoftBlob{}
    mesh.closed = true
    if first.len>0 { >>> errors.new(first) }
    if second.len>0 { >>> errors.new(second) }
    << 0
}
fn close_buffer(buffer $&gpu.Buffer) string { buffer.close() >>> (err){ << err.msg() }
    << "" }
fn (mesh $&Mesh3D) drop() { mesh.close() >>> (err){ << } }
fn matrix_words(matrix fm.Mat4) []int {
    if !matrix.is_finite() { >>> errors.new("nexus 3D: non-finite model-view-projection") }
    $words := []int{}
    for column in [matrix.c0,matrix.c1,matrix.c2,matrix.c3] {
        for value in [column.x,column.y,column.z,column.w] { words.push(scalar_word(value) >>>) }
    }
    << words
}
fn word_bytes(words &[]int) []u8 {
    $bytes := zero_bytes(words.len*4)
    for i in 0:words.len { binary.little_endian().put_u32_bytes($&bytes,i*4,words[i]) >>> }
    << bytes
}
pub fn (device $&Device3D) draw(mesh &Mesh3D, model_view_projection fm.Mat4) int {
    << device.draw_reference(mesh.reference(),model_view_projection) >>>
}
fn (device $&Device3D) record_draw(mesh MeshRef3D, matrices &[]int, parameters &[]int, illumination &[]int, maps &[]TextureRef3D,shadow &ShadowBinding3D,shadow_index int) int {
    device.drawing() >>>
    // All weak resources and scalar bytes are checked before the first binding.
    device.reference().validate_mesh(mesh,false) >>>
    dev := device.gpu_device() >>>
    dev_ref := dev.reference()
    for texture in maps {
        if texture.present { dev_ref.validate_texture(texture.image) >>>
            dev_ref.validate_sampler(texture.sampler) >>> }
    }
    if shadow.present { dev_ref.validate_texture(shadow.image) >>> }
    vertex := word_bytes(matrices) >>>
    fragment := word_bytes(parameters) >>>
    lights := word_bytes(illumination) >>>
    shadow_values := shadow_words(shadow,shadow_index) >>>
    shadow_bytes := word_bytes(&shadow_values) >>>
    if parameters[11]==0 {
        if parameters[12]==3212836864 { device.passes[0].pipeline(&device.pipelines[2]) >>>
        } else { device.passes[0].pipeline(&device.pipelines[1]) >>> }
    } else { device.passes[0].pipeline(&device.pipelines[0]) >>> }
    device.passes[0].vertex_buffer_ref(0,mesh.vertices,0) >>>
    device.passes[0].index_buffer_ref(mesh.indices,0,gpu.INDEX32) >>>
    for i in 0:5 {
        texture := maps[i]
        if texture.present { device.passes[0].sampler_ref(gpu.FRAGMENT,i,texture.image,texture.sampler) >>>
        } else { device.passes[0].sampler(gpu.FRAGMENT,i,&device.whites[0],&device.white_samplers[0]) >>> }
    }
    if shadow.present { device.passes[0].sampler_ref(gpu.FRAGMENT,5,shadow.image,device.white_samplers[0].reference()) >>>
    } else { device.passes[0].sampler(gpu.FRAGMENT,5,&device.whites[0],&device.white_samplers[0]) >>> }
    device.passes[0].uniform(gpu.VERTEX,0,&vertex) >>>
    device.passes[0].uniform(gpu.FRAGMENT,0,&fragment) >>>
    device.passes[0].uniform(gpu.FRAGMENT,1,&lights) >>>
    device.passes[0].uniform(gpu.FRAGMENT,2,&shadow_bytes) >>>
    device.passes[0].draw_indexed(mesh.count,0,0,1,0) >>>
    device.draw_count += 1
    << mesh.count/3
}
