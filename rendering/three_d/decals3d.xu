@"github.com/xulang-org/nexus/rendering/three_d"

#gpu
layout #gpu/layout
#encoding/binary
#errors
#math
fm #"github.com/xulang-org/nexus/foundation/math"

pub const MAX_DECALS = 512

pub const DECAL_BLEND_ALPHA = 0
pub const DECAL_BLEND_ADDITIVE = 1
pub const DECAL_BLEND_STAIN = 2

pub const DECAL_SHAPE_TEXTURED = 0
pub const DECAL_SHAPE_SOFT_DISC = 1
pub const DECAL_SHAPE_RING = 2

pub struct DecalProgram3D {
    pub format int
    pub entrypoint string
    pub vertex []u8
    pub fragment []u8
}

pub fn empty_decal_program_3d() DecalProgram3D {
    << DecalProgram3D{
        format: 0,
        entrypoint: "",
        vertex: []u8{},
        fragment: []u8{}
    }
}

pub struct Decal3D {
    pub world fm.Mat4
    pub albedo fm.Vec3
    pub emission fm.Vec3
    pub opacity f64
    pub roughness f64
    pub metallic f64
    pub blend_mode int
    pub shape_mode int
    pub angle_fade f64
    pub edge_fade f64
    pub ring_inner f64
    pub radial_power f64
    pub sort_order int
    pub texture TextureRef3D
}

pub fn default_decal_3d(world fm.Mat4) Decal3D {
    << Decal3D{
        world: world,
        albedo: fm.vec3(1.0, 1.0, 1.0),
        emission: fm.vec3(0.0, 0.0, 0.0),
        opacity: 1.0,
        roughness: 0.7,
        metallic: 0.0,
        blend_mode: DECAL_BLEND_ALPHA,
        shape_mode: DECAL_SHAPE_SOFT_DISC,
        angle_fade: 0.25,
        edge_fade: 0.15,
        ring_inner: 0.55,
        radial_power: 1.4,
        sort_order: 0,
        texture: no_texture()
    }
}

pub fn (d &Decal3D) validate(device &Device3D) int {
    if !d.world.is_affine() {
        >> errors.new("nexus decals 3D: decal world transform must be finite affine")
    }
    if !d.albedo.is_finite() || d.albedo.x < 0.0 || d.albedo.y < 0.0 || d.albedo.z < 0.0 ||
        !d.emission.is_finite() || d.emission.x < 0.0 || d.emission.y < 0.0 || d.emission.z < 0.0 {
        >> errors.new("nexus decals 3D: invalid decal albedo or emission")
    }
    if !fm.finite(d.opacity) || d.opacity < 0.0 || d.opacity > 1.0 ||
        !fm.finite(d.roughness) || d.roughness < 0.045 || d.roughness > 1.0 ||
        !fm.finite(d.metallic) || d.metallic < 0.0 || d.metallic > 1.0 ||
        !fm.finite(d.angle_fade) || d.angle_fade < 0.0 || d.angle_fade > 0.99 ||
        !fm.finite(d.edge_fade) || d.edge_fade < 0.0 || d.edge_fade > 0.49 ||
        !fm.finite(d.ring_inner) || d.ring_inner < 0.05 || d.ring_inner > 0.9 ||
        !fm.finite(d.radial_power) || d.radial_power <= 0.0 || d.radial_power > 16.0 {
        >> errors.new("nexus decals 3D: decal scalar out of valid range")
    }
    if d.blend_mode < DECAL_BLEND_ALPHA || d.blend_mode > DECAL_BLEND_STAIN ||
        d.shape_mode < DECAL_SHAPE_TEXTURED || d.shape_mode > DECAL_SHAPE_RING {
        >> errors.new("nexus decals 3D: invalid decal blend_mode or shape_mode")
    }
    if d.texture.present {
        dev := device.gpu_device() or >>
        dev_ref := dev.reference()
        dev_ref.validate_texture(d.texture.image) or >>
        dev_ref.validate_sampler(d.texture.sampler) or >>
    }
    << 0
}

pub struct DecalQueue3D {
    items []Decal3D
}

pub fn new_decal_queue_3d() DecalQueue3D {
    << DecalQueue3D{items: []Decal3D{}}
}

pub fn (q $&DecalQueue3D) clear() {
    q.items = []Decal3D{}
}

pub fn (q &DecalQueue3D) count() int {
    << q.items.len
}

pub fn (q $&DecalQueue3D) submit(decal Decal3D) int {
    if q.items.len >= MAX_DECALS {
        >> errors.new("nexus decals 3D: DecalQueue3D capacity (512) exceeded")
    }
    if !decal.world.is_affine() {
        >> errors.new("nexus decals 3D: submitted decal requires affine world matrix")
    }
    idx := q.items.len
    q.items.push(decal)
    << idx
}

pub fn (q &DecalQueue3D) sorted_indices() []int {
    n := q.items.len
    $order := []int{}
    for i in 0:n { order.push(i) }
    for i in 1:n {
        key_idx := order[i]
        key_sort := q.items[key_idx].sort_order
        $j := i - 1
        while j >= 0 && q.items[order[j]].sort_order > key_sort {
            order[j + 1] = order[j]
            j -= 1
        }
        order[j + 1] = key_idx
    }
    << order
}

pub struct DecalRenderer3D {
    owner DeviceRef3D
    pipelines []gpu.GraphicsPipeline // [0]=HDR RGBA16F BLEND_PREMULTIPLIED + CULL_FRONT
    samplers []gpu.Sampler           // [0]=nearest sampler
    buffers []gpu.Buffer             // [0]=box VB (96B), [1]=box IB (144B), [2]=dummy probe (64B)
    closed bool
}

fn push_decal_word(dst $&[]int, val f64) int {
    w := scalar_word(val) or >>
    dst.push(w)
    << 0
}

pub fn (device &Device3D) decal_renderer(program &DecalProgram3D) DecalRenderer3D {
    device.alive() or >>
    if device.active { >> errors.new("nexus decals 3D: create DecalRenderer3D outside a frame") }
    if !device.is_gpu() { >> errors.new("nexus decals 3D: DecalRenderer3D requires GPU backend") }
    dev := device.gpu_device() or >>
    if (dev.shader_formats() & program.format) == 0 || program.entrypoint.len == 0 ||
        program.vertex.len == 0 || program.fragment.len == 0 {
        >> errors.new("nexus decals 3D: invalid or unsupported decal shader program")
    }
    stats := dev.stats() or >>
    if stats.buffer_count + 3 > 1024 || 304 > 67108864 - stats.buffer_bytes {
        >> errors.new("nexus decals 3D: exceeds buffer count or 64 MiB VRAM budget")
    }

    // Unit cube [-0.5, 0.5]^3 vertices (24 float3 = 96B) & outward CCW indices (36 u32 = 144B).
    coords := [-0.5, -0.5, -0.5, 0.5, -0.5, -0.5, 0.5, 0.5, -0.5, -0.5, 0.5, -0.5, -0.5, -0.5, 0.5, 0.5, -0.5, 0.5, 0.5, 0.5, 0.5, -0.5, 0.5, 0.5]
    $vwords := []int{}
    for c in coords {
        w := scalar_word(c) or >>
        vwords.push(w)
    }
    vb_bytes := word_bytes(&vwords) or >>

    indices := [4, 5, 6, 4, 6, 7, 1, 0, 3, 1, 3, 2, 5, 1, 2, 5, 2, 6, 0, 4, 7, 0, 7, 3, 7, 6, 2, 7, 2, 3, 0, 1, 5, 0, 5, 4]
    order := binary.little_endian()
    $ib_bytes := zero_bytes(36 * 4)
    for k in 0:36 {
        order.put_u32_bytes($&ib_bytes, k * 4, indices[k]) or >>
    }

    $vb := dev.buffer(96, gpu.BUFFER_VERTEX) or >>
    $ib := dev.buffer(144, gpu.BUFFER_INDEX) or >>
    $probe := dev.buffer(64, gpu.BUFFER_GRAPHICS_STORAGE_READ) or >>
    $u0 := dev.upload(&vb, 0, &vb_bytes) or >>
    u0.close() or >>
    $u1 := dev.upload(&ib, 0, &ib_bytes) or >>
    u1.close() or >>
    zeros := zero_bytes(64)
    $u2 := dev.upload(&probe, 0, &zeros) or >>
    u2.close() or >>

    $sdesc := gpu.sampler_defaults()
    sdesc.min_filter = gpu.NEAREST
    sdesc.mag_filter = gpu.NEAREST
    sdesc.mip_filter = gpu.NEAREST
    $near_samp := dev.sampler(sdesc) or >>

    vs_desc := gpu.ShaderResourcesDesc{
        stage: gpu.VERTEX,
        format: program.format,
        entrypoint: program.entrypoint + "",
        samplers: 0,
        storage_textures: 0,
        storage_buffers: 0,
        uniform_sizes: [64]
    }
    fs_desc := gpu.ShaderResourcesDesc{
        stage: gpu.FRAGMENT,
        format: program.format,
        entrypoint: program.entrypoint + "",
        samplers: 3,
        storage_textures: 0,
        storage_buffers: 4,
        uniform_sizes: [224, 80, 48]
    }
    $vs := dev.shader_with_resources(&vs_desc, &program.vertex) or >>
    $fs := dev.shader_with_resources(&fs_desc, &program.fragment) or >>

    // CULL_FRONT ensures decal volume stays visible even when camera enters the box.
    $pdesc := gpu.pipeline_defaults(layout.RGBA16_FLOAT)
    pdesc.primitive = gpu.TRIANGLES
    pdesc.cull = gpu.CULL_FRONT
    pdesc.depth_format = 0
    pdesc.depth_compare = gpu.DEPTH_DISABLED
    pdesc.depth_write = false
    pdesc.blend = gpu.BLEND_PREMULTIPLIED
    pdesc.vertex_buffers = [gpu.VertexBufferLayout{slot: 0, stride: 12, rate: gpu.PER_VERTEX}]
    pdesc.attributes = [gpu.VertexAttribute{location: 0, slot: 0, format: gpu.FLOAT3, offset: 0}]
    $pipe := dev.graphics_pipeline(&vs, &fs, &pdesc) or >>
    vs.close() or >>
    fs.close() or >>

    << DecalRenderer3D{
        owner: device.reference(),
        pipelines: [pipe],
        samplers: [near_samp],
        buffers: [vb, ib, probe],
        closed: false
    }
}

fn decal_safe_norm(v fm.Vec3, fallback fm.Vec3) fm.Vec3 {
    << v.normalized() or (err) { << fallback }
}

fn build_decal_frag_bytes(
    inv_vp fm.Mat4,
    decal &Decal3D,
    view fm.Mat4,
    width int,
    height int
) []u8 {
    inv_model := decal.world.affine_inverse() or >>
    up_raw := fm.vec3(decal.world.c1.x, decal.world.c1.y, decal.world.c1.z)
    up_unit := decal_safe_norm(up_raw, fm.vec3(0.0, 1.0, 0.0))

    $w := []int{}
    ivp_w := matrix_words(inv_vp) or >>
    for v in ivp_w { w.push(v) }
    im_w := matrix_words(inv_model) or >>
    for v in im_w { w.push(v) }

    push_decal_word($&w, up_unit.x) or >>
    push_decal_word($&w, up_unit.y) or >>
    push_decal_word($&w, up_unit.z) or >>
    push_decal_word($&w, decal.angle_fade) or >>

    push_decal_word($&w, decal.albedo.x) or >>
    push_decal_word($&w, decal.albedo.y) or >>
    push_decal_word($&w, decal.albedo.z) or >>
    push_decal_word($&w, decal.opacity) or >>

    push_decal_word($&w, decal.emission.x) or >>
    push_decal_word($&w, decal.emission.y) or >>
    push_decal_word($&w, decal.emission.z) or >>
    push_decal_word($&w, decal.roughness) or >>

    push_decal_word($&w, decal.metallic) or >>
    push_decal_word($&w, f64(decal.blend_mode)) or >>
    push_decal_word($&w, f64(decal.shape_mode)) or >>
    push_decal_word($&w, decal.edge_fade) or >>

    push_decal_word($&w, f64(width)) or >>
    push_decal_word($&w, f64(height)) or >>
    push_decal_word($&w, decal.ring_inner) or >>
    push_decal_word($&w, decal.radial_power) or >>

    push_decal_word($&w, view.c0.z) or >>
    push_decal_word($&w, view.c1.z) or >>
    push_decal_word($&w, view.c2.z) or >>
    push_decal_word($&w, view.c3.z) or >>

    << word_bytes(&w) or >>
}

pub fn (dr &DecalRenderer3D) draw_into_hdr(
    device &Device3D,
    hdr $&HdrTarget3D,
    clustered &ClusteredRenderer3D,
    use_gi bool,
    irr &IrradianceGpu3D,
    gi_strength f64,
    queue &DecalQueue3D,
    view fm.Mat4,
    view_projection fm.Mat4
) int {
    device.alive() or >>
    if device.active { >> errors.new("nexus decals 3D: end Device3D frame before draw_into_hdr") }
    if dr.closed || !dr.owner.matches(device) {
        >> errors.new("nexus decals 3D: closed or foreign DecalRenderer3D")
    }
    if hdr.closed || hdr.active || !hdr.owner.matches(device) || hdr.textures.len < 3 {
        >> errors.new("nexus decals 3D: invalid, closed or active HdrTarget3D")
    }
    if clustered.closed || !clustered.owner.matches(device) || !clustered.ready {
        >> errors.new("nexus decals 3D: requires binned ClusteredRenderer3D")
    }
    if use_gi && (irr.closed || !irr.owner.matches(device)) {
        >> errors.new("nexus decals 3D: closed or foreign irradiance grid")
    }
    if !view.is_affine() || !view_projection.is_finite() {
        >> errors.new("nexus decals 3D: invalid camera matrix")
    }
    if queue.items.len == 0 { << 0 }

    for i in 0:queue.items.len {
        d := &queue.items[i]
        d.validate(device) or >>
    }

    inv_vp := mat4_inverse(view_projection) or >>
    light_bytes := clustered.lighting_uniform_bytes() or >>
    irr_bytes := build_terrain_irr_bytes(use_gi, irr, gi_strength) or >>

    dev := device.gpu_device() or >>
    $enc := dev.command_encoder() or >>
    c0 := gpu.ColorAttachment{
        view: hdr.textures[0].view(0) or >>,
        load: gpu.LOAD,
        store: gpu.STORE,
        clear: gpu.Color{r: 0.0, g: 0.0, b: 0.0, a: 0.0}
    }
    $pass := enc.begin_render(c0, gpu.no_depth()) or >>
    pass.pipeline(&dr.pipelines[0]) or >>
    pass.vertex_buffer(0, &dr.buffers[0], 0) or >>
    pass.index_buffer(&dr.buffers[1], 0, gpu.INDEX32) or >>

    $probe_buf := &dr.buffers[2]
    if use_gi { probe_buf = &irr.buffers[0] }

    order := queue.sorted_indices()
    for oi in 0:order.len {
        idx := order[oi]
        d := &queue.items[idx]
        mvp := view_projection.multiply(d.world)
        mvp_w := matrix_words(mvp) or >>
        vert_bytes := word_bytes(&mvp_w) or >>
        frag_bytes := build_decal_frag_bytes(inv_vp, d, view, hdr.width, hdr.height) or >>

        if d.texture.present {
            pass.sampler_ref(gpu.FRAGMENT, 0, d.texture.image, d.texture.sampler) or >>
        } else {
            pass.sampler(gpu.FRAGMENT, 0, &device.whites[0], &device.white_samplers[0]) or >>
        }
        pass.sampler(gpu.FRAGMENT, 1, &hdr.textures[2], &dr.samplers[0]) or >>
        pass.sampler(gpu.FRAGMENT, 2, &hdr.textures[1], &dr.samplers[0]) or >>

        pass.uniform(gpu.VERTEX, 0, &vert_bytes) or >>
        pass.uniform(gpu.FRAGMENT, 0, &frag_bytes) or >>
        pass.uniform(gpu.FRAGMENT, 1, &light_bytes) or >>
        pass.uniform(gpu.FRAGMENT, 2, &irr_bytes) or >>
        pass.storage_buffer(gpu.FRAGMENT, 0, &clustered.buffers[0]) or >>
        pass.storage_buffer(gpu.FRAGMENT, 1, &clustered.buffers[1]) or >>
        pass.storage_buffer(gpu.FRAGMENT, 2, &clustered.buffers[2]) or >>
        pass.storage_buffer(gpu.FRAGMENT, 3, probe_buf) or >>
        pass.draw_indexed(36, 0, 0, 1, 0) or >>
    }

    pass.end() or >>
    $fence := enc.submit() or >>
    fence.wait() or >>
    fence.close() or >>
    hdr.ready = true
    << order.len
}

pub fn (dr $&DecalRenderer3D) close() int {
    if dr.closed { << 0 }
    for i in 0:dr.pipelines.len {
        p := $&dr.pipelines[i]
        p.close() or >>
    }
    for i in 0:dr.samplers.len {
        s := $&dr.samplers[i]
        s.close() or >>
    }
    for i in 0:dr.buffers.len {
        b := $&dr.buffers[i]
        b.close() or >>
    }
    dr.pipelines = []gpu.GraphicsPipeline{}
    dr.samplers = []gpu.Sampler{}
    dr.buffers = []gpu.Buffer{}
    dr.closed = true
    << 0
}

fn (dr $&DecalRenderer3D) drop() {
    dr.close() or (err) { << }
}
