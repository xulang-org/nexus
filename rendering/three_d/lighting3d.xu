@"github.com/xulang-org/nexus/rendering/three_d"

light_data #"github.com/xulang-org/nexus/resources/lighting"
#errors

fn lighting_uniform_size() int { << 32+64*light_data.MAX_LIGHTS }

// Fragment slot 1: two environment vectors followed by sixteen 64-byte lights.
// The public descriptions contain no GPU packing or platform dependencies.
fn lighting_words(lighting &light_data.Environment3D) []int {
    lighting.validate() or >>
    if lighting.source_count()>light_data.MAX_LIGHTS { >> errors.new("nexus lights: select per-mesh sources before GPU encoding") }
    ambient := lighting.ambient()
    eye := lighting.eye()
    $words := []int{}
    for value in [ambient.x,ambient.y,ambient.z,f64(lighting.source_count()),eye.x,eye.y,eye.z,lighting.exposure()] {
        words.push(scalar_word(value) or >>)
    }
    for i in 0:light_data.MAX_LIGHTS {
        if i>=lighting.source_count() { for j in 0:16 { words.push(0) }
            -> }
        source := lighting.source(i) or >>
        position := source.position()
        direction := source.direction()
        radiance := source.radiance()
        for value in [position.x,position.y,position.z,f64(source.kind()),
            direction.x,direction.y,direction.z,source.radius(),radiance.x,radiance.y,radiance.z,source.inner_cosine(),
            source.outer_cosine(),0.0,0.0,0.0] { words.push(scalar_word(value) or >>) }
    }
    << words
}
