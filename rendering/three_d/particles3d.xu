@"github.com/xulang-org/nexus/rendering/three_d"

#gpu
layout #gpu/layout
#encoding/binary
#errors
#math
fm #"github.com/xulang-org/nexus/foundation/math"

pub const MAX_GPU_PARTICLES = 131072

pub const PARTICLE_SHAPE_POINT = 0
pub const PARTICLE_SHAPE_SPHERE = 1
pub const PARTICLE_SHAPE_BOX = 2
pub const PARTICLE_SHAPE_CONE = 3
pub const PARTICLE_SHAPE_RING = 4

pub const PARTICLE_BILLBOARD_CAMERA = 0
pub const PARTICLE_BILLBOARD_STRETCHED = 1
pub const PARTICLE_BILLBOARD_HORIZONTAL = 2

pub const PARTICLE_VISUAL_TEXTURED = 0
pub const PARTICLE_VISUAL_SOFT_DISC = 1
pub const PARTICLE_VISUAL_RING = 2

pub struct ParticleProgram3D {
    pub format int
    pub entrypoint string
    pub sim_compute []u8
    pub vertex []u8
    pub fragment []u8
}

pub fn empty_particle_program_3d() ParticleProgram3D {
    << ParticleProgram3D{
        format: 0,
        entrypoint: "",
        sim_compute: []u8{},
        vertex: []u8{},
        fragment: []u8{}
    }
}

pub struct ParticleEmitter3D {
    pub origin fm.Vec3
    pub direction fm.Vec3
    pub base_velocity fm.Vec3
    pub shape int
    pub shape_param0 f64
    pub shape_param1 f64
    pub box_hz f64
    pub emit_rate f64
    pub emitting bool
    pub speed_min f64
    pub speed_max f64
    pub velocity_spread f64
    pub life_min f64
    pub life_max f64
    pub size_start_min f64
    pub size_start_max f64
    pub size_end_scale f64
    pub size_bell_curve bool
    pub rotation_range f64
    pub angular_vel_min f64
    pub angular_vel_max f64
    pub stretch_factor f64
    pub gravity fm.Vec3
    pub wind fm.Vec3
    pub drag f64
    pub turbulence_strength f64
    pub turbulence_freq f64
    pub turbulence_scroll f64
    pub attractor_pos fm.Vec3
    pub attractor_strength f64
    pub vortex_axis fm.Vec3
    pub vortex_strength f64
    pub plane_enabled bool
    pub plane_normal fm.Vec3
    pub plane_d f64
    pub plane_restitution f64
    pub plane_friction f64
    pub color_keys []f64
    pub emissive_scale f64
    pub start_additive f64
    pub end_additive f64
    pub billboard_mode int
    pub visual_mode int
    pub radial_power f64
    pub ring_inner f64
    pub atlas_cols int
    pub atlas_rows int
    pub atlas_cycles f64
    pub depth_test bool
    pub soft_distance f64
}

pub fn default_particle_emitter_3d(origin fm.Vec3) ParticleEmitter3D {
    colors := [1.0, 0.95, 0.70, 1.0, 1.0, 0.55, 0.15, 0.9, 0.85, 0.20, 0.05, 0.5, 0.25, 0.08, 0.04, 0.0]
    << ParticleEmitter3D{
        origin: origin,
        direction: fm.vec3(0.0, 1.0, 0.0),
        base_velocity: fm.vec3(0.0, 0.0, 0.0),
        shape: PARTICLE_SHAPE_CONE,
        shape_param0: 0.15,
        shape_param1: 0.35,
        box_hz: 0.15,
        emit_rate: 120.0,
        emitting: true,
        speed_min: 1.5,
        speed_max: 3.0,
        velocity_spread: 0.25,
        life_min: 0.8,
        life_max: 1.4,
        size_start_min: 0.18,
        size_start_max: 0.28,
        size_end_scale: 0.35,
        size_bell_curve: false,
        rotation_range: 3.14159265359,
        angular_vel_min: -1.5,
        angular_vel_max: 1.5,
        stretch_factor: 0.25,
        gravity: fm.vec3(0.0, -3.5, 0.0),
        wind: fm.vec3(0.0, 0.0, 0.0),
        drag: 0.2,
        turbulence_strength: 0.0,
        turbulence_freq: 1.2,
        turbulence_scroll: 0.6,
        attractor_pos: origin,
        attractor_strength: 0.0,
        vortex_axis: fm.vec3(0.0, 1.0, 0.0),
        vortex_strength: 0.0,
        plane_enabled: false,
        plane_normal: fm.vec3(0.0, 1.0, 0.0),
        plane_d: 0.0,
        plane_restitution: 0.65,
        plane_friction: 0.15,
        color_keys: colors,
        emissive_scale: 1.0,
        start_additive: 0.0,
        end_additive: 0.0,
        billboard_mode: PARTICLE_BILLBOARD_CAMERA,
        visual_mode: PARTICLE_VISUAL_SOFT_DISC,
        radial_power: 1.5,
        ring_inner: 0.45,
        atlas_cols: 1,
        atlas_rows: 1,
        atlas_cycles: 1.0,
        depth_test: true,
        soft_distance: 0.35
    }
}

fn vec3_finite_ok(v fm.Vec3) bool {
    << fm.finite(v.x) && fm.finite(v.y) && fm.finite(v.z) &&
        math.abs(v.x) <= 1000000.0 && math.abs(v.y) <= 1000000.0 && math.abs(v.z) <= 1000000.0
}

pub fn (cfg &ParticleEmitter3D) validate() int {
    if !vec3_finite_ok(cfg.origin) || !vec3_finite_ok(cfg.direction) || !vec3_finite_ok(cfg.base_velocity) ||
        !vec3_finite_ok(cfg.gravity) || !vec3_finite_ok(cfg.wind) ||
        !vec3_finite_ok(cfg.attractor_pos) || !vec3_finite_ok(cfg.vortex_axis) || !vec3_finite_ok(cfg.plane_normal) {
        >>> errors.new("nexus particles: non-finite or out-of-range vector")
    }
    if cfg.direction.dot(cfg.direction) <= 1e-12 {
        >>> errors.new("nexus particles: emitter direction cannot be zero")
    }
    if cfg.vortex_axis.dot(cfg.vortex_axis) <= 1e-12 {
        >>> errors.new("nexus particles: vortex axis cannot be zero")
    }
    if cfg.plane_enabled && cfg.plane_normal.dot(cfg.plane_normal) <= 1e-12 {
        >>> errors.new("nexus particles: collision plane normal cannot be zero")
    }
    if cfg.shape < 0 || cfg.shape > 4 || cfg.billboard_mode < 0 || cfg.billboard_mode > 2 || cfg.visual_mode < 0 || cfg.visual_mode > 2 {
        >>> errors.new("nexus particles: invalid emitter shape, billboard or visual mode")
    }
    if !fm.finite(cfg.shape_param0) || !fm.finite(cfg.shape_param1) || !fm.finite(cfg.box_hz) ||
        cfg.shape_param0 < 0.0 || cfg.shape_param1 < 0.0 || cfg.box_hz < 0.0 {
        >>> errors.new("nexus particles: invalid emitter shape dimensions")
    }
    if !fm.finite(cfg.emit_rate) || cfg.emit_rate < 0.0 || cfg.emit_rate > 1000000.0 ||
        !fm.finite(cfg.speed_min) || !fm.finite(cfg.speed_max) || cfg.speed_max < cfg.speed_min ||
        !fm.finite(cfg.velocity_spread) || cfg.velocity_spread < 0.0 ||
        !fm.finite(cfg.life_min) || !fm.finite(cfg.life_max) || cfg.life_min <= 0.0 || cfg.life_max < cfg.life_min ||
        !fm.finite(cfg.size_start_min) || !fm.finite(cfg.size_start_max) || cfg.size_start_min <= 0.0 || cfg.size_start_max < cfg.size_start_min ||
        !fm.finite(cfg.size_end_scale) || cfg.size_end_scale < 0.0 {
        >>> errors.new("nexus particles: invalid speed, life or size range")
    }
    if !fm.finite(cfg.rotation_range) || cfg.rotation_range < 0.0 ||
        !fm.finite(cfg.angular_vel_min) || !fm.finite(cfg.angular_vel_max) || cfg.angular_vel_max < cfg.angular_vel_min ||
        !fm.finite(cfg.stretch_factor) || cfg.stretch_factor < 0.0 ||
        !fm.finite(cfg.drag) || cfg.drag < 0.0 ||
        !fm.finite(cfg.turbulence_strength) || cfg.turbulence_strength < 0.0 ||
        !fm.finite(cfg.turbulence_freq) || cfg.turbulence_freq < 0.0 || !fm.finite(cfg.turbulence_scroll) ||
        !fm.finite(cfg.attractor_strength) || !fm.finite(cfg.vortex_strength) {
        >>> errors.new("nexus particles: invalid force or rotation field")
    }
    if !fm.finite(cfg.plane_d) || !fm.finite(cfg.plane_restitution) || cfg.plane_restitution < 0.0 || cfg.plane_restitution > 1.5 ||
        !fm.finite(cfg.plane_friction) || cfg.plane_friction < 0.0 || cfg.plane_friction > 1.0 {
        >>> errors.new("nexus particles: invalid plane collision parameters")
    }
    if cfg.color_keys.len != 16 {
        >>> errors.new("nexus particles: color_keys must contain 16 floats (4 RGBA stops)")
    }
    for i in 0:16 {
        c := cfg.color_keys[i]
        if !fm.finite(c) || c < 0.0 || c > 100.0 {
            >>> errors.new("nexus particles: color key channel out of range 0..100")
        }
    }
    if !fm.finite(cfg.emissive_scale) || cfg.emissive_scale < 0.0 || cfg.emissive_scale > 100.0 ||
        !fm.finite(cfg.start_additive) || cfg.start_additive < 0.0 || cfg.start_additive > 1.0 ||
        !fm.finite(cfg.end_additive) || cfg.end_additive < 0.0 || cfg.end_additive > 1.0 {
        >>> errors.new("nexus particles: invalid emissive or additive factor")
    }
    if !fm.finite(cfg.radial_power) || cfg.radial_power <= 0.0 || cfg.radial_power > 16.0 ||
        !fm.finite(cfg.ring_inner) || cfg.ring_inner < 0.05 || cfg.ring_inner > 0.8 ||
        cfg.atlas_cols < 1 || cfg.atlas_cols > 64 || cfg.atlas_rows < 1 || cfg.atlas_rows > 64 ||
        !fm.finite(cfg.atlas_cycles) || cfg.atlas_cycles <= 0.0 ||
        !fm.finite(cfg.soft_distance) || cfg.soft_distance < 0.0 || cfg.soft_distance > 100.0 {
        >>> errors.new("nexus particles: invalid visual shape, atlas or soft depth parameters")
    }
    << 0
}

fn clone_emitter_3d(src &ParticleEmitter3D) ParticleEmitter3D {
    $keys := []f64{}
    for i in 0:src.color_keys.len { keys.push(src.color_keys[i]) }
    << ParticleEmitter3D{
        origin: src.origin,
        direction: src.direction,
        base_velocity: src.base_velocity,
        shape: src.shape,
        shape_param0: src.shape_param0,
        shape_param1: src.shape_param1,
        box_hz: src.box_hz,
        emit_rate: src.emit_rate,
        emitting: src.emitting,
        speed_min: src.speed_min,
        speed_max: src.speed_max,
        velocity_spread: src.velocity_spread,
        life_min: src.life_min,
        life_max: src.life_max,
        size_start_min: src.size_start_min,
        size_start_max: src.size_start_max,
        size_end_scale: src.size_end_scale,
        size_bell_curve: src.size_bell_curve,
        rotation_range: src.rotation_range,
        angular_vel_min: src.angular_vel_min,
        angular_vel_max: src.angular_vel_max,
        stretch_factor: src.stretch_factor,
        gravity: src.gravity,
        wind: src.wind,
        drag: src.drag,
        turbulence_strength: src.turbulence_strength,
        turbulence_freq: src.turbulence_freq,
        turbulence_scroll: src.turbulence_scroll,
        attractor_pos: src.attractor_pos,
        attractor_strength: src.attractor_strength,
        vortex_axis: src.vortex_axis,
        vortex_strength: src.vortex_strength,
        plane_enabled: src.plane_enabled,
        plane_normal: src.plane_normal,
        plane_d: src.plane_d,
        plane_restitution: src.plane_restitution,
        plane_friction: src.plane_friction,
        color_keys: keys,
        emissive_scale: src.emissive_scale,
        start_additive: src.start_additive,
        end_additive: src.end_additive,
        billboard_mode: src.billboard_mode,
        visual_mode: src.visual_mode,
        radial_power: src.radial_power,
        ring_inner: src.ring_inner,
        atlas_cols: src.atlas_cols,
        atlas_rows: src.atlas_rows,
        atlas_cycles: src.atlas_cycles,
        depth_test: src.depth_test,
        soft_distance: src.soft_distance
    }
}

pub struct ParticleStats3D {
    pub capacity int
    pub alive_count int
    pub spawned_last_step int
    pub collisions_last_step int
}

pub struct GpuParticleSystem3D {
    owner DeviceRef3D
    compute []gpu.ComputePipeline
    pipelines []gpu.GraphicsPipeline // [0]=RGBA16_FLOAT (HDR), [1]=RGBA8_UNORM (Device3D)
    samplers []gpu.Sampler           // [0]=nearest depth sampler
    buffers []gpu.Buffer             // [0]=particles (64*cap), [1]=alive_indices (4*cap), [2]=counters (32B)
    sprite_tex TextureRef3D
    emitter ParticleEmitter3D
    capacity int
    seed int
    frame_counter int
    elapsed f64
    emit_accum f64
    pending_burst int
    closed bool
}

fn counter_reset_bytes() []u8 {
    order := binary.little_endian()
    $bytes := zero_bytes(32)
    order.put_u32_bytes($&bytes, 0, 6) >>>
    << bytes
}

fn particle_pipeline_for_format(dev &gpu.Device, vs &gpu.Shader, fs &gpu.Shader, color_format int) gpu.GraphicsPipeline {
    $desc := gpu.pipeline_defaults(color_format)
    desc.primitive = gpu.TRIANGLES
    desc.cull = gpu.CULL_NONE
    desc.depth_format = 0
    desc.depth_compare = gpu.DEPTH_DISABLED
    desc.depth_write = false
    desc.blend = gpu.BLEND_PREMULTIPLIED
    << dev.graphics_pipeline(vs, fs, &desc) >>>
}

pub fn (device &Device3D) gpu_particle_system(program &ParticleProgram3D, capacity int, seed int) GpuParticleSystem3D {
    device.alive() >>>
    if device.active { >>> errors.new("nexus particles: create GPU particle system outside a frame") }
    if !device.is_gpu() { >>> errors.new("nexus particles: GPU particle system requires GPU backend") }
    if capacity < 1 || capacity > MAX_GPU_PARTICLES {
        >>> errors.new("nexus particles: capacity must be in 1..131072")
    }
    dev := device.gpu_device() >>>
    if (dev.shader_formats() & program.format) == 0 || program.entrypoint.len == 0 ||
        program.sim_compute.len == 0 || program.vertex.len == 0 || program.fragment.len == 0 {
        >>> errors.new("nexus particles: invalid or incomplete particle shader program")
    }

    p_bytes := capacity * 64
    idx_bytes := capacity * 4
    cnt_bytes := 32
    total_bytes := p_bytes + idx_bytes + cnt_bytes
    stats := dev.stats() >>>
    if stats.buffer_count + 3 > 1024 || total_bytes > 67108864 - stats.buffer_bytes {
        >>> errors.new("nexus particles: exceeds GPU 1024-buffer or 64 MiB buffer budget")
    }

    cdesc := gpu.ComputeResourcesDesc{
        format: program.format,
        entrypoint: program.entrypoint + "",
        samplers: 0,
        read_textures: 0,
        read_buffers: 0,
        write_textures: 0,
        write_buffers: 3,
        uniform_sizes: [256],
        threads_x: 64,
        threads_y: 1,
        threads_z: 1
    }
    $comp := dev.compute_pipeline_with_resources(&cdesc, &program.sim_compute) >>>

    vs_desc := gpu.ShaderResourcesDesc{
        stage: gpu.VERTEX,
        format: program.format,
        entrypoint: program.entrypoint + "",
        samplers: 0,
        storage_textures: 0,
        storage_buffers: 2,
        uniform_sizes: [256]
    }
    fs_desc := gpu.ShaderResourcesDesc{
        stage: gpu.FRAGMENT,
        format: program.format,
        entrypoint: program.entrypoint + "",
        samplers: 2,
        storage_textures: 0,
        storage_buffers: 0,
        uniform_sizes: [112]
    }
    $vs := dev.shader_with_resources(&vs_desc, &program.vertex) >>>
    $fs := dev.shader_with_resources(&fs_desc, &program.fragment) >>>
    $pipe_hdr := particle_pipeline_for_format(dev, &vs, &fs, layout.RGBA16_FLOAT) >>>
    $pipe_sdr := particle_pipeline_for_format(dev, &vs, &fs, layout.RGBA8_UNORM) >>>
    vs.close() >>>
    fs.close() >>>

    $sdesc := gpu.sampler_defaults()
    sdesc.min_filter = gpu.NEAREST
    sdesc.mag_filter = gpu.NEAREST
    sdesc.mip_filter = gpu.NEAREST
    $depth_samp := dev.sampler(sdesc) >>>

    buf_usage := gpu.BUFFER_COMPUTE_STORAGE_READ | gpu.BUFFER_COMPUTE_STORAGE_WRITE | gpu.BUFFER_GRAPHICS_STORAGE_READ
    cnt_usage := gpu.BUFFER_COMPUTE_STORAGE_READ | gpu.BUFFER_COMPUTE_STORAGE_WRITE | gpu.BUFFER_INDIRECT
    $p_buf := dev.buffer(p_bytes, buf_usage) >>>
    $idx_buf := dev.buffer(idx_bytes, buf_usage) >>>
    $cnt_buf := dev.buffer(cnt_bytes, cnt_usage) >>>

    zeros_p := zero_bytes(p_bytes)
    $u0 := dev.upload(&p_buf, 0, &zeros_p) >>>
    u0.close() >>>
    zeros_i := zero_bytes(idx_bytes)
    $u1 := dev.upload(&idx_buf, 0, &zeros_i) >>>
    u1.close() >>>
    rst := counter_reset_bytes() >>>
    $u2 := dev.upload(&cnt_buf, 0, &rst) >>>
    u2.close() >>>

    def_emit := default_particle_emitter_3d(fm.vec3(0.0, 0.0, 0.0))
    << GpuParticleSystem3D{
        owner: device.reference(),
        compute: [comp],
        pipelines: [pipe_hdr, pipe_sdr],
        samplers: [depth_samp],
        buffers: [p_buf, idx_buf, cnt_buf],
        sprite_tex: no_texture(),
        emitter: def_emit,
        capacity: capacity,
        seed: seed,
        frame_counter: 0,
        elapsed: 0.0,
        emit_accum: 0.0,
        pending_burst: 0,
        closed: false
    }
}

pub fn (sys $&GpuParticleSystem3D) set_emitter(cfg &ParticleEmitter3D) int {
    if sys.closed { >>> errors.new("nexus particles: particle system is closed") }
    cfg.validate() >>>
    sys.emitter = clone_emitter_3d(cfg)
    << 0
}

pub fn (sys $&GpuParticleSystem3D) set_sprite_texture(tex TextureRef3D) int {
    if sys.closed { >>> errors.new("nexus particles: particle system is closed") }
    if !tex.present || !tex.has_gpu {
        >>> errors.new("nexus particles: sprite texture must be a live GPU texture")
    }
    sys.sprite_tex = tex
    << 0
}

pub fn (sys $&GpuParticleSystem3D) clear_sprite_texture() {
    sys.sprite_tex = no_texture()
}

pub fn (sys $&GpuParticleSystem3D) burst(count int) int {
    if sys.closed { >>> errors.new("nexus particles: particle system is closed") }
    if count < 0 || count > MAX_GPU_PARTICLES {
        >>> errors.new("nexus particles: burst count out of range")
    }
    sys.pending_burst += count
    if sys.pending_burst > MAX_GPU_PARTICLES { sys.pending_burst = MAX_GPU_PARTICLES }
    << 0
}

pub fn (sys $&GpuParticleSystem3D) reset(device &Device3D) int {
    device.alive() >>>
    if device.active { >>> errors.new("nexus particles: reset outside a frame") }
    if sys.closed || !sys.owner.matches(device) {
        >>> errors.new("nexus particles: closed or foreign particle system")
    }
    dev := device.gpu_device() >>>
    zeros_p := zero_bytes(sys.capacity * 64)
    $u0 := dev.upload(&sys.buffers[0], 0, &zeros_p) >>>
    u0.close() >>>
    rst := counter_reset_bytes() >>>
    $u1 := dev.upload(&sys.buffers[2], 0, &rst) >>>
    u1.close() >>>
    sys.elapsed = 0.0
    sys.emit_accum = 0.0
    sys.pending_burst = 0
    sys.frame_counter = 0
    << 0
}

fn push_vec4_scalars(dst $&[]int, a f64, b f64, c f64, d f64) int {
    wa := scalar_word(a) >>>
    wb := scalar_word(b) >>>
    wc := scalar_word(c) >>>
    wd := scalar_word(d) >>>
    dst.push(wa)
    dst.push(wb)
    dst.push(wc)
    dst.push(wd)
    << 0
}

fn safe_norm_3(v fm.Vec3, fallback fm.Vec3) fm.Vec3 {
    if v.dot(v) <= 1e-12 { << fallback }
    << v.normalized() >>>
}

fn build_sim_params_bytes(sys &GpuParticleSystem3D, dt f64, spawn_count int) []u8 {
    e := &sys.emitter
    dir_n := safe_norm_3(e.direction, fm.vec3(0.0, 1.0, 0.0)) >>>
    vort_n := safe_norm_3(e.vortex_axis, fm.vec3(0.0, 1.0, 0.0)) >>>
    $plane_n := fm.vec3(0.0, 1.0, 0.0)
    $plane_en := 0.0
    if e.plane_enabled {
        plane_n = e.plane_normal.normalized() >>>
        plane_en = 1.0
    }
    gw := e.gravity.add(e.wind)
    $w := []int{}
    // 0: time_counts
    push_vec4_scalars($&w, dt, sys.elapsed, f64(sys.capacity), f64(spawn_count)) >>>
    // 1: seed_shape
    seed_mix := f64(((sys.seed ^ sys.frame_counter) & 16777215) + 1)
    push_vec4_scalars($&w, seed_mix, f64(e.shape), e.shape_param0, e.shape_param1) >>>
    // 2: origin_boxz
    push_vec4_scalars($&w, e.origin.x, e.origin.y, e.origin.z, e.box_hz) >>>
    // 3: dir_spread
    push_vec4_scalars($&w, dir_n.x, dir_n.y, dir_n.z, e.velocity_spread) >>>
    // 4: base_vel_drag
    push_vec4_scalars($&w, e.base_velocity.x, e.base_velocity.y, e.base_velocity.z, e.drag) >>>
    // 5: speed_life
    push_vec4_scalars($&w, e.speed_min, e.speed_max, e.life_min, e.life_max) >>>
    // 6: size_rot
    push_vec4_scalars($&w, e.size_start_min, e.size_start_max, e.size_end_scale, e.rotation_range) >>>
    // 7: ang_stretch_add
    push_vec4_scalars($&w, e.angular_vel_min, e.angular_vel_max, e.stretch_factor, e.start_additive) >>>
    // 8: end_add_pad
    push_vec4_scalars($&w, e.end_additive, e.turbulence_strength, e.turbulence_freq, e.turbulence_scroll) >>>
    // 9: gravity_wind
    push_vec4_scalars($&w, gw.x, gw.y, gw.z, 0.0) >>>
    // 10: attractor
    push_vec4_scalars($&w, e.attractor_pos.x, e.attractor_pos.y, e.attractor_pos.z, e.attractor_strength) >>>
    // 11: vortex
    push_vec4_scalars($&w, vort_n.x, vort_n.y, vort_n.z, e.vortex_strength) >>>
    // 12: plane_eq
    push_vec4_scalars($&w, plane_n.x, plane_n.y, plane_n.z, e.plane_d) >>>
    // 13: plane_mat
    push_vec4_scalars($&w, plane_en, e.plane_restitution, e.plane_friction, 0.0) >>>
    // 14..15: reserved
    push_vec4_scalars($&w, 0.0, 0.0, 0.0, 0.0) >>>
    push_vec4_scalars($&w, 0.0, 0.0, 0.0, 0.0) >>>
    << word_bytes(&w) >>>
}

pub fn (sys $&GpuParticleSystem3D) step(device &Device3D, dt f64) int {
    device.alive() >>>
    if device.active { >>> errors.new("nexus particles: step must run before device.begin") }
    if sys.closed || !sys.owner.matches(device) {
        >>> errors.new("nexus particles: closed or foreign particle system")
    }
    if !fm.finite(dt) || dt < 0.0 || dt > 1.0 {
        >>> errors.new("nexus particles: dt must be in 0..1")
    }
    sys.emitter.validate() >>>

    $spawn_count := sys.pending_burst
    sys.pending_burst = 0
    if sys.emitter.emitting && sys.emitter.emit_rate > 0.0 && dt > 0.0 {
        sys.emit_accum += sys.emitter.emit_rate * dt
        n := int(math.floor(sys.emit_accum))
        if n > 0 {
            sys.emit_accum -= f64(n)
            spawn_count += n
        }
    }
    if spawn_count > sys.capacity { spawn_count = sys.capacity }

    sys.elapsed += dt
    sys.frame_counter += 1

    dev := device.gpu_device() >>>
    rst := counter_reset_bytes() >>>
    $u_cnt := dev.upload(&sys.buffers[2], 0, &rst) >>>
    u_cnt.close() >>>

    params := build_sim_params_bytes(sys, dt, spawn_count) >>>
    $enc := dev.command_encoder() >>>
    tw_empty := []gpu.StorageTextureWrite{}
    // CRITICAL: cycle=false preserves persistent particles state and reset counters!
    bw := [gpu.write_buffer(&sys.buffers[0], false), gpu.write_buffer(&sys.buffers[1], false), gpu.write_buffer(&sys.buffers[2], false)]
    $pass := enc.begin_compute_with_resources(&tw_empty, &bw) >>>
    pass.pipeline(&sys.compute[0]) >>>
    pass.uniform(0, &params) >>>
    groups := (sys.capacity + 63) / 64
    pass.dispatch(groups, 1, 1) >>>
    pass.end() >>>
    $fence := enc.submit() >>>
    fence.wait() >>>
    fence.close() >>>
    << 0
}

fn build_draw_uniforms(sys &GpuParticleSystem3D, width int, height int, view fm.Mat4, proj fm.Mat4) []u8 {
    vp := proj.multiply(view)
    inv_proj := mat4_inverse(proj) >>>
    // View matrix rows 0 and 1 are camera right and camera up in world space.
    cam_r := safe_norm_3(fm.vec3(view.c0.x, view.c1.x, view.c2.x), fm.vec3(1.0, 0.0, 0.0)) >>>
    cam_u := safe_norm_3(fm.vec3(view.c0.y, view.c1.y, view.c2.y), fm.vec3(0.0, 1.0, 0.0)) >>>
    e := &sys.emitter

    $vw := []int{}
    for w in matrix_words(vp) >>> { vw.push(w) }
    for w in matrix_words(view) >>> { vw.push(w) }
    push_vec4_scalars($&vw, cam_r.x, cam_r.y, cam_r.z, f64(e.billboard_mode)) >>>
    push_vec4_scalars($&vw, cam_u.x, cam_u.y, cam_u.z, e.atlas_cycles) >>>
    for k in 0:4 {
        b := k * 4
        i1 := b + 1
        i2 := b + 2
        i3 := b + 3
        push_vec4_scalars($&vw, e.color_keys[b], e.color_keys[i1], e.color_keys[i2], e.color_keys[i3]) >>>
    }
    push_vec4_scalars($&vw, f64(e.atlas_cols), f64(e.atlas_rows), e.emissive_scale, 0.1) >>>
    $curve_mode := 0.0
    if e.size_bell_curve { curve_mode = 1.0 }
    push_vec4_scalars($&vw, curve_mode, 0.0, 0.0, 0.0) >>>
    vbytes := word_bytes(&vw) >>>

    $fw := []int{}
    for w in matrix_words(inv_proj) >>> { fw.push(w) }
    push_vec4_scalars($&fw, f64(width), f64(height), e.soft_distance, f64(e.visual_mode)) >>>
    $dtest := 0.0
    if e.depth_test { dtest = 1.0 }
    push_vec4_scalars($&fw, dtest, e.radial_power, e.ring_inner, 0.0) >>>
    push_vec4_scalars($&fw, 0.0, 0.0, 0.0, 0.0) >>>
    fbytes := word_bytes(&fw) >>>

    $packed := []u8{}
    for b in vbytes { packed.push(b) }
    for b in fbytes { packed.push(b) }
    << packed
}

fn (sys &GpuParticleSystem3D) record_billboard_pass(
    device &Device3D,
    enc &gpu.CommandEncoder,
    color_tex &gpu.Texture,
    depth_tex &gpu.Texture,
    pipe_idx int,
    width int,
    height int,
    view fm.Mat4,
    proj fm.Mat4
) int {
    packed := build_draw_uniforms(sys, width, height, view, proj) >>>
    $vbytes := []u8{}
    for i in 0:256 { vbytes.push(packed[i]) }
    $fbytes := []u8{}
    for i in 256:368 { fbytes.push(packed[i]) }

    c0 := gpu.ColorAttachment{
        view: color_tex.view(0) >>>,
        load: gpu.LOAD,
        store: gpu.STORE,
        clear: gpu.Color{r: 0.0, g: 0.0, b: 0.0, a: 0.0}
    }
    $pass := enc.begin_render(c0, gpu.no_depth()) >>>
    pass.pipeline(&sys.pipelines[pipe_idx]) >>>
    pass.uniform(gpu.VERTEX, 0, &vbytes) >>>
    pass.storage_buffer(gpu.VERTEX, 0, &sys.buffers[0]) >>>
    pass.storage_buffer(gpu.VERTEX, 1, &sys.buffers[1]) >>>
    if sys.sprite_tex.present {
        pass.sampler_ref(gpu.FRAGMENT, 0, sys.sprite_tex.image, sys.sprite_tex.sampler) >>>
    } else {
        pass.sampler(gpu.FRAGMENT, 0, &device.whites[0], &device.linear_samplers[0]) >>>
    }
    pass.sampler(gpu.FRAGMENT, 1, depth_tex, &sys.samplers[0]) >>>
    pass.uniform(gpu.FRAGMENT, 0, &fbytes) >>>
    pass.draw_indirect(&sys.buffers[2], 0, 1) >>>
    pass.end() >>>
    << 0
}

pub fn (sys &GpuParticleSystem3D) draw_into_hdr(
    device &Device3D,
    hdr $&HdrTarget3D,
    view fm.Mat4,
    proj fm.Mat4
) int {
    device.alive() >>>
    if device.active { >>> errors.new("nexus particles: end Device3D frame before draw_into_hdr") }
    if sys.closed || !sys.owner.matches(device) {
        >>> errors.new("nexus particles: closed or foreign particle system")
    }
    if hdr.closed || hdr.active || !hdr.owner.matches(device) || hdr.textures.len < 3 {
        >>> errors.new("nexus particles: invalid, closed or active HdrTarget3D")
    }
    if !view.is_affine() || !proj.is_finite() {
        >>> errors.new("nexus particles: invalid camera matrices")
    }
    dev := device.gpu_device() >>>
    $enc := dev.command_encoder() >>>
    sys.record_billboard_pass(device, &enc, &hdr.textures[0], &hdr.textures[2], 0, hdr.width, hdr.height, view, proj) >>>
    $fence := enc.submit() >>>
    fence.wait() >>>
    fence.close() >>>
    hdr.ready = true
    << 0
}

pub fn (sys &GpuParticleSystem3D) draw_into_device(
    device $&Device3D,
    view fm.Mat4,
    proj fm.Mat4
) int {
    device.alive() >>>
    if !device.is_gpu() { >>> errors.new("nexus particles: draw_into_device requires GPU backend") }
    if sys.closed || !sys.owner.matches(device) {
        >>> errors.new("nexus particles: closed or foreign particle system")
    }
    if !view.is_affine() || !proj.is_finite() {
        >>> errors.new("nexus particles: invalid camera matrices")
    }
    if device.targets.len < 2 {
        >>> errors.new("nexus particles: Device3D targets unavailable")
    }
    w := device.target_width * device.render_scale
    h := device.target_height * device.render_scale

    if device.active {
        if device.sealed { >>> errors.new("nexus particles: cannot draw particles after frame seal") }
        device.pause_render_pass() >>>
        enc := &device.encoders[0]
        sys.record_billboard_pass(device, enc, &device.targets[0], &device.targets[1], 1, w, h, view, proj) >>> (err){
            device.abandon_frame()
            >>> err
        }
        device.resume_render_pass() >>>
    } else {
        dev := device.gpu_device() >>>
        $enc := dev.command_encoder() >>>
        sys.record_billboard_pass(device, &enc, &device.targets[0], &device.targets[1], 1, w, h, view, proj) >>>
        $fence := enc.submit() >>>
        fence.wait() >>>
        fence.close() >>>
    }
    device.cached = false
    device.draw_count += 1
    << 0
}

pub fn (sys &GpuParticleSystem3D) readback_stats(device &Device3D) ParticleStats3D {
    device.alive() >>>
    if device.active { >>> errors.new("nexus particles: readback_stats must run outside a frame") }
    if sys.closed || !sys.owner.matches(device) {
        >>> errors.new("nexus particles: closed or foreign particle system")
    }
    dev := device.gpu_device() >>>
    $rb := dev.download(&sys.buffers[2], 0, 32) >>>
    rb.wait() >>>
    $raw := zero_bytes(32)
    rb.read($&raw) >>>
    rb.close() >>>
    order := binary.little_endian()
    alive := order.get_u32_bytes(&raw, 4) >>>
    spawned := order.get_u32_bytes(&raw, 20) >>>
    collisions := order.get_u32_bytes(&raw, 24) >>>
    << ParticleStats3D{
        capacity: sys.capacity,
        alive_count: alive,
        spawned_last_step: spawned,
        collisions_last_step: collisions
    }
}

pub fn (sys &GpuParticleSystem3D) readback_sample_positions(device &Device3D, max_count int) []fm.Vec3 {
    stats := sys.readback_stats(device) >>>
    $n := stats.alive_count
    if max_count < n { n = max_count }
    if n <= 0 { << []fm.Vec3{} }

    dev := device.gpu_device() >>>
    $rb_i := dev.download(&sys.buffers[1], 0, n * 4) >>>
    rb_i.wait() >>>
    $raw_i := zero_bytes(n * 4)
    rb_i.read($&raw_i) >>>
    rb_i.close() >>>

    order := binary.little_endian()
    $out := []fm.Vec3{}
    for k in 0:n {
        pid := order.get_u32_bytes(&raw_i, k * 4) >>>
        if pid >= 0 && pid < sys.capacity {
            $rb_p := dev.download(&sys.buffers[0], pid * 64, 16) >>>
            rb_p.wait() >>>
            $raw_p := zero_bytes(16)
            rb_p.read($&raw_p) >>>
            rb_p.close() >>>
            px := order.get_f32(&raw_p, 0) >>>
            py := order.get_f32(&raw_p, 4) >>>
            pz := order.get_f32(&raw_p, 8) >>>
            out.push(fm.vec3(px, py, pz))
        }
    }
    << out
}

pub fn (sys &GpuParticleSystem3D) capacity_limit() int { << sys.capacity }

pub fn (sys &GpuParticleSystem3D) elapsed_time() f64 { << sys.elapsed }

pub fn (sys $&GpuParticleSystem3D) close() int {
    if sys.closed { << 0 }
    for i in 0:sys.compute.len {
        c := $&sys.compute[i]
        c.close() >>>
    }
    for i in 0:sys.pipelines.len {
        p := $&sys.pipelines[i]
        p.close() >>>
    }
    for i in 0:sys.samplers.len {
        s := $&sys.samplers[i]
        s.close() >>>
    }
    for i in 0:sys.buffers.len {
        b := $&sys.buffers[i]
        b.close() >>>
    }
    sys.compute = []gpu.ComputePipeline{}
    sys.pipelines = []gpu.GraphicsPipeline{}
    sys.samplers = []gpu.Sampler{}
    sys.buffers = []gpu.Buffer{}
    sys.sprite_tex = no_texture()
    sys.closed = true
    << 0
}

fn (sys $&GpuParticleSystem3D) drop() {
    sys.close() >>> (err) { << }
}
