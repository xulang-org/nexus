@"github.com/xulang-org/game/rendering/three_d"

#errors
#strings
#image/png
#gpu

fn (device $&Device3D) snapshot() int {
    device.recording() or >>
    if device.cached { << 0 }
    device.seal() or >>
    if !device.is_gpu() { << 0 }
    $read := snapshot_texture(device) or >>
    read.wait() or >>
    $pixels := []u8{}
    for i in 0:read.size_bytes() { pixels.push(u8(0)) }
    read.read($&pixels) or >>
    read.close() or >>
    device.pixels = pixels
    device.cached = true
    << 0
}
fn snapshot_texture(device &Device3D) gpu.Readback {
    dev := device.gpu_device() or >>
    if device.render_scale==2 { << dev.download_texture(&device.targets[2],0) or >> }
    << dev.download_texture(&device.targets[0],0) or >>
}
// One full target read per drawing revision; subsequent reads reuse CPU bytes.
// A later submit invalidates the cache and remains legal within this frame.
pub fn (device $&Device3D) read_pixel(x int, y int) int {
    device.recording() or >>
    if x < 0 || y < 0 || x >= device.target_width || y >= device.target_height {
        >> errors.new("game 3D: read pixel outside output")
    }
    device.snapshot() or >>
    offset := (y*device.target_width+x)*4
    << (int(device.pixels[offset]) << 24) | (int(device.pixels[offset+1]) << 16) |
        (int(device.pixels[offset+2]) << 8) | int(device.pixels[offset+3])
}
// Explicit diagnostics; PNG encoding is the Xu standard codec, with no SDL GPU
// or image-codec bridge. Pixel allocation is bounded by the output policy.
pub fn (device $&Device3D) capture(path string) int {
    device.snapshot() or >>
    $bytes := strings.new_byte_builder(device.pixels.len)
    for value in device.pixels { bytes.write_byte(int(value)) }
    raw := bytes.to_string()
    encoded := png.encode_rgba_bytes(&raw,device.target_width,device.target_height) or >>
    write_file(path,encoded) or >>
    << 0
}
