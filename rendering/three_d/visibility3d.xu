@"github.com/xulang-org/game/rendering/three_d"

fm #"github.com/xulang-org/game/foundation/math"

fn rounded_column(column fm.Vec4) fm.Vec4 {
    xyz := rounded_vec(column.xyz()) or >>
    w := rounded(column.w) or >>
    << fm.vec4(xyz.x,xyz.y,xyz.z,w)
}
fn clip_visible(bounds fm.Aabb3, mvp fm.Mat4) bool {
    // The vertex shader receives the packed MVP product, not a product of
    // independently quantized view/projection/model matrices.
    a := rounded_column(mvp.c0) or >>
    b := rounded_column(mvp.c1) or >>
    c := rounded_column(mvp.c2) or >>
    d := rounded_column(mvp.c3) or >>
    packed := fm.Mat4{c0: a,c1: b,c2: c,c3: d}
    << bounds.intersects_clip(packed,0.00001,1e-36) or >>
}
fn validate_matrix_values(matrix fm.Mat4) int {
    for column in [matrix.c0,matrix.c1,matrix.c2,matrix.c3] {
        for value in [column.x,column.y,column.z,column.w] { scalar_word(value) or >> }
    }
    << 0
}
// Queries still validate weak resources and the same scalar/transform contract
// as a submitted draw. An offscreen binding cannot hide stale/foreign objects.
pub fn (owner &DeviceRef3D) mesh_in_view(mesh MeshRef3D, model_view_projection fm.Mat4) bool {
    owner.validate_mesh(mesh,false) or >>
    << clip_visible(mesh.bounds,model_view_projection) or >>
}
pub fn (owner &DeviceRef3D) material_in_view(mesh MeshRef3D, world fm.Mat4, view_projection fm.Mat4,
    material &Material3D) bool {
    owner.validate_material(mesh,material) or >>
    inverse := world.affine_inverse() or >>
    validate_matrix_values(world) or >>
    validate_matrix_values(inverse.transposed()) or >>
    << clip_visible(mesh.bounds,view_projection.multiply(world)) or >>
}
