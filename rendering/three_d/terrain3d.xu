@"github.com/xulang-org/nexus/rendering/three_d"

#gpu
layout #gpu/layout
#encoding/binary
#errors
#math
fm #"github.com/xulang-org/nexus/foundation/math"

pub struct TerrainProgram3D {
    pub format int
    pub entrypoint string
    pub vertex []u8
    pub fragment []u8
}

pub fn empty_terrain_program_3d() TerrainProgram3D {
    << TerrainProgram3D{
        format: 0,
        entrypoint: "",
        vertex: []u8{},
        fragment: []u8{}
    }
}

pub struct TerrainLayer3D {
    pub albedo fm.Vec3
    pub tile_scale f64
    pub roughness f64
    pub metallic f64
    pub height_bias f64
    pub texture TextureRef3D
}

pub fn default_terrain_layer_3d(albedo fm.Vec3, roughness f64, tile_scale f64) TerrainLayer3D {
    << TerrainLayer3D{
        albedo: albedo,
        tile_scale: tile_scale,
        roughness: roughness,
        metallic: 0.0,
        height_bias: 0.0,
        texture: no_texture()
    }
}

pub struct TerrainMaterial3D {
    pub splat_texture TextureRef3D
    pub layers []TerrainLayer3D // exactly 4 layers (R, G, B, A)
    pub origin_x f64
    pub origin_z f64
    pub size_x f64
    pub size_z f64
    pub blend_sharpness f64
    pub use_world_uv bool
    pub exposure f64
}

pub fn default_terrain_material_3d(origin_x f64, origin_z f64, size_x f64, size_z f64) TerrainMaterial3D {
    layers := [default_terrain_layer_3d(fm.vec3(0.24, 0.56, 0.18), 0.85, 0.25), default_terrain_layer_3d(fm.vec3(0.48, 0.34, 0.20), 0.90, 0.30), default_terrain_layer_3d(fm.vec3(0.42, 0.44, 0.48), 0.78, 0.20), default_terrain_layer_3d(fm.vec3(0.92, 0.94, 0.98), 0.65, 0.20)]
    << TerrainMaterial3D{
        splat_texture: no_texture(),
        layers: layers,
        origin_x: origin_x,
        origin_z: origin_z,
        size_x: size_x,
        size_z: size_z,
        blend_sharpness: 2.0,
        use_world_uv: true,
        exposure: 1.0
    }
}

pub fn (mat &TerrainMaterial3D) validate(device &Device3D) int {
    if mat.layers.len != 4 {
        >> errors.new("nexus terrain 3D: TerrainMaterial3D requires exactly 4 layers")
    }
    if !fm.finite(mat.origin_x) || !fm.finite(mat.origin_z) ||
        !fm.finite(mat.size_x) || mat.size_x <= 0.0 ||
        !fm.finite(mat.size_z) || mat.size_z <= 0.0 {
        >> errors.new("nexus terrain 3D: invalid terrain world bounds")
    }
    if !fm.finite(mat.blend_sharpness) || mat.blend_sharpness < 0.0 || mat.blend_sharpness > 16.0 ||
        !fm.finite(mat.exposure) || mat.exposure <= 0.0 || mat.exposure > 32.0 {
        >> errors.new("nexus terrain 3D: invalid blend_sharpness or exposure")
    }
    dev := device.gpu_device() >>>
    dev_ref := dev.reference()
    if mat.splat_texture.present {
        dev_ref.validate_texture(mat.splat_texture.image) >>>
        dev_ref.validate_sampler(mat.splat_texture.sampler) >>>
    }
    for i in 0:4 {
        lay := &mat.layers[i]
        if !lay.albedo.is_finite() || lay.albedo.x < 0.0 || lay.albedo.y < 0.0 || lay.albedo.z < 0.0 ||
            !fm.finite(lay.tile_scale) || lay.tile_scale <= 0.0 ||
            !fm.finite(lay.roughness) || lay.roughness < 0.045 || lay.roughness > 1.0 ||
            !fm.finite(lay.metallic) || lay.metallic < 0.0 || lay.metallic > 1.0 ||
            !fm.finite(lay.height_bias) || lay.height_bias < -1.0 || lay.height_bias > 1.0 {
            >> errors.new("nexus terrain 3D: invalid layer PBR parameters")
        }
        if lay.texture.present {
            dev_ref.validate_texture(lay.texture.image) >>>
            dev_ref.validate_sampler(lay.texture.sampler) >>>
        }
    }
    << 0
}

pub struct TerrainRenderer3D {
    owner DeviceRef3D
    pipelines []gpu.GraphicsPipeline // [0]=HDR MRT (CULL_BACK), [1]=Device3D LDR (CULL_BACK)
    buffers []gpu.Buffer           // [0]=dummy 64B probe fallback
    closed bool
}

pub fn (device &Device3D) terrain_renderer(program &TerrainProgram3D) TerrainRenderer3D {
    device.alive() >>>
    if device.active { >> errors.new("nexus terrain 3D: create TerrainRenderer3D outside a frame") }
    if !device.is_gpu() { >> errors.new("nexus terrain 3D: TerrainRenderer3D requires GPU backend") }
    dev := device.gpu_device() >>>
    if (dev.shader_formats() & program.format) == 0 || program.entrypoint.len == 0 ||
        program.vertex.len == 0 || program.fragment.len == 0 {
        >> errors.new("nexus terrain 3D: invalid or unsupported terrain shader program")
    }
    stats := dev.stats() >>>
    if stats.buffer_count + 1 > 1024 || 64 > 67108864 - stats.buffer_bytes {
        >> errors.new("nexus terrain 3D: exceeds buffer count or 64 MiB VRAM budget")
    }

    vs_desc := gpu.ShaderResourcesDesc{
        stage: gpu.VERTEX,
        format: program.format,
        entrypoint: program.entrypoint + "",
        samplers: 0,
        storage_textures: 0,
        storage_buffers: 0,
        uniform_sizes: [192]
    }
    fs_desc := gpu.ShaderResourcesDesc{
        stage: gpu.FRAGMENT,
        format: program.format,
        entrypoint: program.entrypoint + "",
        samplers: 5,
        storage_textures: 0,
        storage_buffers: 4,
        uniform_sizes: [160, 80, 48]
    }
    $vs := dev.shader_with_resources(&vs_desc, &program.vertex) >>>
    $fs := dev.shader_with_resources(&fs_desc, &program.fragment) >>>

    $pdesc := mesh_pipeline()
    pdesc.cull = gpu.CULL_BACK
    mrt := [gpu.ColorTargetDesc{format: layout.RGBA16_FLOAT, blend: gpu.BLEND_DISABLED}, gpu.ColorTargetDesc{format: layout.RGBA16_FLOAT, blend: gpu.BLEND_DISABLED}]
    $p_hdr := dev.graphics_pipeline_targets(&vs, &fs, &pdesc, &mrt) >>>
    $p_dev := dev.graphics_pipeline(&vs, &fs, &pdesc) >>>
    vs.close() >>>
    fs.close() >>>

    $dummy_probe := dev.buffer(64, gpu.BUFFER_GRAPHICS_STORAGE_READ) >>>
    zeros := zero_bytes(64)
    $up := dev.upload(&dummy_probe, 0, &zeros) >>>
    up.close() >>>

    << TerrainRenderer3D{
        owner: device.reference(),
        pipelines: [p_hdr, p_dev],
        buffers: [dummy_probe],
        closed: false
    }
}

fn push_terrain_word(dst $&[]int, val f64) int {
    w := scalar_word(val) >>>
    dst.push(w)
    << 0
}

fn build_terrain_vert_bytes(view_proj fm.Mat4, world fm.Mat4, view fm.Mat4) []u8 {
    $words := []int{}
    vp_w := matrix_words(view_proj) >>>
    for w in vp_w { words.push(w) }
    w_w := matrix_words(world) >>>
    for w in w_w { words.push(w) }
    v_w := matrix_words(view) >>>
    for w in v_w { words.push(w) }
    << word_bytes(&words) >>>
}

fn build_terrain_mat_bytes(mat &TerrainMaterial3D, out_mode f64) []u8 {
    $words := []int{}
    for i in 0:4 {
        lay := &mat.layers[i]
        push_terrain_word($&words, lay.albedo.x) >>>
        push_terrain_word($&words, lay.albedo.y) >>>
        push_terrain_word($&words, lay.albedo.z) >>>
        push_terrain_word($&words, lay.tile_scale) >>>
    }
    for i in 0:4 {
        lay := &mat.layers[i]
        push_terrain_word($&words, lay.roughness) >>>
        push_terrain_word($&words, lay.metallic) >>>
        push_terrain_word($&words, lay.height_bias) >>>
        push_terrain_word($&words, 0.0) >>>
    }
    inv_sx := 1.0 / mat.size_x
    inv_sz := 1.0 / mat.size_z
    push_terrain_word($&words, mat.origin_x) >>>
    push_terrain_word($&words, mat.origin_z) >>>
    push_terrain_word($&words, inv_sx) >>>
    push_terrain_word($&words, inv_sz) >>>

    $use_wuv := 0.0
    if mat.use_world_uv { use_wuv = 1.0 }
    push_terrain_word($&words, mat.blend_sharpness) >>>
    push_terrain_word($&words, use_wuv) >>>
    push_terrain_word($&words, mat.exposure) >>>
    push_terrain_word($&words, out_mode) >>>
    << word_bytes(&words) >>>
}

fn build_terrain_irr_bytes(has_gi bool, irr &IrradianceGpu3D, gi_strength f64) []u8 {
    $words := []int{}
    if has_gi {
        push_terrain_word($&words, irr.origin.x) >>>
        push_terrain_word($&words, irr.origin.y) >>>
        push_terrain_word($&words, irr.origin.z) >>>
        push_terrain_word($&words, f64(irr.nx)) >>>
        push_terrain_word($&words, irr.spacing.x) >>>
        push_terrain_word($&words, irr.spacing.y) >>>
        push_terrain_word($&words, irr.spacing.z) >>>
        push_terrain_word($&words, f64(irr.ny)) >>>
        push_terrain_word($&words, f64(irr.nz)) >>>
        push_terrain_word($&words, 1.0) >>>
        push_terrain_word($&words, gi_strength) >>>
        push_terrain_word($&words, 0.0) >>>
    } else {
        for _ in 0:12 { words.push(0) }
    }
    << word_bytes(&words) >>>
}

fn (tr &TerrainRenderer3D) record_chunk_draw(
    device &Device3D,
    pass $&gpu.RenderPass,
    pipe_idx int,
    clustered &ClusteredRenderer3D,
    probe_buf &gpu.Buffer,
    irr_bytes &[]u8,
    light_bytes &[]u8,
    mat_bytes &[]u8,
    mat &TerrainMaterial3D,
    mesh MeshRef3D,
    world fm.Mat4,
    view fm.Mat4,
    view_projection fm.Mat4
) int {
    device.reference().validate_mesh(mesh, true) >>>
    vert_bytes := build_terrain_vert_bytes(view_projection, world, view) >>>
    pass.pipeline(&tr.pipelines[pipe_idx]) >>>
    pass.vertex_buffer_ref(0, mesh.vertices, 0) >>>
    pass.index_buffer_ref(mesh.indices, 0, gpu.INDEX32) >>>
    if mat.splat_texture.present {
        pass.sampler_ref(gpu.FRAGMENT, 0, mat.splat_texture.image, mat.splat_texture.sampler) >>>
    } else {
        pass.sampler(gpu.FRAGMENT, 0, &device.whites[0], &device.white_samplers[0]) >>>
    }
    for li in 0:4 {
        lay := &mat.layers[li]
        slot := li + 1
        if lay.texture.present {
            pass.sampler_ref(gpu.FRAGMENT, slot, lay.texture.image, lay.texture.sampler) >>>
        } else {
            pass.sampler(gpu.FRAGMENT, slot, &device.whites[0], &device.white_samplers[0]) >>>
        }
    }
    pass.uniform(gpu.VERTEX, 0, &vert_bytes) >>>
    pass.uniform(gpu.FRAGMENT, 0, mat_bytes) >>>
    pass.uniform(gpu.FRAGMENT, 1, light_bytes) >>>
    pass.uniform(gpu.FRAGMENT, 2, irr_bytes) >>>
    pass.storage_buffer(gpu.FRAGMENT, 0, &clustered.buffers[0]) >>>
    pass.storage_buffer(gpu.FRAGMENT, 1, &clustered.buffers[1]) >>>
    pass.storage_buffer(gpu.FRAGMENT, 2, &clustered.buffers[2]) >>>
    pass.storage_buffer(gpu.FRAGMENT, 3, probe_buf) >>>
    pass.draw_indexed(mesh.count, 0, 0, 1, 0) >>>
    << mesh.count / 3
}

pub fn (tr &TerrainRenderer3D) draw_chunks_into_hdr(
    device &Device3D,
    hdr $&HdrTarget3D,
    clustered &ClusteredRenderer3D,
    use_gi bool,
    irr &IrradianceGpu3D,
    gi_strength f64,
    chunks &[]MeshRef3D,
    worlds &[]fm.Mat4,
    view fm.Mat4,
    view_projection fm.Mat4,
    mat &TerrainMaterial3D,
    clear_hdr bool,
    clear_rgba int
) int {
    device.alive() >>>
    if device.active { >> errors.new("nexus terrain 3D: end Device3D frame before draw_chunks_into_hdr") }
    if tr.closed || !tr.owner.matches(device) {
        >> errors.new("nexus terrain 3D: closed or foreign TerrainRenderer3D")
    }
    if hdr.closed || hdr.active || !hdr.owner.matches(device) || hdr.textures.len < 3 {
        >> errors.new("nexus terrain 3D: invalid, closed or active HdrTarget3D")
    }
    if clustered.closed || !clustered.owner.matches(device) || !clustered.ready {
        >> errors.new("nexus terrain 3D: requires binned ClusteredRenderer3D")
    }
    if use_gi && (irr.closed || !irr.owner.matches(device)) {
        >> errors.new("nexus terrain 3D: closed or foreign irradiance grid")
    }
    if chunks.len != worlds.len {
        >> errors.new("nexus terrain 3D: chunks and worlds length mismatch")
    }
    if !view.is_affine() || !view_projection.is_finite() {
        >> errors.new("nexus terrain 3D: invalid view or view_projection matrix")
    }
    mat.validate(device) >>>
    for i in 0:chunks.len {
        if !worlds[i].is_affine() { >> errors.new("nexus terrain 3D: non-affine chunk world matrix") }
        device.reference().validate_mesh(chunks[i], true) >>>
    }

    mat_bytes := build_terrain_mat_bytes(mat, 0.0) >>>
    light_bytes := clustered.lighting_uniform_bytes() >>>
    irr_bytes := build_terrain_irr_bytes(use_gi, irr, gi_strength) >>>

    dev := device.gpu_device() >>>
    $enc := dev.command_encoder() >>>
    clear := rgba_color(clear_rgba) >>>
    $load_op := gpu.LOAD
    if clear_hdr { load_op = gpu.CLEAR }
    c0 := gpu.ColorAttachment{view: hdr.textures[0].view(0) >>>, load: load_op, store: gpu.STORE, clear: clear}
    c1 := gpu.ColorAttachment{view: hdr.textures[1].view(0) >>>, load: load_op, store: gpu.STORE, clear: gpu.Color{r: 0.0, g: 0.0, b: 0.0, a: 0.0}}
    cols := [c0, c1]
    dep := gpu.depth_attachment(&hdr.textures[2], load_op, gpu.STORE, 0.0)
    $pass := enc.begin_render_targets(&cols, dep) >>>

    $probe_buf := &tr.buffers[0]
    if use_gi { probe_buf = &irr.buffers[0] }

    $tris := 0
    for i in 0:chunks.len {
        tris += tr.record_chunk_draw(
            device, $&pass, 0, clustered, probe_buf, &irr_bytes, &light_bytes, &mat_bytes, mat,
            chunks[i], worlds[i], view, view_projection
        ) >>>
    }

    pass.end() >>>
    $fence := enc.submit() >>>
    fence.wait() >>>
    fence.close() >>>
    hdr.ready = true
    << tris
}

pub fn (tr &TerrainRenderer3D) draw_chunk_device(
    device $&Device3D,
    clustered &ClusteredRenderer3D,
    mesh MeshRef3D,
    world fm.Mat4,
    view fm.Mat4,
    view_projection fm.Mat4,
    mat &TerrainMaterial3D
) int {
    device.drawing() >>>
    if tr.closed || !tr.owner.matches(device) {
        >> errors.new("nexus terrain 3D: closed or foreign TerrainRenderer3D")
    }
    if clustered.closed || !clustered.owner.matches(device) || !clustered.ready {
        >> errors.new("nexus terrain 3D: requires binned ClusteredRenderer3D")
    }
    if !world.is_affine() || !view.is_affine() || !view_projection.is_finite() {
        >> errors.new("nexus terrain 3D: invalid transform matrix")
    }
    mat.validate(device) >>>
    mat_bytes := build_terrain_mat_bytes(mat, 1.0) >>>
    light_bytes := clustered.lighting_uniform_bytes() >>>
    empty_irr := zero_bytes(48)

    pass := $&device.passes[0]
    tris := tr.record_chunk_draw(
        device, pass, 1, clustered, &tr.buffers[0], &empty_irr, &light_bytes, &mat_bytes, mat,
        mesh, world, view, view_projection
    ) >>>
    device.cached = false
    device.draw_count += 1
    device.lit_draws += 1
    << tris
}

pub fn (tr $&TerrainRenderer3D) close() int {
    if tr.closed { << 0 }
    for i in 0:tr.pipelines.len {
        p := $&tr.pipelines[i]
        p.close() >>>
    }
    for i in 0:tr.buffers.len {
        b := $&tr.buffers[i]
        b.close() >>>
    }
    tr.pipelines = []gpu.GraphicsPipeline{}
    tr.buffers = []gpu.Buffer{}
    tr.closed = true
    << 0
}

fn (tr $&TerrainRenderer3D) drop() {
    tr.close() >>> (err) { << }
}
