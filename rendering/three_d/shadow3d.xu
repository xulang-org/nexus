@"github.com/xulang-org/nexus/rendering/three_d"

#gpu
#gpu/layout
#errors
fm #"github.com/xulang-org/nexus/foundation/math"
policy #"github.com/xulang-org/nexus/resources/shadow"
lights #"github.com/xulang-org/nexus/resources/lighting"

pub struct ShadowProgram3D { pub format int
    pub entrypoint string
    pub vertex []u8
    pub fragment []u8 }
pub struct ShadowCaster3D { pub mesh MeshRef3D
    pub world fm.Mat4
    pub alpha_texture TextureRef3D
    pub alpha_cutoff f64
    pub uv_rect fm.Vec4 }
pub fn shadow_caster(mesh MeshRef3D, world fm.Mat4) ShadowCaster3D {
    << ShadowCaster3D{mesh: mesh, world: world, alpha_texture: no_texture(),
        alpha_cutoff: 0.0, uv_rect: fm.vec4(0.0, 0.0, 1.0, 1.0)}
}
pub fn shadow_caster_material(mesh MeshRef3D, world fm.Mat4, material &Material3D) ShadowCaster3D {
    material.check() or >>
    << ShadowCaster3D{mesh: mesh, world: world, alpha_texture: material.base_texture_ref(),
        alpha_cutoff: material.alpha_cutoff(), uv_rect: material.uv_transform()}
}
pub struct ShadowMap3D {
    owner DeviceRef3D
    images []gpu.Texture
    pipelines []gpu.GraphicsPipeline
    has_gpu bool
    description policy.ShadowDescription3D
    front int
    ready bool
    closed bool
}
pub struct ShadowBinding3D {
    image gpu.TextureRef
    description policy.ShadowDescription3D
    source int
    present bool
    has_gpu bool
}
pub fn no_shadow_binding() ShadowBinding3D {
    << ShadowBinding3D{image: gpu.TextureRef{},description: policy.default_directional(),source: -1,present: false,has_gpu: false}
}
fn shadow_columns(description &policy.ShadowDescription3D) int {
    if description.kind()==lights.POINT { << 3 }
    if description.cascade_count()>0 { << 2 }
    << 1
}
pub fn (device &Device3D) shadow_map(description policy.ShadowDescription3D,program &ShadowProgram3D) ShadowMap3D {
    device.alive() or >>
    if device.active { >> errors.new("nexus shadow: create maps outside a frame") }
    description.validate() or >>
    shadow_description_words(&description,0) or >>
    for face in 0:description.face_count() { matrix_words(description.view_projection(face) or >>) or >> }
    size := description.resolution()
    columns := shadow_columns(&description)
    if columns < 1 { >> errors.new("nexus shadow: invalid layout columns") }
    width := size*columns
    height := size*((description.face_count()+columns-1)/columns)
    if !device.is_gpu() {
        if width*height*16>67108864 { >> errors.new("nexus shadow: shared 512-texture / 64 MiB budget exceeded") }
        << ShadowMap3D{owner: device.reference(),images: []gpu.Texture{},pipelines: []gpu.GraphicsPipeline{},has_gpu: false,
            description: description,front: 0,ready: false,closed: false}
    }
    dev := device.gpu_device() or >>
    stats := dev.stats() or >>
    $internal := device.target_width*device.target_height*8+4
    if device.render_scale==2 { internal=device.target_width*device.target_height*36+4 }
    if stats.texture_count>509+device.targets.len || width*height*16>67108864-(stats.texture_bytes-internal) { >> errors.new("nexus shadow: shared 512-texture / 64 MiB budget exceeded") }
    if !(dev.supports_texture_2d(layout.R32_FLOAT,gpu.TEXTURE_COLOR_TARGET | gpu.TEXTURE_SAMPLED) or >>) { >> errors.new("nexus shadow: sampled R32_FLOAT color targets unavailable") }
    $images := []gpu.Texture{}
    for i in 0:2 {
        image := dev.texture_2d(gpu.Texture2DDesc{format: layout.R32_FLOAT,width: width,height: height,levels: 1,usage: gpu.TEXTURE_COLOR_TARGET | gpu.TEXTURE_SAMPLED}) or >>
        images.push(image)
        depth := new_depth(dev,width,height) or >>
        images.push(depth)
    }
    vd := gpu.ShaderDesc{stage: gpu.VERTEX,format: program.format,entrypoint: program.entrypoint+"",samplers: 0,uniform_sizes: [64]}
    fd := gpu.ShaderDesc{stage: gpu.FRAGMENT,format: program.format,entrypoint: program.entrypoint+"",samplers: 1,uniform_sizes: [32]}
    $vs := dev.shader(&vd,&program.vertex) or >>
    $fs := dev.shader(&fd,&program.fragment) or >>
    $desc := gpu.pipeline_defaults(layout.R32_FLOAT)
    desc.depth_format=layout.DEPTH32_FLOAT
    desc.depth_compare=gpu.GREATER
    desc.depth_write=true
    desc.vertex_buffers=[gpu.VertexBufferLayout{slot: 0,stride: 64,rate: gpu.PER_VERTEX}]
    desc.attributes=[gpu.VertexAttribute{location: 0,slot: 0,format: gpu.FLOAT3,offset: 0},
        gpu.VertexAttribute{location: 1,slot: 0,format: gpu.FLOAT2,offset: 40}]
    pipeline := dev.graphics_pipeline(&vs,&fs,&desc) or >>
    vs.close() or >>
    fs.close() or >>
    << ShadowMap3D{owner: device.reference(),images: images,pipelines: [pipeline],has_gpu: true,description: description,front: 0,ready: false,closed: false}
}
// All visible casters, including those outside the main camera, are supplied
// explicitly. Double buffering publishes only a successfully submitted map.
pub fn (shadow $&ShadowMap3D) render(device &Device3D,casters &[]ShadowCaster3D,description policy.ShadowDescription3D) int {
    device.alive() or >>
    if device.active || shadow.closed || !shadow.owner.matches(device) { >> errors.new("nexus shadow: closed/foreign map or active main frame") }
    description.validate() or >>
    if description.resolution()!=shadow.description.resolution() || description.face_count()!=shadow.description.face_count() || casters.len>16384 { >> errors.new("nexus shadow: fixed map layout/resolution or caster budget exceeded") }
    shadow_description_words(&description,0) or >>
    $cutout_words := []int{}
    for caster in casters {
        shadow.owner.validate_mesh(caster.mesh,false) or >>
        if !caster.world.is_affine() { >> errors.new("nexus shadow: caster world must be finite affine") }
        if !fm.finite(caster.alpha_cutoff) || caster.alpha_cutoff < 0.0 || caster.alpha_cutoff > 1.0 || !caster.uv_rect.is_finite() {
            >> errors.new("nexus shadow: caster alpha cutoff and UV rect must be finite")
        }
        $has_tex := 0.0
        if caster.alpha_cutoff > 0.0 && caster.alpha_texture.present {
            if !caster.mesh.uvs { >> errors.new("nexus shadow: cutout shadow caster requires mesh UVs") }
            if shadow.has_gpu {
                if !caster.alpha_texture.has_gpu { >> errors.new("nexus shadow: software texture cannot bind to GPU shadow map") }
                shadow.owner.device.validate_texture(caster.alpha_texture.image) or >>
                shadow.owner.device.validate_sampler(caster.alpha_texture.sampler) or >>
            } else {
                if caster.alpha_texture.has_gpu { >> errors.new("nexus shadow: GPU texture cannot bind to software shadow map") }
                caster.alpha_texture.soft_pixels.validate(shadow.owner.device_id) or >>
            }
            has_tex = 1.0
        }
        for value in [caster.alpha_cutoff, has_tex, 0.0, 0.0, caster.uv_rect.x, caster.uv_rect.y, caster.uv_rect.z, caster.uv_rect.w] {
            cutout_words.push(scalar_word(value) or >>)
        }
    }
    // Preflight ALL views, even for an empty update, before any GPU recording.
    $transforms := []int{}
    for face in 0:description.face_count() {
        vp := description.view_projection(face) or >>
        matrix_words(vp) or >>
        for caster in casters {
            words := matrix_words(vp.multiply(caster.world)) or >>
            for value in words { transforms.push(value) }
        }
    }
    if !shadow.has_gpu {
        $soft_tris := 0
        for i in 0:casters.len { soft_tris += casters[i].mesh.count/3 }
        shadow.description=description
        shadow.ready=true
        << soft_tris
    }
    $back := 2
    if shadow.ready { back=2-shadow.front }
    image := back
    depth := back+1
    dev := device.gpu_device() or >>
    $encoder := dev.command_encoder() or >>
    color := gpu.ColorAttachment{view: shadow.images[image].view(0) or >>,load: gpu.CLEAR,store: gpu.STORE,clear: gpu.Color{r: 0.0,g: 0.0,b: 0.0,a: 1.0}}
    attachment := gpu.depth_attachment(&shadow.images[depth],gpu.CLEAR,gpu.STORE,0.0)
    $pass := encoder.begin_render(color,attachment) or >>
    pass.pipeline(&shadow.pipelines[0]) or >>
    $triangles := 0
    size := description.resolution()
    columns := shadow_columns(&description)
    if columns < 1 { >> errors.new("nexus shadow: invalid layout columns") }
    for face in 0:description.face_count() {
        pass.viewport((face%columns)*size,(face/columns)*size,size,size) or >>
        pass.scissor((face%columns)*size,(face/columns)*size,size,size) or >>
        for i in 0:casters.len {
            caster := &casters[i]
            mesh := caster.mesh
            $values := []int{}
            for j in 0:16 { values.push(transforms[(face*casters.len+i)*16+j]) }
            bytes := word_bytes(&values) or >>
            $cvals := []int{}
            for j in 0:8 { cvals.push(cutout_words[i*8+j]) }
            cutout_bytes := word_bytes(&cvals) or >>
            pass.vertex_buffer_ref(0,mesh.vertices,0) or >>
            pass.index_buffer_ref(mesh.indices,0,gpu.INDEX32) or >>
            if caster.alpha_cutoff > 0.0 && caster.alpha_texture.present {
                pass.sampler_ref(gpu.FRAGMENT,0,caster.alpha_texture.image,caster.alpha_texture.sampler) or >>
            } else {
                pass.sampler(gpu.FRAGMENT,0,&device.whites[0],&device.white_samplers[0]) or >>
            }
            pass.uniform(gpu.VERTEX,0,&bytes) or >>
            pass.uniform(gpu.FRAGMENT,0,&cutout_bytes) or >>
            pass.draw_indexed(mesh.count,0,0,1,0) or >>
            triangles+=mesh.count/3
        }
    }
    pass.end() or >>
    $fence := encoder.submit() or >>
    fence.close() or >>
    shadow.front=back
    shadow.description=description
    shadow.ready=true
    << triangles
}
pub fn (shadow &ShadowMap3D) binding(lighting &lights.Environment3D,source int) ShadowBinding3D {
    if shadow.closed || !shadow.ready { >> errors.new("nexus shadow: render a live map before binding") }
    lighting.validate() or >>
    light := lighting.source(source) or >>
    if !(shadow.description.matches_source(&light) or >>) { >> errors.new("nexus shadow: bound source must match rendered projection") }
    if !shadow.has_gpu {
        << ShadowBinding3D{image: gpu.TextureRef{},description: shadow.description,source: source,present: true,has_gpu: false}
    }
    front := shadow.front
    reference := shadow.images[front].reference()
    reference.validate() or >>
    << ShadowBinding3D{image: reference,description: shadow.description,source: source,present: true,has_gpu: true}
}
fn shadow_words(binding &ShadowBinding3D,index int) []int {
    if !binding.present { $empty := []int{}
        for i in 0:104 { empty.push(0) }
        << empty }
    << shadow_description_words(&binding.description,index) or >>
}
fn shadow_description_words(description &policy.ShadowDescription3D,index int) []int {
    $words := []int{}
    for i in 0:4 {
        if description.kind()!=lights.POINT && (i==0 || i<description.cascade_count()) {
            matrix := matrix_words(description.view_projection(i) or >>) or >>
            for value in matrix { words.push(value) }
        } else { for j in 0:16 { words.push(0) } }
    }
    reference := description.receiver_reference()
    $mode := 1.0
    if description.kind()==lights.SPOT { mode=2.0 }
    if description.kind()==lights.POINT { mode=3.0 }
    if description.cascade_count()>0 { mode=4.0 }
    for value in [reference.x,reference.y,reference.z,description.constant_bias(),1.0/f64(description.resolution()),description.slope_bias(),f64(index),mode] { words.push(scalar_word(value) or >>) }
    depth := description.depth_coefficients() or >>
    columns := shadow_columns(description)
    if columns < 1 { >> errors.new("nexus shadow: invalid layout columns") }
    rows := (description.face_count()+columns-1)/columns
    for value in [depth.x,depth.y,f64(columns),f64(rows)] { words.push(scalar_word(value) or >>) }
    camera := description.cascade_depth_plane()
    for value in [camera.x,camera.y,camera.z,camera.w] { words.push(scalar_word(value) or >>) }
    for i in 0:4 {
        $range := fm.vec4(0.0,0.0,0.0,0.0)
        if i<description.cascade_count() { range=description.cascade_parameters(i) or >> }
        for value in [range.x,range.y,range.z,range.w] { words.push(scalar_word(value) or >>) }
    }
    limits := description.cascade_limits()
    for value in [limits.x,limits.y,limits.z,limits.w] { words.push(scalar_word(value) or >>) }
    gradients := description.cascade_gradient_scales()
    for value in [gradients.x,gradients.y,gradients.z,gradients.w] { words.push(scalar_word(value) or >>) }
    << words
}
pub fn (binding &ShadowBinding3D) validate_camera(view_projection fm.Mat4) int {
    if binding.present && !binding.description.matches_camera(view_projection) { >> errors.new("nexus shadow: cascades belong to a different camera; refresh before drawing") }
    << 0
}
pub fn (shadow $&ShadowMap3D) close() int {
    if shadow.closed { << 0 }
    $first := ""
    for i in 0:shadow.images.len { texture := $&shadow.images[i]
        error := close_texture(texture)
        if first.len==0 { first=error } }
    if shadow.pipelines.len>0 {
        pipeline := $&shadow.pipelines[0]
        pipeline_error := close_shadow_pipeline(pipeline)
        if first.len==0 { first=pipeline_error }
    }
    shadow.images = []gpu.Texture{}
    shadow.pipelines = []gpu.GraphicsPipeline{}
    shadow.closed=true
    shadow.ready=false
    if first.len>0 { >> errors.new(first) }
    << 0
}
fn (shadow $&ShadowMap3D) drop() { shadow.close() or(err){ << } }
fn close_shadow_pipeline(pipeline $&gpu.GraphicsPipeline) string {
    pipeline.close() or(err){ << err.msg() }
    << ""
}
