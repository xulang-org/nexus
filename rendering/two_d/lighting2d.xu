@"github.com/xulang-org/nexus/rendering/two_d"

#encoding/binary
#errors
#gpu
#gpu/layout
fm #"github.com/xulang-org/nexus/foundation/math"
present #"github.com/xulang-org/nexus/platform/present"
canvas #"github.com/xulang-org/nexus/resources/canvas"
l2d #"github.com/xulang-org/nexus/resources/lighting2d"

const LIGHTING_UNIFORM_BYTES_2D = 4160

pub struct LightingProgram2D {
    pub format int
    pub entrypoint string
    pub vertex []u8
    pub fragment []u8
}

pub fn empty_lighting_program_2d() LightingProgram2D {
    << LightingProgram2D{format: 0, entrypoint: "", vertex: []u8{}, fragment: []u8{}}
}

fn validate_lighting_program_2d(program &LightingProgram2D, formats int) int {
    if program.entrypoint.len == 0 || program.vertex.len == 0 || program.fragment.len == 0 {
        >> errors.new("nexus canvas: empty 2D lighting shader program")
    }
    if (program.format & formats) == 0 {
        >> errors.new("nexus canvas: 2D lighting shader format unsupported by GPU device")
    }
    << 0
}

fn flat_normal_texture_2d(device &gpu.Device) gpu.Texture {
    $tex := device.texture_2d(gpu.Texture2DDesc{
        format: layout.RGBA8_UNORM,
        width: 1,
        height: 1,
        levels: 1,
        usage: gpu.TEXTURE_SAMPLED
    }) >>>
    bytes := [u8(128), u8(128), u8(255), u8(255)]
    $up := device.upload_texture(&tex, 0, &bytes) >>>
    up.close() >>>
    << tex
}

fn build_lighting_pipeline_2d(device &gpu.Device, program &LightingProgram2D) gpu.GraphicsPipeline {
    $vs := device.shader(&gpu.ShaderDesc{
        stage: gpu.VERTEX,
        format: program.format,
        entrypoint: program.entrypoint + "",
        samplers: 0,
        uniform_sizes: [16]
    }, &program.vertex) >>>
    $fs := device.shader(&gpu.ShaderDesc{
        stage: gpu.FRAGMENT,
        format: program.format,
        entrypoint: program.entrypoint + "",
        samplers: 2,
        uniform_sizes: [LIGHTING_UNIFORM_BYTES_2D]
    }, &program.fragment) >>>
    desc := pipeline_description(layout.RGBA8_UNORM, gpu.BLEND_DISABLED)
    pipe := device.graphics_pipeline(&vs, &fs, &desc) >>>
    vs.close() >>>
    fs.close() >>>
    << pipe
}

fn lighting_uniform_bytes_2d(
    env &l2d.LightEnvironment2D,
    view_origin fm.Vec2,
    view_size fm.Vec2,
    layer_mask int,
    use_normal_map bool
) []u8 {
    view_bounds := fm.rect2(view_origin.x, view_origin.y, view_size.x, view_size.y)
    lights := env.visible_lights(view_bounds, layer_mask, l2d.MAX_GPU_LIGHTS_2D) >>>
    occs := env.visible_occluders(view_bounds, layer_mask, l2d.MAX_GPU_OCCLUDERS_2D) >>>

    $bytes := []u8{}
    for _ in 0:LIGHTING_UNIFORM_BYTES_2D { bytes.push(u8(0)) }
    order := binary.little_endian()

    // [0..16] view_rect
    order.put_f32($&bytes, 0, view_origin.x) >>>
    order.put_f32($&bytes, 4, view_origin.y) >>>
    order.put_f32($&bytes, 8, view_size.x) >>>
    order.put_f32($&bytes, 12, view_size.y) >>>

    // [16..32] ambient_exposure
    order.put_f32($&bytes, 16, env.ambient.x) >>>
    order.put_f32($&bytes, 20, env.ambient.y) >>>
    order.put_f32($&bytes, 24, env.ambient.z) >>>
    order.put_f32($&bytes, 28, env.exposure) >>>

    // [32..48] counts_bias
    $normal_flag := 0.0
    if use_normal_map { normal_flag = 1.0 }
    order.put_f32($&bytes, 32, f64(lights.len)) >>>
    order.put_f32($&bytes, 36, f64(occs.len)) >>>
    order.put_f32($&bytes, 40, env.shadow_bias) >>>
    order.put_f32($&bytes, 44, normal_flag) >>>

    // [48..64] tuning (x=soft_tonemap, y=specular_strength)
    $tonemap_flag := 0.0
    if env.soft_tonemap { tonemap_flag = 1.0 }
    order.put_f32($&bytes, 48, tonemap_flag) >>>
    order.put_f32($&bytes, 52, env.specular_strength) >>>
    order.put_f32($&bytes, 56, 0.0) >>>
    order.put_f32($&bytes, 60, 0.0) >>>

    // [64..2112] lights[128] (32 * 4 * vec4 = 2048 bytes)
    for i in 0:lights.len {
        l := &lights[i]
        off := 64 + i * 64
        order.put_f32($&bytes, off + 0, l.position.x) >>>
        order.put_f32($&bytes, off + 4, l.position.y) >>>
        order.put_f32($&bytes, off + 8, l.height) >>>
        order.put_f32($&bytes, off + 12, f64(l.kind)) >>>

        order.put_f32($&bytes, off + 16, l.direction.x) >>>
        order.put_f32($&bytes, off + 20, l.direction.y) >>>
        order.put_f32($&bytes, off + 24, l.radius) >>>
        order.put_f32($&bytes, off + 28, l.falloff) >>>

        order.put_f32($&bytes, off + 32, l.color.x * l.intensity) >>>
        order.put_f32($&bytes, off + 36, l.color.y * l.intensity) >>>
        order.put_f32($&bytes, off + 40, l.color.z * l.intensity) >>>
        order.put_f32($&bytes, off + 44, l.inner_cos) >>>

        $cast_f := 0.0
        if l.cast_shadows { cast_f = 1.0 }
        $en_f := 0.0
        if l.enabled { en_f = 1.0 }
        order.put_f32($&bytes, off + 48, l.outer_cos) >>>
        order.put_f32($&bytes, off + 52, cast_f) >>>
        order.put_f32($&bytes, off + 56, l.shadow_softness) >>>
        order.put_f32($&bytes, off + 60, en_f) >>>
    }

    // [2112..4160] occluders[128] (128 * vec4 = 2048 bytes)
    for i in 0:occs.len {
        seg := &occs[i]
        off := 2112 + i * 16
        order.put_f32($&bytes, off + 0, seg.a.x) >>>
        order.put_f32($&bytes, off + 4, seg.a.y) >>>
        order.put_f32($&bytes, off + 8, seg.b.x) >>>
        order.put_f32($&bytes, off + 12, seg.b.y) >>>
    }
    << bytes
}

pub fn (renderer $&Renderer2D) enable_lighting_2d(program &LightingProgram2D) int {
    renderer.alive() >>>
    if renderer.active { >> errors.new("nexus canvas: cannot configure 2D lighting during an active frame") }
    if renderer.lighting_enabled { << 0 }
    if renderer.session.is_gpu() {
        dev := renderer.session.gpu_device() >>>
        formats := dev.shader_formats() >>>
        validate_lighting_program_2d(program, formats) >>>
        $pipe := build_lighting_pipeline_2d(dev, program) >>>
        $flat := flat_normal_texture_2d(dev) >>>
        if renderer.targets.len < 2 {
            extra := target_texture(dev, renderer.target_width, renderer.target_height) >>>
            renderer.targets.push(extra)
        }
        renderer.lighting_pipelines.push(pipe)
        renderer.flat_normals.push(flat)
    }
    renderer.lighting_enabled = true
    << 0
}

fn soft_apply_session_lighting_2d(
    sess $&present.Session,
    env &l2d.LightEnvironment2D,
    view_origin fm.Vec2,
    view_size fm.Vec2,
    layer_mask int,
    has_normal_map bool,
    normal_soft &[]u8,
    normal_w int,
    normal_h int,
    normal_linear bool
) int {
    w := sess.width
    h := sess.height
    << soft_apply_lighting_2d(
        $&sess.pixels, w, h,
        env, view_origin, view_size, layer_mask,
        has_normal_map, normal_soft, normal_w, normal_h, normal_linear
    ) >>>
}

fn (renderer $&Renderer2D) apply_lighting_2d_impl(
    env &l2d.LightEnvironment2D,
    view_origin fm.Vec2,
    view_size fm.Vec2,
    layer_mask int,
    has_normal_map bool,
    normal_tex &gpu.Texture,
    normal_linear bool,
    normal_soft &[]u8,
    normal_w int,
    normal_h int
) int {
    renderer.recording() >>>
    if !renderer.lighting_enabled { >> errors.new("nexus canvas: 2D lighting is not enabled") }
    env.validate() >>>
    if !fm.finite(view_origin.x) || !fm.finite(view_origin.y) ||
        !fm.finite(view_size.x) || !fm.finite(view_size.y) ||
        view_size.x <= 0.0 || view_size.y <= 0.0 {
        >> errors.new("nexus canvas: 2D lighting requires positive finite view_size")
    }
    if layer_mask == 0 {
        >> errors.new("nexus canvas: 2D lighting layer_mask must be non-zero")
    }
    if !renderer.session.is_gpu() {
        soft_apply_session_lighting_2d(
            $&renderer.session,
            env, view_origin, view_size, layer_mask,
            has_normal_map, normal_soft, normal_w, normal_h, normal_linear
        ) >>>
        renderer.cached = true
        << 0
    }
    if renderer.targets.len < 2 || renderer.lighting_pipelines.len == 0 || renderer.flat_normals.len == 0 {
        >> errors.new("nexus canvas: GPU 2D lighting resources missing")
    }
    $quad := canvas.new_batch()
    quad.quad(fm.rect2(0.0, 0.0, f64(renderer.target_width), f64(renderer.target_height)), fm.identity(), 4294967295) >>>
    renderer.check_vertices(6) >>>
    vbytes := vertex_bytes(&quad) >>>
    uploaded := upload_renderer_pool(renderer, false, &vbytes, 6) >>>
    vuni := viewport_uniform(renderer.target_width, renderer.target_height) >>>
    funi := lighting_uniform_bytes_2d(env, view_origin, view_size, layer_mask, has_normal_map) >>>

    src_idx := renderer.active_target
    dst_idx := 1 - src_idx
    dev := renderer.session.gpu_device() >>>
    $encoder := dev.command_encoder() >>>
    att := gpu.ColorAttachment{
        view: renderer.targets[dst_idx].view(0) >>>,
        load: gpu.CLEAR,
        store: gpu.STORE,
        clear: gpu.Color{r: 0.0, g: 0.0, b: 0.0, a: 1.0}
    }
    $pass := encoder.begin_render(att, gpu.no_depth()) >>>
    sidx := uploaded.slot
    pass.pipeline(&renderer.lighting_pipelines[0]) >>>
    pass.viewport(0, 0, renderer.target_width, renderer.target_height) >>>
    pass.scissor(0, 0, renderer.target_width, renderer.target_height) >>>
    pass.vertex_buffer(0, &renderer.batch_pool.slots[sidx].buffer[0], uploaded.offset) >>>
    pass.sampler(gpu.FRAGMENT, 0, &renderer.targets[src_idx], &renderer.nearests[0]) >>>
    if has_normal_map {
        if normal_linear {
            pass.sampler(gpu.FRAGMENT, 1, normal_tex, &renderer.linears[0]) >>>
        } else {
            pass.sampler(gpu.FRAGMENT, 1, normal_tex, &renderer.nearests[0]) >>>
        }
    } else {
        pass.sampler(gpu.FRAGMENT, 1, &renderer.flat_normals[0], &renderer.nearests[0]) >>>
    }
    pass.uniform(gpu.VERTEX, 0, &vuni) >>>
    pass.uniform(gpu.FRAGMENT, 0, &funi) >>>
    pass.draw(6, 0, 1, 0) >>>
    pass.end() >>>
    $fence := encoder.submit() >>>
    fence.close() >>>

    renderer.active_target = dst_idx
    renderer.frame_vertices += 6
    renderer.cached = false
    << 0
}

pub fn (renderer $&Renderer2D) apply_lighting_2d(
    env &l2d.LightEnvironment2D,
    view_origin fm.Vec2,
    view_size fm.Vec2,
    layer_mask int
) int {
    empty_soft := []u8{}
    if !renderer.session.is_gpu() {
        << apply_lighting_2d_soft_wrap(renderer, env, view_origin, view_size, layer_mask,
            false, &empty_soft, 0, 0, false) >>>
    }
    << renderer.apply_lighting_2d_impl(env, view_origin, view_size, layer_mask,
        false, &renderer.whites[0], false, &empty_soft, 0, 0) >>>
}

pub fn (renderer $&Renderer2D) apply_lighting_2d_normal(
    env &l2d.LightEnvironment2D,
    view_origin fm.Vec2,
    view_size fm.Vec2,
    layer_mask int,
    normal_map &Texture2D
) int {
    if normal_map.owner != renderer.owner || normal_map.closed {
        >> errors.new("nexus canvas: closed or foreign normal map texture")
    }
    if renderer.session.is_gpu() {
        << renderer.apply_lighting_2d_impl(env, view_origin, view_size, layer_mask,
            true, &normal_map.images[0], normal_map.linear, &normal_map.soft_pixels,
            normal_map.width, normal_map.height) >>>
    }
    << apply_lighting_2d_soft_wrap(renderer, env, view_origin, view_size, layer_mask,
        true, &normal_map.soft_pixels, normal_map.width, normal_map.height, normal_map.linear) >>>
}

fn apply_lighting_2d_soft_wrap(
    renderer $&Renderer2D,
    env &l2d.LightEnvironment2D,
    view_origin fm.Vec2,
    view_size fm.Vec2,
    layer_mask int,
    has_normal_map bool,
    normal_soft &[]u8,
    normal_w int,
    normal_h int,
    normal_linear bool
) int {
    renderer.recording() >>>
    if !renderer.lighting_enabled { >> errors.new("nexus canvas: 2D lighting is not enabled") }
    env.validate() >>>
    if !fm.finite(view_origin.x) || !fm.finite(view_origin.y) ||
        !fm.finite(view_size.x) || !fm.finite(view_size.y) ||
        view_size.x <= 0.0 || view_size.y <= 0.0 {
        >> errors.new("nexus canvas: 2D lighting requires positive finite view_size")
    }
    if layer_mask == 0 {
        >> errors.new("nexus canvas: 2D lighting layer_mask must be non-zero")
    }
    soft_apply_session_lighting_2d(
        $&renderer.session,
        env, view_origin, view_size, layer_mask,
        has_normal_map, normal_soft, normal_w, normal_h, normal_linear
    ) >>>
    renderer.cached = true
    << 0
}
