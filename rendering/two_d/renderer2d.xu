@"github.com/xulang-org/nexus/rendering/two_d"

#gpu
#gpu/layout
#window
#window/events
#errors
canvas #"github.com/xulang-org/nexus/resources/canvas"
present #"github.com/xulang-org/nexus/platform/present"

pub const MAX_TARGET_PIXELS_2D = 16777216
pub struct ShaderProgram2D {
    pub format int
    pub entrypoint string
    pub vertex []u8
    pub fragment []u8
}
// Owns standard resources. Window borrowing exposes events/lifecycle without a
// raw SDL pointer. Device closure invalidates all independent texture owners.
pub struct Renderer2D {
    session present.Session
    targets []gpu.Texture
    whites []gpu.Texture
    nearests []gpu.Sampler
    linears []gpu.Sampler
    drawings []gpu.GraphicsPipeline
    copyings []gpu.GraphicsPipeline
    sdf_pipelines []gpu.GraphicsPipeline
    text_pipelines []gpu.GraphicsPipeline
    batch_pool GpuVertexPool
    sdf_pool GpuVertexPool
    sdf_enabled bool
    text_enabled bool
    owner int
    surface_format int
    target_width int
    target_height int
    frame_vertices int
    clip_x int
    clip_y int
    clip_width int
    clip_height int
    active bool
    closed bool
    cached bool
    pixels []u8
}
fn target_size(width int, height int) int {
    if width < 1 || height < 1 || width > 16384 || height > 16384 || width * height > MAX_TARGET_PIXELS_2D {
        >>> errors.new("nexus canvas: output exceeds 16384 per side or 16M pixels")
    }
    << 0
}
fn target_texture(device &gpu.Device, width int, height int) gpu.Texture {
    target_size(width,height) >>>
    << device.texture_2d(gpu.Texture2DDesc{format: layout.RGBA8_UNORM,width: width,height: height,
        levels: 1,usage: gpu.TEXTURE_SAMPLED | gpu.TEXTURE_COLOR_TARGET}) >>>
}
fn pipeline_description(format int, blend int) gpu.PipelineDesc {
    $desc := gpu.pipeline_defaults(format)
    desc.blend = blend
    desc.vertex_buffers = [gpu.VertexBufferLayout{slot: 0,stride: 20,rate: gpu.PER_VERTEX}]
    desc.attributes = [gpu.VertexAttribute{location: 0,slot: 0,format: gpu.FLOAT2,offset: 0},
        gpu.VertexAttribute{location: 1,slot: 0,format: gpu.UNORM8X4,offset: 8},
        gpu.VertexAttribute{location: 2,slot: 0,format: gpu.FLOAT2,offset: 12}]
    << desc
}
fn open_2d_session(session present.Session, program &ShaderProgram2D, enable_sdf_default bool) Renderer2D {
    if session.is_gpu() {
        dev := session.gpu_device() >>>
        formats := dev.shader_formats() >>>
        validate_shader_program(program, formats) >>>
        target_win := session.window() >>>
        state := target_win.state() >>>
        $target := target_texture(dev, state.pixel_width, state.pixel_height) >>>
        $white := white_texture_2d(dev) >>>
        $nearest := sampler_2d(dev, false) >>>
        $linear := sampler_2d(dev, true) >>>
        format := session.swapchain_format() >>>
        vs_desc := gpu.ShaderDesc{stage: gpu.VERTEX, format: program.format, entrypoint: program.entrypoint + "",
            samplers: 0, uniform_sizes: [16]}
        fs_desc := gpu.ShaderDesc{stage: gpu.FRAGMENT, format: program.format, entrypoint: program.entrypoint + "",
            samplers: 1, uniform_sizes: []int{}}
        $vertex := dev.shader(&vs_desc, &program.vertex) >>>
        $fragment := dev.shader(&fs_desc, &program.fragment) >>>
        drawing_desc := pipeline_description(layout.RGBA8_UNORM, gpu.BLEND_ALPHA)
        $draw_pipe := dev.graphics_pipeline(&vertex, &fragment, &drawing_desc) >>>
        copying_desc := pipeline_description(format, gpu.BLEND_DISABLED)
        $copy_pipe := dev.graphics_pipeline(&vertex, &fragment, &copying_desc) >>>
        vertex.close() >>>
        fragment.close() >>>
        owner := target_win.id()
        << Renderer2D{session: session,
            targets: [target], whites: [white], nearests: [nearest], linears: [linear],
            drawings: [draw_pipe], copyings: [copy_pipe], sdf_pipelines: []gpu.GraphicsPipeline{},
            text_pipelines: []gpu.GraphicsPipeline{},
            batch_pool: new_vertex_pool(), sdf_pool: new_vertex_pool(),
            sdf_enabled: false, text_enabled: false,
            owner: owner, surface_format: format,
            target_width: state.pixel_width, target_height: state.pixel_height,
            frame_vertices: 0, clip_x: 0, clip_y: 0,
            clip_width: state.pixel_width, clip_height: state.pixel_height,
            active: false, closed: false, cached: false, pixels: []u8{}}
    }
    w := session.width
    h := session.height
    target_size(w, h) >>>
    $owner := -1
    if session.has_display_window() {
        target_win := session.window() >>>
        owner = target_win.id()
    }
    << Renderer2D{session: session,
        targets: []gpu.Texture{}, whites: []gpu.Texture{}, nearests: []gpu.Sampler{}, linears: []gpu.Sampler{},
        drawings: []gpu.GraphicsPipeline{}, copyings: []gpu.GraphicsPipeline{}, sdf_pipelines: []gpu.GraphicsPipeline{},
        text_pipelines: []gpu.GraphicsPipeline{},
        batch_pool: new_vertex_pool(), sdf_pool: new_vertex_pool(),
        sdf_enabled: enable_sdf_default, text_enabled: enable_sdf_default,
        owner: owner, surface_format: 0,
        target_width: w, target_height: h,
        frame_vertices: 0, clip_x: 0, clip_y: 0, clip_width: w, clip_height: h,
        active: false, closed: false, cached: true, pixels: []u8{}}
}

pub fn open_2d(title string, width int, height int, backend int, program &ShaderProgram2D) Renderer2D {
    options := window.Options{title: title,width: width,height: height,resizable: true,high_pixel_density: false,hidden: false}
    << open_2d_window(options, backend, program) >>>
}

pub fn open_2d_window(options window.Options, backend int, program &ShaderProgram2D) Renderer2D {
    target_size(options.width, options.height) >>>
    $session := present.open_window(options, backend, program.format, present.POLICY_GPU_ONLY) >>>
    << open_2d_session(session, program, false) >>>
}

pub fn open_2d_window_adaptive(options window.Options, backend int, program &ShaderProgram2D) Renderer2D {
    target_size(options.width, options.height) >>>
    $session := present.open_adaptive(options, backend, program.format) >>>
    << open_2d_session(session, program, false) >>>
}

pub fn open_2d_software(options window.Options) Renderer2D {
    target_size(options.width, options.height) >>>
    $session := present.open_window(options, 0, 0, present.POLICY_SOFTWARE) >>>
    prog := empty_shader_program()
    << open_2d_session(session, &prog, true) >>>
}

pub fn open_2d_headless(width int, height int) Renderer2D {
    target_size(width, height) >>>
    $session := present.open_headless(width, height) >>>
    prog := empty_shader_program()
    << open_2d_session(session, &prog, true) >>>
}
fn (renderer &Renderer2D) alive() int {
    if renderer.closed { >>> errors.new("nexus canvas: renderer is closed") }
    << 0
}
fn (renderer &Renderer2D) recording() int {
    renderer.alive() >>>
    if !renderer.active { >>> errors.new("nexus canvas: begin a frame before drawing or reading") }
    << 0
}
pub fn (renderer &Renderer2D) window() &window.Window {
    renderer.alive() >>>
    if renderer.session.windows.len == 0 {
        >>> errors.new("nexus canvas: headless renderer has no window")
    }
    << &renderer.session.windows[0]
}
pub fn (renderer &Renderer2D) backend() int {
    renderer.alive() >>>
    if !renderer.session.is_gpu() { << 0 }
    dev := renderer.session.gpu_device() >>>
    << dev.backend() >>>
}
pub fn (renderer &Renderer2D) backend_mode() int {
    renderer.alive() >>>
    << renderer.session.backend_mode() >>>
}
pub fn (renderer &Renderer2D) mode_name() string {
    renderer.alive() >>>
    << renderer.session.mode_name() >>>
}
pub fn (renderer &Renderer2D) is_gpu() bool {
    << !renderer.closed && renderer.session.is_gpu()
}
pub fn (renderer &Renderer2D) is_software() bool {
    << !renderer.closed && renderer.session.is_software()
}
pub fn (renderer &Renderer2D) has_display_window() bool {
    << !renderer.closed && renderer.session.has_display_window()
}
pub fn (renderer &Renderer2D) width() int {
    renderer.alive() >>>
    if !renderer.session.has_display_window() { << renderer.target_width }
    win := renderer.session.window() >>>
    state := win.state() >>>
    << state.pixel_width
}
pub fn (renderer &Renderer2D) height() int {
    renderer.alive() >>>
    if !renderer.session.has_display_window() { << renderer.target_height }
    win := renderer.session.window() >>>
    state := win.state() >>>
    << state.pixel_height
}
fn color_value(color int) gpu.Color {
    if color < 0 || color > 4294967295 { >>> errors.new("nexus canvas: invalid RGBA color") }
    << gpu.Color{r: f64((color >> 24) & 255)/255.0,g: f64((color >> 16) & 255)/255.0,
        b: f64((color >> 8) & 255)/255.0,a: f64(color & 255)/255.0}
}
fn sync_software_frame(sess $&present.Session, background int) int {
    sess.sync_software_window_size() >>>
    target_size(sess.width, sess.height) >>>
    sess.clear_software(background) >>>
    << 0
}

pub fn (renderer $&Renderer2D) begin(background int) int {
    renderer.alive() >>>
    if renderer.active { >>> errors.new("nexus canvas: frame already active") }
    clear := color_value(background) >>>
    if renderer.session.is_gpu() {
        if renderer.session.has_display_window() {
            win := renderer.session.window() >>>
            state := win.state() >>>
            // A minimized window may report no pixels. Continue the offscreen frame at
            // the last positive extent; present handles a successful no-image acquire.
            if state.pixel_width > 0 && state.pixel_height > 0 &&
                (state.pixel_width != renderer.target_width || state.pixel_height != renderer.target_height) {
                dev := renderer.session.gpu_device() >>>
                replacement := target_texture(dev, state.pixel_width, state.pixel_height) >>>
                old_target := $&renderer.targets[0]
                old_target.close() >>>
                renderer.targets = [replacement]
                renderer.target_width = state.pixel_width
                renderer.target_height = state.pixel_height
            }
        }
        pool_next_frame($&renderer.batch_pool) >>>
        pool_next_frame($&renderer.sdf_pool) >>>
        dev := renderer.session.gpu_device() >>>
        $encoder := dev.command_encoder() >>>
        attachment := gpu.ColorAttachment{view: renderer.targets[0].view(0) >>>,load: gpu.CLEAR,store: gpu.STORE,clear: clear}
        $pass := encoder.begin_render(attachment,gpu.no_depth()) >>>
        pass.end() >>>
        $fence := encoder.submit() >>>
        fence.close() >>>
        renderer.cached = false
        renderer.pixels = []u8{}
    } else {
        sync_software_frame($&renderer.session, background) >>>
        renderer.target_width = renderer.session.width
        renderer.target_height = renderer.session.height
        renderer.cached = true
    }
    renderer.active = true
    renderer.frame_vertices = 0
    renderer.clip_x = 0
    renderer.clip_y = 0
    renderer.clip_width = renderer.target_width
    renderer.clip_height = renderer.target_height
    << 0
}
fn alloc_device_vertex_buffer(session &present.Session, size_bytes int) gpu.Buffer {
    dev := session.gpu_device() >>>
    << dev.buffer(size_bytes, gpu.BUFFER_VERTEX) >>>
}

fn install_renderer_pool_buf(renderer $&Renderer2D, is_sdf bool, slot_idx int, cap int) int {
    if is_sdf {
        buf := alloc_device_vertex_buffer(&renderer.session, cap) >>>
        << pool_install_buffer($&renderer.sdf_pool, slot_idx, cap, buf) >>>
    }
    buf := alloc_device_vertex_buffer(&renderer.session, cap) >>>
    << pool_install_buffer($&renderer.batch_pool, slot_idx, cap, buf) >>>
}

fn upload_renderer_pool(renderer $&Renderer2D, is_sdf bool, bytes &[]u8, vertex_count int) PooledSlice {
    $plan := []int{}
    if is_sdf { plan = pool_plan(&renderer.sdf_pool, bytes.len, false) }
    else { plan = pool_plan(&renderer.batch_pool, bytes.len, false) }
    slot_idx := plan[0]
    start := plan[1]
    if plan[2] != 0 {
        install_renderer_pool_buf(renderer, is_sdf, slot_idx, plan[3]) >>>
    }
    dev := renderer.session.gpu_device() >>>
    if is_sdf {
        $f := dev.upload(&renderer.sdf_pool.slots[slot_idx].buffer[0], start, bytes) >>>
        f.close() >>>
    } else {
        $f := dev.upload(&renderer.batch_pool.slots[slot_idx].buffer[0], start, bytes) >>>
        f.close() >>>
    }
    next_off := align_transfer_offset(start + bytes.len)
    if is_sdf { renderer.sdf_pool.offset = next_off }
    else { renderer.batch_pool.offset = next_off }
    << PooledSlice{slot: slot_idx, offset: start, vertex_count: vertex_count}
}

fn draw_renderer_solid_gpu(renderer $&Renderer2D, batch &canvas.Batch2D) int {
    count := batch.vertex_count()
    if count <= 0 { << 0 }
    bytes := vertex_bytes(batch) >>>
    uploaded := upload_renderer_pool(renderer, false, &bytes, count) >>>
    dev := renderer.session.gpu_device() >>>
    << draw_target_slice(dev, &renderer.batch_pool, uploaded, &renderer.targets[0], &renderer.drawings[0],
        true, &renderer.nearests[0], &renderer.whites[0], renderer.target_width, renderer.target_height,
        renderer.clip_x, renderer.clip_y, renderer.clip_width, renderer.clip_height) >>>
}

fn draw_renderer_textured_gpu(renderer $&Renderer2D, tex &gpu.Texture,
    linear bool, batch &canvas.Batch2D) int {
    count := batch.vertex_count()
    if count <= 0 { << 0 }
    bytes := vertex_bytes(batch) >>>
    uploaded := upload_renderer_pool(renderer, false, &bytes, count) >>>
    dev := renderer.session.gpu_device() >>>
    if linear {
        << draw_target_slice(dev, &renderer.batch_pool, uploaded, &renderer.targets[0], &renderer.drawings[0],
            true, &renderer.linears[0], tex, renderer.target_width, renderer.target_height,
            renderer.clip_x, renderer.clip_y, renderer.clip_width, renderer.clip_height) >>>
    }
    << draw_target_slice(dev, &renderer.batch_pool, uploaded, &renderer.targets[0], &renderer.drawings[0],
        true, &renderer.nearests[0], tex, renderer.target_width, renderer.target_height,
        renderer.clip_x, renderer.clip_y, renderer.clip_width, renderer.clip_height) >>>
}

fn draw_renderer_sdf_gpu(renderer $&Renderer2D, batch &canvas.SdfBatch) int {
    bytes := sdf_vertex_bytes(batch)
    vertex_count := bytes.len / 40
    if vertex_count <= 0 { << 0 }
    uploaded := upload_renderer_pool(renderer, true, &bytes, vertex_count) >>>
    dev := renderer.session.gpu_device() >>>
    << draw_target_slice(dev, &renderer.sdf_pool, uploaded, &renderer.targets[0], &renderer.sdf_pipelines[0],
        false, &renderer.nearests[0], &renderer.whites[0], renderer.target_width, renderer.target_height,
        renderer.clip_x, renderer.clip_y, renderer.clip_width, renderer.clip_height) >>>
}

fn draw_renderer_text_gpu(renderer $&Renderer2D, tex &gpu.Texture,
    linear bool, batch &canvas.Batch2D) int {
    count := batch.vertex_count()
    if count <= 0 { << 0 }
    bytes := vertex_bytes(batch) >>>
    uploaded := upload_renderer_pool(renderer, false, &bytes, count) >>>
    dev := renderer.session.gpu_device() >>>
    if linear {
        << draw_target_slice(dev, &renderer.batch_pool, uploaded, &renderer.targets[0], &renderer.text_pipelines[0],
            true, &renderer.linears[0], tex, renderer.target_width, renderer.target_height,
            renderer.clip_x, renderer.clip_y, renderer.clip_width, renderer.clip_height) >>>
    }
    << draw_target_slice(dev, &renderer.batch_pool, uploaded, &renderer.targets[0], &renderer.text_pipelines[0],
        true, &renderer.nearests[0], tex, renderer.target_width, renderer.target_height,
        renderer.clip_x, renderer.clip_y, renderer.clip_width, renderer.clip_height) >>>
}

fn soft_draw_session_batch(sess $&present.Session, clip_x int, clip_y int, clip_w int, clip_h int,
    tex &[]u8, tex_w int, tex_h int, linear bool, batch &canvas.Batch2D) {
    w := sess.width
    h := sess.height
    soft_draw_batch($&sess.pixels, w, h, clip_x, clip_y, clip_w, clip_h,
        tex, tex_w, tex_h, linear, batch)
}

fn soft_draw_session_mask(sess $&present.Session, clip_x int, clip_y int, clip_w int, clip_h int,
    mask &[]u8, tex_w int, tex_h int, linear bool, batch &canvas.Batch2D) {
    w := sess.width
    h := sess.height
    soft_draw_mask_batch($&sess.pixels, w, h, clip_x, clip_y, clip_w, clip_h,
        mask, tex_w, tex_h, linear, batch)
}

fn soft_draw_session_sdf(sess $&present.Session, clip_x int, clip_y int, clip_w int, clip_h int,
    batch &canvas.SdfBatch) {
    w := sess.width
    h := sess.height
    soft_draw_sdf_batch($&sess.pixels, w, h, clip_x, clip_y, clip_w, clip_h, batch)
}

pub fn (renderer $&Renderer2D) submit(batch &canvas.Batch2D) int {
    renderer.recording() >>>
    count := batch.vertex_count()
    renderer.check_vertices(count) >>>
    if renderer.clip_width > 0 && renderer.clip_height > 0 && count > 0 {
        if renderer.session.is_gpu() {
            draw_renderer_solid_gpu(renderer, batch) >>>
        } else {
            empty_tex := []u8{}
            cx := renderer.clip_x
            cy := renderer.clip_y
            cw := renderer.clip_width
            ch := renderer.clip_height
            soft_draw_session_batch($&renderer.session, cx, cy, cw, ch,
                &empty_tex, 0, 0, false, batch)
        }
    }
    renderer.frame_vertices += count
    if renderer.session.is_gpu() { renderer.cached = false }
    << count/3
}

pub fn (renderer $&Renderer2D) enable_sdf(program &SdfProgram2D) int {
    renderer.alive() >>>
    if renderer.active { >>> errors.new("nexus canvas: cannot configure SDF during an active frame") }
    if renderer.sdf_enabled { << 0 }
    if renderer.session.is_gpu() {
        dev := renderer.session.gpu_device() >>>
        formats := dev.shader_formats() >>>
        validate_sdf_program(program, formats) >>>
        pipe := build_sdf_pipeline(dev, layout.RGBA8_UNORM, program) >>>
        renderer.sdf_pipelines.push(pipe)
    }
    renderer.sdf_enabled = true
    << 0
}

pub fn (renderer $&Renderer2D) submit_sdf(batch &canvas.SdfBatch) int {
    renderer.recording() >>>
    if !renderer.sdf_enabled { >>> errors.new("nexus canvas: SDF rendering is not enabled") }
    rect_count := batch.rect_count()
    count := rect_count * 6
    renderer.check_vertices(count) >>>
    if renderer.clip_width > 0 && renderer.clip_height > 0 && rect_count > 0 {
        if renderer.session.is_gpu() {
            draw_renderer_sdf_gpu(renderer, batch) >>>
        } else {
            cx := renderer.clip_x
            cy := renderer.clip_y
            cw := renderer.clip_width
            ch := renderer.clip_height
            soft_draw_session_sdf($&renderer.session, cx, cy, cw, ch, batch)
        }
    }
    renderer.frame_vertices += count
    if renderer.session.is_gpu() { renderer.cached = false }
    << rect_count
}

pub fn (renderer $&Renderer2D) enable_text(program &TextProgram2D) int {
    renderer.alive() >>>
    if renderer.active { >>> errors.new("nexus canvas: cannot configure text during an active frame") }
    if renderer.text_enabled { << 0 }
    if renderer.session.is_gpu() {
        dev := renderer.session.gpu_device() >>>
        formats := dev.shader_formats() >>>
        validate_text_program(program, formats) >>>
        pipe := build_text_pipeline(dev, layout.RGBA8_UNORM, program) >>>
        renderer.text_pipelines.push(pipe)
    }
    renderer.text_enabled = true
    << 0
}

pub fn (renderer $&Renderer2D) submit_text(batch &canvas.Batch2D, mask &MaskTexture2D) int {
    renderer.recording() >>>
    if !renderer.text_enabled { >>> errors.new("nexus canvas: text rendering is not enabled") }
    if mask.closed { >>> errors.new("nexus canvas: mask texture is closed") }
    count := batch.vertex_count()
    renderer.check_vertices(count) >>>
    if renderer.session.is_gpu() {
        dev := renderer.session.gpu_device() >>>
        if !mask.has_gpu || mask.dev_refs.len == 0 || !mask.dev_refs[0].same(dev.reference()) || mask.images.len == 0 {
            >>> errors.new("nexus canvas: mask texture belongs to a different device or mode")
        }
        if renderer.clip_width > 0 && renderer.clip_height > 0 && count > 0 {
            draw_renderer_text_gpu(renderer, &mask.images[0], mask.linear, batch) >>>
        }
    } else {
        if mask.has_gpu { >>> errors.new("nexus canvas: GPU mask texture cannot render in software mode") }
        if renderer.clip_width > 0 && renderer.clip_height > 0 && count > 0 {
            cx := renderer.clip_x
            cy := renderer.clip_y
            cw := renderer.clip_width
            ch := renderer.clip_height
            soft_draw_session_mask($&renderer.session, cx, cy, cw, ch,
                &mask.soft_pixels, mask.width, mask.height, mask.linear, batch)
        }
    }
    renderer.frame_vertices += count
    if renderer.session.is_gpu() { renderer.cached = false }
    << count / 3
}
fn (renderer &Renderer2D) check_vertices(count int) int {
    if count > canvas.MAX_VERTICES_2D - renderer.frame_vertices { >>> errors.new("nexus canvas: frame vertex budget exceeded") }
    << 0
}
fn close_pool_err(pool $&GpuVertexPool) string {
    pool_close(pool) >>> (err) { << err.msg() }
    << ""
}
fn close_pipeline_err(p $&gpu.GraphicsPipeline) string {
    p.close() >>> (err) { << err.msg() }
    << ""
}
fn close_texture_err(t $&gpu.Texture) string {
    t.close() >>> (err) { << err.msg() }
    << ""
}
fn close_sampler_err(s $&gpu.Sampler) string {
    s.close() >>> (err) { << err.msg() }
    << ""
}
fn close_session(session $&present.Session) string {
    session.close() >>> (err) { << err.msg() }
    << ""
}
fn first_err(cur string, next string) string {
    if cur.len > 0 { << cur }
    << next
}
pub fn (renderer $&Renderer2D) close() int {
    if renderer.closed { << 0 }
    renderer.closed = true
    renderer.active = false
    renderer.pixels = []u8{}
    $err_msg := ""
    err_msg = first_err(err_msg, close_pool_err($&renderer.batch_pool))
    err_msg = first_err(err_msg, close_pool_err($&renderer.sdf_pool))
    for i in 0:renderer.sdf_pipelines.len { err_msg = first_err(err_msg, close_pipeline_err($&renderer.sdf_pipelines[i])) }
    for i in 0:renderer.text_pipelines.len { err_msg = first_err(err_msg, close_pipeline_err($&renderer.text_pipelines[i])) }
    for i in 0:renderer.drawings.len { err_msg = first_err(err_msg, close_pipeline_err($&renderer.drawings[i])) }
    for i in 0:renderer.copyings.len { err_msg = first_err(err_msg, close_pipeline_err($&renderer.copyings[i])) }
    for i in 0:renderer.targets.len { err_msg = first_err(err_msg, close_texture_err($&renderer.targets[i])) }
    for i in 0:renderer.whites.len { err_msg = first_err(err_msg, close_texture_err($&renderer.whites[i])) }
    for i in 0:renderer.nearests.len { err_msg = first_err(err_msg, close_sampler_err($&renderer.nearests[i])) }
    for i in 0:renderer.linears.len { err_msg = first_err(err_msg, close_sampler_err($&renderer.linears[i])) }
    renderer.sdf_pipelines = []gpu.GraphicsPipeline{}
    renderer.text_pipelines = []gpu.GraphicsPipeline{}
    renderer.drawings = []gpu.GraphicsPipeline{}
    renderer.copyings = []gpu.GraphicsPipeline{}
    renderer.targets = []gpu.Texture{}
    renderer.whites = []gpu.Texture{}
    renderer.nearests = []gpu.Sampler{}
    renderer.linears = []gpu.Sampler{}
    err_msg = first_err(err_msg, close_session($&renderer.session))
    if err_msg.len > 0 { >>> errors.new(err_msg) }
    << 0
}
fn (renderer $&Renderer2D) drop() { renderer.close() >>> (err) { << } }

pub fn (renderer &Renderer2D) poll() events.Event {
    renderer.alive() >>>
    << renderer.session.poll() >>>
}
