#include <metal_stdlib>
using namespace metal;

struct Input {
    float4 position [[position]];
    float4 color;
    float2 uv;
};

struct Lighting2DUniform {
    float4 view_rect;        // xy=origin, zw=size
    float4 ambient_exposure; // xyz=ambient, w=exposure
    float4 counts_bias;      // x=light_count, y=occluder_count, z=shadow_bias, w=use_normal_map
    float4 lights[128];      // 32 lights * 4 float4
    float4 occluders[128];   // 128 segments (ax, ay, bx, by)
};

static inline bool seg_occluded_2d(float2 from_p, float2 to_p, constant Lighting2DUniform& u, int occ_count, float bias) {
    float2 delta = to_p - from_p;
    float dist = length(delta);
    if (dist <= bias + 1e-4) return false;
    float2 dir = delta / dist;
    float max_t = dist - bias;
    for (int i = 0; i < 128 && i < occ_count; ++i) {
        float4 seg = u.occluders[i];
        float sx = seg.z - seg.x;
        float sy = seg.w - seg.y;
        float denom = dir.x * sy - dir.y * sx;
        if (abs(denom) <= 1e-7) continue;
        float qx = seg.x - from_p.x;
        float qy = seg.y - from_p.y;
        float t = (qx * sy - qy * sx) / denom;
        float u_param = (qx * dir.y - qy * dir.x) / denom;
        if (t > 0.001 && t < max_t && u_param >= -1e-4 && u_param <= 1.0 + 1e-4) {
            return true;
        }
    }
    return false;
}

static inline float shadow_factor_2d(float2 light_pos, float2 world_pos, float softness, constant Lighting2DUniform& u, int occ_count, float bias) {
    float2 delta = world_pos - light_pos;
    float dist = length(delta);
    if (dist <= bias + 1e-4) return 1.0;
    if (softness <= 0.0001) {
        return seg_occluded_2d(light_pos, world_pos, u, occ_count, bias) ? 0.0 : 1.0;
    }
    float2 perp = float2(-delta.y / dist, delta.x / dist);
    float vis = 0.0;
    const float offsets[5] = { -1.0, -0.5, 0.0, 0.5, 1.0 };
    for (int k = 0; k < 5; ++k) {
        float2 tap = light_pos + perp * (offsets[k] * softness);
        if (!seg_occluded_2d(tap, world_pos, u, occ_count, bias)) vis += 1.0;
    }
    return vis * 0.2;
}

fragment float4 main0(
    Input input [[stage_in]],
    constant Lighting2DUniform& u [[buffer(0)]],
    texture2d<float> scene_tex [[texture(0)]],
    sampler scene_sampler [[sampler(0)]],
    texture2d<float> normal_tex [[texture(1)]],
    sampler normal_sampler [[sampler(1)]]
) {
    float4 albedo = scene_tex.sample(scene_sampler, input.uv);
    float2 world_pos = u.view_rect.xy + input.uv * u.view_rect.zw;
    float3 normal = float3(0.0, 0.0, 1.0);
    if (u.counts_bias.w > 0.5) {
        float3 n_sample = normal_tex.sample(normal_sampler, input.uv).rgb * 2.0 - 1.0;
        float nlen = length(n_sample);
        if (nlen > 1e-5) normal = n_sample / nlen;
    }
    int lcount = int(u.counts_bias.x);
    int ocount = int(u.counts_bias.y);
    float bias = u.counts_bias.z;

    float3 lit = u.ambient_exposure.xyz;
    for (int i = 0; i < 32 && i < lcount; ++i) {
        int b = i * 4;
        float4 d0 = u.lights[b + 0]; // px, py, height, kind
        float4 d1 = u.lights[b + 1]; // dx, dy, radius, falloff
        float4 d2 = u.lights[b + 2]; // cr*int, cg*int, cb*int, inner_cos
        float4 d3 = u.lights[b + 3]; // outer_cos, cast_shadows, softness, enabled
        if (d3.w < 0.5) continue;

        int kind = int(d0.w + 0.5);
        if (kind == 2) {
            float3 l3 = normalize(float3(-d1.x, -d1.y, max(d0.z, 1.0) / 32.0));
            float ndotl = max(0.0, dot(normal, l3));
            lit += d2.xyz * ndotl;
            continue;
        }

        float2 to_light = d0.xy - world_pos;
        float dist = length(to_light);
        if (dist >= d1.z) continue;
        float norm_u = clamp(1.0 - dist / d1.z, 0.0, 1.0);
        float atten = pow(max(norm_u, 1e-6), d1.w);
        if (norm_u <= 0.0) atten = 0.0;

        if (kind == 1) {
            float2 out_dir = dist > 1e-6 ? (-to_light / dist) : float2(1.0, 0.0);
            float cos_a = dot(d1.xy, out_dir);
            atten *= smoothstep(d3.x, d2.w, cos_a);
        }
        if (atten <= 0.0) continue;

        float3 l3 = normalize(float3(to_light.x, to_light.y, max(d0.z, 1.0)));
        float ndotl = max(0.0, dot(normal, l3));
        if (ndotl <= 0.0) continue;

        float vis = 1.0;
        if (d3.y > 0.5) {
            vis = shadow_factor_2d(d0.xy, world_pos, d3.z, u, ocount, bias);
        }
        lit += d2.xyz * (atten * ndotl * vis);
    }
    float3 final_rgb = clamp(albedo.rgb * lit * u.ambient_exposure.w, float3(0.0), float3(1.0));
    return float4(final_rgb * input.color.rgb, albedo.a * input.color.a);
}
