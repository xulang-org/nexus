#include <metal_stdlib>
using namespace metal;
struct Vertex { float2 point [[attribute(0)]]; float4 color [[attribute(1)]]; float2 uv [[attribute(2)]]; };
struct Output { float4 position [[position]]; float4 color; float2 uv; };
vertex Output main0(Vertex input [[stage_in]],constant float4 &viewport [[buffer(0)]]) {
    Output out; out.position=float4(input.point.x/viewport.x*2-1,1-input.point.y/viewport.y*2,0,1);
    out.color=input.color;out.uv=input.uv;return out;
}
