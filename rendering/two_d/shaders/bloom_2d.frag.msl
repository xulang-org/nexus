#include <metal_stdlib>
using namespace metal;

struct Input {
    float4 position [[position]];
    float4 color;
    float2 uv;
};

struct Bloom2DUniform {
    float4 params0; // x=mode(0:bright+hblur,1:vblur+composite), y=threshold, z=soft_knee, w=intensity
    float4 params1; // x=texel_x, y=texel_y, z=radius, w=0
};

static inline float3 bright_extract(float3 c, float threshold, float soft_knee) {
    float luma = max(c.r, max(c.g, c.b));
    float knee = max(soft_knee, 1e-4);
    float soft = clamp(luma - threshold + knee, 0.0, 2.0 * knee);
    soft = (soft * soft) / (4.0 * knee);
    float contrib = max(soft, luma - threshold) / max(luma, 1e-5);
    return c * max(contrib, 0.0);
}

fragment float4 main0(
    Input input [[stage_in]],
    constant Bloom2DUniform& u [[buffer(0)]],
    texture2d<float> scene_tex [[texture(0)]],
    sampler scene_sampler [[sampler(0)]],
    texture2d<float> bloom_tex [[texture(1)]],
    sampler bloom_sampler [[sampler(1)]]
) {
    const float offsets[9] = { -4.0, -3.0, -2.0, -1.0, 0.0, 1.0, 2.0, 3.0, 4.0 };
    const float weights[9] = { 0.016216, 0.054054, 0.121622, 0.194595, 0.227027, 0.194595, 0.121622, 0.054054, 0.016216 };
    if (u.params0.x < 0.5) {
        float3 sum = float3(0.0, 0.0, 0.0);
        for (int k = 0; k < 9; ++k) {
            float2 suv = clamp(input.uv + float2(offsets[k] * u.params1.z * u.params1.x, 0.0), float2(0.0), float2(1.0));
            float3 tex = scene_tex.sample(scene_sampler, suv).rgb;
            sum += bright_extract(tex, u.params0.y, u.params0.z) * weights[k];
        }
        return float4(sum, 1.0);
    }
    float3 vblur = float3(0.0, 0.0, 0.0);
    for (int k = 0; k < 9; ++k) {
        float2 buv = clamp(input.uv + float2(0.0, offsets[k] * u.params1.z * u.params1.y), float2(0.0), float2(1.0));
        vblur += bloom_tex.sample(bloom_sampler, buv).rgb * weights[k];
    }
    float4 base = scene_tex.sample(scene_sampler, input.uv);
    float3 out_rgb = clamp(base.rgb + vblur * u.params0.w, float3(0.0), float3(1.0));
    return float4(out_rgb * input.color.rgb, base.a * input.color.a);
}
