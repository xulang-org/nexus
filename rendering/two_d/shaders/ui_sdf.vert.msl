#include <metal_stdlib>
using namespace metal;
struct Vertex {
    float2 pos [[attribute(0)]];
    float2 local_pos [[attribute(1)]];
    float4 params [[attribute(2)]];
    float4 fill_color [[attribute(3)]];
    float4 border_color [[attribute(4)]];
};
struct Output {
    float4 position [[position]];
    float2 local_pos;
    float4 params;
    float4 fill_color;
    float4 border_color;
};
vertex Output main0(Vertex input [[stage_in]], constant float4 &viewport [[buffer(0)]]) {
    Output out;
    out.position = float4(input.pos.x / viewport.x * 2.0 - 1.0, 1.0 - input.pos.y / viewport.y * 2.0, 0.0, 1.0);
    out.local_pos = input.local_pos;
    out.params = input.params;
    out.fill_color = input.fill_color;
    out.border_color = input.border_color;
    return out;
}
