@"github.com/xulang-org/nexus/rendering/two_d"

#encoding/binary
#errors
#gpu
#gpu/layout
fm #"github.com/xulang-org/nexus/foundation/math"
present #"github.com/xulang-org/nexus/platform/present"
canvas #"github.com/xulang-org/nexus/resources/canvas"

const BLOOM_UNIFORM_BYTES_2D = 32

pub struct BloomProgram2D {
    pub format int
    pub entrypoint string
    pub vertex []u8
    pub fragment []u8
}

pub struct BloomConfig2D {
    pub threshold f64
    pub soft_knee f64
    pub intensity f64
    pub radius f64
}

pub fn empty_bloom_program_2d() BloomProgram2D {
    << BloomProgram2D{format: 0, entrypoint: "", vertex: []u8{}, fragment: []u8{}}
}

pub fn default_bloom_2d() BloomConfig2D {
    << BloomConfig2D{threshold: 0.72, soft_knee: 0.2, intensity: 0.65, radius: 2.0}
}

pub fn (cfg &BloomConfig2D) validate() int {
    if !fm.finite(cfg.threshold) || cfg.threshold < 0.0 || cfg.threshold > 4.0 ||
        !fm.finite(cfg.soft_knee) || cfg.soft_knee < 0.0 || cfg.soft_knee > 2.0 ||
        !fm.finite(cfg.intensity) || cfg.intensity < 0.0 || cfg.intensity > 8.0 ||
        !fm.finite(cfg.radius) || cfg.radius < 0.0 || cfg.radius > 16.0 {
        >> errors.new("nexus canvas: invalid 2D bloom parameters")
    }
    << 0
}

fn validate_bloom_program_2d(program &BloomProgram2D, formats int) int {
    if program.entrypoint.len == 0 || program.vertex.len == 0 || program.fragment.len == 0 {
        >> errors.new("nexus canvas: empty 2D bloom shader program")
    }
    if (program.format & formats) == 0 {
        >> errors.new("nexus canvas: 2D bloom shader format unsupported by GPU device")
    }
    << 0
}

fn build_bloom_pipeline_2d(device &gpu.Device, program &BloomProgram2D) gpu.GraphicsPipeline {
    $vs := device.shader(&gpu.ShaderDesc{
        stage: gpu.VERTEX,
        format: program.format,
        entrypoint: program.entrypoint + "",
        samplers: 0,
        uniform_sizes: [16]
    }, &program.vertex) >>>
    $fs := device.shader(&gpu.ShaderDesc{
        stage: gpu.FRAGMENT,
        format: program.format,
        entrypoint: program.entrypoint + "",
        samplers: 2,
        uniform_sizes: [BLOOM_UNIFORM_BYTES_2D]
    }, &program.fragment) >>>
    desc := pipeline_description(layout.RGBA8_UNORM, gpu.BLEND_DISABLED)
    pipe := device.graphics_pipeline(&vs, &fs, &desc) >>>
    vs.close() >>>
    fs.close() >>>
    << pipe
}

fn bloom_uniform_bytes_2d(mode f64, cfg &BloomConfig2D, width int, height int) []u8 {
    $bytes := []u8{}
    for _ in 0:BLOOM_UNIFORM_BYTES_2D { bytes.push(u8(0)) }
    order := binary.little_endian()
    order.put_f32($&bytes, 0, mode) >>>
    order.put_f32($&bytes, 4, cfg.threshold) >>>
    order.put_f32($&bytes, 8, cfg.soft_knee) >>>
    order.put_f32($&bytes, 12, cfg.intensity) >>>
    order.put_f32($&bytes, 16, 1.0 / f64(width)) >>>
    order.put_f32($&bytes, 20, 1.0 / f64(height)) >>>
    order.put_f32($&bytes, 24, cfg.radius) >>>
    order.put_f32($&bytes, 28, 0.0) >>>
    << bytes
}

pub fn (renderer $&Renderer2D) enable_bloom_2d(program &BloomProgram2D) int {
    renderer.alive() >>>
    if renderer.active { >> errors.new("nexus canvas: cannot configure 2D bloom during an active frame") }
    if renderer.bloom_enabled { << 0 }
    if renderer.session.is_gpu() {
        dev := renderer.session.gpu_device() >>>
        formats := dev.shader_formats() >>>
        validate_bloom_program_2d(program, formats) >>>
        $pipe := build_bloom_pipeline_2d(dev, program) >>>
        if renderer.targets.len < 2 {
            extra := target_texture(dev, renderer.target_width, renderer.target_height) >>>
            renderer.targets.push(extra)
        }
        if renderer.bloom_temps.len == 0 {
            btex := target_texture(dev, renderer.target_width, renderer.target_height) >>>
            renderer.bloom_temps.push(btex)
        }
        renderer.bloom_pipelines.push(pipe)
    }
    renderer.bloom_enabled = true
    << 0
}

fn soft_apply_session_bloom_2d(sess $&present.Session, cfg &BloomConfig2D) int {
    w := sess.width
    h := sess.height
    << soft_apply_bloom_2d($&sess.pixels, w, h, cfg.threshold, cfg.soft_knee, cfg.intensity, cfg.radius) >>>
}

pub fn (renderer $&Renderer2D) apply_bloom_2d(cfg &BloomConfig2D) int {
    renderer.recording() >>>
    if !renderer.bloom_enabled { >> errors.new("nexus canvas: 2D bloom is not enabled") }
    cfg.validate() >>>
    if cfg.intensity <= 0.00001 { << 0 }

    if !renderer.session.is_gpu() {
        soft_apply_session_bloom_2d($&renderer.session, cfg) >>>
        renderer.cached = true
        << 0
    }
    if renderer.targets.len < 2 || renderer.bloom_pipelines.len == 0 || renderer.bloom_temps.len == 0 {
        >> errors.new("nexus canvas: GPU 2D bloom resources missing")
    }

    $quad := canvas.new_batch()
    quad.quad(fm.rect2(0.0, 0.0, f64(renderer.target_width), f64(renderer.target_height)), fm.identity(), 4294967295) >>>
    renderer.check_vertices(6) >>>
    vbytes := vertex_bytes(&quad) >>>
    uploaded := upload_renderer_pool(renderer, false, &vbytes, 6) >>>
    vuni := viewport_uniform(renderer.target_width, renderer.target_height) >>>
    u0 := bloom_uniform_bytes_2d(0.0, cfg, renderer.target_width, renderer.target_height) >>>
    u1 := bloom_uniform_bytes_2d(1.0, cfg, renderer.target_width, renderer.target_height) >>>

    src_idx := renderer.active_target
    dst_idx := 1 - src_idx
    sidx := uploaded.slot
    dev := renderer.session.gpu_device() >>>
    $encoder := dev.command_encoder() >>>

    // Pass 1: Bright-pass + Horizontal Gaussian blur into bloom_temps[0].
    att0 := gpu.ColorAttachment{
        view: renderer.bloom_temps[0].view(0) >>>,
        load: gpu.CLEAR,
        store: gpu.STORE,
        clear: gpu.Color{r: 0.0, g: 0.0, b: 0.0, a: 1.0}
    }
    $pass0 := encoder.begin_render(att0, gpu.no_depth()) >>>
    pass0.pipeline(&renderer.bloom_pipelines[0]) >>>
    pass0.viewport(0, 0, renderer.target_width, renderer.target_height) >>>
    pass0.scissor(0, 0, renderer.target_width, renderer.target_height) >>>
    pass0.vertex_buffer(0, &renderer.batch_pool.slots[sidx].buffer[0], uploaded.offset) >>>
    pass0.sampler(gpu.FRAGMENT, 0, &renderer.targets[src_idx], &renderer.linears[0]) >>>
    pass0.sampler(gpu.FRAGMENT, 1, &renderer.whites[0], &renderer.linears[0]) >>>
    pass0.uniform(gpu.VERTEX, 0, &vuni) >>>
    pass0.uniform(gpu.FRAGMENT, 0, &u0) >>>
    pass0.draw(6, 0, 1, 0) >>>
    pass0.end() >>>

    // Pass 2: Vertical Gaussian blur + additive composite into targets[dst_idx].
    att1 := gpu.ColorAttachment{
        view: renderer.targets[dst_idx].view(0) >>>,
        load: gpu.CLEAR,
        store: gpu.STORE,
        clear: gpu.Color{r: 0.0, g: 0.0, b: 0.0, a: 1.0}
    }
    $pass1 := encoder.begin_render(att1, gpu.no_depth()) >>>
    pass1.pipeline(&renderer.bloom_pipelines[0]) >>>
    pass1.viewport(0, 0, renderer.target_width, renderer.target_height) >>>
    pass1.scissor(0, 0, renderer.target_width, renderer.target_height) >>>
    pass1.vertex_buffer(0, &renderer.batch_pool.slots[sidx].buffer[0], uploaded.offset) >>>
    pass1.sampler(gpu.FRAGMENT, 0, &renderer.targets[src_idx], &renderer.nearests[0]) >>>
    pass1.sampler(gpu.FRAGMENT, 1, &renderer.bloom_temps[0], &renderer.linears[0]) >>>
    pass1.uniform(gpu.VERTEX, 0, &vuni) >>>
    pass1.uniform(gpu.FRAGMENT, 0, &u1) >>>
    pass1.draw(6, 0, 1, 0) >>>
    pass1.end() >>>

    $fence := encoder.submit() >>>
    fence.close() >>>

    renderer.active_target = dst_idx
    renderer.frame_vertices += 6
    renderer.cached = false
    << 0
}
