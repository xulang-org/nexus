@"github.com/xulang-org/nexus/rendering/two_d"

canvas #"github.com/xulang-org/nexus/resources/canvas"
fm #"github.com/xulang-org/nexus/foundation/math"
present #"github.com/xulang-org/nexus/platform/present"
#gpu
#gpu/layout
#errors
#math

const OVERLAY_CMD_BATCH = 0
const OVERLAY_CMD_SDF = 1
const OVERLAY_CMD_TEXT = 2

struct OverlayCmd {
    kind int
    index int
    clip_x int
    clip_y int
    clip_w int
    clip_h int
    has_clip bool
}

struct PreparedOverlayCmd {
    kind int
    slice PooledSlice
    clip_x int
    clip_y int
    clip_w int
    clip_h int
}

// Overlay2D composites 2D triangles and SDF UI primitives onto an existing swapchain
// frame (GPU) or RGBA8 pixel buffer (software/headless) without owning a window or device.
pub struct Overlay2D {
    dev_refs []gpu.DeviceRef
    drawing []gpu.GraphicsPipeline
    sdf_pipe []gpu.GraphicsPipeline
    text_pipe []gpu.GraphicsPipeline
    nearest []gpu.Sampler
    linear []gpu.Sampler
    white []gpu.Texture
    text_mask []gpu.Texture
    text_soft []u8
    text_mask_w int
    text_mask_h int
    text_mask_linear bool
    text_mask_rev int
    color_format int
    text_enabled bool
    pool GpuVertexPool
    gpu_mode bool
    has_clip bool
    clip_x int
    clip_y int
    clip_w int
    clip_h int
    cmds []OverlayCmd
    batches []canvas.Batch2D
    sdfs []canvas.SdfBatch
    closed bool
}

fn white_texture_2d(device &gpu.Device) gpu.Texture {
    $tex := device.texture_2d(gpu.Texture2DDesc{format: layout.RGBA8_UNORM, width: 1, height: 1,
        levels: 1, usage: gpu.TEXTURE_SAMPLED}) >>>
    $bytes := [u8(255), u8(255), u8(255), u8(255)]
    $up := device.upload_texture(&tex, 0, &bytes) >>>
    up.close() >>>
    << tex
}

fn sampler_2d(device &gpu.Device, linear bool) gpu.Sampler {
    $desc := gpu.sampler_defaults()
    $mode := gpu.NEAREST
    if linear { mode = gpu.LINEAR }
    desc.min_filter = mode
    desc.mag_filter = mode
    desc.mip_filter = mode
    << device.sampler(desc) >>>
}

pub fn open_overlay_software() Overlay2D {
    << Overlay2D{dev_refs: []gpu.DeviceRef{},
        drawing: []gpu.GraphicsPipeline{},
        sdf_pipe: []gpu.GraphicsPipeline{},
        text_pipe: []gpu.GraphicsPipeline{},
        nearest: []gpu.Sampler{},
        linear: []gpu.Sampler{},
        white: []gpu.Texture{},
        text_mask: []gpu.Texture{},
        text_soft: []u8{},
        text_mask_w: 0, text_mask_h: 0, text_mask_linear: true, text_mask_rev: 0,
        color_format: 0, text_enabled: true,
        pool: new_vertex_pool(),
        gpu_mode: false,
        has_clip: false,
        clip_x: 0, clip_y: 0, clip_w: 0, clip_h: 0,
        cmds: []OverlayCmd{},
        batches: []canvas.Batch2D{},
        sdfs: []canvas.SdfBatch{},
        closed: false}
}

pub fn open_overlay(session &present.Session, canvas_program &ShaderProgram2D, sdf_program &SdfProgram2D) Overlay2D {
    if !session.is_gpu() {
        << open_overlay_software()
    }
    dev := session.gpu_device() >>>
    color_format := session.swapchain_format() >>>
    formats := dev.shader_formats() >>>
    validate_shader_program(canvas_program, formats) >>>
    validate_sdf_program(sdf_program, formats) >>>
    $drawing := build_canvas_pipeline(dev, color_format, canvas_program) >>>
    $sdf_pipe := build_sdf_pipeline(dev, color_format, sdf_program) >>>
    $nearest := sampler_2d(dev, false) >>>
    $linear := sampler_2d(dev, true) >>>
    $white := white_texture_2d(dev) >>>
    << Overlay2D{dev_refs: [dev.reference()],
        drawing: [drawing],
        sdf_pipe: [sdf_pipe],
        text_pipe: []gpu.GraphicsPipeline{},
        nearest: [nearest],
        linear: [linear],
        white: [white],
        text_mask: []gpu.Texture{},
        text_soft: []u8{},
        text_mask_w: 0, text_mask_h: 0, text_mask_linear: true, text_mask_rev: 0,
        color_format: color_format, text_enabled: false,
        pool: new_vertex_pool(),
        gpu_mode: true,
        has_clip: false,
        clip_x: 0, clip_y: 0, clip_w: 0, clip_h: 0,
        cmds: []OverlayCmd{},
        batches: []canvas.Batch2D{},
        sdfs: []canvas.SdfBatch{},
        closed: false}
}

fn validate_shader_program(program &ShaderProgram2D, formats int) int {
    if program.entrypoint.len == 0 || program.vertex.len == 0 || program.fragment.len == 0 {
        >> errors.new("nexus canvas: empty shader program")
    }
    if (program.format & formats) == 0 {
        >> errors.new("nexus canvas: shader format unsupported by GPU device")
    }
    << 0
}

fn (overlay &Overlay2D) alive() int {
    if overlay.closed { >> errors.new("nexus canvas: overlay is closed") }
    << 0
}

pub fn (overlay &Overlay2D) is_gpu() bool { << !overlay.closed && overlay.gpu_mode }

pub fn (overlay $&Overlay2D) clear() int {
    overlay.alive() >>>
    overlay.cmds = []OverlayCmd{}
    overlay.batches = []canvas.Batch2D{}
    overlay.sdfs = []canvas.SdfBatch{}
    overlay.has_clip = false
    << 0
}

pub fn (overlay $&Overlay2D) clip_rect(bounds fm.Rect2) int {
    overlay.alive() >>>
    if !bounds.valid() || !fm.finite(bounds.position.x) || !fm.finite(bounds.position.y) ||
        !fm.finite(bounds.size.x) || !fm.finite(bounds.size.y) {
        >> errors.new("nexus canvas: invalid clip rectangle")
    }
    overlay.has_clip = true
    overlay.clip_x = int(math.floor(bounds.position.x))
    overlay.clip_y = int(math.floor(bounds.position.y))
    overlay.clip_w = int(math.ceil(bounds.position.x + bounds.size.x)) - overlay.clip_x
    overlay.clip_h = int(math.ceil(bounds.position.y + bounds.size.y)) - overlay.clip_y
    << 0
}

pub fn (overlay $&Overlay2D) reset_clip() int {
    overlay.alive() >>>
    overlay.has_clip = false
    << 0
}

pub fn (overlay $&Overlay2D) submit(batch &canvas.Batch2D) int {
    overlay.alive() >>>
    if batch.vertex_count() <= 0 { << 0 }
    idx := overlay.batches.len
    overlay.batches.push(clone_batch(batch))
    overlay.cmds.push(OverlayCmd{kind: OVERLAY_CMD_BATCH, index: idx,
        clip_x: overlay.clip_x, clip_y: overlay.clip_y,
        clip_w: overlay.clip_w, clip_h: overlay.clip_h,
        has_clip: overlay.has_clip})
    << batch.triangle_count()
}

pub fn (overlay $&Overlay2D) submit_sdf(batch &canvas.SdfBatch) int {
    overlay.alive() >>>
    if batch.rect_count() <= 0 { << 0 }
    idx := overlay.sdfs.len
    overlay.sdfs.push(clone_sdf_batch(batch))
    overlay.cmds.push(OverlayCmd{kind: OVERLAY_CMD_SDF, index: idx,
        clip_x: overlay.clip_x, clip_y: overlay.clip_y,
        clip_w: overlay.clip_w, clip_h: overlay.clip_h,
        has_clip: overlay.has_clip})
    << batch.rect_count()
}

pub fn (overlay $&Overlay2D) enable_text_device(device &gpu.Device, program &TextProgram2D) int {
    overlay.alive() >>>
    if !overlay.gpu_mode { >> errors.new("nexus canvas: software overlay cannot enable GPU text pipeline") }
    if overlay.dev_refs.len == 0 || !overlay.dev_refs[0].same(device.reference()) {
        >> errors.new("nexus canvas: overlay belongs to a different GPU device")
    }
    if overlay.text_enabled { << 0 }
    formats := device.shader_formats() >>>
    validate_text_program(program, formats) >>>
    pipe := build_text_pipeline(device, overlay.color_format, program) >>>
    overlay.text_pipe.push(pipe)
    overlay.text_enabled = true
    << 0
}

pub fn (overlay $&Overlay2D) enable_text(session &present.Session, program &TextProgram2D) int {
    overlay.alive() >>>
    if !session.is_gpu() {
        if overlay.gpu_mode { >> errors.new("nexus canvas: GPU overlay cannot configure software session") }
        overlay.text_enabled = true
        << 0
    }
    dev := session.gpu_device() >>>
    << overlay.enable_text_device(dev, program) >>>
}

pub fn (overlay $&Overlay2D) sync_text_mask_software(width int, height int,
    linear bool, bytes &[]u8, revision int) int {
    overlay.alive() >>>
    if overlay.gpu_mode { >> errors.new("nexus canvas: GPU overlay cannot sync software text mask") }
    overlay.text_mask_linear = linear
    if revision > 0 && revision == overlay.text_mask_rev &&
        width == overlay.text_mask_w && height == overlay.text_mask_h &&
        overlay.text_soft.len == width * height {
        << 0
    }
    validate_mask_bytes(width, height, bytes) >>>
    overlay.text_soft = clone_u8_slice(bytes)
    overlay.text_mask_w = width
    overlay.text_mask_h = height
    overlay.text_mask_rev = revision
    << 0
}

pub fn (overlay $&Overlay2D) sync_text_mask_device(device &gpu.Device, width int, height int,
    linear bool, bytes &[]u8, revision int) int {
    overlay.alive() >>>
    if !overlay.gpu_mode { >> errors.new("nexus canvas: software overlay cannot sync GPU text mask") }
    if overlay.dev_refs.len == 0 || !overlay.dev_refs[0].same(device.reference()) {
        >> errors.new("nexus canvas: overlay belongs to a different GPU device")
    }
    overlay.text_mask_linear = linear
    if revision > 0 && revision == overlay.text_mask_rev &&
        width == overlay.text_mask_w && height == overlay.text_mask_h &&
        overlay.text_mask.len > 0 {
        << 0
    }
    validate_mask_bytes(width, height, bytes) >>>
    if width == overlay.text_mask_w && height == overlay.text_mask_h && overlay.text_mask.len > 0 {
        $up := device.upload_texture(&overlay.text_mask[0], 0, bytes) >>>
        up.close() >>>
    } else {
        replacement := create_r8_gpu_texture(device, width, height, bytes) >>>
        if overlay.text_mask.len > 0 {
            old := $&overlay.text_mask[0]
            old.close() >>>
        }
        overlay.text_mask = [replacement]
        overlay.text_mask_w = width
        overlay.text_mask_h = height
    }
    overlay.text_mask_rev = revision
    << 0
}

pub fn (overlay $&Overlay2D) sync_text_mask(session &present.Session, width int, height int,
    linear bool, bytes &[]u8, revision int) int {
    overlay.alive() >>>
    if !session.is_gpu() {
        << overlay.sync_text_mask_software(width, height, linear, bytes, revision) >>>
    }
    dev := session.gpu_device() >>>
    << overlay.sync_text_mask_device(dev, width, height, linear, bytes, revision) >>>
}

pub fn (overlay $&Overlay2D) submit_text(batch &canvas.Batch2D) int {
    overlay.alive() >>>
    if !overlay.text_enabled { >> errors.new("nexus canvas: text rendering is not enabled") }
    if batch.vertex_count() <= 0 { << 0 }
    idx := overlay.batches.len
    overlay.batches.push(clone_batch(batch))
    overlay.cmds.push(OverlayCmd{kind: OVERLAY_CMD_TEXT, index: idx,
        clip_x: overlay.clip_x, clip_y: overlay.clip_y,
        clip_w: overlay.clip_w, clip_h: overlay.clip_h,
        has_clip: overlay.has_clip})
    << batch.triangle_count()
}

fn clone_batch(src &canvas.Batch2D) canvas.Batch2D {
    $out := canvas.new_batch()
    count := src.triangle_count()
    for t in 0:count {
        base := t * 3
        v0 := src.vertex_at(base) >>> (err) { << out }
        v1 := src.vertex_at(base + 1) >>> (err) { << out }
        v2 := src.vertex_at(base + 2) >>> (err) { << out }
        out.triangle_uv(v0.point, v1.point, v2.point,
            v0.color, v1.color, v2.color,
            v0.uv, v1.uv, v2.uv) >>> (err) { << out }
    }
    << out
}

fn clone_sdf_batch(src &canvas.SdfBatch) canvas.SdfBatch {
    $out := canvas.new_sdf_batch()
    count := src.rect_count()
    for i in 0:count {
        r := src.rect_at(i) >>> (err) { << out }
        out.rounded_rect(r.bounds, r.radius, r.fill_color, r.border_width, r.border_color) >>> (err) { << out }
    }
    << out
}

fn resolve_clip(cmd &OverlayCmd, width int, height int) []int {
    if !cmd.has_clip { << [0, 0, width, height] }
    $x0 := cmd.clip_x
    $y0 := cmd.clip_y
    $x1 := cmd.clip_x + cmd.clip_w
    $y1 := cmd.clip_y + cmd.clip_h
    if x0 < 0 { x0 = 0 }
    if y0 < 0 { y0 = 0 }
    if x1 > width { x1 = width }
    if y1 > height { y1 = height }
    $w := x1 - x0
    $h := y1 - y0
    if w < 0 { w = 0 }
    if h < 0 { h = 0 }
    << [x0, y0, w, h]
}

fn clear_rgba_buffer(pixels $&[]u8, width int, height int, rgba int) int {
    if pixels.len != width * height * 4 {
        >> errors.new("nexus canvas: software buffer length mismatch")
    }
    if rgba < 0 || rgba > 4294967295 {
        >> errors.new("nexus canvas: invalid RGBA clear color")
    }
    r := u8((rgba >> 24) & 255)
    g := u8((rgba >> 16) & 255)
    b := u8((rgba >> 8) & 255)
    a := u8(rgba & 255)
    total := width * height
    for i in 0:total {
        off := i * 4
        pixels[off] = r
        pixels[off + 1] = g
        pixels[off + 2] = b
        pixels[off + 3] = a
    }
    << 0
}

fn record_overlay_text_pass(pass &gpu.RenderPass, overlay &Overlay2D,
    vb &gpu.Buffer, offset int, width int, height int,
    item &PreparedOverlayCmd, mask_tex &gpu.Texture, linear bool) int {
    if linear {
        << record_draw_pass(pass, &overlay.text_pipe[0], vb, offset,
            width, height, item.clip_x, item.clip_y, item.clip_w, item.clip_h,
            true, &overlay.linear[0], mask_tex, item.slice.vertex_count) >>>
    }
    << record_draw_pass(pass, &overlay.text_pipe[0], vb, offset,
        width, height, item.clip_x, item.clip_y, item.clip_w, item.clip_h,
        true, &overlay.nearest[0], mask_tex, item.slice.vertex_count) >>>
}

fn (overlay $&Overlay2D) flush_gpu_frame_impl(device &gpu.Device, frame $&gpu.Frame,
    width int, height int, initial_load int, background int,
    ext_masks &[]gpu.Texture, ext_linear bool) int {
    overlay.alive() >>>
    if !overlay.gpu_mode { >> errors.new("nexus canvas: flush_gpu_frame requires GPU overlay") }
    if !overlay.dev_refs[0].same(device.reference()) {
        >> errors.new("nexus canvas: overlay belongs to a different GPU device")
    }
    if width <= 0 || height <= 0 {
        >> errors.new("nexus canvas: invalid overlay target dimensions")
    }
    if initial_load == gpu.LOAD && overlay.cmds.len == 0 {
        overlay.clear() >>>
        << 0
    }
    has_ext_mask := ext_masks.len > 0
    $raw_bytes := [][]u8{}
    $vcounts := []int{}
    $total_bytes := 0
    for i in 0:overlay.cmds.len {
        cmd := overlay.cmds[i]
        idx := cmd.index
        $vb := []u8{}
        $vc := 0
        if cmd.kind == OVERLAY_CMD_BATCH || cmd.kind == OVERLAY_CMD_TEXT {
            vb = vertex_bytes(&overlay.batches[idx]) >>>
            vc = overlay.batches[idx].vertex_count()
        } else {
            vb = sdf_vertex_bytes(&overlay.sdfs[idx])
            vc = vb.len / 40
        }
        if cmd.kind == OVERLAY_CMD_TEXT && vc > 0 {
            if overlay.text_pipe.len == 0 {
                >> errors.new("nexus canvas: overlay text pipeline is not enabled")
            }
            if !has_ext_mask && overlay.text_mask.len == 0 {
                >> errors.new("nexus canvas: overlay text mask is not synced")
            }
        }
        if vb.len > 0 && vc > 0 {
            total_bytes += align_transfer_offset(vb.len)
        }
        raw_bytes.push(vb)
        vcounts.push(vc)
    }
    pool_next_frame($&overlay.pool) >>>
    if total_bytes > 0 {
        pool_ensure_slot_capacity($&overlay.pool, device, total_bytes) >>>
    }
    $prepared := []PreparedOverlayCmd{}
    for i in 0:overlay.cmds.len {
        vc := vcounts[i]
        if vc <= 0 || raw_bytes[i].len == 0 { -> }
        clip := resolve_clip(&overlay.cmds[i], width, height)
        if clip[2] <= 0 || clip[3] <= 0 { -> }
        sl := pool_upload($&overlay.pool, device, &raw_bytes[i], vc) >>>
        prepared.push(PreparedOverlayCmd{kind: overlay.cmds[i].kind, slice: sl,
            clip_x: clip[0], clip_y: clip[1], clip_w: clip[2], clip_h: clip[3]})
    }
    if initial_load != gpu.LOAD || prepared.len > 0 {
        clear_col := color_value(background) >>>
        $pass := frame.begin_render(initial_load, clear_col, gpu.no_depth()) >>>
        for i in 0:prepared.len {
            item := prepared[i]
            sidx := item.slice.slot
            if item.kind == OVERLAY_CMD_BATCH {
                record_draw_pass(&pass, &overlay.drawing[0],
                    &overlay.pool.slots[sidx].buffer[0], item.slice.offset,
                    width, height, item.clip_x, item.clip_y, item.clip_w, item.clip_h,
                    true, &overlay.nearest[0], &overlay.white[0], item.slice.vertex_count) >>>
            } else if item.kind == OVERLAY_CMD_TEXT {
                if has_ext_mask {
                    record_overlay_text_pass(&pass, overlay, &overlay.pool.slots[sidx].buffer[0],
                        item.slice.offset, width, height, &item, &ext_masks[0], ext_linear) >>>
                } else {
                    record_overlay_text_pass(&pass, overlay, &overlay.pool.slots[sidx].buffer[0],
                        item.slice.offset, width, height, &item, &overlay.text_mask[0], overlay.text_mask_linear) >>>
                }
            } else {
                record_draw_pass(&pass, &overlay.sdf_pipe[0],
                    &overlay.pool.slots[sidx].buffer[0], item.slice.offset,
                    width, height, item.clip_x, item.clip_y, item.clip_w, item.clip_h,
                    false, &overlay.nearest[0], &overlay.white[0], item.slice.vertex_count) >>>
            }
        }
        pass.end() >>>
    }
    overlay.clear() >>>
    << 0
}

pub fn (overlay $&Overlay2D) flush_gpu_frame(device &gpu.Device, frame $&gpu.Frame,
    width int, height int, initial_load int, background int) int {
    overlay.alive() >>>
    if !overlay.gpu_mode { >> errors.new("nexus canvas: flush_gpu_frame requires GPU overlay") }
    no_masks := []gpu.Texture{}
    << overlay.flush_gpu_frame_impl(device, frame, width, height, initial_load, background,
        &no_masks, false) >>>
}

pub fn (overlay $&Overlay2D) flush_gpu_frame_with_mask(device &gpu.Device, frame $&gpu.Frame,
    width int, height int, initial_load int, background int, mask &MaskTexture2D) int {
    overlay.alive() >>>
    if !overlay.gpu_mode { >> errors.new("nexus canvas: flush_gpu_frame_with_mask requires GPU overlay") }
    if mask.closed || !mask.has_gpu || mask.dev_refs.len == 0 ||
        !mask.dev_refs[0].same(device.reference()) || mask.images.len == 0 {
        >> errors.new("nexus canvas: invalid GPU mask texture for overlay")
    }
    << overlay.flush_gpu_frame_impl(device, frame, width, height, initial_load, background,
        &mask.images, mask.linear) >>>
}

fn (overlay $&Overlay2D) flush_software_impl(pixels $&[]u8, width int, height int,
    clear_first bool, background int, has_ext_mask bool, ext_bytes &[]u8,
    ext_w int, ext_h int, ext_linear bool) int {
    overlay.alive() >>>
    if width <= 0 || height <= 0 {
        >> errors.new("nexus canvas: invalid software overlay dimensions")
    }
    if pixels.len != width * height * 4 {
        >> errors.new("nexus canvas: software buffer length mismatch")
    }
    if clear_first {
        clear_rgba_buffer(pixels, width, height, background) >>>
    }
    empty_tex := []u8{}
    for i in 0:overlay.cmds.len {
        cmd := overlay.cmds[i]
        idx := cmd.index
        clip := resolve_clip(&cmd, width, height)
        if clip[2] <= 0 || clip[3] <= 0 { -> }
        if cmd.kind == OVERLAY_CMD_BATCH {
            soft_draw_batch(pixels, width, height, clip[0], clip[1], clip[2], clip[3],
                &empty_tex, 0, 0, false, &overlay.batches[idx])
        } else if cmd.kind == OVERLAY_CMD_TEXT {
            if has_ext_mask {
                if ext_w <= 0 || ext_h <= 0 || ext_bytes.len != ext_w * ext_h {
                    >> errors.new("nexus canvas: invalid software overlay text mask")
                }
                soft_draw_mask_batch(pixels, width, height, clip[0], clip[1], clip[2], clip[3],
                    ext_bytes, ext_w, ext_h, ext_linear, &overlay.batches[idx])
            } else {
                if overlay.text_mask_w <= 0 || overlay.text_mask_h <= 0 ||
                    overlay.text_soft.len != overlay.text_mask_w * overlay.text_mask_h {
                    >> errors.new("nexus canvas: overlay text mask is not synced")
                }
                soft_draw_mask_batch(pixels, width, height, clip[0], clip[1], clip[2], clip[3],
                    &overlay.text_soft, overlay.text_mask_w, overlay.text_mask_h,
                    overlay.text_mask_linear, &overlay.batches[idx])
            }
        } else {
            soft_draw_sdf_batch(pixels, width, height, clip[0], clip[1], clip[2], clip[3],
                &overlay.sdfs[idx])
        }
    }
    overlay.clear() >>>
    << 0
}

pub fn (overlay $&Overlay2D) flush_software(pixels $&[]u8, width int, height int,
    clear_first bool, background int) int {
    empty_tex := []u8{}
    << overlay.flush_software_impl(pixels, width, height, clear_first, background,
        false, &empty_tex, 0, 0, false) >>>
}

pub fn (overlay $&Overlay2D) flush_software_with_mask(pixels $&[]u8, width int, height int,
    clear_first bool, background int, mask &MaskTexture2D) int {
    overlay.alive() >>>
    if mask.closed || mask.has_gpu {
        >> errors.new("nexus canvas: invalid software mask texture for overlay")
    }
    << overlay.flush_software_impl(pixels, width, height, clear_first, background,
        true, &mask.soft_pixels, mask.width, mask.height, mask.linear) >>>
}

pub fn (overlay $&Overlay2D) draw_gpu_frame(device &gpu.Device, frame $&gpu.Frame,
    width int, height int, initial_load int, background int,
    sdf &canvas.SdfBatch, batch &canvas.Batch2D) int {
    overlay.clear() >>>
    overlay.submit_sdf(sdf) >>>
    overlay.submit(batch) >>>
    << overlay.flush_gpu_frame(device, frame, width, height, initial_load, background) >>>
}

pub fn (overlay $&Overlay2D) draw_software(pixels $&[]u8, width int, height int,
    clear_first bool, background int, sdf &canvas.SdfBatch, batch &canvas.Batch2D) int {
    overlay.clear() >>>
    overlay.submit_sdf(sdf) >>>
    overlay.submit(batch) >>>
    << overlay.flush_software(pixels, width, height, clear_first, background) >>>
}

pub fn (overlay $&Overlay2D) close() int {
    if overlay.closed { << 0 }
    $err_msg := close_pool_err($&overlay.pool)
    for i in 0:overlay.drawing.len { err_msg = first_err(err_msg, close_pipeline_err($&overlay.drawing[i])) }
    for i in 0:overlay.sdf_pipe.len { err_msg = first_err(err_msg, close_pipeline_err($&overlay.sdf_pipe[i])) }
    for i in 0:overlay.text_pipe.len { err_msg = first_err(err_msg, close_pipeline_err($&overlay.text_pipe[i])) }
    for i in 0:overlay.nearest.len { err_msg = first_err(err_msg, close_sampler_err($&overlay.nearest[i])) }
    for i in 0:overlay.linear.len { err_msg = first_err(err_msg, close_sampler_err($&overlay.linear[i])) }
    for i in 0:overlay.white.len { err_msg = first_err(err_msg, close_texture_err($&overlay.white[i])) }
    for i in 0:overlay.text_mask.len { err_msg = first_err(err_msg, close_texture_err($&overlay.text_mask[i])) }
    overlay.drawing = []gpu.GraphicsPipeline{}
    overlay.sdf_pipe = []gpu.GraphicsPipeline{}
    overlay.text_pipe = []gpu.GraphicsPipeline{}
    overlay.nearest = []gpu.Sampler{}
    overlay.linear = []gpu.Sampler{}
    overlay.white = []gpu.Texture{}
    overlay.text_mask = []gpu.Texture{}
    overlay.text_soft = []u8{}
    overlay.text_mask_w = 0
    overlay.text_mask_h = 0
    overlay.text_mask_rev = 0
    overlay.text_enabled = false
    overlay.dev_refs = []gpu.DeviceRef{}
    overlay.cmds = []OverlayCmd{}
    overlay.batches = []canvas.Batch2D{}
    overlay.sdfs = []canvas.SdfBatch{}
    overlay.closed = true
    if err_msg.len > 0 { >> errors.new(err_msg) }
    << 0
}

fn (overlay $&Overlay2D) drop() {
    overlay.close() >>> (err) { << }
}
