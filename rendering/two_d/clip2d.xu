@"github.com/xulang-org/nexus/rendering/two_d"

fm #"github.com/xulang-org/nexus/foundation/math"
#errors
#math

// Coordinates are output pixels. Fractional edges expand to whole pixels;
// intersection permits empty/offscreen clips without an invalid GPU scissor.
pub fn (renderer $&Renderer2D) clip_rect(bounds fm.Rect2) int {
    renderer.recording() or >>
    if !bounds.valid() || bounds.position.x < 0.0 || bounds.position.y < 0.0 ||
        bounds.position.x+bounds.size.x > 16384.0 || bounds.position.y+bounds.size.y > 16384.0 {
        >> errors.new("nexus canvas: invalid clip rectangle")
    }
    x := int(math.floor(bounds.position.x))
    y := int(math.floor(bounds.position.y))
    $right := int(math.ceil(bounds.position.x+bounds.size.x))
    $bottom := int(math.ceil(bounds.position.y+bounds.size.y))
    if right > renderer.target_width { right = renderer.target_width }
    if bottom > renderer.target_height { bottom = renderer.target_height }
    renderer.clip_x = x
    renderer.clip_y = y
    renderer.clip_width = 0
    renderer.clip_height = 0
    if right > x && bottom > y {
        renderer.clip_width = right-x
        renderer.clip_height = bottom-y
    }
    << 0
}
pub fn (renderer $&Renderer2D) reset_clip() int {
    renderer.recording() or >>
    renderer.clip_x = 0
    renderer.clip_y = 0
    renderer.clip_width = renderer.target_width
    renderer.clip_height = renderer.target_height
    << 0
}
