@"github.com/xulang-org/nexus/rendering/two_d"

#errors
#strings
#image/png

fn (renderer $&Renderer2D) snapshot() int {
    renderer.recording() >>>
    if renderer.cached { << 0 }
    if !renderer.session.is_gpu() {
        renderer.cached = true
        << 0
    }
    dev := renderer.session.gpu_device() >>>
    tidx := renderer.active_target
    $read := dev.download_texture(&renderer.targets[tidx],0) >>>
    read.wait() >>>
    $pixels := []u8{}
    for i in 0:read.size_bytes() { pixels.push(u8(0)) }
    read.read($&pixels) >>>
    read.close() >>>
    renderer.pixels = pixels
    renderer.cached = true
    << 0
}
// One full target read per drawing revision; subsequent reads reuse CPU bytes.
// A later submit invalidates the cache and remains legal within this frame.
pub fn (renderer $&Renderer2D) read_pixel(x int, y int) int {
    renderer.recording() >>>
    if !renderer.session.is_gpu() {
        << renderer.session.read_software_pixel(x, y) >>>
    }
    if x < 0 || y < 0 || x >= renderer.target_width || y >= renderer.target_height {
        >> errors.new("nexus canvas: read pixel outside output")
    }
    renderer.snapshot() >>>
    offset := (y*renderer.target_width+x)*4
    << (int(renderer.pixels[offset]) << 24) | (int(renderer.pixels[offset+1]) << 16) |
        (int(renderer.pixels[offset+2]) << 8) | int(renderer.pixels[offset+3])
}
// Explicit diagnostics; PNG encoding is the Xu standard codec, with no SDL GPU
// or image-codec bridge. Pixel allocation is bounded by the output policy.
pub fn (renderer $&Renderer2D) capture(path string) int {
    renderer.recording() >>>
    if !renderer.session.is_gpu() {
        << renderer.session.capture_software_png(path) >>>
    }
    renderer.snapshot() >>>
    $bytes := strings.new_byte_builder(renderer.pixels.len)
    for value in renderer.pixels { bytes.write_byte(int(value)) }
    raw := bytes.to_string()
    encoded := png.encode_rgba_bytes(&raw,renderer.target_width,renderer.target_height) >>>
    write_file(path,encoded) >>>
    << 0
}
