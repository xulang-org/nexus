@"github.com/xulang-org/nexus/rendering/two_d"

#gpu
#encoding/binary
canvas #"github.com/xulang-org/nexus/resources/canvas"

fn vertex_bytes(batch &canvas.Batch2D) []u8 {
    count := batch.vertex_count()
    $bytes := []u8{}
    for i in 0:count*20 { bytes.push(u8(0)) }
    order := binary.little_endian()
    for i in 0:count {
        vertex := batch.vertex_at(i) >>>
        offset := i*20
        order.put_f32($&bytes,offset,vertex.point.x) >>>
        order.put_f32($&bytes,offset+4,vertex.point.y) >>>
        bytes[offset+8] = u8((vertex.color >> 24) & 255)
        bytes[offset+9] = u8((vertex.color >> 16) & 255)
        bytes[offset+10] = u8((vertex.color >> 8) & 255)
        bytes[offset+11] = u8(vertex.color & 255)
        order.put_f32($&bytes,offset+12,vertex.uv.x) >>>
        order.put_f32($&bytes,offset+16,vertex.uv.y) >>>
    }
    << bytes
}
fn viewport_uniform(width int, height int) []u8 {
    $bytes := []u8{}
    for i in 0:16 { bytes.push(u8(0)) }
    order := binary.little_endian()
    order.put_f32($&bytes,0,f64(width)) >>>
    order.put_f32($&bytes,4,f64(height)) >>>
    << bytes
}
fn draw_batch(device &gpu.Device, target &gpu.Texture, pipeline &gpu.GraphicsPipeline,
    sampler &gpu.Sampler, texture &gpu.Texture, batch &canvas.Batch2D,
    width int, height int, x int, y int, clip_width int, clip_height int) int {
    data := vertex_bytes(batch) >>>
    $buffer := device.buffer(data.len,gpu.BUFFER_VERTEX) >>>
    $upload := device.upload(&buffer,0,&data) >>>
    upload.close() >>>
    $encoder := device.command_encoder() >>>
    attachment := gpu.ColorAttachment{view: target.view(0) >>>,load: gpu.LOAD,store: gpu.STORE,
        clear: gpu.Color{r: 0.0,g: 0.0,b: 0.0,a: 0.0}}
    $pass := encoder.begin_render(attachment,gpu.no_depth()) >>>
    pass.pipeline(pipeline) >>>
    pass.vertex_buffer(0,&buffer,0) >>>
    pass.sampler(gpu.FRAGMENT,0,texture,sampler) >>>
    uniform := viewport_uniform(width,height) >>>
    pass.uniform(gpu.VERTEX,0,&uniform) >>>
    pass.scissor(x,y,clip_width,clip_height) >>>
    pass.draw(batch.vertex_count(),0,1,0) >>>
    pass.end() >>>
    $fence := encoder.submit() >>>
    fence.close() >>>
    buffer.close() >>>
    << 0
}
