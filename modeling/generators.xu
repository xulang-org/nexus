@"github.com/xulang-org/nexus/modeling"

fm #"github.com/xulang-org/nexus/foundation/math"
meshes #"github.com/xulang-org/nexus/resources/mesh"
rm #"github.com/xulang-org/nexus/resources/modeling"
#errors
#math

fn check_dim(size fm.Vec3, label string) int {
    if !size.is_finite() || size.x <= 0.0001 || size.y <= 0.0001 || size.z <= 0.0001 ||
        size.x > 100000.0 || size.y > 100000.0 || size.z > 100000.0 {
        >> errors.new("nexus modeling: invalid dimensions for " + label)
    }
    << 0
}

fn append_quad(
    m $&rm.EditableMesh,
    v0 int, v1 int, v2 int, v3 int,
    n fm.Vec3,
    mat_slot int
) int {
    uvs := [fm.vec2(0.0, 1.0), fm.vec2(1.0, 1.0), fm.vec2(1.0, 0.0), fm.vec2(0.0, 0.0)]
    << m.add_polygon([v0, v1, v2, v3], uvs, true, n, true, mat_slot, 0) >>>
}

fn append_tri(
    m $&rm.EditableMesh,
    v0 int, v1 int, v2 int,
    n fm.Vec3,
    mat_slot int
) int {
    uvs := [fm.vec2(0.0, 1.0), fm.vec2(1.0, 1.0), fm.vec2(0.5, 0.0)]
    << m.add_polygon([v0, v1, v2], uvs, true, n, true, mat_slot, 0) >>>
}

// Centered watertight 8-vertex / 6-quad editable box with per-face sharp normals.
pub fn box_editable(size fm.Vec3, color int, mat_slot int) rm.EditableMesh {
    check_dim(size, "box") >>>
    hx := size.x * 0.5
    hy := size.y * 0.5
    hz := size.z * 0.5
    $m := rm.new_editable_mesh("Box")
    // 0..3 bottom (-Y), 4..7 top (+Y)
    v0 := m.add_vertex(fm.vec3(-hx, -hy, hz), color) >>>
    v1 := m.add_vertex(fm.vec3(hx, -hy, hz), color) >>>
    v2 := m.add_vertex(fm.vec3(hx, -hy, -hz), color) >>>
    v3 := m.add_vertex(fm.vec3(-hx, -hy, -hz), color) >>>
    v4 := m.add_vertex(fm.vec3(-hx, hy, hz), color) >>>
    v5 := m.add_vertex(fm.vec3(hx, hy, hz), color) >>>
    v6 := m.add_vertex(fm.vec3(hx, hy, -hz), color) >>>
    v7 := m.add_vertex(fm.vec3(-hx, hy, -hz), color) >>>

    append_quad($&m, v0, v1, v5, v4, fm.vec3(0.0, 0.0, 1.0), mat_slot) >>>   // +Z front
    append_quad($&m, v2, v3, v7, v6, fm.vec3(0.0, 0.0, -1.0), mat_slot) >>>  // -Z back
    append_quad($&m, v1, v2, v6, v5, fm.vec3(1.0, 0.0, 0.0), mat_slot) >>>   // +X right
    append_quad($&m, v3, v0, v4, v7, fm.vec3(-1.0, 0.0, 0.0), mat_slot) >>>  // -X left
    append_quad($&m, v4, v5, v6, v7, fm.vec3(0.0, 1.0, 0.0), mat_slot) >>>   // +Y top
    append_quad($&m, v3, v2, v1, v0, fm.vec3(0.0, -1.0, 0.0), mat_slot) >>>  // -Y bottom
    project_uv_box_all($&m, 1.0) >>>
    << m
}

// Centered watertight 6-vertex ramp/wedge rising toward -Z.
pub fn wedge_editable(size fm.Vec3, color int, mat_slot int) rm.EditableMesh {
    check_dim(size, "wedge") >>>
    hx := size.x * 0.5
    hy := size.y * 0.5
    hz := size.z * 0.5
    $m := rm.new_editable_mesh("Wedge")
    v0 := m.add_vertex(fm.vec3(-hx, -hy, hz), color) >>>
    v1 := m.add_vertex(fm.vec3(hx, -hy, hz), color) >>>
    v2 := m.add_vertex(fm.vec3(hx, -hy, -hz), color) >>>
    v3 := m.add_vertex(fm.vec3(-hx, -hy, -hz), color) >>>
    v4 := m.add_vertex(fm.vec3(hx, hy, -hz), color) >>>
    v5 := m.add_vertex(fm.vec3(-hx, hy, -hz), color) >>>

    slope_n := fm.vec3(0.0, size.z, size.y).normalized() >>>
    append_quad($&m, v3, v2, v1, v0, fm.vec3(0.0, -1.0, 0.0), mat_slot) >>> // bottom
    append_quad($&m, v2, v3, v5, v4, fm.vec3(0.0, 0.0, -1.0), mat_slot) >>> // back (-Z)
    append_quad($&m, v0, v1, v4, v5, slope_n, mat_slot) >>>                 // sloped ramp
    append_tri($&m, v1, v2, v4, fm.vec3(1.0, 0.0, 0.0), mat_slot) >>>       // +X side
    append_tri($&m, v3, v0, v5, fm.vec3(-1.0, 0.0, 0.0), mat_slot) >>>      // -X side
    project_uv_box_all($&m, 1.0) >>>
    << m
}

// Centered watertight stepped staircase ascending toward -Z.
pub fn stair_editable(size fm.Vec3, steps int, color int, mat_slot int) rm.EditableMesh {
    check_dim(size, "stair") >>>
    if steps < 1 || steps > 64 {
        >> errors.new("nexus modeling: stair step count must be in 1..64")
    }
    hx := size.x * 0.5
    hy := size.y * 0.5
    hz := size.z * 0.5
    dz := size.z / f64(steps)
    dy := size.y / f64(steps)
    $m := rm.new_editable_mesh("Stair")

    // Build front-to-back profile points on -X and +X sides.
    // Profile goes: (+hz, -hy), then for each step i: riser up then tread back, ending at (-hz, -hy).
    $left_pts := []int{}
    $right_pts := []int{}
    b_fl := m.add_vertex(fm.vec3(-hx, -hy, hz), color) >>>
    b_fr := m.add_vertex(fm.vec3(hx, -hy, hz), color) >>>
    left_pts.push(b_fl)
    right_pts.push(b_fr)

    for i in 0:steps {
        z_front := hz - f64(i) * dz
        z_back := hz - f64(i + 1) * dz
        y_top := -hy + f64(i + 1) * dy
        l0 := m.add_vertex(fm.vec3(-hx, y_top, z_front), color) >>>
        r0 := m.add_vertex(fm.vec3(hx, y_top, z_front), color) >>>
        l1 := m.add_vertex(fm.vec3(-hx, y_top, z_back), color) >>>
        r1 := m.add_vertex(fm.vec3(hx, y_top, z_back), color) >>>
        left_pts.push(l0)
        left_pts.push(l1)
        right_pts.push(r0)
        right_pts.push(r1)
    }
    b_bl := m.add_vertex(fm.vec3(-hx, -hy, -hz), color) >>>
    b_br := m.add_vertex(fm.vec3(hx, -hy, -hz), color) >>>
    left_pts.push(b_bl)
    right_pts.push(b_br)

    // Risers and treads
    for i in 0:steps {
        base_idx := i * 2
        // Riser (+Z)
        append_quad($&m, left_pts[base_idx], right_pts[base_idx], right_pts[base_idx + 1], left_pts[base_idx + 1],
            fm.vec3(0.0, 0.0, 1.0), mat_slot) >>>
        // Tread (+Y)
        append_quad($&m, left_pts[base_idx + 1], right_pts[base_idx + 1], right_pts[base_idx + 2], left_pts[base_idx + 2],
            fm.vec3(0.0, 1.0, 0.0), mat_slot) >>>
    }
    // Back (-Z) and bottom (-Y)
    last := steps * 2 + 1
    append_quad($&m, right_pts[last], left_pts[last], left_pts[last - 1], right_pts[last - 1],
        fm.vec3(0.0, 0.0, -1.0), mat_slot) >>>
    append_quad($&m, left_pts[last], right_pts[last], right_pts[0], left_pts[0],
        fm.vec3(0.0, -1.0, 0.0), mat_slot) >>>

    // Side N-gons (or decomposed step rects, using simple step column decomposition for convex quads)
    for i in 0:steps {
        z0 := hz - f64(i) * dz
        z1 := hz - f64(i + 1) * dz
        y0 := -hy
        y1 := -hy + f64(i + 1) * dy
        // Right (+X)
        r_bl := m.add_vertex(fm.vec3(hx, y0, z0), color) >>>
        r_br := m.add_vertex(fm.vec3(hx, y0, z1), color) >>>
        r_tr := m.add_vertex(fm.vec3(hx, y1, z1), color) >>>
        r_tl := m.add_vertex(fm.vec3(hx, y1, z0), color) >>>
        append_quad($&m, r_bl, r_br, r_tr, r_tl, fm.vec3(1.0, 0.0, 0.0), mat_slot) >>>
        // Left (-X)
        l_bl := m.add_vertex(fm.vec3(-hx, y0, z1), color) >>>
        l_br := m.add_vertex(fm.vec3(-hx, y0, z0), color) >>>
        l_tr := m.add_vertex(fm.vec3(-hx, y1, z0), color) >>>
        l_tl := m.add_vertex(fm.vec3(-hx, y1, z1), color) >>>
        append_quad($&m, l_bl, l_br, l_tr, l_tl, fm.vec3(-1.0, 0.0, 0.0), mat_slot) >>>
    }
    project_uv_box_all($&m, 1.0) >>>
    << m
}

pub fn cylinder_editable(
    radius_top f64,
    radius_bottom f64,
    height f64,
    segments int,
    color int,
    mat_slot int
) rm.EditableMesh {
    if !fm.finite(radius_top) || radius_top < 0.0 || !fm.finite(radius_bottom) || radius_bottom < 0.0 ||
        (radius_top <= 0.0001 && radius_bottom <= 0.0001) || !fm.finite(height) || height <= 0.0001 ||
        segments < 3 || segments > 64 {
        >> errors.new("nexus modeling: invalid cylinder parameters")
    }
    $m := rm.new_editable_mesh("Cylinder")
    hy := height * 0.5
    $top_ring := []int{}
    $bot_ring := []int{}
    for i in 0:segments {
        theta := f64(i) / f64(segments) * 2.0 * math.pi()
        cs := math.cos(theta)
        sn := math.sin(theta)
        if radius_bottom > 0.0001 {
            bot_ring.push(m.add_vertex(fm.vec3(radius_bottom * cs, -hy, radius_bottom * sn), color) >>>)
        }
        if radius_top > 0.0001 {
            top_ring.push(m.add_vertex(fm.vec3(radius_top * cs, hy, radius_top * sn), color) >>>)
        }
    }
    if radius_top > 0.0001 && radius_bottom > 0.0001 {
        for i in 0:segments {
            $ni := i + 1
            if ni >= segments { ni = 0 }
            a := bot_ring[i]
            b := top_ring[i]
            c := top_ring[ni]
            d := bot_ring[ni]
            pa := m.vertices[a].position
            pb := m.vertices[b].position
            pd := m.vertices[d].position
            n := pb.sub(pa).cross(pd.sub(pa)).normalized_or_zero()
            m.add_polygon([a, b, c, d], [fm.vec2(0.0, 1.0), fm.vec2(0.0, 0.0), fm.vec2(1.0, 0.0), fm.vec2(1.0, 1.0)],
                true, n, false, mat_slot, 1) >>>
        }
        // Top cap (+Y): reverse order for +Y normal
        $top_rev := []int{}
        $top_uvs := []fm.Vec2{}
        for i in 0:segments {
            idx := segments - 1 - i
            top_rev.push(top_ring[idx])
            theta := f64(idx) / f64(segments) * 2.0 * math.pi()
            top_uvs.push(fm.vec2(0.5 + 0.5 * math.cos(theta), 0.5 - 0.5 * math.sin(theta)))
        }
        m.add_polygon(top_rev, top_uvs, true, fm.vec3(0.0, 1.0, 0.0), true, mat_slot, 0) >>>
        // Bottom cap (-Y)
        $bot_uvs := []fm.Vec2{}
        for i in 0:segments {
            theta := f64(i) / f64(segments) * 2.0 * math.pi()
            bot_uvs.push(fm.vec2(0.5 + 0.5 * math.cos(theta), 0.5 + 0.5 * math.sin(theta)))
        }
        m.add_polygon(~bot_ring, bot_uvs, true, fm.vec3(0.0, -1.0, 0.0), true, mat_slot, 0) >>>
    } else if radius_bottom > 0.0001 {
        apex := m.add_vertex(fm.vec3(0.0, hy, 0.0), color) >>>
        for i in 0:segments {
            $ni := i + 1
            if ni >= segments { ni = 0 }
            append_tri($&m, bot_ring[i], apex, bot_ring[ni], fm.vec3(0.0, 1.0, 0.0), mat_slot) >>>
        }
        $bot_uvs := []fm.Vec2{}
        for i in 0:segments {
            theta := f64(i) / f64(segments) * 2.0 * math.pi()
            bot_uvs.push(fm.vec2(0.5 + 0.5 * math.cos(theta), 0.5 + 0.5 * math.sin(theta)))
        }
        m.add_polygon(~bot_ring, bot_uvs, true, fm.vec3(0.0, -1.0, 0.0), true, mat_slot, 0) >>>
    } else {
        apex := m.add_vertex(fm.vec3(0.0, -hy, 0.0), color) >>>
        for i in 0:segments {
            $ni := i + 1
            if ni >= segments { ni = 0 }
            append_tri($&m, top_ring[ni], apex, top_ring[i], fm.vec3(0.0, -1.0, 0.0), mat_slot) >>>
        }
        $top_rev := []int{}
        $top_uvs := []fm.Vec2{}
        for i in 0:segments {
            idx := segments - 1 - i
            top_rev.push(top_ring[idx])
            theta := f64(idx) / f64(segments) * 2.0 * math.pi()
            top_uvs.push(fm.vec2(0.5 + 0.5 * math.cos(theta), 0.5 - 0.5 * math.sin(theta)))
        }
        m.add_polygon(top_rev, top_uvs, true, fm.vec3(0.0, 1.0, 0.0), true, mat_slot, 0) >>>
    }
    compute_normals($&m) >>>
    << m
}

// Vaulted rectangular doorway/arch along Z axis.
pub fn arch_editable(size fm.Vec3, thickness f64, segments int, color int, mat_slot int) rm.EditableMesh {
    check_dim(size, "arch") >>>
    if !fm.finite(thickness) || thickness <= 0.0001 || thickness >= size.x * 0.49 ||
        segments < 3 || segments > 64 {
        >> errors.new("nexus modeling: invalid arch thickness or segments")
    }
    hx := size.x * 0.5
    hy := size.y * 0.5
    hz := size.z * 0.5
    inner_r := hx - thickness
    // Keep inner radius bounded vertically
    $r_y := inner_r
    if r_y > size.y - thickness { r_y = size.y - thickness }
    $base_y := hy - thickness - r_y
    if base_y < -hy { base_y = -hy }

    $m := rm.new_editable_mesh("Arch")
    // Left pillar + right pillar below springline
    if base_y > -hy + 0.0001 {
        // Left pillar (-hx..-inner_r, -hy..base_y)
        lh := base_y - (-hy)
        lbox := box_editable(fm.vec3(thickness, lh, size.z), color, mat_slot) >>>
        append_offset_mesh($&m, &lbox, fm.vec3(-hx + thickness * 0.5, -hy + lh * 0.5, 0.0)) >>>
        rbox := box_editable(fm.vec3(thickness, lh, size.z), color, mat_slot) >>>
        append_offset_mesh($&m, &rbox, fm.vec3(hx - thickness * 0.5, -hy + lh * 0.5, 0.0)) >>>
    }
    // Radial segments spanning theta = 0 (right +X) to pi (left -X)
    for i in 0:segments {
        t0 := f64(i) / f64(segments) * math.pi()
        t1 := f64(i + 1) / f64(segments) * math.pi()
        in0 := fm.vec3(inner_r * math.cos(t0), base_y + r_y * math.sin(t0), 0.0)
        in1 := fm.vec3(inner_r * math.cos(t1), base_y + r_y * math.sin(t1), 0.0)
        out0 := outer_arch_point(hx, base_y, hy, t0)
        out1 := outer_arch_point(hx, base_y, hy, t1)

        f_in0 := m.add_vertex(fm.vec3(in0.x, in0.y, hz), color) >>>
        f_in1 := m.add_vertex(fm.vec3(in1.x, in1.y, hz), color) >>>
        f_out1 := m.add_vertex(fm.vec3(out1.x, out1.y, hz), color) >>>
        f_out0 := m.add_vertex(fm.vec3(out0.x, out0.y, hz), color) >>>

        b_in0 := m.add_vertex(fm.vec3(in0.x, in0.y, -hz), color) >>>
        b_in1 := m.add_vertex(fm.vec3(in1.x, in1.y, -hz), color) >>>
        b_out1 := m.add_vertex(fm.vec3(out1.x, out1.y, -hz), color) >>>
        b_out0 := m.add_vertex(fm.vec3(out0.x, out0.y, -hz), color) >>>

        append_quad($&m, f_in0, f_out0, f_out1, f_in1, fm.vec3(0.0, 0.0, 1.0), mat_slot) >>>
        append_quad($&m, b_in1, b_out1, b_out0, b_in0, fm.vec3(0.0, 0.0, -1.0), mat_slot) >>>
        append_quad($&m, f_in0, f_in1, b_in1, b_in0, fm.vec3(0.0, -1.0, 0.0), mat_slot) >>>
        append_quad($&m, f_out1, f_out0, b_out0, b_out1, fm.vec3(0.0, 1.0, 0.0), mat_slot) >>>
    }
    compute_normals($&m) >>>
    project_uv_box_all($&m, 1.0) >>>
    << m
}

fn outer_arch_point(hx f64, base_y f64, hy f64, theta f64) fm.Vec3 {
    cs := math.cos(theta)
    sn := math.sin(theta)
    top_h := hy - base_y
    $tx := 1e30
    if math.abs(cs) > 1e-9 { tx = hx / math.abs(cs) }
    $ty := 1e30
    if sn > 1e-9 { ty = top_h / sn }
    t := math.min(tx, ty)
    << fm.vec3(cs * t, base_y + sn * t, 0.0)
}

fn append_offset_mesh(dst $&rm.EditableMesh, src &rm.EditableMesh, offset fm.Vec3) int {
    $vmap := []int{}
    for v in src.vertices {
        vmap.push(dst.add_vertex(v.position.add(offset), v.color) >>>)
    }
    for f in src.faces {
        $verts := []int{}
        $uvs := []fm.Vec2{}
        $has_uv := true
        $has_n := true
        $n := fm.vec3(0.0, 1.0, 0.0)
        for cid in f.corners {
            c := &src.corners[cid]
            verts.push(vmap[c.vertex])
            uvs.push(c.uv)
            if !c.has_uv { has_uv = false }
            if !c.has_normal { has_n = false } else { n = c.normal }
        }
        dst.add_polygon(verts, uvs, has_uv, n, has_n, f.material_slot, f.smoothing_group) >>>
    }
    << 0
}

pub fn sphere_editable(radius f64, segments int, rings int, color int, mat_slot int) rm.EditableMesh {
    raw := meshes.sphere_mesh_3d(radius, segments, rings, color) >>>
    $m := from_mesh_data("Sphere", &raw, 1e-5) >>>
    for i in 0:m.faces.len {
        m.faces[i].material_slot = mat_slot
        m.faces[i].smoothing_group = 1
    }
    compute_normals($&m) >>>
    << m
}

pub fn generate_brush_mesh(brush &rm.CsgBrush) rm.EditableMesh {
    brush.validate() >>>
    $m := rm.new_editable_mesh(brush.name + "")
    if brush.shape == rm.CSG_SHAPE_BOX {
        m = box_editable(brush.size, brush.color, brush.material_slot) >>>
    } else if brush.shape == rm.CSG_SHAPE_WEDGE {
        m = wedge_editable(brush.size, brush.color, brush.material_slot) >>>
    } else if brush.shape == rm.CSG_SHAPE_STAIR {
        m = stair_editable(brush.size, brush.step_count, brush.color, brush.material_slot) >>>
    } else if brush.shape == rm.CSG_SHAPE_CYLINDER {
        r := math.min(brush.size.x, brush.size.z) * 0.5
        m = cylinder_editable(r, r, brush.size.y, brush.segments, brush.color, brush.material_slot) >>>
    } else if brush.shape == rm.CSG_SHAPE_ARCH {
        m = arch_editable(brush.size, brush.arch_thickness, brush.segments, brush.color, brush.material_slot) >>>
    } else {
        r := math.min(brush.size.x, math.min(brush.size.y, brush.size.z)) * 0.5
        $rings := brush.segments / 2
        if rings < 4 { rings = 4 }
        m = sphere_editable(r, brush.segments, rings, brush.color, brush.material_slot) >>>
    }
    // Apply brush transform and check negative determinant / flip_normals
    det := brush.transform.c0.xyz().dot(brush.transform.c1.xyz().cross(brush.transform.c2.xyz()))
    invert := (det < 0.0) != brush.flip_normals
    for i in 0:m.vertices.len {
        m.vertices[i].position = brush.transform.transform_point(m.vertices[i].position)
    }
    if invert {
        for fi in 0:m.faces.len {
            $rev := []int{}
            cids := &m.faces[fi].corners
            for k in 0:cids.len {
                rev.push(cids[cids.len - 1 - k])
            }
            m.faces[fi].corners = rev
        }
    }
    for ci in 0:m.corners.len {
        m.corners[ci].has_normal = false
        m.corners[ci].normal = fm.vec3(0.0, 0.0, 0.0)
    }
    compute_normals($&m) >>>
    project_uv_box_all($&m, 1.0) >>>
    << m
}

// Imports a triangle MeshData3D into an EditableMesh by welding coincident
// vertex positions within weld_eps while keeping per-corner UV/normal seams.
pub fn from_mesh_data(name string, src &meshes.MeshData3D, weld_eps f64) rm.EditableMesh {
    src.validate() >>>
    eps := math.max(1e-7, weld_eps)
    inv_eps := 1.0 / eps
    $m := rm.new_editable_mesh(name)
    $buckets := map[string][]int{}
    $src_to_v := []int{}
    for v in src.vertices {
        qx := int(math.round_to_even(v.position.x * inv_eps))
        qy := int(math.round_to_even(v.position.y * inv_eps))
        qz := int(math.round_to_even(v.position.z * inv_eps))
        key := str(qx) + ":" + str(qy) + ":" + str(qz)
        $found := -1
        for dx in -1:2 {
            if found >= 0 { <- }
            for dy in -1:2 {
                if found >= 0 { <- }
                for dz in -1:2 {
                    nkey := str(qx + dx) + ":" + str(qy + dy) + ":" + str(qz + dz)
                    if buckets.has(nkey) {
                        for cand in buckets[nkey] {
                            if m.vertices[cand].position.distance_sq(v.position) <= eps * eps {
                                found = cand
                                <-
                            }
                        }
                        if found >= 0 { <- }
                    }
                }
            }
        }
        if found < 0 {
            found = m.add_vertex(v.position, v.color) >>>
            if buckets.has(key) {
                buckets[key].push(found)
            } else {
                buckets[key] = [found]
            }
        }
        src_to_v.push(found)
    }
    for ti in 0:src.triangle_count() {
        i0 := src.indices[ti * 3]
        i1 := src.indices[ti * 3 + 1]
        i2 := src.indices[ti * 3 + 2]
        v0 := src_to_v[i0]
        v1 := src_to_v[i1]
        v2 := src_to_v[i2]
        if v0 == v1 || v1 == v2 || v2 == v0 { -> }
        $cids := []int{}
        for idx in [i0, i1, i2] {
            sv := &src.vertices[idx]
            has_n := sv.normal.dot(sv.normal) > 0.5
            $n := fm.vec3(0.0, 0.0, 0.0)
            if has_n { n = sv.normal }
            cids.push(m.add_corner(src_to_v[idx], sv.uv, sv.has_uv, n, has_n) >>>)
        }
        m.add_face(cids, 0, 0) >>>
    }
    << m
}
