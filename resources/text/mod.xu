@"github.com/xulang-org/nexus/resources/text"

canvas #"github.com/xulang-org/nexus/resources/canvas"
fm #"github.com/xulang-org/nexus/foundation/math"
font #ui/font
#errors
#math

fn clamped_uv(entry &font.AtlasEntry) fm.Rect2 {
    $u0 := entry.u0
    $v0 := entry.v0
    if u0 < 0.0 { u0 = 0.0 }
    if v0 < 0.0 { v0 = 0.0 }
    if u0 > 1.0 { u0 = 1.0 }
    if v0 > 1.0 { v0 = 1.0 }
    $uw := entry.u1 - u0
    $vh := entry.v1 - v0
    if uw < 0.0 { uw = 0.0 }
    if vh < 0.0 { vh = 0.0 }
    max_uw := 1.0 - u0
    max_vh := 1.0 - v0
    if uw > max_uw { uw = max_uw }
    if vh > max_vh { vh = max_vh }
    if u0 + uw > 1.0 { uw = max_uw * 0.999999999999999 }
    if v0 + vh > 1.0 { vh = max_vh * 0.999999999999999 }
    << fm.rect2(u0, v0, uw, vh)
}

fn validate_quad_args(transform fm.Transform2D, origin fm.Vec2, color int) int {
    if !transform.is_finite() || math.is_nan(origin.x) || math.is_inf(origin.x) ||
        math.is_nan(origin.y) || math.is_inf(origin.y) {
        >> errors.new("nexus text: invalid origin or transform")
    }
    if color < 0 || color > 4294967295 {
        >> errors.new("nexus text: invalid RGBA text color")
    }
    << 0
}

fn append_entry_quad(batch $&canvas.Batch2D, entry &font.AtlasEntry,
    gx f64, gy f64, origin fm.Vec2, transform fm.Transform2D, color int) int {
    if !entry.has_ink || entry.w <= 0 || entry.h <= 0 { << 0 }
    bounds := fm.rect2(
        origin.x + gx + f64(entry.offset_x),
        origin.y + gy + f64(entry.offset_y),
        f64(entry.w),
        f64(entry.h)
    )
    uv := clamped_uv(entry)
    batch.quad_region(bounds, transform, color, uv) or >>
    << 1
}

// Populates the glyph atlas for all glyphs in layout first so auto-grow cannot
// invalidate previously emitted quad UVs, then appends textured glyph quads.
pub fn append_layout_quads(batch $&canvas.Batch2D, layout &font.TextLayout,
    stack &font.FontStack, atlas $&font.GlyphAtlas,
    origin fm.Vec2, transform fm.Transform2D, color int) int {
    validate_quad_args(transform, origin, color) or >>
    layout.populate_atlas(atlas, stack) or >>
    $emitted := 0
    glyph_total := layout.glyph_count()
    for i in 0:glyph_total {
        g := layout.glyph_at(i)
        if g.is_newline { -> }
        rg := font.ResolvedGlyph{
            face_index: g.face_index,
            font_id: g.font_id,
            glyph_id: g.glyph_id
        }
        entry := atlas.get_or_rasterize(stack, rg, layout.size) or >>
        emitted += append_entry_quad(batch, &entry, g.x, g.baseline_y, origin, transform, color) or >>
    }
    << emitted
}

// Appends quads for a layout whose glyphs were already cached in atlas without
// requiring mutable atlas access or FontStack borrows.
pub fn append_cached_quads(batch $&canvas.Batch2D, layout &font.TextLayout,
    atlas &font.GlyphAtlas, origin fm.Vec2, transform fm.Transform2D, color int) int {
    validate_quad_args(transform, origin, color) or >>
    $emitted := 0
    glyph_total := layout.glyph_count()
    for i in 0:glyph_total {
        g := layout.glyph_at(i)
        if g.is_newline { -> }
        idx := atlas.entry_index(g.font_id, g.glyph_id, layout.size)
        if idx < 0 { >> errors.new("nexus text: missing glyph in cached atlas") }
        entry := atlas.entries[idx]
        emitted += append_entry_quad(batch, &entry, g.x, g.baseline_y, origin, transform, color) or >>
    }
    << emitted
}

// Shapes a single-style string using default options, rasterizes missing glyphs
// into atlas, emits quads into batch, and returns the resulting TextLayout.
pub fn draw_string_quads(batch $&canvas.Batch2D, text &string,
    stack &font.FontStack, atlas $&font.GlyphAtlas,
    origin fm.Vec2, size f64, color int) font.TextLayout {
    opts := font.default_options(size)
    layout := font.layout_text(stack, text, &opts) or >>
    append_layout_quads(batch, &layout, stack, atlas, origin, fm.identity(), color) or >>
    << layout
}

// Shapes a wrapped/aligned string using wrapped options, rasterizes missing glyphs
// into atlas, emits quads into batch, and returns the resulting TextLayout.
pub fn draw_wrapped_quads(batch $&canvas.Batch2D, text &string,
    stack &font.FontStack, atlas $&font.GlyphAtlas,
    origin fm.Vec2, size f64, width f64, align int, color int) font.TextLayout {
    opts := font.wrapped_options(size, width, align)
    layout := font.layout_text(stack, text, &opts) or >>
    append_layout_quads(batch, &layout, stack, atlas, origin, fm.identity(), color) or >>
    << layout
}
