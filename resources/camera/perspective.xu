@"github.com/xulang-org/nexus/resources/camera"

fm #"github.com/xulang-org/nexus/foundation/math"
#math
#errors

// An empty Perspective clears the camera attachment on a spatial node.
pub struct Perspective {
    vertical_fov f64
    near f64
    far f64
}

pub fn (lens Perspective) is_set() bool { << lens.vertical_fov != 0.0 }
pub fn (lens Perspective) vertical_fov() f64 { << lens.vertical_fov }
pub fn (lens Perspective) near() f64 { << lens.near }
pub fn (lens Perspective) far() f64 { << lens.far }

pub fn perspective(vertical_fov f64, near f64, far f64) Perspective {
    projection(vertical_fov, 1.0, near, far) >>>
    << Perspective{vertical_fov: vertical_fov, near: near, far: far}
}

// Finite reverse-Z perspective: NDC depth near=1, far=0, clear=0, compare GREATER.
pub fn projection(vertical_fov f64, aspect f64, near f64, far f64) fm.Mat4 {
    if !fm.finite(vertical_fov) || !fm.finite(aspect) || !fm.finite(near) || !fm.finite(far) ||
        vertical_fov < 0.01 || vertical_fov > 3.13 || aspect <= 0.0 || near <= 0.0 || far <= near {
        >>> errors.new("nexus: invalid perspective frustum")
    }
    half := vertical_fov * 0.5
    sine := math.sin(half)
    if sine <= 0.0 { >>> errors.new("nexus: invalid perspective angle") }
    focal := math.cos(half) / sine
    range := far - near
    if range <= 0.0 { >>> errors.new("nexus: empty perspective depth range") }
    result := fm.Mat4{c0: fm.vec4(focal / aspect, 0.0, 0.0, 0.0), c1: fm.vec4(0.0, focal, 0.0, 0.0),
        c2: fm.vec4(0.0, 0.0, near / range, -1.0), c3: fm.vec4(0.0, 0.0, near * (far / range), 0.0)}
    if !result.is_finite() { >>> errors.new("nexus: perspective matrix overflow") }
    << result
}
