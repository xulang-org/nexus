@"github.com/xulang-org/nexus/resources/camera"

fm #"github.com/xulang-org/nexus/foundation/math"
#errors

// Position and rotation come from the Node2D transform at runtime.
pub struct View2D {
    width f64
    height f64
    zoom f64
}

pub fn valid_dimensions_2d(width f64, height f64) bool {
    << fm.finite(width) && fm.finite(height) && width >= 1.0 && height >= 1.0 &&
        width <= 16384.0 && height <= 16384.0
}
pub fn valid_zoom_2d(zoom f64) bool {
    << fm.finite(zoom) && zoom >= 0.001 && zoom <= 1000.0
}
pub fn view_2d(width f64, height f64, zoom f64) View2D {
    if !valid_dimensions_2d(width, height) || !valid_zoom_2d(zoom) {
        >> errors.new("nexus: invalid 2D camera design size or zoom")
    }
    << View2D{width: width, height: height, zoom: zoom}
}
pub fn (view View2D) is_set() bool { << view.width != 0.0 }
pub fn (view View2D) width() f64 { << view.width }
pub fn (view View2D) height() f64 { << view.height }
pub fn (view View2D) zoom() f64 { << view.zoom }
