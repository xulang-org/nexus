@"github.com/xulang-org/nexus/resources/camera"

fm #"github.com/xulang-org/nexus/foundation/math"
#errors

// Vertical size is measured in world units. Aspect comes from the output.
pub struct Orthographic {
    vertical_size f64
    near f64
    far f64
}

pub fn (lens Orthographic) is_set() bool { << lens.vertical_size != 0.0 }
pub fn (lens Orthographic) vertical_size() f64 { << lens.vertical_size }
pub fn (lens Orthographic) near() f64 { << lens.near }
pub fn (lens Orthographic) far() f64 { << lens.far }

pub fn orthographic(vertical_size f64, near f64, far f64) Orthographic {
    lens := Orthographic{vertical_size: vertical_size, near: near, far: far}
    lens.projection(1.0) >>>
    << lens
}

// Same finite reverse-Z depth convention as the perspective lens.
pub fn (lens Orthographic) projection(aspect f64) fm.Mat4 {
    if !fm.finite(lens.vertical_size) || lens.vertical_size <= 0.0 ||
        !fm.finite(aspect) || aspect <= 0.0 ||
        !fm.finite(lens.near) || !fm.finite(lens.far) || lens.near < 0.0 || lens.far <= lens.near {
        >>> errors.new("nexus: invalid orthographic frustum")
    }
    depth := lens.far - lens.near
    sy := 2.0 / lens.vertical_size
    sx := sy / aspect
    sz := 1.0 / depth
    result := fm.Mat4{c0: fm.vec4(sx, 0.0, 0.0, 0.0), c1: fm.vec4(0.0, sy, 0.0, 0.0),
        c2: fm.vec4(0.0, 0.0, sz, 0.0), c3: fm.vec4(0.0, 0.0, lens.far / depth, 1.0)}
    if !result.is_finite() || sx <= 0.0 || sy <= 0.0 || sz <= 0.0 {
        >>> errors.new("nexus: orthographic matrix outside finite range")
    }
    << result
}
