@"github.com/xulang-org/nexus/resources/shadow"

lights #"github.com/xulang-org/nexus/resources/lighting"
#errors

pub struct PunctualSettings3D {
    pub near f64
    pub resolution int
    pub constant_bias f64
    pub slope_bias f64
}

// The source owns its range, cone and pose. The profile stores only authored
// sampling and projection settings and can be applied to the world-space light.
pub struct PunctualProfile3D { config PunctualSettings3D }

pub fn punctual_profile(source lights.Light3D, settings PunctualSettings3D) PunctualProfile3D {
    profile := PunctualProfile3D{config: settings}
    profile.description(source) or >>
    << profile
}

pub fn (profile PunctualProfile3D) enabled() bool { << profile.config.resolution != 0 }

pub fn (profile PunctualProfile3D) settings() PunctualSettings3D {
    if !profile.enabled() { >> errors.new("nexus shadow: no punctual shadow profile") }
    << profile.config
}

pub fn (profile PunctualProfile3D) description(source lights.Light3D) ShadowDescription3D {
    settings := profile.settings() or >>
    if source.kind() == lights.POINT {
        projection := point(source, settings.near, settings.resolution) or >>
        << projection.with_bias(settings.constant_bias, settings.slope_bias) or >>
    }
    projection := spot(source, settings.near, settings.resolution) or >>
    << projection.with_bias(settings.constant_bias, settings.slope_bias) or >>
}

pub fn validate_profiles(source lights.Light3D, cascades CascadeProfile3D, punctual PunctualProfile3D) int {
    source.validate() or >>
    if cascades.enabled() && source.kind() != lights.DIRECTIONAL {
        >> errors.new("nexus shadow: cascade profiles require a directional light")
    }
    if punctual.enabled() { punctual.description(source) or >> }
    << 0
}
