@"github.com/xulang-org/nexus/resources/shadow"

fm #"github.com/xulang-org/nexus/foundation/math"
lights #"github.com/xulang-org/nexus/resources/lighting"
#errors

// Six world-aligned 90-degree projections, independent of GPU atlas packing.
pub fn point(source lights.Light3D,near f64,resolution int) ShadowDescription3D {
    source.validate() >>>
    if source.kind()!=lights.POINT { >>> errors.new("nexus shadow: point projection requires a point source") }
    result := ShadowDescription3D{kind: lights.POINT,center: source.position(),direction: fm.vec3(0.0,0.0,0.0),extent: 0.0,depth: source.radius(),
        near: near,outer_cosine: 0.0,resolution: resolution,bias: 0.00002,slope: 0.00005,cascades: no_cascades()}
    result.validate() >>>
    << result
}
// Order is +X,-X,+Y,-Y,+Z,-Z; right/up follow the shared perspective basis.
pub fn point_face_direction(face int) fm.Vec3 {
    if face==0 { << fm.vec3(1.0,0.0,0.0) }
    if face==1 { << fm.vec3(-1.0,0.0,0.0) }
    if face==2 { << fm.vec3(0.0,1.0,0.0) }
    if face==3 { << fm.vec3(0.0,-1.0,0.0) }
    if face==4 { << fm.vec3(0.0,0.0,1.0) }
    if face==5 { << fm.vec3(0.0,0.0,-1.0) }
    >>> errors.new("nexus shadow: point face outside 0...5")
}
