@"github.com/xulang-org/nexus/resources/shadow"

fm #"github.com/xulang-org/nexus/foundation/math"
lights #"github.com/xulang-org/nexus/resources/lighting"
#math
#errors

// The source already owns position, forward, radius and cosine-domain cone.
// Inner cone and intensity affect illumination, not shadow coverage.
pub fn spot(source lights.Light3D,near f64,resolution int) ShadowDescription3D {
    source.validate() or >>
    if source.kind()!=lights.SPOT { >> errors.new("nexus shadow: spot projection requires a spot source") }
    result := ShadowDescription3D{kind: lights.SPOT,center: source.position(),direction: source.direction(),extent: 0.0,depth: source.radius(),
        near: near,outer_cosine: source.outer_cosine(),resolution: resolution,bias: 0.00002,slope: 0.00005,pcss_light_radius: 0.0,cascades: no_cascades()}
    result.validate() or >>
    << result
}
fn (description &ShadowDescription3D) perspective_view_projection(forward fm.Vec3,focal f64) fm.Mat4 {
    back := forward.scaled(-1.0)
    $up := fm.vec3(0.0,1.0,0.0)
    if math.abs(back.y)>0.99 { up=fm.vec3(0.0,0.0,1.0) }
    right := up.cross(back).normalized() or >>
    vertical := back.cross(right)
    position := description.center
    view := fm.Mat4{c0: fm.vec4(right.x,vertical.x,back.x,0.0),c1: fm.vec4(right.y,vertical.y,back.y,0.0),
        c2: fm.vec4(right.z,vertical.z,back.z,0.0),c3: fm.vec4(-right.dot(position),-vertical.dot(position),-back.dot(position),1.0)}
    depth := description.depth_coefficients() or >>
    projection := fm.Mat4{c0: fm.vec4(focal,0.0,0.0,0.0),c1: fm.vec4(0.0,focal,0.0,0.0),
        c2: fm.vec4(0.0,0.0,depth.y,-1.0),c3: fm.vec4(0.0,0.0,depth.x,0.0)}
    result := projection.multiply(view)
    if !result.is_finite() { >> errors.new("nexus shadow: punctual matrix overflow") }
    << result
}
