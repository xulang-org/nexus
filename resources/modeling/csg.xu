@"github.com/xulang-org/nexus/resources/modeling"

fm #"github.com/xulang-org/nexus/foundation/math"
#encoding/json
#errors
#math
#strings

pub const CSG_OP_UNION = 0
pub const CSG_OP_SUBTRACT = 1
pub const CSG_OP_INTERSECT = 2

pub const CSG_SHAPE_BOX = 0
pub const CSG_SHAPE_WEDGE = 1
pub const CSG_SHAPE_STAIR = 2
pub const CSG_SHAPE_CYLINDER = 3
pub const CSG_SHAPE_ARCH = 4
pub const CSG_SHAPE_SPHERE = 5

pub const MAX_CSG_BRUSHES = 256

pub struct CsgBrush {
    pub id int
    pub name string
    pub shape int
    pub op int
    pub transform fm.Mat4
    pub size fm.Vec3
    pub segments int
    pub step_count int
    pub arch_thickness f64
    pub material_slot int
    pub color int
    pub flip_normals bool
}

pub struct CsgTree {
    pub brushes []CsgBrush
}

pub fn default_csg_brush(id int, shape int, op int) CsgBrush {
    << CsgBrush{
        id: id,
        name: "Brush_" + str(id),
        shape: shape,
        op: op,
        transform: fm.identity_3d(),
        size: fm.vec3(2.0, 2.0, 2.0),
        segments: 16,
        step_count: 6,
        arch_thickness: 0.35,
        material_slot: 0,
        color: 4294967295,
        flip_normals: false
    }
}

pub fn new_csg_tree() CsgTree {
    << CsgTree{brushes: []CsgBrush{}}
}

pub fn (b &CsgBrush) validate() int {
    if b.shape < CSG_SHAPE_BOX || b.shape > CSG_SHAPE_SPHERE {
        >> errors.new("nexus modeling: unsupported CSG shape")
    }
    if b.op < CSG_OP_UNION || b.op > CSG_OP_INTERSECT {
        >> errors.new("nexus modeling: unsupported CSG boolean operation")
    }
    if !b.transform.is_affine() {
        >> errors.new("nexus modeling: CSG brush transform must be finite affine")
    }
    if !b.size.is_finite() || b.size.x <= 0.0001 || b.size.y <= 0.0001 || b.size.z <= 0.0001 ||
        b.size.x > 100000.0 || b.size.y > 100000.0 || b.size.z > 100000.0 {
        >> errors.new("nexus modeling: CSG brush dimensions outside valid range")
    }
    if b.segments < 3 || b.segments > 64 || b.step_count < 1 || b.step_count > 64 {
        >> errors.new("nexus modeling: CSG segments/steps outside 3..64 / 1..64")
    }
    if !fm.finite(b.arch_thickness) || b.arch_thickness <= 0.0001 || b.arch_thickness >= b.size.x * 0.49 {
        if b.shape == CSG_SHAPE_ARCH {
            >> errors.new("nexus modeling: invalid CSG arch thickness")
        }
    }
    if b.material_slot < 0 || b.material_slot >= MAX_MATERIAL_SLOTS {
        >> errors.new("nexus modeling: invalid CSG material_slot")
    }
    if b.color < 0 || b.color > 4294967295 {
        >> errors.new("nexus modeling: invalid CSG color")
    }
    << 0
}

pub fn (t &CsgTree) validate() int {
    if t.brushes.len > MAX_CSG_BRUSHES {
        >> errors.new("nexus modeling: CSG brush count exceeds 256")
    }
    for b in t.brushes {
        b.validate() >>>
    }
    << 0
}

pub fn (t &CsgTree) clone() CsgTree {
    $out := []CsgBrush{}
    for b in t.brushes {
        out.push(CsgBrush{
            id: b.id,
            name: b.name + "",
            shape: b.shape,
            op: b.op,
            transform: b.transform,
            size: b.size,
            segments: b.segments,
            step_count: b.step_count,
            arch_thickness: b.arch_thickness,
            material_slot: b.material_slot,
            color: b.color,
            flip_normals: b.flip_normals
        })
    }
    << CsgTree{brushes: out}
}

pub fn (t &CsgTree) encode_json() string {
    t.validate() >>>
    $out := strings.new_byte_builder(512)
    out.write_str("{\"format\":\"nexus.csg_tree\",\"version\":1,\"brushes\":[")
    for i in 0:t.brushes.len {
        if i > 0 { out.write_str(",") }
        b := &t.brushes[i]
        nm := b.name + ""
        m := b.transform
        out.write_str("{\"id\":" + str(b.id) + ",\"name\":" + json.quote(&nm) +
            ",\"shape\":" + str(b.shape) + ",\"op\":" + str(b.op) +
            ",\"size\":[" + fmt_f64_json(b.size.x) + "," + fmt_f64_json(b.size.y) + "," + fmt_f64_json(b.size.z) + "]" +
            ",\"transform\":[" +
            fmt_f64_json(m.c0.x) + "," + fmt_f64_json(m.c0.y) + "," + fmt_f64_json(m.c0.z) + "," + fmt_f64_json(m.c0.w) + "," +
            fmt_f64_json(m.c1.x) + "," + fmt_f64_json(m.c1.y) + "," + fmt_f64_json(m.c1.z) + "," + fmt_f64_json(m.c1.w) + "," +
            fmt_f64_json(m.c2.x) + "," + fmt_f64_json(m.c2.y) + "," + fmt_f64_json(m.c2.z) + "," + fmt_f64_json(m.c2.w) + "," +
            fmt_f64_json(m.c3.x) + "," + fmt_f64_json(m.c3.y) + "," + fmt_f64_json(m.c3.z) + "," + fmt_f64_json(m.c3.w) + "]" +
            ",\"segments\":" + str(b.segments) + ",\"step_count\":" + str(b.step_count) +
            ",\"arch_thickness\":" + fmt_f64_json(b.arch_thickness) +
            ",\"material_slot\":" + str(b.material_slot) + ",\"color\":" + str(b.color) +
            ",\"flip_normals\":" + str(b.flip_normals) + "}")
    }
    out.write_str("]}\n")
    << out.to_string()
}

pub fn decode_csg_tree_node(doc &json.Doc, root int) CsgTree {
    if root < 0 || !doc.is_dict(root) { >> errors.new("nexus modeling: expected CsgTree JSON object") }
    if (doc.as_string(doc.get(root, "format")) >>>) != "nexus.csg_tree" ||
        (doc.as_int(doc.get(root, "version")) >>>) != 1 {
        >> errors.new("nexus modeling: unsupported CsgTree format/version")
    }
    blist := doc.get(root, "brushes")
    if blist < 0 || !doc.is_list(blist) || doc.count(blist) > MAX_CSG_BRUSHES {
        >> errors.new("nexus modeling: invalid CSG brushes array")
    }
    $tree := new_csg_tree()
    for i in 0:doc.count(blist) {
        bn := doc.at(blist, i)
        if !doc.is_dict(bn) { >> errors.new("nexus modeling: expected brush object") }
        sz := doc.get(bn, "size")
        tr := doc.get(bn, "transform")
        if sz < 0 || !doc.is_list(sz) || doc.count(sz) != 3 ||
            tr < 0 || !doc.is_list(tr) || doc.count(tr) != 16 {
            >> errors.new("nexus modeling: invalid brush size/transform")
        }
        $tv := []f64{}
        for j in 0:16 { tv.push(doc.as_f64(doc.at(tr, j)) >>>) }
        mat := fm.Mat4{
            c0: fm.vec4(tv[0], tv[1], tv[2], tv[3]),
            c1: fm.vec4(tv[4], tv[5], tv[6], tv[7]),
            c2: fm.vec4(tv[8], tv[9], tv[10], tv[11]),
            c3: fm.vec4(tv[12], tv[13], tv[14], tv[15])
        }
        b := CsgBrush{
            id: doc.as_int(doc.get(bn, "id")) >>>,
            name: doc.as_string(doc.get(bn, "name")) >>>,
            shape: doc.as_int(doc.get(bn, "shape")) >>>,
            op: doc.as_int(doc.get(bn, "op")) >>>,
            transform: mat,
            size: fm.vec3(doc.as_f64(doc.at(sz, 0)) >>>, doc.as_f64(doc.at(sz, 1)) >>>, doc.as_f64(doc.at(sz, 2)) >>>),
            segments: doc.as_int(doc.get(bn, "segments")) >>>,
            step_count: doc.as_int(doc.get(bn, "step_count")) >>>,
            arch_thickness: doc.as_f64(doc.get(bn, "arch_thickness")) >>>,
            material_slot: doc.as_int(doc.get(bn, "material_slot")) >>>,
            color: doc.as_int(doc.get(bn, "color")) >>>,
            flip_normals: doc.as_bool(doc.get(bn, "flip_normals")) >>>
        }
        b.validate() >>>
        tree.brushes.push(b)
    }
    tree.validate() >>>
    << tree
}

pub fn decode_csg_tree_json(raw &string) CsgTree {
    if raw.len < 2 || raw.len > MAX_MODELING_JSON_BYTES {
        >> errors.new("nexus modeling: CsgTree JSON size outside limits")
    }
    doc := json.parse_max(raw, MAX_MODELING_JSON_BYTES)
    if !doc.ok() { >> errors.new("nexus modeling CSG JSON: " + doc.error()) }
    << decode_csg_tree_node(&doc, doc.root()) >>>
}
