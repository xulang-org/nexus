@"github.com/xulang-org/nexus/resources/modeling"

fm #"github.com/xulang-org/nexus/foundation/math"
#encoding/json
#errors
#strings

pub const ALPHA_OPAQUE = 0
pub const ALPHA_MASK = 1
pub const ALPHA_BLEND = 2

pub struct MaterialAsset {
    pub name string
    pub base_color fm.Vec3
    pub alpha f64
    pub metallic f64
    pub roughness f64
    pub emission fm.Vec3
    pub normal_scale f64
    pub occlusion_strength f64
    pub alpha_mode int
    pub alpha_cutoff f64
    pub double_sided bool
    pub clearcoat f64
    pub clearcoat_roughness f64
    pub sheen_color fm.Vec3
    pub sheen_roughness f64
    pub ior f64
    pub base_texture_uid string
    pub orm_texture_uid string
    pub normal_texture_uid string
    pub emission_texture_uid string
    pub occlusion_texture_uid string
    pub uv_offset fm.Vec2
    pub uv_scale fm.Vec2
    pub flip_u bool
    pub flip_v bool
}

pub fn default_material_asset(name string) MaterialAsset {
    << MaterialAsset{
        name: name + "",
        base_color: fm.vec3(0.82, 0.82, 0.85),
        alpha: 1.0,
        metallic: 0.0,
        roughness: 0.65,
        emission: fm.vec3(0.0, 0.0, 0.0),
        normal_scale: 1.0,
        occlusion_strength: 1.0,
        alpha_mode: ALPHA_OPAQUE,
        alpha_cutoff: 0.5,
        double_sided: false,
        clearcoat: 0.0,
        clearcoat_roughness: 0.08,
        sheen_color: fm.vec3(0.0, 0.0, 0.0),
        sheen_roughness: 0.5,
        ior: 1.5,
        base_texture_uid: "",
        orm_texture_uid: "",
        normal_texture_uid: "",
        emission_texture_uid: "",
        occlusion_texture_uid: "",
        uv_offset: fm.vec2(0.0, 0.0),
        uv_scale: fm.vec2(1.0, 1.0),
        flip_u: false,
        flip_v: false
    }
}

fn valid_vec3_range(v fm.Vec3, lo f64, hi f64) bool {
    << v.is_finite() && v.x >= lo && v.x <= hi && v.y >= lo && v.y <= hi && v.z >= lo && v.z <= hi
}

fn valid_opt_uid(uid &string) bool {
    if uid.len == 0 { << true }
    if uid.len != 32 { << false }
    for i in 0:32 {
        c := uid[i] & 255
        if !(c >= 48 && c <= 57) && !(c >= 97 && c <= 102) { << false }
    }
    << true
}

pub fn (m &MaterialAsset) validate() int {
    if !valid_vec3_range(m.base_color, 0.0, 1.0) || !valid_vec3_range(m.emission, 0.0, 16.0) ||
        !valid_vec3_range(m.sheen_color, 0.0, 1.0) {
        >> errors.new("nexus modeling: invalid MaterialAsset RGB vector")
    }
    if !fm.finite(m.alpha) || m.alpha < 0.0 || m.alpha > 1.0 ||
        !fm.finite(m.metallic) || m.metallic < 0.0 || m.metallic > 1.0 ||
        !fm.finite(m.roughness) || m.roughness < 0.045 || m.roughness > 1.0 ||
        !fm.finite(m.normal_scale) || m.normal_scale < 0.0 || m.normal_scale > 8.0 ||
        !fm.finite(m.occlusion_strength) || m.occlusion_strength < 0.0 || m.occlusion_strength > 1.0 ||
        !fm.finite(m.alpha_cutoff) || m.alpha_cutoff < 0.0 || m.alpha_cutoff > 1.0 ||
        m.alpha_mode < ALPHA_OPAQUE || m.alpha_mode > ALPHA_BLEND ||
        !fm.finite(m.clearcoat) || m.clearcoat < 0.0 || m.clearcoat > 1.0 ||
        !fm.finite(m.clearcoat_roughness) || m.clearcoat_roughness < 0.045 || m.clearcoat_roughness > 1.0 ||
        !fm.finite(m.sheen_roughness) || m.sheen_roughness < 0.045 || m.sheen_roughness > 1.0 ||
        !fm.finite(m.ior) || m.ior < 1.0 || m.ior > 2.5 {
        >> errors.new("nexus modeling: MaterialAsset scalar parameter out of range")
    }
    if !fm.finite(m.uv_offset.x) || !fm.finite(m.uv_offset.y) ||
        !fm.finite(m.uv_scale.x) || !fm.finite(m.uv_scale.y) ||
        m.uv_scale.x <= 0.0 || m.uv_scale.y <= 0.0 {
        >> errors.new("nexus modeling: MaterialAsset UV transform invalid")
    }
    if !valid_opt_uid(&m.base_texture_uid) || !valid_opt_uid(&m.orm_texture_uid) ||
        !valid_opt_uid(&m.normal_texture_uid) || !valid_opt_uid(&m.emission_texture_uid) ||
        !valid_opt_uid(&m.occlusion_texture_uid) {
        >> errors.new("nexus modeling: MaterialAsset texture UID must be empty or 32 lowercase hex")
    }
    << 0
}

pub fn (m &MaterialAsset) encode_json() string {
    m.validate() or >>
    $out := strings.new_byte_builder(512)
    nm := m.name + ""
    out.write_str("{\"format\":\"nexus.material\",\"version\":1,\"name\":" + json.quote(&nm))
    out.write_str(",\"base_color\":[" + fmt_f64_json(m.base_color.x) + "," + fmt_f64_json(m.base_color.y) + "," + fmt_f64_json(m.base_color.z) + "]")
    out.write_str(",\"alpha\":" + fmt_f64_json(m.alpha) + ",\"metallic\":" + fmt_f64_json(m.metallic) + ",\"roughness\":" + fmt_f64_json(m.roughness))
    out.write_str(",\"emission\":[" + fmt_f64_json(m.emission.x) + "," + fmt_f64_json(m.emission.y) + "," + fmt_f64_json(m.emission.z) + "]")
    out.write_str(",\"normal_scale\":" + fmt_f64_json(m.normal_scale) + ",\"occlusion_strength\":" + fmt_f64_json(m.occlusion_strength))
    out.write_str(",\"alpha_mode\":" + str(m.alpha_mode) + ",\"alpha_cutoff\":" + fmt_f64_json(m.alpha_cutoff) + ",\"double_sided\":" + str(m.double_sided))
    out.write_str(",\"clearcoat\":" + fmt_f64_json(m.clearcoat) + ",\"clearcoat_roughness\":" + fmt_f64_json(m.clearcoat_roughness))
    out.write_str(",\"sheen_color\":[" + fmt_f64_json(m.sheen_color.x) + "," + fmt_f64_json(m.sheen_color.y) + "," + fmt_f64_json(m.sheen_color.z) + "]")
    out.write_str(",\"sheen_roughness\":" + fmt_f64_json(m.sheen_roughness) + ",\"ior\":" + fmt_f64_json(m.ior))
    u1 := m.base_texture_uid + ""
    u2 := m.orm_texture_uid + ""
    u3 := m.normal_texture_uid + ""
    u4 := m.emission_texture_uid + ""
    u5 := m.occlusion_texture_uid + ""
    out.write_str(",\"base_texture_uid\":" + json.quote(&u1) + ",\"orm_texture_uid\":" + json.quote(&u2) +
        ",\"normal_texture_uid\":" + json.quote(&u3) + ",\"emission_texture_uid\":" + json.quote(&u4) +
        ",\"occlusion_texture_uid\":" + json.quote(&u5))
    out.write_str(",\"uv_offset\":[" + fmt_f64_json(m.uv_offset.x) + "," + fmt_f64_json(m.uv_offset.y) + "]")
    out.write_str(",\"uv_scale\":[" + fmt_f64_json(m.uv_scale.x) + "," + fmt_f64_json(m.uv_scale.y) + "]")
    out.write_str(",\"flip_u\":" + str(m.flip_u) + ",\"flip_v\":" + str(m.flip_v) + "}\n")
    << out.to_string()
}

fn read_vec3_field(doc &json.Doc, obj int, key string) fm.Vec3 {
    arr := doc.get(obj, key + "")
    if arr < 0 || !doc.is_list(arr) || doc.count(arr) != 3 {
        >> errors.new("nexus modeling: expected 3-element array for " + key)
    }
    << fm.vec3(doc.as_f64(doc.at(arr, 0)) or >>, doc.as_f64(doc.at(arr, 1)) or >>, doc.as_f64(doc.at(arr, 2)) or >>)
}

fn read_vec2_field(doc &json.Doc, obj int, key string) fm.Vec2 {
    arr := doc.get(obj, key + "")
    if arr < 0 || !doc.is_list(arr) || doc.count(arr) != 2 {
        >> errors.new("nexus modeling: expected 2-element array for " + key)
    }
    << fm.vec2(doc.as_f64(doc.at(arr, 0)) or >>, doc.as_f64(doc.at(arr, 1)) or >>)
}

pub fn decode_material_asset_node(doc &json.Doc, root int) MaterialAsset {
    if root < 0 || !doc.is_dict(root) { >> errors.new("nexus modeling: expected MaterialAsset JSON object") }
    if (doc.as_string(doc.get(root, "format")) or >>) != "nexus.material" ||
        (doc.as_int(doc.get(root, "version")) or >>) != 1 {
        >> errors.new("nexus modeling: unsupported MaterialAsset format/version")
    }
    m := MaterialAsset{
        name: doc.as_string(doc.get(root, "name")) or >>,
        base_color: read_vec3_field(doc, root, "base_color") or >>,
        alpha: doc.as_f64(doc.get(root, "alpha")) or >>,
        metallic: doc.as_f64(doc.get(root, "metallic")) or >>,
        roughness: doc.as_f64(doc.get(root, "roughness")) or >>,
        emission: read_vec3_field(doc, root, "emission") or >>,
        normal_scale: doc.as_f64(doc.get(root, "normal_scale")) or >>,
        occlusion_strength: doc.as_f64(doc.get(root, "occlusion_strength")) or >>,
        alpha_mode: doc.as_int(doc.get(root, "alpha_mode")) or >>,
        alpha_cutoff: doc.as_f64(doc.get(root, "alpha_cutoff")) or >>,
        double_sided: doc.as_bool(doc.get(root, "double_sided")) or >>,
        clearcoat: doc.as_f64(doc.get(root, "clearcoat")) or >>,
        clearcoat_roughness: doc.as_f64(doc.get(root, "clearcoat_roughness")) or >>,
        sheen_color: read_vec3_field(doc, root, "sheen_color") or >>,
        sheen_roughness: doc.as_f64(doc.get(root, "sheen_roughness")) or >>,
        ior: doc.as_f64(doc.get(root, "ior")) or >>,
        base_texture_uid: doc.as_string(doc.get(root, "base_texture_uid")) or >>,
        orm_texture_uid: doc.as_string(doc.get(root, "orm_texture_uid")) or >>,
        normal_texture_uid: doc.as_string(doc.get(root, "normal_texture_uid")) or >>,
        emission_texture_uid: doc.as_string(doc.get(root, "emission_texture_uid")) or >>,
        occlusion_texture_uid: doc.as_string(doc.get(root, "occlusion_texture_uid")) or >>,
        uv_offset: read_vec2_field(doc, root, "uv_offset") or >>,
        uv_scale: read_vec2_field(doc, root, "uv_scale") or >>,
        flip_u: doc.as_bool(doc.get(root, "flip_u")) or >>,
        flip_v: doc.as_bool(doc.get(root, "flip_v")) or >>
    }
    m.validate() or >>
    << m
}

pub fn decode_material_asset_json(raw &string) MaterialAsset {
    if raw.len < 2 || raw.len > 65536 {
        >> errors.new("nexus modeling: MaterialAsset JSON size outside limits")
    }
    doc := json.parse_max(raw, 65536)
    if !doc.ok() { >> errors.new("nexus modeling Material JSON: " + doc.error()) }
    << decode_material_asset_node(&doc, doc.root()) or >>
}
