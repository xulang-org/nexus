@"github.com/xulang-org/nexus/resources/canvas"

fm #"github.com/xulang-org/nexus/foundation/math"
#errors

pub const MAX_SDF_RECTS_2D = 16384

pub struct SdfRect {
    pub bounds fm.Rect2
    pub radius f64
    pub border_width f64
    pub fill_color int
    pub border_color int
}

pub struct SdfBatch {
    rects []SdfRect
    count int
}

pub fn new_sdf_batch() SdfBatch {
    << SdfBatch{rects: []SdfRect{}, count: 0}
}

pub fn (batch $&SdfBatch) clear() {
    batch.count = 0
}

pub fn (batch &SdfBatch) rect_count() int {
    << batch.count
}

fn push_rect(batch $&SdfBatch, value SdfRect) {
    if batch.count < batch.rects.len {
        batch.rects[batch.count] = value
    } else {
        batch.rects.push(value)
    }
    batch.count = batch.count + 1
}

pub fn (batch $&SdfBatch) rounded_rect(bounds fm.Rect2, radius f64, fill_color int,
    border_width f64, border_color int) int {
    if batch.count >= MAX_SDF_RECTS_2D {
        >> errors.new("nexus canvas: SDF batch capacity exceeded")
    }
    if !bounds.valid() || !valid_point(bounds.position) ||
        !valid_point(bounds.position.add(bounds.size)) ||
        !fm.finite(radius) || radius < 0.0 ||
        !fm.finite(border_width) || border_width < 0.0 ||
        fill_color < 0 || fill_color > 4294967295 ||
        border_color < 0 || border_color > 4294967295 {
        >> errors.new("nexus canvas: invalid SDF rounded rectangle parameters")
    }
    push_rect(batch, SdfRect{bounds: bounds, radius: radius, border_width: border_width,
        fill_color: fill_color, border_color: border_color})
    << 0
}

pub fn (batch $&SdfBatch) fill_rect(bounds fm.Rect2, radius f64, color int) int {
    << batch.rounded_rect(bounds, radius, color, 0.0, 0) or >>
}

pub fn (batch $&SdfBatch) circle(center fm.Vec2, radius f64, fill_color int,
    border_width f64, border_color int) int {
    if !fm.finite(radius) || radius < 0.0 {
        >> errors.new("nexus canvas: invalid SDF circle radius")
    }
    bounds := fm.rect2(center.x - radius, center.y - radius, radius * 2.0, radius * 2.0)
    << batch.rounded_rect(bounds, radius, fill_color, border_width, border_color) or >>
}

pub fn (batch &SdfBatch) rect_at(index int) SdfRect {
    if index < 0 || index >= batch.count {
        >> errors.new("nexus canvas: SDF rect index outside batch")
    }
    << batch.rects[index]
}
