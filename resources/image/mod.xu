@"github.com/xulang-org/nexus/resources/image"

#errors

pub const MAX_DIMENSION = 4096
pub const MAX_PIXELS = 4194304
// CPU pixels in row-major straight RGBA8. No renderer, codec or file ownership.
// Public data can be edited; consumers must validate before use.
pub struct ImageRGBA8 {
    pub width int
    pub height int
    pub pixels []int
}
pub fn (image &ImageRGBA8) validate() int {
    if image.width < 1 || image.width > MAX_DIMENSION || image.height < 1 || image.height > MAX_DIMENSION ||
        image.width * image.height > MAX_PIXELS || image.pixels.len != image.width * image.height {
        >> errors.new("nexus image: invalid dimensions or pixel count")
    }
    for pixel in image.pixels {
        if pixel < 0 || pixel > 4294967295 { >> errors.new("nexus image: invalid RGBA8 pixel") }
    }
    << 0
}
