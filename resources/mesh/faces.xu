@"github.com/xulang-org/nexus/resources/mesh"

fm #"github.com/xulang-org/nexus/foundation/math"
#errors

// Normalize edges before crossing to avoid overflow/underflow from coordinate
// scale. The import profile rejects zero edges and near-collinear corners.
pub fn triangle_normal(a fm.Vec3,b fm.Vec3,c fm.Vec3) fm.Vec3 {
    u := b.sub(a).normalized() or >>
    v := c.sub(a).normalized() or >>
    cross := u.cross(v)
    if cross.dot(cross)<1e-24 { >> errors.new("nexus mesh: degenerate or near-collinear face") }
    << cross.normalized() or >>
}
