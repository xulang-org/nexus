@"github.com/xulang-org/nexus/resources/mesh"

fm #"github.com/xulang-org/nexus/foundation/math"
#errors
#math

// Angle-weighted UV gradients for procedural meshes, grouped by original
// vertex and handedness. This algorithm is independent of MikkTSpace.
struct TangentFace { tangent fm.Vec3
    bitangent fm.Vec3 }
fn tangent_face(a &Vertex3D, b &Vertex3D, c &Vertex3D) TangentFace {
    edge1 := b.position.sub(a.position)
    edge2 := c.position.sub(a.position)
    unit1 := edge1.normalized() >>>
    unit2 := edge2.normalized() >>>
    if unit1.cross(unit2).length() <= 0.000000000001 {
        >>> errors.new("nexus mesh: degenerate triangle cannot define a tangent")
    }
    scale := math.max(math.max(math.abs(edge1.x), math.max(math.abs(edge1.y), math.abs(edge1.z))),
        math.max(math.abs(edge2.x), math.max(math.abs(edge2.y), math.abs(edge2.z))))
    e1 := fm.vec3(edge1.x / scale, edge1.y / scale, edge1.z / scale)
    e2 := fm.vec3(edge2.x / scale, edge2.y / scale, edge2.z / scale)
    du1 := b.uv.x - a.uv.x
    dv1 := b.uv.y - a.uv.y
    du2 := c.uv.x - a.uv.x
    dv2 := c.uv.y - a.uv.y
    uv_scale := math.max(math.max(math.abs(du1), math.abs(dv1)), math.max(math.abs(du2), math.abs(dv2)))
    if uv_scale == 0.0 { >>> errors.new("nexus mesh: constant UVs cannot define a tangent") }
    u1 := du1 / uv_scale
    v1 := dv1 / uv_scale
    u2 := du2 / uv_scale
    v2 := dv2 / uv_scale
    determinant := u1 * v2 - u2 * v1
    if math.abs(determinant) <= 0.000000000001 {
        >>> errors.new("nexus mesh: degenerate or ill-conditioned UV triangle")
    }
    $sign := 1.0
    if determinant < 0.0 { sign = -1.0 }
    tangent := e1.scaled(v2).sub(e2.scaled(v1)).scaled(sign).normalized() >>>
    bitangent := e2.scaled(u1).sub(e1.scaled(u2)).scaled(sign).normalized() >>>
    << TangentFace{tangent: tangent, bitangent: bitangent}
}
fn corner_angle(a fm.Vec3, b fm.Vec3, c fm.Vec3) f64 {
    first := b.sub(a).normalized() >>>
    second := c.sub(a).normalized() >>>
    << math.atan2(first.cross(second).length(), first.dot(second))
}
fn corner_tangent(vertex &Vertex3D, face &TangentFace) fm.Vec4 {
    n := vertex.normal
    projected := face.tangent.sub(n.scaled(n.dot(face.tangent)))
    if projected.length() <= 0.000000000001 {
        >>> errors.new("nexus mesh: tangent is parallel to the vertex normal")
    }
    t := projected.normalized() >>>
    direction := n.cross(t).dot(face.bitangent)
    if math.abs(direction) <= 0.000000000001 {
        >>> errors.new("nexus mesh: normal is incompatible with the UV basis")
    }
    $sign := 1.0
    if direction < 0.0 { sign = -1.0 }
    << fm.vec4(t.x, t.y, t.z, sign)
}

// Every vertex needs a unit normal, UV, and a nondegenerate incident triangle.
// Opposite handedness splits shared vertices; existing UV/normal seams stay
// separate. Returns added vertices. All errors leave the mesh unchanged.
pub fn (mesh $&MeshData3D) generate_tangents() int {
    mesh.validate() >>>
    $sums := []fm.Vec3{}
    $counts := []int{}
    for vertex in mesh.vertices {
        if !vertex.has_uv || vertex.normal.dot(vertex.normal) == 0.0 {
            >>> errors.new("nexus mesh: tangent generation requires normals and UVs on every vertex")
        }
        for group in 0:2 {
            sums.push(fm.vec3(0.0, 0.0, 0.0))
            counts.push(0)
        }
    }
    $groups := []int{}
    for triangle in 0:mesh.triangle_count() {
        ids := [mesh.indices[triangle * 3], mesh.indices[triangle * 3 + 1], mesh.indices[triangle * 3 + 2]]
        a := ids[0]
        b := ids[1]
        c := ids[2]
        face := tangent_face(&mesh.vertices[a], &mesh.vertices[b], &mesh.vertices[c]) >>>
        $winding := 0.0
        for corner in 0:3 {
            id := ids[corner]
            vertex := &mesh.vertices[id]
            tangent := corner_tangent(vertex, &face) >>>
            if corner == 0 { winding = tangent.w }
            if tangent.w != winding { >>> errors.new("nexus mesh: triangle normals produce mixed tangent handedness") }
            angle := corner_angle(vertex.position, mesh.vertices[ids[(corner + 1) % 3]].position,
                mesh.vertices[ids[(corner + 2) % 3]].position) >>>
            $group := ids[corner] * 2
            if tangent.w < 0.0 { group += 1 }
            sums[group] = sums[group].add(tangent.xyz().scaled(angle))
            counts[group] += 1
            groups.push(group)
        }
    }
    $vertices := []Vertex3D{}
    $mapping := []int{}
    for i in 0:sums.len { mapping.push(-1) }
    for i in 0:mesh.vertices.len {
        if counts[i * 2] == 0 && counts[i * 2 + 1] == 0 {
            >>> errors.new("nexus mesh: unreferenced vertex has no tangent basis")
        }
        for side in 0:2 {
            group := i * 2 + side
            if counts[group] == 0 { -> }
            if vertices.len >= MAX_VERTICES { >>> errors.new("nexus mesh: tangent seam split exceeds vertex limit") }
            if sums[group].length() <= 0.000000000001 {
                >>> errors.new("nexus mesh: incompatible tangents cancel at a shared vertex; split its seam")
            }
            source := mesh.vertices[i]
            t := sums[group].sub(source.normal.scaled(source.normal.dot(sums[group]))).normalized() >>>
            $sign := 1.0
            if side == 1 { sign = -1.0 }
            vertex := Vertex3D{position: source.position, color: source.color, normal: source.normal, uv: source.uv,
                tangent: fm.vec4(t.x, t.y, t.z, sign), has_uv: true, has_tangent: true}
            vertex.validate() >>>
            mapping[group] = vertices.len
            vertices.push(vertex)
        }
    }
    $indices := []int{}
    for group in groups { indices.push(mapping[group]) }
    added := vertices.len - mesh.vertices.len
    mesh.vertices = vertices
    mesh.indices = indices
    << added
}
