@"github.com/xulang-org/game/resources/mesh"

fm #"github.com/xulang-org/game/foundation/math"
#errors
#math

pub const MAX_VERTICES = 262144
pub const MAX_INDICES = 1048575

// Typed CPU data. Public edits require validation; GPU encoding is separate.
pub struct Vertex3D {
    pub position fm.Vec3
    pub color int
    pub normal fm.Vec3
    pub uv fm.Vec2
    pub tangent fm.Vec4
    pub has_uv bool
    pub has_tangent bool
}
pub struct MeshData3D {
    pub vertices []Vertex3D
    pub indices []int
}
pub fn new_mesh_data_3d() MeshData3D {
    << MeshData3D{vertices: []Vertex3D{}, indices: []int{}}
}
pub fn (mesh &MeshData3D) vertex_count() int { << mesh.vertices.len }
pub fn (mesh &MeshData3D) triangle_count() int { << mesh.indices.len / 3 }

pub fn (vertex &Vertex3D) validate() int {
    if !vertex.position.is_finite() || math.abs(vertex.position.x) > 1000000000.0 ||
        math.abs(vertex.position.y) > 1000000000.0 || math.abs(vertex.position.z) > 1000000000.0 ||
        vertex.color < 0 || vertex.color > 4294967295 {
        >> errors.new("game mesh: invalid position or RGBA8 color")
    }
    if !fm.finite(vertex.uv.x) || !fm.finite(vertex.uv.y) ||
        math.abs(vertex.uv.x) > 1000000.0 || math.abs(vertex.uv.y) > 1000000.0 {
        >> errors.new("game mesh: invalid UV coordinate")
    }
    length := vertex.normal.dot(vertex.normal)
    if !vertex.normal.is_finite() || (length != 0.0 && math.abs(length - 1.0) > 0.0001) ||
        (length != 0.0 && vertex.color % 256 != 255) {
        >> errors.new("game mesh: material vertices require a unit normal and opaque color")
    }
    if !vertex.tangent.is_finite() { >> errors.new("game mesh: non-finite tangent") }
    if vertex.has_tangent {
        t := vertex.tangent.xyz()
        if !vertex.has_uv || length == 0.0 || math.abs(t.dot(t) - 1.0) > 0.0001 ||
            math.abs(vertex.normal.dot(t)) > 0.0001 ||
            (vertex.tangent.w != -1.0 && vertex.tangent.w != 1.0) {
            >> errors.new("game mesh: tangent requires UV, perpendicular unit XYZ and W = +/-1")
        }
    } else if vertex.tangent.x != 0.0 || vertex.tangent.y != 0.0 || vertex.tangent.z != 0.0 || vertex.tangent.w != 0.0 {
        >> errors.new("game mesh: tangent data requires its presence flag")
    }
    << 0
}
pub fn (mesh &MeshData3D) validate() int {
    if mesh.vertices.len < 3 || mesh.vertices.len > MAX_VERTICES || mesh.indices.len < 3 ||
        mesh.indices.len > MAX_INDICES || mesh.indices.len % 3 != 0 {
        >> errors.new("game mesh: invalid vertex or triangle count")
    }
    for vertex in mesh.vertices { vertex.validate() or >> }
    for i in 0:mesh.indices.len / 3 {
        a := mesh.indices[i * 3]
        b := mesh.indices[i * 3 + 1]
        c := mesh.indices[i * 3 + 2]
        mesh.check_triangle(a, b, c) or >>
    }
    << 0
}
fn (mesh &MeshData3D) check_triangle(a int, b int, c int) int {
    if a < 0 || b < 0 || c < 0 || a >= mesh.vertices.len || b >= mesh.vertices.len || c >= mesh.vertices.len {
        >> errors.new("game mesh: invalid triangle index")
    }
    va := &mesh.vertices[a]
    vb := &mesh.vertices[b]
    vc := &mesh.vertices[c]
    if va.has_tangent && vb.has_tangent && vc.has_tangent &&
        (va.tangent.w != vb.tangent.w || va.tangent.w != vc.tangent.w) {
        >> errors.new("game mesh: triangle has mixed tangent handedness")
    }
    << 0
}
pub fn (mesh $&MeshData3D) triangle(a int, b int, c int) int {
    if mesh.indices.len > MAX_INDICES - 3 || mesh.indices.len % 3 != 0 {
        >> errors.new("game mesh: triangle limit exceeded or malformed indices")
    }
    mesh.check_triangle(a, b, c) or >>
    mesh.indices.push(a)
    mesh.indices.push(b)
    mesh.indices.push(c)
    << 0
}
