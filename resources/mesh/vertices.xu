@"github.com/xulang-org/nexus/resources/mesh"

fm #"github.com/xulang-org/nexus/foundation/math"
#errors
#math

pub fn (mesh $&MeshData3D) vertex(position fm.Vec3, color int) int {
    << mesh.append_vertex(position, color, fm.vec3(0.0, 0.0, 0.0), fm.vec2(0.0, 0.0), false, fm.vec4(0.0, 0.0, 0.0, 0.0)) >>>
}
pub fn (mesh $&MeshData3D) vertex_lit(position fm.Vec3, color int, normal fm.Vec3) int {
    unit := normal.normalized() >>>
    << mesh.append_vertex(position, color, unit, fm.vec2(0.0, 0.0), false, fm.vec4(0.0, 0.0, 0.0, 0.0)) >>>
}
pub fn (mesh $&MeshData3D) vertex_uv(position fm.Vec3, color int, uv fm.Vec2) int {
    << mesh.append_vertex(position, color, fm.vec3(0.0, 0.0, 0.0), uv, true, fm.vec4(0.0, 0.0, 0.0, 0.0)) >>>
}
pub fn (mesh $&MeshData3D) vertex_lit_uv(position fm.Vec3, color int, normal fm.Vec3, uv fm.Vec2) int {
    unit := normal.normalized() >>>
    << mesh.append_vertex(position, color, unit, uv, true, fm.vec4(0.0, 0.0, 0.0, 0.0)) >>>
}
// Normalize authored XYZ; UV seams/handedness changes use separate vertices.
pub fn (mesh $&MeshData3D) vertex_tangent(position fm.Vec3, color int, normal fm.Vec3, uv fm.Vec2, tangent fm.Vec4) int {
    if !tangent.is_finite() || (tangent.w != -1.0 && tangent.w != 1.0) {
        >> errors.new("nexus mesh: tangent W must be +/-1")
    }
    n := normal.normalized() >>>
    t := tangent.xyz().normalized() >>>
    if math.abs(n.dot(t)) > 0.0001 { >> errors.new("nexus mesh: tangent must be perpendicular to normal") }
    << mesh.append_vertex(position, color, n, uv, true, fm.vec4(t.x, t.y, t.z, tangent.w)) >>>
}
fn (mesh $&MeshData3D) append_vertex(position fm.Vec3, color int, normal fm.Vec3, uv fm.Vec2, has_uv bool, tangent fm.Vec4) int {
    if mesh.vertices.len >= MAX_VERTICES { >> errors.new("nexus mesh: vertex limit exceeded") }
    vertex := Vertex3D{position: position, color: color, normal: normal, uv: uv,
        tangent: tangent, has_uv: has_uv, has_tangent: tangent.w != 0.0}
    vertex.validate() >>>
    index := mesh.vertices.len
    mesh.vertices.push(vertex)
    << index
}
