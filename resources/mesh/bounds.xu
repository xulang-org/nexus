@"github.com/xulang-org/nexus/resources/mesh"

fm #"github.com/xulang-org/nexus/foundation/math"
#math

// All authored vertices, including unused ones. Conservative and independent
// of GPU packing; the renderer separately bounds the uploaded binary32 data.
pub fn (mesh &MeshData3D) bounds() fm.Aabb3 {
    mesh.validate() or >>
    $low := mesh.vertices[0].position
    $high := low
    for vertex in mesh.vertices {
        p := vertex.position
        low=fm.vec3(math.min(low.x,p.x),math.min(low.y,p.y),math.min(low.z,p.z))
        high=fm.vec3(math.max(high.x,p.x),math.max(high.y,p.y),math.max(high.z,p.z))
    }
    << fm.aabb3(low,high) or >>
}
