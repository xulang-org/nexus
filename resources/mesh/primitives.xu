@"github.com/xulang-org/nexus/resources/mesh"

fm #"github.com/xulang-org/nexus/foundation/math"
#math
#errors

// Indexed sphere with outward CCW winding and unit normals; omits pole degenerates.
pub fn sphere_mesh_3d(radius f64, segments int, rings int, color int) MeshData3D {
    if !fm.finite(radius) || radius <= 0.0 || radius > 1000000.0 || segments < 3 || segments > 128 || rings < 2 || rings > 64 {
        >> errors.new("nexus mesh: invalid sphere radius or tessellation")
    }
    $mesh := new_mesh_data_3d()
    for row in 0:rings + 1 {
        latitude := f64(row) / f64(rings) * math.pi()
        for column in 0:segments + 1 {
            longitude := f64(column) / f64(segments) * 2.0 * math.pi()
            normal := fm.vec3(math.sin(latitude) * math.cos(longitude), math.cos(latitude), math.sin(latitude) * math.sin(longitude))
            mesh.vertex_tangent(normal.scaled(radius), color, normal, fm.vec2(f64(column) / f64(segments), f64(row) / f64(rings)), fm.vec4(-math.sin(longitude), 0.0, math.cos(longitude), 1.0)) or >>
        }
    }
    for row in 0:rings {
        for column in 0:segments {
            a := row * (segments + 1) + column
            b := a + segments + 1
            if row > 0 { mesh.triangle(a, a + 1, b) or >> }
            if row < rings - 1 { mesh.triangle(a + 1, b + 1, b) or >> }
        }
    }
    << mesh
}

// Indexed XY-plane quad facing +Z with outward CCW winding, unit normal and tangent.
// pivot is normalized in [0, 1]^2 where (0, 0) is bottom-left and (0.5, 0) is bottom-center.
pub fn quad_mesh_3d(width f64, height f64, pivot fm.Vec2, color int) MeshData3D {
    if !fm.finite(width) || width <= 0.0 || width > 1000000.0 ||
        !fm.finite(height) || height <= 0.0 || height > 1000000.0 ||
        !fm.finite(pivot.x) || !fm.finite(pivot.y) ||
        pivot.x < 0.0 || pivot.x > 1.0 || pivot.y < 0.0 || pivot.y > 1.0 {
        >> errors.new("nexus mesh: invalid quad size or pivot")
    }
    x0 := -pivot.x * width
    x1 := x0 + width
    y0 := -pivot.y * height
    y1 := y0 + height
    normal := fm.vec3(0.0, 0.0, 1.0)
    tangent := fm.vec4(1.0, 0.0, 0.0, 1.0)
    $mesh := new_mesh_data_3d()
    mesh.vertex_tangent(fm.vec3(x0, y0, 0.0), color, normal, fm.vec2(0.0, 1.0), tangent) or >>
    mesh.vertex_tangent(fm.vec3(x1, y0, 0.0), color, normal, fm.vec2(1.0, 1.0), tangent) or >>
    mesh.vertex_tangent(fm.vec3(x1, y1, 0.0), color, normal, fm.vec2(1.0, 0.0), tangent) or >>
    mesh.vertex_tangent(fm.vec3(x0, y1, 0.0), color, normal, fm.vec2(0.0, 0.0), tangent) or >>
    mesh.triangle(0, 1, 2) or >>
    mesh.triangle(0, 2, 3) or >>
    << mesh
}
