@"github.com/xulang-org/nexus/resources/mesh"

fm #"github.com/xulang-org/nexus/foundation/math"
#math
#errors

// Indexed sphere with outward CCW winding and unit normals; omits pole degenerates.
pub fn sphere_mesh_3d(radius f64, segments int, rings int, color int) MeshData3D {
    if !fm.finite(radius) || radius <= 0.0 || radius > 1000000.0 || segments < 3 || segments > 128 || rings < 2 || rings > 64 {
        >> errors.new("nexus mesh: invalid sphere radius or tessellation")
    }
    $mesh := new_mesh_data_3d()
    for row in 0:rings + 1 {
        latitude := f64(row) / f64(rings) * math.pi()
        for column in 0:segments + 1 {
            longitude := f64(column) / f64(segments) * 2.0 * math.pi()
            normal := fm.vec3(math.sin(latitude) * math.cos(longitude), math.cos(latitude), math.sin(latitude) * math.sin(longitude))
            mesh.vertex_tangent(normal.scaled(radius), color, normal, fm.vec2(f64(column) / f64(segments), f64(row) / f64(rings)), fm.vec4(-math.sin(longitude), 0.0, math.cos(longitude), 1.0)) or >>
        }
    }
    for row in 0:rings {
        for column in 0:segments {
            a := row * (segments + 1) + column
            b := a + segments + 1
            if row > 0 { mesh.triangle(a, a + 1, b) or >> }
            if row < rings - 1 { mesh.triangle(a + 1, b + 1, b) or >> }
        }
    }
    << mesh
}

// Indexed XY-plane quad facing +Z with outward CCW winding, unit normal and tangent.
// pivot is normalized in [0, 1]^2 where (0, 0) is bottom-left and (0.5, 0) is bottom-center.
pub fn quad_mesh_3d(width f64, height f64, pivot fm.Vec2, color int) MeshData3D {
    if !fm.finite(width) || width <= 0.0 || width > 1000000.0 ||
        !fm.finite(height) || height <= 0.0 || height > 1000000.0 ||
        !fm.finite(pivot.x) || !fm.finite(pivot.y) ||
        pivot.x < 0.0 || pivot.x > 1.0 || pivot.y < 0.0 || pivot.y > 1.0 {
        >> errors.new("nexus mesh: invalid quad size or pivot")
    }
    x0 := -pivot.x * width
    x1 := x0 + width
    y0 := -pivot.y * height
    y1 := y0 + height
    normal := fm.vec3(0.0, 0.0, 1.0)
    tangent := fm.vec4(1.0, 0.0, 0.0, 1.0)
    $mesh := new_mesh_data_3d()
    mesh.vertex_tangent(fm.vec3(x0, y0, 0.0), color, normal, fm.vec2(0.0, 1.0), tangent) or >>
    mesh.vertex_tangent(fm.vec3(x1, y0, 0.0), color, normal, fm.vec2(1.0, 1.0), tangent) or >>
    mesh.vertex_tangent(fm.vec3(x1, y1, 0.0), color, normal, fm.vec2(1.0, 0.0), tangent) or >>
    mesh.vertex_tangent(fm.vec3(x0, y1, 0.0), color, normal, fm.vec2(0.0, 0.0), tangent) or >>
    mesh.triangle(0, 1, 2) or >>
    mesh.triangle(0, 2, 3) or >>
    << mesh
}

fn check_opaque_primitive_color(color int) int {
    if color < 0 || color > 4294967295 || (color % 256) != 255 {
        >> errors.new("nexus mesh: lit procedural primitive requires opaque RGBA8 color (alpha = 255)")
    }
    << 0
}

// Centered 24-vertex box mesh with outward CCW faces, unit normals, UVs, and valid tangents.
pub fn box_mesh_3d(size fm.Vec3, color int) MeshData3D {
    if !size.is_finite() || size.x <= 0.0 || size.y <= 0.0 || size.z <= 0.0 ||
        size.x > 1000000.0 || size.y > 1000000.0 || size.z > 1000000.0 {
        >> errors.new("nexus mesh: box_mesh_3d requires positive finite dimensions")
    }
    check_opaque_primitive_color(color) or >>
    hx := size.x * 0.5
    hy := size.y * 0.5
    hz := size.z * 0.5
    $mesh := new_mesh_data_3d()

    // +Z front
    n0 := fm.vec3(0.0, 0.0, 1.0)
    t0 := fm.vec4(1.0, 0.0, 0.0, 1.0)
    mesh.vertex_tangent(fm.vec3(-hx, -hy, hz), color, n0, fm.vec2(0.0, 1.0), t0) or >>
    mesh.vertex_tangent(fm.vec3(hx, -hy, hz), color, n0, fm.vec2(1.0, 1.0), t0) or >>
    mesh.vertex_tangent(fm.vec3(hx, hy, hz), color, n0, fm.vec2(1.0, 0.0), t0) or >>
    mesh.vertex_tangent(fm.vec3(-hx, hy, hz), color, n0, fm.vec2(0.0, 0.0), t0) or >>
    // -Z back
    n1 := fm.vec3(0.0, 0.0, -1.0)
    t1 := fm.vec4(-1.0, 0.0, 0.0, 1.0)
    mesh.vertex_tangent(fm.vec3(hx, -hy, -hz), color, n1, fm.vec2(0.0, 1.0), t1) or >>
    mesh.vertex_tangent(fm.vec3(-hx, -hy, -hz), color, n1, fm.vec2(1.0, 1.0), t1) or >>
    mesh.vertex_tangent(fm.vec3(-hx, hy, -hz), color, n1, fm.vec2(1.0, 0.0), t1) or >>
    mesh.vertex_tangent(fm.vec3(hx, hy, -hz), color, n1, fm.vec2(0.0, 0.0), t1) or >>
    // +X right
    n2 := fm.vec3(1.0, 0.0, 0.0)
    t2 := fm.vec4(0.0, 0.0, -1.0, 1.0)
    mesh.vertex_tangent(fm.vec3(hx, -hy, hz), color, n2, fm.vec2(0.0, 1.0), t2) or >>
    mesh.vertex_tangent(fm.vec3(hx, -hy, -hz), color, n2, fm.vec2(1.0, 1.0), t2) or >>
    mesh.vertex_tangent(fm.vec3(hx, hy, -hz), color, n2, fm.vec2(1.0, 0.0), t2) or >>
    mesh.vertex_tangent(fm.vec3(hx, hy, hz), color, n2, fm.vec2(0.0, 0.0), t2) or >>
    // -X left
    n3 := fm.vec3(-1.0, 0.0, 0.0)
    t3 := fm.vec4(0.0, 0.0, 1.0, 1.0)
    mesh.vertex_tangent(fm.vec3(-hx, -hy, -hz), color, n3, fm.vec2(0.0, 1.0), t3) or >>
    mesh.vertex_tangent(fm.vec3(-hx, -hy, hz), color, n3, fm.vec2(1.0, 1.0), t3) or >>
    mesh.vertex_tangent(fm.vec3(-hx, hy, hz), color, n3, fm.vec2(1.0, 0.0), t3) or >>
    mesh.vertex_tangent(fm.vec3(-hx, hy, -hz), color, n3, fm.vec2(0.0, 0.0), t3) or >>
    // +Y top
    n4 := fm.vec3(0.0, 1.0, 0.0)
    t4 := fm.vec4(1.0, 0.0, 0.0, 1.0)
    mesh.vertex_tangent(fm.vec3(-hx, hy, hz), color, n4, fm.vec2(0.0, 1.0), t4) or >>
    mesh.vertex_tangent(fm.vec3(hx, hy, hz), color, n4, fm.vec2(1.0, 1.0), t4) or >>
    mesh.vertex_tangent(fm.vec3(hx, hy, -hz), color, n4, fm.vec2(1.0, 0.0), t4) or >>
    mesh.vertex_tangent(fm.vec3(-hx, hy, -hz), color, n4, fm.vec2(0.0, 0.0), t4) or >>
    // -Y bottom
    n5 := fm.vec3(0.0, -1.0, 0.0)
    t5 := fm.vec4(1.0, 0.0, 0.0, 1.0)
    mesh.vertex_tangent(fm.vec3(-hx, -hy, -hz), color, n5, fm.vec2(0.0, 1.0), t5) or >>
    mesh.vertex_tangent(fm.vec3(hx, -hy, -hz), color, n5, fm.vec2(1.0, 1.0), t5) or >>
    mesh.vertex_tangent(fm.vec3(hx, -hy, hz), color, n5, fm.vec2(1.0, 0.0), t5) or >>
    mesh.vertex_tangent(fm.vec3(-hx, -hy, hz), color, n5, fm.vec2(0.0, 0.0), t5) or >>

    for f in 0:6 {
        b := f * 4
        mesh.triangle(b, b + 1, b + 2) or >>
        mesh.triangle(b, b + 2, b + 3) or >>
    }
    << mesh
}

// Centered XZ ground plane facing +Y with outward CCW winding, unit normals, UVs, and tangents.
pub fn plane_mesh_3d(width f64, depth f64, seg_x int, seg_z int, color int) MeshData3D {
    if !fm.finite(width) || width <= 0.0 || width > 1000000.0 ||
        !fm.finite(depth) || depth <= 0.0 || depth > 1000000.0 ||
        seg_x < 1 || seg_x > 128 || seg_z < 1 || seg_z > 128 {
        >> errors.new("nexus mesh: invalid plane dimensions or subdivisions")
    }
    check_opaque_primitive_color(color) or >>
    $mesh := new_mesh_data_3d()
    normal := fm.vec3(0.0, 1.0, 0.0)
    tangent := fm.vec4(1.0, 0.0, 0.0, 1.0)
    for row in 0:(seg_z + 1) {
        v := f64(row) / f64(seg_z)
        z := (v - 0.5) * depth
        for col in 0:(seg_x + 1) {
            u := f64(col) / f64(seg_x)
            x := (u - 0.5) * width
            mesh.vertex_tangent(fm.vec3(x, 0.0, z), color, normal, fm.vec2(u, v), tangent) or >>
        }
    }
    stride := seg_x + 1
    for row in 0:seg_z {
        for col in 0:seg_x {
            a := row * stride + col
            b := a + 1
            c := a + stride
            d := c + 1
            mesh.triangle(a, c, d) or >>
            mesh.triangle(a, d, b) or >>
        }
    }
    << mesh
}

// Y-axis cylinder/frustum/cone with outward CCW winding, unit slope normals, UVs, and tangents.
pub fn cylinder_mesh_3d(radius_top f64, radius_bottom f64, height f64, segments int, color int) MeshData3D {
    if !fm.finite(radius_top) || radius_top < 0.0 || radius_top > 1000000.0 ||
        !fm.finite(radius_bottom) || radius_bottom < 0.0 || radius_bottom > 1000000.0 ||
        (radius_top <= 0.0 && radius_bottom <= 0.0) ||
        !fm.finite(height) || height <= 0.0 || height > 1000000.0 ||
        segments < 3 || segments > 128 {
        >> errors.new("nexus mesh: invalid cylinder parameters")
    }
    check_opaque_primitive_color(color) or >>
    $mesh := new_mesh_data_3d()
    hy := height * 0.5
    dr := radius_top - radius_bottom
    slope_len := math.sqrt(dr * dr + height * height)
    $nr := 1.0
    $ny := 0.0
    if slope_len > 1e-12 {
        nr = height / slope_len
        ny = -dr / slope_len
    }

    // Side ring vertices: pairs of (bottom, top) per angular step.
    for col in 0:(segments + 1) {
        u := f64(col) / f64(segments)
        theta := u * 2.0 * math.pi()
        cs := math.cos(theta)
        sn := math.sin(theta)
        n := fm.vec3(nr * cs, ny, nr * sn).normalized() or >>
        t := fm.vec4(-sn, 0.0, cs, 1.0)
        mesh.vertex_tangent(fm.vec3(radius_bottom * cs, -hy, radius_bottom * sn), color, n, fm.vec2(u, 1.0), t) or >>
        mesh.vertex_tangent(fm.vec3(radius_top * cs, hy, radius_top * sn), color, n, fm.vec2(u, 0.0), t) or >>
    }
    for col in 0:segments {
        b0 := col * 2
        t0 := b0 + 1
        b1 := b0 + 2
        t1 := b0 + 3
        if radius_bottom > 0.0 { mesh.triangle(b0, t0, b1) or >> }
        if radius_top > 0.0 { mesh.triangle(b1, t0, t1) or >> }
    }

    // Top cap (+Y).
    if radius_top > 0.0 {
        top_n := fm.vec3(0.0, 1.0, 0.0)
        top_t := fm.vec4(1.0, 0.0, 0.0, 1.0)
        center_idx := mesh.vertex_tangent(fm.vec3(0.0, hy, 0.0), color, top_n, fm.vec2(0.5, 0.5), top_t) or >>
        ring_start := mesh.vertex_count()
        for col in 0:(segments + 1) {
            theta := f64(col) / f64(segments) * 2.0 * math.pi()
            cs := math.cos(theta)
            sn := math.sin(theta)
            mesh.vertex_tangent(fm.vec3(radius_top * cs, hy, radius_top * sn), color, top_n,
                fm.vec2(0.5 + 0.5 * cs, 0.5 - 0.5 * sn), top_t) or >>
        }
        for col in 0:segments {
            mesh.triangle(center_idx, ring_start + col + 1, ring_start + col) or >>
        }
    }

    // Bottom cap (-Y).
    if radius_bottom > 0.0 {
        bot_n := fm.vec3(0.0, -1.0, 0.0)
        bot_t := fm.vec4(1.0, 0.0, 0.0, 1.0)
        center_idx := mesh.vertex_tangent(fm.vec3(0.0, -hy, 0.0), color, bot_n, fm.vec2(0.5, 0.5), bot_t) or >>
        ring_start := mesh.vertex_count()
        for col in 0:(segments + 1) {
            theta := f64(col) / f64(segments) * 2.0 * math.pi()
            cs := math.cos(theta)
            sn := math.sin(theta)
            mesh.vertex_tangent(fm.vec3(radius_bottom * cs, -hy, radius_bottom * sn), color, bot_n,
                fm.vec2(0.5 + 0.5 * cs, 0.5 + 0.5 * sn), bot_t) or >>
        }
        for col in 0:segments {
            mesh.triangle(center_idx, ring_start + col, ring_start + col + 1) or >>
        }
    }
    << mesh
}

pub fn cone_mesh_3d(radius f64, height f64, segments int, color int) MeshData3D {
    << cylinder_mesh_3d(0.0, radius, height, segments, color) or >>
}

// Y-axis capsule mesh (total height = cylinder_height + 2*radius) with outward CCW faces.
pub fn capsule_mesh_3d(radius f64, cylinder_height f64, segments int, hemi_rings int, color int) MeshData3D {
    if !fm.finite(radius) || radius <= 0.0 || radius > 1000000.0 ||
        !fm.finite(cylinder_height) || cylinder_height < 0.0 || cylinder_height > 1000000.0 ||
        segments < 3 || segments > 128 || hemi_rings < 1 || hemi_rings > 32 {
        >> errors.new("nexus mesh: invalid capsule parameters")
    }
    check_opaque_primitive_color(color) or >>
    $mesh := new_mesh_data_3d()
    half_cyl := cylinder_height * 0.5
    total_h := math.max(1e-6, cylinder_height + 2.0 * radius)
    total_rows := hemi_rings * 2 + 1

    for r in 0:(total_rows + 1) {
        $phi := 0.0
        $y_off := 0.0
        if r <= hemi_rings {
            phi = f64(r) / f64(hemi_rings) * (math.pi() * 0.5)
            y_off = half_cyl
        } else {
            br := r - (hemi_rings + 1)
            phi = (math.pi() * 0.5) + f64(br) / f64(hemi_rings) * (math.pi() * 0.5)
            y_off = -half_cyl
        }
        y := y_off + radius * math.cos(phi)
        v := 0.5 - (y / total_h)
        sin_p := math.sin(phi)
        cos_p := math.cos(phi)
        for col in 0:(segments + 1) {
            u := f64(col) / f64(segments)
            theta := u * 2.0 * math.pi()
            cs := math.cos(theta)
            sn := math.sin(theta)
            n := fm.vec3(sin_p * cs, cos_p, sin_p * sn).normalized() or >>
            t := fm.vec4(-sn, 0.0, cs, 1.0)
            p := fm.vec3(radius * sin_p * cs, y, radius * sin_p * sn)
            mesh.vertex_tangent(p, color, n, fm.vec2(u, v), t) or >>
        }
    }
    stride := segments + 1
    for r in 0:total_rows {
        for col in 0:segments {
            a := r * stride + col
            b := a + stride
            if r > 0 { mesh.triangle(a, a + 1, b) or >> }
            if r < total_rows - 1 { mesh.triangle(a + 1, b + 1, b) or >> }
        }
    }
    << mesh
}
