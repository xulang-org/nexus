@"github.com/xulang-org/nexus/resources/mesh"

fm #"github.com/xulang-org/nexus/foundation/math"
#errors
#math

pub struct MikkTSpaceOptions {
    pub weld_angle_deg f64
}

pub fn default_mikktspace_options() MikkTSpaceOptions {
    << MikkTSpaceOptions{weld_angle_deg: 60.0}
}

pub struct MikkTSpaceStats {
    pub original_vertices int
    pub final_vertices int
    pub split_vertices int
    pub mirrored_seams int
    pub degenerate_corners int
    pub triangles int
}

fn fallback_tangent_for_normal(normal fm.Vec3) fm.Vec3 {
    $axis := fm.vec3(1.0, 0.0, 0.0)
    if math.abs(normal.x) > 0.9 { axis = fm.vec3(0.0, 1.0, 0.0) }
    candidate := axis.sub(normal.scaled(normal.dot(axis)))
    if candidate.length() <= 0.000001 {
        alt := fm.vec3(0.0, 0.0, 1.0).sub(normal.scaled(normal.dot(fm.vec3(0.0, 0.0, 1.0))))
        if alt.length() <= 0.000001 { << fm.vec3(1.0, 0.0, 0.0) }
        << alt.normalized() or (e) { << fm.vec3(1.0, 0.0, 0.0) }
    }
    << candidate.normalized() or (e) { << fm.vec3(1.0, 0.0, 0.0) }
}

fn safe_norm(v fm.Vec3, fb fm.Vec3) fm.Vec3 {
    << v.normalized() or (e) { << fb }
}

fn orthogonalize_tangent(normal fm.Vec3, raw fm.Vec3) fm.Vec3 {
    projected := raw.sub(normal.scaled(normal.dot(raw)))
    if projected.length() <= 0.000000001 {
        << fallback_tangent_for_normal(normal)
    }
    << projected.normalized() or (e) { << fallback_tangent_for_normal(normal) }
}

fn corner_angle_safe(a fm.Vec3, b fm.Vec3, c fm.Vec3) f64 {
    ab := b.sub(a)
    ac := c.sub(a)
    if ab.length() <= 0.000000000001 || ac.length() <= 0.000000000001 { << 0.001 }
    first := ab.normalized() or (e) { << 0.001 }
    second := ac.normalized() or (e) { << 0.001 }
    angle := math.atan2(first.cross(second).length(), first.dot(second))
    if !fm.finite(angle) || angle <= 0.000001 { << 0.001 }
    << angle
}

pub fn (mesh $&MeshData3D) generate_mikktspace_tangents() MikkTSpaceStats {
    opts := default_mikktspace_options()
    << mesh.generate_mikktspace_tangents_with(&opts) or >>
}

// Generates corner-angle-weighted MikkTSpace-style tangents, automatically
// splitting vertices across mirrored UV handedness or sharp tangent seams.
pub fn (mesh $&MeshData3D) generate_mikktspace_tangents_with(opts &MikkTSpaceOptions) MikkTSpaceStats {
    if !fm.finite(opts.weld_angle_deg) || opts.weld_angle_deg < 0.0 || opts.weld_angle_deg > 180.0 {
        >> errors.new("nexus mesh: MikkTSpace weld_angle_deg must be in 0..180")
    }
    mesh.validate() or >>
    for vertex in mesh.vertices {
        if !vertex.has_uv || vertex.normal.dot(vertex.normal) == 0.0 {
            >> errors.new("nexus mesh: MikkTSpace tangent generation requires normals and UVs on every vertex")
        }
    }

    cos_threshold := math.cos(opts.weld_angle_deg * 0.017453292519943295)
    orig_count := mesh.vertices.len
    tri_count := mesh.triangle_count()

    $corner_t := []fm.Vec3{}
    $corner_side := []int{}
    $corner_angle := []f64{}
    $corner_vertex := []int{}
    $degenerate_corners := 0

    for t in 0:tri_count {
        ia := mesh.indices[t * 3]
        ib := mesh.indices[t * 3 + 1]
        ic := mesh.indices[t * 3 + 2]
        va := &mesh.vertices[ia]
        vb := &mesh.vertices[ib]
        vc := &mesh.vertices[ic]

        e1 := vb.position.sub(va.position)
        e2 := vc.position.sub(va.position)
        u1 := vb.uv.x - va.uv.x
        v1 := vb.uv.y - va.uv.y
        u2 := vc.uv.x - va.uv.x
        v2 := vc.uv.y - va.uv.y
        det := u1 * v2 - v1 * u2

        $face_valid := false
        $face_t := fm.vec3(1.0, 0.0, 0.0)
        $face_b := fm.vec3(0.0, 1.0, 0.0)
        if math.abs(det) > 0.000000000001 {
            $det_sign := 1.0
            if det < 0.0 { det_sign = -1.0 }
            raw_t := e1.scaled(v2).sub(e2.scaled(v1)).scaled(det_sign)
            raw_b := e2.scaled(u1).sub(e1.scaled(u2)).scaled(det_sign)
            if raw_t.length() > 0.000000000001 && raw_b.length() > 0.000000000001 {
                face_t = safe_norm(raw_t, fm.vec3(1.0, 0.0, 0.0))
                face_b = safe_norm(raw_b, fm.vec3(0.0, 1.0, 0.0))
                face_valid = true
            }
        }

        ids := [ia, ib, ic]
        $tri_tangents := []fm.Vec3{}
        $tri_sides := []int{}
        $tri_angles := []f64{}
        $pos_votes := 0
        $neg_votes := 0

        for c in 0:3 {
            id := ids[c]
            nb := mesh.vertices[ids[(c + 1) % 3]].position
            nc := mesh.vertices[ids[(c + 2) % 3]].position
            vtx := &mesh.vertices[id]
            ang := corner_angle_safe(vtx.position, nb, nc)
            tri_angles.push(ang)

            if !face_valid {
                degenerate_corners += 1
                tri_tangents.push(fallback_tangent_for_normal(vtx.normal))
                tri_sides.push(0)
                pos_votes += 1
                ->
            }

            proj := face_t.sub(vtx.normal.scaled(vtx.normal.dot(face_t)))
            if proj.length() <= 0.0000000001 {
                degenerate_corners += 1
                tri_tangents.push(fallback_tangent_for_normal(vtx.normal))
                tri_sides.push(0)
                pos_votes += 1
                ->
            }

            tan := safe_norm(proj, fallback_tangent_for_normal(vtx.normal))
            dir := vtx.normal.cross(tan).dot(face_b)
            $side := 0
            if dir < 0.0 {
                side = 1
                neg_votes += 1
            } else {
                pos_votes += 1
            }
            if math.abs(dir) <= 0.0000000001 { degenerate_corners += 1 }
            tri_tangents.push(tan)
            tri_sides.push(side)
        }

        $canonical_side := 0
        if neg_votes > pos_votes { canonical_side = 1 }
        for c in 0:3 {
            corner_vertex.push(ids[c])
            corner_t.push(tri_tangents[c])
            corner_side.push(canonical_side)
            corner_angle.push(tri_angles[c])
        }
    }

    // Group corners per original vertex using linked chains by (handedness side, weld angle).
    $vert_head := []int{}
    $vert_has_pos := []bool{}
    $vert_has_neg := []bool{}
    for _i in 0:orig_count {
        vert_head.push(-1)
        vert_has_pos.push(false)
        vert_has_neg.push(false)
    }

    $group_orig := []int{}
    $group_side := []int{}
    $group_seed := []fm.Vec3{}
    $group_sum := []fm.Vec3{}
    $group_next := []int{}
    $corner_group := []int{}

    for c in 0:corner_vertex.len {
        ov := corner_vertex[c]
        side := corner_side[c]
        tan := corner_t[c]
        ang := corner_angle[c]
        if side == 0 { vert_has_pos[ov] = true } else { vert_has_neg[ov] = true }

        $matched := -1
        $g := vert_head[ov]
        while g >= 0 {
            if group_side[g] == side && group_seed[g].dot(tan) >= cos_threshold {
                candidate_sum := group_sum[g].add(tan.scaled(ang))
                if candidate_sum.length() > 0.000001 {
                    group_sum[g] = candidate_sum
                    matched = g
                    <-
                }
            }
            g = group_next[g]
        }

        if matched < 0 {
            matched = group_orig.len
            group_orig.push(ov)
            group_side.push(side)
            group_seed.push(tan)
            group_sum.push(tan.scaled(ang))
            group_next.push(vert_head[ov])
            vert_head[ov] = matched
        }
        corner_group.push(matched)
    }

    $mirrored_seams := 0
    for ov in 0:orig_count {
        if vert_has_pos[ov] && vert_has_neg[ov] { mirrored_seams += 1 }
        if vert_head[ov] < 0 {
            fb := fallback_tangent_for_normal(mesh.vertices[ov].normal)
            ng := group_orig.len
            group_orig.push(ov)
            group_side.push(0)
            group_seed.push(fb)
            group_sum.push(fb)
            group_next.push(-1)
            vert_head[ov] = ng
        }
    }

    // Place the first group of each original vertex at index 0..orig_count-1,
    // and append extra seam-split groups afterwards so unsplit meshes keep IDs.
    $group_to_out := []int{}
    for _g in 0:group_orig.len { group_to_out.push(-1) }
    $out_vertices := []Vertex3D{}
    for _i in 0:orig_count {
        out_vertices.push(Vertex3D{
            position: fm.vec3(0.0, 0.0, 0.0), color: 0, normal: fm.vec3(0.0, 0.0, 0.0),
            uv: fm.vec2(0.0, 0.0), tangent: fm.vec4(0.0, 0.0, 0.0, 0.0),
            has_uv: false, has_tangent: false
        })
    }

    $primary_assigned := []bool{}
    for _i in 0:orig_count { primary_assigned.push(false) }

    for g in 0:group_orig.len {
        ov := group_orig[g]
        src := &mesh.vertices[ov]
        $raw_avg := group_sum[g]
        if raw_avg.length() <= 0.000000001 { raw_avg = group_seed[g] }
        ortho := orthogonalize_tangent(src.normal, raw_avg)
        $w := 1.0
        if group_side[g] == 1 { w = -1.0 }
        new_v := Vertex3D{
            position: src.position,
            color: src.color,
            normal: src.normal,
            uv: src.uv,
            tangent: fm.vec4(ortho.x, ortho.y, ortho.z, w),
            has_uv: true,
            has_tangent: true
        }
        if !primary_assigned[ov] {
            primary_assigned[ov] = true
            out_vertices[ov] = new_v
            group_to_out[g] = ov
        } else {
            if out_vertices.len >= MAX_VERTICES {
                >> errors.new("nexus mesh: MikkTSpace seam split exceeds vertex limit")
            }
            group_to_out[g] = out_vertices.len
            out_vertices.push(new_v)
        }
    }

    $out_indices := []int{}
    for c in 0:corner_group.len {
        out_indices.push(group_to_out[corner_group[c]])
    }

    $candidate := MeshData3D{vertices: out_vertices, indices: out_indices}
    candidate.validate() or >>
    $next_verts := []Vertex3D{}
    $next_idx := []int{}
    for i in 0:candidate.vertices.len {
        v := &candidate.vertices[i]
        next_verts.push(Vertex3D{
            position: v.position,
            color: v.color,
            normal: v.normal,
            uv: v.uv,
            tangent: v.tangent,
            has_uv: v.has_uv,
            has_tangent: v.has_tangent
        })
    }
    for idx in candidate.indices {
        next_idx.push(idx)
    }
    mesh.vertices = next_verts
    mesh.indices = next_idx

    << MikkTSpaceStats{
        original_vertices: orig_count,
        final_vertices: mesh.vertices.len,
        split_vertices: mesh.vertices.len - orig_count,
        mirrored_seams: mirrored_seams,
        degenerate_corners: degenerate_corners,
        triangles: tri_count
    }
}
