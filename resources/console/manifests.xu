        save_quota_mb: cfg.save_quota_mb,
        supports_quick_resume: cfg.supports_quick_resume,
        supports_smart_delivery: cfg.supports_smart_delivery,
        supports_crossplay: cfg.supports_crossplay,
        achievement_ids: achs,
        dlc_store_ids: dlcs
    }
}

pub fn default_ps_config() PlayStationAppConfig {
    << PlayStationAppConfig{
        title_id: "PPSA01234",
        content_id: "UP9000-PPSA01234_00-NEXUSGAME0000001",
        app_version: "01.000.000",
        master_version: "01.00",
        target_generation: 5,
        display_name: "Nexus Sample Title",
        save_quota_mb: 128,
        supports_crossplay: true,
        supports_dualsense_haptics: true,
        supports_adaptive_triggers: true,
        supports_activities: true,
        trophies: []PsTrophyDef{},
        activities: []PsActivityDef{},
        entitlement_labels: []string{}
    }
}

pub fn (cfg &PlayStationAppConfig) clone() PlayStationAppConfig {
    $ts := []PsTrophyDef{}
    for i in 0:cfg.trophies.len {
        t := &cfg.trophies[i]
        ts.push(PsTrophyDef{
            trophy_id: t.trophy_id,
            grade: t.grade,
            name: t.name + "",
            is_progress: t.is_progress,
            target_value: t.target_value,
            hidden: t.hidden
        })
    }
    $acts := []PsActivityDef{}
    for i in 0:cfg.activities.len {
        a := &cfg.activities[i]
        acts.push(PsActivityDef{
            activity_id: a.activity_id + "",
            name: a.name + "",
            category: a.category + ""
        })
    }
    $ents := []string{}
    for i in 0:cfg.entitlement_labels.len { ents.push(cfg.entitlement_labels[i] + "") }
    << PlayStationAppConfig{
        title_id: cfg.title_id + "",
        content_id: cfg.content_id + "",
        app_version: cfg.app_version + "",
        master_version: cfg.master_version + "",
        target_generation: cfg.target_generation,
        display_name: cfg.display_name + "",
        save_quota_mb: cfg.save_quota_mb,
        supports_crossplay: cfg.supports_crossplay,
        supports_dualsense_haptics: cfg.supports_dualsense_haptics,
        supports_adaptive_triggers: cfg.supports_adaptive_triggers,
        supports_activities: cfg.supports_activities,
        trophies: ts,
        activities: acts,
        entitlement_labels: ents
    }
}

fn is_hex(b int) bool {
    << (b >= 48 && b <= 57) || (b >= 65 && b <= 70) || (b >= 97 && b <= 102)
}

fn is_alnum(b int) bool {
    << (b >= 48 && b <= 57) || (b >= 65 && b <= 90) || (b >= 97 && b <= 122)
}

fn check_no_ctrl(s &string, label string) int {
    lbl := label + ""
    if s.len == 0 || s.len > 256 {
        >> errors.new("nexus console: invalid " + lbl + " length")
    }
    for i in 0:s.len {
        b := s[i] & 255
        if b < 32 || b == 127 {
            >> errors.new("nexus console: control char forbidden in " + lbl)
        }
    }
    << 0
}

fn valid_ascii_id(s &string, label string) int {
    lbl := label + ""
    check_no_ctrl(s, lbl + "") >>>
    for i in 0:s.len {
        b := s[i] & 255
        if !is_alnum(b) && b != 95 && b != 45 && b != 46 {
            >> errors.new("nexus console: invalid character in " + lbl)
        }
    }
    << 0
}

fn valid_uuid(s &string) bool {
    if s.len != 36 { << false }
    for i in 0:36 {
        b := s[i] & 255
        if i == 8 || i == 13 || i == 18 || i == 23 {
            if b != 45 { << false }
        } else if !is_hex(b) {
            << false
        }
    }
    << true
}

pub fn validate_xbox_config(cfg &XboxAppConfig) int {
    if cfg.store_id.len != 12 {
        >> errors.new("nexus xbox: store_id must be 12 alphanumeric characters")
    }
    for i in 0:12 {
        if !is_alnum(cfg.store_id[i] & 255) {
            >> errors.new("nexus xbox: store_id must be alphanumeric")
        }
    }
    if cfg.title_id_hex.len != 8 {
        >> errors.new("nexus xbox: title_id_hex must be 8 hex digits")
    }
    for i in 0:8 {
        if !is_hex(cfg.title_id_hex[i] & 255) {
            >> errors.new("nexus xbox: title_id_hex must be hexadecimal")
        }
    }
    if !valid_uuid(&cfg.scid) {
        >> errors.new("nexus xbox: scid must be a valid 36-char UUID")
    }
    check_no_ctrl(&cfg.identity_name, "identity_name") >>>
    check_no_ctrl(&cfg.publisher, "publisher") >>>
    check_no_ctrl(&cfg.display_name, "display_name") >>>
    valid_ascii_id(&cfg.version, "version") >>>
    check_no_ctrl(&cfg.executable, "executable") >>>
    if strings.contains(&cfg.executable, "..") || strings.contains(&cfg.executable, "/") || strings.contains(&cfg.executable, "\\") {
        >> errors.new("nexus xbox: executable must be a filename")
    }
    valid_ascii_id(&cfg.msa_app_id, "msa_app_id") >>>
    if cfg.save_quota_mb < 1 || cfg.save_quota_mb > 256 {
        >> errors.new("nexus xbox: save_quota_mb must be 1..256 (GDK per-user cap)")
    }
    for i in 0:cfg.achievement_ids.len {
        aid := cfg.achievement_ids[i] + ""
        valid_ascii_id(&aid, "achievement_id") >>>
        for j in 0:i {
            if cfg.achievement_ids[j] == aid {
                >> errors.new("nexus xbox: duplicate achievement_id: " + aid)
            }
        }
    }
    for i in 0:cfg.dlc_store_ids.len {
        did := cfg.dlc_store_ids[i] + ""
        if did.len != 12 {
            >> errors.new("nexus xbox: dlc store_id must be 12 chars: " + did)
        }
        for k in 0:12 {
            if !is_alnum(did[k] & 255) { >> errors.new("nexus xbox: illegal char in dlc store_id") }
        }
    }
    << 0
}

pub fn validate_ps_config(cfg &PlayStationAppConfig) int {
    if cfg.target_generation != 4 && cfg.target_generation != 5 {
        >> errors.new("nexus ps: target_generation must be 4 (PS4) or 5 (PS5)")
    }
    if cfg.title_id.len != 9 {
        >> errors.new("nexus ps: title_id must be 9 chars (e.g. PPSA01234)")
    }
    for i in 0:4 {
        b := cfg.title_id[i] & 255
        if b < 65 || b > 90 { >> errors.new("nexus ps: title_id prefix must be 4 uppercase letters") }
    }
    for i in 4:9 {
        b := cfg.title_id[i] & 255
        if b < 48 || b > 57 { >> errors.new("nexus ps: title_id suffix must be 5 digits") }
    }
    if cfg.content_id.len != 36 || !strings.contains(&cfg.content_id, cfg.title_id + "") {
        >> errors.new("nexus ps: content_id must be 36 chars containing title_id")
    }
    check_no_ctrl(&cfg.content_id, "content_id") >>>
    valid_ascii_id(&cfg.app_version, "app_version") >>>
    valid_ascii_id(&cfg.master_version, "master_version") >>>
    check_no_ctrl(&cfg.display_name, "display_name") >>>
    if cfg.save_quota_mb < 1 || cfg.save_quota_mb > 1024 {
        >> errors.new("nexus ps: save_quota_mb must be 1..1024")
    }
    $plat_count := 0
    for i in 0:cfg.trophies.len {
        t := &cfg.trophies[i]
        if t.trophy_id < 0 || t.trophy_id > 127 {
            >> errors.new("nexus ps: trophy_id must be 0..127")
        }
        if t.grade < TROPHY_BRONZE || t.grade > TROPHY_PLATINUM {
            >> errors.new("nexus ps: invalid trophy grade")
        }
        if t.grade == TROPHY_PLATINUM { plat_count += 1 }
        if t.is_progress && t.target_value < 1 {
            >> errors.new("nexus ps: progress trophy requires positive target_value")
        }
        tname := t.name + ""
        check_no_ctrl(&tname, "trophy name") >>>
        for j in 0:i {
            if cfg.trophies[j].trophy_id == t.trophy_id {
                >> errors.new("nexus ps: duplicate trophy_id")
            }
        }
    }
    if plat_count > 1 {
        >> errors.new("nexus ps: at most 1 Platinum trophy allowed")
    }
    for i in 0:cfg.activities.len {
        a := &cfg.activities[i]
        aid := a.activity_id + ""
        aname := a.name + ""
        valid_ascii_id(&aid, "activity_id") >>>
        check_no_ctrl(&aname, "activity name") >>>
        if a.category != "progress" && a.category != "open_ended" && a.category != "competitive" {
            >> errors.new("nexus ps: invalid activity category: " + a.category)
        }
        for j in 0:i {
            if cfg.activities[j].activity_id == aid {
                >> errors.new("nexus ps: duplicate activity_id: " + aid)
            }
        }
    }
    for i in 0:cfg.entitlement_labels.len {
        el := cfg.entitlement_labels[i] + ""
        valid_ascii_id(&el, "entitlement_label") >>>
    }
    << 0
}

fn xml_escape(s &string) string {
    $b := strings.new_byte_builder(s.len + 16)
    for i in 0:s.len {
        c := s[i] & 255
        if c == 38 { b.write_str("&amp;") }
        else if c == 60 { b.write_str("&lt;") }
        else if c == 62 { b.write_str("&gt;") }
        else if c == 34 { b.write_str("&quot;") }
        else if c == 39 { b.write_str("&apos;") }
        else { b.write_byte(c) }
    }
    << b.to_string()
}

pub fn generate_microsoft_game_config_xml(cfg &XboxAppConfig) string {
    validate_xbox_config(cfg) >>>
    $qr := "false"
    if cfg.supports_quick_resume { qr = "true" }
    $b := strings.new_byte_builder(1024)
    b.write_str("<?xml version=\"1.0\" encoding=\"utf-8\"?>\n")
    b.write_str("<Game configVersion=\"1\">\n")
    b.write_str("  <Identity Name=\"" + xml_escape(&cfg.identity_name) +
        "\" Publisher=\"" + xml_escape(&cfg.publisher) +
        "\" Version=\"" + xml_escape(&cfg.version) + "\" />\n")
    b.write_str("  <ExecutableList>\n")
    b.write_str("    <Executable Name=\"" + xml_escape(&cfg.executable) + "\" TargetDeviceFamily=\"Xbox\" />\n")
    b.write_str("  </ExecutableList>\n")
    b.write_str("  <TitleId>" + xml_escape(&cfg.title_id_hex) + "</TitleId>\n")
    b.write_str("  <MSAAppId>" + xml_escape(&cfg.msa_app_id) + "</MSAAppId>\n")
    b.write_str("  <StoreId>" + xml_escape(&cfg.store_id) + "</StoreId>\n")
    b.write_str("  <ShellVisuals DefaultDisplayName=\"" + xml_escape(&cfg.display_name) + "\" />\n")
    b.write_str("  <ExtendedAttributeList>\n")
    b.write_str("    <ExtendedAttribute Name=\"Scid\" Value=\"" + xml_escape(&cfg.scid) + "\" />\n")
    b.write_str("  </ExtendedAttributeList>\n")
    b.write_str("  <AdvancedUserModel>true</AdvancedUserModel>\n")
    b.write_str("  <ModFolder Name=\"QuickResume\" Value=\"" + qr + "\" />\n")
    b.write_str("</Game>\n")
    << b.to_string()
}

pub fn generate_xbox_layout_xml(cfg &XboxAppConfig, files &[]string) string {
    validate_xbox_config(cfg) >>>
    $b := strings.new_byte_builder(512)
    b.write_str("<Layout>\n")
    b.write_str("  <Chunk Id=\"1000\" Marker=\"Launch\">\n")
    for i in 0:files.len {
        f := files[i] + ""
        check_no_ctrl(&f, "layout file") >>>
        if strings.contains(&f, "..") {
            >> errors.new("nexus xbox: path traversal forbidden in layout.xml")
        }
        b.write_str("    <FileGroup SourcePath=\"" + xml_escape(&f) + "\" Include=\"*\" />\n")
    }
    b.write_str("  </Chunk>\n</Layout>\n")
    << b.to_string()
}

fn bool_json(v bool) string {
    if v { << "true" }
    << "false"
}

pub fn generate_ps_param_json(cfg &PlayStationAppConfig) string {
    validate_ps_config(cfg) >>>
    tid := cfg.title_id + ""
    cid := cfg.content_id + ""
    av := cfg.app_version + ""
    mv := cfg.master_version + ""
    dn := cfg.display_name + ""
    $attr := 0
    if cfg.supports_dualsense_haptics { attr = attr + 1 }
    if cfg.supports_adaptive_triggers { attr = attr + 2 }
    if cfg.supports_crossplay { attr = attr + 8 }
    $b := strings.new_byte_builder(512)
    b.write_str("{\n")
    b.write_str("  \"titleId\": " + json.quote(&tid) + ",\n")
    b.write_str("  \"contentId\": " + json.quote(&cid) + ",\n")
    b.write_str("  \"contentVersion\": " + json.quote(&av) + ",\n")
    b.write_str("  \"masterVersion\": " + json.quote(&mv) + ",\n")
    b.write_str("  \"attribute\": " + str(attr) + ",\n")
    b.write_str("  \"localizedParameters\": {\n")
    b.write_str("    \"defaultLanguage\": \"en-US\",\n")
    b.write_str("    \"en-US\": {\"titleName\": " + json.quote(&dn) + "}\n")
    b.write_str("  }\n}\n")
    << b.to_string()
}

pub fn generate_ps_uds_schema_json(cfg &PlayStationAppConfig) string {
    validate_ps_config(cfg) >>>
    tid := cfg.title_id + ""
    $b := strings.new_byte_builder(512)
    b.write_str("{\n  \"titleId\": " + json.quote(&tid) + ",\n  \"trophies\": [")
    for i in 0:cfg.trophies.len {
        if i > 0 { b.write_str(", ") }
        t := &cfg.trophies[i]
        tn := t.name + ""
        b.write_str("{\"id\": " + str(t.trophy_id) +
            ", \"grade\": " + str(t.grade) +
            ", \"name\": " + json.quote(&tn) +
            ", \"progress\": " + bool_json(t.is_progress) +
            ", \"target\": " + str(t.target_value) +
            ", \"hidden\": " + bool_json(t.hidden) + "}")
    }
    b.write_str("],\n  \"activities\": [")
    for i in 0:cfg.activities.len {
        if i > 0 { b.write_str(", ") }
        a := &cfg.activities[i]
        aid := a.activity_id + ""
        an := a.name + ""
        ac := a.category + ""
        b.write_str("{\"id\": " + json.quote(&aid) +
            ", \"name\": " + json.quote(&an) +
            ", \"category\": " + json.quote(&ac) + "}")
    }
    b.write_str("]\n}\n")
    << b.to_string()
}

pub fn generate_ps_gp5_xml(cfg &PlayStationAppConfig, files &[]string) string {
    validate_ps_config(cfg) >>>
    $b := strings.new_byte_builder(512)
    b.write_str("<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>\n")
    b.write_str("<psproject fmt=\"gp5\" version=\"1000\">\n")
    b.write_str("  <volume>\n    <package content_id=\"" + xml_escape(&cfg.content_id) + "\" />\n  </volume>\n")
    b.write_str("  <files img_no=\"0\">\n")
    for i in 0:files.len {
        f := files[i] + ""
        check_no_ctrl(&f, "gp5 file") >>>
        if strings.contains(&f, "..") {
            >> errors.new("nexus ps: path traversal forbidden in .gp5")
        }
        esc := xml_escape(&f)
        b.write_str("    <file targ_path=\"" + esc + "\" orig_path=\"content/" + esc + "\" />\n")
    }
    b.write_str("  </files>\n</psproject>\n")
    << b.to_string()
}

pub fn encode_xbox_config_json(cfg &XboxAppConfig) string {
    validate_xbox_config(cfg) >>>
    $b := strings.new_byte_builder(1024)
    fmt_s := XBOX_CONFIG_FORMAT + ""
    s_id := cfg.store_id + ""
    t_id := cfg.title_id_hex + ""
    sc_s := cfg.scid + ""
    id_s := cfg.identity_name + ""
    pub_s := cfg.publisher + ""
    dn_s := cfg.display_name + ""
    ver_s := cfg.version + ""
    ex_s := cfg.executable + ""
    msa_s := cfg.msa_app_id + ""
    b.write_str("{\n")
    b.write_str("  \"format\": " + json.quote(&fmt_s) + ",\n")
    b.write_str("  \"version\": " + str(CONFIG_VERSION) + ",\n")
    b.write_str("  \"store_id\": " + json.quote(&s_id) + ",\n")
    b.write_str("  \"title_id_hex\": " + json.quote(&t_id) + ",\n")
    b.write_str("  \"scid\": " + json.quote(&sc_s) + ",\n")
    b.write_str("  \"identity_name\": " + json.quote(&id_s) + ",\n")
    b.write_str("  \"publisher\": " + json.quote(&pub_s) + ",\n")
    b.write_str("  \"display_name\": " + json.quote(&dn_s) + ",\n")
    b.write_str("  \"app_version\": " + json.quote(&ver_s) + ",\n")
    b.write_str("  \"executable\": " + json.quote(&ex_s) + ",\n")
    b.write_str("  \"msa_app_id\": " + json.quote(&msa_s) + ",\n")
    b.write_str("  \"save_quota_mb\": " + str(cfg.save_quota_mb) + ",\n")
    b.write_str("  \"supports_quick_resume\": " + bool_json(cfg.supports_quick_resume) + ",\n")
    b.write_str("  \"supports_smart_delivery\": " + bool_json(cfg.supports_smart_delivery) + ",\n")
    b.write_str("  \"supports_crossplay\": " + bool_json(cfg.supports_crossplay) + ",\n")
    b.write_str("  \"achievement_ids\": [")
    for i in 0:cfg.achievement_ids.len {
        if i > 0 { b.write_str(", ") }
        aid := cfg.achievement_ids[i] + ""
        b.write_str(json.quote(&aid))
    }
    b.write_str("],\n  \"dlc_store_ids\": [")
    for i in 0:cfg.dlc_store_ids.len {
        if i > 0 { b.write_str(", ") }
        did := cfg.dlc_store_ids[i] + ""
        b.write_str(json.quote(&did))
    }
    b.write_str("]\n}\n")
    << b.to_string()
}

pub fn decode_xbox_config_json(raw &string) XboxAppConfig {
    if raw.len < 2 || raw.len > 1048576 { >> errors.new("nexus xbox: JSON size out of bounds") }
    doc := json.parse_max(raw, 1048576)
    if !doc.ok() { >> errors.new("nexus xbox JSON: " + doc.error()) }
    root := doc.root()
    if !doc.is_dict(root) { >> errors.new("nexus xbox: root must be object") }
    if !doc.has(root, "format") || !doc.has(root, "version") {
        >> errors.new("nexus xbox: missing format/version")
    }
    if (doc.as_string(doc.get(root, "format")) >>>) != XBOX_CONFIG_FORMAT ||
       (doc.as_int(doc.get(root, "version")) >>>) != CONFIG_VERSION {
        >> errors.new("nexus xbox: unsupported config format/version")
    }
    $cfg := default_xbox_config()
    if doc.has(root, "store_id") { cfg.store_id = doc.as_string(doc.get(root, "store_id")) >>> }
    if doc.has(root, "title_id_hex") { cfg.title_id_hex = doc.as_string(doc.get(root, "title_id_hex")) >>> }
    if doc.has(root, "scid") { cfg.scid = doc.as_string(doc.get(root, "scid")) >>> }
    if doc.has(root, "identity_name") { cfg.identity_name = doc.as_string(doc.get(root, "identity_name")) >>> }
    if doc.has(root, "publisher") { cfg.publisher = doc.as_string(doc.get(root, "publisher")) >>> }
    if doc.has(root, "display_name") { cfg.display_name = doc.as_string(doc.get(root, "display_name")) >>> }
    if doc.has(root, "app_version") { cfg.version = doc.as_string(doc.get(root, "app_version")) >>> }
    if doc.has(root, "executable") { cfg.executable = doc.as_string(doc.get(root, "executable")) >>> }
    if doc.has(root, "msa_app_id") { cfg.msa_app_id = doc.as_string(doc.get(root, "msa_app_id")) >>> }
    if doc.has(root, "save_quota_mb") { cfg.save_quota_mb = doc.as_int(doc.get(root, "save_quota_mb")) >>> }
    if doc.has(root, "supports_quick_resume") { cfg.supports_quick_resume = doc.as_bool(doc.get(root, "supports_quick_resume")) >>> }
    if doc.has(root, "supports_smart_delivery") { cfg.supports_smart_delivery = doc.as_bool(doc.get(root, "supports_smart_delivery")) >>> }
    if doc.has(root, "supports_crossplay") { cfg.supports_crossplay = doc.as_bool(doc.get(root, "supports_crossplay")) >>> }
    if doc.has(root, "achievement_ids") {
        al := doc.get(root, "achievement_ids")
        if !doc.is_list(al) { >> errors.new("nexus xbox: achievement_ids must be list") }
        for i in 0:doc.count(al) { cfg.achievement_ids.push(doc.as_string(doc.at(al, i)) >>>) }
    }
    if doc.has(root, "dlc_store_ids") {
        dl := doc.get(root, "dlc_store_ids")
        if !doc.is_list(dl) { >> errors.new("nexus xbox: dlc_store_ids must be list") }
        for i in 0:doc.count(dl) { cfg.dlc_store_ids.push(doc.as_string(doc.at(dl, i)) >>>) }
    }
    validate_xbox_config(&cfg) >>>
    << cfg
}

pub fn encode_ps_config_json(cfg &PlayStationAppConfig) string {
    validate_ps_config(cfg) >>>
    $b := strings.new_byte_builder(1024)
    fmt_s := PS_CONFIG_FORMAT + ""
    t_s := cfg.title_id + ""
    c_s := cfg.content_id + ""
    av_s := cfg.app_version + ""
    mv_s := cfg.master_version + ""
    dn_s := cfg.display_name + ""
    b.write_str("{\n")
    b.write_str("  \"format\": " + json.quote(&fmt_s) + ",\n")
    b.write_str("  \"version\": " + str(CONFIG_VERSION) + ",\n")
    b.write_str("  \"title_id\": " + json.quote(&t_s) + ",\n")
    b.write_str("  \"content_id\": " + json.quote(&c_s) + ",\n")
    b.write_str("  \"app_version\": " + json.quote(&av_s) + ",\n")
    b.write_str("  \"master_version\": " + json.quote(&mv_s) + ",\n")
    b.write_str("  \"target_generation\": " + str(cfg.target_generation) + ",\n")
    b.write_str("  \"display_name\": " + json.quote(&dn_s) + ",\n")
    b.write_str("  \"save_quota_mb\": " + str(cfg.save_quota_mb) + ",\n")
    b.write_str("  \"supports_crossplay\": " + bool_json(cfg.supports_crossplay) + ",\n")
    b.write_str("  \"supports_dualsense_haptics\": " + bool_json(cfg.supports_dualsense_haptics) + ",\n")
    b.write_str("  \"supports_adaptive_triggers\": " + bool_json(cfg.supports_adaptive_triggers) + ",\n")
    b.write_str("  \"supports_activities\": " + bool_json(cfg.supports_activities) + ",\n")
    b.write_str("  \"trophies\": [")
    for i in 0:cfg.trophies.len {
        if i > 0 { b.write_str(", ") }
        t := &cfg.trophies[i]
        tn := t.name + ""
        b.write_str("{\"trophy_id\": " + str(t.trophy_id) +
            ", \"grade\": " + str(t.grade) +
            ", \"name\": " + json.quote(&tn) +
            ", \"is_progress\": " + bool_json(t.is_progress) +
            ", \"target_value\": " + str(t.target_value) +
            ", \"hidden\": " + bool_json(t.hidden) + "}")
    }
    b.write_str("],\n  \"activities\": [")
    for i in 0:cfg.activities.len {
        if i > 0 { b.write_str(", ") }
        a := &cfg.activities[i]
        aid := a.activity_id + ""
        an := a.name + ""
        ac := a.category + ""
        b.write_str("{\"activity_id\": " + json.quote(&aid) +
            ", \"name\": " + json.quote(&an) +
            ", \"category\": " + json.quote(&ac) + "}")
    }
    b.write_str("],\n  \"entitlement_labels\": [")
    for i in 0:cfg.entitlement_labels.len {
        if i > 0 { b.write_str(", ") }
        el := cfg.entitlement_labels[i] + ""
        b.write_str(json.quote(&el))
    }
    b.write_str("]\n}\n")
    << b.to_string()
}

pub fn decode_ps_config_json(raw &string) PlayStationAppConfig {
    if raw.len < 2 || raw.len > 1048576 { >> errors.new("nexus ps: JSON size out of bounds") }
    doc := json.parse_max(raw, 1048576)
    if !doc.ok() { >> errors.new("nexus ps JSON: " + doc.error()) }
    root := doc.root()
    if !doc.is_dict(root) { >> errors.new("nexus ps: root must be object") }
    if !doc.has(root, "format") || !doc.has(root, "version") {
        >> errors.new("nexus ps: missing format/version")
    }
    if (doc.as_string(doc.get(root, "format")) >>>) != PS_CONFIG_FORMAT ||
       (doc.as_int(doc.get(root, "version")) >>>) != CONFIG_VERSION {
        >> errors.new("nexus ps: unsupported config format/version")
    }
    $cfg := default_ps_config()
    if doc.has(root, "title_id") { cfg.title_id = doc.as_string(doc.get(root, "title_id")) >>> }
    if doc.has(root, "content_id") { cfg.content_id = doc.as_string(doc.get(root, "content_id")) >>> }
    if doc.has(root, "app_version") { cfg.app_version = doc.as_string(doc.get(root, "app_version")) >>> }
    if doc.has(root, "master_version") { cfg.master_version = doc.as_string(doc.get(root, "master_version")) >>> }
    if doc.has(root, "target_generation") { cfg.target_generation = doc.as_int(doc.get(root, "target_generation")) >>> }
    if doc.has(root, "display_name") { cfg.display_name = doc.as_string(doc.get(root, "display_name")) >>> }
    if doc.has(root, "save_quota_mb") { cfg.save_quota_mb = doc.as_int(doc.get(root, "save_quota_mb")) >>> }
    if doc.has(root, "supports_crossplay") { cfg.supports_crossplay = doc.as_bool(doc.get(root, "supports_crossplay")) >>> }
    if doc.has(root, "supports_dualsense_haptics") { cfg.supports_dualsense_haptics = doc.as_bool(doc.get(root, "supports_dualsense_haptics")) >>> }
    if doc.has(root, "supports_adaptive_triggers") { cfg.supports_adaptive_triggers = doc.as_bool(doc.get(root, "supports_adaptive_triggers")) >>> }
    if doc.has(root, "supports_activities") { cfg.supports_activities = doc.as_bool(doc.get(root, "supports_activities")) >>> }
    if doc.has(root, "trophies") {
        tl := doc.get(root, "trophies")
        if !doc.is_list(tl) { >> errors.new("nexus ps: trophies must be list") }
        for i in 0:doc.count(tl) {
            n := doc.at(tl, i)
            if !doc.is_dict(n) { >> errors.new("nexus ps: trophy entry must be object") }
            $ip := false
            if doc.has(n, "is_progress") { ip = doc.as_bool(doc.get(n, "is_progress")) >>> }
            $tv := 0
            if doc.has(n, "target_value") { tv = doc.as_int(doc.get(n, "target_value")) >>> }
            $hid := false
            if doc.has(n, "hidden") { hid = doc.as_bool(doc.get(n, "hidden")) >>> }
            cfg.trophies.push(PsTrophyDef{
                trophy_id: doc.as_int(doc.get(n, "trophy_id")) >>>,
                grade: doc.as_int(doc.get(n, "grade")) >>>,
                name: doc.as_string(doc.get(n, "name")) >>>,
                is_progress: ip,
                target_value: tv,
                hidden: hid
            })
        }
    }
    if doc.has(root, "activities") {
        al := doc.get(root, "activities")
        if !doc.is_list(al) { >> errors.new("nexus ps: activities must be list") }
        for i in 0:doc.count(al) {
            n := doc.at(al, i)
            if !doc.is_dict(n) { >> errors.new("nexus ps: activity entry must be object") }
            cfg.activities.push(PsActivityDef{
                activity_id: doc.as_string(doc.get(n, "activity_id")) >>>,
                name: doc.as_string(doc.get(n, "name")) >>>,
                category: doc.as_string(doc.get(n, "category")) >>>
            })
        }
    }
    if doc.has(root, "entitlement_labels") {
        el := doc.get(root, "entitlement_labels")
        if !doc.is_list(el) { >> errors.new("nexus ps: entitlement_labels must be list") }
        for i in 0:doc.count(el) { cfg.entitlement_labels.push(doc.as_string(doc.at(el, i)) >>>) }
    }
    validate_ps_config(&cfg) >>>
    << cfg
}

fn xbox_config_error(cfg &XboxAppConfig) string {
    _ := validate_xbox_config(cfg) >>> (err) { << err.msg() }
    << ""
}

fn ps_config_error(cfg &PlayStationAppConfig) string {
    _ := validate_ps_config(cfg) >>> (err) { << err.msg() }
    << ""
}

pub fn audit_xbox_certification(cfg &XboxAppConfig, safe_area_pct int) CertificationReport {
    $issues := []CertificationIssue{}
    $ok := true
    err_msg := xbox_config_error(cfg)
    if err_msg.len > 0 {
        ok = false
        issues.push(CertificationIssue{code: "XR-001", severity: "error", message: err_msg})
    }
    if safe_area_pct < 85 || safe_area_pct > 95 {
        ok = false
        issues.push(CertificationIssue{
            code: "XR-020",
            severity: "error",
            message: "TV HUD safe area must be within 85%..95% on Xbox consoles"
        })
    }
    if !cfg.supports_quick_resume {
        issues.push(CertificationIssue{
            code: "XR-076",
            severity: "warning",
            message: "Quick Resume disabled; Xbox Series X|S certification recommends resume support"
        })
    }
    << CertificationReport{platform: PLATFORM_XBOX_SERIES_X, passed: ok, issues: issues}
}

pub fn audit_ps_certification(cfg &PlayStationAppConfig, safe_area_pct int) CertificationReport {
    $issues := []CertificationIssue{}
    $ok := true
    err_msg := ps_config_error(cfg)
    if err_msg.len > 0 {
        ok = false
        issues.push(CertificationIssue{code: "TRC-001", severity: "error", message: err_msg})
    }
    if safe_area_pct < 85 || safe_area_pct > 95 {
        ok = false
        issues.push(CertificationIssue{
            code: "TRC-4030",
            severity: "error",
            message: "TV safe area must remain inside 85%..95% for PlayStation console builds"
        })
    }
    $has_plat := false
    for i in 0:cfg.trophies.len {
        if cfg.trophies[i].grade == TROPHY_PLATINUM { has_plat = true }
    }
    if has_plat && cfg.trophies.len < 2 {
        ok = false
        issues.push(CertificationIssue{
            code: "TRC-R4055",
            severity: "error",
            message: "Platinum trophy requires at least one unlockable Bronze/Silver/Gold trophy"
        })
    }
    << CertificationReport{platform: PLATFORM_PS5, passed: ok, issues: issues}
}

pub fn validate_switch_config(cfg &SwitchAppConfig) int {
    if cfg.application_id_hex.len != 16 {
        >> errors.new("nexus switch: application_id_hex must be 16 hexadecimal digits")
    }
    for i in 0:16 {
        if !is_hex(cfg.application_id_hex[i] & 255) {
            >> errors.new("nexus switch: application_id_hex must be hexadecimal")
        }
    }
    check_no_ctrl(&cfg.display_name, "display_name") >>>
    check_no_ctrl(&cfg.publisher, "publisher") >>>
    valid_ascii_id(&cfg.display_version, "display_version") >>>
    if cfg.release_version < 0 { >> errors.new("nexus switch: release_version must be >= 0") }
    if cfg.startup_user_account != "Required" &&
       cfg.startup_user_account != "RequiredWithNetworkServiceAccountAvailable" &&
       cfg.startup_user_account != "None" {
        >> errors.new("nexus switch: invalid startup_user_account")
    }
    if cfg.target_generation != 1 && cfg.target_generation != 2 {
        >> errors.new("nexus switch: target_generation must be 1 or 2")
    }
    if cfg.save_quota_mb < 1 || cfg.save_quota_mb > 512 {
        >> errors.new("nexus switch: save_quota_mb must be 1..512")
    }
    if cfg.save_journal_mb < 2 || cfg.save_journal_mb > 512 {
        >> errors.new("nexus switch: save_journal_mb must be 2..512")
    }
    if !cfg.supports_tv && !cfg.supports_handheld && !cfg.supports_tabletop {
        >> errors.new("nexus switch: at least one operation mode must be enabled")
    }
    for i in 0:cfg.aoc_indices.len {
        idx := cfg.aoc_indices[i]
        if idx < 1 || idx > 2000 { >> errors.new("nexus switch: AOC index must be 1..2000") }
        for j in 0:i {
            if cfg.aoc_indices[j] == idx { >> errors.new("nexus switch: duplicate AOC index") }
        }
    }
    << 0
}

fn int_to_hex_str(val int) string {
    if val <= 0 { << "0" }
    digits := "0123456789abcdef"
    $n := val
    $rev := []int{}
    while n > 0 {
        rev.push(n & 15)
        n = n >> 4
    }
    $b := strings.new_byte_builder(rev.len + 1)
    $i := rev.len - 1
    while i >= 0 {
        b.write_byte(digits[rev[i]] & 255)
        i = i - 1
    }
    << b.to_string()
}

pub fn generate_switch_nmeta_xml(cfg &SwitchAppConfig) string {
    validate_switch_config(cfg) >>>
    save_hex := "0x" + int_to_hex_str(cfg.save_quota_mb * 1048576)
    journal_hex := "0x" + int_to_hex_str(cfg.save_journal_mb * 1048576)
    $b := strings.new_byte_builder(1024)
    b.write_str("<?xml version=\"1.0\" encoding=\"utf-8\"?>\n")
    b.write_str("<NintendoSdkMeta>\n")
    b.write_str("  <Core>\n")
    b.write_str("    <Name>" + xml_escape(&cfg.display_name) + "</Name>\n")
    b.write_str("    <ApplicationId>0x" + xml_escape(&cfg.application_id_hex) + "</ApplicationId>\n")
    b.write_str("    <Is64BitInstruction>true</Is64BitInstruction>\n")
    b.write_str("    <ProcessAddressSpace>AddressSpace64Bit</ProcessAddressSpace>\n")
    b.write_str("  </Core>\n")
    b.write_str("  <Application>\n")
    b.write_str("    <Title>\n")
    b.write_str("      <Language>AmericanEnglish</Language>\n")
    b.write_str("      <Name>" + xml_escape(&cfg.display_name) + "</Name>\n")
    b.write_str("      <Publisher>" + xml_escape(&cfg.publisher) + "</Publisher>\n")
    b.write_str("    </Title>\n")
    b.write_str("    <StartupUserAccount>" + xml_escape(&cfg.startup_user_account) + "</StartupUserAccount>\n")
    b.write_str("    <UserAccountSaveDataSize>" + save_hex + "</UserAccountSaveDataSize>\n")
    b.write_str("    <UserAccountSaveDataJournalSize>" + journal_hex + "</UserAccountSaveDataJournalSize>\n")
    b.write_str("    <DisplayVersion>" + xml_escape(&cfg.display_version) + "</DisplayVersion>\n")
    b.write_str("    <ReleaseVersion>" + str(cfg.release_version) + "</ReleaseVersion>\n")
    b.write_str("  </Application>\n")
    b.write_str("</NintendoSdkMeta>\n")
    << b.to_string()
}

pub fn encode_switch_config_json(cfg &SwitchAppConfig) string {
    validate_switch_config(cfg) >>>
    $b := strings.new_byte_builder(1024)
    fmt_s := SWITCH_CONFIG_FORMAT + ""
    aid_s := cfg.application_id_hex + ""
    dn_s := cfg.display_name + ""
    pub_s := cfg.publisher + ""
    dv_s := cfg.display_version + ""
    sua_s := cfg.startup_user_account + ""
    b.write_str("{\n")
    b.write_str("  \"format\": " + json.quote(&fmt_s) + ",\n")
    b.write_str("  \"version\": " + str(CONFIG_VERSION) + ",\n")
    b.write_str("  \"application_id_hex\": " + json.quote(&aid_s) + ",\n")
    b.write_str("  \"display_name\": " + json.quote(&dn_s) + ",\n")
    b.write_str("  \"publisher\": " + json.quote(&pub_s) + ",\n")
    b.write_str("  \"display_version\": " + json.quote(&dv_s) + ",\n")
    b.write_str("  \"release_version\": " + str(cfg.release_version) + ",\n")
    b.write_str("  \"startup_user_account\": " + json.quote(&sua_s) + ",\n")
    b.write_str("  \"save_quota_mb\": " + str(cfg.save_quota_mb) + ",\n")
    b.write_str("  \"save_journal_mb\": " + str(cfg.save_journal_mb) + ",\n")
    b.write_str("  \"target_generation\": " + str(cfg.target_generation) + ",\n")
    b.write_str("  \"supports_tv\": " + bool_json(cfg.supports_tv) + ",\n")
    b.write_str("  \"supports_handheld\": " + bool_json(cfg.supports_handheld) + ",\n")
    b.write_str("  \"supports_tabletop\": " + bool_json(cfg.supports_tabletop) + ",\n")
    b.write_str("  \"supports_hd_rumble\": " + bool_json(cfg.supports_hd_rumble) + ",\n")
    b.write_str("  \"supports_touch_screen\": " + bool_json(cfg.supports_touch_screen) + ",\n")
    b.write_str("  \"supports_crossplay\": " + bool_json(cfg.supports_crossplay) + ",\n")
    b.write_str("  \"aoc_indices\": [")
    for i in 0:cfg.aoc_indices.len {
        if i > 0 { b.write_str(", ") }
        b.write_str(str(cfg.aoc_indices[i]))
    }
    b.write_str("]\n}\n")
    << b.to_string()
}

pub fn decode_switch_config_json(raw &string) SwitchAppConfig {
    if raw.len < 2 || raw.len > 1048576 { >> errors.new("nexus switch: JSON size out of bounds") }
    doc := json.parse_max(raw, 1048576)
    if !doc.ok() { >> errors.new("nexus switch JSON: " + doc.error()) }
    root := doc.root()
    if !doc.is_dict(root) { >> errors.new("nexus switch: root must be object") }
    if !doc.has(root, "format") || !doc.has(root, "version") {
        >> errors.new("nexus switch: missing format/version")
    }
    if (doc.as_string(doc.get(root, "format")) >>>) != SWITCH_CONFIG_FORMAT ||
       (doc.as_int(doc.get(root, "version")) >>>) != CONFIG_VERSION {
        >> errors.new("nexus switch: unsupported config format/version")
    }
    $cfg := default_switch_config()
    if doc.has(root, "application_id_hex") { cfg.application_id_hex = doc.as_string(doc.get(root, "application_id_hex")) >>> }
    if doc.has(root, "display_name") { cfg.display_name = doc.as_string(doc.get(root, "display_name")) >>> }
    if doc.has(root, "publisher") { cfg.publisher = doc.as_string(doc.get(root, "publisher")) >>> }
    if doc.has(root, "display_version") { cfg.display_version = doc.as_string(doc.get(root, "display_version")) >>> }
    if doc.has(root, "release_version") { cfg.release_version = doc.as_int(doc.get(root, "release_version")) >>> }
    if doc.has(root, "startup_user_account") { cfg.startup_user_account = doc.as_string(doc.get(root, "startup_user_account")) >>> }
    if doc.has(root, "save_quota_mb") { cfg.save_quota_mb = doc.as_int(doc.get(root, "save_quota_mb")) >>> }
    if doc.has(root, "save_journal_mb") { cfg.save_journal_mb = doc.as_int(doc.get(root, "save_journal_mb")) >>> }
    if doc.has(root, "target_generation") { cfg.target_generation = doc.as_int(doc.get(root, "target_generation")) >>> }
    if doc.has(root, "supports_tv") { cfg.supports_tv = doc.as_bool(doc.get(root, "supports_tv")) >>> }
    if doc.has(root, "supports_handheld") { cfg.supports_handheld = doc.as_bool(doc.get(root, "supports_handheld")) >>> }
    if doc.has(root, "supports_tabletop") { cfg.supports_tabletop = doc.as_bool(doc.get(root, "supports_tabletop")) >>> }
    if doc.has(root, "supports_hd_rumble") { cfg.supports_hd_rumble = doc.as_bool(doc.get(root, "supports_hd_rumble")) >>> }
    if doc.has(root, "supports_touch_screen") { cfg.supports_touch_screen = doc.as_bool(doc.get(root, "supports_touch_screen")) >>> }
    if doc.has(root, "supports_crossplay") { cfg.supports_crossplay = doc.as_bool(doc.get(root, "supports_crossplay")) >>> }
    if doc.has(root, "aoc_indices") {
        al := doc.get(root, "aoc_indices")
        if !doc.is_list(al) { >> errors.new("nexus switch: aoc_indices must be list") }
        for i in 0:doc.count(al) { cfg.aoc_indices.push(doc.as_int(doc.at(al, i)) >>>) }
    }
    validate_switch_config(&cfg) >>>
    << cfg
}

fn switch_config_error(cfg &SwitchAppConfig) string {
    _ := validate_switch_config(cfg) >>> (err) { << err.msg() }
    << ""
}

pub fn audit_switch_certification(cfg &SwitchAppConfig, docked_safe_pct int, handheld_safe_pct int) CertificationReport {
    $issues := []CertificationIssue{}
    $ok := true
    err_msg := switch_config_error(cfg)
    if err_msg.len > 0 {
        ok = false
        issues.push(CertificationIssue{code: "LOT-001", severity: "error", message: err_msg})
    }
    if cfg.save_journal_mb < 2 {
        ok = false
        issues.push(CertificationIssue{
            code: "LOT-010",
            severity: "error",
            message: "Switch save_journal_mb must be >= 2 MiB for atomic commit"
        })
    }
    if cfg.supports_tv && (docked_safe_pct < 85 || docked_safe_pct > 95) {
        ok = false
        issues.push(CertificationIssue{
            code: "LOT-020",
            severity: "error",
            message: "Docked TV HUD safe area must be inside 85%..95%"
        })
    }
    if cfg.supports_handheld && handheld_safe_pct != 100 {
        ok = false
        issues.push(CertificationIssue{
            code: "LOT-021",
            severity: "error",
            message: "Switch Handheld screen safe area must be 100%"
        })
    }
    $plat_out := PLATFORM_SWITCH
    if cfg.target_generation == 2 { plat_out = PLATFORM_SWITCH_2 }
    << CertificationReport{platform: plat_out, passed: ok, issues: issues}
}
