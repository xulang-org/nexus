    for i in 0:cfg.achievement_ids.len { achs.push(cfg.achievement_ids[i] + "") }
    $dlcs := []string{}
    for i in 0:cfg.dlc_store_ids.len { dlcs.push(cfg.dlc_store_ids[i] + "") }
    << XboxAppConfig{
        store_id: cfg.store_id + "",
        title_id_hex: cfg.title_id_hex + "",
        scid: cfg.scid + "",
        identity_name: cfg.identity_name + "",
        publisher: cfg.publisher + "",
