@"github.com/xulang-org/nexus/resources/console"

#encoding/json
#errors
#strings

pub const XBOX_CONFIG_FORMAT = "nexus.xbox"
pub const PS_CONFIG_FORMAT = "nexus.playstation"
pub const SWITCH_CONFIG_FORMAT = "nexus.switch"
pub const CONFIG_VERSION = 1

pub struct SwitchAppConfig {
    pub application_id_hex string
    pub display_name string
    pub publisher string
    pub display_version string
    pub release_version int
    pub startup_user_account string
    pub save_quota_mb int
    pub save_journal_mb int
    pub target_generation int
    pub supports_tv bool
    pub supports_handheld bool
    pub supports_tabletop bool
    pub supports_hd_rumble bool
    pub supports_touch_screen bool
    pub supports_crossplay bool
    pub aoc_indices []int
}

pub fn default_switch_config() SwitchAppConfig {
    << SwitchAppConfig{
        application_id_hex: "0100abcd12340000",
        display_name: "Nexus Sample Title",
        publisher: "NexusStudio",
        display_version: "1.0.0",
        release_version: 0,
        startup_user_account: "Required",
        save_quota_mb: 32,
        save_journal_mb: 16,
        target_generation: 1,
        supports_tv: true,
        supports_handheld: true,
        supports_tabletop: true,
        supports_hd_rumble: true,
        supports_touch_screen: true,
        supports_crossplay: true,
        aoc_indices: []int{}
    }
}

pub fn (cfg &SwitchAppConfig) clone() SwitchAppConfig {
    $aocs := []int{}
    for i in 0:cfg.aoc_indices.len { aocs.push(cfg.aoc_indices[i]) }
    << SwitchAppConfig{
        application_id_hex: cfg.application_id_hex + "",
        display_name: cfg.display_name + "",
        publisher: cfg.publisher + "",
        display_version: cfg.display_version + "",
        release_version: cfg.release_version,
        startup_user_account: cfg.startup_user_account + "",
        save_quota_mb: cfg.save_quota_mb,
        save_journal_mb: cfg.save_journal_mb,
        target_generation: cfg.target_generation,
        supports_tv: cfg.supports_tv,
        supports_handheld: cfg.supports_handheld,
        supports_tabletop: cfg.supports_tabletop,
        supports_hd_rumble: cfg.supports_hd_rumble,
        supports_touch_screen: cfg.supports_touch_screen,
        supports_crossplay: cfg.supports_crossplay,
        aoc_indices: aocs
    }
}

pub struct XboxAppConfig {
    pub store_id string
    pub title_id_hex string
    pub scid string
    pub identity_name string
    pub publisher string
    pub display_name string
    pub version string
    pub executable string
    pub msa_app_id string
    pub save_quota_mb int
    pub supports_quick_resume bool
    pub supports_smart_delivery bool
    pub supports_crossplay bool
    pub achievement_ids []string
    pub dlc_store_ids []string
}

pub struct PsTrophyDef {
    pub trophy_id int
    pub grade int
    pub name string
    pub is_progress bool
    pub target_value int
    pub hidden bool
}

pub struct PsActivityDef {
    pub activity_id string
    pub name string
    pub category string
}

pub struct PlayStationAppConfig {
    pub title_id string
    pub content_id string
    pub app_version string
    pub master_version string
    pub target_generation int
    pub display_name string
    pub save_quota_mb int
    pub supports_crossplay bool
    pub supports_dualsense_haptics bool
    pub supports_adaptive_triggers bool
    pub supports_activities bool
    pub trophies []PsTrophyDef
    pub activities []PsActivityDef
    pub entitlement_labels []string
}

pub struct CertificationIssue {
    pub code string
    pub severity string
    pub message string
}

pub struct CertificationReport {
    pub platform int
    pub passed bool
    pub issues []CertificationIssue
}

