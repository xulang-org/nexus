    pub dlcs []LogicalDlcMap
}

pub fn default_adaptive_off() AdaptiveTriggerEffect {
    << AdaptiveTriggerEffect{mode: TRIGGER_OFF, start_position: 0, end_position: 0, strength: 0, frequency: 0}
}

pub fn default_haptic_command() GamepadHapticCommand {
    << GamepadHapticCommand{
        low_freq_motor: 0.0,
        high_freq_motor: 0.0,
        left_trigger_rumble: 0.0,
        right_trigger_rumble: 0.0,
        left_adaptive: default_adaptive_off(),
        right_adaptive: default_adaptive_off(),
        lightbar_r: 0,
        lightbar_g: 90,
        lightbar_b: 255,
        hd_rumble_freq_low: 160.0,
        hd_rumble_freq_high: 320.0
    }
}

fn validate_trigger_effect(t &AdaptiveTriggerEffect, label string) int {
    if t.mode < TRIGGER_OFF || t.mode > TRIGGER_VIBRATION {
        >> errors.new("nexus console: invalid " + label + " adaptive trigger mode")
    }
    if t.start_position < 0 || t.start_position > 9 || t.end_position < 0 || t.end_position > 9 {
        >> errors.new("nexus console: " + label + " trigger position must be 0..9")
    }
    if t.mode == TRIGGER_WEAPON && t.end_position < t.start_position {
        >> errors.new("nexus console: " + label + " weapon trigger end < start")
    }
    if t.strength < 0 || t.strength > 8 || t.frequency < 0 || t.frequency > 255 {
        >> errors.new("nexus console: " + label + " trigger strength/frequency out of bounds")
    }
    << 0
}

pub fn validate_haptic_command(cmd &GamepadHapticCommand) int {
    vals := [cmd.low_freq_motor, cmd.high_freq_motor, cmd.left_trigger_rumble, cmd.right_trigger_rumble]
    for v in vals {
        if math.is_nan(v) || math.is_inf(v) || v < 0.0 || v > 1.0 {
            >> errors.new("nexus console: rumble motor must be finite within 0..1")
        }
    }
    if math.is_nan(cmd.hd_rumble_freq_low) || math.is_inf(cmd.hd_rumble_freq_low) ||
       cmd.hd_rumble_freq_low < 40.0 || cmd.hd_rumble_freq_low > 1280.0 ||
       math.is_nan(cmd.hd_rumble_freq_high) || math.is_inf(cmd.hd_rumble_freq_high) ||
       cmd.hd_rumble_freq_high < 40.0 || cmd.hd_rumble_freq_high > 1280.0 {
        >> errors.new("nexus console: Switch HD Rumble frequency must be 40..1280 Hz")
    }
    validate_trigger_effect(&cmd.left_adaptive, "left") or >>
    validate_trigger_effect(&cmd.right_adaptive, "right") or >>
    if cmd.lightbar_r < 0 || cmd.lightbar_r > 255 ||
       cmd.lightbar_g < 0 || cmd.lightbar_g > 255 ||
       cmd.lightbar_b < 0 || cmd.lightbar_b > 255 {
        >> errors.new("nexus console: lightbar RGB must be 0..255")
    }
    << 0
}

fn valid_segment(raw &string, label string) int {
    lbl := label + ""
    if raw.len < 1 || raw.len > 64 {
        >> errors.new("nexus console: invalid " + lbl + " length")
    }
    for i in 0:raw.len {
        b := raw[i] & 255
        ok := (b >= 65 && b <= 90) || (b >= 97 && b <= 122) ||
            (b >= 48 && b <= 57) || b == 95 || b == 45 || b == 46
        if !ok {
            >> errors.new("nexus console: illegal character in " + lbl)
        }
    }
    if *raw == "." || *raw == ".." {
        >> errors.new("nexus console: dot segment forbidden in " + lbl)
    }
    << 0
}

pub fn validate_save_key(container &string, blob &string) int {
    valid_segment(container, "save container") or >>
    valid_segment(blob, "save blob") or >>
    << 0
}
