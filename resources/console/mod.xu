    pub high_freq_motor f64
    pub left_trigger_rumble f64
    pub right_trigger_rumble f64
    pub left_adaptive AdaptiveTriggerEffect
    pub right_adaptive AdaptiveTriggerEffect
    pub lightbar_r int
    pub lightbar_g int
    pub lightbar_b int
    pub hd_rumble_freq_low f64
    pub hd_rumble_freq_high f64
}

