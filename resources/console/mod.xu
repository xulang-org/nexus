pub struct ConsoleHardwareProfile {
    pub platform int
    pub name string
    pub gfx_api int
    pub target_width int
    pub target_height int
    pub max_refresh_hz int
    pub memory_budget_mb int
    pub tv_safe_area_pct int
    pub supports_hdr bool
    pub supports_vrr bool
    pub supports_spatial_audio bool
}

pub fn hardware_profile(platform int) ConsoleHardwareProfile {
    if platform == PLATFORM_XBOX_SERIES_X {
        << ConsoleHardwareProfile{
            platform: platform,
            name: "Xbox Series X",
            gfx_api: GFX_D3D12,
            target_width: 3840,
            target_height: 2160,
            max_refresh_hz: 120,
            memory_budget_mb: 13824,
            tv_safe_area_pct: 90,
            supports_hdr: true,
            supports_vrr: true,
            supports_spatial_audio: true
        }
    }
    if platform == PLATFORM_XBOX_SERIES_S {
        << ConsoleHardwareProfile{
            platform: platform,
            name: "Xbox Series S",
            gfx_api: GFX_D3D12,
            target_width: 2560,
            target_height: 1440,
            max_refresh_hz: 120,
            memory_budget_mb: 8192,
            tv_safe_area_pct: 90,
            supports_hdr: true,
            supports_vrr: true,
            supports_spatial_audio: true
        }
    }
    if platform == PLATFORM_XBOX_PC_GDK {
        << ConsoleHardwareProfile{
            platform: platform,
            name: "Xbox PC GDK",
            gfx_api: GFX_D3D12,
            target_width: 2560,
            target_height: 1440,
            max_refresh_hz: 120,
            memory_budget_mb: 8192,
            tv_safe_area_pct: 100,
            supports_hdr: true,
            supports_vrr: true,
            supports_spatial_audio: true
        }
    }
    if platform == PLATFORM_PS5 {
        << ConsoleHardwareProfile{
            platform: platform,
            name: "PlayStation 5",
            gfx_api: GFX_PS_AGC,
            target_width: 3840,
            target_height: 2160,
            max_refresh_hz: 120,
            memory_budget_mb: 12800,
            tv_safe_area_pct: 90,
            supports_hdr: true,
            supports_vrr: true,
            supports_spatial_audio: true
        }
    }
    if platform == PLATFORM_PS5_PRO {
        << ConsoleHardwareProfile{
            platform: platform,
            name: "PlayStation 5 Pro",
            gfx_api: GFX_PS_AGC,
            target_width: 3840,
            target_height: 2160,
            max_refresh_hz: 120,
            memory_budget_mb: 13824,
            tv_safe_area_pct: 90,
            supports_hdr: true,
            supports_vrr: true,
            supports_spatial_audio: true
        }
    }
    if platform == PLATFORM_PS4 {
        << ConsoleHardwareProfile{
            platform: platform,
            name: "PlayStation 4",
            gfx_api: GFX_PS_GNM,
            target_width: 1920,
            target_height: 1080,
            max_refresh_hz: 60,
            memory_budget_mb: 5120,
            tv_safe_area_pct: 90,
            supports_hdr: true,
            supports_vrr: false,
            supports_spatial_audio: false
        }
    }
    if platform == PLATFORM_SWITCH {
        << ConsoleHardwareProfile{
            platform: platform,
            name: "Nintendo Switch",
            gfx_api: GFX_SWITCH_NVN,
            target_width: 1920,
            target_height: 1080,
            max_refresh_hz: 60,
            memory_budget_mb: 3200,
            tv_safe_area_pct: 90,
            supports_hdr: false,
            supports_vrr: false,
            supports_spatial_audio: false
        }
    }
    if platform == PLATFORM_SWITCH_2 {
        << ConsoleHardwareProfile{
            platform: platform,
            name: "Nintendo Switch 2",
            gfx_api: GFX_SWITCH_NVN,
            target_width: 3840,
            target_height: 2160,
            max_refresh_hz: 120,
            memory_budget_mb: 9216,
            tv_safe_area_pct: 90,
            supports_hdr: true,
            supports_vrr: true,
            supports_spatial_audio: true
        }
    }
    if platform == PLATFORM_PC_STEAM {
        << ConsoleHardwareProfile{
            platform: platform,
            name: "PC Steam",
            gfx_api: GFX_VULKAN,
            target_width: 2560,
            target_height: 1440,
            max_refresh_hz: 120,
            memory_budget_mb: 8192,
            tv_safe_area_pct: 100,
            supports_hdr: true,
            supports_vrr: true,
            supports_spatial_audio: true
        }
    }
    if platform == PLATFORM_TAPTAP_ANDROID {
        << ConsoleHardwareProfile{
            platform: platform,
            name: "TapTap Android",
            gfx_api: GFX_VULKAN,
            target_width: 2400,
            target_height: 1080,
            max_refresh_hz: 120,
            memory_budget_mb: 4096,
            tv_safe_area_pct: 100,
            supports_hdr: false,
            supports_vrr: false,
            supports_spatial_audio: false
        }
    }
    if platform == PLATFORM_TAPTAP_IOS {
        << ConsoleHardwareProfile{
            platform: platform,
            name: "TapTap iOS",
            gfx_api: GFX_METAL,
            target_width: 2532,
            target_height: 1170,
            max_refresh_hz: 120,
            memory_budget_mb: 4096,
            tv_safe_area_pct: 100,
            supports_hdr: true,
            supports_vrr: true,
            supports_spatial_audio: true
        }
    }
    if platform == PLATFORM_TAPTAP_PC {
        << ConsoleHardwareProfile{
            platform: platform,
            name: "TapTap PC",
            gfx_api: GFX_VULKAN,
            target_width: 1920,
            target_height: 1080,
            max_refresh_hz: 144,
            memory_budget_mb: 8192,
            tv_safe_area_pct: 100,
            supports_hdr: true,
            supports_vrr: true,
            supports_spatial_audio: true
        }
    }
    >> errors.new("nexus console: unknown platform id: " + str(platform))
}

pub fn is_xbox_platform(platform int) bool {
    << platform == PLATFORM_XBOX_SERIES_X || platform == PLATFORM_XBOX_SERIES_S || platform == PLATFORM_XBOX_PC_GDK
}

pub fn is_playstation_platform(platform int) bool {
    << platform == PLATFORM_PS5 || platform == PLATFORM_PS5_PRO || platform == PLATFORM_PS4
}

pub fn is_switch_platform(platform int) bool {
    << platform == PLATFORM_SWITCH || platform == PLATFORM_SWITCH_2
}

pub fn is_taptap_platform(platform int) bool {
    << platform >= PLATFORM_TAPTAP_ANDROID && platform <= PLATFORM_TAPTAP_PC
}

pub fn switch_resolution(platform int, op_mode int) []int {
    if platform == PLATFORM_SWITCH_2 {
        if op_mode == OPERATION_MODE_DOCKED { << [3840, 2160] }
        << [1920, 1080]
    }
    if op_mode == OPERATION_MODE_DOCKED { << [1920, 1080] }
    << [1280, 720]
}

