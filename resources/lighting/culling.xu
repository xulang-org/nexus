@"github.com/xulang-org/game/resources/lighting"

fm #"github.com/xulang-org/game/foundation/math"
#math
#errors

fn absolute_max(v fm.Vec3) f64 { << math.max(math.abs(v.x),math.max(math.abs(v.y),math.abs(v.z))) }
// Retain uncertain boundary cases. This allowance covers binary32 light
// positions/radius/direction, cone rounding and fragment arithmetic; large
// coordinates intentionally reduce selectivity rather than risk missing light.
pub fn (source &Light3D) affects(bounds fm.Aabb3) bool {
    source.validate() or >>
    bounds.validate() or >>
    if source.kind==DIRECTIONAL { << true }
    scale := absolute_max(bounds.minimum)+absolute_max(bounds.maximum)+absolute_max(source.position)+source.radius+1.0
    margin := scale*0.00001
    distance2 := bounds.distance_squared(source.position) or >>
    radius := source.radius+margin
    if !fm.finite(distance2) || !fm.finite(radius) { << true }
    if distance2>radius*radius { << false }
    if source.kind==POINT { << true }
    // A bounding sphere outside a supporting plane of the widened infinite
    // spot cone cannot intersect the finite cone. No normal-facing heuristic.
    delta := (bounds.center() or >>).sub(source.position)
    extent := bounds.half_extent() or >>
    sphere := math.sqrt(extent.dot(extent))
    axial := delta.dot(source.direction)
    perpendicular := delta.sub(source.direction.scaled(axial))
    radial := math.sqrt(perpendicular.dot(perpendicular))
    cosine := math.max(0.0,source.outer_cosine-0.00004)
    sine := math.sqrt(math.max(0.0,1.0-cosine*cosine))
    separation := radial*cosine-axial*sine
    if !fm.finite(sphere) || !fm.finite(separation) { << true }
    << separation<=sphere+margin
}
// Stable candidate order; keep all possibly contributing sources and reject
// overload. No strongest/nearest truncation or implicit time-varying selection.
pub fn (environment &Environment3D) for_bounds(bounds fm.Aabb3) Environment3D {
    environment.validate() or >>
    bounds.validate() or >>
    $selected := []Light3D{}
    for source in environment.sources {
        if !(source.affects(bounds) or >>) { -> }
        if selected.len>=MAX_LIGHTS { >> errors.new("game lights: more than 16 sources may affect one mesh") }
        selected.push(source)
    }
    << Environment3D{ambient: environment.ambient,eye: environment.eye,exposure: environment.exposure,sources: selected}
}
// Preserve explicit candidate identity after stable per-mesh filtering.
pub fn (environment &Environment3D) selected_source_index(bounds fm.Aabb3,index int) int {
    environment.validate() or >>
    bounds.validate() or >>
    if index<0 || index>=environment.sources.len { >> errors.new("game lights: selected source index outside environment") }
    $selected := 0
    for i in 0:environment.sources.len {
        if !(environment.sources[i].affects(bounds) or >>) { -> }
        if i==index { << selected }
        selected+=1
    }
    << -1
}
