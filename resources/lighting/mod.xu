@"github.com/xulang-org/nexus/resources/lighting"

fm #"github.com/xulang-org/nexus/foundation/math"
#math
#errors

pub const DIRECTIONAL = 0
pub const POINT = 1
pub const SPOT = 2
pub const MAX_LIGHTS = 16
pub const MAX_SOURCES = 256

// Linear RGB radiance; punctual sources are inverse-square intensities at one
// world unit. Radius is a world-space cutoff, unaffected by node scale.
pub struct Light3D {
    kind int
    position fm.Vec3
    direction fm.Vec3
    radiance fm.Vec3
    radius f64
    inner_cosine f64
    outer_cosine f64
}
fn color_range(color fm.Vec3, maximum f64) bool {
    << color.is_finite() && color.x>=0.0 && color.y>=0.0 && color.z>=0.0 &&
        color.x<=maximum && color.y<=maximum && color.z<=maximum
}
fn position_range(position fm.Vec3) bool {
    << position.is_finite() && math.abs(position.x)<=1000000000.0 &&
        math.abs(position.y)<=1000000000.0 && math.abs(position.z)<=1000000000.0
}
// Directional direction is surface-to-light; a spot's forward direction points
// from the source into the cone. Both are normalized once at construction.
pub fn directional(toward_light fm.Vec3, radiance fm.Vec3) Light3D {
    unit := toward_light.normalized() >>>
    source := Light3D{kind: DIRECTIONAL,position: fm.vec3(0.0,0.0,0.0),direction: unit,
        radiance: radiance,radius: 0.0,inner_cosine: 0.0,outer_cosine: 0.0}
    source.validate() >>>
    << source
}
pub fn point(position fm.Vec3, radiance fm.Vec3, radius f64) Light3D {
    source := Light3D{kind: POINT,position: position,direction: fm.vec3(0.0,0.0,0.0),
        radiance: radiance,radius: radius,inner_cosine: 0.0,outer_cosine: 0.0}
    source.validate() >>>
    << source
}
// Cone half-angles are radians, 0 <= inner < outer < pi/2. Reject cones whose
// cosine transition is too narrow for stable binary32 shading.
pub fn spot(position fm.Vec3, forward fm.Vec3, radiance fm.Vec3, radius f64,
    inner_half_angle f64, outer_half_angle f64) Light3D {
    if !fm.finite(inner_half_angle) || !fm.finite(outer_half_angle) || inner_half_angle<0.0 ||
        inner_half_angle>=outer_half_angle || outer_half_angle>=1.5707963267948966 {
        >> errors.new("nexus lights: invalid spot cone half-angles")
    }
    << spot_cosines(position,forward,radiance,radius,math.cos(inner_half_angle),math.cos(outer_half_angle)) >>>
}
// Persist the cosine-domain cone directly, without lossy acos/cos conversion.
pub fn spot_cosines(position fm.Vec3, forward fm.Vec3, radiance fm.Vec3, radius f64,
    inner_cosine f64, outer_cosine f64) Light3D {
    unit := forward.normalized() >>>
    source := Light3D{kind: SPOT,position: position,direction: unit,radiance: radiance,radius: radius,
        inner_cosine: inner_cosine,outer_cosine: outer_cosine}
    source.validate() >>>
    << source
}
pub fn (source &Light3D) validate() int {
    if source.kind<DIRECTIONAL || source.kind>SPOT || !position_range(source.position) ||
        !color_range(source.radiance,64.0) || !fm.finite(source.radius) {
        >> errors.new("nexus lights: invalid kind, position, radiance or radius")
    }
    if source.kind!=DIRECTIONAL && (source.radius<0.001 || source.radius>1000000.0) {
        >> errors.new("nexus lights: radius outside 0.001...1000000 world units")
    }
    if source.kind!=POINT {
        length := source.direction.dot(source.direction)
        if !fm.finite(length) || math.abs(length-1.0)>0.001 { >> errors.new("nexus lights: direction must be a unit vector") }
    }
    if source.kind==SPOT && (!fm.finite(source.inner_cosine) || !fm.finite(source.outer_cosine) ||
        source.outer_cosine<=0.0 || source.inner_cosine>1.0 || source.inner_cosine-source.outer_cosine<0.000001) {
        >> errors.new("nexus lights: spot cosine transition is invalid or too narrow")
    }
    << 0
}
pub fn (source &Light3D) kind() int { << source.kind }
pub fn (source &Light3D) position() fm.Vec3 { << source.position }
pub fn (source &Light3D) direction() fm.Vec3 { << source.direction }
pub fn (source &Light3D) radiance() fm.Vec3 { << source.radiance }
pub fn (source &Light3D) radius() f64 { << source.radius }
pub fn (source &Light3D) inner_cosine() f64 { << source.inner_cosine }
pub fn (source &Light3D) outer_cosine() f64 { << source.outer_cosine }
// Affine translation affects positions; only the linear basis affects direction.
// Shear/nonuniform scale rotate the axis, but do not scale radius or cone angles.
pub fn (source &Light3D) transformed(world fm.Mat4) Light3D {
    source.validate() >>>
    if !world.is_affine() { >> errors.new("nexus lights: light transform must be finite and affine") }
    $position := source.position
    $direction := source.direction
    if source.kind!=DIRECTIONAL { position=world.transform(fm.vec4(position.x,position.y,position.z,1.0)).xyz() }
    if source.kind!=POINT { direction=world.transform(fm.vec4(direction.x,direction.y,direction.z,0.0)).xyz().normalized() >>> }
    result := Light3D{kind: source.kind,position: position,direction: direction,radiance: source.radiance,
        radius: source.radius,inner_cosine: source.inner_cosine,outer_cosine: source.outer_cosine}
    result.validate() >>>
    << result
}

// Immutable candidate lighting. Per-mesh selection reduces at most 256 sources
// to the explicit 16-source forward draw budget before any GPU binding.
pub struct Environment3D {
    ambient fm.Vec3
    eye fm.Vec3
    exposure f64
    sources []Light3D
}
pub fn environment(ambient fm.Vec3, eye fm.Vec3, exposure f64, sources []Light3D) Environment3D {
    result := Environment3D{ambient: ambient,eye: eye,exposure: exposure,sources: sources}
    result.validate() >>>
    << result
}
pub fn (environment &Environment3D) validate() int {
    if !color_range(environment.ambient,1.0) || !position_range(environment.eye) || !fm.finite(environment.exposure) ||
        environment.exposure<0.01 || environment.exposure>16.0 || environment.sources.len>MAX_SOURCES {
        >> errors.new("nexus lights: invalid ambient, eye, exposure or candidate light budget")
    }
    for source in environment.sources { source.validate() >>> }
    << 0
}
pub fn (environment &Environment3D) ambient() fm.Vec3 { << environment.ambient }
pub fn (environment &Environment3D) eye() fm.Vec3 { << environment.eye }
pub fn (environment &Environment3D) exposure() f64 { << environment.exposure }
pub fn (environment &Environment3D) source_count() int { << environment.sources.len }
pub fn (environment &Environment3D) source(index int) Light3D {
    if index<0 || index>=environment.sources.len { >> errors.new("nexus lights: source index outside environment") }
    << environment.sources[index]
}
