@"github.com/xulang-org/nexus/resources/scene"

lod #"github.com/xulang-org/nexus/resources/lod"
#strings
#unicode/utf8
#errors

pub const MAX_RESOURCES = 32
pub const MAX_SURFACES = 4096
// Persistent opaque 128-bit identity, separate from a revision's SHA-256.
// Runtime paths resolve relative to the published scene file.
pub struct ResourceReference { pub uid string
    pub kind string
    pub path string
    pub content_hash string }
pub struct SurfaceLevel { pub distance f64
    pub resource_uid string
    pub primitive int }
pub struct Surface { pub node int
    pub resource_uid string
    pub primitive int
    pub levels []SurfaceLevel
    pub hysteresis f64 }
pub fn surface(node int, resource_uid string, primitive int) Surface {
    << Surface{node: node, resource_uid: resource_uid, primitive: primitive, levels: []SurfaceLevel{}, hysteresis: 0.0}
}
pub fn (surface &Surface) distance_policy() lod.DistanceLod {
    $thresholds := []f64{}
    for level in surface.levels { thresholds.push(level.distance) }
    << lod.distance_lod(thresholds, surface.hysteresis) or >>
}
pub fn valid_resource_id(value &string) bool {
    << lower_hex(value, 32) && *value != "00000000000000000000000000000000"
}
fn lower_hex(value &string, size int) bool {
    if value.len != size { << false }
    for i in 0:value.len { if !(value[i] >= 48 && value[i] <= 57) && !(value[i] >= 97 && value[i] <= 102) { << false } }
    << true
}
fn relative_path(value &string) bool {
    if value.len < 1 || value.len > 1024 || !utf8.valid(value) { << false }
    for i in 0:value.len { if value[i] < 32 || value[i] == 127 || value[i] == 58 || value[i] == 92 { << false } }
    parts := strings.split(value, "/")
    for part in parts { if part.len == 0 || part == "." || part == ".." { << false } }
    << true
}
fn validate_primitive(kinds &map[string]string, uid string, primitive int) int {
    if primitive < 0 || primitive >= 1024 || !kinds.has(uid + "") || kinds[uid] != "glb_model" {
        >> errors.new("nexus scene: invalid surface resource/primitive")
    }
    << 0
}
pub fn with_attachments(document &Document, references []ResourceReference, surfaces []Surface, buses []AudioBus, emitters []AudioEmitter, scripts []ScriptAttachment, connections []ScriptConnection, lights []LightAttachment) Document {
    << with_all_attachments(document, references, surfaces, buses, emitters, scripts, connections, lights, []Sprite3DAttachment{}, []TileMap2DAttachment{}) or >>
}
pub fn with_all_attachments(document &Document, references []ResourceReference, surfaces []Surface, buses []AudioBus, emitters []AudioEmitter, scripts []ScriptAttachment, connections []ScriptConnection, lights []LightAttachment, sprites_3d []Sprite3DAttachment, tilemaps_2d []TileMap2DAttachment) Document {
    if document.nodes.len < 1 || references.len > MAX_RESOURCES || surfaces.len > MAX_SURFACES {
        >> errors.new("nexus scene: attachment counts outside profile")
    }
    $paths := map[string]bool{}
    $kinds := map[string]string{}
    for i in 0:references.len {
        reference := &references[i]
        uid := reference.uid + ""
        path := reference.path + ""
        hash := reference.content_hash + ""
        if !valid_resource_id(&uid) || !lower_hex(&hash, 64) || !relative_path(&path) || (reference.kind != "glb_model" && reference.kind != "wav_clip" && reference.kind != "xu_bytecode" && reference.kind != "image_rgba") {
            >> errors.new("nexus scene: invalid resource identity/path/hash/kind")
        }
        if kinds.has(uid + "") || paths.has(path + "") { >> errors.new("nexus scene: duplicate resource identity or path") }
        kinds[uid] = reference.kind + ""
        paths[path] = true
    }
    $used := map[string]bool{}
    $occupied := map[int]bool{}
    for surface in surfaces {
        if surface.node < 0 || surface.node >= document.nodes.len || document.nodes[surface.node].kind != NODE_3D {
            >> errors.new("nexus scene: invalid surface node")
        }
        if occupied.has(surface.node) { >> errors.new("nexus scene: duplicate surface node") }
        validate_primitive(&kinds, surface.resource_uid + "", surface.primitive) or >>
        if surface.levels.len > 0 || surface.hysteresis != 0.0 {
            if surface.levels.len == 0 || surface.levels.len >= lod.MAX_LEVELS {
                >> errors.new("nexus scene: invalid LOD surface level count")
            }
            surface.distance_policy() or >>
        }
        occupied[surface.node] = true
        used[surface.resource_uid + ""] = true
        for level in surface.levels {
            validate_primitive(&kinds, level.resource_uid + "", level.primitive) or >>
            used[level.resource_uid + ""] = true
        }
    }
    validate_audio(document, &buses, &emitters, &kinds, $&used) or >>
    validate_scripts(document, &scripts, &connections, &kinds, $&used) or >>
    validate_lights(document, &lights) or >>
    validate_sprites_3d(document, &sprites_3d, &kinds, $&used) or >>
    validate_tilemaps_2d(document, &tilemaps_2d, &kinds, $&used) or >>
    if used.len() != references.len { >> errors.new("nexus scene: unreferenced resource") }
    $nodes := []NodeData{}
    for i in 0:document.node_count() { nodes.push(document.describe_node(i) or >>) }
    << Document{nodes: nodes, references: references, surfaces: surfaces, buses: buses, emitters: emitters, scripts: scripts, connections: connections, lights: lights, sprites_3d: sprites_3d, tilemaps_2d: tilemaps_2d}
}
pub fn (document &Document) resource_count() int { << document.references.len }
pub fn (document &Document) surface_count() int { << document.surfaces.len }
pub fn (document &Document) resource(index int) ResourceReference {
    if index < 0 || index >= document.references.len { >> errors.new("nexus scene: resource index outside document") }
    << document.references[index]
}
pub fn (document &Document) surface(index int) Surface {
    if index < 0 || index >= document.surfaces.len { >> errors.new("nexus scene: surface index outside document") }
    saved := &document.surfaces[index]
    $levels := []SurfaceLevel{}
    for level in saved.levels {
        levels.push(SurfaceLevel{distance: level.distance, resource_uid: level.resource_uid + "", primitive: level.primitive})
    }
    << Surface{node: saved.node, resource_uid: saved.resource_uid + "", primitive: saved.primitive,
        levels: levels, hysteresis: saved.hysteresis}
}
