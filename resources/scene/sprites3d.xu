@"github.com/xulang-org/nexus/resources/scene"

sprite3d #"github.com/xulang-org/nexus/resources/sprite3d"
#errors

pub const MAX_SCENE_SPRITES_3D = 4096

pub struct Sprite3DAttachment {
    pub node int
    pub resource_uid string
    pub sprite sprite3d.Sprite3D
}

pub fn sprite_3d_attachment(node int, resource_uid string, sprite sprite3d.Sprite3D) Sprite3DAttachment {
    << Sprite3DAttachment{node: node, resource_uid: resource_uid, sprite: sprite}
}

fn validate_sprites_3d(document &Document, sprites &[]Sprite3DAttachment, kinds &map[string]string, used $&map[string]bool) int {
    if sprites.len > MAX_SCENE_SPRITES_3D {
        >>> errors.new("nexus scene: Sprite3D attachment count exceeds 4096")
    }
    $occupied := map[int]bool{}
    for item in sprites {
        uid := item.resource_uid + ""
        if item.node < 0 || item.node >= document.nodes.len || document.nodes[item.node].kind != NODE_3D ||
            occupied.has(item.node) {
            >>> errors.new("nexus scene: Sprite3D requires a unique Node3D index")
        }
        if !kinds.has(uid + "") || kinds[uid + ""] != "image_rgba" {
            >>> errors.new("nexus scene: Sprite3D requires an image_rgba resource")
        }
        item.sprite.validate() >>>
        occupied[item.node] = true
        used[uid] = true
    }
    << 0
}

pub fn (document &Document) sprite_3d_count() int { << document.sprites_3d.len }

pub fn (document &Document) sprite_3d(index int) Sprite3DAttachment {
    if index < 0 || index >= document.sprites_3d.len {
        >>> errors.new("nexus scene: Sprite3D index outside document")
    }
    saved := &document.sprites_3d[index]
    << Sprite3DAttachment{node: saved.node, resource_uid: saved.resource_uid + "", sprite: saved.sprite}
}

pub fn with_sprites_3d(document &Document, references []ResourceReference, sprites []Sprite3DAttachment) Document {
    $surfaces := []Surface{}
    $buses := []AudioBus{}
    $emitters := []AudioEmitter{}
    $scripts := []ScriptAttachment{}
    $connections := []ScriptConnection{}
    $lights := []LightAttachment{}
    $tilemaps := []TileMap2DAttachment{}
    for i in 0:document.surface_count() { surfaces.push(document.surface(i) >>>) }
    for i in 0:document.audio_bus_count() { buses.push(document.audio_bus(i) >>>) }
    for i in 0:document.audio_count() { emitters.push(document.audio_emitter(i) >>>) }
    for i in 0:document.script_count() { scripts.push(document.script(i) >>>) }
    for i in 0:document.script_connection_count() { connections.push(document.script_connection(i) >>>) }
    for i in 0:document.light_count() { lights.push(document.light(i) >>>) }
    for i in 0:document.tilemap_2d_count() { tilemaps.push(document.tilemap_2d(i) >>>) }
    << with_all_attachments(document, references, surfaces, buses, emitters, scripts, connections, lights, sprites, tilemaps) >>>
}
