@"github.com/xulang-org/game/resources/scene"

light_data #"github.com/xulang-org/game/resources/lighting"
#errors

// Authoring budget is independent of the renderer's 16 simultaneously visible
// sources. Hidden lights still retain their local description in a scene file.
pub const MAX_SCENE_LIGHTS = 256
pub struct LightAttachment { pub node int
    pub source light_data.Light3D }
fn validate_lights(document &Document, lights &[]LightAttachment) int {
    if lights.len>MAX_SCENE_LIGHTS { >> errors.new("game scene: light attachment count exceeds 256") }
    $occupied := map[int]bool{}
    for light in lights {
        if light.node<0 || light.node>=document.nodes.len || document.nodes[light.node].kind!=NODE_3D || occupied.has(light.node) {
            >> errors.new("game scene: light requires a unique Node3D index")
        }
        light.source.validate() or >>
        occupied[light.node]=true
    }
    << 0
}
pub fn (document &Document) light_count() int { << document.lights.len }
pub fn (document &Document) light(index int) LightAttachment {
    if index<0 || index>=document.lights.len { >> errors.new("game scene: light index outside document") }
    << document.lights[index]
}
// Replace local source descriptions while preserving every other attachment.
pub fn with_lights(document &Document, lights []LightAttachment) Document {
    validate_lights(document,&lights) or >>
    $references := []ResourceReference{}
    for i in 0:document.resource_count() { references.push(document.resource(i) or >>) }
    $result := with_references(document,document,references) or >>
    result.lights=lights
    << result
}
