@"github.com/xulang-org/nexus/resources/scene"

fm #"github.com/xulang-org/nexus/foundation/math"
#errors

pub const MAX_SCRIPT_SCALAR = 1000000000
pub const MAX_SCENE_SCRIPTS = 32
pub const MAX_SCRIPT_INITIALS = 32
pub const MAX_SCRIPT_CONNECTIONS = 32
pub struct ScriptInitial { pub id int
    pub value f64 }
pub struct ScriptAttachment { pub node int
    pub resource_uid string
    pub initial []ScriptInitial }
// Endpoints are document node indices; signal/handler are stable schema IDs.
pub struct ScriptConnection { pub source int
    pub signal int
    pub target int
    pub handler int }
fn validate_scripts(document &Document, scripts &[]ScriptAttachment, connections &[]ScriptConnection, kinds &map[string]string, used $&map[string]bool) int {
    if scripts.len > MAX_SCENE_SCRIPTS || connections.len > MAX_SCRIPT_CONNECTIONS { >>> errors.new("nexus scene: script/connection counts outside profile") }
    $nodes := map[int]bool{}
    for script in scripts {
        uid := script.resource_uid + ""
        if script.node < 0 || script.node >= document.nodes.len || nodes.has(script.node) || !kinds.has(uid + "") || kinds[uid + ""] != "xu_bytecode" || script.initial.len > MAX_SCRIPT_INITIALS {
            >>> errors.new("nexus scene: invalid script node/resource/initial count")
        }
        $fields := map[int]bool{}
        for field in script.initial {
            if field.id < 1 || field.id > 2147483647 || fields.has(field.id) || !fm.finite(field.value) || field.value < -f64(MAX_SCRIPT_SCALAR) || field.value > f64(MAX_SCRIPT_SCALAR) {
                >>> errors.new("nexus scene: invalid script initial field ID/value")
            }
            fields[field.id] = true
        }
        nodes[script.node] = true
        used[uid] = true
    }
    $routes := map[string]bool{}
    for route in connections {
        if !nodes.has(route.source) || !nodes.has(route.target) || route.signal < 1 || route.signal > 2147483647 || route.handler < 1 || route.handler > 2147483647 {
            >>> errors.new("nexus scene: invalid script route endpoints/IDs")
        }
        key := str(route.source) + "/" + str(route.signal) + "/" + str(route.target) + "/" + str(route.handler)
        if routes.has(key + "") { >>> errors.new("nexus scene: duplicate script route") }
        routes[key] = true
    }
    << 0
}
pub fn (document &Document) script_count() int { << document.scripts.len }
pub fn (document &Document) script_connection_count() int { << document.connections.len }
pub fn (document &Document) script(index int) ScriptAttachment {
    if index < 0 || index >= document.scripts.len { >>> errors.new("nexus scene: script index outside document") }
    script := &document.scripts[index]
    $initial := []ScriptInitial{}
    for field in script.initial { initial.push(field) }
    << ScriptAttachment{node: script.node, resource_uid: script.resource_uid + "", initial: initial}
}
pub fn (document &Document) script_connection(index int) ScriptConnection {
    if index < 0 || index >= document.connections.len { >>> errors.new("nexus scene: script connection index outside document") }
    << document.connections[index]
}
