@"github.com/xulang-org/nexus/resources/scene"

fm #"github.com/xulang-org/nexus/foundation/math"
#errors

pub const MAX_SCENE_TERRAINS = 16

pub struct TerrainAttachment {
    pub node int
    pub grid_x int
    pub grid_z int
    pub cell_size f64
    pub height_scale f64
    pub seed int
    pub foliage_density f64
    pub wind_strength f64
}

pub fn default_terrain_attachment(node int) TerrainAttachment {
    << TerrainAttachment{
        node: node,
        grid_x: 33,
        grid_z: 33,
        cell_size: 1.0,
        height_scale: 1.0,
        seed: 777,
        foliage_density: 0.75,
        wind_strength: 1.0
    }
}

pub fn (t &TerrainAttachment) validate() int {
    if t.grid_x < 2 || t.grid_x > 1025 || t.grid_z < 2 || t.grid_z > 1025 {
        >> errors.new("nexus scene: Terrain grid dimensions outside 2...1025")
    }
    if !fm.finite(t.cell_size) || t.cell_size <= 0.0 ||
        !fm.finite(t.height_scale) || t.height_scale < 0.0 ||
        !fm.finite(t.foliage_density) || t.foliage_density < 0.0 ||
        !fm.finite(t.wind_strength) || t.wind_strength < 0.0 {
        >> errors.new("nexus scene: Terrain parameters outside valid range")
    }
    << 0
}

fn validate_terrains(document &Document, terrains &[]TerrainAttachment) int {
    if terrains.len > MAX_SCENE_TERRAINS {
        >> errors.new("nexus scene: Terrain attachment count exceeds 16")
    }
    $occupied := map[int]bool{}
    for item in terrains {
        if item.node < 0 || item.node >= document.nodes.len || document.nodes[item.node].kind != NODE_3D || occupied.has(item.node) {
            >> errors.new("nexus scene: Terrain requires a unique Node3D index")
        }
        item.validate() or >>
        occupied[item.node] = true
    }
    << 0
}

pub fn (document &Document) terrain_count() int { << document.terrains.len }

pub fn (document &Document) terrain(index int) TerrainAttachment {
    if index < 0 || index >= document.terrains.len {
        >> errors.new("nexus scene: Terrain index outside document")
    }
    << document.terrains[index]
}
