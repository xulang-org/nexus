@"github.com/xulang-org/nexus/resources/scene"

fm #"github.com/xulang-org/nexus/foundation/math"
#errors

pub const MAX_SCENE_PARTICLES_3D = 256

pub struct ParticleEmitter3DAttachment {
    pub node int
    pub max_particles int
    pub spawn_rate f64
    pub lifetime f64
    pub speed f64
    pub gravity f64
    pub start_color int
    pub end_color int
    pub size f64
    pub additive bool
}

pub fn default_particle_emitter_3d(node int) ParticleEmitter3DAttachment {
    << ParticleEmitter3DAttachment{
        node: node,
        max_particles: 256,
        spawn_rate: 48.0,
        lifetime: 1.5,
        speed: 2.5,
        gravity: -4.0,
        start_color: -16724737, // 0xff00ccff-ish (RGBA packed)
        end_color: 16724736,
        size: 0.25,
        additive: true
    }
}

pub fn (p &ParticleEmitter3DAttachment) validate() int {
    if p.max_particles < 1 || p.max_particles > 65536 {
        >> errors.new("nexus scene: ParticleEmitter3D max_particles outside 1...65536")
    }
    if !fm.finite(p.spawn_rate) || p.spawn_rate < 0.0 ||
        !fm.finite(p.lifetime) || p.lifetime <= 0.0 ||
        !fm.finite(p.speed) || p.speed < 0.0 ||
        !fm.finite(p.gravity) ||
        !fm.finite(p.size) || p.size <= 0.0 {
        >> errors.new("nexus scene: ParticleEmitter3D parameters outside valid range")
    }
    << 0
}

fn validate_particles_3d(document &Document, emitters &[]ParticleEmitter3DAttachment) int {
    if emitters.len > MAX_SCENE_PARTICLES_3D {
        >> errors.new("nexus scene: ParticleEmitter3D attachment count exceeds 256")
    }
    $occupied := map[int]bool{}
    for item in emitters {
        if item.node < 0 || item.node >= document.nodes.len || document.nodes[item.node].kind != NODE_3D || occupied.has(item.node) {
            >> errors.new("nexus scene: ParticleEmitter3D requires a unique Node3D index")
        }
        item.validate() >>>
        occupied[item.node] = true
    }
    << 0
}

pub fn (document &Document) particle_emitter_3d_count() int { << document.particles_3d.len }

pub fn (document &Document) particle_emitter_3d(index int) ParticleEmitter3DAttachment {
    if index < 0 || index >= document.particles_3d.len {
        >> errors.new("nexus scene: ParticleEmitter3D index outside document")
    }
    << document.particles_3d[index]
}
