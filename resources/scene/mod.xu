@"github.com/xulang-org/nexus/resources/scene"

fm #"github.com/xulang-org/nexus/foundation/math"
camera_data #"github.com/xulang-org/nexus/resources/camera"
#unicode/utf8
#errors

pub const NODE_GROUP = 0
pub const NODE_2D = 2
pub const NODE_3D = 3
pub const PROCESS_INHERIT = 0
pub const PROCESS_PAUSABLE = 1
pub const PROCESS_ALWAYS = 2
pub const PROCESS_WHEN_PAUSED = 3
pub const PROCESS_DISABLED = 4
pub const MAX_NODES = 4096
pub const MAX_DEPTH = 256

// Local node data. Runtime IDs, live service objects and execution state are
// absent; Document may additionally contain declarative surface/source metadata.
pub struct NodeData {
    pub parent int
    pub name string
    pub kind int
    pub visible bool
    pub process_mode int
    pub local fm.Transform2D
    pub local_3d fm.Mat4
    pub camera camera_data.Perspective
    pub orthographic camera_data.Orthographic
    pub camera_2d camera_data.View2D
}
pub struct Document { nodes []NodeData
    references []ResourceReference
    surfaces []Surface
    buses []AudioBus
    emitters []AudioEmitter
    scripts []ScriptAttachment
    connections []ScriptConnection
    lights []LightAttachment }
pub fn node(parent int, name string, kind int) NodeData {
    << NodeData{parent: parent, name: name, kind: kind, visible: true,
        process_mode: PROCESS_INHERIT, local: fm.identity(), local_3d: fm.identity_3d(),
        camera: camera_data.Perspective{}, orthographic: camera_data.Orthographic{},
        camera_2d: camera_data.View2D{}}
}
fn valid_name(name &string) bool {
    if name.len < 1 || name.len > 255 || *name == "." || *name == ".." || !utf8.valid(name) { << false }
    for i in 0:name.len { if name[i] < 32 || name[i] == 47 || name[i] == 127 { << false } }
    << true
}
fn identity_2d(t fm.Transform2D) bool {
    << t.a == 1.0 && t.b == 0.0 && t.c == 0.0 && t.d == 1.0 && t.tx == 0.0 && t.ty == 0.0
}
fn identity_3d(m fm.Mat4) bool {
    << m.c0.x == 1.0 && m.c0.y == 0.0 && m.c0.z == 0.0 && m.c0.w == 0.0 &&
        m.c1.x == 0.0 && m.c1.y == 1.0 && m.c1.z == 0.0 && m.c1.w == 0.0 &&
        m.c2.x == 0.0 && m.c2.y == 0.0 && m.c2.z == 1.0 && m.c2.w == 0.0 &&
        m.c3.x == 0.0 && m.c3.y == 0.0 && m.c3.z == 0.0 && m.c3.w == 1.0
}
pub fn make_document(nodes []NodeData) Document {
    if nodes.len < 1 || nodes.len > MAX_NODES { >> errors.new("nexus scene: node count outside 1...4096") }
    $depths := []int{}
    $ancestors := []int{}
    for i in 0:MAX_DEPTH { ancestors.push(-1) }
    $previous_depth := -1
    $siblings := map[string]bool{}
    for i in 0:nodes.len {
        current := &nodes[i]
        name := current.name + ""
        if !valid_name(&name) { >> errors.new("nexus scene: invalid UTF-8 node name") }
        if current.kind != NODE_GROUP && current.kind != NODE_2D && current.kind != NODE_3D { >> errors.new("nexus scene: unsupported node kind") }
        if (current.camera.is_set() || current.orthographic.is_set()) && current.kind != NODE_3D {
            >> errors.new("nexus scene: 3D camera requires a Node3D")
        }
        if current.camera.is_set() && current.orthographic.is_set() {
            >> errors.new("nexus scene: Node3D has two camera projections")
        }
        if current.camera_2d.is_set() && current.kind != NODE_2D { >> errors.new("nexus scene: 2D camera requires a Node2D") }
        if current.process_mode < PROCESS_INHERIT || current.process_mode > PROCESS_DISABLED { >> errors.new("nexus scene: invalid process mode") }
        if !current.local.is_finite() || !current.local_3d.is_affine() { >> errors.new("nexus scene: transform must be finite and affine") }
        if (current.kind != NODE_2D && !identity_2d(current.local)) || (current.kind != NODE_3D && !identity_3d(current.local_3d)) {
            >> errors.new("nexus scene: inactive transform must be identity")
        }
        $depth := 0
        if i == 0 {
            if current.parent != -1 { >> errors.new("nexus scene: root parent must be -1") }
        } else {
            if current.parent < 0 || current.parent >= i { >> errors.new("nexus scene: parent must precede its child") }
            depth = depths[current.parent] + 1
            if depth >= MAX_DEPTH || depth > previous_depth + 1 || ancestors[depth - 1] != current.parent {
                >> errors.new("nexus scene: nodes require preorder within depth 256")
            }
        }
        key := str(current.parent) + "/" + current.name
        if siblings.has(key + "") { >> errors.new("nexus scene: duplicate sibling name") }
        siblings[key] = true
        ancestors[depth] = i
        depths.push(depth)
        previous_depth = depth
    }
    << Document{nodes: nodes, references: []ResourceReference{}, surfaces: []Surface{}, buses: []AudioBus{}, emitters: []AudioEmitter{}, scripts: []ScriptAttachment{}, connections: []ScriptConnection{}, lights: []LightAttachment{}}
}
pub fn (document &Document) node_count() int { << document.nodes.len }
pub fn (document &Document) describe_node(index int) NodeData {
    if index < 0 || index >= document.nodes.len { >> errors.new("nexus scene: node index outside document") }
    << document.nodes[index]
}
