    $b := strings.new_byte_builder(512)
    b.write_str("{\n")
    b.write_str("  \"format\": \"nexus.platform_mapping\",\n")
    b.write_str("  \"version\": 1,\n")
    b.write_str("  \"achievements\": [\n")
    b.write_str("    {\n")
    b.write_str("      \"logical_id\": \"ACH_FIRST_WIN\",\n")
    b.write_str("      \"steam_id\": \"ACH_FIRST_WIN\",\n")
    b.write_str("      \"xbox_id\": \"1\",\n")
    b.write_str("      \"ps_trophy_id\": 0,\n")
    b.write_str("      \"taptap_id\": \"tap_first_win\"\n")
    b.write_str("    }\n")
    b.write_str("  ],\n")
    b.write_str("  \"dlcs\": [\n")
    b.write_str("    {\n")
    b.write_str("      \"logical_id\": \"DLC_EXPANSION_01\",\n")
    b.write_str("      \"steam_app_id\": 480010,\n")
    b.write_str("      \"xbox_store_id\": \"9NX0DLC00001\",\n")
    b.write_str("      \"ps_entitlement\": \"DLC001\",\n")
    b.write_str("      \"switch_aoc_index\": 1,\n")
    b.write_str("      \"taptap_dlc_id\": \"tap_dlc_01\"\n")
    b.write_str("    }\n")
    b.write_str("  ]\n")
    b.write_str("}\n")
    << b.to_string()
}

pub fn generate_readme(meta &ProjectMeta, module_name &string, plats &ProjectPlatformConfigs) string {
    $b := strings.new_byte_builder(1536)
    b.write_str("# " + meta.name + "\n\n")
    b.write_str("- **Project ID**: `" + meta.id + "`\n")
    b.write_str("- **Xu Module**: `" + *module_name + "`\n")
    b.write_str("- **Template / Render Profile**: `" + meta.template + "` / `" + meta.render_profile + "`\n")
    b.write_str("- **Entry Scene**: `scenes/" + meta.entry_scene + "`\n")
    b.write_str("- **Default Locale**: `" + meta.default_locale + "`\n\n")
    b.write_str("## Directory Layout\n\n")
    b.write_str("```text\n")
    b.write_str(".\n")
    b.write_str("├── xu.xun                  # Xu module & Nexus engine dependency\n")
    b.write_str("├── project.json            # Nexus project manifest (meta, paths, platforms, assets, scenes)\n")
    b.write_str("├── src/                    # Game Xu source code (@main + game modules)\n")
    b.write_str("├── scenes/                 # Authored .xuscene levels\n")
    b.write_str("├── prefabs/                # Reusable .xuscene prefabs\n")
    b.write_str("├── assets/                 # models/, textures/, audio/, animations/, shaders/\n")
    b.write_str("├── scripts/                # XuScript (.xus) & schemas\n")
    b.write_str("├── locales/                # i18n string catalogs (strings.json)\n")
    b.write_str("├── config/                 # input_bindings.json, perf_budgets.json, platform_mapping.json\n")
    b.write_str("├── platforms/              # Store/SDK manifests (steam/xbox/ps/switch/taptap/mobile/miniprogram)\n")
    b.write_str("├── tests/                  # Game tests & performance regression gates\n")
    b.write_str("└── build/ & .nexus/        # (gitignored) Build artifacts, cooked generations & editor cache\n")
    b.write_str("```\n\n")
    b.write_str("## Common Commands\n\n")
    b.write_str("```sh\n")
    b.write_str("# Typecheck & build game executable\n")
    b.write_str("xu check src/main.xu\n")
    b.write_str("xu build src/main.xu -o build/game && ./build/game --smoke\n\n")
    b.write_str("# Audit project structure, scenes, locales, input & platform certs\n")
    b.write_str("nexus-project doctor project.json\n\n")
    b.write_str("# Cook scenes & assets into immutable generation under build/published\n")
    b.write_str("nexus-project build project.json --output build/published\n")
    if plats.steam.len > 0 {
        b.write_str("nexus-project steam-stage project.json --output build/stage-steam\n")
    }
    if plats.xbox.len > 0 {
        b.write_str("nexus-project xbox-stage project.json --output build/stage-xbox\n")
    }
    if plats.playstation.len > 0 {
        b.write_str("nexus-project ps-stage project.json --output build/stage-ps\n")
    }
    if plats.switch_cfg.len > 0 {
        b.write_str("nexus-project switch-stage project.json --output build/stage-switch\n")
    }
    if plats.taptap.len > 0 {
        b.write_str("nexus-project taptap-stage project.json --output build/stage-taptap\n")
    }
    b.write_str("```\n")
    << b.to_string()
}

pub fn format_layout_spec() string {
    $b := strings.new_byte_builder(1536)
    b.write_str("Nexus Standard User Game Project Layout:\n")
    b.write_str("<my_game>/\n")
    b.write_str("├── xu.xun                       Xu module manifest requiring github.com/xulang-org/nexus\n")
    b.write_str("├── project.json                 nexus.project v1 (meta, paths, platforms, assets UID map, scenes)\n")
    b.write_str("├── .gitignore                   Ignores build/, .nexus/, *.xubc\n")
    b.write_str("├── README.md                    Build, doctor, editor, and store staging guide\n")
    b.write_str("├── src/\n")
    b.write_str("│   ├── main.xu                  @main game entrypoint\n")
    b.write_str("│   └── game/config.xu           Compile-time identity & boot config\n")
    b.write_str("├── scenes/main.xuscene          Entry scene (.xuscene)\n")
    b.write_str("├── prefabs/                     Reusable .xuscene prefab templates\n")
    b.write_str("├── assets/\n")
    b.write_str("│   ├── models/                  .glb / .obj / .stl meshes\n")
    b.write_str("│   ├── textures/                .png textures & sprite atlases\n")
    b.write_str("│   ├── audio/                   .wav / ADPCM audio clips\n")
    b.write_str("│   ├── animations/              Skeletal ASM JSON & clips\n")
    b.write_str("│   └── shaders/                 Custom MSL / GLSL / HLSL shaders\n")
    b.write_str("├── scripts/                     XuScript (.xus) + .schema.json\n")
    b.write_str("├── locales/strings.json         nexus.i18n v1 localization catalog\n")
    b.write_str("├── config/\n")
    b.write_str("│   ├── input_bindings.json      nexus.input v1 keyboard/gamepad bindings\n")
    b.write_str("│   ├── perf_budgets.json        nexus.perf_budgets v1 frame budgets\n")
    b.write_str("│   └── platform_mapping.json    nexus.platform_mapping v1 achievements & DLCs\n")
    b.write_str("├── platforms/\n")
    b.write_str("│   ├── steam.json               Steamworks / SteamPipe config\n")
    b.write_str("│   ├── xbox.json                Xbox GDK config & XR rules\n")
    b.write_str("│   ├── playstation.json         PS5/PS4 PSN config & TRC rules\n")
    b.write_str("│   ├── switch.json              Nintendo Switch / Switch 2 Lotcheck config\n")
    b.write_str("│   ├── taptap.json              TapTap TapSDK v4 CN/Global config\n")
    b.write_str("│   ├── mobile/                  Android / iOS store icons & extras\n")
    b.write_str("│   └── miniprogram/             WeChat / Douyin MiniGame config\n")
    b.write_str("├── tests/                       Game tests & perf regression checks\n")
    b.write_str("├── build/                       (gitignored) compiled binaries, published generations, staged pkgs\n")
    b.write_str("└── .nexus/                      (gitignored) editor drafts, receipts, local mock saves\n")
    << b.to_string()
}
