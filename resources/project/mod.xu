@"github.com/xulang-org/nexus/resources/project"

#encoding/json
#errors
#strconv
#strings

pub const PROJECT_FORMAT = "nexus.project"
pub const PROJECT_VERSION = 1

pub const PERF_BUDGETS_FORMAT = "nexus.perf_budgets"
pub const PERF_BUDGETS_VERSION = 1

pub const PLATFORM_MAPPING_FORMAT = "nexus.platform_mapping"
pub const PLATFORM_MAPPING_VERSION = 1

pub const DEFAULT_NEXUS_VERSION = "0.1.2"
pub const DEFAULT_XU_VERSION = "0.14.4"

pub const TEMPLATE_3D = "3d"
pub const TEMPLATE_2D = "2d"
pub const TEMPLATE_25D = "25d"
pub const TEMPLATE_BLANK = "blank"

pub const RENDER_MODERN_3D = "modern_3d"
pub const RENDER_STANDARD_2D = "standard_2d"
pub const RENDER_HD2D = "hd2d"
pub const RENDER_MINIMAL = "minimal"

pub struct ProjectMeta {
    pub name string
    pub id string
    pub version string
    pub template string
    pub nexus_version string
    pub entry_scene string
    pub default_locale string
    pub render_profile string
}

pub struct ProjectPaths {
    pub src string
    pub scenes string
    pub prefabs string
    pub assets string
    pub scripts string
    pub locales string
    pub input_bindings string
    pub perf_budgets string
    pub platform_mapping string
}

pub struct ProjectPlatformConfigs {
    pub steam string
    pub xbox string
    pub playstation string
    pub switch_cfg string
    pub taptap string
}

pub fn empty_meta() ProjectMeta {
    << ProjectMeta{
        name: "",
        id: "",
        version: "0.1.0",
        template: TEMPLATE_3D,
        nexus_version: DEFAULT_NEXUS_VERSION,
        entry_scene: "",
        default_locale: "en-US",
        render_profile: RENDER_MODERN_3D
    }
}

pub fn empty_paths() ProjectPaths {
    << ProjectPaths{
        src: "",
        scenes: "",
        prefabs: "",
        assets: "",
        scripts: "",
        locales: "",
        input_bindings: "",
        perf_budgets: "",
        platform_mapping: ""
    }
}

pub fn empty_platforms() ProjectPlatformConfigs {
    << ProjectPlatformConfigs{
        steam: "",
        xbox: "",
        playstation: "",
        switch_cfg: "",
        taptap: ""
    }
}

pub fn clone_meta(m &ProjectMeta) ProjectMeta {
    << ProjectMeta{
        name: m.name + "",
        id: m.id + "",
        version: m.version + "",
        template: m.template + "",
        nexus_version: m.nexus_version + "",
        entry_scene: m.entry_scene + "",
        default_locale: m.default_locale + "",
        render_profile: m.render_profile + ""
    }
}

pub fn clone_paths(p &ProjectPaths) ProjectPaths {
    << ProjectPaths{
        src: p.src + "",
        scenes: p.scenes + "",
        prefabs: p.prefabs + "",
        assets: p.assets + "",
        scripts: p.scripts + "",
        locales: p.locales + "",
        input_bindings: p.input_bindings + "",
        perf_budgets: p.perf_budgets + "",
        platform_mapping: p.platform_mapping + ""
    }
}

pub fn clone_platforms(p &ProjectPlatformConfigs) ProjectPlatformConfigs {
    << ProjectPlatformConfigs{
        steam: p.steam + "",
        xbox: p.xbox + "",
        playstation: p.playstation + "",
        switch_cfg: p.switch_cfg + "",
        taptap: p.taptap + ""
    }
}

pub fn standard_directories() []string {
    << [
        "src",
        "src/game",
        "scenes",
        "prefabs",
        "assets",
        "assets/models",
        "assets/textures",
        "assets/audio",
        "assets/animations",
        "assets/shaders",
        "scripts",
        "locales",
        "config",
        "platforms",
        "platforms/mobile",
        "platforms/miniprogram",
        "tests"
    ]
}

pub fn default_render_profile(template &string) string {
    if *template == TEMPLATE_2D { << RENDER_STANDARD_2D }
    if *template == TEMPLATE_25D { << RENDER_HD2D }
    if *template == TEMPLATE_BLANK { << RENDER_MINIMAL }
    << RENDER_MODERN_3D
}

pub fn slugify_identifier(raw &string) string {
    trimmed := strings.trim_space(raw)
    $b := strings.new_byte_builder(trimmed.len + 8)
    $written := 0
    $prev_underscore := false
    for i in 0:trimmed.len {
        c := trimmed[i] & 255
        if c >= 65 && c <= 90 {
            b.write_byte(int(c + 32))
            written += 1
            prev_underscore = false
        } else if (c >= 97 && c <= 122) || (c >= 48 && c <= 57) {
            b.write_byte(int(c))
            written += 1
            prev_underscore = false
        } else {
            if written > 0 && !prev_underscore {
                b.write_byte(95)
                written += 1
                prev_underscore = true
            }
        }
    }
    $slug := b.to_string()
    while slug.len > 0 && (slug[slug.len - 1] & 255) == 95 {
        slug = slug[0 : slug.len - 1] + ""
    }
    if slug.len == 0 {
        << "nexus_game"
    }
    first := slug[0] & 255
    if first < 97 || first > 122 {
        slug = "game_" + slug
    }
    << slug
}

pub fn default_project_id(name &string) string {
    << "com.nexus." + slugify_identifier(name)
}

fn normalize_template_or_default(template &string) string {
    << validate_template(template) >>> (err) {
        _ := err.msg()
        << TEMPLATE_3D
    }
}

pub fn default_meta(name string, id string, template string, default_locale string) ProjectMeta {
    tmpl := normalize_template_or_default(&template)
    $resolved_id := strings.trim_space(&id)
    if resolved_id.len == 0 {
        resolved_id = default_project_id(&name)
    }
    $loc := strings.trim_space(&default_locale)
    if loc.len == 0 {
        loc = "en-US"
    }
    << ProjectMeta{
        name: strings.trim_space(&name),
        id: resolved_id,
        version: "0.1.0",
        template: tmpl + "",
        nexus_version: DEFAULT_NEXUS_VERSION,
        entry_scene: "main.xuscene",
        default_locale: loc,
        render_profile: default_render_profile(&tmpl)
    }
}

pub fn default_paths() ProjectPaths {
    << ProjectPaths{
        src: "src",
        scenes: "scenes",
        prefabs: "prefabs",
        assets: "assets",
        scripts: "scripts",
        locales: "locales/strings.json",
        input_bindings: "config/input_bindings.json",
        perf_budgets: "config/perf_budgets.json",
        platform_mapping: "config/platform_mapping.json"
    }
}

fn check_no_ctrl(s &string, label string) int {
    lbl := label + ""
    if s.len == 0 || s.len > 256 {
        >> errors.new("nexus project: " + lbl + " must be 1..256 bytes")
    }
    for i in 0:s.len {
        b := s[i] & 255
        if b < 32 || b == 127 {
            >> errors.new("nexus project: control character forbidden in " + lbl)
        }
    }
    << 0
}

pub fn validate_project_name(raw &string) string {
    trimmed := strings.trim_space(raw)
    if trimmed.len < 1 || trimmed.len > 128 {
        >> errors.new("nexus project: name must be 1..128 bytes")
    }
    check_no_ctrl(&trimmed, "meta.name") >>>
    << trimmed
}

pub fn validate_project_id(raw &string) string {
    trimmed := strings.trim_space(raw)
    if trimmed.len < 3 || trimmed.len > 128 {
        >> errors.new("nexus project: meta.id must be 3..128 bytes")
    }
    $has_dot := false
    for i in 0:trimmed.len {
        b := trimmed[i] & 255
        if b == 46 {
            has_dot = true
            if i == 0 || i == trimmed.len - 1 || (trimmed[i - 1] & 255) == 46 {
                >> errors.new("nexus project: meta.id has misplaced dot: " + trimmed)
            }
        } else {
            ok := (b >= 65 && b <= 90) || (b >= 97 && b <= 122) ||
                (b >= 48 && b <= 57) || b == 95
            if !ok {
                >> errors.new("nexus project: illegal character in meta.id: " + trimmed)
            }
        }
    }
    if !has_dot {
        >> errors.new("nexus project: meta.id must be reverse-DNS (e.g. com.studio.game): " + trimmed)
    }
    << trimmed
}

pub fn validate_semver(raw &string) string {
    trimmed := strings.trim_space(raw)
    if trimmed.len < 3 || trimmed.len > 64 {
        >> errors.new("nexus project: invalid version length: " + trimmed)
    }
    for i in 0:trimmed.len {
        b := trimmed[i] & 255
        ok := (b >= 48 && b <= 57) || (b >= 65 && b <= 90) || (b >= 97 && b <= 122) ||
            b == 46 || b == 45 || b == 43
        if !ok {
            >> errors.new("nexus project: illegal character in version: " + trimmed)
        }
    }
    if !strings.contains(&trimmed, ".") {
        >> errors.new("nexus project: version must be semver-like (e.g. 0.1.0): " + trimmed)
    }
    << trimmed
}

pub fn validate_template(raw &string) string {
    t := strings.to_lower(&strings.trim_space(raw))
    if t != TEMPLATE_3D && t != TEMPLATE_2D && t != TEMPLATE_25D && t != TEMPLATE_BLANK {
        >> errors.new("nexus project: unsupported template '" + t + "' (expected 3d, 2d, 25d, or blank)")
    }
    << t
}

pub fn validate_render_profile(raw &string) string {
    p := strings.to_lower(&strings.trim_space(raw))
    if p != RENDER_MODERN_3D && p != RENDER_STANDARD_2D && p != RENDER_HD2D && p != RENDER_MINIMAL {
        >> errors.new("nexus project: unsupported render_profile '" + p + "'")
    }
    << p
}

pub fn validate_rel_path(raw &string, label string) string {
    trimmed := strings.trim_space(raw)
    lbl := label + ""
    if trimmed.len < 1 || trimmed.len > 512 {
        >> errors.new("nexus project: invalid relative path in " + lbl)
    }
    check_no_ctrl(&trimmed, lbl + "") >>>
    if (trimmed[0] & 255) == 47 || (trimmed[0] & 255) == 92 {
        >> errors.new("nexus project: " + lbl + " must be relative: " + trimmed)
    }
    if trimmed.len >= 2 && (trimmed[1] & 255) == 58 {
        >> errors.new("nexus project: drive-qualified path forbidden in " + lbl)
    }
    slashed := strings.replace_all(&trimmed, "\\", "/")
    parts := strings.split(&slashed, "/")
    $clean := []string{}
    for part in parts {
        seg := part + ""
        if seg.len == 0 || seg == "." || seg == ".." {
            >> errors.new("nexus project: invalid path segment in " + lbl + ": " + trimmed)
        }
        clean.push(seg)
    }
    << strings.join(clean, "/")
}

pub fn validate_meta(m &ProjectMeta) int {
    _ := validate_project_name(&m.name) >>>
    _ := validate_project_id(&m.id) >>>
    _ := validate_semver(&m.version) >>>
    _ := validate_template(&m.template) >>>
    if m.nexus_version.len > 0 {
        _ := validate_semver(&m.nexus_version) >>>
    }
    if m.entry_scene.len > 0 {
        check_no_ctrl(&m.entry_scene, "meta.entry_scene") >>>
        if strings.contains(&m.entry_scene, "/") || strings.contains(&m.entry_scene, "\\") {
            >> errors.new("nexus project: meta.entry_scene must be a scene key, not a path")
        }
    }
    if m.default_locale.len > 0 {
        check_no_ctrl(&m.default_locale, "meta.default_locale") >>>
    }
    if m.render_profile.len > 0 {
        _ := validate_render_profile(&m.render_profile) >>>
    }
    << 0
}

pub fn validate_paths(p &ProjectPaths) int {
    if p.src.len > 0 { _ := validate_rel_path(&p.src, "paths.src") >>> }
    if p.scenes.len > 0 { _ := validate_rel_path(&p.scenes, "paths.scenes") >>> }
    if p.prefabs.len > 0 { _ := validate_rel_path(&p.prefabs, "paths.prefabs") >>> }
    if p.assets.len > 0 { _ := validate_rel_path(&p.assets, "paths.assets") >>> }
    if p.scripts.len > 0 { _ := validate_rel_path(&p.scripts, "paths.scripts") >>> }
    if p.locales.len > 0 { _ := validate_rel_path(&p.locales, "paths.locales") >>> }
    if p.input_bindings.len > 0 { _ := validate_rel_path(&p.input_bindings, "paths.input_bindings") >>> }
    if p.perf_budgets.len > 0 { _ := validate_rel_path(&p.perf_budgets, "paths.perf_budgets") >>> }
    if p.platform_mapping.len > 0 { _ := validate_rel_path(&p.platform_mapping, "paths.platform_mapping") >>> }
    << 0
}

pub fn validate_platform_configs(p &ProjectPlatformConfigs) int {
    if p.steam.len > 0 { _ := validate_rel_path(&p.steam, "platforms.steam") >>> }
    if p.xbox.len > 0 { _ := validate_rel_path(&p.xbox, "platforms.xbox") >>> }
    if p.playstation.len > 0 { _ := validate_rel_path(&p.playstation, "platforms.playstation") >>> }
    if p.switch_cfg.len > 0 { _ := validate_rel_path(&p.switch_cfg, "platforms.switch") >>> }
    if p.taptap.len > 0 { _ := validate_rel_path(&p.taptap, "platforms.taptap") >>> }
    << 0
}

fn push_unique_platform(out $&[]string, v string) {
    for i in 0:out.len {
        if out[i] == v { << }
    }
    out.push(v)
}

pub fn parse_platform_list(raw &string) []string {
    trimmed := strings.to_lower(&strings.trim_space(raw))
    if trimmed.len == 0 || trimmed == "all" {
        << ["steam", "xbox", "playstation", "switch", "taptap"]
    }
    if trimmed == "none" {
        << []string{}
    }
    parts := strings.split(&trimmed, ",")
    $out := []string{}
    for i in 0:parts.len {
        tok := strings.trim_space(&parts[i])
        if tok.len == 0 {
            >> errors.new("nexus project: empty platform token in '" + trimmed + "'")
        }
        $norm := tok + ""
        if tok == "ps" || tok == "ps5" || tok == "ps4" {
            norm = "playstation"
        } else if tok == "ns" || tok == "nintendo" {
            norm = "switch"
        }
        if norm != "steam" && norm != "xbox" && norm != "playstation" && norm != "switch" && norm != "taptap" {
            >> errors.new("nexus project: unknown platform '" + tok + "' (expected steam, xbox, playstation, switch, taptap)")
        }
        push_unique_platform($&out, norm)
    }
    << out
}

pub fn platform_configs_for_list(plats &[]string) ProjectPlatformConfigs {
    $cfg := empty_platforms()
    for i in 0:plats.len {
        p := plats[i] + ""
        if p == "steam" { cfg.steam = "platforms/steam.json" }
        else if p == "xbox" { cfg.xbox = "platforms/xbox.json" }
        else if p == "playstation" { cfg.playstation = "platforms/playstation.json" }
        else if p == "switch" { cfg.switch_cfg = "platforms/switch.json" }
        else if p == "taptap" { cfg.taptap = "platforms/taptap.json" }
    }
    << cfg
}

fn check_allowed_keys(doc &json.Doc, obj int, allowed &[]string, label string) int {
    keys := doc.dict_keys(obj)
    for i in 0:keys.len {
        k := keys[i] + ""
        $found := false
        for ai in 0:allowed.len {
            if allowed[ai] == k {
                found = true
                <-
            }
        }
        if !found {
            >> errors.new("nexus project: unknown field '" + k + "' in " + label)
        }
    }
    << 0
}

pub fn decode_meta_node(doc &json.Doc, node int) ProjectMeta {
    if node < 0 || !doc.is_dict(node) {
        >> errors.new("nexus project: expected object for meta")
    }
    allowed := ["name", "id", "version", "template", "nexus_version", "entry_scene", "default_locale", "render_profile"]
    check_allowed_keys(doc, node, &allowed, "meta") >>>
    $m := empty_meta()
    if !doc.has(node, "name") || !doc.has(node, "id") {
        >> errors.new("nexus project: meta requires 'name' and 'id'")
    }
    m.name = doc.as_string(doc.get(node, "name")) >>>
    m.id = doc.as_string(doc.get(node, "id")) >>>
    if doc.has(node, "version") { m.version = doc.as_string(doc.get(node, "version")) >>> }
    if doc.has(node, "template") { m.template = doc.as_string(doc.get(node, "template")) >>> }
    if doc.has(node, "nexus_version") { m.nexus_version = doc.as_string(doc.get(node, "nexus_version")) >>> }
    if doc.has(node, "entry_scene") { m.entry_scene = doc.as_string(doc.get(node, "entry_scene")) >>> }
    if doc.has(node, "default_locale") { m.default_locale = doc.as_string(doc.get(node, "default_locale")) >>> }
    if doc.has(node, "render_profile") {
        m.render_profile = doc.as_string(doc.get(node, "render_profile")) >>>
    } else {
        m.render_profile = default_render_profile(&m.template)
    }
    validate_meta(&m) >>>
    << m
}

pub fn encode_meta_json(m &ProjectMeta, indent string) string {
    validate_meta(m) >>>
    ind := indent + ""
    ind2 := ind + "  "
    name_s := m.name + ""
    id_s := m.id + ""
    ver_s := m.version + ""
    tmpl_s := m.template + ""
    nx_s := m.nexus_version + ""
    es_s := m.entry_scene + ""
    dl_s := m.default_locale + ""
    rp_s := m.render_profile + ""
    $b := strings.new_byte_builder(512)
    b.write_str("{\n")
    b.write_str(ind2 + "\"name\": " + json.quote(&name_s) + ",\n")
    b.write_str(ind2 + "\"id\": " + json.quote(&id_s) + ",\n")
    b.write_str(ind2 + "\"version\": " + json.quote(&ver_s) + ",\n")
    b.write_str(ind2 + "\"template\": " + json.quote(&tmpl_s) + ",\n")
    b.write_str(ind2 + "\"nexus_version\": " + json.quote(&nx_s) + ",\n")
    b.write_str(ind2 + "\"entry_scene\": " + json.quote(&es_s) + ",\n")
    b.write_str(ind2 + "\"default_locale\": " + json.quote(&dl_s) + ",\n")
    b.write_str(ind2 + "\"render_profile\": " + json.quote(&rp_s) + "\n")
    b.write_str(ind + "}")
    << b.to_string()
}

pub fn decode_paths_node(doc &json.Doc, node int) ProjectPaths {
    if node < 0 || !doc.is_dict(node) {
        >> errors.new("nexus project: expected object for paths")
    }
    allowed := ["src", "scenes", "prefabs", "assets", "scripts", "locales", "input_bindings", "perf_budgets", "platform_mapping"]
    check_allowed_keys(doc, node, &allowed, "paths") >>>
    $p := empty_paths()
    if doc.has(node, "src") { p.src = doc.as_string(doc.get(node, "src")) >>> }
    if doc.has(node, "scenes") { p.scenes = doc.as_string(doc.get(node, "scenes")) >>> }
    if doc.has(node, "prefabs") { p.prefabs = doc.as_string(doc.get(node, "prefabs")) >>> }
    if doc.has(node, "assets") { p.assets = doc.as_string(doc.get(node, "assets")) >>> }
    if doc.has(node, "scripts") { p.scripts = doc.as_string(doc.get(node, "scripts")) >>> }
    if doc.has(node, "locales") { p.locales = doc.as_string(doc.get(node, "locales")) >>> }
    if doc.has(node, "input_bindings") { p.input_bindings = doc.as_string(doc.get(node, "input_bindings")) >>> }
    if doc.has(node, "perf_budgets") { p.perf_budgets = doc.as_string(doc.get(node, "perf_budgets")) >>> }
    if doc.has(node, "platform_mapping") { p.platform_mapping = doc.as_string(doc.get(node, "platform_mapping")) >>> }
    validate_paths(&p) >>>
    << p
}

fn append_kv_line(entries $&[]string, ind2 &string, key string, val &string) {
    if val.len == 0 { << }
    v := val + ""
    entries.push(ind2 + json.quote(&key) + ": " + json.quote(&v))
}

pub fn encode_paths_json(p &ProjectPaths, indent string) string {
    validate_paths(p) >>>
    ind := indent + ""
    ind2 := ind + "  "
    $rows := []string{}
    append_kv_line($&rows, &ind2, "src", &p.src)
    append_kv_line($&rows, &ind2, "scenes", &p.scenes)
    append_kv_line($&rows, &ind2, "prefabs", &p.prefabs)
    append_kv_line($&rows, &ind2, "assets", &p.assets)
    append_kv_line($&rows, &ind2, "scripts", &p.scripts)
    append_kv_line($&rows, &ind2, "locales", &p.locales)
    append_kv_line($&rows, &ind2, "input_bindings", &p.input_bindings)
    append_kv_line($&rows, &ind2, "perf_budgets", &p.perf_budgets)
    append_kv_line($&rows, &ind2, "platform_mapping", &p.platform_mapping)
    if rows.len == 0 { << "{}" }
    << "{\n" + strings.join(rows, ",\n") + "\n" + ind + "}"
}

pub fn decode_platforms_node(doc &json.Doc, node int) ProjectPlatformConfigs {
    if node < 0 || !doc.is_dict(node) {
        >> errors.new("nexus project: expected object for platforms")
    }
    allowed := ["steam", "xbox", "playstation", "switch", "taptap"]
    check_allowed_keys(doc, node, &allowed, "platforms") >>>
    $p := empty_platforms()
    if doc.has(node, "steam") { p.steam = doc.as_string(doc.get(node, "steam")) >>> }
    if doc.has(node, "xbox") { p.xbox = doc.as_string(doc.get(node, "xbox")) >>> }
    if doc.has(node, "playstation") { p.playstation = doc.as_string(doc.get(node, "playstation")) >>> }
    if doc.has(node, "switch") { p.switch_cfg = doc.as_string(doc.get(node, "switch")) >>> }
    if doc.has(node, "taptap") { p.taptap = doc.as_string(doc.get(node, "taptap")) >>> }
    validate_platform_configs(&p) >>>
    << p
}

pub fn encode_platforms_json(p &ProjectPlatformConfigs, indent string) string {
    validate_platform_configs(p) >>>
    ind := indent + ""
    ind2 := ind + "  "
    $rows := []string{}
    append_kv_line($&rows, &ind2, "steam", &p.steam)
    append_kv_line($&rows, &ind2, "xbox", &p.xbox)
    append_kv_line($&rows, &ind2, "playstation", &p.playstation)
    append_kv_line($&rows, &ind2, "switch", &p.switch_cfg)
    append_kv_line($&rows, &ind2, "taptap", &p.taptap)
    if rows.len == 0 { << "{}" }
    << "{\n" + strings.join(rows, ",\n") + "\n" + ind + "}"
}

pub fn validate_perf_budgets_json(raw &string) int {
    if raw.len < 2 || raw.len > 1048576 {
        >> errors.new("nexus perf_budgets: JSON size out of bounds")
    }
    doc := json.parse_max(raw, 1048576)
    if !doc.ok() { >> errors.new("nexus perf_budgets JSON: " + doc.error()) }
    root := doc.root()
    if !doc.is_dict(root) || !doc.has(root, "format") || !doc.has(root, "version") || !doc.has(root, "profiles") {
        >> errors.new("nexus perf_budgets: missing required fields (format/version/profiles)")
    }
    if (doc.as_string(doc.get(root, "format")) >>>) != PERF_BUDGETS_FORMAT ||
       (doc.as_int(doc.get(root, "version")) >>>) != PERF_BUDGETS_VERSION {
        >> errors.new("nexus perf_budgets: unsupported format or version")
    }
    profs := doc.get(root, "profiles")
    if !doc.is_dict(profs) || doc.count(profs) < 1 {
        >> errors.new("nexus perf_budgets: profiles must be non-empty object")
    }
    for i in 0:doc.count(profs) {
        pnode := doc.at(profs, i)
        pname := doc.key(pnode)
        if !doc.is_dict(pnode) {
            >> errors.new("nexus perf_budgets: profile '" + pname + "' must be object")
        }
        if !doc.has(pnode, "max_avg_ms") || !doc.has(pnode, "max_p95_ms") || !doc.has(pnode, "max_p99_ms") ||
           !doc.has(pnode, "min_samples") || !doc.has(pnode, "max_regression_ratio") {
            >> errors.new("nexus perf_budgets: profile '" + pname + "' missing threshold field")
        }
        avg := doc.as_f64(doc.get(pnode, "max_avg_ms")) >>>
        p95 := doc.as_f64(doc.get(pnode, "max_p95_ms")) >>>
        p99 := doc.as_f64(doc.get(pnode, "max_p99_ms")) >>>
        mins := doc.as_int(doc.get(pnode, "min_samples")) >>>
        reg := doc.as_f64(doc.get(pnode, "max_regression_ratio")) >>>
        if avg <= 0.0 || p95 < avg || p99 < p95 || mins < 1 || reg <= 0.0 {
            >> errors.new("nexus perf_budgets: invalid budget threshold in profile '" + pname + "'")
        }
    }
    << 0
}

pub fn validate_platform_mapping_json(raw &string) int {
    if raw.len < 2 || raw.len > 1048576 {
        >> errors.new("nexus platform_mapping: JSON size out of bounds")
    }
    doc := json.parse_max(raw, 1048576)
    if !doc.ok() { >> errors.new("nexus platform_mapping JSON: " + doc.error()) }
    root := doc.root()
    if !doc.is_dict(root) || !doc.has(root, "format") || !doc.has(root, "version") {
        >> errors.new("nexus platform_mapping: missing required format/version")
    }
    if (doc.as_string(doc.get(root, "format")) >>>) != PLATFORM_MAPPING_FORMAT ||
       (doc.as_int(doc.get(root, "version")) >>>) != PLATFORM_MAPPING_VERSION {
        >> errors.new("nexus platform_mapping: unsupported format or version")
    }
    if doc.has(root, "achievements") {
        al := doc.get(root, "achievements")
        if !doc.is_list(al) { >> errors.new("nexus platform_mapping: achievements must be array") }
        for i in 0:doc.count(al) {
            row := doc.at(al, i)
            if !doc.is_dict(row) || !doc.has(row, "logical_id") || !doc.has(row, "ps_trophy_id") {
                >> errors.new("nexus platform_mapping: achievement entry missing logical_id/ps_trophy_id")
            }
            lid := doc.as_string(doc.get(row, "logical_id")) >>>
            if lid.len == 0 { >> errors.new("nexus platform_mapping: empty logical_id") }
            tid := doc.as_int(doc.get(row, "ps_trophy_id")) >>>
            if tid < 0 || tid > 127 { >> errors.new("nexus platform_mapping: ps_trophy_id out of range 0..127") }
        }
    }
    if doc.has(root, "dlcs") {
        dl := doc.get(root, "dlcs")
        if !doc.is_list(dl) { >> errors.new("nexus platform_mapping: dlcs must be array") }
        for i in 0:doc.count(dl) {
            row := doc.at(dl, i)
            if !doc.is_dict(row) || !doc.has(row, "logical_id") || !doc.has(row, "steam_app_id") || !doc.has(row, "switch_aoc_index") {
                >> errors.new("nexus platform_mapping: dlc entry missing required fields")
            }
            lid := doc.as_string(doc.get(row, "logical_id")) >>>
            if lid.len == 0 { >> errors.new("nexus platform_mapping: empty dlc logical_id") }
            sa := doc.as_int(doc.get(row, "steam_app_id")) >>>
            aoc := doc.as_int(doc.get(row, "switch_aoc_index")) >>>
            if sa < 0 || aoc < 0 { >> errors.new("nexus platform_mapping: negative DLC ID/index") }
        }
    }
    << 0
}
