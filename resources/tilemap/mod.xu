@"github.com/xulang-org/nexus/resources/tilemap"

fm #"github.com/xulang-org/nexus/foundation/math"
#errors
#math

pub const LAYOUT_ORTHOGONAL = 0
pub const LAYOUT_ISOMETRIC = 1
pub const LAYOUT_STAGGERED = 2

pub const EMPTY_TILE = -1
pub const MAX_MAP_WIDTH = 512
pub const MAX_MAP_HEIGHT = 512
pub const MAX_MAP_CELLS = 65536
pub const MAX_ATLAS_COLUMNS = 256
pub const MAX_ATLAS_ROWS = 256
pub const MAX_TILE_LAYERS = 64

pub struct CellCoord {
    pub col int
    pub row int
}

// Uniform sprite-sheet tileset metadata. draw_size may exceed the logical grid
// tile size to support tall 2.5D isometric walls, trees, and elevated blocks.
// origin is normalized in [0, 1]^2 relative to draw_size and anchors onto the cell center.
pub struct TileSet2D {
    pub columns int
    pub rows int
    pub draw_width f64
    pub draw_height f64
    pub origin fm.Vec2
}

pub fn tileset_2d(columns int, rows int, draw_width f64, draw_height f64, origin fm.Vec2) TileSet2D {
    set := TileSet2D{columns: columns, rows: rows, draw_width: draw_width, draw_height: draw_height, origin: origin}
    set.validate() >>>
    << set
}

pub fn (set &TileSet2D) validate() int {
    if set.columns < 1 || set.columns > MAX_ATLAS_COLUMNS || set.rows < 1 || set.rows > MAX_ATLAS_ROWS {
        >> errors.new("nexus tilemap: tileset grid must be in 1...256")
    }
    if !fm.finite(set.draw_width) || !fm.finite(set.draw_height) ||
        set.draw_width <= 0.0 || set.draw_height <= 0.0 ||
        set.draw_width > 16384.0 || set.draw_height > 16384.0 {
        >> errors.new("nexus tilemap: tileset draw size must be in (0, 16384]")
    }
    if !fm.finite(set.origin.x) || !fm.finite(set.origin.y) ||
        set.origin.x < 0.0 || set.origin.x > 1.0 || set.origin.y < 0.0 || set.origin.y > 1.0 {
        >> errors.new("nexus tilemap: tileset origin must be in 0...1")
    }
    << 0
}

pub fn (set &TileSet2D) tile_count() int { << set.columns * set.rows }

pub fn (set &TileSet2D) tile_uv(tile int) fm.Rect2 {
    set.validate() >>>
    cols := set.columns
    rows := set.rows
    if cols < 1 || rows < 1 || tile < 0 || tile >= cols * rows {
        >> errors.new("nexus tilemap: tile index outside tileset")
    }
    col := tile % cols
    row := tile / cols
    left := f64(col) / f64(cols)
    top := f64(row) / f64(rows)
    right := f64(col + 1) / f64(cols)
    bottom := f64(row + 1) / f64(rows)
    << fm.rect2(left, top, right - left, bottom - top)
}

pub fn (set &TileSet2D) local_quad_bounds() fm.Rect2 {
    set.validate() >>>
    << fm.rect2(-set.origin.x * set.draw_width, -set.origin.y * set.draw_height, set.draw_width, set.draw_height)
}

// Pure CPU 2D / 2.5D tilemap supporting orthogonal, diamond isometric, and
// staggered isometric grids with per-cell elevation and tint and per-tile solidity.
pub struct TileMap2D {
    pub layout int
    pub width int
    pub height int
    pub tile_width f64
    pub tile_height f64
    pub elevation_step f64
    pub tileset TileSet2D
    cells []int
    elevations []f64
    tints []int
    solid_tiles map[int]bool
}

pub fn new_tilemap_2d(layout int, width int, height int, tile_width f64, tile_height f64,
    elevation_step f64, tileset TileSet2D) TileMap2D {
    if layout < LAYOUT_ORTHOGONAL || layout > LAYOUT_STAGGERED {
        >> errors.new("nexus tilemap: unsupported tilemap layout")
    }
    if width < 1 || width > MAX_MAP_WIDTH || height < 1 || height > MAX_MAP_HEIGHT || width * height > MAX_MAP_CELLS {
        >> errors.new("nexus tilemap: map dimensions exceed 512x512 / 65536 cells")
    }
    if !fm.finite(tile_width) || !fm.finite(tile_height) || tile_width <= 0.0 || tile_height <= 0.0 ||
        tile_width > 16384.0 || tile_height > 16384.0 {
        >> errors.new("nexus tilemap: tile dimensions must be in (0, 16384]")
    }
    if !fm.finite(elevation_step) || elevation_step < 0.0 || elevation_step > 4096.0 {
        >> errors.new("nexus tilemap: elevation step must be in 0...4096")
    }
    tileset.validate() >>>
    total := width * height
    $cells := []int{}
    $elevations := []f64{}
    $tints := []int{}
    for i in 0:total {
        cells.push(EMPTY_TILE)
        elevations.push(0.0)
        tints.push(4294967295)
    }
    << TileMap2D{
        layout: layout,
        width: width,
        height: height,
        tile_width: tile_width,
        tile_height: tile_height,
        elevation_step: elevation_step,
        tileset: tileset,
        cells: cells,
        elevations: elevations,
        tints: tints,
        solid_tiles: map[int]bool{}
    }
}

pub fn (grid &TileMap2D) validate() int {
    if grid.layout < LAYOUT_ORTHOGONAL || grid.layout > LAYOUT_STAGGERED {
        >> errors.new("nexus tilemap: unsupported tilemap layout")
    }
    if grid.width < 1 || grid.width > MAX_MAP_WIDTH || grid.height < 1 || grid.height > MAX_MAP_HEIGHT ||
        grid.width * grid.height > MAX_MAP_CELLS {
        >> errors.new("nexus tilemap: map dimensions exceed 512x512 / 65536 cells")
    }
    if !fm.finite(grid.tile_width) || !fm.finite(grid.tile_height) ||
        grid.tile_width <= 0.0 || grid.tile_height <= 0.0 ||
        grid.tile_width > 16384.0 || grid.tile_height > 16384.0 {
        >> errors.new("nexus tilemap: tile dimensions must be in (0, 16384]")
    }
    if !fm.finite(grid.elevation_step) || grid.elevation_step < 0.0 || grid.elevation_step > 4096.0 {
        >> errors.new("nexus tilemap: elevation step must be in 0...4096")
    }
    grid.tileset.validate() >>>
    total := grid.width * grid.height
    if grid.cells.len != total || grid.elevations.len != total || grid.tints.len != total {
        >> errors.new("nexus tilemap: cell array length mismatch")
    }
    max_tile := grid.tileset.tile_count()
    for tile, solid in grid.solid_tiles {
        if tile < 0 || tile >= max_tile || !solid { >> errors.new("nexus tilemap: invalid solid tile") }
    }
    for i in 0:total {
        tile := grid.cells[i]
        if tile != EMPTY_TILE && (tile < 0 || tile >= max_tile) {
            >> errors.new("nexus tilemap: cell tile index outside tileset")
        }
        elev := grid.elevations[i]
        if !fm.finite(elev) || math.abs(elev) > 1000.0 {
            >> errors.new("nexus tilemap: cell elevation outside -1000...1000")
        }
        tint := grid.tints[i]
        if tint < 0 || tint > 4294967295 {
            >> errors.new("nexus tilemap: cell tint must be valid RGBA8")
        }
    }
    << 0
}

pub fn (grid &TileMap2D) clone() TileMap2D {
    grid.validate() >>>
    $cells := []int{}
    $elevations := []f64{}
    $tints := []int{}
    $solid_tiles := map[int]bool{}
    for tile, solid in grid.solid_tiles { solid_tiles[tile] = solid }
    for i in 0:grid.cells.len {
        cells.push(grid.cells[i])
        elevations.push(grid.elevations[i])
        tints.push(grid.tints[i])
    }
    << TileMap2D{
        layout: grid.layout,
        width: grid.width,
        height: grid.height,
        tile_width: grid.tile_width,
        tile_height: grid.tile_height,
        elevation_step: grid.elevation_step,
        tileset: grid.tileset,
        cells: cells,
        elevations: elevations,
        tints: tints,
        solid_tiles: solid_tiles
    }
}

pub fn (grid &TileMap2D) in_bounds(col int, row int) bool {
    << col >= 0 && col < grid.width && row >= 0 && row < grid.height
}

fn (grid &TileMap2D) cell_index(col int, row int) int {
    if !grid.in_bounds(col, row) { >> errors.new("nexus tilemap: cell outside map bounds") }
    << row * grid.width + col
}

pub fn (grid &TileMap2D) cell(col int, row int) int {
    index := grid.cell_index(col, row) >>>
    << grid.cells[index]
}

pub fn (grid $&TileMap2D) set_cell(col int, row int, tile int) int {
    index := grid.cell_index(col, row) >>>
    if tile != EMPTY_TILE && (tile < 0 || tile >= grid.tileset.tile_count()) {
        >> errors.new("nexus tilemap: tile index outside tileset")
    }
    grid.cells[index] = tile
    << 0
}

pub fn (grid &TileMap2D) solid_tile_count() int { << grid.solid_tiles.len() }
pub fn (grid &TileMap2D) tile_is_solid(tile int) bool { << grid.solid_tiles.has(tile) }

pub fn (grid &TileMap2D) solid_tile_ids() []int {
    $tiles := []int{}
    if grid.solid_tiles.len() > 0 {
        for tile in 0:grid.tileset.tile_count() {
            if grid.solid_tiles.has(tile) { tiles.push(tile) }
        }
    }
    << tiles
}

pub fn (grid $&TileMap2D) set_tile_solid(tile int, solid bool) int {
    if tile < 0 || tile >= grid.tileset.tile_count() {
        >> errors.new("nexus tilemap: solid tile index outside tileset")
    }
    $solids := $&grid.solid_tiles
    if solid { solids[tile] = true } else { solids.delete(tile) }
    << 0
}

pub fn (grid &TileMap2D) cell_is_solid(col int, row int) bool {
    tile := grid.cell(col, row) >>>
    << grid.tile_is_solid(tile)
}

pub fn (grid &TileMap2D) elevation(col int, row int) f64 {
    index := grid.cell_index(col, row) >>>
    << grid.elevations[index]
}

pub fn (grid $&TileMap2D) set_elevation(col int, row int, elevation f64) int {
    index := grid.cell_index(col, row) >>>
    if !fm.finite(elevation) || math.abs(elevation) > 1000.0 {
        >> errors.new("nexus tilemap: cell elevation outside -1000...1000")
    }
    grid.elevations[index] = elevation
    << 0
}

pub fn (grid &TileMap2D) tint(col int, row int) int {
    index := grid.cell_index(col, row) >>>
    << grid.tints[index]
}

pub fn (grid $&TileMap2D) set_tint(col int, row int, rgba int) int {
    index := grid.cell_index(col, row) >>>
    if rgba < 0 || rgba > 4294967295 {
        >> errors.new("nexus tilemap: cell tint must be valid RGBA8")
    }
    grid.tints[index] = rgba
    << 0
}

// Logical ground-plane center of (col, row) in TileMap local coordinates (+Y down).
pub fn (grid &TileMap2D) cell_center(col int, row int) fm.Vec2 {
    if grid.layout == LAYOUT_ORTHOGONAL {
        << fm.vec2((f64(col) + 0.5) * grid.tile_width, (f64(row) + 0.5) * grid.tile_height)
    }
    half_w := grid.tile_width * 0.5
    half_h := grid.tile_height * 0.5
    if grid.layout == LAYOUT_ISOMETRIC {
        << fm.vec2(f64(col - row) * half_w, f64(col + row) * half_h)
    }
    // LAYOUT_STAGGERED: odd rows shift right by half a tile, vertical pitch is half_h.
    $offset := 0.0
    if row % 2 != 0 { offset = half_w }
    << fm.vec2(f64(col) * grid.tile_width + offset, f64(row) * half_h)
}

// Visual draw anchor shifted upward (-Y) by elevation * elevation_step.
pub fn (grid &TileMap2D) cell_visual_center(col int, row int) fm.Vec2 {
    index := grid.cell_index(col, row) >>>
    base := grid.cell_center(col, row)
    << fm.vec2(base.x, base.y - grid.elevations[index] * grid.elevation_step)
}

// Ground-plane depth key used for Y-Sort interleaving with actors and props.
pub fn (grid &TileMap2D) cell_sort_y(col int, row int) f64 {
    << grid.cell_center(col, row).y
}

// Exact inverse mapping from local 2D point on the ground plane to grid cell.
pub fn (grid &TileMap2D) point_to_cell(local fm.Vec2) CellCoord {
    if !fm.finite(local.x) || !fm.finite(local.y) {
        >> errors.new("nexus tilemap: non-finite pick coordinate")
    }
    if grid.layout == LAYOUT_ORTHOGONAL {
        col := int(math.floor(local.x / grid.tile_width))
        row := int(math.floor(local.y / grid.tile_height))
        << CellCoord{col: col, row: row}
    }
    half_w := grid.tile_width * 0.5
    half_h := grid.tile_height * 0.5
    if grid.layout == LAYOUT_ISOMETRIC {
        u := local.x / half_w
        v := local.y / half_h
        col := int(math.floor((u + v) * 0.5 + 0.5))
        row := int(math.floor((v - u) * 0.5 + 0.5))
        << CellCoord{col: col, row: row}
    }
    // Staggered diamond picking: test the nearest coarse staggered candidates by L1 diamond metric.
    approx_row := int(math.floor(local.y / half_h + 0.5))
    $best_col := 0
    $best_row := approx_row
    $best_dist := 1e300
    for r_idx in 0:3 {
        dr := r_idx - 1
        cand_row := approx_row + dr
        $row_offset := 0.0
        if cand_row % 2 != 0 { row_offset = half_w }
        approx_col := int(math.floor((local.x - row_offset) / grid.tile_width + 0.5))
        for c_idx in 0:3 {
            dc := c_idx - 1
            cand_col := approx_col + dc
            center := grid.cell_center(cand_col, cand_row)
            dist := math.abs(local.x - center.x) / half_w + math.abs(local.y - center.y) / half_h
            if dist < best_dist {
                best_dist = dist
                best_col = cand_col
                best_row = cand_row
            }
        }
    }
    << CellCoord{col: best_col, row: best_row}
}

// Deterministic back-to-front cell order for direct batch recording.
pub fn (grid &TileMap2D) draw_order() []CellCoord {
    grid.validate() >>>
    $order := []CellCoord{}
    if grid.layout == LAYOUT_ISOMETRIC {
        max_diag := grid.width + grid.height - 1
        for diag in 0:max_diag {
            for row in 0:grid.height {
                col := diag - row
                if col >= 0 && col < grid.width {
                    order.push(CellCoord{col: col, row: row})
                }
            }
        }
        << order
    }
    for row in 0:grid.height {
        for col in 0:grid.width {
            order.push(CellCoord{col: col, row: row})
        }
    }
    << order
}

// Parallax depth scaling for 2.5D background/midground/foreground layers.
pub struct Parallax2D {
    pub scroll_scale fm.Vec2
    pub scroll_offset fm.Vec2
}

pub fn parallax_2d(scale_x f64, scale_y f64, offset_x f64, offset_y f64) Parallax2D {
    layer := Parallax2D{scroll_scale: fm.vec2(scale_x, scale_y), scroll_offset: fm.vec2(offset_x, offset_y)}
    layer.validate() >>>
    << layer
}

pub fn (layer &Parallax2D) validate() int {
    if !fm.finite(layer.scroll_scale.x) || !fm.finite(layer.scroll_scale.y) ||
        math.abs(layer.scroll_scale.x) > 100.0 || math.abs(layer.scroll_scale.y) > 100.0 ||
        !fm.finite(layer.scroll_offset.x) || !fm.finite(layer.scroll_offset.y) ||
        math.abs(layer.scroll_offset.x) > 1000000.0 || math.abs(layer.scroll_offset.y) > 1000000.0 {
        >> errors.new("nexus tilemap: invalid parallax scroll scale or offset")
    }
    << 0
}
