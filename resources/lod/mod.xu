@"github.com/xulang-org/nexus/resources/lod"

#math
#errors

pub const MAX_LEVELS = 8
// Distance is measured in authored world units. This is an immutable choice
// policy, independent of meshes, cameras, nodes, files and GPU ownership.
pub struct DistanceLod { thresholds []f64
    hysteresis f64 }
pub fn distance_lod(thresholds []f64, hysteresis f64) DistanceLod {
    result := DistanceLod{thresholds: thresholds,hysteresis: hysteresis}
    result.validate() or >>
    << result
}
pub fn (policy &DistanceLod) validate() int {
    if policy.thresholds.len>=MAX_LEVELS || math.is_nan(policy.hysteresis) || math.is_inf(policy.hysteresis) ||
        policy.hysteresis<0.0 || policy.hysteresis>=0.5 { >> errors.new("nexus LOD: invalid level count or hysteresis") }
    $previous := 0.0
    for distance in policy.thresholds {
        if math.is_nan(distance) || math.is_inf(distance) || distance<=previous || distance>1000000000.0 {
            >> errors.new("nexus LOD: thresholds must increase within 0...1e9 world units")
        }
        previous=distance
    }
    << 0
}
pub fn (policy &DistanceLod) level_count() int { << policy.thresholds.len+1 }
pub fn (policy &DistanceLod) hysteresis() f64 { << policy.hysteresis }
pub fn (policy &DistanceLod) threshold(index int) f64 {
    if index<0 || index>=policy.thresholds.len { >> errors.new("nexus LOD: threshold index outside policy") }
    << policy.thresholds[index]
}
// -1 is first selection: nominal thresholds apply. Thereafter coarsen at
// threshold*(1+h), refine strictly below threshold*(1-h). Teleports can cross
// several levels in one call; a stationary point never oscillates by itself.
pub fn (policy &DistanceLod) choose(distance f64, current int) int {
    policy.validate() or >>
    if math.is_nan(distance) || math.is_inf(distance) || distance<0.0 || current < -1 || current>=policy.level_count() {
        >> errors.new("nexus LOD: invalid distance or current level")
    }
    $level := current
    if level<0 {
        level=0
        while level<policy.thresholds.len && distance>=policy.thresholds[level] { level+=1 }
        << level
    }
    while level<policy.thresholds.len && distance>=policy.thresholds[level]*(1.0+policy.hysteresis) { level+=1 }
    while level>0 && distance<policy.thresholds[level-1]*(1.0-policy.hysteresis) { level-=1 }
    << level
}
