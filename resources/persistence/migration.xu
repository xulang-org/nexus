@"github.com/xulang-org/nexus/resources/persistence"

#crypto/sha256
#encoding/json
#errors
#strings

pub const SAVE_ENVELOPE_FORMAT = "nexus.save"

pub struct SaveEnvelope {
    pub format string
    pub schema_version int
    pub checksum string
    pub payload string
}

pub fn wrap_save_envelope(schema_version int, payload string) SaveEnvelope {
    if schema_version < 1 {
        >> errors.new("nexus persistence: save schema_version must be >= 1")
    }
    if payload.len == 0 || payload.len > MANIFEST_MAX_BYTES {
        >> errors.new("nexus persistence: save payload size out of bounds")
    }
    parsed := json.parse_max(&payload, MANIFEST_MAX_BYTES)
    if !parsed.ok() {
        >> errors.new("nexus persistence: save payload is not valid JSON: " + parsed.error())
    }
    sum := sha256.sum256(payload + "")
    << SaveEnvelope{
        format: SAVE_ENVELOPE_FORMAT,
        schema_version: schema_version,
        checksum: sum,
        payload: payload
    }
}

pub fn (e &SaveEnvelope) verify() int {
    if e.format != SAVE_ENVELOPE_FORMAT {
        >> errors.new("nexus persistence: invalid save envelope format")
    }
    if e.schema_version < 1 {
        >> errors.new("nexus persistence: invalid save schema_version")
    }
    if e.payload.len == 0 || e.payload.len > MANIFEST_MAX_BYTES {
        >> errors.new("nexus persistence: invalid save payload length")
    }
    parsed := json.parse_max(&e.payload, MANIFEST_MAX_BYTES)
    if !parsed.ok() {
        >> errors.new("nexus persistence: save payload is invalid JSON: " + parsed.error())
    }
    expected := sha256.sum256(e.payload + "")
    if e.checksum != expected {
        >> errors.new("nexus persistence: save envelope SHA-256 checksum mismatch")
    }
    << 0
}

pub fn encode_envelope(e &SaveEnvelope) string {
    e.verify() >>>
    $out := strings.new_byte_builder(1024)
    fmt := e.format + ""
    cs := e.checksum + ""
    pl := e.payload + ""
    out.write_str("{\"format\":" + json.quote(&fmt) +
        ",\"schema_version\":" + str(e.schema_version) +
        ",\"checksum\":" + json.quote(&cs) +
        ",\"payload\":" + json.quote(&pl) + "}\n")
    << out.to_string()
}

pub fn decode_envelope(raw &string) SaveEnvelope {
    if raw.len == 0 || raw.len > MANIFEST_MAX_BYTES * 2 {
        >> errors.new("nexus persistence: save envelope file size out of bounds")
    }
    doc := json.parse_max(raw, MANIFEST_MAX_BYTES * 2)
    if !doc.ok() {
        >> errors.new("nexus persistence: save envelope JSON parse error: " + doc.error())
    }
    root := doc.root()
    if !doc.is_dict(root) {
        >> errors.new("nexus persistence: save envelope root must be JSON object")
    }
    env := SaveEnvelope{
        format: doc.as_string(doc.get(root, "format")) >>>,
        schema_version: doc.as_int(doc.get(root, "schema_version")) >>>,
        checksum: doc.as_string(doc.get(root, "checksum")) >>>,
        payload: doc.as_string(doc.get(root, "payload")) >>>
    }
    env.verify() >>>
    << env
}

pub struct KeyRename {
    pub old_key string
    pub new_key string
}

pub struct KeyDefault {
    pub key string
    pub raw_json_value string
}

pub struct MigrationStep {
    pub from_version int
    pub to_version int
    pub description string
    pub rename_keys []KeyRename
    pub inject_defaults []KeyDefault
    pub remove_keys []string
}

pub struct SaveMigrationChain {
    steps []MigrationStep
}

pub struct MigrationReport {
    pub from_version int
    pub to_version int
    pub steps_applied []string
    pub envelope SaveEnvelope
}

pub fn new_migration_chain() SaveMigrationChain {
    << SaveMigrationChain{steps: []MigrationStep{}}
}

fn clone_step(step &MigrationStep) MigrationStep {
    $rk := []KeyRename{}
    for i in 0:step.rename_keys.len {
        rk.push(KeyRename{
            old_key: step.rename_keys[i].old_key + "",
            new_key: step.rename_keys[i].new_key + ""
        })
    }
    $id := []KeyDefault{}
    for i in 0:step.inject_defaults.len {
        id.push(KeyDefault{
            key: step.inject_defaults[i].key + "",
            raw_json_value: step.inject_defaults[i].raw_json_value + ""
        })
    }
    $rm := []string{}
    for i in 0:step.remove_keys.len {
        rm.push(step.remove_keys[i] + "")
    }
    << MigrationStep{
        from_version: step.from_version,
        to_version: step.to_version,
        description: step.description + "",
        rename_keys: rk,
        inject_defaults: id,
        remove_keys: rm
    }
}

pub fn (c $&SaveMigrationChain) add_step(step MigrationStep) int {
    if step.from_version < 1 || step.to_version <= step.from_version {
        >> errors.new("nexus persistence: migration step must advance from >= 1 to a higher version")
    }
    if step.description.len == 0 {
        >> errors.new("nexus persistence: migration step requires description")
    }
    for i in 0:c.steps.len {
        if c.steps[i].from_version == step.from_version {
            >> errors.new("nexus persistence: duplicate migration source version")
        }
    }
    for i in 0:step.rename_keys.len {
        rk := &step.rename_keys[i]
        if rk.old_key.len == 0 || rk.new_key.len == 0 {
            >> errors.new("nexus persistence: KeyRename keys must be non-empty")
        }
    }
    for i in 0:step.inject_defaults.len {
        df := &step.inject_defaults[i]
        if df.key.len == 0 {
            >> errors.new("nexus persistence: KeyDefault key must be non-empty")
        }
        p := json.parse_max(&df.raw_json_value, 65536)
        if !p.ok() {
            >> errors.new("nexus persistence: invalid KeyDefault raw_json_value for " + df.key)
        }
    }
    c.steps.push(clone_step(&step))
    << 0
}

fn step_should_remove(step &MigrationStep, k &string) bool {
    for i in 0:step.remove_keys.len {
        if step.remove_keys[i] == *k { << true }
    }
    << false
}

fn step_renamed_key(step &MigrationStep, k &string) string {
    for i in 0:step.rename_keys.len {
        if step.rename_keys[i].old_key == *k {
            << step.rename_keys[i].new_key + ""
        }
    }
    << *k + ""
}

fn apply_migration_step(payload &string, step &MigrationStep) string {
    doc := json.parse_max(payload, MANIFEST_MAX_BYTES)
    if !doc.ok() { >> errors.new("nexus persistence: migration input payload invalid JSON") }
    root := doc.root()
    if !doc.is_dict(root) { >> errors.new("nexus persistence: migration requires top-level JSON object") }

    orig_keys := doc.dict_keys(root)
    $out_keys := []string{}
    $out_vals := []string{}
    $present := map[string]bool{}

    for i in 0:orig_keys.len {
        old_k := orig_keys[i] + ""
        if step_should_remove(step, &old_k) { -> }
        new_k := step_renamed_key(step, &old_k)
        if present.has(new_k + "") {
            >> errors.new("nexus persistence: migration key rename collision on " + new_k)
        }
        present[new_k + ""] = true
        out_keys.push(new_k + "")
        if new_k == "schema_version" {
            out_vals.push(str(step.to_version))
        } else {
            vnode := doc.get(root, old_k)
            out_vals.push(doc.encode(vnode) >>>)
        }
    }

    for i in 0:step.inject_defaults.len {
        df := &step.inject_defaults[i]
        dk := df.key + ""
        if !present.has(dk) {
            present[dk] = true
            out_keys.push(dk)
            out_vals.push(df.raw_json_value + "")
        }
    }

    $b := strings.new_byte_builder(payload.len + 256)
    b.write_str("{")
    for i in 0:out_keys.len {
        if i > 0 { b.write_str(",") }
        k := out_keys[i] + ""
        b.write_str(json.quote(&k) + ":" + out_vals[i])
    }
    b.write_str("}")
    next_raw := b.to_string()
    recheck := json.parse_max(&next_raw, MANIFEST_MAX_BYTES)
    if !recheck.ok() {
        >> errors.new("nexus persistence: migrated payload failed JSON validation: " + recheck.error())
    }
    << next_raw
}

pub fn (c &SaveMigrationChain) migrate(envelope &SaveEnvelope, target_version int) MigrationReport {
    envelope.verify() >>>
    if target_version < 1 {
        >> errors.new("nexus persistence: target_version must be >= 1")
    }
    if target_version < envelope.schema_version {
        >> errors.new("nexus persistence: save schema downgrade is not allowed")
    }
    $cur_ver := envelope.schema_version
    $cur_payload := envelope.payload + ""
    $applied := []string{}
    $hops := 0
    while cur_ver < target_version {
        if hops > 64 { >> errors.new("nexus persistence: migration chain exceeded 64 hops") }
        $found_idx := -1
        for i in 0:c.steps.len {
            if c.steps[i].from_version == cur_ver {
                found_idx = i
                <-
            }
        }
        if found_idx < 0 {
            >> errors.new("nexus persistence: missing migration step from schema v" + str(cur_ver))
        }
        step := &c.steps[found_idx]
        cur_payload = apply_migration_step(&cur_payload, step) >>>
        cur_ver = step.to_version
        applied.push(step.description + "")
        hops += 1
    }
    if cur_ver != target_version {
        >> errors.new("nexus persistence: migration overshot target_version")
    }
    out_env := wrap_save_envelope(target_version, cur_payload) >>>
    << MigrationReport{
        from_version: envelope.schema_version,
        to_version: target_version,
        steps_applied: applied,
        envelope: out_env
    }
}
