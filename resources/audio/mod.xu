@"github.com/xulang-org/nexus/resources/audio"

#errors
#strings
#crypto/sha256

pub const MAX_SAMPLES = 8388608
// Immutable normalized signed PCM16, interleaved mono/stereo. No device lifetime.
pub struct Clip {
    rate int
    channels int
    samples []int
    digest string
}
pub fn fingerprint_pcm16(rate int, channels int, samples &[]int) string {
    if rate < 8000 || rate > 192000 || channels < 1 || channels > 2 || samples.len < channels ||
        samples.len > MAX_SAMPLES || (channels == 2 && samples.len % 2 != 0) { >>> errors.new("nexus audio: invalid PCM dimensions") }
    $bytes := strings.new_byte_builder(samples.len * 2)
    for sample in samples {
        if sample < -32768 || sample > 32767 { >>> errors.new("nexus audio: invalid PCM16 sample") }
        bytes.write_byte(sample & 255)
        bytes.write_byte((sample >> 8) & 255)
    }
    raw := bytes.to_string()
    << sha256.sum256(str(rate) + ":" + str(channels) + ":" + raw)
}
pub fn pcm16(rate int, channels int, samples []int) Clip {
    digest := fingerprint_pcm16(rate, channels, &samples) >>>
    << Clip{rate: rate, channels: channels, samples: samples, digest: digest}
}
pub fn (clip &Clip) sample_rate() int { << clip.rate }
pub fn (clip &Clip) channel_count() int { << clip.channels }
pub fn (clip &Clip) sample_count() int { << clip.samples.len }
pub fn (clip &Clip) frame_count() int {
    if clip.channels == 1 { << clip.samples.len }
    if clip.channels == 2 { << clip.samples.len / 2 }
    << 0
}
pub fn (clip &Clip) fingerprint() string { << clip.digest + "" }
pub fn (clip &Clip) sample(frame int, channel int) int {
    if frame < 0 || frame >= clip.frame_count() || channel < 0 || channel >= clip.channels { >>> errors.new("nexus audio: sample index outside clip") }
    << clip.samples[frame * clip.channels + channel]
}
pub fn (clip &Clip) validate() int {
    if clip.rate < 8000 || clip.rate > 192000 || clip.channels < 1 || clip.channels > 2 || clip.samples.len < clip.channels ||
        clip.samples.len > MAX_SAMPLES || (clip.channels == 2 && clip.samples.len % 2 != 0) || clip.digest.len != 64 { >>> errors.new("nexus audio: invalid PCM clip") }
    << 0
}
