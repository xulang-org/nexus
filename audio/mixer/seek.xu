@"github.com/xulang-org/nexus/audio/mixer"

#math
#errors

// A transport command retains instantaneous gain/balance/pause and cancels
// pending envelopes, including fade-stop. It never changes the voice identity.
fn reset_transport(voice $&Voice, phase int, resume bool, ended bool) {
    voice.phase = phase
    // Hold the exact existing envelope value, including sub-millistep fractions.
    // Re-quantizing it to a control value here would introduce a seek gain step.
    voice.fade_hold = true
    voice.fade_stop = false
    if ended { voice.playing = false
    } else if resume { voice.playing = true }
}
fn (mixer $&Mixer) position_clip(id int, frame int, resume bool) int {
    index := mixer.voice_index(id) >>>
    source := mixer.voices[index].clip
    if source < 0 { >>> errors.new("nexus mixer: seek streamed voices through their producer") }
    count := mixer.clips[source].frame_count()
    if frame < 0 || frame > count { >>> errors.new("nexus mixer: seek outside clip") }
    $target := frame
    if mixer.voices[index].looping && target == count { target = 0 }
    phase := target * mixer.rate
    voice := $&mixer.voices[index]
    reset_transport(voice, phase, resume, target == count)
    mixer.revision = mixer.revision + 1
    << target
}
pub fn (mixer $&Mixer) seek_voice(id int, frame int) int {
    << mixer.position_clip(id, frame, false) >>>
}
pub fn (mixer $&Mixer) seek_voice_seconds(id int, seconds f64) int {
    index := mixer.voice_index(id) >>>
    source := mixer.voices[index].clip
    if source < 0 { >>> errors.new("nexus mixer: seek streamed voices through their producer") }
    rate := mixer.clips[source].sample_rate()
    if rate == 0 { >>> errors.new("nexus mixer: zero clip rate") }
    duration := f64(mixer.clips[source].frame_count()) / f64(rate)
    if math.is_nan(seconds) || math.is_inf(seconds) || seconds < 0.0 || seconds > duration { >>> errors.new("nexus mixer: invalid seek time") }
    frame := int(math.round_to_even(seconds * f64(rate)))
    << mixer.position_clip(id, frame, false) >>>
}
pub fn (mixer $&Mixer) restart_voice(id int) int {
    << mixer.position_clip(id, 0, true) >>>
}
