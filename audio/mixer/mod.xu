@"github.com/xulang-org/nexus/audio/mixer"

pcm #"github.com/xulang-org/nexus/resources/audio"
#errors
#math

pub const MAX_VOICES = 32
pub const MAX_BUSES = 16
pub const MAX_CLIPS = 64
pub const MAX_BANK_SAMPLES = 8388608
pub const MAX_BLOCK_FRAMES = 4096
struct Voice {
    generation int
    allocated bool
    playing bool
    clip int
    bus int
    phase int
    gain int
    pan int
    paused bool
    looping bool
    fade_start int
    fade_target int
    fade_total int
    fade_position int
    fade_stop bool
    fade_hold bool
    pitch_milli int
    itd_frames int
    gain_l_milli int
    gain_r_milli int
    lpf_alpha_l f64
    lpf_alpha_r f64
    lpf_state_l f64
    lpf_state_r f64
}
struct Bus { parent int
    gain int
    muted bool
    paused bool
    name string
    dsp BusDsp }
pub struct Mixer {
    rate int
    voices []Voice
    buses []Bus
    clips []pcm.Clip
    bank_samples int
    revision int
    bank_hash int
    stream_hash int
    streams []PcmStream
    stream_samples int
    scratch_l [][]f64
    scratch_r [][]f64
}
// MixBlock is a preview. Only commit after its samples reach the intended sink.
// Its integer revision & bank/stream hashes ensure another mixer or mutated state
// cannot accept a stale or foreign receipt.
pub struct MixBlock {
    pub samples []int
    stamp_rev int
    stamp_bank int
    stamp_stream int
    stamp_rate int
    stamp_voices int
    stamp_buses int
    phases []int
    playing []bool
    frames int
    fade_positions []int
    dsp_next []BusDsp
    lpf_l []f64
    lpf_r []f64
    pub underruns int
}
pub fn new_mixer(rate int, capacity int) Mixer {
    if rate < 8000 || rate > 192000 || capacity < 1 || capacity > MAX_VOICES { >> errors.new("nexus mixer: invalid sample rate or capacity") }
    $voices := []Voice{}
    for i in 0:capacity { voices.push(Voice{generation: 0, allocated: false, playing: false, clip: 0, bus: 0, phase: 0,
        gain: 1000, pan: 0, paused: false, looping: false, fade_start: 1000, fade_target: 1000, fade_total: 0, fade_position: 0, fade_stop: false, fade_hold: false,
        pitch_milli: 1000, itd_frames: 0, gain_l_milli: -1, gain_r_milli: -1, lpf_alpha_l: 1.0, lpf_alpha_r: 1.0, lpf_state_l: 0.0, lpf_state_r: 0.0}) }
    $streams := []PcmStream{}
    for i in 0:MAX_STREAMS { streams.push(empty_stream(0)) }
    << Mixer{rate: rate, voices: voices, buses: [Bus{parent: -1, gain: 1000, muted: false, paused: false, name: "Master", dsp: default_bus_dsp()}],
        clips: []pcm.Clip{}, bank_samples: 0, revision: 0, bank_hash: 1469598103934665603, stream_hash: 1469598103934665603,
        streams: streams, stream_samples: 0, scratch_l: [][]f64{}, scratch_r: [][]f64{}}
}
fn control(value f64, minimum f64, maximum f64) int {
    if math.is_nan(value) || math.is_inf(value) || value < minimum || value > maximum { >> errors.new("nexus mixer: invalid gain or pan") }
    << int(math.round_to_even(value * 1000.0))
}
fn flag(value bool) int { if value { << 1 }
    << 0 }
fn (mixer &Mixer) valid() int {
    if mixer.rate < 8000 || mixer.rate > 192000 || mixer.voices.len < 1 || mixer.voices.len > MAX_VOICES || mixer.buses.len < 1 {
        >> errors.new("nexus mixer: uninitialized mixer")
    }
    << 0
}
pub fn (mixer &Mixer) sample_rate() int { << mixer.rate }
pub fn (mixer &Mixer) clip_count() int { << mixer.clips.len }
pub fn (mixer &Mixer) bank_sample_count() int { << mixer.bank_samples }
pub fn (mixer &Mixer) bus_count() int { << mixer.buses.len }
pub fn (mixer $&Mixer) add_clip(clip pcm.Clip) int {
    mixer.valid() >>>
    clip.validate() >>>
    if mixer.clips.len >= MAX_CLIPS || clip.sample_count() > MAX_BANK_SAMPLES - mixer.bank_samples { >> errors.new("nexus mixer: PCM bank capacity exceeded") }
    index := mixer.clips.len
    fp := clip.fingerprint()
    mixer.bank_hash = mix_hash_str(mix_hash_int(mixer.bank_hash, clip.sample_rate() * 13 + clip.channel_count()), &fp)
    mixer.bank_samples = mixer.bank_samples + clip.sample_count()
    mixer.clips.push(clip)
    mixer.revision = mixer.revision + 1
    << index
}
fn (mixer &Mixer) bus_index(bus int) int {
    mixer.valid() >>>
    if bus < 0 || bus >= mixer.buses.len { >> errors.new("nexus mixer: invalid bus") }
    << bus
}
pub fn (mixer $&Mixer) add_bus(parent int, name string, volume f64) int {
    mixer.bus_index(parent) >>>
    gain := control(volume, 0.0, 4.0) >>>
    if name.len < 1 || name.len > 63 || mixer.buses.len >= MAX_BUSES { >> errors.new("nexus mixer: invalid bus name or capacity") }
    for i in 0:mixer.buses.len { if mixer.buses[i].name == name { >> errors.new("nexus mixer: duplicate bus name") } }
    index := mixer.buses.len
    mixer.buses.push(Bus{parent: parent, gain: gain, muted: false, paused: false, name: name, dsp: default_bus_dsp()})
    mixer.revision = mixer.revision + 1
    << index
}
pub fn (mixer $&Mixer) set_bus_volume(bus int, volume f64) int {
    mixer.bus_index(bus) >>>
    gain := control(volume, 0.0, 4.0) >>>
    mixer.buses[bus].gain = gain
    mixer.revision = mixer.revision + 1
    << 0
}
pub fn (mixer $&Mixer) mute_bus(bus int, muted bool) int {
    mixer.bus_index(bus) >>>
    mixer.buses[bus].muted = muted
    mixer.revision = mixer.revision + 1
    << 0
}
pub fn (mixer $&Mixer) pause_bus(bus int, paused bool) int {
    mixer.bus_index(bus) >>>
    mixer.buses[bus].paused = paused
    mixer.revision = mixer.revision + 1
    << 0
}
fn (mixer $&Mixer) allocate(source int, bus int, volume f64, pan f64, looping bool, phase int) int {
    mixer.bus_index(bus) >>>
    gain := control(volume, 0.0, 4.0) >>>
    balance := control(pan, -1.0, 1.0) >>>
    for i in 0:mixer.voices.len {
        if !mixer.voices[i].playing {
            generation := mixer.voices[i].generation + 1
            if generation > 1000000000 { >> errors.new("nexus mixer: voice generation exhausted") }
            mixer.voices[i] = Voice{generation: generation, allocated: true, playing: true, clip: source, bus: bus, phase: phase,
                gain: gain, pan: balance, paused: false, looping: looping, fade_start: gain, fade_target: gain, fade_total: 0, fade_position: 0, fade_stop: false, fade_hold: false,
                pitch_milli: 1000, itd_frames: 0, gain_l_milli: -1, gain_r_milli: -1, lpf_alpha_l: 1.0, lpf_alpha_r: 1.0, lpf_state_l: 0.0, lpf_state_r: 0.0}
            mixer.revision = mixer.revision + 1
            << generation * MAX_VOICES + i + 1
        }
    }
    >> errors.new("nexus mixer: voice capacity exceeded")
}
pub fn (mixer $&Mixer) play(clip int, bus int, volume f64, pan f64, looping bool) int {
    if clip < 0 || clip >= mixer.clips.len { >> errors.new("nexus mixer: invalid clip") }
    << mixer.allocate(clip, bus, volume, pan, looping, 0) >>>
}
pub fn (mixer &Mixer) is_voice(id int) bool {
    if id <= 0 { << false }
    slot := (id - 1) % MAX_VOICES
    << slot < mixer.voices.len && mixer.voices[slot].allocated && mixer.voices[slot].generation == (id - 1) / MAX_VOICES
}
fn (mixer &Mixer) voice_index(id int) int {
    if !mixer.is_voice(id) { >> errors.new("nexus mixer: stale or invalid voice") }
    << (id - 1) % MAX_VOICES
}
pub fn (mixer &Mixer) is_playing(id int) bool { index := mixer.voice_index(id) >>>
    << mixer.voices[index].playing }
pub fn (mixer &Mixer) position_frames(id int) f64 { index := mixer.voice_index(id) >>>
    << f64(mixer.voices[index].phase) / f64(mixer.rate) }
pub fn (mixer $&Mixer) stop(id int) int { index := mixer.voice_index(id) >>>
    mixer.voices[index].playing = false
    mixer.revision = mixer.revision + 1
    << 0 }
pub fn (mixer $&Mixer) pause_voice(id int, paused bool) int { index := mixer.voice_index(id) >>>
    mixer.voices[index].paused = paused
    mixer.revision = mixer.revision + 1
    << 0 }
pub fn (mixer $&Mixer) set_volume(id int, volume f64) int {
    index := mixer.voice_index(id) >>>
    gain := control(volume, 0.0, 4.0) >>>
    mixer.voices[index].gain = gain
    mixer.voices[index].fade_total = 0
    mixer.voices[index].fade_position = 0
    mixer.voices[index].fade_stop = false
    mixer.voices[index].fade_hold = false
    mixer.revision = mixer.revision + 1
    << 0
}
pub fn (mixer $&Mixer) set_volume_smooth(id int, volume f64, ramp_ms f64) int {
    mixer.voice_index(id) >>>
    control(volume, 0.0, 4.0) >>>
    if math.is_nan(ramp_ms) || math.is_inf(ramp_ms) || ramp_ms < 0.0 || ramp_ms > 5000.0 {
        >> errors.new("nexus mixer: volume ramp_ms outside 0..5000")
    }
    if ramp_ms <= 0.000001 {
        << mixer.set_volume(id, volume) >>>
    }
    $frames := int(math.round_to_even(ramp_ms * f64(mixer.rate) / 1000.0))
    if frames < 1 { frames = 1 }
    << mixer.fade_volume(id, volume, frames, false) >>>
}
pub fn (mixer $&Mixer) set_pan(id int, pan f64) int {
    index := mixer.voice_index(id) >>>
    balance := control(pan, -1.0, 1.0) >>>
    mixer.voices[index].pan = balance
    mixer.revision = mixer.revision + 1
    << 0
}
fn clamp_mix(v f64, lo f64, hi f64) f64 {
    << math.max(lo, math.min(hi, v))
}

fn one_pole_alpha(cutoff_hz f64, rate int) f64 {
    if math.is_nan(cutoff_hz) || math.is_inf(cutoff_hz) || cutoff_hz < 20.0 {
        >> errors.new("nexus mixer: invalid LPF cutoff frequency")
    }
    if cutoff_hz >= f64(rate) * 0.45 { << 1.0 }
    rc := 1.0 / (6.283185307179586 * cutoff_hz)
    dt := 1.0 / f64(rate)
    << clamp_mix(dt / (rc + dt), 0.005, 1.0)
}

pub fn (mixer $&Mixer) set_pitch(id int, pitch f64) int {
    index := mixer.voice_index(id) >>>
    if math.is_nan(pitch) || math.is_inf(pitch) || pitch < 0.25 || pitch > 4.0 {
        >> errors.new("nexus mixer: pitch out of valid range 0.25..4.0")
    }
    mixer.voices[index].pitch_milli = int(math.round_to_even(pitch * 1000.0))
    mixer.revision = mixer.revision + 1
    << 0
}

pub fn (mixer $&Mixer) set_voice_lowpass(id int, cutoff_left_hz f64, cutoff_right_hz f64) int {
    index := mixer.voice_index(id) >>>
    al := one_pole_alpha(cutoff_left_hz, mixer.rate) >>>
    ar := one_pole_alpha(cutoff_right_hz, mixer.rate) >>>
    mixer.voices[index].lpf_alpha_l = al
    mixer.voices[index].lpf_alpha_r = ar
    mixer.revision = mixer.revision + 1
    << 0
}

pub fn (mixer $&Mixer) set_binaural(id int, itd_frames int, left_gain f64, right_gain f64, cutoff_left_hz f64, cutoff_right_hz f64) int {
    index := mixer.voice_index(id) >>>
    if itd_frames < -48 || itd_frames > 48 {
        >> errors.new("nexus mixer: ITD frames out of range -48..48")
    }
    if math.is_nan(left_gain) || math.is_inf(left_gain) || left_gain < 0.0 || left_gain > 2.0 ||
        math.is_nan(right_gain) || math.is_inf(right_gain) || right_gain < 0.0 || right_gain > 2.0 {
        >> errors.new("nexus mixer: binaural gain out of range 0.0..2.0")
    }
    al := one_pole_alpha(cutoff_left_hz, mixer.rate) >>>
    ar := one_pole_alpha(cutoff_right_hz, mixer.rate) >>>
    v := $&mixer.voices[index]
    v.itd_frames = itd_frames
    v.gain_l_milli = int(math.round_to_even(left_gain * 1000.0))
    v.gain_r_milli = int(math.round_to_even(right_gain * 1000.0))
    v.lpf_alpha_l = al
    v.lpf_alpha_r = ar
    mixer.revision = mixer.revision + 1
    << 0
}

pub fn (mixer $&Mixer) apply_spatial_3d(id int, res &Spatial3DResult) int {
    index := mixer.voice_index(id) >>>
    gain := control(res.volume, 0.0, 4.0) >>>
    pan := control(res.pan, -1.0, 1.0) >>>
    if math.is_nan(res.pitch) || math.is_inf(res.pitch) || res.pitch < 0.25 || res.pitch > 4.0 {
        >> errors.new("nexus mixer: spatial pitch out of range")
    }
    if res.itd_frames < -48 || res.itd_frames > 48 {
        >> errors.new("nexus mixer: spatial ITD out of range")
    }
    al := one_pole_alpha(res.lpf_cutoff_left_hz, mixer.rate) >>>
    ar := one_pole_alpha(res.lpf_cutoff_right_hz, mixer.rate) >>>
    gl := clamp_mix(res.left_gain, 0.0, 2.0)
    gr := clamp_mix(res.right_gain, 0.0, 2.0)
    v := $&mixer.voices[index]
    fade_active := v.fade_total > 0 && v.fade_position < v.fade_total
    v.pan = pan
    if !fade_active {
        v.gain = gain
        v.fade_total = 0
        v.fade_position = 0
        v.fade_stop = false
        v.fade_hold = false
    } else if !v.fade_stop {
        v.gain = gain
    }
    v.pitch_milli = int(math.round_to_even(res.pitch * 1000.0))
    v.itd_frames = res.itd_frames
    v.gain_l_milli = int(math.round_to_even(gl * 1000.0))
    v.gain_r_milli = int(math.round_to_even(gr * 1000.0))
    v.lpf_alpha_l = al
    v.lpf_alpha_r = ar
    mixer.revision = mixer.revision + 1
    << 0
}

fn (mixer &Mixer) any_bus_dsp_active() bool {
    for i in 0:mixer.buses.len {
        if mixer.buses[i].dsp.active() { << true }
    }
    << false
}
fn mix_hash_int(h int, v int) int {
    << ((h ^ v) * 1099511628211) & 0x3fffffffffffffff
}

fn mix_hash_str(h int, s &string) int {
    $acc := h
    for i in 0:s.len {
        acc = ((acc ^ (s[i] & 255)) * 1099511628211) & 0x3fffffffffffffff
    }
    << acc
}
struct BusState { gain f64
    paused bool }
fn (mixer &Mixer) bus_state(index int) BusState {
    $current := index
    $gain := 1.0
    $paused := false
    while current >= 0 {
        bus := &mixer.buses[current]
        gain = gain * f64(bus.gain) / 1000.0
        if bus.muted { gain = 0.0 }
        if bus.paused { paused = true }
        current = bus.parent
    }
    << BusState{gain: gain, paused: paused}
}
fn quantize(value f64) int { << int(math.round_to_even(math.max(-32768.0, math.min(32767.0, value)))) }
struct VoiceRenderOutcome {
    phase int
    active bool
    fade_position int
    lpf_l f64
    lpf_r f64
    underrun bool
}
fn sample_clip_at_phase_from(
    clips &[]pcm.Clip,
    streams &[]PcmStream,
    source &SourceInfo,
    clip_id int,
    raw_phase int,
    looping bool,
    rate int,
    channel int
) f64 {
    period := source.frames * rate
    if period <= 0 || rate <= 0 { << 0.0 }
    $ph := raw_phase
    if ph < 0 {
        if !looping { << 0.0 }
        ph = ((ph % period) + period) % period
    } else if ph >= period {
        if !looping { << 0.0 }
        ph = wrap_phase(ph, period)
    }
    at := ph / rate
    weight := f64(ph % rate) / f64(rate)
    $next := at + 1
    if next >= source.frames {
        if looping { next = 0 } else { next = at }
    }
    a := source_sample_from(clips, streams, clip_id, at, channel) >>>
    b := source_sample_from(clips, streams, clip_id, next, channel) >>>
    << f64(a) + f64(b - a) * weight
}
fn mix_voice_into_from(
    clips &[]pcm.Clip,
    streams &[]PcmStream,
    voice &Voice,
    bus_gain f64,
    frames int,
    rate int,
    left $&[]f64,
    right $&[]f64
) VoiceRenderOutcome {
    source := source_info_from(clips, streams, voice.clip) >>>
    if rate < 1 { >> errors.new("nexus mixer: zero output rate") }
    period := source.frames * rate
    if !source.streaming && period == 0 { >> errors.new("nexus mixer: empty clip period") }
    $phase := voice.phase
    $active := true
    $fade_position := voice.fade_position
    $lpf_l := voice.lpf_state_l
    $lpf_r := voice.lpf_state_r
    $underrun := false
    $balance_left := 1.0 - math.max(f64(voice.pan) / 1000.0, 0.0)
    $balance_right := 1.0 + math.min(f64(voice.pan) / 1000.0, 0.0)
    if voice.gain_l_milli >= 0 && voice.gain_r_milli >= 0 {
        balance_left = f64(voice.gain_l_milli) / 1000.0
        balance_right = f64(voice.gain_r_milli) / 1000.0
    }
    $step := source.rate
    if voice.pitch_milli != 1000 {
        step = int(math.round_to_even(f64(source.rate) * f64(voice.pitch_milli) / 1000.0))
        if step < 1 { step = 1 }
    }
    for frame in 0:frames {
        if !source.streaming && phase >= period {
            if voice.looping { phase = wrap_phase(phase, period)
            } else { active = false
                <- }
        }
        at := phase / rate
        if source.streaming && at >= source.frames {
            if source.eof { active = false } else { underrun = true }
            <-
        }
        weight := f64(phase % rate) / f64(rate)
        $next := at + 1
        if next >= source.frames {
            if source.streaming && !source.eof && weight > 0.0 {
                underrun = true
                <-
            }
            if !source.streaming && voice.looping { next = 0 } else { next = at }
        }
        a := source_sample_from(clips, streams, voice.clip, at, 0) >>>
        b := source_sample_from(clips, streams, voice.clip, next, 0) >>>
        $l := f64(a) + f64(b - a) * weight
        $r := l
        if source.channels == 2 {
            c := source_sample_from(clips, streams, voice.clip, at, 1) >>>
            d := source_sample_from(clips, streams, voice.clip, next, 1) >>>
            r = f64(c) + f64(d - c) * weight
        }
        if voice.itd_frames > 0 && !source.streaming {
            l = sample_clip_at_phase_from(clips, streams, &source, voice.clip, phase - voice.itd_frames * step, voice.looping, rate, 0) >>>
        } else if voice.itd_frames < 0 && !source.streaming {
            $ch_r := 0
            if source.channels == 2 { ch_r = 1 }
            r = sample_clip_at_phase_from(clips, streams, &source, voice.clip, phase - (-voice.itd_frames) * step, voice.looping, rate, ch_r) >>>
        }
        if voice.lpf_alpha_l < 0.999999 {
            lpf_l = lpf_l + voice.lpf_alpha_l * (l - lpf_l)
            l = lpf_l
        }
        if voice.lpf_alpha_r < 0.999999 {
            lpf_r = lpf_r + voice.lpf_alpha_r * (r - lpf_r)
            r = lpf_r
        }
        if !voice.fade_hold && fade_position < voice.fade_total { fade_position = fade_position + 1 }
        gain := bus_gain * gain_at(voice, fade_position) / 1000.0
        left[frame] = left[frame] + l * gain * balance_left
        right[frame] = right[frame] + r * gain * balance_right
        phase = phase + step
        if voice.fade_stop && voice.fade_total > 0 && fade_position >= voice.fade_total {
            active = false
            <-
        }
    }
    if !source.streaming && voice.looping { phase = wrap_phase(phase, period)
    } else if source.eof && phase >= period { active = false }
    << VoiceRenderOutcome{phase: phase, active: active, fade_position: fade_position, lpf_l: lpf_l, lpf_r: lpf_r, underrun: underrun}
}
fn (mixer &Mixer) mix_voice_into(
    voice &Voice,
    bus_gain f64,
    frames int,
    rate int,
    left $&[]f64,
    right $&[]f64
) VoiceRenderOutcome {
    << mix_voice_into_from(&mixer.clips, &mixer.streams, voice, bus_gain, frames, rate, left, right) >>>
}
pub fn (mixer &Mixer) prepare(frames int) MixBlock {
    mixer.valid() >>>
    if frames < 1 || frames > MAX_BLOCK_FRAMES { >> errors.new("nexus mixer: invalid block frame count") }
    rate := mixer.rate
    if rate == 0 { >> errors.new("nexus mixer: zero output rate") }
    dsp_mode := mixer.any_bus_dsp_active()
    $phases := []int{}
    $playing := []bool{}
    $fade_positions := []int{}
    $lpf_l := []f64{}
    $lpf_r := []f64{}
    $underruns := 0
    $samples := []int{}
    $dsp_next := []BusDsp{}

    if !dsp_mode {
        $left := []f64{}
        $right := []f64{}
        for _ in 0:frames {
            left.push(0.0)
            right.push(0.0)
        }
        for i in 0:mixer.voices.len {
            voice := &mixer.voices[i]
            $phase := voice.phase
            $active := voice.playing
            $fade_position := voice.fade_position
            $vl := voice.lpf_state_l
            $vr := voice.lpf_state_r
            if active {
                state := mixer.bus_state(voice.bus)
                if !voice.paused && !state.paused {
                    out := mixer.mix_voice_into(voice, state.gain, frames, rate, $&left, $&right) >>>
                    phase = out.phase
                    active = out.active
                    fade_position = out.fade_position
                    vl = out.lpf_l
                    vr = out.lpf_r
                    if out.underrun { underruns += 1 }
                }
            }
            phases.push(phase)
            playing.push(active)
            fade_positions.push(fade_position)
            lpf_l.push(vl)
            lpf_r.push(vr)
        }
        for i in 0:frames {
            samples.push(quantize(left[i]))
            samples.push(quantize(right[i]))
        }
    } else {
        $bus_l := [][]f64{}
        $bus_r := [][]f64{}
        for b in 0:mixer.buses.len {
            $bl := []f64{}
            $br := []f64{}
            for _ in 0:frames {
                bl.push(0.0)
                br.push(0.0)
            }
            bus_l.push(bl)
            bus_r.push(br)
            dsp_next.push(clone_bus_dsp(&mixer.buses[b].dsp))
        }
        for i in 0:mixer.voices.len {
            voice := &mixer.voices[i]
            $phase := voice.phase
            $active := voice.playing
            $fade_position := voice.fade_position
            $vl := voice.lpf_state_l
            $vr := voice.lpf_state_r
            if active {
                state := mixer.bus_state(voice.bus)
                if !voice.paused && !state.paused {
                    vb := voice.bus
                    out := mixer.mix_voice_into(voice, 1.0, frames, rate, $&bus_l[vb], $&bus_r[vb]) >>>
                    phase = out.phase
                    active = out.active
                    fade_position = out.fade_position
                    vl = out.lpf_l
                    vr = out.lpf_r
                    if out.underrun { underruns += 1 }
                }
            }
            phases.push(phase)
            playing.push(active)
            fade_positions.push(fade_position)
            lpf_l.push(vl)
            lpf_r.push(vr)
        }
        // Topological fold from child buses up to Master (parent index strictly < child index).
        $rev := mixer.buses.len - 1
        while rev >= 0 {
            if !mixer.bus_state(rev).paused {
                process_bus_dsp($&dsp_next[rev], $&bus_l[rev], $&bus_r[rev], frames)
            }
            $bgain := f64(mixer.buses[rev].gain) / 1000.0
            if mixer.buses[rev].muted { bgain = 0.0 }
            parent := mixer.buses[rev].parent
            if parent >= 0 {
                for f in 0:frames {
                    bus_l[parent][f] += bus_l[rev][f] * bgain
                    bus_r[parent][f] += bus_r[rev][f] * bgain
                }
            } else {
                for f in 0:frames {
                    samples.push(quantize(bus_l[0][f] * bgain))
                    samples.push(quantize(bus_r[0][f] * bgain))
                }
            }
            rev -= 1
        }
    }
    << MixBlock{
        samples: samples,
        stamp_rev: mixer.revision,
        stamp_bank: mixer.bank_hash,
        stamp_stream: mixer.stream_hash,
        stamp_rate: mixer.rate,
        stamp_voices: mixer.voices.len,
        stamp_buses: mixer.buses.len,
        phases: phases,
        playing: playing,
        frames: frames,
        fade_positions: fade_positions,
        dsp_next: dsp_next,
        lpf_l: lpf_l,
        lpf_r: lpf_r,
        underruns: underruns
    }
}
pub fn (block &MixBlock) frame_count() int { << block.frames }
pub fn (mixer $&Mixer) commit(block &MixBlock) int {
    mixer.valid() >>>
    if block.frames < 1 || block.frames > MAX_BLOCK_FRAMES || block.samples.len != block.frames * 2 || block.phases.len != mixer.voices.len ||
        block.playing.len != mixer.voices.len || block.fade_positions.len != mixer.voices.len ||
        block.stamp_rev != mixer.revision || block.stamp_bank != mixer.bank_hash ||
        block.stamp_stream != mixer.stream_hash || block.stamp_rate != mixer.rate ||
        block.stamp_voices != mixer.voices.len || block.stamp_buses != mixer.buses.len {
        >> errors.new("nexus mixer: stale or foreign mix block")
    }
    for i in 0:mixer.voices.len { mixer.voices[i].phase = block.phases[i]
        mixer.voices[i].playing = block.playing[i]
        mixer.voices[i].fade_position = block.fade_positions[i]
        if block.lpf_l.len == mixer.voices.len { mixer.voices[i].lpf_state_l = block.lpf_l[i] }
        if block.lpf_r.len == mixer.voices.len { mixer.voices[i].lpf_state_r = block.lpf_r[i] } }
    if block.dsp_next.len == mixer.buses.len {
        for b in 0:mixer.buses.len {
            mixer.buses[b].dsp = clone_bus_dsp(&block.dsp_next[b])
        }
    }
    mixer.consume_streams()
    mixer.revision = mixer.revision + 1
    << 0
}

fn ensure_scratch_buses(sl $&[][]f64, sr $&[][]f64, bus_count int, frames int) {
    while sl.len < bus_count {
        sl.push([]f64{})
        sr.push([]f64{})
    }
    for b in 0:bus_count {
        bl := $&sl[b]
        br := $&sr[b]
        while bl.len < frames { bl.push(0.0) }
        while br.len < frames { br.push(0.0) }
        for f in 0:frames {
            bl[f] = 0.0
            br[f] = 0.0
        }
    }
}

pub fn (mixer $&Mixer) render(frames int) []int {
    mixer.valid() >>>
    if frames < 1 || frames > MAX_BLOCK_FRAMES { >> errors.new("nexus mixer: invalid block frame count") }
    rate := mixer.rate
    if rate == 0 { >> errors.new("nexus mixer: zero output rate") }
    dsp_mode := mixer.any_bus_dsp_active()
    bus_count := mixer.buses.len
    $needed_buses := 1
    if dsp_mode { needed_buses = bus_count }

    ensure_scratch_buses($&mixer.scratch_l, $&mixer.scratch_r, needed_buses, frames)

    $samples := []int{}
    $outcomes := []VoiceRenderOutcome{}
    $ran_voice := []bool{}
    for i in 0:mixer.voices.len {
        if mixer.voices[i].playing {
            state := mixer.bus_state(mixer.voices[i].bus)
            if !mixer.voices[i].paused && !state.paused {
                $target_bus := 0
                $vgain := state.gain
                if dsp_mode {
                    target_bus = mixer.voices[i].bus
                    vgain = 1.0
                }
                out := mix_voice_into_from(&mixer.clips, &mixer.streams, &mixer.voices[i], vgain, frames, rate,
                    $&mixer.scratch_l[target_bus], $&mixer.scratch_r[target_bus]) >>>
                outcomes.push(out)
                ran_voice.push(true)
                ->
            }
        }
        outcomes.push(VoiceRenderOutcome{phase: mixer.voices[i].phase, active: mixer.voices[i].playing,
            fade_position: mixer.voices[i].fade_position, lpf_l: mixer.voices[i].lpf_state_l, lpf_r: mixer.voices[i].lpf_state_r, underrun: false})
        ran_voice.push(false)
    }

    for i in 0:mixer.voices.len {
        if ran_voice[i] {
            mixer.voices[i].phase = outcomes[i].phase
            mixer.voices[i].playing = outcomes[i].active
            mixer.voices[i].fade_position = outcomes[i].fade_position
            mixer.voices[i].lpf_state_l = outcomes[i].lpf_l
            mixer.voices[i].lpf_state_r = outcomes[i].lpf_r
        }
    }

    if !dsp_mode {
        for f in 0:frames {
            samples.push(quantize(mixer.scratch_l[0][f]))
            samples.push(quantize(mixer.scratch_r[0][f]))
        }
    } else {
        $rev := bus_count - 1
        while rev >= 0 {
            if !mixer.bus_state(rev).paused {
                process_bus_dsp($&mixer.buses[rev].dsp, $&mixer.scratch_l[rev], $&mixer.scratch_r[rev], frames)
            }
            $bgain := f64(mixer.buses[rev].gain) / 1000.0
            if mixer.buses[rev].muted { bgain = 0.0 }
            parent := mixer.buses[rev].parent
            if parent >= 0 {
                for f in 0:frames {
                    mixer.scratch_l[parent][f] += mixer.scratch_l[rev][f] * bgain
                    mixer.scratch_r[parent][f] += mixer.scratch_r[rev][f] * bgain
                }
            } else {
                for f in 0:frames {
                    samples.push(quantize(mixer.scratch_l[0][f] * bgain))
                    samples.push(quantize(mixer.scratch_r[0][f] * bgain))
                }
            }
            rev -= 1
        }
    }

    mixer.consume_streams()
    mixer.revision = mixer.revision + 1
    << samples
}
