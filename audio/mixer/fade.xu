@"github.com/xulang-org/nexus/audio/mixer"

#math
#errors

fn gain_at(voice &Voice, position int) f64 {
    duration := voice.fade_total
    if duration == 0 { << f64(voice.gain) }
    weight := math.min(1.0, f64(position) / f64(duration))
    << f64(voice.fade_start) + f64(voice.fade_target - voice.fade_start) * weight
}
pub fn (mixer &Mixer) volume(id int) f64 {
    index := mixer.voice_index(id) or >>
    voice := &mixer.voices[index]
    << gain_at(voice, voice.fade_position) / 1000.0
}
// Durations use output frames, so a ramp has the same sample-exact length
// regardless of block size. Source/bus pause and starvation freeze the ramp.
pub fn (mixer $&Mixer) fade_volume(id int, volume f64, frames int, stop_at_end bool) int {
    index := mixer.voice_index(id) or >>
    target := control(volume, 0.0, 4.0) or >>
    if frames < 0 || frames > mixer.rate * 600 { >> errors.new("nexus mixer: fade duration outside 0...600 seconds") }
    current := int(math.round_to_even(gain_at(&mixer.voices[index], mixer.voices[index].fade_position)))
    mixer.voices[index].fade_start = current
    mixer.voices[index].fade_target = target
    mixer.voices[index].fade_position = 0
    mixer.voices[index].fade_total = frames
    mixer.voices[index].fade_stop = stop_at_end
    mixer.voices[index].fade_hold = false
    if frames == 0 {
        mixer.voices[index].gain = target
        if stop_at_end { mixer.voices[index].playing = false }
    }
    mixer.revision = mixer.revision + 1
    << 0
}
pub fn (mixer $&Mixer) crossfade(old int, fresh int, frames int, volume f64) int {
    left := mixer.voice_index(old) or >>
    right := mixer.voice_index(fresh) or >>
    control(volume, 0.0, 4.0) or >>
    if old == fresh || frames < 1 || frames > mixer.rate * 600 || !mixer.voices[left].playing || !mixer.voices[right].playing {
        >> errors.new("nexus mixer: invalid crossfade voices or duration")
    }
    mixer.fade_volume(old, 0.0, frames, true) or >>
    mixer.set_volume(fresh, 0.0) or >>
    mixer.fade_volume(fresh, volume, frames, false) or >>
    << 0
}
