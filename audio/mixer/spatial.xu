@"github.com/xulang-org/nexus/audio/mixer"

fm #"github.com/xulang-org/nexus/foundation/math"
#math
#errors

pub struct Spatial { pub volume f64
    pub pan f64 }
fn spatial_result(distance f64, toward_right f64, maximum f64) Spatial {
    if !fm.finite(distance) || !fm.finite(maximum) || maximum <= 0.0 || maximum > 1000000000.0 { >> errors.new("nexus spatial audio: invalid distance range") }
    weight := math.max(0.0, 1.0 - distance / maximum)
    $pan := 0.0
    if distance > 0.000000001 { pan = math.max(-1.0, math.min(1.0, toward_right / distance)) }
    << Spatial{volume: weight * weight, pan: pan}
}
// Squared linear distance falloff and stereo balance; no HRTF or occlusion.
pub fn spatial_2d(source fm.Vec2, listener fm.Vec2, listener_right fm.Vec2, maximum f64) Spatial {
    if !fm.finite(source.x) || !fm.finite(source.y) || !fm.finite(listener.x) || !fm.finite(listener.y) ||
        !fm.finite(listener_right.x) || !fm.finite(listener_right.y) { >> errors.new("nexus spatial audio: non-finite position") }
    length := listener_right.length()
    if !fm.finite(length) || length <= 0.000000001 { >> errors.new("nexus spatial audio: invalid listener right axis") }
    delta := source.sub(listener)
    << spatial_result(delta.length(), delta.dot(listener_right.scaled(1.0 / length)), maximum) or >>
}
pub fn spatial_3d(source fm.Vec3, listener fm.Vec3, listener_right fm.Vec3, maximum f64) Spatial {
    if !source.is_finite() || !listener.is_finite() { >> errors.new("nexus spatial audio: non-finite position") }
    right := listener_right.normalized() or >>
    delta := source.sub(listener)
    << spatial_result(delta.length(), delta.dot(right), maximum) or >>
}
