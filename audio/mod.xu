@"github.com/xulang-org/nexus/audio"

driver #"github.com/xulang-org/nexus/platform/sdl_audio"
mix #"github.com/xulang-org/nexus/audio/mixer"
#errors

pub const MAX_QUEUED_FRAMES = 24000
pub struct Output { handle int
    rate int }
// Opens paused. Feed a bounded queue before resume; all calls use one owner thread.
pub fn open_output(sample_rate int) Output {
    handle := driver.checked(driver.raw_open(sample_rate)) >>>
    << Output{handle: handle, rate: sample_rate}
}
pub fn (output &Output) sample_rate() int { << output.rate }
pub fn (output &Output) driver_name() string {
    count := driver.checked(driver.raw_driver_len(output.handle)) >>>
    $name := ""
    for i in 0:count { code := driver.checked(driver.raw_driver_byte(output.handle, i)) >>>
        name = name + string_from_byte(code) }
    << name
}
pub fn (output &Output) pause(paused bool) int { $flag := 0
    if paused { flag = 1 }
    << driver.checked(driver.raw_pause(output.handle, flag)) >>> }
pub fn (output &Output) queued_frames() int { << driver.checked(driver.raw_queued(output.handle)) >>> }
pub fn (output &Output) submit(samples &[]int) int { << driver.checked(driver.raw_submit(output.handle, samples)) >>> }
pub fn (output &Output) clear() int { << driver.checked(driver.raw_clear(output.handle)) >>> }
pub fn (output $&Output) close() int {
    if output.handle == 0 { << 0 }
    driver.checked(driver.raw_close(output.handle)) >>>
    output.handle = 0
    << 0
}
fn (output $&Output) drop() { if output.handle > 0 { driver.raw_close(output.handle)
    output.handle = 0 } }
pub struct PumpReport { pub submitted_frames int
    pub queued_frames int
    pub blocks int
    pub underruns int }
// At most four blocks per call. Device failure leaves the unsent block's cursors
// unchanged; earlier successfully submitted blocks remain committed.
pub fn pump(output &Output, mixer $&mix.Mixer, target_frames int, block_frames int) PumpReport {
    if output.rate != mixer.sample_rate() || target_frames < 1 || target_frames > MAX_QUEUED_FRAMES ||
        block_frames < 1 || block_frames > mix.MAX_BLOCK_FRAMES { >>> errors.new("nexus audio: invalid mixer/output rate or queue request") }
    $submitted := 0
    $blocks := 0
    $underruns := 0
    $queued := output.queued_frames() >>>
    while queued < target_frames && blocks < 4 {
        $count := target_frames - queued
        if count > block_frames { count = block_frames }
        block := mixer.prepare(count) >>>
        output.submit(&block.samples) >>>
        mixer.commit(&block) >>>
        underruns = underruns + block.underruns
        submitted = submitted + count
        blocks = blocks + 1
        queued = output.queued_frames() >>>
    }
    << PumpReport{submitted_frames: submitted, queued_frames: queued, blocks: blocks, underruns: underruns}
}
