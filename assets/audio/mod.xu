@"github.com/xulang-org/nexus/assets/audio"

wav #"github.com/xulang-org/nexus/formats/wav"
pcm #"github.com/xulang-org/nexus/resources/audio"
files #"github.com/xulang-org/nexus/internal/file_snapshot"

pub fn load_wav(path string) pcm.Clip {
    raw := files.read(path, wav.MAX_BYTES) or >>
    << wav.decode(&raw) or >>
}
