@"github.com/xulang-org/nexus/assets/shaders/two_d"

renderer #"github.com/xulang-org/nexus/rendering/two_d"
files #"github.com/xulang-org/nexus/internal/file_snapshot"
#gpu
#errors

fn read_shader_bytes(path string, label string) []u8 {
    raw := files.read(path, 1048576) >>>
    if raw.len == 0 { >> errors.new("nexus shaders: empty " + label + " shader") }
    $out := []u8{}
    for i in 0:raw.len { out.push(u8(raw[i])) }
    << out
}

fn read_shader_format(directory &string) int {
    dir := directory + ""
    marker := files.read(dir + "/format", 32) >>>
    if marker == "msl\n" { << gpu.SHADER_MSL }
    if marker == "spirv\n" { << gpu.SHADER_SPIRV }
    if marker == "dxil\n" { << gpu.SHADER_DXIL }
    >> errors.new("nexus shaders: unknown canvas shader format")
}

fn shader_entrypoint(format int) string {
    if format == gpu.SHADER_MSL { << "main0" }
    << "main"
}

// Offline artifacts are explicit inputs. Rendering never loads files or runs
// compilers. A format marker prevents treating host shaders as another backend.
pub fn load_canvas(directory string) renderer.ShaderProgram2D {
    format := read_shader_format(&directory) >>>
    entry := shader_entrypoint(format)
    vs := read_shader_bytes(directory + "/canvas.vert.bin", "canvas") >>>
    fs := read_shader_bytes(directory + "/canvas.frag.bin", "canvas") >>>
    << renderer.ShaderProgram2D{format: format, entrypoint: entry, vertex: vs, fragment: fs}
}

pub fn load_ui_sdf(directory string) renderer.SdfProgram2D {
    format := read_shader_format(&directory) >>>
    entry := shader_entrypoint(format)
    vs := read_shader_bytes(directory + "/ui_sdf.vert.bin", "ui_sdf") >>>
