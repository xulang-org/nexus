    } else if marker=="dxil\n" { format=gpu.SHADER_DXIL
    } else { >> errors.new("nexus shaders: unknown clustered shader format") }
    compute := shader_bytes(directory+"/cluster_lights.comp.bin") or >>
    vertex := shader_bytes(directory+"/mesh_clustered.vert.bin") or >>
    fragment := shader_bytes(directory+"/mesh_clustered.frag.bin") or >>
    << renderer.ClusteredProgram3D{
        format: format,
