    } else { >> errors.new("nexus shaders: unknown skinning shader format") }
    compute := shader_bytes(directory+"/skin_lbs.comp.bin") or >>
    << renderer.SkinProgram3D{format: format, entrypoint: entrypoint, compute: compute}
}

pub fn load_clustered_program(directory string) renderer.ClusteredProgram3D {
    marker := files.read(directory+"/format",32) or >>
    $format := 0
