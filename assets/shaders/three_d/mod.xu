}

pub fn load_postprocess_program(directory string) renderer.PostProcessProgram3D {
    marker := files.read(directory+"/format",32) or >>
    $format := 0
    $entrypoint := "main"
    if marker=="msl\n" { format=gpu.SHADER_MSL
        entrypoint="main0"
    } else if marker=="spirv\n" { format=gpu.SHADER_SPIRV
    } else if marker=="dxil\n" { format=gpu.SHADER_DXIL
    } else { >> errors.new("nexus shaders: unknown postprocess shader format") }
    hdr_vertex := shader_bytes(directory+"/mesh_clustered.vert.bin") or >>
    hdr_fragment := shader_bytes(directory+"/hdr_clustered.frag.bin") or >>
    gtao := shader_bytes(directory+"/gtao.comp.bin") or >>
    gtao_blur := shader_bytes(directory+"/gtao_blur.comp.bin") or >>
    ssr := shader_bytes(directory+"/ssr.comp.bin") or >>
    bloom_down := shader_bytes(directory+"/bloom_down.comp.bin") or >>
    bloom_up := shader_bytes(directory+"/bloom_up.comp.bin") or >>
    taa_resolve := shader_bytes(directory+"/taa_resolve.comp.bin") or >>
    composite_vertex := shader_bytes(directory+"/post_composite.vert.bin") or >>
    composite_fragment := shader_bytes(directory+"/post_composite.frag.bin") or >>
    << renderer.PostProcessProgram3D{
        format: format,
        entrypoint: entrypoint,
        hdr_vertex: hdr_vertex,
        hdr_fragment: hdr_fragment,
        gtao: gtao,
        gtao_blur: gtao_blur,
        ssr: ssr,
        bloom_down: bloom_down,
        bloom_up: bloom_up,
        taa_resolve: taa_resolve,
        composite_vertex: composite_vertex,
        composite_fragment: composite_fragment
    }
}

