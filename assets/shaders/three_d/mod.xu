pub fn load_indirect_program(directory string) renderer.IndirectProgram3D {
    marker := files.read(directory+"/format",32) or >>
    $format := 0
    $entrypoint := "main"
    if marker=="msl\n" { format=gpu.SHADER_MSL
        entrypoint="main0"
    } else if marker=="spirv\n" { format=gpu.SHADER_SPIRV
    } else if marker=="dxil\n" { format=gpu.SHADER_DXIL
    } else { >> errors.new("nexus shaders: unknown indirect shader format") }
    hiz_depth := shader_bytes(directory+"/hiz_depth.comp.bin") or >>
    hiz_mip := shader_bytes(directory+"/hiz_mip.comp.bin") or >>
    cull := shader_bytes(directory+"/cull_indirect.comp.bin") or >>
    vertex := shader_bytes(directory+"/mesh_indirect.vert.bin") or >>
    fragment := shader_bytes(directory+"/mesh_indirect.frag.bin") or >>
    << renderer.IndirectProgram3D{
        format: format,
        entrypoint: entrypoint,
        hiz_depth: hiz_depth,
