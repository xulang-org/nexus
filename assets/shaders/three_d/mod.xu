@"github.com/xulang-org/nexus/assets/shaders/three_d"

renderer #"github.com/xulang-org/nexus/rendering/three_d"
files #"github.com/xulang-org/nexus/internal/file_snapshot"
#gpu
#errors

fn shader_bytes(path string) []u8 {
    raw := files.read(path,1048576) >>>
    if raw.len==0 { >>> errors.new("nexus shaders: empty mesh shader") }
    $bytes := []u8{}
    for i in 0:raw.len { bytes.push(u8(raw[i])) }
    << bytes
}
pub fn load_mesh(directory string) renderer.ShaderProgram3D {
    marker := files.read(directory+"/format",32) >>>
    $format := 0
    $entrypoint := "main"
    if marker=="msl\n" { format=gpu.SHADER_MSL
        entrypoint="main0"
    } else if marker=="spirv\n" { format=gpu.SHADER_SPIRV
    } else if marker=="dxil\n" { format=gpu.SHADER_DXIL
    } else { >>> errors.new("nexus shaders: unknown mesh shader format") }
    vertex := shader_bytes(directory+"/mesh.vert.bin") >>>
    fragment := shader_bytes(directory+"/mesh.frag.bin") >>>
    present_vertex := shader_bytes(directory+"/canvas.vert.bin") >>>
    present_fragment := shader_bytes(directory+"/canvas.frag.bin") >>>
    << renderer.ShaderProgram3D{format: format,entrypoint: entrypoint,vertex: vertex,fragment: fragment,
        present_vertex: present_vertex,present_fragment: present_fragment}
}
pub fn load_shadow(directory string) renderer.ShadowProgram3D {
    marker := files.read(directory+"/format",32) >>>
    $format := 0
    $entrypoint := "main"
    if marker=="msl\n" { format=gpu.SHADER_MSL
        entrypoint="main0"
    } else if marker=="spirv\n" { format=gpu.SHADER_SPIRV
    } else if marker=="dxil\n" { format=gpu.SHADER_DXIL
    } else { >>> errors.new("nexus shaders: unknown shadow shader format") }
    vertex := shader_bytes(directory+"/shadow.vert.bin") >>>
    fragment := shader_bytes(directory+"/shadow.frag.bin") >>>
    << renderer.ShadowProgram3D{format: format,entrypoint: entrypoint,vertex: vertex,fragment: fragment}
}
