@"github.com/xulang-org/nexus/assets/image"

images #"github.com/xulang-org/nexus/resources/image"
files #"github.com/xulang-org/nexus/internal/file_snapshot"
driver #"github.com/xulang-org/nexus/platform/sdl_image"
#encoding/binary
#errors

pub const MAX_IMAGE_BYTES = 33554432
// Decodes an immutable byte snapshot before any GPU allocation. The platform
// codec is SDL's CPU PNG decoder; no window/video subsystem is created here.
pub fn decode_png(raw &string) images.ImageRGBA8 {
    if raw.len < 33 || raw.len > MAX_IMAGE_BYTES { >>> errors.new("nexus image: PNG must be in 33 bytes...32 MiB") }
    signature := [137, 80, 78, 71, 13, 10, 26, 10]
    for i in 0:8 {
        if (raw[i] & 255) != signature[i] { >>> errors.new("nexus image: invalid PNG signature") }
    }
    $header := []int{}
    for i in 8:24 { header.push(raw[i] & 255) }
    order := binary.big_endian()
    if (order.get_u32(&header, 0) >>>) != 13 || header[4] != 73 || header[5] != 72 || header[6] != 68 || header[7] != 82 {
        >>> errors.new("nexus image: invalid PNG IHDR")
    }
    width := order.get_u32(&header, 8) >>>
    height := order.get_u32(&header, 12) >>>
    if width < 1 || width > images.MAX_DIMENSION || height < 1 || height > images.MAX_DIMENSION || width * height > images.MAX_PIXELS {
        >>> errors.new("nexus image: PNG exceeds dimension or pixel limits")
    }
    $bytes := []u8{}
    for i in 0:raw.len { bytes.push(u8(raw[i])) }
    $pixels := []int{}
    for i in 0:width * height { pixels.push(0) }
    driver.check_status(driver.raw_decode_png(&bytes, width, height, $&pixels)) >>>
    << images.ImageRGBA8{width: width, height: height, pixels: pixels}
}
pub fn load_png(path string) images.ImageRGBA8 {
    raw := files.read(path, MAX_IMAGE_BYTES) >>>
    << decode_png(&raw) >>>
}

// Bounded embedded data path. The caller can impose a remaining decode-work
// budget before pixel allocation; no string conversion or window is needed.
pub fn decode_png_bytes(raw &[]int, pixel_limit int) images.ImageRGBA8 {
    if raw.len < 33 || raw.len > MAX_IMAGE_BYTES || pixel_limit < 1 || pixel_limit > images.MAX_PIXELS {
        >>> errors.new("nexus image: invalid PNG byte or pixel budget")
    }
    signature := [137, 80, 78, 71, 13, 10, 26, 10]
    for i in 0:8 { if raw[i] != signature[i] { >>> errors.new("nexus image: invalid PNG signature") } }
    order := binary.big_endian()
    if (order.get_u32(raw, 8) >>>) != 13 || raw[12] != 73 || raw[13] != 72 || raw[14] != 68 || raw[15] != 82 {
        >>> errors.new("nexus image: invalid PNG IHDR")
    }
    width := order.get_u32(raw, 16) >>>
    height := order.get_u32(raw, 20) >>>
    if width < 1 || width > images.MAX_DIMENSION || height < 1 || height > images.MAX_DIMENSION || width * height > pixel_limit {
        >>> errors.new("nexus image: PNG exceeds dimension or caller pixel budget")
    }
    for value in raw { if value < 0 || value > 255 { >>> errors.new("nexus image: invalid PNG byte") } }
    $pixels := []int{}
    for i in 0:width * height { pixels.push(0) }
    $bytes := []u8{}
    for value in raw { bytes.push(u8(value)) }
    driver.check_status(driver.raw_decode_png(&bytes, width, height, $&pixels)) >>>
    << images.ImageRGBA8{width: width, height: height, pixels: pixels}
}
