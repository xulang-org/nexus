@"github.com/xulang-org/nexus/assets/image"

images #"github.com/xulang-org/nexus/resources/image"
#image/jpeg
#strings
#errors

// Reuse Xu's baseline JPEG decoder. Bound dimensions before pixel allocation;
// progressive, CMYK and other encodings remain explicit codec errors.
pub fn decode_jpeg(raw &string,pixel_limit int) images.ImageRGBA8 {
    if raw.len<4 || raw.len>MAX_IMAGE_BYTES || pixel_limit<1 || pixel_limit>images.MAX_PIXELS || raw[0]!=255 || raw[1]!=216 { >>> errors.new("nexus image: invalid JPEG bytes or pixel budget") }
    $at := 2
    $width := 0
    $height := 0
    while at<raw.len {
        if raw[at]!=255 { >>> errors.new("nexus image: invalid JPEG marker") }
        while at<raw.len && raw[at]==255 { at+=1 }
        if at>=raw.len { >>> errors.new("nexus image: truncated JPEG marker") }
        marker := raw[at]
        at+=1
        if marker==217 || marker==218 { <- }
        if marker==1 || (marker>=208 && marker<=215) { -> }
        if at>raw.len-2 { >>> errors.new("nexus image: truncated JPEG segment") }
        size := raw[at]*256+raw[at+1]
        if size<2 || size>raw.len-at { >>> errors.new("nexus image: invalid JPEG segment size") }
        if marker==192 {
            if size<8 || raw[at+2]!=8 { >>> errors.new("nexus image: JPEG requires 8-bit baseline frame") }
            components := raw[at+7]
            if (components!=1 && components!=3) || size!=8+components*3 { >>> errors.new("nexus image: JPEG requires gray or three-component baseline frame") }
            height=raw[at+3]*256+raw[at+4]
            width=raw[at+5]*256+raw[at+6]
            if width<1 || height<1 || width>images.MAX_DIMENSION || height>images.MAX_DIMENSION || width*height>pixel_limit { >>> errors.new("nexus image: JPEG exceeds dimension or caller pixel budget") }
            <-
        }
        if marker>=193 && marker<=207 && marker!=196 && marker!=200 && marker!=204 { >>> errors.new("nexus image: JPEG supports baseline SOF0 only") }
        at+=size
    }
    if width<1 || height<1 { >>> errors.new("nexus image: JPEG frame header missing") }
    decoded := jpeg.decode(raw) >>>
    if decoded.rect.dx()!=width || decoded.rect.dy()!=height || decoded.stride!=width*4 || decoded.pix.len!=width*height*4 { >>> errors.new("nexus image: JPEG output differs from checked frame") }
    $pixels := []int{}
    for i in 0:width*height {
        p := i*4
        pixels.push((decoded.pix[p]<<24) | (decoded.pix[p+1]<<16) | (decoded.pix[p+2]<<8) | 255)
    }
    << images.ImageRGBA8{width: width,height: height,pixels: pixels}
}
pub fn decode_jpeg_bytes(raw &[]int,pixel_limit int) images.ImageRGBA8 {
    if raw.len<4 || raw.len>MAX_IMAGE_BYTES { >>> errors.new("nexus image: invalid JPEG byte budget") }
    $builder := strings.new_byte_builder(raw.len)
    for octet in raw { if octet<0 || octet>255 { >>> errors.new("nexus image: invalid JPEG byte") }
        builder.write_byte(octet) }
    data := builder.to_string()
    << decode_jpeg(&data,pixel_limit) >>>
}
