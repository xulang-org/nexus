@"github.com/xulang-org/game/assets/mesh"

mesh #"github.com/xulang-org/game/resources/mesh"
obj #"github.com/xulang-org/game/formats/obj"
stl #"github.com/xulang-org/game/formats/stl"
snapshot #"github.com/xulang-org/game/internal/file_snapshot"
#path/filepath
#strings
#errors

// Static mesh formats without hierarchy/material sidecars. GLB's richer
// resource/scene/material contract remains in assets/gltf and gltf_render.
pub fn load(path string) mesh.MeshData3D {
    extension := filepath.ext(&path)
    kind := strings.to_lower(&extension)
    if kind!=".obj" && kind!=".stl" { >> errors.new("game mesh: unsupported format; expected .obj or .stl") }
    raw := snapshot.read(path,16777216) or >>
    if kind==".obj" { << obj.decode(&raw) or >> }
    << stl.decode(&raw) or >>
}
