@"github.com/xulang-org/nexus/assets/mesh"

mesh #"github.com/xulang-org/nexus/resources/mesh"
obj #"github.com/xulang-org/nexus/formats/obj"
stl #"github.com/xulang-org/nexus/formats/stl"
snapshot #"github.com/xulang-org/nexus/internal/file_snapshot"
#path/filepath
#strings
#errors

// Static mesh formats without hierarchy/material sidecars. GLB's richer
// resource/scene/material contract remains in assets/gltf and gltf_render.
pub fn load(path string) mesh.MeshData3D {
    extension := filepath.ext(&path)
    kind := strings.to_lower(&extension)
    if kind!=".obj" && kind!=".stl" { >> errors.new("nexus mesh: unsupported format; expected .obj or .stl") }
    raw := snapshot.read(path,16777216) >>>
    if kind==".obj" { << obj.decode(&raw) >>> }
    << stl.decode(&raw) >>>
}
