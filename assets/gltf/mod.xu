@"github.com/xulang-org/nexus/assets/gltf"

gltf #"github.com/xulang-org/nexus/formats/gltf"
files #"github.com/xulang-org/nexus/internal/file_snapshot"
#path/filepath
#strings
#errors
#os

fn is_link(path string) bool {
    os.readlink(path) >>>(err){ << false }
    << true
}

pub fn load_glb_geometry(path string) gltf.GlbGeometry {
    raw := files.read(path+"", gltf.MAX_GLB_BYTES) >>>
    $asset := gltf.decode_glb_geometry(&raw) >>>
    directory := filepath.dir(&path)
    for i in 0:asset.image_count() {
        uri := asset.image_uri(i) >>>
        if uri.len==0 { -> }
        $candidate := directory+""
        for part in strings.split(&uri,"/") {
            candidate=filepath.join([candidate+"",part+""])
            if is_link(candidate+"") { >> errors.new("nexus GLB: external image paths cannot contain symlinks") }
        }
        image_bytes := files.read(candidate,8388608) >>>
        asset.resolve_image(i,&image_bytes) >>>
    }
    << asset
}
