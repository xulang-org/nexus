@"github.com/xulang-org/game/assets/gltf"

gltf #"github.com/xulang-org/game/formats/gltf"
files #"github.com/xulang-org/game/internal/file_snapshot"
#path/filepath
#strings
#errors
#os

fn is_link(path string) bool {
    os.readlink(path) or(err){ << false }
    << true
}

pub fn load_glb_geometry(path string) gltf.GlbGeometry {
    raw := files.read(path+"", gltf.MAX_GLB_BYTES) or >>
    $asset := gltf.decode_glb_geometry(&raw) or >>
    directory := filepath.dir(&path)
    for i in 0:asset.image_count() {
        uri := asset.image_uri(i) or >>
        if uri.len==0 { -> }
        $candidate := directory+""
        for part in strings.split(&uri,"/") {
            candidate=filepath.join([candidate+"",part+""])
            if is_link(candidate+"") { >> errors.new("game GLB: external image paths cannot contain symlinks") }
        }
        image_bytes := files.read(candidate,8388608) or >>
        asset.resolve_image(i,&image_bytes) or >>
    }
    << asset
}
