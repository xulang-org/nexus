@"github.com/xulang-org/nexus/assets/gltf"

gltf #"github.com/xulang-org/nexus/formats/gltf"
fm #"github.com/xulang-org/nexus/foundation/math"
nexus #"github.com/xulang-org/nexus/scene"
#errors

pub struct GlbInstance {
    pub root int
    source_hash string
    nodes []int
    primitive_nodes []int
    primitives []int
    primitive_sources []int
}
pub fn (instance &GlbInstance) content_hash() string { << instance.source_hash + "" }
pub fn (instance &GlbInstance) primitive_count() int { << instance.primitives.len }
pub fn (instance &GlbInstance) primitive_node(index int) int {
    if index < 0 || index >= instance.primitives.len { >> errors.new("nexus GLB: instance primitive out of range") }
    << instance.primitive_nodes[index]
}
pub fn (instance &GlbInstance) primitive_index(index int) int {
    if index < 0 || index >= instance.primitives.len { >> errors.new("nexus GLB: instance primitive out of range") }
    << instance.primitives[index]
}
pub fn (instance &GlbInstance) primitive_source_node(index int) int {
    if index<0 || index>=instance.primitives.len { >> errors.new("nexus GLB: instance primitive index invalid") }
    << instance.primitive_sources[index]
}
pub fn (instance &GlbInstance) apply_pose(tree $&nexus.SceneTree,asset &gltf.GlbGeometry,locals &[]fm.Mat4) int {
    if instance.content_hash()!=asset.content_hash() || locals.len!=instance.nodes.len { >> errors.new("nexus GLB: pose/instance asset mismatch") }
    for i in 0:locals.len {
        if !locals[i].is_affine() { >> errors.new("nexus GLB: invalid pose transform") }
        if instance.nodes[i]!=0 {
            info := tree.node_info(instance.nodes[i]) or >>
            if info.queued_free { >> errors.new("nexus GLB: pose node is queued for deletion") }
            tree.global_transform_3d(instance.nodes[i]) or >>
        }
    }
    for i in 0:locals.len { if instance.nodes[i]!=0 { tree.set_transform_3d(instance.nodes[i],locals[i]) or >> } }
    << 0
}
// Returns 0 for source nodes excluded from the selected glTF scene.
pub fn (instance &GlbInstance) source_node(index int) int {
    if index < 0 || index >= instance.nodes.len { >> errors.new("nexus GLB: source node index out of range") }
    << instance.nodes[index]
}
pub fn instantiate(asset &gltf.GlbGeometry, tree $&nexus.SceneTree, parent int, name string) GlbInstance {
    $order := []int{}
    for i in 0:asset.selected_node_count() { order.push(asset.selected_node(i) or >>) }
    $count := 1 + order.len
    for index in order {
        source := asset.describe_node(index) or >>
        if source.mesh >= 0 { count = count + (asset.mesh_primitive_count(source.mesh) or >>) }
    }
    if count > 4096 { >> errors.new("nexus GLB: instantiated scene exceeds 4096 nodes") }
    // Build off-tree, then reuse PackedScene's atomic capacity/name preflight.
    $temporary := nexus.new_scene_tree_3d("Imported", count) or >>
    root := temporary.root()
    $nodes := []int{}
    for i in 0:asset.node_count() { nodes.push(0) }
    $primitive_nodes := []int{}
    $primitives := []int{}
    $sources := []int{}
    for index in order {
        source := asset.describe_node(index) or >>
        $owner := root
        if source.parent >= 0 { owner = nodes[source.parent] }
        // Stable generated names avoid sibling conflicts and source path syntax.
        node := temporary.add_child_3d(owner, "Node_" + str(index)) or >>
        temporary.set_transform_3d(node, source.local) or >>
        nodes[index] = node
        if source.mesh >= 0 {
            first := asset.mesh_first_primitive(source.mesh) or >>
            primitive_count := asset.mesh_primitive_count(source.mesh) or >>
            for i in 0:primitive_count {
                primitive := first + i
                child := temporary.add_child_3d(node, "Primitive_" + str(i)) or >>
                primitive_nodes.push(child)
                primitives.push(primitive)
                sources.push(index)
            }
        }
    }
    before := temporary.subtree(root) or >>
    $ordinals := map[int]int{}
    for i in 0:before.len { ordinals[before[i]] = i }
    packed := nexus.pack_scene(&temporary, root) or >>
    instance_root := packed.instantiate(tree, parent, name) or >>
    after := tree.subtree(instance_root) or >>
    for i in 0:nodes.len { if nodes[i] != 0 { nodes[i] = after[ordinals[nodes[i]]] } }
    for i in 0:primitive_nodes.len { primitive_nodes[i] = after[ordinals[primitive_nodes[i]]] }
    << GlbInstance{root: instance_root, source_hash: asset.content_hash(), nodes: nodes,
        primitive_nodes: primitive_nodes, primitives: primitives,primitive_sources: sources}
}
