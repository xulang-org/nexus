@"github.com/xulang-org/nexus/animation/skeletal"

#encoding/json
#errors
#strconv
#strings

pub const ASM_FORMAT = "nexus.asm"
pub const ASM_VERSION = 1

fn b_str(v bool) string {
    if v { << "true" }
    << "false"
}

fn f_str(v f64) string {
    << strconv.format_float(v, 103, -1) >>> (err) {
        _ := err.msg()
        << "0"
    }
}

pub fn encode_state_machine_json(sm &AnimationStateMachine) string {
    if sm.states.len == 0 {
        >> errors.new("nexus anim: cannot serialize empty state machine")
    }
    $b := strings.new_byte_builder(1024)
    fmt_s := ASM_FORMAT + ""
    b.write_str("{\n")
    b.write_str("  \"format\": " + json.quote(&fmt_s) + ",\n")
    b.write_str("  \"version\": " + str(ASM_VERSION) + ",\n")
    b.write_str("  \"current_state\": " + str(sm.current_state) + ",\n")
    b.write_str("  \"rm_enabled\": " + b_str(sm.rm_enabled) + ",\n")
    b.write_str("  \"rm_root_node\": " + str(sm.rm_root_node) + ",\n")
    b.write_str("  \"rm_lock_xz\": " + b_str(sm.rm_lock_xz) + ",\n")
    b.write_str("  \"rm_lock_y\": " + b_str(sm.rm_lock_y) + ",\n")

    b.write_str("  \"states\": [\n")
    for i in 0:sm.states.len {
        if i > 0 { b.write_str(",\n") }
        st := &sm.states[i]
        sname := st.name + ""
        px := st.param_x + ""
        py := st.param_y + ""
        b.write_str("    {\"name\": " + json.quote(&sname) +
            ", \"kind\": " + str(st.kind) +
            ", \"clip\": " + str(st.clip) +
            ", \"param_x\": " + json.quote(&px) +
            ", \"param_y\": " + json.quote(&py) +
            ", \"looping\": " + b_str(st.looping) +
            ", \"speed\": " + f_str(st.speed) +
            ", \"sync_group\": " + str(st.sync_group))
        if st.kind == STATE_BLEND_1D {
            b.write_str(", \"samples_1d\": [")
            for k in 0:st.space1d.samples.len {
                if k > 0 { b.write_str(", ") }
                s := &st.space1d.samples[k]
                b.write_str("{\"clip\": " + str(s.clip) + ", \"coord\": " + f_str(s.coord) + ", \"speed\": " + f_str(s.speed) + "}")
            }
            b.write_str("]")
        } else if st.kind == STATE_BLEND_2D {
            b.write_str(", \"samples_2d\": [")
            for k in 0:st.space2d.samples.len {
                if k > 0 { b.write_str(", ") }
                s := &st.space2d.samples[k]
                b.write_str("{\"clip\": " + str(s.clip) + ", \"x\": " + f_str(s.x) + ", \"y\": " + f_str(s.y) + ", \"speed\": " + f_str(s.speed) + "}")
            }
            b.write_str("]")
        }
        b.write_str("}")
    }
    b.write_str("\n  ],\n  \"transitions\": [\n")
    for i in 0:sm.transitions.len {
        if i > 0 { b.write_str(",\n") }
        tr := &sm.transitions[i]
        b.write_str("    {\"from_state\": " + str(tr.from_state) +
            ", \"to_state\": " + str(tr.to_state) +
            ", \"fade_duration\": " + f_str(tr.fade_duration) +
            ", \"has_exit_time\": " + b_str(tr.has_exit_time) +
            ", \"exit_time\": " + f_str(tr.exit_time) +
            ", \"conditions\": [")
        for ci in 0:tr.conditions.len {
            if ci > 0 { b.write_str(", ") }
            cd := &tr.conditions[ci]
            cp := cd.param + ""
            b.write_str("{\"kind\": " + str(cd.kind) + ", \"param\": " + json.quote(&cp) + ", \"threshold\": " + f_str(cd.threshold) + "}")
        }
        b.write_str("]}")
    }
    b.write_str("\n  ],\n  \"events\": [\n")
    for i in 0:sm.events.len {
        if i > 0 { b.write_str(",\n") }
        ev := &sm.events[i]
        en := ev.name + ""
        b.write_str("    {\"clip\": " + str(ev.clip) + ", \"time\": " + f_str(ev.time) +
            ", \"name\": " + json.quote(&en) + ", \"tag\": " + str(ev.tag) + "}")
    }
    b.write_str("\n  ]\n}\n")
    << b.to_string()
}

pub fn decode_state_machine_json(raw &string) AnimationStateMachine {
    if raw.len < 2 || raw.len > 4194304 {
        >> errors.new("nexus anim: ASM JSON size out of bounds")
    }
    doc := json.parse_max(raw, 4194304)
    if !doc.ok() { >> errors.new("nexus anim JSON: " + doc.error()) }
    root := doc.root()
    if !doc.is_dict(root) || !doc.has(root, "format") || !doc.has(root, "version") || !doc.has(root, "states") {
        >> errors.new("nexus anim: missing required ASM fields")
    }
    fmt_s := doc.as_string(doc.get(root, "format")) >>>
    ver := doc.as_int(doc.get(root, "version")) >>>
    if fmt_s != ASM_FORMAT || ver != ASM_VERSION {
        >> errors.new("nexus anim: unsupported ASM format or version")
    }

    $sm := new_state_machine()
    states_list := doc.get(root, "states")
    if !doc.is_list(states_list) || doc.count(states_list) < 1 {
        >> errors.new("nexus anim: states must be a non-empty list")
    }
    for i in 0:doc.count(states_list) {
        snode := doc.at(states_list, i)
        if !doc.is_dict(snode) || !doc.has(snode, "name") || !doc.has(snode, "kind") {
            >> errors.new("nexus anim: invalid state entry")
        }
        sname := doc.as_string(doc.get(snode, "name")) >>>
        kind := doc.as_int(doc.get(snode, "kind")) >>>
        $looping := true
        if doc.has(snode, "looping") { looping = doc.as_bool(doc.get(snode, "looping")) >>> }
        $speed := 1.0
        if doc.has(snode, "speed") { speed = doc.as_f64(doc.get(snode, "speed")) >>> }
        $sync_group := -1
        if doc.has(snode, "sync_group") { sync_group = doc.as_int(doc.get(snode, "sync_group")) >>> }

        $created_sid := -1
        if kind == STATE_CLIP {
            clip := doc.as_int(doc.get(snode, "clip")) >>>
            created_sid = sm.add_clip_state(sname + "", clip, looping, speed) >>>
        } else if kind == STATE_BLEND_1D {
            px := doc.as_string(doc.get(snode, "param_x")) >>>
            $bs := new_blend_space_1d()
            samps := doc.get(snode, "samples_1d")
            if !doc.is_list(samps) { >> errors.new("nexus anim: samples_1d must be list") }
            for k in 0:doc.count(samps) {
                sn := doc.at(samps, k)
                sc := doc.as_int(doc.get(sn, "clip")) >>>
                co := doc.as_f64(doc.get(sn, "coord")) >>>
                sp := doc.as_f64(doc.get(sn, "speed")) >>>
                _ := bs.add_sample(sc, co, sp) >>>
            }
            created_sid = sm.add_blend_1d_state(sname + "", bs, px + "", looping, speed) >>>
        } else if kind == STATE_BLEND_2D {
            px := doc.as_string(doc.get(snode, "param_x")) >>>
            py := doc.as_string(doc.get(snode, "param_y")) >>>
            $bs := new_blend_space_2d()
            samps := doc.get(snode, "samples_2d")
            if !doc.is_list(samps) { >> errors.new("nexus anim: samples_2d must be list") }
            for k in 0:doc.count(samps) {
                sn := doc.at(samps, k)
                sc := doc.as_int(doc.get(sn, "clip")) >>>
                sx := doc.as_f64(doc.get(sn, "x")) >>>
                sy := doc.as_f64(doc.get(sn, "y")) >>>
                sp := doc.as_f64(doc.get(sn, "speed")) >>>
                _ := bs.add_sample(sc, sx, sy, sp) >>>
            }
            created_sid = sm.add_blend_2d_state(sname + "", bs, px + "", py + "", looping, speed) >>>
        } else {
            >> errors.new("nexus anim: unknown state kind")
        }
        if sync_group >= 0 {
            sm.set_state_sync_group(created_sid, sync_group) >>>
        }
    }

    if doc.has(root, "transitions") {
        tlist := doc.get(root, "transitions")
        if !doc.is_list(tlist) { >> errors.new("nexus anim: transitions must be list") }
        for i in 0:doc.count(tlist) {
            tn := doc.at(tlist, i)
            from_s := doc.as_int(doc.get(tn, "from_state")) >>>
            to_s := doc.as_int(doc.get(tn, "to_state")) >>>
            fade := doc.as_f64(doc.get(tn, "fade_duration")) >>>
            has_ex := doc.as_bool(doc.get(tn, "has_exit_time")) >>>
            ex_t := doc.as_f64(doc.get(tn, "exit_time")) >>>
            clist := doc.get(tn, "conditions")
            if !doc.is_list(clist) { >> errors.new("nexus anim: conditions must be list") }
            $conds := []TransitionCondition{}
            for ci in 0:doc.count(clist) {
                cn := doc.at(clist, ci)
                ck := doc.as_int(doc.get(cn, "kind")) >>>
                cp := doc.as_string(doc.get(cn, "param")) >>>
                ct := doc.as_f64(doc.get(cn, "threshold")) >>>
                conds.push(TransitionCondition{kind: ck, param: cp + "", threshold: ct})
            }
            _ := sm.add_transition(from_s, to_s, fade, has_ex, ex_t, &conds) >>>
        }
    }

    if doc.has(root, "events") {
        elist := doc.get(root, "events")
        if !doc.is_list(elist) { >> errors.new("nexus anim: events must be list") }
        for i in 0:doc.count(elist) {
            en := doc.at(elist, i)
            ec := doc.as_int(doc.get(en, "clip")) >>>
            et := doc.as_f64(doc.get(en, "time")) >>>
            ename := doc.as_string(doc.get(en, "name")) >>>
            etag := doc.as_int(doc.get(en, "tag")) >>>
            _ := sm.add_event(ec, et, ename + "", etag) >>>
        }
    }

    if doc.has(root, "current_state") {
        cur := doc.as_int(doc.get(root, "current_state")) >>>
        sm.set_initial_state(cur) >>>
    }
    if doc.has(root, "rm_enabled") && (doc.as_bool(doc.get(root, "rm_enabled")) >>>) {
        rn := doc.as_int(doc.get(root, "rm_root_node")) >>>
        lxz := doc.as_bool(doc.get(root, "rm_lock_xz")) >>>
        ly := doc.as_bool(doc.get(root, "rm_lock_y")) >>>
        sm.enable_root_motion(rn, lxz, ly) >>>
    }
    << sm
}
