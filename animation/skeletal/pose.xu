@"github.com/xulang-org/nexus/animation/skeletal"

fm #"github.com/xulang-org/nexus/foundation/math"
gltf #"github.com/xulang-org/nexus/formats/gltf"
#errors
#math

fn pi_f() f64 { << 3.141592653589793 }

fn clamp_f(v f64, lo f64, hi f64) f64 {
    if v < lo { << lo }
    if v > hi { << hi }
    << v
}

fn wrap_angle(a f64) f64 {
    pi := pi_f()
    $x := a
    while x > pi { x -= 2.0 * pi }
    while x < -pi { x += 2.0 * pi }
    << x
}

pub fn quat_identity() fm.Vec4 {
    << fm.vec4(0.0, 0.0, 0.0, 1.0)
}

pub fn quat_norm(q fm.Vec4) fm.Vec4 {
    n := fm.quaternion(q.x, q.y, q.z, q.w).normalized() >>>
    << fm.vec4(n.x, n.y, n.z, n.w)
}

pub fn quat_conj(q fm.Vec4) fm.Vec4 {
    << fm.vec4(-q.x, -q.y, -q.z, q.w)
}

pub fn quat_mul(a fm.Vec4, b fm.Vec4) fm.Vec4 {
    x := a.w * b.x + a.x * b.w + a.y * b.z - a.z * b.y
    y := a.w * b.y - a.x * b.z + a.y * b.w + a.z * b.x
    z := a.w * b.z + a.x * b.y - a.y * b.x + a.z * b.w
    w := a.w * b.w - a.x * b.x - a.y * b.y - a.z * b.z
    << fm.vec4(x, y, z, w)
}

pub fn quat_slerp(a fm.Vec4, b_in fm.Vec4, t f64) fm.Vec4 {
    $b := b_in
    $dot := a.x * b.x + a.y * b.y + a.z * b.z + a.w * b.w
    if dot < 0.0 {
        b = fm.vec4(-b.x, -b.y, -b.z, -b.w)
        dot = -dot
    }
    dot = clamp_f(dot, 0.0, 1.0)
    if dot > 0.9995 {
        << quat_norm(fm.vec4(
            a.x * (1.0 - t) + b.x * t,
            a.y * (1.0 - t) + b.y * t,
            a.z * (1.0 - t) + b.z * t,
            a.w * (1.0 - t) + b.w * t
        )) >>>
    }
    angle := math.acos(dot)
    sin_a := math.sin(angle)
    w0 := math.sin((1.0 - t) * angle) / sin_a
    w1 := math.sin(t * angle) / sin_a
    << quat_norm(fm.vec4(
        a.x * w0 + b.x * w1,
        a.y * w0 + b.y * w1,
        a.z * w0 + b.z * w1,
        a.w * w0 + b.w * w1
    )) >>>
}

pub fn quat_rotate_vec3(q fm.Vec4, v fm.Vec3) fm.Vec3 {
    qv := fm.vec3(q.x, q.y, q.z)
    t := qv.cross(v).scaled(2.0)
    << v.add(t.scaled(q.w)).add(qv.cross(t))
}

pub fn quat_from_axis_angle(axis fm.Vec3, angle f64) fm.Vec4 {
    u := axis.normalized() >>>
    half := angle * 0.5
    s := math.sin(half)
    c := math.cos(half)
    << quat_norm(fm.vec4(u.x * s, u.y * s, u.z * s, c)) >>>
}

pub fn quat_from_to(from_dir fm.Vec3, to_dir fm.Vec3) fm.Vec4 {
    u := from_dir.normalized() >>>
    v := to_dir.normalized() >>>
    d := clamp_f(u.dot(v), -1.0, 1.0)
    if d > 0.999999 {
        << quat_identity()
    }
    if d < -0.999999 {
        $orth := fm.vec3(1.0, 0.0, 0.0).cross(u)
        if orth.dot(orth) < 1e-8 {
            orth = fm.vec3(0.0, 1.0, 0.0).cross(u)
        }
        << quat_from_axis_angle(orth, pi_f()) >>>
    }
    c := u.cross(v)
    << quat_norm(fm.vec4(c.x, c.y, c.z, 1.0 + d)) >>>
}

// Extracts a unit rotation quaternion from an affine Mat4 (removing scaling).
pub fn mat4_rotation_quat(m fm.Mat4) fm.Vec4 {
    c0 := m.c0.xyz().normalized() >>> (err) { << quat_identity() }
    c1_raw := m.c1.xyz()
    c1 := c1_raw.sub(c0.scaled(c1_raw.dot(c0))).normalized() >>> (err) { << quat_identity() }
    c2 := c0.cross(c1)

    m00 := c0.x
    m10 := c0.y
    m20 := c0.z
    m01 := c1.x
    m11 := c1.y
    m21 := c1.z
    m02 := c2.x
    m12 := c2.y
    m22 := c2.z

    tr := m00 + m11 + m22
    if tr > 0.0 {
        s := math.sqrt(tr + 1.0) * 2.0
        << quat_norm(fm.vec4((m21 - m12) / s, (m02 - m20) / s, (m10 - m01) / s, 0.25 * s)) >>>
    }
    if m00 > m11 && m00 > m22 {
        s := math.sqrt(1.0 + m00 - m11 - m22) * 2.0
        << quat_norm(fm.vec4(0.25 * s, (m01 + m10) / s, (m02 + m20) / s, (m21 - m12) / s)) >>>
    }
    if m11 > m22 {
        s := math.sqrt(1.0 + m11 - m00 - m22) * 2.0
        << quat_norm(fm.vec4((m01 + m10) / s, 0.25 * s, (m12 + m21) / s, (m02 - m20) / s)) >>>
    }
    s := math.sqrt(1.0 + m22 - m00 - m11) * 2.0
    << quat_norm(fm.vec4((m02 + m20) / s, (m12 + m21) / s, 0.25 * s, (m10 - m01) / s)) >>>
}

pub fn quat_yaw(q fm.Vec4) f64 {
    siny_cosp := 2.0 * (q.w * q.y + q.x * q.z)
    cosy_cosp := 1.0 - 2.0 * (q.y * q.y + q.z * q.z)
    << math.atan2(siny_cosp, cosy_cosp)
}

pub struct BoneMask {
    weights []f64
}

pub fn new_bone_mask(node_count int, default_weight f64) BoneMask {
    if node_count < 1 || node_count > 4096 || !fm.finite(default_weight) || default_weight < 0.0 || default_weight > 1.0 {
        >>> errors.new("nexus anim: invalid bone mask node count or default weight")
    }
    $w := []f64{}
    for _ in 0:node_count { w.push(default_weight) }
    << BoneMask{weights: w}
}

pub fn (mask $&BoneMask) set_weight(node int, weight f64) int {
    if node < 0 || node >= mask.weights.len || !fm.finite(weight) || weight < 0.0 || weight > 1.0 {
        >>> errors.new("nexus anim: invalid bone mask node or weight")
    }
    mask.weights[node] = weight
    << 0
}

pub fn (mask $&BoneMask) set_branch_weight(asset &gltf.GlbGeometry, root_node int, weight f64) int {
    n := asset.node_count()
    if n != mask.weights.len || root_node < 0 || root_node >= n || !fm.finite(weight) || weight < 0.0 || weight > 1.0 {
        >>> errors.new("nexus anim: invalid bone branch root or weight")
    }
    for i in 0:n {
        $cur := i
        $hit := false
        for _ in 0:n {
            if cur == root_node {
                hit = true
                <-
            }
            if cur < 0 { <- }
            cur = asset.node_parent(cur) >>>
        }
        if hit {
            mask.weights[i] = weight
        }
    }
    << 0
}

pub fn (mask &BoneMask) weight(node int) f64 {
    if node < 0 || node >= mask.weights.len {
        >>> errors.new("nexus anim: bone mask node out of range")
    }
    << mask.weights[node]
}

fn lerp_vec3(a fm.Vec3, b fm.Vec3, t f64) fm.Vec3 {
    inv := 1.0 - t
    << fm.vec3(a.x * inv + b.x * t, a.y * inv + b.y * t, a.z * inv + b.z * t)
}

pub fn blend_poses(a &[]gltf.NodeTrs, b &[]gltf.NodeTrs, weight f64) []gltf.NodeTrs {
    if a.len != b.len || !fm.finite(weight) || weight < 0.0 || weight > 1.0 {
        >>> errors.new("nexus anim: pose blend requires matching node counts and weight in [0, 1]")
    }
    $out := []gltf.NodeTrs{}
    for i in 0:a.len {
        pa := a[i]
        pb := b[i]
        if pa.is_matrix || pb.is_matrix || weight <= 0.0 {
            if weight >= 1.0 && !pb.is_matrix {
                out.push(pb)
            } else {
                out.push(pa)
            }
            ->
        }
        if weight >= 1.0 {
            out.push(pb)
            ->
        }
        out.push(gltf.NodeTrs{
            translation: lerp_vec3(pa.translation, pb.translation, weight),
            rotation: quat_slerp(pa.rotation, pb.rotation, weight) >>>,
            scale: lerp_vec3(pa.scale, pb.scale, weight),
            is_matrix: false
        })
    }
    << out
}

pub fn blend_poses_masked(base &[]gltf.NodeTrs, overlay &[]gltf.NodeTrs, mask &BoneMask, layer_weight f64) []gltf.NodeTrs {
    if base.len != overlay.len || base.len != mask.weights.len ||
        !fm.finite(layer_weight) || layer_weight < 0.0 || layer_weight > 1.0 {
        >>> errors.new("nexus anim: masked blend node counts or layer_weight invalid")
    }
    $out := []gltf.NodeTrs{}
    for i in 0:base.len {
        w := clamp_f(mask.weights[i] * layer_weight, 0.0, 1.0)
        pa := base[i]
        pb := overlay[i]
        if w <= 0.0 || pa.is_matrix || pb.is_matrix {
            out.push(pa)
        } else if w >= 1.0 {
            out.push(pb)
        } else {
            out.push(gltf.NodeTrs{
                translation: lerp_vec3(pa.translation, pb.translation, w),
                rotation: quat_slerp(pa.rotation, pb.rotation, w) >>>,
                scale: lerp_vec3(pa.scale, pb.scale, w),
                is_matrix: false
            })
        }
    }
    << out
}

// Applies additive delta = (additive - reference) on top of base pose with weight in [0, 1].
pub fn apply_additive_pose(base &[]gltf.NodeTrs, additive &[]gltf.NodeTrs, reference &[]gltf.NodeTrs, weight f64) []gltf.NodeTrs {
    if base.len != additive.len || base.len != reference.len || !fm.finite(weight) || weight < 0.0 || weight > 1.0 {
        >>> errors.new("nexus anim: additive pose node counts or weight invalid")
    }
    $out := []gltf.NodeTrs{}
    for i in 0:base.len {
        b := base[i]
        a := additive[i]
        r := reference[i]
        if weight <= 0.0 || b.is_matrix || a.is_matrix || r.is_matrix {
            out.push(b)
            ->
        }
        dt := a.translation.sub(r.translation).scaled(weight)
        dq_full := quat_mul(a.rotation, quat_conj(r.rotation))
        dq_weighted := quat_slerp(quat_identity(), dq_full, weight) >>>
        ds := a.scale.sub(r.scale).scaled(weight)
        out.push(gltf.NodeTrs{
            translation: b.translation.add(dt),
            rotation: quat_norm(quat_mul(dq_weighted, b.rotation)) >>>,
            scale: b.scale.add(ds),
            is_matrix: false
        })
    }
    << out
}

pub struct RootMotionDelta {
    pub delta_translation fm.Vec3
    pub delta_yaw f64
}

pub fn zero_root_motion() RootMotionDelta {
    << RootMotionDelta{delta_translation: fm.vec3(0.0, 0.0, 0.0), delta_yaw: 0.0}
}

pub fn extract_root_motion(
    asset &gltf.GlbGeometry,
    clip int,
    prev_time f64,
    curr_time f64,
    looping bool,
    root_node int,
    pose $&[]gltf.NodeTrs,
    lock_xz bool,
    lock_y bool
) RootMotionDelta {
    if clip < 0 || clip >= asset.animation_count() || root_node < 0 || root_node >= pose.len || pose.len != asset.node_count() {
        >>> errors.new("nexus anim: invalid clip or root_node for root motion")
    }
    dur := asset.animation_duration(clip) >>>
    if dur <= 0.0 {
        << zero_root_motion()
    }
    t0 := clamp_f(prev_time, 0.0, dur)
    t1 := clamp_f(curr_time, 0.0, dur)
    $dt_trans := fm.vec3(0.0, 0.0, 0.0)
    $d_yaw := 0.0
    if looping && t1 < t0 {
        p_prev := asset.sample_trs_pose(clip, t0) >>>
        p_end := asset.sample_trs_pose(clip, dur) >>>
        p_start := asset.sample_trs_pose(clip, 0.0) >>>
        p_curr := asset.sample_trs_pose(clip, t1) >>>
        dt1 := p_end[root_node].translation.sub(p_prev[root_node].translation)
        dt2 := p_curr[root_node].translation.sub(p_start[root_node].translation)
        dt_trans = dt1.add(dt2)
        dy1 := wrap_angle(quat_yaw(p_end[root_node].rotation) - quat_yaw(p_prev[root_node].rotation))
        dy2 := wrap_angle(quat_yaw(p_curr[root_node].rotation) - quat_yaw(p_start[root_node].rotation))
        d_yaw = wrap_angle(dy1 + dy2)
    } else {
        p_prev := asset.sample_trs_pose(clip, t0) >>>
        p_curr := asset.sample_trs_pose(clip, t1) >>>
        dt_trans = p_curr[root_node].translation.sub(p_prev[root_node].translation)
        d_yaw = wrap_angle(quat_yaw(p_curr[root_node].rotation) - quat_yaw(p_prev[root_node].rotation))
    }
    if lock_xz || lock_y {
        rest := asset.sample_trs_pose(-1, 0.0) >>>
        cur_t := pose[root_node].translation
        rest_t := rest[root_node].translation
        $nx := cur_t.x
        $ny := cur_t.y
        $nz := cur_t.z
        if lock_xz {
            nx = rest_t.x
            nz = rest_t.z
        }
        if lock_y {
            ny = rest_t.y
        }
        pose[root_node].translation = fm.vec3(nx, ny, nz)
    }
    << RootMotionDelta{delta_translation: dt_trans, delta_yaw: d_yaw}
}
