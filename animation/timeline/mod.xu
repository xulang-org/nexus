@"github.com/xulang-org/nexus/animation/timeline"

fm #"github.com/xulang-org/nexus/foundation/math"
#errors
#math

pub const INTERP_STEP = 0
pub const INTERP_LINEAR = 1
pub const INTERP_CUBIC_HERMITE = 2

pub struct ScalarKey {
    pub time f64
    pub value f64
    pub in_tangent f64
    pub out_tangent f64
}

pub struct Vec3Key {
    pub time f64
    pub value fm.Vec3
}

pub struct ColorKey {
    pub time f64
    pub rgba int
}

pub struct TimelineEvent {
    pub time f64
    pub name string
    pub payload f64
}

pub struct ScalarTrack {
    pub target string
    pub property string
    pub interp int
    pub keys []ScalarKey
}

pub struct Vec3Track {
    pub target string
    pub property string
    pub interp int
    pub keys []Vec3Key
}

pub struct ColorTrack {
    pub target string
    pub property string
    pub keys []ColorKey
}

pub struct AnimationClip {
    pub name string
    pub duration f64
    pub scalars []ScalarTrack
    pub vec3s []Vec3Track
    pub colors []ColorTrack
    pub events []TimelineEvent
}

pub struct TimelineSample {
    pub time f64
    pub scalar_values []f64
    pub vec3_values []fm.Vec3
    pub color_values []int
    pub fired_events []TimelineEvent
}

pub struct TimelinePlayer {
    pub time f64
    pub speed f64
    pub looping bool
    pub playing bool
}

pub fn new_clip(name string, duration f64) AnimationClip {
    if name.len == 0 || !fm.finite(duration) || duration <= 0.0 {
        >> errors.new("nexus timeline: invalid clip name or duration")
    }
    << AnimationClip{
        name: name,
        duration: duration,
        scalars: []ScalarTrack{},
        vec3s: []Vec3Track{},
        colors: []ColorTrack{},
        events: []TimelineEvent{}
    }
}

pub fn (c $&AnimationClip) add_scalar_track(target string, property string, interp int, keys []ScalarKey) int {
    if keys.len == 0 || interp < INTERP_STEP || interp > INTERP_CUBIC_HERMITE {
        >> errors.new("nexus timeline: invalid scalar track")
    }
    for i in 0:keys.len {
        k := keys[i]
        if !fm.finite(k.time) || !fm.finite(k.value) || (i > 0 && k.time < keys[i - 1].time) {
            >> errors.new("nexus timeline: scalar key times must be sorted and finite")
        }
    }
    id := c.scalars.len
    c.scalars.push(ScalarTrack{target: target, property: property, interp: interp, keys: keys})
    << id
}

pub fn (c $&AnimationClip) add_vec3_track(target string, property string, interp int, keys []Vec3Key) int {
    if keys.len == 0 || interp < INTERP_STEP || interp > INTERP_LINEAR {
        >> errors.new("nexus timeline: invalid vec3 track")
    }
    for i in 0:keys.len {
        k := keys[i]
        if !fm.finite(k.time) || !k.value.is_finite() || (i > 0 && k.time < keys[i - 1].time) {
            >> errors.new("nexus timeline: vec3 key times must be sorted and finite")
        }
    }
    id := c.vec3s.len
    c.vec3s.push(Vec3Track{target: target, property: property, interp: interp, keys: keys})
    << id
}

pub fn (c $&AnimationClip) add_color_track(target string, property string, keys []ColorKey) int {
    if keys.len == 0 {
        >> errors.new("nexus timeline: invalid color track")
    }
    for i in 0:keys.len {
        k := keys[i]
        if !fm.finite(k.time) || (i > 0 && k.time < keys[i - 1].time) {
            >> errors.new("nexus timeline: color key times must be sorted and finite")
        }
    }
    id := c.colors.len
    c.colors.push(ColorTrack{target: target, property: property, keys: keys})
    << id
}

pub fn (c $&AnimationClip) add_event(time f64, name string, payload f64) int {
    if !fm.finite(time) || time < 0.0 || time > c.duration || name.len == 0 {
        >> errors.new("nexus timeline: invalid event marker")
    }
    c.events.push(TimelineEvent{time: time, name: name, payload: payload})
    << c.events.len - 1
}

fn eval_scalar_track(tr &ScalarTrack, t f64) f64 {
    n := tr.keys.len
    if n == 1 || t <= tr.keys[0].time { << tr.keys[0].value }
    if t >= tr.keys[n - 1].time { << tr.keys[n - 1].value }
    for i in 0:(n - 1) {
        a := tr.keys[i]
        b := tr.keys[i + 1]
        if t <= b.time {
            if tr.interp == INTERP_STEP { << a.value }
            dt := math.max(1e-9, b.time - a.time)
            u := (t - a.time) / dt
            if tr.interp == INTERP_LINEAR {
                << a.value + (b.value - a.value) * u
            }
            u2 := u * u
            u3 := u2 * u
            h00 := 2.0 * u3 - 3.0 * u2 + 1.0
            h10 := u3 - 2.0 * u2 + u
            h01 := -2.0 * u3 + 3.0 * u2
            h11 := u3 - u2
            << h00 * a.value + h10 * dt * a.out_tangent + h01 * b.value + h11 * dt * b.in_tangent
        }
    }
    << tr.keys[n - 1].value
}

fn eval_vec3_track(tr &Vec3Track, t f64) fm.Vec3 {
    n := tr.keys.len
    if n == 1 || t <= tr.keys[0].time { << tr.keys[0].value }
    if t >= tr.keys[n - 1].time { << tr.keys[n - 1].value }
    for i in 0:(n - 1) {
        a := tr.keys[i]
        b := tr.keys[i + 1]
        if t <= b.time {
            if tr.interp == INTERP_STEP { << a.value }
            dt := math.max(1e-9, b.time - a.time)
            u := (t - a.time) / dt
            << a.value.add(b.value.sub(a.value).scaled(u))
        }
    }
    << tr.keys[n - 1].value
}

fn clamp_byte(v f64) int {
    iv := int(math.round(v))
    if iv < 0 { << 0 }
    if iv > 255 { << 255 }
    << iv
}

fn lerp_rgba(c0 int, c1 int, u f64) int {
    r0 := f64((c0 >> 24) & 255)
    g0 := f64((c0 >> 16) & 255)
    b0 := f64((c0 >> 8) & 255)
    a0 := f64(c0 & 255)
    r1 := f64((c1 >> 24) & 255)
    g1 := f64((c1 >> 16) & 255)
    b1 := f64((c1 >> 8) & 255)
    a1 := f64(c1 & 255)
    r := clamp_byte(r0 + (r1 - r0) * u)
    g := clamp_byte(g0 + (g1 - g0) * u)
    b := clamp_byte(b0 + (b1 - b0) * u)
    a := clamp_byte(a0 + (a1 - a0) * u)
    << (r << 24) | (g << 16) | (b << 8) | a
}

fn eval_color_track(tr &ColorTrack, t f64) int {
    n := tr.keys.len
    if n == 1 || t <= tr.keys[0].time { << tr.keys[0].rgba }
    if t >= tr.keys[n - 1].time { << tr.keys[n - 1].rgba }
    for i in 0:(n - 1) {
        a := tr.keys[i]
        b := tr.keys[i + 1]
        if t <= b.time {
            dt := math.max(1e-9, b.time - a.time)
            u := (t - a.time) / dt
            << lerp_rgba(a.rgba, b.rgba, u)
        }
    }
    << tr.keys[n - 1].rgba
}

pub fn (c &AnimationClip) evaluate(t f64) TimelineSample {
    clamped := math.max(0.0, math.min(c.duration, t))
    $sv := []f64{}
    for i in 0:c.scalars.len { sv.push(eval_scalar_track(&c.scalars[i], clamped)) }
    $vv := []fm.Vec3{}
    for i in 0:c.vec3s.len { vv.push(eval_vec3_track(&c.vec3s[i], clamped)) }
    $cv := []int{}
    for i in 0:c.colors.len { cv.push(eval_color_track(&c.colors[i], clamped)) }
    << TimelineSample{
        time: clamped,
        scalar_values: sv,
        vec3_values: vv,
        color_values: cv,
        fired_events: []TimelineEvent{}
    }
}

pub fn new_player(looping bool) TimelinePlayer {
    << TimelinePlayer{time: 0.0, speed: 1.0, looping: looping, playing: true}
}

pub fn (p $&TimelinePlayer) play() { p.playing = true }
pub fn (p $&TimelinePlayer) pause() { p.playing = false }

pub fn (p $&TimelinePlayer) seek(t f64) {
    if fm.finite(t) && t >= 0.0 { p.time = t }
}

pub fn (p $&TimelinePlayer) set_speed(speed f64) int {
    if !fm.finite(speed) || speed < 0.0 || speed > 10.0 {
        >> errors.new("nexus timeline: speed must be in 0..10")
    }
    p.speed = speed
    << 0
}

fn collect_events_range(clip &AnimationClip, start_excl f64, end_incl f64, out $&[]TimelineEvent) {
    for i in 0:clip.events.len {
        ev := &clip.events[i]
        if ev.time > start_excl && ev.time <= end_incl {
            out.push(TimelineEvent{time: ev.time, name: ev.name + "", payload: ev.payload})
        }
    }
}

pub fn (p $&TimelinePlayer) advance(clip &AnimationClip, dt f64) TimelineSample {
    if !fm.finite(dt) || dt < 0.0 {
        >> errors.new("nexus timeline: dt must be finite and non-negative")
    }
    $fired := []TimelineEvent{}
    if p.playing && dt > 0.0 && p.speed > 0.0 {
        prev := p.time
        step := dt * p.speed
        if p.looping {
            raw := prev + step
            if raw <= clip.duration {
                collect_events_range(clip, prev, raw, $&fired)
                p.time = raw
                if p.time >= clip.duration { p.time = 0.0 }
            } else {
                collect_events_range(clip, prev, clip.duration, $&fired)
                wrapped := math.mod(raw, clip.duration)
                collect_events_range(clip, -1e-9, wrapped, $&fired)
                p.time = wrapped
            }
        } else {
            next := math.min(clip.duration, prev + step)
            collect_events_range(clip, prev, next, $&fired)
            p.time = next
            if p.time >= clip.duration { p.playing = false }
        }
    }
    $sample := clip.evaluate(p.time)
    sample.fired_events = fired
    << sample
}
