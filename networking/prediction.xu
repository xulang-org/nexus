@"github.com/xulang-org/nexus/networking"

fm #"github.com/xulang-org/nexus/foundation/math"
#encoding/binary
#errors
#math

pub struct PlayerInputCmd {
    pub seq int
    pub tick int
    pub move_x f64
    pub move_z f64
    pub yaw f64
    pub jump bool
    pub sprint bool
    pub dt f64
}

pub struct PredictedBodyState {
    pub position fm.Vec3
    pub velocity fm.Vec3
    pub grounded bool
    pub yaw f64
}

pub fn default_player_input(seq int, tick int, dt f64) PlayerInputCmd {
    << PlayerInputCmd{
        seq: seq,
        tick: tick,
        move_x: 0.0,
        move_z: 0.0,
        yaw: 0.0,
        jump: false,
        sprint: false,
        dt: dt
    }
}

pub fn initial_body_state(pos fm.Vec3, yaw f64) PredictedBodyState {
    << PredictedBodyState{
        position: pos,
        velocity: fm.vec3(0.0, 0.0, 0.0),
        grounded: true,
        yaw: yaw
    }
}

pub fn write_input_cmd(bw $&BitWriter, cmd &PlayerInputCmd) int {
    bw.write_u32(cmd.seq) >>>
    bw.write_u32(cmd.tick) >>>
    bw.write_quantized_f64(cmd.move_x, -1.0, 1.0, 8) >>>
    bw.write_quantized_f64(cmd.move_z, -1.0, 1.0, 8) >>>
    bw.write_angle_rad(cmd.yaw, 12) >>>
    bw.write_bool(cmd.jump) >>>
    bw.write_bool(cmd.sprint) >>>
    << bw.write_quantized_f64(cmd.dt, 0.0, 0.1, 10) >>>
}

pub fn read_input_cmd(br $&BitReader) PlayerInputCmd {
    seq := br.read_u32() >>>
    tick := br.read_u32() >>>
    mx := br.read_quantized_f64(-1.0, 1.0, 8) >>>
    mz := br.read_quantized_f64(-1.0, 1.0, 8) >>>
    yaw := br.read_angle_rad(12) >>>
    jump := br.read_bool() >>>
    sprint := br.read_bool() >>>
    dt := br.read_quantized_f64(0.0, 0.1, 10) >>>
    << PlayerInputCmd{
        seq: seq,
        tick: tick,
        move_x: mx,
        move_z: mz,
        yaw: yaw,
        jump: jump,
        sprint: sprint,
        dt: dt
    }
}

pub fn encode_input_cmd(cmd &PlayerInputCmd) []u8 {
    $bw := new_bit_writer()
    write_input_cmd($&bw, cmd) >>>
    << bw.finish()
}

pub fn decode_input_cmd(raw &[]u8) PlayerInputCmd {
    $br := new_bit_reader(raw)
    << read_input_cmd($&br) >>>
}

fn clamp_f_net(v f64, lo f64, hi f64) f64 {
    if v < lo { << lo }
    if v > hi { << hi }
    << v
}

pub fn simulate_player_tick(state PredictedBodyState, cmd &PlayerInputCmd) PredictedBodyState {
    dt := clamp_f_net(cmd.dt, 0.0, 0.1)
    $mx := clamp_f_net(cmd.move_x, -1.0, 1.0)
    $mz := clamp_f_net(cmd.move_z, -1.0, 1.0)
    mlen := math.sqrt(mx * mx + mz * mz)
    if mlen > 1.0 {
        mx /= mlen
        mz /= mlen
    }

    $speed := 5.5
    if cmd.sprint { speed = 9.0 }

    $vx := mx * speed
    $vz := mz * speed
    $vy := state.velocity.y
    $grounded := state.grounded

    if grounded && cmd.jump {
        vy = 7.2
        grounded = false
    }
    vy -= 18.0 * dt

    $nx := clamp_f_net(state.position.x + vx * dt, -500.0, 500.0)
    $ny := state.position.y + vy * dt
    $nz := clamp_f_net(state.position.z + vz * dt, -500.0, 500.0)
    if ny <= 0.0 {
        ny = 0.0
        if vy < 0.0 { vy = 0.0 }
        grounded = true
    } else {
        grounded = false
    }

    << PredictedBodyState{
        position: fm.vec3(nx, ny, nz),
        velocity: fm.vec3(vx, vy, vz),
        grounded: grounded,
        yaw: wrap_angle_rad(cmd.yaw)
    }
}

// --- Client-Side Prediction + Authoritative Server Reconciliation ---
pub struct ReconcileReport {
    pub error_distance f64
    pub snapped bool
    pub replayed_inputs int
    pub remaining_pending int
}

pub struct ClientPredictor {
    current PredictedBodyState
    pending []PlayerInputCmd
    visual_error fm.Vec3
    last_ack_seq int
}

pub fn new_client_predictor(initial PredictedBodyState) ClientPredictor {
    << ClientPredictor{
        current: initial,
        pending: []PlayerInputCmd{},
        visual_error: fm.vec3(0.0, 0.0, 0.0),
        last_ack_seq: 0
    }
}

pub fn (cp $&ClientPredictor) record_and_predict(cmd PlayerInputCmd) PredictedBodyState {
    cp.pending.push(cmd)
    if cp.pending.len > 128 {
        $trimmed := []PlayerInputCmd{}
        for i in (cp.pending.len - 128):cp.pending.len {
            trimmed.push(cp.pending[i])
        }
        cp.pending = trimmed
    }
    cp.current = simulate_player_tick(cp.current, &cmd)
    << cp.current
}

pub fn (cp $&ClientPredictor) reconcile(
    auth_state PredictedBodyState,
    ack_input_seq int,
    snap_threshold f64
) ReconcileReport {
    if ack_input_seq > cp.last_ack_seq {
        cp.last_ack_seq = ack_input_seq
    }
    $kept := []PlayerInputCmd{}
    for i in 0:cp.pending.len {
        if cp.pending[i].seq > cp.last_ack_seq {
            kept.push(cp.pending[i])
        }
    }
    cp.pending = kept

    old_pos := cp.current.position
    $replayed := auth_state
    for i in 0:cp.pending.len {
        c := &cp.pending[i]
        replayed = simulate_player_tick(replayed, c)
    }

    err_vec := old_pos.sub(replayed.position)
    err_dist := err_vec.length()
    $snapped := false
    if err_dist > snap_threshold {
        snapped = true
        cp.visual_error = fm.vec3(0.0, 0.0, 0.0)
    } else if err_dist > 0.002 {
        cp.visual_error = cp.visual_error.add(err_vec)
    }
    cp.current = replayed

    << ReconcileReport{
        error_distance: err_dist,
        snapped: snapped,
        replayed_inputs: cp.pending.len,
        remaining_pending: cp.pending.len
    }
}

pub fn (cp $&ClientPredictor) advance_visual_smoothing(dt f64) fm.Vec3 {
    if dt > 0.0 {
        decay := math.exp(-16.0 * dt)
        cp.visual_error = cp.visual_error.scaled(decay)
        if cp.visual_error.length() < 0.0005 {
            cp.visual_error = fm.vec3(0.0, 0.0, 0.0)
        }
    }
    << cp.current.position.add(cp.visual_error)
}

pub fn (cp &ClientPredictor) state() PredictedBodyState { << cp.current }
pub fn (cp &ClientPredictor) pending_count() int { << cp.pending.len }

// --- Remote Entity Interpolation (Cubic Hermite + Shortest-Arc Yaw + Bounded Extrapolation) ---
pub struct InterpSample {
    pub tick int
    pub time_s f64
    pub position fm.Vec3
    pub velocity fm.Vec3
    pub yaw f64
    pub pitch f64
}

pub struct InterpResult {
    pub valid bool
    pub extrapolated bool
    pub position fm.Vec3
    pub yaw f64
    pub pitch f64
}

pub struct EntityInterpolator {
    interp_delay_s f64
    max_extrap_s f64
    samples []InterpSample
}

pub fn new_entity_interpolator(interp_delay_s f64, max_extrap_s f64) EntityInterpolator {
    if !fm.finite(interp_delay_s) || interp_delay_s < 0.0 ||
        !fm.finite(max_extrap_s) || max_extrap_s < 0.0 {
        >> errors.new("nexus net: invalid EntityInterpolator timings")
    }
    << EntityInterpolator{
        interp_delay_s: interp_delay_s,
        max_extrap_s: max_extrap_s,
        samples: []InterpSample{}
    }
}

pub fn lerp_angle_shortest(a f64, b f64, t f64) f64 {
    diff := wrap_angle_rad(b - a)
    << wrap_angle_rad(a + diff * t)
}

pub fn (ei $&EntityInterpolator) push_sample(sample InterpSample) {
    if ei.samples.len > 0 {
        li := ei.samples.len - 1
        last := &ei.samples[li]
        if sample.tick <= last.tick && sample.time_s <= last.time_s {
            <<
        }
    }
    ei.samples.push(sample)
    if ei.samples.len > 32 {
        $trimmed := []InterpSample{}
        for i in (ei.samples.len - 32):ei.samples.len {
            trimmed.push(ei.samples[i])
        }
        ei.samples = trimmed
    }
}

pub fn (ei &EntityInterpolator) sample_count() int { << ei.samples.len }

pub fn (ei &EntityInterpolator) interp_delay() f64 { << ei.interp_delay_s }

pub fn (ei $&EntityInterpolator) set_interp_delay(delay_s f64) int {
    if !fm.finite(delay_s) || delay_s < 0.0 || delay_s > 2.0 {
        >> errors.new("nexus net: invalid EntityInterpolator interp_delay_s")
    }
    ei.interp_delay_s = delay_s
    << 0
}

pub fn (ei &EntityInterpolator) sample(client_time_s f64) InterpResult {
    n := ei.samples.len
    if n == 0 {
        << InterpResult{
            valid: false,
            extrapolated: false,
            position: fm.vec3(0.0, 0.0, 0.0),
            yaw: 0.0,
            pitch: 0.0
        }
    }
    render_t := client_time_s - ei.interp_delay_s
    first := &ei.samples[0]
    if n == 1 || render_t <= first.time_s {
        << InterpResult{
            valid: true,
            extrapolated: false,
            position: first.position,
            yaw: wrap_angle_rad(first.yaw),
            pitch: wrap_angle_rad(first.pitch)
        }
    }

    li := n - 1
    last := &ei.samples[li]
    if render_t >= last.time_s {
        $ext_dt := render_t - last.time_s
        if ext_dt > ei.max_extrap_s { ext_dt = ei.max_extrap_s }
        pos := last.position.add(last.velocity.scaled(ext_dt))
        << InterpResult{
            valid: true,
            extrapolated: ext_dt > 0.0001,
            position: pos,
            yaw: wrap_angle_rad(last.yaw),
            pitch: wrap_angle_rad(last.pitch)
        }
    }

    // Find bracket [i, i+1] where s0.time_s <= render_t <= s1.time_s.
    $idx := 0
    for i in 0:(n - 1) {
        if ei.samples[i + 1].time_s >= render_t {
            idx = i
            <-
        }
    }
    ni := idx + 1
    s0 := &ei.samples[idx]
    s1 := &ei.samples[ni]
    span := s1.time_s - s0.time_s
    if span <= 1e-6 {
        << InterpResult{
            valid: true,
            extrapolated: false,
            position: s1.position,
            yaw: wrap_angle_rad(s1.yaw),
            pitch: wrap_angle_rad(s1.pitch)
        }
    }

    t := clamp_f_net((render_t - s0.time_s) / span, 0.0, 1.0)
    t2 := t * t
    t3 := t2 * t
    h00 := 2.0 * t3 - 3.0 * t2 + 1.0
    h10 := t3 - 2.0 * t2 + t
    h01 := -2.0 * t3 + 3.0 * t2
    h11 := t3 - t2

    m0 := s0.velocity.scaled(span)
    m1 := s1.velocity.scaled(span)
    pos := s0.position.scaled(h00).add(m0.scaled(h10)).add(s1.position.scaled(h01)).add(m1.scaled(h11))
    yaw := lerp_angle_shortest(s0.yaw, s1.yaw, t)
    pitch := lerp_angle_shortest(s0.pitch, s1.pitch, t)

    << InterpResult{
        valid: true,
        extrapolated: false,
        position: pos,
        yaw: yaw,
        pitch: pitch
    }
}

pub const MAX_REDUNDANT_INPUTS = 8
pub const INPUT_BUNDLE_MAGIC = 0x4E58

pub struct InputRedundancyWindow {
    max_window int
    history []PlayerInputCmd
}

pub fn new_input_redundancy_window(window_size int) InputRedundancyWindow {
    if window_size < 1 || window_size > MAX_REDUNDANT_INPUTS {
        >> errors.new("nexus net: redundant input window size must be in 1...8")
    }
    << InputRedundancyWindow{max_window: window_size, history: []PlayerInputCmd{}}
}

pub fn (w &InputRedundancyWindow) len() int { << w.history.len }

pub fn (w $&InputRedundancyWindow) push(cmd PlayerInputCmd) int {
    if !fm.finite(cmd.move_x) || !fm.finite(cmd.move_z) || !fm.finite(cmd.yaw) ||
        !fm.finite(cmd.dt) || cmd.dt <= 0.0 || cmd.seq < 0 || cmd.tick < 0 {
        >> errors.new("nexus net: invalid PlayerInputCmd for redundant window")
    }
    if w.history.len > 0 {
        li := w.history.len - 1
        if cmd.seq <= w.history[li].seq {
            >> errors.new("nexus net: input redundancy window requires strictly increasing seq")
        }
    }
    w.history.push(cmd)
    while w.history.len > w.max_window {
        $trimmed := []PlayerInputCmd{}
        for i in 1:w.history.len { trimmed.push(w.history[i]) }
        w.history = trimmed
    }
    << w.history.len
}

pub fn (w &InputRedundancyWindow) encode_bundle() []u8 {
    n := w.history.len
    if n == 0 || n > MAX_REDUNDANT_INPUTS {
        >> errors.new("nexus net: cannot encode empty input redundancy window")
    }
    total := 4 + n * 28
    $out := []u8{}
    for _ in 0:total { out.push(u8(0)) }
    order := binary.little_endian()
    order.put_u16_bytes($&out, 0, INPUT_BUNDLE_MAGIC) >>>
    out[2] = u8(1)
    out[3] = u8(n)
    for i in 0:n {
        cmd := &w.history[i]
        off := 4 + i * 28
        order.put_u32_bytes($&out, off + 0, cmd.seq) >>>
        order.put_u32_bytes($&out, off + 4, cmd.tick) >>>
        order.put_f32($&out, off + 8, cmd.move_x) >>>
        order.put_f32($&out, off + 12, cmd.move_z) >>>
        order.put_f32($&out, off + 16, cmd.yaw) >>>
        $flags := 0
        if cmd.jump { flags = flags | 1 }
        if cmd.sprint { flags = flags | 2 }
        order.put_u32_bytes($&out, off + 20, flags) >>>
        order.put_f32($&out, off + 24, cmd.dt) >>>
    }
    << out
}

pub fn decode_input_bundle(data &[]u8) []PlayerInputCmd {
    if data.len < 4 {
        >> errors.new("nexus net: input bundle header truncated")
    }
    order := binary.little_endian()
    magic := order.get_u16_bytes(data, 0) >>>
    if magic != INPUT_BUNDLE_MAGIC || int(data[2]) != 1 {
        >> errors.new("nexus net: invalid input bundle magic or version")
    }
    count := int(data[3])
    if count < 1 || count > MAX_REDUNDANT_INPUTS || data.len != 4 + count * 28 {
        >> errors.new("nexus net: input bundle length mismatch")
    }
    $cmds := []PlayerInputCmd{}
    for i in 0:count {
        off := 4 + i * 28
        seq := order.get_u32_bytes(data, off + 0) >>>
        tick := order.get_u32_bytes(data, off + 4) >>>
        mx := math.float32_from_bits(order.get_u32_bytes(data, off + 8) >>>)
        mz := math.float32_from_bits(order.get_u32_bytes(data, off + 12) >>>)
        yaw := math.float32_from_bits(order.get_u32_bytes(data, off + 16) >>>)
        flags := order.get_u32_bytes(data, off + 20) >>>
        dt := math.float32_from_bits(order.get_u32_bytes(data, off + 24) >>>)
        if !fm.finite(mx) || !fm.finite(mz) || !fm.finite(yaw) || !fm.finite(dt) || dt <= 0.0 {
            >> errors.new("nexus net: corrupted float in input bundle")
        }
        cmds.push(PlayerInputCmd{
            seq: seq,
            tick: tick,
            move_x: mx,
            move_z: mz,
            yaw: yaw,
            jump: (flags & 1) != 0,
            sprint: (flags & 2) != 0,
            dt: dt
        })
    }
    << cmds
}

pub struct ServerInputReceiver {
    last_applied_seq int
    recovered_count int
    duplicate_count int
}

pub fn new_server_input_receiver() ServerInputReceiver {
    << ServerInputReceiver{last_applied_seq: -1, recovered_count: 0, duplicate_count: 0}
}

pub fn (r &ServerInputReceiver) last_seq() int { << r.last_applied_seq }
pub fn (r &ServerInputReceiver) recovered() int { << r.recovered_count }
pub fn (r &ServerInputReceiver) duplicates() int { << r.duplicate_count }

pub fn (r $&ServerInputReceiver) ingest_bundle(data &[]u8) []PlayerInputCmd {
    cmds := decode_input_bundle(data) >>>
    $unseen := []PlayerInputCmd{}
    for i in 0:cmds.len {
        c := cmds[i]
        if c.seq <= r.last_applied_seq {
            r.duplicate_count += 1
        } else {
            unseen.push(c)
        }
    }
    if unseen.len > 1 {
        r.recovered_count += unseen.len - 1
    }
    if unseen.len > 0 {
        li := unseen.len - 1
        r.last_applied_seq = unseen[li].seq
    }
    << unseen
}

pub struct AdaptiveJitterBuffer {
    send_interval_s f64
    min_delay_s f64
    max_delay_s f64
    srtt_s f64
    jitter_s f64
    current_delay_s f64
    last_arrival_s f64
    last_server_s f64
    has_sample bool
    attack_rate f64
    release_rate f64
}

pub fn new_adaptive_jitter_buffer(send_interval_s f64, min_delay_s f64, max_delay_s f64) AdaptiveJitterBuffer {
    if !fm.finite(send_interval_s) || send_interval_s <= 0.0 ||
        !fm.finite(min_delay_s) || !fm.finite(max_delay_s) ||
        min_delay_s < 0.0 || max_delay_s < min_delay_s || max_delay_s > 2.0 {
        >> errors.new("nexus net: invalid AdaptiveJitterBuffer configuration")
    }
    init_d := clamp_f_net(send_interval_s * 1.5, min_delay_s, max_delay_s)
    << AdaptiveJitterBuffer{
        send_interval_s: send_interval_s,
        min_delay_s: min_delay_s,
        max_delay_s: max_delay_s,
        srtt_s: 0.0,
        jitter_s: 0.0,
        current_delay_s: init_d,
        last_arrival_s: 0.0,
        last_server_s: 0.0,
        has_sample: false,
        attack_rate: 0.35,
        release_rate: 0.06
    }
}

pub fn (jb &AdaptiveJitterBuffer) recommended_delay_s() f64 { << jb.current_delay_s }
pub fn (jb &AdaptiveJitterBuffer) jitter_estimate_s() f64 { << jb.jitter_s }
pub fn (jb &AdaptiveJitterBuffer) srtt_estimate_s() f64 { << jb.srtt_s }

pub fn (jb $&AdaptiveJitterBuffer) observe_packet(arrival_time_s f64, server_time_s f64, rtt_s f64) f64 {
    if !fm.finite(arrival_time_s) || !fm.finite(server_time_s) || !fm.finite(rtt_s) || rtt_s < 0.0 {
        >> errors.new("nexus net: invalid jitter buffer packet sample")
    }
    if !jb.has_sample {
        jb.srtt_s = rtt_s
        jb.last_arrival_s = arrival_time_s
        jb.last_server_s = server_time_s
        jb.has_sample = true
        << jb.current_delay_s
    }
    jb.srtt_s = jb.srtt_s * 0.875 + rtt_s * 0.125
    transit_delta := math.abs((arrival_time_s - jb.last_arrival_s) - (server_time_s - jb.last_server_s))
    jb.jitter_s = jb.jitter_s + (transit_delta - jb.jitter_s) / 16.0
    jb.last_arrival_s = arrival_time_s
    jb.last_server_s = server_time_s

    target := clamp_f_net(jb.send_interval_s + jb.jitter_s * 3.0 + jb.srtt_s * 0.05, jb.min_delay_s, jb.max_delay_s)
    $rate := jb.release_rate
    if target > jb.current_delay_s { rate = jb.attack_rate }
    jb.current_delay_s = clamp_f_net(jb.current_delay_s + (target - jb.current_delay_s) * rate, jb.min_delay_s, jb.max_delay_s)
    << jb.current_delay_s
}
