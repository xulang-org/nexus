@"github.com/xulang-org/nexus/networking"

fm #"github.com/xulang-org/nexus/foundation/math"
#errors

pub const MSG_INPUT_BATCH = 1
pub const MSG_SNAPSHOT = 2
pub const MSG_RPC_EVENT = 3

pub struct NetRpcEvent {
    pub sender_peer int
    pub event_id int
    pub payload []u8
}

struct ServerPeerState {
    peer_id int
    channel ReliableChannel
    interest InterestManager
    has_baseline bool
    baseline WorldSnapshot
    sent_history []WorldSnapshot
    last_input_seq int
}

pub struct ServerSession {
    bounds SnapshotBounds
    entities []NetEntityState
    peers []ServerPeerState
}

pub fn new_server_session() ServerSession {
    << ServerSession{
        bounds: default_snapshot_bounds(),
        entities: []NetEntityState{},
        peers: []ServerPeerState{}
    }
}

fn (s &ServerSession) find_peer_idx(peer_id int) int {
    for i in 0:s.peers.len {
        if s.peers[i].peer_id == peer_id { << i }
    }
    << -1
}

fn (s &ServerSession) find_entity_idx(net_id int) int {
    for i in 0:s.entities.len {
        if s.entities[i].net_id == net_id { << i }
    }
    << -1
}

pub fn (s $&ServerSession) add_peer(peer_id int, interest InterestConfig) int {
    if peer_id <= 0 {
        >> errors.new("nexus net: peer_id must be > 0")
    }
    if s.find_peer_idx(peer_id) >= 0 {
        >> errors.new("nexus net: duplicate peer_id")
    }
    idx := s.peers.len
    im := new_interest_manager(interest) or >>
    s.peers.push(ServerPeerState{
        peer_id: peer_id,
        channel: new_reliable_channel(),
        interest: im,
        has_baseline: false,
        baseline: new_world_snapshot(0, 0),
        sent_history: []WorldSnapshot{},
        last_input_seq: 0
    })
    << idx
}

pub fn (s $&ServerSession) spawn_entity(ent NetEntityState) int {
    if s.find_entity_idx(ent.net_id) >= 0 {
        >> errors.new("nexus net: duplicate entity net_id")
    }
    idx := s.entities.len
    s.entities.push(ent)
    << idx
}

pub fn (s $&ServerSession) update_entity(ent NetEntityState) int {
    idx := s.find_entity_idx(ent.net_id)
    if idx < 0 { >> errors.new("nexus net: entity not found") }
    s.entities[idx] = ent
    << 0
}

pub fn (s $&ServerSession) remove_entity(net_id int) int {
    idx := s.find_entity_idx(net_id)
    if idx < 0 { >> errors.new("nexus net: entity not found") }
    $next := []NetEntityState{}
    for i in 0:s.entities.len {
        if i != idx { next.push(s.entities[i]) }
    }
    s.entities = next
    << 0
}

pub fn (s &ServerSession) entity(net_id int) NetEntityState {
    idx := s.find_entity_idx(net_id)
    if idx < 0 { >> errors.new("nexus net: entity not found") }
    << s.entities[idx]
}

pub fn (s &ServerSession) entities_snapshot() []NetEntityState {
    $out := []NetEntityState{}
    for i in 0:s.entities.len { out.push(s.entities[i]) }
    << out
}

fn encode_input_batch_payload(last_snap_tick int, inputs &[]PlayerInputCmd) []u8 {
    $bw := new_bit_writer()
    bw.write_u8(MSG_INPUT_BATCH) or >>
    bw.write_u32(last_snap_tick) or >>
    $cnt := inputs.len
    if cnt > 4 { cnt = 4 }
    bw.write_u8(cnt) or >>
    for i in 0:cnt {
        write_input_cmd($&bw, &inputs[i]) or >>
    }
    << bw.finish()
}

fn encode_rpc_payload(event_id int, payload &[]u8) []u8 {
    $bw := new_bit_writer()
    bw.write_u8(MSG_RPC_EVENT) or >>
    bw.write_u32(event_id) or >>
    bw.write_bytes(payload) or >>
    << bw.finish()
}

fn (s $&ServerSession) apply_peer_input_batch(pidx int, peer_id int, br $&BitReader) int {
    ack_snap_tick := br.read_u32() or >>
    cnt := br.read_u8() or >>
    if cnt > 8 { >> errors.new("nexus net: malformed input batch count") }

    // Promote acked snapshot from sent history to baseline.
    if ack_snap_tick > 0 {
        p := $&s.peers[pidx]
        if !p.has_baseline || ack_snap_tick > p.baseline.tick {
            for hi in 0:p.sent_history.len {
                if p.sent_history[hi].tick == ack_snap_tick {
                    p.baseline = clone_snapshot(&p.sent_history[hi])
                    p.has_baseline = true
                    <-
                }
            }
        }
    }

    for _ in 0:cnt {
        cmd := read_input_cmd(br) or >>
        if cmd.seq > s.peers[pidx].last_input_seq {
            s.peers[pidx].last_input_seq = cmd.seq
            for ei in 0:s.entities.len {
                if s.entities[ei].owner_peer == peer_id {
                    ent := s.entities[ei]
                    bs := PredictedBodyState{
                        position: ent.position,
                        velocity: ent.velocity,
                        grounded: (ent.flags & 1) != 0,
                        yaw: ent.yaw
                    }
                    ns := simulate_player_tick(bs, &cmd)
                    $nflags := ent.flags & (-2)
                    if ns.grounded { nflags = nflags | 1 }
                    s.entities[ei].position = ns.position
                    s.entities[ei].velocity = ns.velocity
                    s.entities[ei].yaw = ns.yaw
                    s.entities[ei].flags = nflags
                }
            }
        }
    }
    << 0
}

pub fn (s $&ServerSession) on_packet_from_peer(peer_id int, raw &[]u8, now_ms f64) []NetRpcEvent {
    pidx := s.find_peer_idx(peer_id)
    if pidx < 0 { >> errors.new("nexus net: unknown peer_id") }
    ch := $&s.peers[pidx].channel
    msgs := ch.on_receive(raw, now_ms) or >>
    $rpcs := []NetRpcEvent{}
    for i in 0:msgs.len {
        m := &msgs[i]
        if m.kind != PKT_DATA || m.payload.len == 0 { -> }
        $br := new_bit_reader(&m.payload)
        tag := br.read_u8() or >>
        if tag == MSG_INPUT_BATCH {
            s.apply_peer_input_batch(pidx, peer_id, $&br) or >>
        } else if tag == MSG_RPC_EVENT {
            ev_id := br.read_u32() or >>
            ev_data := br.read_bytes(1024) or >>
            rpcs.push(NetRpcEvent{sender_peer: peer_id, event_id: ev_id, payload: ev_data})
        }
    }
    << rpcs
}

pub fn (s $&ServerSession) build_outbound_for_peer(
    peer_id int,
    tick int,
    observer_pos fm.Vec3,
    now_ms f64
) []NetPacket {
    pidx := s.find_peer_idx(peer_id)
    if pidx < 0 { >> errors.new("nexus net: unknown peer_id") }

    ch0 := $&s.peers[pidx].channel
    $out := ch0.poll_retransmits(now_ms) or >>

    ack_seq := s.peers[pidx].last_input_seq
    im := $&s.peers[pidx].interest
    snap := im.filter_snapshot(&s.entities, peer_id, observer_pos, tick, ack_seq)

    // Store snapshot in bounded 32-entry baseline history.
    s.peers[pidx].sent_history.push(clone_snapshot(&snap))
    if s.peers[pidx].sent_history.len > 32 {
        $trimmed := []WorldSnapshot{}
        start_h := s.peers[pidx].sent_history.len - 32
        for i in start_h:s.peers[pidx].sent_history.len {
            trimmed.push(clone_snapshot(&s.peers[pidx].sent_history[i]))
        }
        s.peers[pidx].sent_history = trimmed
    }

    delta := encode_snapshot_delta(&snap, &s.peers[pidx].baseline, s.peers[pidx].has_baseline, &s.bounds) or >>
    $bw := new_bit_writer()
    bw.write_u8(MSG_SNAPSHOT) or >>
    bw.write_bytes(&delta) or >>
    snap_payload := bw.finish()
    ch1 := $&s.peers[pidx].channel
    pkt := ch1.send(CHANNEL_UNRELIABLE, PKT_DATA, &snap_payload, now_ms) or >>
    out.push(NetPacket{data: pkt})
    << out
}

pub fn (s $&ServerSession) send_rpc_to_peer(peer_id int, event_id int, payload &[]u8, now_ms f64) []u8 {
    pidx := s.find_peer_idx(peer_id)
    if pidx < 0 { >> errors.new("nexus net: unknown peer_id") }
    rpc_bytes := encode_rpc_payload(event_id, payload) or >>
    ch := $&s.peers[pidx].channel
    << ch.send(CHANNEL_RELIABLE_ORDERED, PKT_DATA, &rpc_bytes, now_ms) or >>
}

pub fn (s &ServerSession) peer_stats(peer_id int) ChannelStats {
    pidx := s.find_peer_idx(peer_id)
    if pidx < 0 { >> errors.new("nexus net: unknown peer_id") }
    << s.peers[pidx].channel.stats()
}

// --- Client Session ---
struct RemoteInterpEntry {
    net_id int
    interp EntityInterpolator
}

pub struct ClientSession {
    pub peer_id int
    pub local_net_id int
    bounds SnapshotBounds
    channel ReliableChannel
    predictor ClientPredictor
    has_baseline bool
    baseline WorldSnapshot
    last_snap_time_s f64
    interp_delay_s f64
    max_extrap_s f64
    remotes []RemoteInterpEntry
    recent_inputs []PlayerInputCmd
    rpcs []NetRpcEvent
}

pub fn new_client_session(
    peer_id int,
    local_net_id int,
    initial PredictedBodyState,
    interp_delay_s f64,
    max_extrap_s f64
) ClientSession {
    << ClientSession{
        peer_id: peer_id,
        local_net_id: local_net_id,
        bounds: default_snapshot_bounds(),
        channel: new_reliable_channel(),
        predictor: new_client_predictor(initial),
        has_baseline: false,
        baseline: new_world_snapshot(0, 0),
        last_snap_time_s: 0.0,
        interp_delay_s: interp_delay_s,
        max_extrap_s: max_extrap_s,
        remotes: []RemoteInterpEntry{},
        recent_inputs: []PlayerInputCmd{},
        rpcs: []NetRpcEvent{}
    }
}

pub fn (cs $&ClientSession) step_local_input(cmd PlayerInputCmd, now_ms f64) []u8 {
    pred := $&cs.predictor
    _ := pred.record_and_predict(cmd)
    cs.recent_inputs.push(cmd)
    if cs.recent_inputs.len > 4 {
        $trimmed := []PlayerInputCmd{}
        start_r := cs.recent_inputs.len - 4
        for i in start_r:cs.recent_inputs.len {
            trimmed.push(cs.recent_inputs[i])
        }
        cs.recent_inputs = trimmed
    }
    $ack_tick := 0
    if cs.has_baseline { ack_tick = cs.baseline.tick }
    payload := encode_input_batch_payload(ack_tick, &cs.recent_inputs) or >>
    ch := $&cs.channel
    << ch.send(CHANNEL_UNRELIABLE, PKT_DATA, &payload, now_ms) or >>
}

fn (cs $&ClientSession) push_remote_state(ent &NetEntityState, tick int, time_s f64) {
    $idx := -1
    for i in 0:cs.remotes.len {
        if cs.remotes[i].net_id == ent.net_id {
            idx = i
            <-
        }
    }
    if idx < 0 {
        idx = cs.remotes.len
        interp := new_entity_interpolator(cs.interp_delay_s, cs.max_extrap_s) or (err) { << }
        cs.remotes.push(RemoteInterpEntry{net_id: ent.net_id, interp: interp})
    }
    itp := $&cs.remotes[idx].interp
    itp.push_sample(InterpSample{
        tick: tick,
        time_s: time_s,
        position: ent.position,
        velocity: ent.velocity,
        yaw: ent.yaw,
        pitch: ent.pitch
    })
}

pub fn (cs $&ClientSession) on_packet_from_server(raw &[]u8, now_ms f64, client_time_s f64) int {
    ch := $&cs.channel
    msgs := ch.on_receive(raw, now_ms) or >>
    $snaps_applied := 0
    for i in 0:msgs.len {
        m := &msgs[i]
        if m.kind != PKT_DATA || m.payload.len == 0 { -> }
        $br := new_bit_reader(&m.payload)
        tag := br.read_u8() or >>
        if tag == MSG_SNAPSHOT {
            snap_bytes := br.read_bytes(1350) or >>
            snap := decode_snapshot_delta(&snap_bytes, &cs.baseline, &cs.bounds) or >>
            if !cs.has_baseline || snap.tick > cs.baseline.tick {
                cs.baseline = clone_snapshot(&snap)
                cs.has_baseline = true
                cs.last_snap_time_s = client_time_s
                snaps_applied += 1

                for ei in 0:snap.entities.len {
                    e := &snap.entities[ei]
                    if e.net_id == cs.local_net_id {
                        auth := PredictedBodyState{
                            position: e.position,
                            velocity: e.velocity,
                            grounded: (e.flags & 1) != 0,
                            yaw: e.yaw
                        }
                        pred := $&cs.predictor
                        _ := pred.reconcile(auth, snap.ack_input_seq, 2.0)
                    } else {
                        cs.push_remote_state(e, snap.tick, client_time_s)
                    }
                }

                // Prune despawned remote entities no longer in snapshot.
                $kept_remotes := []RemoteInterpEntry{}
                for ri in 0:cs.remotes.len {
                    rid := cs.remotes[ri].net_id
                    if find_entity_idx(&snap.entities, rid) >= 0 {
                        kept_remotes.push(clone_remote_entry(&cs.remotes[ri]))
                    }
                }
                cs.remotes = kept_remotes
            }
        } else if tag == MSG_RPC_EVENT {
            ev_id := br.read_u32() or >>
            ev_data := br.read_bytes(1024) or >>
            cs.rpcs.push(NetRpcEvent{sender_peer: 0, event_id: ev_id, payload: ev_data})
        }
    }
    << snaps_applied
}

fn clone_remote_entry(src &RemoteInterpEntry) RemoteInterpEntry {
    $samples := []InterpSample{}
    for i in 0:src.interp.samples.len { samples.push(src.interp.samples[i]) }
    << RemoteInterpEntry{
        net_id: src.net_id,
        interp: EntityInterpolator{
            interp_delay_s: src.interp.interp_delay_s,
            max_extrap_s: src.interp.max_extrap_s,
            samples: samples
        }
    }
}

pub fn (cs &ClientSession) sample_remote_entity(net_id int, client_time_s f64) InterpResult {
    for i in 0:cs.remotes.len {
        if cs.remotes[i].net_id == net_id {
            << cs.remotes[i].interp.sample(client_time_s)
        }
    }
    << InterpResult{
        valid: false,
        extrapolated: false,
        position: fm.vec3(0.0, 0.0, 0.0),
        yaw: 0.0,
        pitch: 0.0
    }
}

pub fn (cs &ClientSession) local_predicted_state() PredictedBodyState { << cs.predictor.state() }

pub fn (cs $&ClientSession) pop_rpcs() []NetRpcEvent {
    $out := []NetRpcEvent{}
    for i in 0:cs.rpcs.len {
        r := &cs.rpcs[i]
        out.push(NetRpcEvent{
            sender_peer: r.sender_peer,
            event_id: r.event_id,
            payload: clone_bytes(&r.payload)
        })
    }
    cs.rpcs = []NetRpcEvent{}
    << out
}

pub fn (cs $&ClientSession) poll_retransmits(now_ms f64) []NetPacket {
    ch := $&cs.channel
    << ch.poll_retransmits(now_ms) or >>
}

pub fn (cs $&ClientSession) send_rpc(event_id int, payload &[]u8, now_ms f64) []u8 {
    rpc_bytes := encode_rpc_payload(event_id, payload) or >>
    ch := $&cs.channel
    << ch.send(CHANNEL_RELIABLE_ORDERED, PKT_DATA, &rpc_bytes, now_ms) or >>
}

pub fn (cs &ClientSession) remote_entity_count() int { << cs.remotes.len }
pub fn (cs &ClientSession) baseline_tick() int {
    if !cs.has_baseline { << 0 }
    << cs.baseline.tick
}
pub fn (cs &ClientSession) stats() ChannelStats { << cs.channel.stats() }
